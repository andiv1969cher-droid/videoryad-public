Dialogue: 0,0:00:00.11,0:00:03.16,Caption,,0,0,0,,ПОМНИТЕ ПОЧТАЛЬОНА ПЕЧКИНА? Я ВАМ ПОСЫЛКУ ПРИНЁС,
Dialogue: 0,0:00:03.25,0:00:06.87,Caption,,0,0,0,,ТОЛЬКО Я ВАМ ЕЁ НЕ ОТДАМ, ПОТОМУ ЧТО У ВАС ДОКУМЕНТОВ НЕТ. В
Dialogue: 0,0:00:06.87,0:00:09.27,Caption,,0,0,0,,ЕВРОПЕ ПОШЛИ ГОРАЗДО ДАЛЬШЕ ПЕЧКИНА. ТАМ ЕЩЁ
Dialogue: 0,0:00:09.27,0:00:12.13,Caption,,0,0,0,,И ЗАРАБАТЫВАТЬ НА ЧУЖОЙ ПОСЫЛКЕ НАУЧИЛИСЬ. ПРИЧЁМ С
Dialogue: 0,0:00:12.13,0:00:15.34,Caption,,0,0,0,,ПЕРСПЕКТИВОЙ НА ТРИДЦАТЬ ПЯТЬ ЛЕТ ВПЕРЁД. И ВЫ ТОЛЬКО
Dialogue: 0,0:00:15.34,0:00:18.20,Caption,,0,0,0,,ПОСМОТРИТЕ, КАК ПРИ ВСЁМ ЭТОМ ОБСТОЯТ ДЕЛА У САМИХ
Dialogue: 0,0:00:18.20,0:00:20.29,Caption,,0,0,0,,ПОЧТАЛЬОНОВ. ПОДПИСЫВАЙТЕСЬ. ПОТОМУ
Dialogue: 0,0:00:20.29,0:00:23.47,Caption,,0,0,0,,ЧТО ТАКИЕ ДЕТАЛИ ЧАСТО ЗНАЧИТЕЛЬНО ИНТЕРЕСНЕЕ САМОЙ
Dialogue: 0,0:00:23.47,0:00:26.15,Caption,,0,0,0,,НОВОСТИ. В ЕВРОСОЮЗЕ ЗАМОРОЖЕНО ОКОЛО ДВУХСОТ
Dialogue: 0,0:00:26.15,0:00:29.27,Caption,,0,0,0,,ДЕСЯТИ МИЛЛИАРДОВ ЕВРО РОССИЙСКИХ АКТИВОВ. И ТЕПЕРЬ
Dialogue: 0,0:00:29.27,0:00:32.49,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ СОВСЕМ ЗАМЕЧАТЕЛЬНАЯ ПОДРОБНОСТЬ. ДОХОДЫ ОТ
Dialogue: 0,0:00:32.49,0:00:35.44,Caption,,0,0,0,,ЭТИХ ДЕНЕГ УЖЕ ВСТРОИЛИ В ФИНАНСОВЫЕ СХЕМЫ НА ГОДЫ
Dialogue: 0,0:00:35.44,0:00:37.80,Caption,,0,0,0,,ВПЕРЁД. НА НИХ ЗАВЯЗАНО ПОГАШЕНИЕ КРЕДИТОВ,
Dialogue: 0,0:00:38.04,0:00:40.65,Caption,,0,0,0,,КОТОРЫЕ ВЫДАЮТСЯ УКРАИНЕ. ДЕНЬГИ ЛЕЖАТ
Dialogue: 0,0:00:40.65,0:00:43.56,Caption,,0,0,0,,ЧУЖИЕ. ДОХОД С НИХ ИДЁТ В ДЕЛО. А ХОЗЯИНУ ГОВОРЯТ
Dialogue: 0,0:00:43.56,0:00:45.66,Caption,,0,0,0,,ОТДАВАТЬ ПОКА НЕ СОБИРАЕМСЯ. И ВОТ
Dialogue: 0,0:00:45.66,0:00:48.25,Caption,,0,0,0,,КОНКРЕТНАЯ АРИФМЕТИКА. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:00:48.25,0:00:51.02,Caption,,0,0,0,,ЧЕТВЁРТОМ ГОДУ ЕВРОСОЮЗ ВМЕСТЕ С БОЛЬШОЙ СЕМЁРКОЙ
Dialogue: 0,0:00:51.02,0:00:53.31,Caption,,0,0,0,,ЗАПУСТИЛ КРЕДИТНУЮ ПРОГРАММУ НА СОРОК ПЯТЬ
Dialogue: 0,0:00:53.31,0:00:56.67,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО. ПОГАСИТЬ ЭТИ КРЕДИТЫ НЕОБХОДИМО ДО ДВЕ
Dialogue: 0,0:00:56.67,0:00:59.48,Caption,,0,0,0,,ТЫСЯЧИ СОРОК ВТОРОГО ГОДА. ПРИ СТАВКЕ ТРИ ПРОЦЕНТА
Dialogue: 0,0:00:59.48,0:01:01.90,Caption,,0,0,0,,ОДНИ ТОЛЬКО ПРОЦЕНТЫ ЗА ВЕСЬ СРОК ОЦЕНИВАЮТСЯ
Dialogue: 0,0:01:01.90,0:01:04.27,Caption,,0,0,0,,ПРИМЕРНО В ДВАДЦАТЬ ПЯТЬ МИЛЛИАРДОВ ЕВРО. С
Dialogue: 0,0:01:04.27,0:01:06.69,Caption,,0,0,0,,ПРОЦЕНТАМИ КРЕДИТОРАМ ПРЕДСТОИТ ВЕРНУТЬ ОКОЛО
Dialogue: 0,0:01:06.69,0:01:12.36,Caption,,0,0,0,,СЕМИДЕСЯТИ МИЛЛИАРДОВ. А ТЕПЕРЬ ОБСУЖДАЮТСЯ НОВЫЕ ДЕСЯТКИ
Dialogue: 0,0:01:12.36,0:01:14.47,Caption,,0,0,0,,МИЛЛИАРДОВ. ПО ПРИВЕДЁННЫМ РАСЧЁТАМ,
Dialogue: 0,0:01:14.55,0:01:18.14,Caption,,0,0,0,,ОБЩАЯ СУММА ОБЯЗАТЕЛЬСТВ, КОТОРЫЕ РАССЧИТЫВАЮТ ПОГАШАТЬ ЗА СЧЁТ
Dialogue: 0,0:01:18.14,0:01:19.67,Caption,,0,0,0,,ДОХОДОВ ОТ РОССИЙСКИХ АКТИВОВ,
Dialogue: 0,0:01:19.99,0:01:22.65,Caption,,0,0,0,,МОЖЕТ ДОСТИГНУТЬ СТА СОРОКА МИЛЛИАРДОВ
Dialogue: 0,0:01:22.65,0:01:24.96,Caption,,0,0,0,,ЕВРО. ПРИ НЫНЕШНИХ ДОХОДАХ В ТРИ ЧЕТЫРЕ
Dialogue: 0,0:01:24.96,0:01:27.84,Caption,,0,0,0,,МИЛЛИАРДА В ГОД НА ПОГАШЕНИЕ ТАКОГО ОБЪЁМА ПОТРЕБУЕТСЯ
Dialogue: 0,0:01:27.84,0:01:30.27,Caption,,0,0,0,,НЕ МЕНЬШЕ ТРИДЦАТИ ПЯТИ ЛЕТ. ВОТ ТАК ЧУЖИЕ
Dialogue: 0,0:01:30.27,0:01:33.75,Caption,,0,0,0,,ДЕНЬГИ ПРЕВРАЩАЮТСЯ В ФИНАНСОВЫЙ ПЛАН НА ЦЕЛОЕ ПОКОЛЕНИЕ.
Dialogue: 0,0:01:33.75,0:01:36.61,Caption,,0,0,0,,ПРИЧЁМ СЛОВО "ПОКА" ЗДЕСЬ ОСОБЕННО КРАСИВОЕ. ПО
Dialogue: 0,0:01:36.61,0:01:39.65,Caption,,0,0,0,,НЫНЕШНИМ РАСЧЁТАМ РЕЧЬ ИДЁТ МИНИМУМ О ТРИДЦАТИ ПЯТИ
Dialogue: 0,0:01:39.65,0:01:42.72,Caption,,0,0,0,,ГОДАХ. ТРИДЦАТЬ ПЯТЬ ЛЕТ. ЭТО УЖЕ НЕ ПАУЗА. ЭТО
Dialogue: 0,0:01:42.72,0:01:45.54,Caption,,0,0,0,,ПОЛОВИНА НОРМАЛЬНОЙ ЧЕЛОВЕЧЕСКОЙ ЖИЗНИ. ТО ЕСТЬ
Dialogue: 0,0:01:45.54,0:01:47.69,Caption,,0,0,0,,СХЕМА ПРИМЕРНО ТАКАЯ. ВАШИ ДЕНЬГИ
Dialogue: 0,0:01:47.69,0:01:50.69,Caption,,0,0,0,,ЗАБЛОКИРОВАЛИ. НА ДОХОД С ВАШИХ ДЕНЕГ УЖЕ НАБРАЛИ
Dialogue: 0,0:01:50.69,0:01:52.71,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВ. ПОТОМ ВАМ ОБЪЯСНИЛИ,
Dialogue: 0,0:01:52.87,0:01:56.78,Caption,,0,0,0,,ЧТО ВЕРНУТЬ ИХ ТЕПЕРЬ НИКАК, ПОТОМУ ЧТО ДОХОД ОТ НИХ УЖЕ РАСПИСАН.
Dialogue: 0,0:01:56.78,0:01:59.30,Caption,,0,0,0,,КРАСИВО. ПОЧТАЛЬОН ПЕЧКИН ХОТЯ БЫ ЧЕСТНО
Dialogue: 0,0:01:59.30,0:02:02.15,Caption,,0,0,0,,ГОВОРИЛ, ЧТО ПОСЫЛКА СТОИТ У НЕГО НА СТОЛЕ.
Dialogue: 0,0:02:02.15,0:02:04.28,Caption,,0,0,0,,ЗДЕСЬ НА ВАШЕЙ ПОСЫЛКЕ ЕЩЁ И БИЗНЕС
Dialogue: 0,0:02:04.28,0:02:06.83,Caption,,0,0,0,,ПОСТРОИЛИ. И ВЕДЬ ЧТО ОСОБЕННО ПРЕКРАСНО. В
Dialogue: 0,0:02:06.83,0:02:09.83,Caption,,0,0,0,,ШВЕЙЦАРИИ ТОЖЕ ОТЧИТАЛИСЬ О РОССИЙСКИХ ЗАМОРОЖЕННЫХ
Dialogue: 0,0:02:09.83,0:02:12.48,Caption,,0,0,0,,АКТИВАХ. ТАМ СУММА ВЫРОСЛА ДО ВОСЬМИ С ПОЛОВИНОЙ
Dialogue: 0,0:02:12.48,0:02:15.50,Caption,,0,0,0,,МИЛЛИАРДОВ ШВЕЙЦАРСКИХ ФРАНКОВ. ЭТО БОЛЬШЕ ДЕСЯТИ
Dialogue: 0,0:02:15.50,0:02:20.50,Caption,,0,0,0,,МИЛЛИАРДОВ ДОЛЛАРОВ. ПО СРАВНЕНИЮ С АПРЕЛЕМ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:02:20.50,0:02:23.13,Caption,,0,0,0,,ДВАДЦАТЬ ПЯТОГО ГОДА РОСТ СОСТАВИЛ ПЯТНАДЦАТЬ
Dialogue: 0,0:02:23.13,0:02:25.96,Caption,,0,0,0,,ПРОЦЕНТОВ. А ВОТ ЗАБЛОКИРОВАННЫЕ РЕЗЕРВЫ РОССИЙСКОГО
Dialogue: 0,0:02:25.96,0:02:27.79,Caption,,0,0,0,,ЦЕНТРОБАНКА ЗА ВОСЕМНАДЦАТЬ МЕСЯЦЕВ,
Dialogue: 0,0:02:28.03,0:02:30.67,Caption,,0,0,0,,НАОБОРОТ, СОКРАТИЛИСЬ НА ДЕВЯТЬ ПРОЦЕНТОВ,
Dialogue: 0,0:02:30.90,0:02:34.19,Caption,,0,0,0,,ДО ШЕСТИ ЦЕЛЫХ ВОСЬМИ ДЕСЯТЫХ МИЛЛИАРДА ФРАНКОВ. ТО
Dialogue: 0,0:02:34.19,0:02:36.36,Caption,,0,0,0,,ЕСТЬ ОДНИ ЗАМОРОЖЕННЫЕ АКТИВЫ ВЫРОСЛИ
Dialogue: 0,0:02:36.36,0:02:39.40,Caption,,0,0,0,,В СТОИМОСТИ, А ДРУГИЕ ПОТЕРЯЛИ ЧАСТЬ СТОИМОСТИ.
Dialogue: 0,0:02:39.40,0:02:42.67,Caption,,0,0,0,,САМО ВЫРАЖЕНИЕ ПРЕКРАСНОЕ. ОБЪЁМ ЗАМОРОЖЕННЫХ ЧУЖИХ
Dialogue: 0,0:02:42.67,0:02:45.74,Caption,,0,0,0,,ДЕНЕГ ВЫРОС. ПОЧТИ КАК УРОЖАЙ ПШЕНИЦЫ. БЫЛО
Dialogue: 0,0:02:45.74,0:02:48.22,Caption,,0,0,0,,СТОЛЬКО, СТАЛО БОЛЬШЕ. МОЖНО ТАБЛИЦУ
Dialogue: 0,0:02:48.22,0:02:52.51,Caption,,0,0,0,,НАРИСОВАТЬ, ГРАФИК ПОСТРОИТЬ, СТРЕЛОЧКУ ВВЕРХ ПОСТАВИТЬ. УСПЕХ.
Dialogue: 0,0:02:53.07,0:02:54.81,Caption,,0,0,0,,ВОТ ТОЛЬКО ПОПРОБУЙТЕ ПЕРЕНЕСТИ ЭТУ
Dialogue: 0,0:02:54.81,0:02:57.41,Caption,,0,0,0,,ИСТОРИЮ ИЗ БОЛЬШОЙ ПОЛИТИКИ В ОБЫЧНУЮ ЖИЗНЬ. У
Dialogue: 0,0:02:57.41,0:03:00.27,Caption,,0,0,0,,ВАС ЛЕЖАТ ДЕНЬГИ В БАНКЕ. БАНК ОДНАЖДЫ ГОВОРИТ
Dialogue: 0,0:03:00.27,0:03:02.83,Caption,,0,0,0,,МЫ ИХ ВАМ НЕ ОТДАДИМ. ПОТОМ ПРОХОДИТ ВРЕМЯ,
Dialogue: 0,0:03:02.99,0:03:06.43,Caption,,0,0,0,,И БАНК СООБЩАЕТ КСТАТИ, ВАШИ ДЕНЬГИ НЕПЛОХО РАБОТАЮТ,
Dialogue: 0,0:03:06.51,0:03:09.39,Caption,,0,0,0,,ДОХОД РАСТЁТ. ПОТОМ ДОБАВЛЯЕТ ВОЗВРАЩАТЬ ИХ В
Dialogue: 0,0:03:09.39,0:03:11.63,Caption,,0,0,0,,БЛИЖАЙШИЕ ДЕСЯТИЛЕТИЯ ТОЖЕ НЕ ПЛАНИРУЕМ,
Dialogue: 0,0:03:11.87,0:03:13.79,Caption,,0,0,0,,ПОТОМУ ЧТО МЫ ЭТОТ БУДУЩИЙ ДОХОД УЖЕ
Dialogue: 0,0:03:13.79,0:03:16.31,Caption,,0,0,0,,ПООБЕЩАЛИ ДРУГИМ ЛЮДЯМ. ЧТО ВЫ В ЭТОТ МОМЕНТ
Dialogue: 0,0:03:16.31,0:03:19.23,Caption,,0,0,0,,ДОЛЖНЫ СКАЗАТЬ? СПАСИБО ЗА ХОРОШУЮ РАБОТУ С МОИМИ
Dialogue: 0,0:03:19.23,0:03:21.90,Caption,,0,0,0,,ДЕНЬГАМИ? ЭТО ШИКАРНЫЙ БИЗНЕС. ОХРЕНЕТЬ. И
Dialogue: 0,0:03:21.90,0:03:23.79,Caption,,0,0,0,,ГЛАВНЫЙ ВОПРОС ЗДЕСЬ ДАЖЕ НЕ В ТОМ,
Dialogue: 0,0:03:23.95,0:03:26.20,Caption,,0,0,0,,НРАВИТСЯ КОМУ РОССИЯ ИЛИ НЕ НРАВИТСЯ.
Dialogue: 0,0:03:26.20,0:03:28.27,Caption,,0,0,0,,ВЫ ПРОСТО УБЕРИТЕ НА СЕКУНДУ ФЛАГИ,
Dialogue: 0,0:03:28.35,0:03:30.94,Caption,,0,0,0,,ФАМИЛИИ И ЛОЗУНГИ. ОСТАВЬТЕ ХОЗЯИНА И
Dialogue: 0,0:03:30.94,0:03:35.73,Caption,,0,0,0,,ЕГО ДЕНЬГИ. И СРАЗУ ВСЯ КОНСТРУКЦИЯ НАЧИНАЕТ
Dialogue: 0,0:03:35.73,0:03:40.10,Caption,,0,0,0,,ВЫГЛЯДЕТЬ ЗНАЧИТЕЛЬНО ПРОЩЕ. И ВОТ ЕЩЁ КАКАЯ ЗАМЕЧАТЕЛЬНАЯ ИСТОРИЯ.
Dialogue: 0,0:03:40.10,0:03:42.30,Caption,,0,0,0,,ПОЯВИЛОСЬ НЕПОДТВЕРЖДЁННОЕ УТВЕРЖДЕНИЕ,
Dialogue: 0,0:03:42.54,0:03:44.67,Caption,,0,0,0,,БУДТО ПОДОЗРЕНИЯ В ЯВНОМ ИЛИ СКРЫТОМ
Dialogue: 0,0:03:44.67,0:03:47.48,Caption,,0,0,0,,РОССИЙСКОМ ВМЕШАТЕЛЬСТВЕ МОГУТ СТАТЬ ОСНОВАНИЕМ
Dialogue: 0,0:03:47.48,0:03:50.07,Caption,,0,0,0,,ДЛЯ ПЕРЕНОСА ИЛИ ОТМЕНЫ ВЫБОРОВ В СТРАНАХ
Dialogue: 0,0:03:50.07,0:03:52.88,Caption,,0,0,0,,ЕВРОСОЮЗА. ПРИЧЁМ ГОСУДАРСТВО ЯКОБЫ МОЖЕТ ДАЖЕ НЕ
Dialogue: 0,0:03:52.88,0:03:55.02,Caption,,0,0,0,,РАСКРЫВАТЬ КОНКРЕТНЫЕ ДЕЙСТВИЯ РОССИИ,
Dialogue: 0,0:03:55.26,0:03:57.54,Caption,,0,0,0,,КОТОРЫМИ ОБОСНОВЫВАЕТ ТАКОЕ РЕШЕНИЕ.
Dialogue: 0,0:03:57.54,0:03:59.92,Caption,,0,0,0,,НО САМА ПОСТАНОВКА ВОПРОСА ПРЕКРАСНАЯ.
Dialogue: 0,0:03:59.92,0:04:03.10,Caption,,0,0,0,,ПОЛУЧАЕТСЯ, ЕЩЁ ДО ГОЛОСОВАНИЯ МОЖНО ОБСУЖДАТЬ,
Dialogue: 0,0:04:03.34,0:04:05.45,Caption,,0,0,0,,НЕ ОТМЕНИТЬ ЛИ ВЫБОРЫ ИЗ ЗА ПОДОЗРЕНИЙ
Dialogue: 0,0:04:05.45,0:04:07.89,Caption,,0,0,0,,В ИНОСТРАННОМ ВЛИЯНИИ. ХОРОШО. ТОГДА
Dialogue: 0,0:04:07.89,0:04:10.22,Caption,,0,0,0,,ВОПРОС ПРОСТОЙ. ЧТО ПРОИСХОДИТ,
Dialogue: 0,0:04:10.46,0:04:12.44,Caption,,0,0,0,,ЕСЛИ ГРАЖДАНЕ НА СОВЕРШЕННО ОБЫЧНЫХ
Dialogue: 0,0:04:12.44,0:04:15.69,Caption,,0,0,0,,ВЫБОРАХ ГОЛОСУЮТ ЗА ПАРТИЮ, КОТОРУЮ В БРЮССЕЛЕ СЧИТАЮТ
Dialogue: 0,0:04:15.69,0:04:18.88,Caption,,0,0,0,,НЕПРАВИЛЬНОЙ? ГРАЖДАНИН ПРИХОДИТ НА УЧАСТОК. СТАВИТ
Dialogue: 0,0:04:18.88,0:04:21.98,Caption,,0,0,0,,ГАЛОЧКУ. ГОЛОСУЕТ. ЕГО ПАРТИЯ ПОБЕЖДАЕТ. А
Dialogue: 0,0:04:21.98,0:04:24.62,Caption,,0,0,0,,ПОТОМ ВОКРУГ РЕЗУЛЬТАТА НАЧИНАЕТСЯ РАЗГОВОР О
Dialogue: 0,0:04:24.62,0:04:26.94,Caption,,0,0,0,,РОССИЙСКОМ ВЛИЯНИИ, ДЕЗИНФОРМАЦИИ,
Dialogue: 0,0:04:27.18,0:04:29.31,Caption,,0,0,0,,УГРОЗЕ ДЕМОКРАТИИ И НЕОБХОДИМОСТИ
Dialogue: 0,0:04:29.31,0:04:32.14,Caption,,0,0,0,,ЗАЩИЩАТЬ ЕВРОПЕЙСКИЙ ВЫБОР. ОТ КОГО ЗАЩИЩАТЬ?
Dialogue: 0,0:04:32.43,0:04:36.14,Caption,,0,0,0,,ОТ ЕВРОПЕЙСКОГО ИЗБИРАТЕЛЯ? ВОТ ЗДЕСЬ НАЧИНАЕТСЯ ОЧЕНЬ ТОНКАЯ
Dialogue: 0,0:04:36.14,0:04:38.54,Caption,,0,0,0,,МАТЕМАТИКА. КОГДА ЧЕЛОВЕК ГОЛОСУЕТ ПРАВИЛЬНО,
Dialogue: 0,0:04:38.77,0:04:40.67,Caption,,0,0,0,,ЭТО ДЕМОКРАТИЯ. КОГДА ГОЛОСУЕТ
Dialogue: 0,0:04:40.67,0:04:43.18,Caption,,0,0,0,,НЕПРАВИЛЬНО, ТРЕБУЕТСЯ ВНИМАТЕЛЬНО ВЫЯСНИТЬ,
Dialogue: 0,0:04:43.31,0:04:47.33,Caption,,0,0,0,,КТО НА НЕГО ПОВЛИЯЛ. А МОЖЕТ, ОН ПРОСТО ПОСМОТРЕЛ НА СВОЙ СЧЁТ ЗА
Dialogue: 0,0:04:47.33,0:04:50.90,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО? НА НАЛОГИ?
Dialogue: 0,0:04:51.12,0:04:53.74,Caption,,0,0,0,,НА АРЕНДУ? НА СТОИМОСТЬ ДОМА ПРЕСТАРЕЛЫХ ДЛЯ
Dialogue: 0,0:04:53.74,0:04:55.78,Caption,,0,0,0,,РОДИТЕЛЕЙ? НА СОБСТВЕННУЮ ЗАРПЛАТУ?
Dialogue: 0,0:04:56.18,0:04:58.63,Caption,,0,0,0,,И РЕШИЛ ПРОГОЛОСОВАТЬ ИНАЧЕ. ТАК ТОЖЕ
Dialogue: 0,0:04:58.63,0:05:01.01,Caption,,0,0,0,,БЫВАЕТ. И ИМЕННО ПОЭТОМУ ТЕМА ДЕНЕГ ЗДЕСЬ
Dialogue: 0,0:05:01.01,0:05:04.36,Caption,,0,0,0,,ЗНАЧИТЕЛЬНО ВАЖНЕЕ, ЧЕМ КАЖЕТСЯ. ЧЕЛОВЕК МОЖЕТ ГОДАМИ
Dialogue: 0,0:05:04.36,0:05:08.13,Caption,,0,0,0,,СЛУШАТЬ ОГРОМНЫЕ ЦИФРЫ. ДВЕСТИ ДЕСЯТЬ МИЛЛИАРДОВ. СОРОК
Dialogue: 0,0:05:08.13,0:05:10.49,Caption,,0,0,0,,ПЯТЬ МИЛЛИАРДОВ. СТО МИЛЛИАРДОВ. ДЛЯ
Dialogue: 0,0:05:10.49,0:05:13.94,Caption,,0,0,0,,ОБЫЧНОГО ЧЕЛОВЕКА ЭТО ПОЧТИ КОСМОС. ЧТО СТО МИЛЛИАРДОВ,
Dialogue: 0,0:05:14.10,0:05:16.45,Caption,,0,0,0,,ЧТО ДВЕСТИ МИЛЛИАРДОВ. ВСЁ РАВНО ЦИФРА
Dialogue: 0,0:05:16.45,0:05:19.37,Caption,,0,0,0,,ГДЕ ТО ЗА ПРЕДЕЛАМИ БЫТОВОГО СОЗНАНИЯ. А ТРИ
Dialogue: 0,0:05:19.37,0:05:22.19,Caption,,0,0,0,,ТЫСЯЧИ ТРИСТА ШЕСТЬДЕСЯТ ЧЕТЫРЕ ЕВРО В МЕСЯЦ ОН
Dialogue: 0,0:05:22.19,0:05:25.29,Caption,,0,0,0,,ПОНИМАЕТ ПРЕКРАСНО. ПОТОМУ ЧТО ЭТО ЕГО ДЕНЬГИ.
Dialogue: 0,0:05:25.29,0:05:27.59,Caption,,0,0,0,,ВОТ ТУТ НИКАКОГО ПЕРЕВОДЧИКА С ЯЗЫКА БОЛЬШОЙ
Dialogue: 0,0:05:27.59,0:05:30.51,Caption,,0,0,0,,ПОЛИТИКИ УЖЕ НЕ ТРЕБУЕТСЯ. И ЕСЛИ В КАКОЙ ТО МОМЕНТ
Dialogue: 0,0:05:30.51,0:05:32.50,Caption,,0,0,0,,ГРАЖДАНИН НАЧИНАЕТ ГОЛОСОВАТЬ НЕ ТАК,
Dialogue: 0,0:05:32.64,0:05:36.01,Caption,,0,0,0,,КАК ОТ НЕГО ОЖИДАЛИ, ОЧЕНЬ УДОБНО ОБЪЯСНИТЬ ЭТО ИНОСТРАННЫМ
Dialogue: 0,0:05:36.01,0:05:38.66,Caption,,0,0,0,,ВЛИЯНИЕМ. ЗНАЧИТЕЛЬНО НЕПРИЯТНЕЕ СПРОСИТЬ,
Dialogue: 0,0:05:38.90,0:05:40.90,Caption,,0,0,0,,СКОЛЬКО У НЕГО САМОГО ОСТАЛОСЬ ДЕНЕГ
Dialogue: 0,0:05:40.90,0:05:42.74,Caption,,0,0,0,,ПОСЛЕ ВСЕХ ЭТИХ ПРАВИЛЬНЫХ РЕШЕНИЙ.
Dialogue: 0,0:05:42.74,0:05:46.18,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ЗДЕСЬ ВАЖНЕЕ НЕ ГРОМКИЕ ЗАЯВЛЕНИЯ
Dialogue: 0,0:05:46.18,0:05:49.50,Caption,,0,0,0,,ПОЛИТИКОВ, А ТО, ЧЕМ ИХ РЕШЕНИЯ ЗАКАНЧИВАЮТСЯ ДЛЯ
Dialogue: 0,0:05:49.50,0:05:53.22,Caption,,0,0,0,,ОБЫЧНОГО ЧЕЛОВЕКА. НО ТУТ ЕСТЬ ЕЩЁ ОДНА ДЕТАЛЬ. ПОКА В
Dialogue: 0,0:05:53.22,0:05:55.10,Caption,,0,0,0,,ЕВРОПЕ ПРЕКРАСНО НАУЧИЛИСЬ СЧИТАТЬ
Dialogue: 0,0:05:55.10,0:05:56.74,Caption,,0,0,0,,ДОХОД ОТ РОССИЙСКИХ МИЛЛИАРДОВ,
Dialogue: 0,0:05:56.98,0:05:58.92,Caption,,0,0,0,,С СОБСТВЕННЫМИ ДЕНЬГАМИ ДЕЛА ПОЧЕМУ ТО
Dialogue: 0,0:05:58.92,0:06:03.65,Caption,,0,0,0,,ИДУТ КУДА ВЕСЕЛЕЕ. ФРИДРИХ МЕРЦ УЖЕ ГОВОРИТ О
Dialogue: 0,0:06:03.65,0:06:07.12,Caption,,0,0,0,,НЕОБХОДИМОСТИ ОЧЕНЬ ВНИМАТЕЛЬНО ВЫБИРАТЬ РАСХОДЫ. ДЕНЕГ НА
Dialogue: 0,0:06:07.12,0:06:09.28,Caption,,0,0,0,,ВСЁ НЕ ХВАТАЕТ. БЮДЖЕТЫ ПРИХОДИТСЯ
Dialogue: 0,0:06:09.28,0:06:12.64,Caption,,0,0,0,,ПЕРЕСМАТРИВАТЬ. РАСХОДЫ РАСТУТ. ГОСУДАРСТВЕННЫЕ ФИНАНСЫ
Dialogue: 0,0:06:12.64,0:06:16.37,Caption,,0,0,0,,ПРИХОДИТСЯ ПРИВОДИТЬ В ЧУВСТВО. ТО ЕСТЬ ЧУЖИЕ ДЕНЬГИ ЛЕЖАТ.
Dialogue: 0,0:06:16.37,0:06:18.94,Caption,,0,0,0,,ДОХОД ОТ НИХ РАБОТАЕТ. НА ДЕСЯТИЛЕТИЯ ВПЕРЁД
Dialogue: 0,0:06:18.94,0:06:21.48,Caption,,0,0,0,,УЖЕ ВСЁ РАСПИСАЛИ. А СВОИХ ВСЁ РАВНО НЕ
Dialogue: 0,0:06:21.48,0:06:25.06,Caption,,0,0,0,,ХВАТАЕТ. РАЙ ЗАКОНЧИЛСЯ, РЕБЯТА. ПРИШЛО ВРЕМЯ ПЛАТИТЬ ПО
Dialogue: 0,0:06:25.06,0:06:27.91,Caption,,0,0,0,,СЧЕТАМ. И ВОТ ЗДЕСЬ ПОЛИТИКА ВНЕЗАПНО ПЕРЕСТАЁТ БЫТЬ
Dialogue: 0,0:06:27.91,0:06:30.26,Caption,,0,0,0,,ЧЕМ ТО ДАЛЁКИМ. ПОТОМУ ЧТО КОГДА ГОСУДАРСТВУ
Dialogue: 0,0:06:30.26,0:06:33.89,Caption,,0,0,0,,НАЧИНАЕТ НЕ ХВАТАТЬ ДЕНЕГ, ОНО РЕДКО ПЕРВЫМ ДЕЛОМ ИДЁТ К САМОМУ
Dialogue: 0,0:06:33.89,0:06:35.51,Caption,,0,0,0,,СИЛЬНОМУ И ГОВОРИТ ДОРОГОЙ МОЙ,
Dialogue: 0,0:06:35.64,0:06:37.75,Caption,,0,0,0,,ТЕПЕРЬ ТЫ БУДЕШЬ ЖИТЬ ХУЖЕ. НЕТ.
Dialogue: 0,0:06:37.75,0:06:42.20,Caption,,0,0,0,,ОБЫЧНО НАЧИНАЕТСЯ ПОИСК ТЕХ, ДО КОГО ПРОЩЕ ДОТЯНУТЬСЯ. ПЕНСИОНЕРЫ.
Dialogue: 0,0:06:42.20,0:06:46.50,Caption,,0,0,0,,ПОЛУЧАТЕЛИ ПОСОБИЙ. ЛЮДИ, КОТОРЫЕ ЗАВИСЯТ ОТ СОЦИАЛЬНОЙ СИСТЕМЫ.
Dialogue: 0,0:06:46.50,0:06:49.22,Caption,,0,0,0,,ПОТОМ РАБОТАЮЩИЕ ГРАЖДАНЕ. ПОТОМ НАЛОГИ.
Dialogue: 0,0:06:49.22,0:06:52.25,Caption,,0,0,0,,ПОТОМ ВОЗРАСТ ВЫХОДА НА ПЕНСИЮ. ПОТОМ ЕЩЁ КАКАЯ
Dialogue: 0,0:06:52.25,0:06:55.59,Caption,,0,0,0,,НИБУДЬ ЗАМЕЧАТЕЛЬНАЯ РЕФОРМА, ПОСЛЕ КОТОРОЙ ВАМ ОБЪЯСНЯТ,
Dialogue: 0,0:06:55.75,0:06:57.88,Caption,,0,0,0,,ЧТО ЖИТЬ СТАЛО ТРУДНЕЕ ИСКЛЮЧИТЕЛЬНО
Dialogue: 0,0:06:57.88,0:07:00.52,Caption,,0,0,0,,РАДИ ВАШЕГО ЖЕ БУДУЩЕГО. И ЭТО НЕ НЕМЕЦКОЕ
Dialogue: 0,0:07:00.52,0:07:03.59,Caption,,0,0,0,,ИЗОБРЕТЕНИЕ. И НЕ РОССИЙСКОЕ. И НЕ ФРАНЦУЗСКОЕ.
Dialogue: 0,0:07:03.59,0:07:07.09,Caption,,0,0,0,,ПОЛИТИЧЕСКИЕ СТРОИ РАЗНЫЕ. ФЛАГИ РАЗНЫЕ. ТЕЛЕВИЗОРЫ
Dialogue: 0,0:07:07.09,0:07:10.34,Caption,,0,0,0,,РУГАЮТ ДРУГ ДРУГА РАЗНЫМИ СЛОВАМИ. А КОГДА ДЕНЕГ
Dialogue: 0,0:07:10.34,0:07:13.36,Caption,,0,0,0,,СТАНОВИТСЯ МАЛО, ДВИЖЕНИЯ У ГОСУДАРСТВА КАКИЕ ТО
Dialogue: 0,0:07:13.36,0:07:19.15,Caption,,0,0,0,,ПОДОЗРИТЕЛЬНО ОДИНАКОВЫЕ. НА РУСИ ПРО ЭТО ДАВНО СКАЗАЛИ ПРОЩЕ
Dialogue: 0,0:07:19.15,0:07:21.95,Caption,,0,0,0,,ЕДУТ НА ТОМ, КТО ВЕЗЁТ. У КОГО ЕЩЁ ЕСТЬ СИЛЫ,
Dialogue: 0,0:07:22.04,0:07:24.06,Caption,,0,0,0,,ТОТ И ПОТАЩИТ. А В ГЕРМАНИИ ЭТА
Dialogue: 0,0:07:24.06,0:07:26.55,Caption,,0,0,0,,ИСТОРИЯ УЖЕ ПЕРЕСТАЛА БЫТЬ АБСТРАКТНОЙ.
Dialogue: 0,0:07:26.55,0:07:29.08,Caption,,0,0,0,,СРЕДНЯЯ СУММА, КОТОРУЮ ЧЕЛОВЕК В ПЕРВЫЙ ГОД
Dialogue: 0,0:07:29.08,0:07:31.48,Caption,,0,0,0,,ПРОЖИВАНИЯ В НЕМЕЦКОМ ДОМЕ ПРЕСТАРЕЛЫХ ПЛАТИТ ИЗ
Dialogue: 0,0:07:31.48,0:07:35.29,Caption,,0,0,0,,СОБСТВЕННОГО КАРМАНА, ПРЕВЫСИЛА ТРИ ТЫСЯЧИ ТРИСТА ШЕСТЬДЕСЯТ
Dialogue: 0,0:07:35.29,0:07:38.91,Caption,,0,0,0,,ЧЕТЫРЕ ЕВРО В МЕСЯЦ. В МЕСЯЦ. ВОТ ЭТО УЖЕ НЕ ЦИФРА
Dialogue: 0,0:07:38.91,0:07:42.83,Caption,,0,0,0,,ИЗ БЮДЖЕТА ЕВРОСОЮЗА, ГДЕ МИЛЛИАРДЫ ТАК И ЛЕТАЮТ ТУДА СЮДА,
Dialogue: 0,0:07:42.99,0:07:45.46,Caption,,0,0,0,,ЧТО ГЛАЗ ПРИВЫКНУТЬ НЕ УСПЕВАЕТ. ЭТО
Dialogue: 0,0:07:45.46,0:07:48.05,Caption,,0,0,0,,СУММА, КОТОРУЮ ОБЫЧНОМУ ПЕНСИОНЕРУ НУЖНО
Dialogue: 0,0:07:48.05,0:07:51.36,Caption,,0,0,0,,НАЙТИ КАЖДЫЙ МЕСЯЦ. И НЕКОТОРЫЕ НЕМЦЫ УЖЕ ИЩУТ ДОМА
Dialogue: 0,0:07:51.36,0:07:54.46,Caption,,0,0,0,,ПРЕСТАРЕЛЫХ ЗА ПРЕДЕЛАМИ ГЕРМАНИИ. ПРИЧИНА ОЧЕНЬ
Dialogue: 0,0:07:54.46,0:07:57.55,Caption,,0,0,0,,ПРОСТАЯ. ДОМА ДОРОГО. ВОТ И ВСЯ ВЫСОКАЯ ЕВРОПЕЙСКАЯ
Dialogue: 0,0:07:57.55,0:08:00.51,Caption,,0,0,0,,ЭКОНОМИКА НА УРОВНЕ ОДНОГО ЧЕЛОВЕКА. ТЫ ВСЮ ЖИЗНЬ
Dialogue: 0,0:08:00.51,0:08:03.30,Caption,,0,0,0,,РАБОТАЛ В ОДНОЙ ИЗ БОГАТЕЙШИХ СТРАН МИРА. ПЛАТИЛ
Dialogue: 0,0:08:03.30,0:08:06.45,Caption,,0,0,0,,НАЛОГИ. ПЛАТИЛ СТРАХОВКИ. ЖИЛ ПО ПРАВИЛАМ. А
Dialogue: 0,0:08:06.45,0:08:10.26,Caption,,0,0,0,,ПОТОМ НАСТУПАЕТ МОМЕНТ, КОГДА ПРОВЕСТИ ПОСЛЕДНИЕ ГОДЫ ЖИЗНИ У
Dialogue: 0,0:08:10.26,0:08:12.92,Caption,,0,0,0,,СЕБЯ ДОМА СТАНОВИТСЯ СЛИШКОМ ДОРОГО. И ТЫ ЕДЕШЬ
Dialogue: 0,0:08:12.92,0:08:15.95,Caption,,0,0,0,,В ДРУГУЮ СТРАНУ, ПОТОМУ ЧТО ТАМ ДЕШЕВЛЕ СТАРЕТЬ.
Dialogue: 0,0:08:15.95,0:08:18.11,Caption,,0,0,0,,ПРЕКРАСНЫЙ ИТОГ. И ВЕДЬ НИКТО НЕ ГОВОРИТ,
Dialogue: 0,0:08:18.27,0:08:20.12,Caption,,0,0,0,,ЧТО ГОСУДАРСТВО ОБЯЗАНО ОПЛАЧИВАТЬ
Dialogue: 0,0:08:20.12,0:08:23.14,Caption,,0,0,0,,КАЖДОМУ ЧЕЛОВЕКУ ВООБЩЕ ВСЁ. ВОПРОС ДРУГОЙ. КОГДА
Dialogue: 0,0:08:23.14,0:08:26.27,Caption,,0,0,0,,РУКОВОДСТВО СТРАНЫ ГОВОРИТ, ЧТО ДЕНЕГ НЕ ХВАТАЕТ,
Dialogue: 0,0:08:26.60,0:08:30.43,Caption,,0,0,0,,ОЧЕНЬ ИНТЕРЕСНО СМОТРЕТЬ, ГДЕ ИМЕННО ОНИ ЗАКАНЧИВАЮТСЯ ПЕРВЫМИ.
Dialogue: 0,0:08:32.62,0:08:34.39,Caption,,0,0,0,,ПОТОМУ ЧТО НА БОЛЬШИЕ МЕЖДУНАРОДНЫЕ
Dialogue: 0,0:08:34.39,0:08:37.39,Caption,,0,0,0,,ПРОЕКТЫ ДЕНЬГИ ПОЧЕМУ ТО ВЫГЛЯДЯТ ОЧЕНЬ СОЛИДНО. НА
Dialogue: 0,0:08:37.39,0:08:40.72,Caption,,0,0,0,,ОБОРОНУ СУММЫ РАСТУТ. НА КРЕДИТЫ НАХОДЯТСЯ. НА НОВЫЕ
Dialogue: 0,0:08:40.72,0:08:43.63,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА НАХОДЯТСЯ. НА ОБСЛУЖИВАНИЕ СТАРЫХ
Dialogue: 0,0:08:43.63,0:08:46.78,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВ НАХОДЯТСЯ. А ПОТОМ ПРИХОДИТ ПЕНСИОНЕР,
Dialogue: 0,0:08:47.02,0:08:49.06,Caption,,0,0,0,,СМОТРИТ НА СЧЁТ ЗА ДОМ ПРЕСТАРЕЛЫХ И
Dialogue: 0,0:08:49.06,0:08:51.59,Caption,,0,0,0,,ПОНИМАЕТ, ЧТО ЕГО ЛИЧНАЯ ФИНАНСОВАЯ ОПЕРАЦИЯ
Dialogue: 0,0:08:51.59,0:08:53.99,Caption,,0,0,0,,НАЗЫВАЕТСЯ ГОРАЗДО ПРОЩЕ СОБИРАЙ ЧЕМОДАН. А
Dialogue: 0,0:08:53.99,0:08:57.24,Caption,,0,0,0,,ТЕПЕРЬ ПОСМОТРИМ НА ДРУГУЮ СТОРОНУ АТЛАНТИКИ. ПОКА
Dialogue: 0,0:08:57.24,0:09:00.38,Caption,,0,0,0,,ЕВРОПЕЙЦЫ РЕШАЮТ, ЧТО ДЕЛАТЬ С РОССИЙСКИМИ АКТИВАМИ,
Dialogue: 0,0:09:00.69,0:09:02.62,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ СНОВА ПОДОШЛИ К
Dialogue: 0,0:09:02.62,0:09:05.78,Caption,,0,0,0,,СВОЕМУ ЛЮБИМОМУ ФИНАНСОВОМУ АТТРАКЦИОНУ ПОД НАЗВАНИЕМ
Dialogue: 0,0:09:05.78,0:09:08.88,Caption,,0,0,0,,ПОТОЛОК ГОСУДАРСТВЕННОГО ДОЛГА. ДОНАЛЬД ТРАМП
Dialogue: 0,0:09:08.88,0:09:10.94,Caption,,0,0,0,,УЖЕ ПРЕДУПРЕЖДАЕТ ОБ УГРОЗЕ ДЕФОЛТА,
Dialogue: 0,0:09:11.15,0:09:13.15,Caption,,0,0,0,,ЕСЛИ ВОПРОС НЕ БУДЕТ РЕШЁН. СРОК
Dialogue: 0,0:09:13.15,0:09:15.61,Caption,,0,0,0,,ОБОЗНАЧЕН ДО ФЕВРАЛЯ. ПРИЧЁМ ТРАМП ВООБЩЕ
Dialogue: 0,0:09:15.61,0:09:18.95,Caption,,0,0,0,,ПРЕДЛАГАЕТ ОТМЕНИТЬ САМ ПОТОЛОК ГОСУДАРСТВЕННОГО ДОЛГА. ТО
Dialogue: 0,0:09:18.95,0:09:20.78,Caption,,0,0,0,,ЕСТЬ РЕШИТЬ ПРОБЛЕМУ ОГРАНИЧИТЕЛЯ,
Dialogue: 0,0:09:20.93,0:09:23.34,Caption,,0,0,0,,УБРАВ ОГРАНИЧИТЕЛЬ. УДИВИТЕЛЬНАЯ ВЕЩЬ,
Dialogue: 0,0:09:23.43,0:09:25.49,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЕ ФИНАНСЫ. ОБЫЧНОМУ
Dialogue: 0,0:09:25.49,0:09:27.90,Caption,,0,0,0,,ЧЕЛОВЕКУ БАНК ОБЪЯСНЯЕТ ЕСЛИ ДЕНЕГ НЕТ,
Dialogue: 0,0:09:27.98,0:09:30.29,Caption,,0,0,0,,ПЕРЕСТАНЬТЕ ТРАТИТЬ. ГОСУДАРСТВУ ТАКОЙ
Dialogue: 0,0:09:30.29,0:09:33.18,Caption,,0,0,0,,СОВЕТ ПОЧЕМУ ТО НЕ ПОДХОДИТ. ТАМ ВСЁ НЕМНОГО
Dialogue: 0,0:09:33.18,0:09:37.11,Caption,,0,0,0,,СЛОЖНЕЕ. ЕСЛИ ДЕНЕГ НЕТ, БЕРЁМ В ДОЛГ. ЕСЛИ ДОЛГ УПЁРСЯ В
Dialogue: 0,0:09:37.11,0:09:40.22,Caption,,0,0,0,,ПОТОЛОК, ПОДНИМАЕМ ПОТОЛОК. ЕСЛИ ОПЯТЬ УПЁРСЯ,
Dialogue: 0,0:09:40.30,0:09:45.96,Caption,,0,0,0,,СНОВА ОБСУЖДАЕМ ПОТОЛОК. И КАЖДЫЙ РАЗ ПРОИСХОДИТ НЕВЕРОЯТНОЕ
Dialogue: 0,0:09:45.96,0:09:49.96,Caption,,0,0,0,,ОТКРЫТИЕ ОКАЗЫВАЕТСЯ, ПОТОЛОК МЕШАЕТ. ДОМ СТРОИЛИ САМИ.
Dialogue: 0,0:09:49.96,0:09:53.52,Caption,,0,0,0,,ПОТОЛОК СТАВИЛИ САМИ. ДОЛГ НАБИРАЛИ САМИ. А ТЕПЕРЬ
Dialogue: 0,0:09:53.52,0:09:56.81,Caption,,0,0,0,,ПОТОЛОК ВИНОВАТ. И ВЕДЬ США ЗДЕСЬ НЕ КАКАЯ ТО МАЛЕНЬКАЯ
Dialogue: 0,0:09:56.81,0:09:59.66,Caption,,0,0,0,,ЭКОНОМИКА, КОТОРАЯ СЛУЧАЙНО ПРОСЧИТАЛАСЬ. ЭТО
Dialogue: 0,0:09:59.66,0:10:02.76,Caption,,0,0,0,,КРУПНЕЙШАЯ ФИНАНСОВАЯ МАШИНА МИРА. ДОЛЛАР ЛЕЖИТ В
Dialogue: 0,0:10:02.76,0:10:05.36,Caption,,0,0,0,,РЕЗЕРВАХ ДЕСЯТКОВ ГОСУДАРСТВ. АМЕРИКАНСКИЕ
Dialogue: 0,0:10:05.36,0:10:07.79,Caption,,0,0,0,,ОБЛИГАЦИИ СЧИТАЮТСЯ ОДНОЙ ИЗ ОСНОВ МИРОВОЙ
Dialogue: 0,0:10:07.79,0:10:11.33,Caption,,0,0,0,,ФИНАНСОВОЙ СИСТЕМЫ. И ВОТ ПРЕЗИДЕНТ ЭТОЙ СТРАНЫ ПРОИЗНОСИТ
Dialogue: 0,0:10:11.33,0:10:13.97,Caption,,0,0,0,,СЛОВО "ДЕФОЛТ". КРАСИВО ЖИВЁМ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:10:13.97,0:10:17.36,Caption,,0,0,0,,ОЧЕНЬ ИНТЕРЕСНАЯ КАРТИНА. В ЕВРОПЕ СЧИТАЮТ ДОХОДЫ ОТ
Dialogue: 0,0:10:17.36,0:10:19.33,Caption,,0,0,0,,ЧУЖИХ ЗАМОРОЖЕННЫХ МИЛЛИАРДОВ И УЖЕ
Dialogue: 0,0:10:19.33,0:10:21.93,Caption,,0,0,0,,ПЛАНИРУЮТ ИХ ИСПОЛЬЗОВАНИЕ НА ДЕСЯТИЛЕТИЯ. В
Dialogue: 0,0:10:21.93,0:10:25.02,Caption,,0,0,0,,ГЕРМАНИИ ГОВОРЯТ О НЕОБХОДИМОСТИ УЖИМАТЬСЯ. НЕМЕЦКИЕ
Dialogue: 0,0:10:25.02,0:10:27.69,Caption,,0,0,0,,ПЕНСИОНЕРЫ СМОТРЯТ ДОМА ПРЕСТАРЕЛЫХ ЗА ГРАНИЦЕЙ,
Dialogue: 0,0:10:27.85,0:10:29.70,Caption,,0,0,0,,ПОТОМУ ЧТО ДОМА СЛИШКОМ ДОРОГО.
Dialogue: 0,0:10:29.70,0:10:32.21,Caption,,0,0,0,,АМЕРИКАНЦЫ СНОВА ВЫЯСНЯЮТ ОТНОШЕНИЯ СО СВОИМ
Dialogue: 0,0:10:32.21,0:10:35.52,Caption,,0,0,0,,СОБСТВЕННЫМ ПОТОЛКОМ ДОЛГА. И ВСЁ ЭТО ПРОИСХОДИТ НА ФОНЕ
Dialogue: 0,0:10:35.52,0:10:37.29,Caption,,0,0,0,,ОГРОМНЫХ ПОЛИТИЧЕСКИХ ОБЕЩАНИЙ,
Dialogue: 0,0:10:37.53,0:10:39.85,Caption,,0,0,0,,ВОЕННЫХ РАСХОДОВ, НОВЫХ ПРОГРАММ,
Dialogue: 0,0:10:40.01,0:10:42.11,Caption,,0,0,0,,КРЕДИТОВ И ОБЯЗАТЕЛЬСТВ. ДЕНЬГИ В
Dialogue: 0,0:10:42.11,0:10:45.19,Caption,,0,0,0,,БОЛЬШОЙ ПОЛИТИКЕ ВООБЩЕ УДИВИТЕЛЬНАЯ ШТУКА. ПОКА ИХ
Dialogue: 0,0:10:45.19,0:10:48.33,Caption,,0,0,0,,СЧИТАЮТ МИЛЛИАРДАМИ, ОНИ ПОЧТИ НИЧЕГО НЕ ЗНАЧАТ ДЛЯ
Dialogue: 0,0:10:48.33,0:10:51.50,Caption,,0,0,0,,ЧЕЛОВЕКА. ПОТОМ ОНИ ВДРУГ ПРЕВРАЩАЮТСЯ В ЕГО НАЛОГ. В
Dialogue: 0,0:10:51.50,0:10:53.94,Caption,,0,0,0,,ЕГО ПЕНСИОННЫЙ ВОЗРАСТ. В ЕГО СЧЁТ. В
Dialogue: 0,0:10:53.94,0:10:55.93,Caption,,0,0,0,,СТОИМОСТЬ УХОДА ЗА ЕГО РОДИТЕЛЯМИ.
Dialogue: 0,0:10:58.12,0:10:59.94,Caption,,0,0,0,,И ТУТ МИЛЛИАРД НАКОНЕЦ СТАНОВИТСЯ
Dialogue: 0,0:10:59.94,0:11:02.62,Caption,,0,0,0,,ПОНЯТНЫМ. ГОСУДАРСТВО В КРИЗИС ОЧЕНЬ БЫСТРО
Dialogue: 0,0:11:02.62,0:11:05.72,Caption,,0,0,0,,ВСПОМИНАЕТ ОДНУ СТАРУЮ ИСТИНУ. ЕДУТ НА ТОМ,
Dialogue: 0,0:11:05.80,0:11:10.12,Caption,,0,0,0,,КТО ВЕЗЁТ. ПОКА ВЕЗЁШЬ, НА ТЕБЯ ГРУЗЯТ ЕЩЁ. ПОКА РАБОТАЕШЬ,
Dialogue: 0,0:11:10.20,0:11:12.28,Caption,,0,0,0,,ПЛАТИШЬ. ПОКА ЕСТЬ НАКОПЛЕНИЯ,
Dialogue: 0,0:11:12.44,0:11:16.40,Caption,,0,0,0,,НАЙДЁТСЯ СПОСОБ ОБЪЯСНИТЬ, ПОЧЕМУ НУЖНО ПОДЕЛИТЬСЯ. А КОГДА СИЛ
Dialogue: 0,0:11:16.40,0:11:20.25,Caption,,0,0,0,,УЖЕ НЕТ, ОСТАЁТСЯ НАДЕЯТЬСЯ, ЧТО ГДЕ НИБУДЬ ЗА ГРАНИЦЕЙ ДОМ
Dialogue: 0,0:11:20.25,0:11:23.64,Caption,,0,0,0,,ПРЕСТАРЕЛЫХ ОКАЖЕТСЯ ДЕШЕВЛЕ. И ВОТ ЗДЕСЬ ПЕЧКИН ИЗ НАЧАЛА
Dialogue: 0,0:11:23.64,0:11:26.10,Caption,,0,0,0,,ЭТОЙ ИСТОРИИ УЖЕ НЕ КАЖЕТСЯ ТАКИМ СМЕШНЫМ.
Dialogue: 0,0:11:26.10,0:11:29.00,Caption,,0,0,0,,ОН ХОТЯ БЫ ПОСЫЛКУ ПРОСТО НЕ ОТДАВАЛ. ПРОЦЕНТЫ
Dialogue: 0,0:11:29.00,0:11:30.12,Caption,,0,0,0,,С НЕЁ ОН НЕ СНИМАЛ.
