Dialogue: 0,0:00:00.12,0:00:02.60,Caption,,0,0,0,,ЕСТЬ У МЕНЯ ОДИН ПРОСТОЙ ВОПРОС. А ГДЕ
Dialogue: 0,0:00:02.68,0:00:04.52,Caption,,0,0,0,,У ЭТОЙ ИСТОРИИ ВООБЩЕ СТОП КРАН?
Dialogue: 0,0:00:04.84,0:00:07.48,Caption,,0,0,0,,ПОТОМУ ЧТО ОБЫЧНО, КОГДА ВПЕРЕДИ УЖЕ НЕ ЯМА,
Dialogue: 0,0:00:07.57,0:00:11.88,Caption,,0,0,0,,А НОРМАЛЬНАЯ ТАКАЯ ПРОПАСТЬ, ЧЕЛОВЕК ХОТЯ БЫ НОГУ С ГАЗА УБИРАЕТ. А
Dialogue: 0,0:00:11.88,0:00:14.04,Caption,,0,0,0,,ЗДЕСЬ ВСЁ НАОБОРОТ. ЧЕМ БЛИЖЕ КРАЙ,
Dialogue: 0,0:00:14.36,0:00:17.00,Caption,,0,0,0,,ТЕМ ГРОМЧЕ ЗВУЧИТ НИЧЕГО, ЕЩЁ НАСКРЕБЁМ,
Dialogue: 0,0:00:17.16,0:00:20.44,Caption,,0,0,0,,ЕЩЁ НАЙДЁМ, ЕЩЁ ПРОТЯНЕМ. И ВОТ МНЕ ИНТЕРЕСНО,
Dialogue: 0,0:00:20.72,0:00:24.84,Caption,,0,0,0,,ЧТО ВООБЩЕ ДОЛЖНО ПРОИЗОЙТИ, ЧТОБЫ КТО НИБУДЬ НАКОНЕЦ СКАЗАЛ ВСЁ,
Dialogue: 0,0:00:24.92,0:00:27.40,Caption,,0,0,0,,ХВАТИТ? ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:27.48,0:00:30.68,Caption,,0,0,0,,ПОДПИШИТЕСЬ. НАЧНЁМ ВООБЩЕ НЕ С РАКЕТ. РОЖДАЕМОСТЬ
Dialogue: 0,0:00:30.76,0:00:33.08,Caption,,0,0,0,,НА УКРАИНЕ СОКРАТИЛАСЬ НА ТРИДЦАТЬ ВОСЕМЬ ЦЕЛЫХ
Dialogue: 0,0:00:33.08,0:00:35.64,Caption,,0,0,0,,ЧЕТЫРЕ ДЕСЯТЫХ ПРОЦЕНТА ПО СРАВНЕНИЮ С ДВЕ ТЫСЯЧИ
Dialogue: 0,0:00:35.64,0:00:38.36,Caption,,0,0,0,,ДВАДЦАТЬ ПЕРВЫМ ГОДОМ. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОМ
Dialogue: 0,0:00:38.36,0:00:40.84,Caption,,0,0,0,,ЗАРЕГИСТРИРОВАЛИ ПРИМЕРНО ДВЕСТИ СЕМЬДЕСЯТ ЧЕТЫРЕ
Dialogue: 0,0:00:40.92,0:00:43.48,Caption,,0,0,0,,ТЫСЯЧИ РОЖДЕНИЙ. В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЯТОМ УЖЕ
Dialogue: 0,0:00:43.56,0:00:46.76,Caption,,0,0,0,,ОКОЛО СТА ШЕСТИДЕСЯТИ ДЕВЯТИ ТЫСЯЧ. РАЗНИЦА ПРИМЕРНО
Dialogue: 0,0:00:46.84,0:00:50.04,Caption,,0,0,0,,СТО ПЯТЬ ТЫСЯЧ ДЕТЕЙ. СТО ПЯТЬ ТЫСЯЧ. ЭТО
Dialogue: 0,0:00:50.12,0:00:54.12,Caption,,0,0,0,,НЕ СТО ПЯТЬ ТЫСЯЧ ЧЕЛОВЕК, КОТОРЫЕ КУДА ТО ПЕРЕЕХАЛИ И ПОТОМ ЕЩЁ ВЕРНУТСЯ.
Dialogue: 0,0:00:54.36,0:00:57.80,Caption,,0,0,0,,ЭТО ЛЮДИ, КОТОРЫХ ВООБЩЕ НЕ ПОЯВИЛОСЬ. ЧЕРЕЗ СЕМЬ ЛЕТ ИХ
Dialogue: 0,0:00:57.80,0:01:00.12,Caption,,0,0,0,,НЕ БУДЕТ В ШКОЛАХ. ЧЕРЕЗ ПЯТНАДЦАТЬ ЛЕТ ИХ
Dialogue: 0,0:01:00.20,0:01:04.52,Caption,,0,0,0,,НЕ БУДЕТ СРЕДИ ПОДРОСТКОВ, КОТОРЫЕ ВЫБИРАЮТ ПРОФЕССИЮ. ЧЕРЕЗ ДВАДЦАТЬ ЛЕТ ИХ НЕ
Dialogue: 0,0:01:04.60,0:01:06.52,Caption,,0,0,0,,БУДЕТ СРЕДИ ТЕХ, КТО РАБОТАЕТ,
Dialogue: 0,0:01:06.66,0:01:10.60,Caption,,0,0,0,,СОЗДАЁТ СЕМЬИ, ПЛАТИТ НАЛОГИ И РОЖАЕТ УЖЕ СЛЕДУЮЩЕЕ ПОКОЛЕНИЕ.
Dialogue: 0,0:01:12.87,0:01:14.63,Caption,,0,0,0,,И ВОТ ЗДЕСЬ НАЧИНАЕТСЯ ПРОБЛЕМА,
Dialogue: 0,0:01:14.87,0:01:18.07,Caption,,0,0,0,,КОТОРУЮ НЕЛЬЗЯ ЗАЛАТАТЬ МЕШКОМ ДЕНЕГ. ТРАНСФОРМАТОР
Dialogue: 0,0:01:18.15,0:01:21.59,Caption,,0,0,0,,МОЖНО КУПИТЬ. ГЕНЕРАТОР МОЖНО ПРИВЕЗТИ. РАКЕТУ МОЖНО
Dialogue: 0,0:01:21.67,0:01:24.71,Caption,,0,0,0,,ЗАКАЗАТЬ. ДАЖЕ РАЗРУШЕННЫЙ МОСТ КОГДА НИБУДЬ МОЖНО
Dialogue: 0,0:01:24.71,0:01:27.51,Caption,,0,0,0,,ПОСТРОИТЬ ЗАНОВО. А ЧЕЛОВЕКА ЧЕРЕЗ ДВАДЦАТЬ ЛЕТ НА
Dialogue: 0,0:01:27.51,0:01:30.31,Caption,,0,0,0,,СКЛАДЕ НЕ ВЫДАДУТ. ПРИЧЁМ РОЖДАЕМОСТЬ ВЕДЬ ПАДАЕТ НЕ
Dialogue: 0,0:01:30.39,0:01:33.19,Caption,,0,0,0,,В ПУСТОЙ КОМНАТЕ. МИЛЛИОНЫ УКРАИНЦЕВ НАХОДЯТСЯ ЗА
Dialogue: 0,0:01:33.19,0:01:36.07,Caption,,0,0,0,,ПРЕДЕЛАМИ СТРАНЫ. В ОСНОВНОМ ЭТО ЖЕНЩИНЫ И ДЕТИ.
Dialogue: 0,0:01:36.30,0:01:39.03,Caption,,0,0,0,,И ЖЕЛАНИЕ ВОЗВРАЩАТЬСЯ СО ВРЕМЕНЕМ ТОЖЕ СНИЖАЕТСЯ.
Dialogue: 0,0:01:39.43,0:01:42.23,Caption,,0,0,0,,ЭТО ВПОЛНЕ ОБЫЧНАЯ ЧЕЛОВЕЧЕСКАЯ ИСТОРИЯ. ЧЕЛОВЕК
Dialogue: 0,0:01:42.23,0:01:45.11,Caption,,0,0,0,,УЕХАЛ НА НЕСКОЛЬКО МЕСЯЦЕВ. ПОТОМ РЕБЁНОК ПОШЁЛ В
Dialogue: 0,0:01:45.19,0:01:48.79,Caption,,0,0,0,,ШКОЛУ. ПОТОМ ПОЯВИЛАСЬ РАБОТА. ПОТОМ ЯЗЫК. ДРУЗЬЯ.
Dialogue: 0,0:01:49.03,0:01:52.31,Caption,,0,0,0,,СЪЁМНАЯ КВАРТИРА. КАКИЕ ТО ПЛАНЫ. И ЧЕРЕЗ НЕСКОЛЬКО
Dialogue: 0,0:01:52.39,0:01:55.19,Caption,,0,0,0,,ЛЕТ ВОЗВРАЩЕНИЕ ВЫГЛЯДИТ УЖЕ НЕ КАК ПОЕЗДКА ДОМОЙ.
Dialogue: 0,0:01:55.43,0:01:57.99,Caption,,0,0,0,,ЭТО ОПЯТЬ ВСЁ БРОСИТЬ И СНОВА НАЧИНАТЬ ЖИЗНЬ
Dialogue: 0,0:01:57.99,0:02:00.79,Caption,,0,0,0,,СНАЧАЛА. ПОЭТОМУ ВЫРАЖЕНИЕ "ПОСЛЕ КОНФЛИКТА ВСЕ
Dialogue: 0,0:02:00.79,0:02:03.11,Caption,,0,0,0,,ВЕРНУТСЯ" ЗВУЧИТ КРАСИВО ТОЛЬКО ДО ТЕХ ПОР,
Dialogue: 0,0:02:03.43,0:02:06.47,Caption,,0,0,0,,ПОКА НЕ НАЧИНАЕШЬ СМОТРЕТЬ НА КАЛЕНДАРЬ. ЛЮДИ ЖИВУТ.
Dialogue: 0,0:02:06.71,0:02:11.91,Caption,,0,0,0,,ДЕТИ РАСТУТ. ВРЕМЯ НЕ ЖДЁТ, ПОКА ПОЛИТИКИ ЗАКОНЧАТ СВОИ КОМБИНАЦИИ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:02:11.99,0:02:14.39,Caption,,0,0,0,,МНЕ КАК РАЗ НЕПОНЯТНО ДРУГОЕ. НА ЭТОМ ФОНЕ
Dialogue: 0,0:02:14.39,0:02:17.75,Caption,,0,0,0,,ПОЛИТИЧЕСКАЯ ЛОГИКА ПОЧТИ НЕ МЕНЯЕТСЯ. СНОВА ЗВУЧИТ
Dialogue: 0,0:02:17.83,0:02:20.15,Caption,,0,0,0,,НАДО ПРОДОЛЖАТЬ. НЕТ ОДНОГО РЕСУРСА,
Dialogue: 0,0:02:20.31,0:02:22.31,Caption,,0,0,0,,ИЩЕМ ДРУГОЙ. НЕ ХВАТАЕТ ЗДЕСЬ,
Dialogue: 0,0:02:22.47,0:02:25.83,Caption,,0,0,0,,ПРОСИМ ТАМ. НЕ ДАЛИ СЕЙЧАС, ЗНАЧИТ БУДЕМ ЖДАТЬ ТЕХ,
Dialogue: 0,0:02:26.00,0:02:31.39,Caption,,0,0,0,,КТО ПОТОМ ДАСТ. ЗЕЛЕНСКИЙ УЖЕ ПУБЛИЧНО ГОВОРИТ О КОНТАКТАХ С
Dialogue: 0,0:02:31.47,0:02:33.63,Caption,,0,0,0,,ДЕМОКРАТАМИ В БУДУЩЕМ СОСТАВЕ АМЕРИКАНСКОГО
Dialogue: 0,0:02:33.63,0:02:36.59,Caption,,0,0,0,,КОНГРЕССА И РАССЧИТЫВАЕТ НА БОЛЬШУЮ ПОДДЕРЖКУ. ТО
Dialogue: 0,0:02:36.67,0:02:38.51,Caption,,0,0,0,,ЕСТЬ СТАВКА УЖЕ ИДЁТ ДАЖЕ НЕ ТОЛЬКО НА
Dialogue: 0,0:02:38.51,0:02:41.31,Caption,,0,0,0,,НЫНЕШНИЙ ВАШИНГТОН. СТАВКА ИДЁТ НА СЛЕДУЮЩИЙ
Dialogue: 0,0:02:41.31,0:02:43.47,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ РАСКЛАД. ГРУБО ГОВОРЯ,
Dialogue: 0,0:02:43.70,0:02:46.11,Caption,,0,0,0,,СЕГОДНЯ ДЕНЕГ И ОРУЖИЯ ДАЮТ НЕ СТОЛЬКО,
Dialogue: 0,0:02:46.31,0:02:50.27,Caption,,0,0,0,,СКОЛЬКО ХОТЕЛОСЬ БЫ, ЗАТО ЗАВТРА ПРИДУТ ДРУГИЕ ЛЮДИ. А ТАМ ПОСМОТРИМ.
Dialogue: 0,0:02:50.43,0:02:53.23,Caption,,0,0,0,,ОЧЕНЬ УДОБНАЯ КОНСТРУКЦИЯ. АМЕРИКАНСКИЙ ИЗБИРАТЕЛЬ
Dialogue: 0,0:02:53.23,0:02:55.39,Caption,,0,0,0,,ЕЩЁ ДАЖЕ НЕ УСПЕЛ КАК СЛЕДУЕТ ПОЗНАКОМИТЬСЯ СО
Dialogue: 0,0:02:55.47,0:02:59.79,Caption,,0,0,0,,СВОИМ НОВЫМ КОНГРЕССОМ, А В КИЕВЕ УЖЕ МЫСЛЕННО ОТКРЫВАЮТ СКЛАД. РЕБЯТА
Dialogue: 0,0:02:59.79,0:03:03.79,Caption,,0,0,0,,ТОЛЬКО КРЕСЛА ПРИМЕРЯЮТ, А ИМ УЖЕ СПИСОК ПОКУПОК НЕСУТ. ТОЛЬКО ЕСТЬ
Dialogue: 0,0:03:03.79,0:03:07.23,Caption,,0,0,0,,ОДНА НЕПРИЯТНОСТЬ. ДО ЭТОГО "ПОТОМ" ЕЩЁ НАДО ДОЖИТЬ.
Dialogue: 0,0:03:07.38,0:03:10.11,Caption,,0,0,0,,А ЖИТЬ ПРИХОДИТСЯ УЖЕ СЕЙЧАС. И СЕЙЧАС ГЕРМАНИЯ
Dialogue: 0,0:03:10.11,0:03:14.19,Caption,,0,0,0,,ГОВОРИТ ВЕЩЬ, КОТОРАЯ ДЛЯ КИЕВА ЗВУЧИТ СОВСЕМ НЕВЕСЕЛО. НОВЫХ
Dialogue: 0,0:03:14.19,0:03:17.07,Caption,,0,0,0,,PATRIOT БЕРЛИН ПЕРЕДАВАТЬ НЕ СОБИРАЕТСЯ. МИНИСТР
Dialogue: 0,0:03:17.07,0:03:19.79,Caption,,0,0,0,,ОБОРОНЫ ГЕРМАНИИ БОРИС ПИСТОРИУС ОБЪЯСНЯЕТ ЭТО
Dialogue: 0,0:03:19.87,0:03:22.67,Caption,,0,0,0,,ДОВОЛЬНО ПРОСТО. ГЕРМАНИЯ УЖЕ ПЕРЕДАЛА НЕСКОЛЬКО
Dialogue: 0,0:03:22.67,0:03:25.87,Caption,,0,0,0,,СИСТЕМ И БОЛЬШОЕ КОЛИЧЕСТВО РАКЕТ. ДАЛЬШЕ НАЧИНАЮТСЯ
Dialogue: 0,0:03:25.87,0:03:28.43,Caption,,0,0,0,,ПРОБЛЕМЫ УЖЕ У САМОЙ ГЕРМАНИИ. ВОТ И ВСЯ
Dialogue: 0,0:03:28.43,0:03:31.63,Caption,,0,0,0,,ДРУЖБА, КОГДА ДЕЛО ДОХОДИТ ДО ПОСЛЕДНЕЙ КУРТКИ В ШКАФУ.
Dialogue: 0,0:03:31.98,0:03:36.11,Caption,,0,0,0,,ПОКА У ТЕБЯ ИХ ПЯТЬ, МОЖНО КРАСИВО РАССКАЗЫВАТЬ О СОЛИДАРНОСТИ И ОТДАТЬ
Dialogue: 0,0:03:36.19,0:03:40.62,Caption,,0,0,0,,СОСЕДУ ОДНУ. КОГДА ОСТАЛАСЬ ПОСЛЕДНЯЯ,
Dialogue: 0,0:03:40.86,0:03:44.14,Caption,,0,0,0,,НЕОЖИДАННО ВЫЯСНЯЕТСЯ, ЧТО ЗИМА ВООБЩЕ ТО И У ТЕБЯ ТОЖЕ.
Dialogue: 0,0:03:44.44,0:03:46.94,Caption,,0,0,0,,И БЕРЛИН СЕЙЧАС ИМЕННО ЭТО И ГОВОРИТ. МЫ
Dialogue: 0,0:03:46.94,0:03:50.54,Caption,,0,0,0,,ПОМОГАЛИ. МЫ ОТДАВАЛИ. НО У СОБСТВЕННОЙ ОБОРОНЫ ТОЖЕ
Dialogue: 0,0:03:50.54,0:03:53.10,Caption,,0,0,0,,ЕСТЬ НИЖНЯЯ ГРАНИЦА. И ВОТ ЭТО УЖЕ НОВАЯ
Dialogue: 0,0:03:53.18,0:03:57.26,Caption,,0,0,0,,ИСТОРИЯ. НЕ ПОТОМУ, ЧТО УКРАИНА ВПЕРВЫЕ СТОЛКНУЛАСЬ С НЕХВАТКОЙ PATRIOT.
Dialogue: 0,0:03:57.59,0:04:00.06,Caption,,0,0,0,,ПРО НЕХВАТКУ ГОВОРИЛИ ДАВНО. НЕ ПОТОМУ,
Dialogue: 0,0:04:00.21,0:04:03.02,Caption,,0,0,0,,ЧТО ГЕРМАНИЯ ВДРУГ ПЕРЕСТАЛА ПОДДЕРЖИВАТЬ КИЕВ. РЕЧЬ
Dialogue: 0,0:04:03.10,0:04:05.98,Caption,,0,0,0,,НЕ ОБ ЭТОМ. НОВЫЙ СМЫСЛ В ДРУГОМ. НАЧИНАЕТ
Dialogue: 0,0:04:05.98,0:04:08.46,Caption,,0,0,0,,ЗАКАНЧИВАТЬСЯ ТА ЧАСТЬ ЕВРОПЕЙСКОГО РЕСУРСА,
Dialogue: 0,0:04:08.71,0:04:11.26,Caption,,0,0,0,,КОТОРУЮ РАНЬШЕ МОЖНО БЫЛО ПРОСТО ПЕРЕДАВАТЬ ДАЛЬШЕ.
Dialogue: 0,0:04:11.66,0:04:14.38,Caption,,0,0,0,,ПОТОМУ ЧТО СОБСТВЕННАЯ БЕЗОПАСНОСТЬ ТОЖЕ СУЩЕСТВУЕТ.
Dialogue: 0,0:04:14.70,0:04:16.54,Caption,,0,0,0,,И В ТОТ ЖЕ САМЫЙ МОМЕНТ КИЕВ ГОВОРИТ
Dialogue: 0,0:04:16.54,0:04:19.58,Caption,,0,0,0,,НАМ ЭТИХ СИСТЕМ НЕ ХВАТАЕТ. ПО СЛОВАМ ЗЕЛЕНСКОГО,
Dialogue: 0,0:04:19.81,0:04:22.06,Caption,,0,0,0,,ПРИ ОДНОМ ИЗ МАССИРОВАННЫХ УДАРОВ ПО КИЕВУ И
Dialogue: 0,0:04:22.06,0:04:25.26,Caption,,0,0,0,,ОБЛАСТИ БЫЛИ ПРИМЕНЕНЫ ТРИДЦАТЬ ШЕСТЬ БАЛЛИСТИЧЕСКИХ
Dialogue: 0,0:04:25.26,0:04:27.90,Caption,,0,0,0,,РАКЕТ. УКРАИНСКАЯ СТОРОНА ЗАЯВИЛА О ПЕРЕХВАТЕ
Dialogue: 0,0:04:27.90,0:04:31.02,Caption,,0,0,0,,ЧЕТЫРЁХ. ЧЕТЫРЁХ ИЗ ТРИДЦАТИ ШЕСТИ. ТУТ ДАЖЕ
Dialogue: 0,0:04:31.02,0:04:33.98,Caption,,0,0,0,,КАЛЬКУЛЯТОР ОСОБЕННО НЕ НУЖЕН. ЕСЛИ БРАТЬ ЭТИ ЦИФРЫ
Dialogue: 0,0:04:33.98,0:04:36.70,Caption,,0,0,0,,КИЕВА, ОСТАЁТСЯ ТРИДЦАТЬ ДВЕ РАКЕТЫ,
Dialogue: 0,0:04:36.98,0:04:39.74,Caption,,0,0,0,,КОТОРЫЕ В ЗАЯВЛЕННЫЙ ПЕРЕХВАТ НЕ ПОПАЛИ. И СРЕДИ
Dialogue: 0,0:04:39.74,0:04:42.38,Caption,,0,0,0,,ПРИМЕНЁННЫХ СРЕДСТВ ЗЕЛЕНСКИЙ ОТДЕЛЬНО НАЗВАЛ
Dialogue: 0,0:04:42.38,0:04:45.42,Caption,,0,0,0,,СЕВЕРОКОРЕЙСКУЮ КН ДВАДЦАТЬ ТРИ. ОДНА ИЗ ТАКИХ
Dialogue: 0,0:04:45.42,0:04:49.34,Caption,,0,0,0,,РАКЕТ, ПО ЕГО СЛОВАМ, ПОРАЗИЛА ВАЖНЫЙ ЭНЕРГЕТИЧЕСКИЙ ОБЪЕКТ.
Dialogue: 0,0:04:51.62,0:04:53.38,Caption,,0,0,0,,ТО ЕСТЬ РАЗГОВОР ИДЁТ УЖЕ НЕ О ТОМ,
Dialogue: 0,0:04:53.54,0:04:56.58,Caption,,0,0,0,,ХОРОШО БЫЛО БЫ ПОЛУЧИТЬ ЕЩЁ НЕМНОГО ПВО. РАЗГОВОР
Dialogue: 0,0:04:56.58,0:05:00.50,Caption,,0,0,0,,ИДЁТ О БАЛЛИСТИКЕ, КОТОРУЮ НАДО ПЕРЕХВАТЫВАТЬ СЕЙЧАС. НЕ ПОСЛЕ
Dialogue: 0,0:05:00.50,0:05:03.30,Caption,,0,0,0,,СЛЕДУЮЩЕГО КОНГРЕССА. НЕ КОГДА ЗАВОД РАСШИРИТ
Dialogue: 0,0:05:03.30,0:05:06.10,Caption,,0,0,0,,ПРОИЗВОДСТВО. НЕ КОГДА КТО НИБУДЬ ЧЕРЕЗ ПАРУ ЛЕТ
Dialogue: 0,0:05:06.18,0:05:09.30,Caption,,0,0,0,,ВЫПОЛНИТ НОВЫЙ КОНТРАКТ. СЕЙЧАС. А ГЕРМАНИЯ В ЭТОТ
Dialogue: 0,0:05:09.38,0:05:13.30,Caption,,0,0,0,,САМЫЙ МОМЕНТ ГОВОРИТ РЕБЯТА, НАШ ШКАФ ТОЖЕ НЕ РЕЗИНОВЫЙ. ВОТ ВАМ И
Dialogue: 0,0:05:13.38,0:05:18.58,Caption,,0,0,0,,ВСЯ АРИФМЕТИКА. ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. КИЕВ. ТАМ ВЕДЬ ПРОБЛЕМА
Dialogue: 0,0:05:18.58,0:05:23.30,Caption,,0,0,0,,ДАВНО НЕ ОГРАНИЧИВАЕТСЯ ТЕМ, СКОЛЬКО ЧЕГО СБИЛИ. СТОЛИЦА УЖЕ ЖИВЁТ С АВАРИЙНЫМИ
Dialogue: 0,0:05:23.30,0:05:26.18,Caption,,0,0,0,,ОТКЛЮЧЕНИЯМИ ЭЛЕКТРИЧЕСТВА. ВОЗНИКАЮТ ПРОБЛЕМЫ С
Dialogue: 0,0:05:26.18,0:05:28.90,Caption,,0,0,0,,ВОДОЙ. ЧАСТЬ ИНФРАСТРУКТУРЫ ПЫТАЮТСЯ ДЕРЖАТЬ НА
Dialogue: 0,0:05:28.90,0:05:32.18,Caption,,0,0,0,,ГЕНЕРАТОРАХ. САМ ЗЕЛЕНСКИЙ УЖЕ КРИТИКУЕТ ПОДГОТОВКУ
Dialogue: 0,0:05:32.18,0:05:35.70,Caption,,0,0,0,,ГОРОДА И ГОВОРИТ, ЧТО НА ГОРОДСКОМ УРОВНЕ ОНА ПРОВАЛЕНА ПО РЯДУ
Dialogue: 0,0:05:35.70,0:05:39.22,Caption,,0,0,0,,НАПРАВЛЕНИЙ, ВКЛЮЧАЯ АЛЬТЕРНАТИВНОЕ ОБЕСПЕЧЕНИЕ ВОДОКАНАЛА.
Dialogue: 0,0:05:39.78,0:05:44.18,Caption,,0,0,0,,КЛИЧКО В ОТВЕТ ОБЪЯСНЯЕТ, ЧТО ПОТРЕБНОСТИ ОГРОМНЫЕ И ГЕНЕРАТОРАМИ ВСЁ ЗАКРЫТЬ
Dialogue: 0,0:05:44.18,0:05:46.42,Caption,,0,0,0,,ФИЗИЧЕСКИ НЕВОЗМОЖНО. ВОТ ОНА,
Dialogue: 0,0:05:46.52,0:05:49.30,Caption,,0,0,0,,РЕАЛЬНАЯ ЖИЗНЬ. У ЧЕЛОВЕКА ДОМА НЕТ СВЕТА,
Dialogue: 0,0:05:49.46,0:05:52.66,Caption,,0,0,0,,СЛЕДОМ ПРОПАДАЕТ ВОДА. НАСОСУ НУЖНО ЭЛЕКТРИЧЕСТВО,
Dialogue: 0,0:05:52.82,0:05:55.78,Caption,,0,0,0,,ГЕНЕРАТОРУ ТОПЛИВО. А ЕЩЁ ЭТОТ ГЕНЕРАТОР СНАЧАЛА
Dialogue: 0,0:05:55.78,0:05:58.18,Caption,,0,0,0,,НАДО ГДЕ ТО ВЗЯТЬ. И КОГДА ВЛАСТИ ГОВОРЯТ,
Dialogue: 0,0:05:58.34,0:06:02.74,Caption,,0,0,0,,ЧТО СИСТЕМА ДЕРЖИТСЯ, ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС НА ЧЁМ И СКОЛЬКО ЕЩЁ?
Dialogue: 0,0:06:03.14,0:06:04.82,Caption,,0,0,0,,А ТЕПЕРЬ ДОБАВЛЯЕМ ЕЩЁ ОДИН СЛОЙ.
Dialogue: 0,0:06:07.09,0:06:10.85,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ГОВОРИТ, ЧТО УКРАИНСКАЯ РАЗВЕДКА РАСПОЛАГАЕТ ИНФОРМАЦИЕЙ О
Dialogue: 0,0:06:10.85,0:06:13.81,Caption,,0,0,0,,ПОДГОТОВКЕ НОВЫХ УДАРОВ ПО ЭНЕРГЕТИКЕ И МОСТАМ ЧЕРЕЗ
Dialogue: 0,0:06:13.81,0:06:16.69,Caption,,0,0,0,,ДНЕПР. ВОТ ЗДЕСЬ УЖЕ СТАНОВИТСЯ СОВСЕМ ВЕСЕЛО.
Dialogue: 0,0:06:17.16,0:06:19.17,Caption,,0,0,0,,ПОТОМУ ЧТО МОСТ ЧЕРЕЗ ДНЕПР ЭТО НЕ ПРОСТО
Dialogue: 0,0:06:19.17,0:06:23.09,Caption,,0,0,0,,КРАСИВЫЙ ОБЪЕКТ, КОТОРЫЙ МОЖНО ПОТОМ ПОКАЗАТЬ В НОВОСТЯХ. ЭТО СВЯЗЬ
Dialogue: 0,0:06:23.17,0:06:25.73,Caption,,0,0,0,,МЕЖДУ ОГРОМНЫМИ ЧАСТЯМИ СТРАНЫ. ЛЮДИ,
Dialogue: 0,0:06:25.81,0:06:28.85,Caption,,0,0,0,,ГРУЗЫ, ЖЕЛЕЗНАЯ ДОРОГА, АВТОТРАНСПОРТ,
Dialogue: 0,0:06:28.98,0:06:30.93,Caption,,0,0,0,,ВОЕННАЯ И ГРАЖДАНСКАЯ ЛОГИСТИКА,
Dialogue: 0,0:06:31.01,0:06:33.73,Caption,,0,0,0,,РЕМОНТ, ПЕРЕБРОСКА ТЕХНИКИ. ВСЁ,
Dialogue: 0,0:06:33.82,0:06:35.57,Caption,,0,0,0,,ЧТО ДОЛЖНО ДВИГАТЬСЯ МЕЖДУ БЕРЕГАМИ.
Dialogue: 0,0:06:36.13,0:06:38.53,Caption,,0,0,0,,И ЕСЛИ ТАКИЕ ОБЪЕКТЫ ОКАЗЫВАЮТСЯ ПОД СИСТЕМНЫМ
Dialogue: 0,0:06:38.53,0:06:42.37,Caption,,0,0,0,,ДАВЛЕНИЕМ, ВОПРОС ПЕРЕСТАЁТ БЫТЬ ВОПРОСОМ ОДНОГО МОСТА. ЭТО УЖЕ
Dialogue: 0,0:06:42.37,0:06:45.81,Caption,,0,0,0,,ВОПРОС ТОГО, СКОЛЬКО РАЗ МОЖНО РЕМОНТИРОВАТЬ ОДНУ И ТУ ЖЕ
Dialogue: 0,0:06:45.81,0:06:47.89,Caption,,0,0,0,,СИСТЕМУ И СКОЛЬКО ЛЮДЕЙ НУЖНО,
Dialogue: 0,0:06:48.13,0:06:50.85,Caption,,0,0,0,,ЧТОБЫ ПОСТОЯННО ЭТИМ ЗАНИМАТЬСЯ. МЫ ЭТО УЖЕ ВИДЕЛИ
Dialogue: 0,0:06:50.85,0:06:54.05,Caption,,0,0,0,,РАНЬШЕ. МОЖНО ПРИДУМАТЬ ВРЕМЕННУЮ ПЕРЕПРАВУ. МОЖНО
Dialogue: 0,0:06:54.05,0:06:57.57,Caption,,0,0,0,,ПРИВЕЗТИ КОНСТРУКЦИИ. МОЖНО НАЙТИ МОНТАЖНИКОВ. МОЖНО
Dialogue: 0,0:06:57.65,0:07:00.21,Caption,,0,0,0,,СНОВА ЧТО ТО ВОССТАНОВИТЬ. НА БУМАГЕ ВООБЩЕ ВСЁ
Dialogue: 0,0:07:00.21,0:07:03.09,Caption,,0,0,0,,ПРЕКРАСНО ВОССТАНАВЛИВАЕТСЯ. ТОЛЬКО БУМАГА НЕ СТОИТ
Dialogue: 0,0:07:03.17,0:07:06.29,Caption,,0,0,0,,ПОД ВОЗДУШНОЙ ТРЕВОГОЙ С ГАЕЧНЫМ КЛЮЧОМ. ЛЮДИ СТОЯТ.
Dialogue: 0,0:07:06.61,0:07:08.61,Caption,,0,0,0,,И ВОТ ЗДЕСЬ МЫ ВОЗВРАЩАЕМСЯ К ТОЙ САМОЙ
Dialogue: 0,0:07:08.61,0:07:11.89,Caption,,0,0,0,,ДЕМОГРАФИИ, С КОТОРОЙ НАЧАЛИ. ПОТОМУ ЧТО ОЧЕНЬ ЛЕГКО ГОВОРИТЬ
Dialogue: 0,0:07:11.97,0:07:14.61,Caption,,0,0,0,,О НАСЕЛЕНИИ КАК О РЕСУРСЕ. ЕСТЬ ЕЩЁ ЛЮДИ.
Dialogue: 0,0:07:15.01,0:07:18.85,Caption,,0,0,0,,ЕЩЁ МОБИЛИЗУЕМ. ЕЩЁ НАЙДЁМ СПЕЦИАЛИСТОВ. ЕЩЁ КТО ТО
Dialogue: 0,0:07:18.85,0:07:25.61,Caption,,0,0,0,,ПОЧИНИТ. ЕЩЁ КТО ТО ПОСТРОИТ. ЕЩЁ КТО ТО СЯДЕТ ЗА РУЛЬ. ЕЩЁ КТО
Dialogue: 0,0:07:25.61,0:07:28.73,Caption,,0,0,0,,ТО ПОЙДЁТ РАБОТАТЬ. ТОЛЬКО ЧЕЛОВЕК НЕ ПАТРОН. ЕГО
Dialogue: 0,0:07:28.73,0:07:31.29,Caption,,0,0,0,,НЕЛЬЗЯ ПРОИЗВЕСТИ ДОПОЛНИТЕЛЬНОЙ СМЕНОЙ НА ЗАВОДЕ.
Dialogue: 0,0:07:31.85,0:07:34.25,Caption,,0,0,0,,И КОГДА СТРАНА ОДНОВРЕМЕННО ТЕРЯЕТ ЛЮДЕЙ ЧЕРЕЗ
Dialogue: 0,0:07:34.25,0:07:37.77,Caption,,0,0,0,,ЭМИГРАЦИЮ, ПОЛУЧАЕТ ПРОВАЛ РОЖДАЕМОСТИ И ПРОДОЛЖАЕТ ЖИТЬ В
Dialogue: 0,0:07:37.85,0:07:40.25,Caption,,0,0,0,,РЕЖИМЕ ОГРОМНОГО ВОЕННОГО И ИНФРАСТРУКТУРНОГО
Dialogue: 0,0:07:40.25,0:07:43.77,Caption,,0,0,0,,РАСХОДА, ЗДЕСЬ УЖЕ ХОЧЕТСЯ СПРОСИТЬ ОЧЕНЬ ПРОСТУЮ ВЕЩЬ. А
Dialogue: 0,0:07:43.85,0:07:46.09,Caption,,0,0,0,,ЛЮДИ ТОЧНО НЕ ПРЕВРАТИЛИСЬ ПРОСТО В ЕЩЁ ОДНУ
Dialogue: 0,0:07:46.17,0:07:48.65,Caption,,0,0,0,,СТРОКУ РАСХОДНИКОВ? ЗАКОНЧИЛИСЬ РАКЕТЫ,
Dialogue: 0,0:07:48.80,0:07:50.97,Caption,,0,0,0,,ИЩЕМ РАКЕТЫ. ЗАКОНЧИЛИСЬ ДЕНЬГИ,
Dialogue: 0,0:07:51.20,0:07:53.45,Caption,,0,0,0,,ИЩЕМ ДЕНЬГИ. НЕ ХВАТАЕТ ГЕНЕРАТОРОВ,
Dialogue: 0,0:07:53.54,0:07:55.85,Caption,,0,0,0,,ИЩЕМ ГЕНЕРАТОРЫ. НЕ ХВАТАЕТ ЛЮДЕЙ,
Dialogue: 0,0:07:55.97,0:07:58.89,Caption,,0,0,0,,ЗНАЧИТ ИЩЕМ ЛЮДЕЙ. ТАК ДОЛГО РАБОТАТЬ НЕ МОЖЕТ
Dialogue: 0,0:07:58.97,0:08:01.85,Caption,,0,0,0,,ВООБЩЕ НИКАКАЯ СИСТЕМА. ПОТОМУ ЧТО У ЛЮБОГО СКЛАДА
Dialogue: 0,0:08:01.93,0:08:05.21,Caption,,0,0,0,,ЕСТЬ ДНО. И ИМЕННО ЗДЕСЬ ОСОБЕННО ИНТЕРЕСНО СМОТРЕТЬ
Dialogue: 0,0:08:05.29,0:08:08.33,Caption,,0,0,0,,НА НЫНЕШНЮЮ ЛОГИКУ КИЕВА. ВМЕСТО РАЗГОВОРА О ТОМ,
Dialogue: 0,0:08:08.49,0:08:11.61,Caption,,0,0,0,,ГДЕ НАХОДИТСЯ ПРЕДЕЛ, СНОВА ЗВУЧИТ РАЗГОВОР О ТОМ,
Dialogue: 0,0:08:11.77,0:08:16.01,Caption,,0,0,0,,ГДЕ ВЗЯТЬ ЕЩЁ. САМИ БУДЕМ УВЕЛИЧИВАТЬ ПРОИЗВОДСТВО. БУДЕМ ИСКАТЬ
Dialogue: 0,0:08:16.01,0:08:19.29,Caption,,0,0,0,,РАКЕТЫ. БУДЕМ РАБОТАТЬ С АМЕРИКАНЦАМИ. БУДЕМ ЖДАТЬ
Dialogue: 0,0:08:19.29,0:08:22.33,Caption,,0,0,0,,НОВОЙ ПОЛИТИЧЕСКОЙ КОНФИГУРАЦИИ В ВАШИНГТОНЕ. БУДЕМ
Dialogue: 0,0:08:22.33,0:08:25.13,Caption,,0,0,0,,ПРОСИТЬ ЕВРОПЕЙЦЕВ. БУДЕМ ПРОДОЛЖАТЬ. ТО ЕСТЬ
Dialogue: 0,0:08:25.21,0:08:27.53,Caption,,0,0,0,,ПРОБЛЕМА КАЖДЫЙ РАЗ ПОЛУЧАЕТ ОДИН И ТОТ ЖЕ
Dialogue: 0,0:08:27.53,0:08:30.49,Caption,,0,0,0,,ОТВЕТ. ЕЩЁ РЕСУРС. И В ЭТОМ ЕСТЬ ОЧЕНЬ
Dialogue: 0,0:08:30.49,0:08:33.21,Caption,,0,0,0,,СТРАННАЯ ВЕЩЬ. ЧЕМ ТЯЖЕЛЕЕ СТАНОВИТСЯ ЦЕНА
Dialogue: 0,0:08:33.21,0:08:37.29,Caption,,0,0,0,,ПРОДОЛЖЕНИЯ, ТЕМ МЕНЬШЕ САМА ЦЕНА ВЛИЯЕТ НА РЕШЕНИЕ ПРОДОЛЖАТЬ.
Dialogue: 0,0:08:39.57,0:08:42.21,Caption,,0,0,0,,ДЕМОГРАФИЯ ПРОСЕДАЕТ, ЛЮДИ УЕЗЖАЮТ,
Dialogue: 0,0:08:42.36,0:08:44.45,Caption,,0,0,0,,В КИЕВЕ ПРОБЛЕМЫ СО СВЕТОМ И ВОДОЙ,
Dialogue: 0,0:08:44.64,0:08:49.08,Caption,,0,0,0,,PATRIOT НЕ ХВАТАЕТ, МОСТАМ УГРОЖАЮТ НОВЫЕ УДАРЫ. А ОТВЕТ КАЖДЫЙ РАЗ
Dialogue: 0,0:08:49.08,0:08:51.96,Caption,,0,0,0,,ТОТ ЖЕ БУДЕМ ИСКАТЬ РЕСУРС И ПРОДОЛЖАТЬ. НА
Dialogue: 0,0:08:52.04,0:08:55.16,Caption,,0,0,0,,КАЖДУЮ НОВУЮ ПРОБЛЕМУ ОДИН РЕЦЕПТ. НАЙТИ ЕЩЁ НЕМНОГО
Dialogue: 0,0:08:55.16,0:08:57.48,Caption,,0,0,0,,ТОПЛИВА ДЛЯ ТОЙ ЖЕ САМОЙ МАШИНЫ. А ГДЕ
Dialogue: 0,0:08:57.57,0:09:00.28,Caption,,0,0,0,,ТОРМОЗ? ВОТ ЭТО И ЕСТЬ ГЛАВНЫЙ ВОПРОС. ПОТОМУ ЧТО
Dialogue: 0,0:09:00.36,0:09:02.84,Caption,,0,0,0,,ВОЙНА ВООБЩЕ СТРАШНО УДОБНАЯ ВЕЩЬ ДЛЯ БЮРОКРАТИИ.
Dialogue: 0,0:09:03.14,0:09:06.21,Caption,,0,0,0,,ЛЮБУЮ ПРОБЛЕМУ МОЖНО ОБЪЯВИТЬ ЕЩЁ ОДНИМ АРГУМЕНТОМ,
Dialogue: 0,0:09:06.36,0:09:08.76,Caption,,0,0,0,,ПОЧЕМУ НЕЛЬЗЯ ОСТАНАВЛИВАТЬСЯ. СТАЛО ХУЖЕ?
Dialogue: 0,0:09:09.16,0:09:11.96,Caption,,0,0,0,,ТЕМ БОЛЕЕ НЕЛЬЗЯ ОСТАНАВЛИВАТЬСЯ. ПОТЕРЯЛИ БОЛЬШЕ?
Dialogue: 0,0:09:12.32,0:09:15.16,Caption,,0,0,0,,ТЕМ БОЛЕЕ НЕЛЬЗЯ ОСТАНАВЛИВАТЬСЯ. УЖЕ СЛИШКОМ ДОРОГО
Dialogue: 0,0:09:15.16,0:09:17.33,Caption,,0,0,0,,ЗАПЛАТИЛИ? ЗНАЧИТ НЕЛЬЗЯ ДОПУСТИТЬ,
Dialogue: 0,0:09:17.53,0:09:20.21,Caption,,0,0,0,,ЧТОБЫ ЗАПЛАТИЛИ ЗРЯ. И ТАК МОЖНО ИДТИ ОЧЕНЬ
Dialogue: 0,0:09:20.28,0:09:23.00,Caption,,0,0,0,,ДАЛЕКО. У ЭТОГО ЕСТЬ ДАЖЕ БЫТОВОЙ АНАЛОГ. ЧЕЛОВЕК
Dialogue: 0,0:09:23.08,0:09:26.36,Caption,,0,0,0,,СИДИТ В КАЗИНО, ПРОИГРАЛ ПОЛОВИНУ ДЕНЕГ И ГОВОРИТ СЕЙЧАС УЙТИ
Dialogue: 0,0:09:26.45,0:09:29.88,Caption,,0,0,0,,НЕЛЬЗЯ, НАДО ОТБИТЬ. ПРОИГРЫВАЕТ ЕЩЁ. ТЕПЕРЬ ТЕМ БОЛЕЕ
Dialogue: 0,0:09:29.88,0:09:33.72,Caption,,0,0,0,,НЕЛЬЗЯ УХОДИТЬ. ЕЩЁ ОДНА СТАВКА. ЕЩЁ ОДНА. ПОТОМ
Dialogue: 0,0:09:33.72,0:09:36.12,Caption,,0,0,0,,ОН УЖЕ ИГРАЕТ НЕ РАДИ ВЫИГРЫША. ОН ИГРАЕТ
Dialogue: 0,0:09:36.12,0:09:39.24,Caption,,0,0,0,,ПОТОМУ, ЧТО ПРИЗНАТЬ ПРЕДЫДУЩИЙ ПРОИГРЫШ БОЛЬНЕЕ,
Dialogue: 0,0:09:39.41,0:09:41.80,Caption,,0,0,0,,ЧЕМ СДЕЛАТЬ СЛЕДУЮЩИЙ. ТОЛЬКО ГОСУДАРСТВО ЭТО НЕ
Dialogue: 0,0:09:41.80,0:09:45.16,Caption,,0,0,0,,КАЗИНО. И ФИШКИ ТАМ ДРУГИЕ. ЛЮДИ. ГОРОДА.
Dialogue: 0,0:09:45.40,0:09:49.57,Caption,,0,0,0,,ЭНЕРГЕТИКА. ЭКОНОМИКА. ТЕРРИТОРИЯ. БУДУЩЕЕ. И ВОТ
Dialogue: 0,0:09:49.64,0:09:52.12,Caption,,0,0,0,,ТОГДА ИСТОРИЯ С АМЕРИКАНСКИМИ ДЕМОКРАТАМИ НАЧИНАЕТ
Dialogue: 0,0:09:52.21,0:09:58.57,Caption,,0,0,0,,ВЫГЛЯДЕТЬ СОВСЕМ ИНАЧЕ. САМА ПО СЕБЕ НОВОСТЬ ОБЫЧНАЯ. ЗЕЛЕНСКИЙ ОБЩАЕТСЯ С
Dialogue: 0,0:09:58.65,0:10:02.33,Caption,,0,0,0,,ЛЮДЬМИ, КОТОРЫЕ ЗАВТРА БУДУТ ВЛИЯТЬ НА КОНГРЕСС. НУ ОБЩАЕТСЯ
Dialogue: 0,0:10:02.41,0:10:04.97,Caption,,0,0,0,,И ОБЩАЕТСЯ. ПОЛИТИК ДЛЯ ТОГО И СУЩЕСТВУЕТ,
Dialogue: 0,0:10:05.13,0:10:07.85,Caption,,0,0,0,,ЧТОБЫ РАЗГОВАРИВАТЬ С ДРУГИМИ ПОЛИТИКАМИ. НО ЕСЛИ
Dialogue: 0,0:10:07.93,0:10:10.25,Caption,,0,0,0,,ПОСТАВИТЬ ЭТО РЯДОМ С ОСТАЛЬНЫМИ СОБЫТИЯМИ,
Dialogue: 0,0:10:10.33,0:10:15.53,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ДРУГОЙ СМЫСЛ. КИЕВ ИЩЕТ НЕ ПРОСТО ПОДДЕРЖКУ. ОН ИЩЕТ ВОЗМОЖНОСТЬ
Dialogue: 0,0:10:15.53,0:10:18.89,Caption,,0,0,0,,ПРОДЛИТЬ РЕСУРСНУЮ БАЗУ. ЕВРОПЕЙСКИЙ ЗАПАС УПИРАЕТСЯ
Dialogue: 0,0:10:18.97,0:10:21.77,Caption,,0,0,0,,В СОБСТВЕННУЮ ОБОРОНУ. АМЕРИКАНСКАЯ АДМИНИСТРАЦИЯ
Dialogue: 0,0:10:21.77,0:10:24.89,Caption,,0,0,0,,ПРОВОДИТ СВОЮ ЛИНИЮ. ЗНАЧИТ СТАВКА ПЕРЕНОСИТСЯ НА
Dialogue: 0,0:10:24.89,0:10:27.61,Caption,,0,0,0,,АМЕРИКАНСКУЮ ВНУТРЕННЮЮ ПОЛИТИКУ. НА ТЕХ,
Dialogue: 0,0:10:27.76,0:10:31.05,Caption,,0,0,0,,КТО ПРИДЁТ ПОТОМ. НА СЛЕДУЮЩИЙ СОСТАВ КОНГРЕССА. НА
Dialogue: 0,0:10:31.05,0:10:34.17,Caption,,0,0,0,,СЛЕДУЮЩИЙ ПАКЕТ. НА СЛЕДУЮЩИЙ БЮДЖЕТ. НА СЛЕДУЮЩИЙ
Dialogue: 0,0:10:34.17,0:10:37.45,Caption,,0,0,0,,СКЛАД. ВСЁ ВРЕМЯ СЛЕДУЮЩИЙ. А УКРАИНА ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:10:37.45,0:10:40.09,Caption,,0,0,0,,ЖИВЁТ НЕ В СЛЕДУЮЩЕМ ГОДУ. ОНА ЖИВЁТ СЕЙЧАС.
Dialogue: 0,0:10:40.33,0:10:44.89,Caption,,0,0,0,,И ВОТ ЭТО, ПОЖАЛУЙ, САМАЯ ЖЁСТКАЯ ЧАСТЬ ВСЕЙ КОНСТРУКЦИИ. ПОЛИТИЧЕСКИЙ
Dialogue: 0,0:10:44.97,0:10:47.85,Caption,,0,0,0,,РАСЧЁТ РАБОТАЕТ ГОДАМИ. ДЕМОГРАФИЯ ТОЖЕ РАБОТАЕТ
Dialogue: 0,0:10:47.93,0:10:50.89,Caption,,0,0,0,,ГОДАМИ. ТОЛЬКО В РАЗНЫЕ СТОРОНЫ. ПОЛИТИК ДУМАЕТ НАДО
Dialogue: 0,0:10:50.89,0:10:53.85,Caption,,0,0,0,,ДОТЯНУТЬ ДО СЛЕДУЮЩЕГО РЕШЕНИЯ. ДЕМОГРАФИЯ ОТВЕЧАЕТ
Dialogue: 0,0:10:53.85,0:10:56.97,Caption,,0,0,0,,ХОРОШО, ТОЛЬКО ЗА ЭТО ВРЕМЯ ЕЩЁ МЕНЬШЕ ДЕТЕЙ РОДИТСЯ.
Dialogue: 0,0:10:57.36,0:11:00.33,Caption,,0,0,0,,ПОЛИТИК ДУМАЕТ НАДО ДОЖДАТЬСЯ НОВОГО ПАКЕТА ПОМОЩИ.
Dialogue: 0,0:11:00.60,0:11:04.97,Caption,,0,0,0,,ЭМИГРАЦИЯ ОТВЕЧАЕТ ХОРОШО, ТОЛЬКО ЗА ЭТО ВРЕМЯ ЕЩЁ ОДНА СЕМЬЯ ОКОНЧАТЕЛЬНО
Dialogue: 0,0:11:05.05,0:11:07.53,Caption,,0,0,0,,УСТРОИТСЯ В ДРУГОЙ СТРАНЕ. ПОЛИТИК ДУМАЕТ НАДО ЕЩЁ
Dialogue: 0,0:11:07.53,0:11:12.52,Caption,,0,0,0,,ГОД ПРОДЕРЖАТЬСЯ. ИНФРАСТРУКТУРА ОТВЕЧАЕТ ХОРОШО,
Dialogue: 0,0:11:12.68,0:11:14.44,Caption,,0,0,0,,ТОЛЬКО ЕЁ ЭТОТ ГОД ТОЖЕ НАДО КАК ТО
Dialogue: 0,0:11:14.44,0:11:17.32,Caption,,0,0,0,,ПЕРЕЖИТЬ. И ТОГДА ВОПРОС О СТОП КРАНЕ СТАНОВИТСЯ
Dialogue: 0,0:11:17.40,0:11:20.52,Caption,,0,0,0,,УЖЕ СОВСЕМ НЕ РИТОРИЧЕСКИМ. ГДЕ НАХОДИТСЯ ТОЧКА,
Dialogue: 0,0:11:20.84,0:11:23.48,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ ЦЕНА НАЧИНАЕТ МЕНЯТЬ САМУ СТРАТЕГИЮ?
Dialogue: 0,0:11:23.77,0:11:27.00,Caption,,0,0,0,,НЕ ОЧЕРЕДНОЙ БЮДЖЕТ. НЕ ОЧЕРЕДНОЙ ПАКЕТ РАКЕТ. НЕ
Dialogue: 0,0:11:27.08,0:11:30.68,Caption,,0,0,0,,ОЧЕРЕДНОЕ ЗАЯВЛЕНИЕ. А СТРАТЕГИЮ. ПОТОМУ ЧТО РЕСУРС
Dialogue: 0,0:11:30.76,0:11:33.96,Caption,,0,0,0,,МОЖНО ИСКАТЬ ДОЛГО. ЕВРОПА ЕЩЁ ДАСТ ДЕНЕГ. АМЕРИКА
Dialogue: 0,0:11:34.04,0:11:36.84,Caption,,0,0,0,,ЕЩЁ ЧТО ТО ПОСТАВИТ. САМА УКРАИНА ЕЩЁ ЧТО
Dialogue: 0,0:11:36.92,0:11:39.96,Caption,,0,0,0,,ТО ПРОИЗВЕДЁТ. ЕЩЁ НАЙДУТСЯ ГЕНЕРАТОРЫ. ЕЩЁ
Dialogue: 0,0:11:39.96,0:11:43.56,Caption,,0,0,0,,ВОССТАНОВЯТ ЛИНИИ. ЕЩЁ ОТРЕМОНТИРУЮТ МОСТ. ЕЩЁ КТО
Dialogue: 0,0:11:43.64,0:11:47.40,Caption,,0,0,0,,ТО ВЕРНЁТСЯ. ЕЩЁ КОГО ТО МОБИЛИЗУЮТ. ОТДЕЛЬНО КАЖДЫЙ
Dialogue: 0,0:11:47.48,0:11:50.20,Caption,,0,0,0,,ПУНКТ ВЫГЛЯДИТ РЕШАЕМЫМ. ПРОБЛЕМА НАЧИНАЕТСЯ,
Dialogue: 0,0:11:50.52,0:11:53.48,Caption,,0,0,0,,КОГДА ОНИ ПРОИСХОДЯТ ОДНОВРЕМЕННО. ВОТ ТОГДА ЭТО УЖЕ
Dialogue: 0,0:11:53.56,0:11:56.68,Caption,,0,0,0,,НЕ СЕМЬ ОТДЕЛЬНЫХ ПРОБЛЕМ. ПЕРЕД ВАМИ ОДНА СИСТЕМА,
Dialogue: 0,0:11:57.00,0:11:59.80,Caption,,0,0,0,,КОТОРАЯ ТРЕБУЕТ ВСЁ БОЛЬШЕ РЕСУРСОВ ПРОСТО ДЛЯ ТОГО,
Dialogue: 0,0:11:59.96,0:12:03.00,Caption,,0,0,0,,ЧТОБЫ ОСТАВАТЬСЯ В ПРЕЖНЕМ РЕЖИМЕ. И ЗДЕСЬ ЧЕЛОВЕК
Dialogue: 0,0:12:03.00,0:12:05.40,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО НАЧИНАЕТ ВЫГЛЯДЕТЬ САМЫМ УДОБНЫМ
Dialogue: 0,0:12:05.40,0:12:08.12,Caption,,0,0,0,,РЕСУРСОМ. ОН НЕ ЛЕЖИТ НА СКЛАДЕ С ЦЕННИКОМ.
Dialogue: 0,0:12:08.28,0:12:11.32,Caption,,0,0,0,,ЕГО СТОИМОСТЬ НЕ ПОЯВЛЯЕТСЯ В ВОЕННОМ КОНТРАКТЕ. НА
Dialogue: 0,0:12:11.40,0:12:14.20,Caption,,0,0,0,,НЕГО НЕ НУЖНО ЖДАТЬ ЭКСПОРТНУЮ ЛИЦЕНЗИЮ. ПОКА ОН
Dialogue: 0,0:12:14.28,0:12:19.24,Caption,,0,0,0,,ЕСТЬ, СИСТЕМА ПРОСТО СЧИТАЕТ, ЧТО ОН ЕЩЁ ЕСТЬ. А ПОТОМ ПРИХОДИТ СТАТИСТИКА
Dialogue: 0,0:12:19.24,0:12:21.64,Caption,,0,0,0,,РОЖДАЕМОСТИ. И ВНЕЗАПНО ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:12:21.80,0:12:24.44,Caption,,0,0,0,,ЧТО СИСТЕМА УЖЕ НАЧАЛА ЕСТЬ СОБСТВЕННОЕ БУДУЩЕЕ.
Dialogue: 0,0:12:26.72,0:12:29.37,Caption,,0,0,0,,ВОТ ПОЭТОМУ ЦИФРА МИНУС ТРИДЦАТЬ ВОСЕМЬ ЦЕЛЫХ ЧЕТЫРЕ
Dialogue: 0,0:12:29.37,0:12:32.01,Caption,,0,0,0,,ДЕСЯТЫХ ПРОЦЕНТА ДЛЯ МЕНЯ В ЭТОЙ ИСТОРИИ ВАЖНЕЕ
Dialogue: 0,0:12:32.01,0:12:34.89,Caption,,0,0,0,,ОЧЕНЬ МНОГИХ ГРОМКИХ ЗАЯВЛЕНИЙ. НЕ ПОТОМУ,
Dialogue: 0,0:12:35.10,0:12:37.61,Caption,,0,0,0,,ЧТО ЗАВТРА ОТ НЕЁ ИЗМЕНИТСЯ ЛИНИЯ ФРОНТА. НЕ
Dialogue: 0,0:12:37.61,0:12:42.01,Caption,,0,0,0,,ИЗМЕНИТСЯ. НЕ ПОТОМУ, ЧТО ЗАВТРА ИЗ ЗА НЕЁ ОСТАНОВИТСЯ КОНФЛИКТ. ТОЖЕ
Dialogue: 0,0:12:42.09,0:12:45.05,Caption,,0,0,0,,НЕТ. А ПОТОМУ, ЧТО ОНА ПОКАЗЫВАЕТ ЦЕНУ,
Dialogue: 0,0:12:45.21,0:12:48.25,Caption,,0,0,0,,КОТОРУЮ СЕГОДНЯ ПОЧТИ НИКТО ФИЗИЧЕСКИ НЕ ЗАМЕЧАЕТ.
Dialogue: 0,0:12:48.52,0:12:51.37,Caption,,0,0,0,,ПОГАСШИЙ СВЕТ ЗАМЕТНО СРАЗУ. НЕТ ВОДЫ,
Dialogue: 0,0:12:51.59,0:12:53.85,Caption,,0,0,0,,ЗАМЕТНО СРАЗУ. ПРИЛЕТЕЛА РАКЕТА,
Dialogue: 0,0:12:54.02,0:12:59.13,Caption,,0,0,0,,ЗАМЕТНО СРАЗУ. РАЗРУШЕН МОСТ, ЗАМЕТНО СРАЗУ. А ОТСУТСТВУЮЩЕГО РЕБЁНКА НИКТО НЕ
Dialogue: 0,0:12:59.21,0:13:02.25,Caption,,0,0,0,,ЗАМЕЧАЕТ. ЕГО ПРОСТО НЕТ. И ТОЛЬКО ЧЕРЕЗ ДВАДЦАТЬ
Dialogue: 0,0:13:02.33,0:13:04.89,Caption,,0,0,0,,ЛЕТ ГОСУДАРСТВО ОБНАРУЖИВАЕТ ПУСТОЕ МЕСТО ТАМ,
Dialogue: 0,0:13:05.21,0:13:07.69,Caption,,0,0,0,,ГДЕ ДОЛЖЕН БЫЛ СТОЯТЬ ВЗРОСЛЫЙ ЧЕЛОВЕК. И ВОТ
Dialogue: 0,0:13:07.69,0:13:10.33,Caption,,0,0,0,,ТОГДА УЖЕ ПО СУСЕКАМ ОСОБО НЕ ПОСКРЕБЁШЬ. PATRIOT
Dialogue: 0,0:13:10.33,0:13:13.69,Caption,,0,0,0,,МОЖНО КУПИТЬ. ГЕНЕРАТОР МОЖНО ПРИВЕЗТИ. МОСТ МОЖНО
Dialogue: 0,0:13:13.69,0:13:16.25,Caption,,0,0,0,,ВОССТАНОВИТЬ. ДЕНЬГИ МОЖНО ЗАНЯТЬ. ДАЖЕ
Dialogue: 0,0:13:16.33,0:13:19.05,Caption,,0,0,0,,ПОЛИТИЧЕСКОГО СОЮЗНИКА ИНОГДА МОЖНО ПОМЕНЯТЬ. А
Dialogue: 0,0:13:19.05,0:13:21.53,Caption,,0,0,0,,ДВАДЦАТИЛЕТНЕГО ЧЕЛОВЕКА ЧЕРЕЗ ДВАДЦАТЬ ЛЕТ ЗАКАЗАТЬ
Dialogue: 0,0:13:21.61,0:13:23.85,Caption,,0,0,0,,УЖЕ НЕГДЕ. ВОТ ЭТО И ЕСТЬ ТОТ СЧЁТ,
Dialogue: 0,0:13:24.01,0:13:26.97,Caption,,0,0,0,,КОТОРЫЙ ПРИХОДИТ САМЫМ ПОСЛЕДНИМ. И ИМЕННО ПОЭТОМУ
Dialogue: 0,0:13:27.05,0:13:30.33,Caption,,0,0,0,,ВОПРОС ОСТАЁТСЯ ПРЕЖНИМ. ЕСЛИ ДАЖЕ ТАКАЯ ЦЕНА ПОКА
Dialogue: 0,0:13:30.41,0:13:33.29,Caption,,0,0,0,,НЕ СТАНОВИТСЯ СТОП КРАНОМ, ТОГДА ЧТО ВООБЩЕ ИМ СТАНЕТ?
