Dialogue: 0,0:00:00.12,0:00:02.92,Caption,,0,0,0,,ЕВРОПЕ СЕЙЧАС ПРЕДЛАГАЮТ ОЧЕНЬ СЛОЖНОЕ УПРАЖНЕНИЕ.
Dialogue: 0,0:00:03.20,0:00:05.48,Caption,,0,0,0,,НАЙДИТЕ ОДНОГО ЧЕЛОВЕКА. ОДНОГО,
Dialogue: 0,0:00:05.56,0:00:07.96,Caption,,0,0,0,,РЕБЯТА. ЧТОБЫ ОН МОГ СЕСТЬ ЗА СТОЛ И
Dialogue: 0,0:00:08.04,0:00:10.68,Caption,,0,0,0,,ГОВОРИТЬ ОТ ВАШЕГО ИМЕНИ. ПОТОМУ ЧТО ОСТАЛЬНЫЕ,
Dialogue: 0,0:00:10.81,0:00:14.12,Caption,,0,0,0,,ПОХОЖЕ, ЖДАТЬ, ПОКА ВЫ ТАМ ДОГОВОРИТЕСЬ МЕЖДУ СОБОЙ,
Dialogue: 0,0:00:14.20,0:00:17.00,Caption,,0,0,0,,НЕ СОБИРАЮТСЯ. И ВОТ ЗДЕСЬ ВОПРОС УЖЕ СОВСЕМ
Dialogue: 0,0:00:17.08,0:00:20.28,Caption,,0,0,0,,НЕ СМЕШНОЙ. А ЧТО БУДЕТ, ЕСЛИ ОДНАЖДЫ ОКАЖЕТСЯ,
Dialogue: 0,0:00:20.46,0:00:24.28,Caption,,0,0,0,,ЧТО ЖДАТЬ ВАС ВООБЩЕ НЕЗАЧЕМ? ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:24.60,0:00:26.84,Caption,,0,0,0,,ГДЕ МЫ СМОТРИМ НЕ НА ОДНУ ГРОМКУЮ ФРАЗУ,
Dialogue: 0,0:00:26.92,0:00:29.32,Caption,,0,0,0,,А НА ТО, ЧТО ЗА НЕЙ НАЧИНАЕТ ДВИГАТЬСЯ,
Dialogue: 0,0:00:29.40,0:00:32.28,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ. РОССИЯ
Dialogue: 0,0:00:32.28,0:00:34.84,Caption,,0,0,0,,ПРЕДЛОЖИЛА СТРАНАМ НАТО ТРИ ВАРИАНТА НОВЫХ
Dialogue: 0,0:00:34.84,0:00:37.72,Caption,,0,0,0,,ДОГОВОРЁННОСТЕЙ ПО БЕЗОПАСНОСТИ. НЕ ОДНУ КРАСИВУЮ
Dialogue: 0,0:00:37.72,0:00:39.32,Caption,,0,0,0,,ДЕКЛАРАЦИЮ НА ДВАДЦАТЬ СТРАНИЦ,
Dialogue: 0,0:00:39.55,0:00:41.00,Caption,,0,0,0,,КОТОРУЮ ПОТОМ НИКТО НЕ ЧИТАЕТ,
Dialogue: 0,0:00:41.40,0:00:44.36,Caption,,0,0,0,,А ТРИ ВПОЛНЕ ПОНЯТНЫЕ КОНСТРУКЦИИ. ПЕРВАЯ,
Dialogue: 0,0:00:44.52,0:00:46.84,Caption,,0,0,0,,ВЗАИМНАЯ ВОЕННАЯ ПОМОЩЬ. ВТОРАЯ,
Dialogue: 0,0:00:47.14,0:00:49.24,Caption,,0,0,0,,ПОЛИТИЧЕСКОЕ ОБЯЗАТЕЛЬСТВО НЕ ПОДДЕРЖИВАТЬ
Dialogue: 0,0:00:49.24,0:00:52.44,Caption,,0,0,0,,ПРОТИВНИКА ДРУГОЙ СТОРОНЫ В СЛУЧАЕ АГРЕССИИ. ТРЕТЬЯ,
Dialogue: 0,0:00:52.75,0:00:55.24,Caption,,0,0,0,,ДВУСТОРОННИЕ ПАКТЫ О НЕНАПАДЕНИИ С ОТДЕЛЬНЫМИ
Dialogue: 0,0:00:55.24,0:00:57.56,Caption,,0,0,0,,СТРАНАМИ НАТО. ВОТ ТРЕТИЙ ВАРИАНТ ОСОБЕННО
Dialogue: 0,0:00:57.56,0:01:00.44,Caption,,0,0,0,,ИНТЕРЕСНЫЙ. ПОТОМУ ЧТО НАТО У НАС ВРОДЕ КОЛЛЕКТИВНЫЙ
Dialogue: 0,0:01:00.44,0:01:03.16,Caption,,0,0,0,,АЛЬЯНС. ВСЕ ВМЕСТЕ, ПЛЕЧОМ К ПЛЕЧУ,
Dialogue: 0,0:01:03.40,0:01:06.20,Caption,,0,0,0,,ОДНА БОЛЬШАЯ СЕМЬЯ. А МОСКВА ГОВОРИТ ХОРОШО,
Dialogue: 0,0:01:06.28,0:01:09.64,Caption,,0,0,0,,ХОТИТЕ, ДАВАЙТЕ РАЗГОВАРИВАТЬ С КАЖДЫМ ОТДЕЛЬНО. ПОЛЬША
Dialogue: 0,0:01:09.64,0:01:12.92,Caption,,0,0,0,,ОТДЕЛЬНО. ГЕРМАНИЯ ОТДЕЛЬНО. ФИНЛЯНДИЯ ОТДЕЛЬНО.
Dialogue: 0,0:01:15.19,0:01:17.44,Caption,,0,0,0,,КТО ГОТОВ ОБСУЖДАТЬ КОНКРЕТНЫЕ ГАРАНТИИ,
Dialogue: 0,0:01:17.56,0:01:20.48,Caption,,0,0,0,,ТОТ САДИТСЯ И ОБСУЖДАЕТ. И ТУТ СРАЗУ ВОЗНИКАЕТ
Dialogue: 0,0:01:20.48,0:01:23.84,Caption,,0,0,0,,НЕУДОБНАЯ ВЕЩЬ. ЕСЛИ ОТДЕЛЬНАЯ СТРАНА НАТО ПОЛУЧАЕТ
Dialogue: 0,0:01:23.92,0:01:26.40,Caption,,0,0,0,,ОТ РОССИИ ОТДЕЛЬНЫЕ ГАРАНТИИ БЕЗОПАСНОСТИ,
Dialogue: 0,0:01:26.72,0:01:29.20,Caption,,0,0,0,,ОТДЕЛЬНЫЕ ОБЯЗАТЕЛЬСТВА И ОТДЕЛЬНЫЙ ДОГОВОР,
Dialogue: 0,0:01:29.52,0:01:31.76,Caption,,0,0,0,,ТО ЧТО СТАНОВИТСЯ ГЛАВНЫМ ДЛЯ ЭТОЙ СТРАНЫ В
Dialogue: 0,0:01:31.76,0:01:36.80,Caption,,0,0,0,,РЕАЛЬНОЙ КРИЗИСНОЙ СИТУАЦИИ? ОБЩАЯ БУМАГА АЛЬЯНСА ИЛИ КОНКРЕТНАЯ ДВУСТОРОННЯЯ
Dialogue: 0,0:01:36.80,0:01:39.04,Caption,,0,0,0,,БУМАГА, ПОД КОТОРОЙ СТОЯТ ДВЕ ПОДПИСИ?
Dialogue: 0,0:01:39.31,0:01:42.88,Caption,,0,0,0,,РЕЧЬ НЕ О ТОМ, ЧТО НАТО ЗАВТРА КУДА ТО ИСЧЕЗНЕТ. РЕЧЬ О
Dialogue: 0,0:01:42.88,0:01:46.00,Caption,,0,0,0,,САМОЙ КОНСТРУКЦИИ. МОСКВА ПРЕДЛАГАЕТ ЕВРОПЕЙЦАМ НЕ
Dialogue: 0,0:01:46.00,0:01:48.08,Caption,,0,0,0,,ЛОЗУНГ, А НЕСКОЛЬКО ВАРИАНТОВ,
Dialogue: 0,0:01:48.31,0:01:50.00,Caption,,0,0,0,,КАК ПЕРЕСТРОИТЬ ОТНОШЕНИЯ ТАК,
Dialogue: 0,0:01:50.24,0:01:52.80,Caption,,0,0,0,,ЧТОБЫ БЕЗОПАСНОСТЬ ОДНОЙ СТОРОНЫ НЕ СТРОИЛАСЬ НА
Dialogue: 0,0:01:52.88,0:01:55.92,Caption,,0,0,0,,СТРАХЕ ДРУГОЙ. МЫ ОБ ЭТОМ УЖЕ ГОВОРИЛИ. БЕЗОПАСНОСТЬ
Dialogue: 0,0:01:55.92,0:01:58.72,Caption,,0,0,0,,ОДНОГО СОСЕДА НЕ СУЩЕСТВУЕТ ОТДЕЛЬНО ОТ БЕЗОПАСНОСТИ
Dialogue: 0,0:01:58.72,0:02:01.28,Caption,,0,0,0,,ДРУГОГО. НЕЛЬЗЯ ПОСТАВИТЬ РАКЕТЫ ВОЗЛЕ ЧУЖОГО
Dialogue: 0,0:02:01.28,0:02:04.72,Caption,,0,0,0,,ЗАБОРА, ПОТОМ ПОВЕСИТЬ ТАБЛИЧКУ "ЭТО ДЛЯ НАШЕЙ БЕЗОПАСНОСТИ"
Dialogue: 0,0:02:04.80,0:02:08.80,Caption,,0,0,0,,И УДИВЛЯТЬСЯ, ПОЧЕМУ СОСЕД НЕРВНИЧАЕТ. ТАК ЭТО НЕ РАБОТАЕТ ДАЖЕ
Dialogue: 0,0:02:08.88,0:02:11.36,Caption,,0,0,0,,В ОБЫЧНОМ ДВОРЕ. В БОЛЬШОЙ ПОЛИТИКЕ ТЕМ БОЛЕЕ.
Dialogue: 0,0:02:11.90,0:02:14.64,Caption,,0,0,0,,И ТУТ ПОЯВЛЯЕТСЯ ВАШИНГТОН. АМЕРИКАНЦЫ ПОПРОСИЛИ
Dialogue: 0,0:02:14.72,0:02:17.28,Caption,,0,0,0,,РОССИЮ ПОДГОТОВИТЬ ПРЕДЛОЖЕНИЯ ПО НОВЫМ ПРАВИЛАМ
Dialogue: 0,0:02:17.28,0:02:20.24,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ. ПРИЧЁМ РЕЧЬ ИДЁТ НЕ О ТОМ,
Dialogue: 0,0:02:20.48,0:02:23.12,Caption,,0,0,0,,ЧТОБЫ ЕЩЁ РАЗ НАПИСАТЬ КРАСИВОЕ ЗАЯВЛЕНИЕ О МИРЕ.
Dialogue: 0,0:02:25.39,0:02:28.11,Caption,,0,0,0,,ВАШИНГТОН ХОЧЕТ ОБСУЖДАТЬ НОВЫЙ ФОРМАТ ОТНОШЕНИЙ
Dialogue: 0,0:02:28.19,0:02:30.91,Caption,,0,0,0,,РОССИИ И ЕВРОПЫ ВМЕСТЕ С УРЕГУЛИРОВАНИЕМ УКРАИНСКОГО
Dialogue: 0,0:02:30.91,0:02:33.15,Caption,,0,0,0,,КОНФЛИКТА. МЫ ЭТО УЖЕ РАЗБИРАЛИ,
Dialogue: 0,0:02:33.30,0:02:35.15,Caption,,0,0,0,,ПОЭТОМУ ПОВТОРЯТЬ ВСЮ ИСТОРИЮ НЕ БУДЕМ.
Dialogue: 0,0:02:35.71,0:02:38.19,Caption,,0,0,0,,РОССИЙСКИЕ ТРЕБОВАНИЯ ПО БЕЗОПАСНОСТИ ПОЯВИЛИСЬ НЕ
Dialogue: 0,0:02:38.19,0:02:40.83,Caption,,0,0,0,,ВЧЕРА. В КОНЦЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО ГОДА
Dialogue: 0,0:02:40.83,0:02:43.71,Caption,,0,0,0,,МОСКВА УЖЕ ПРЕДЛАГАЛА США И НАТО ДОГОВОРИТЬСЯ О
Dialogue: 0,0:02:43.71,0:02:46.51,Caption,,0,0,0,,ПРАВИЛАХ, КОТОРЫЕ КАСАЛИСЬ РАСШИРЕНИЯ НАТО,
Dialogue: 0,0:02:46.75,0:02:49.47,Caption,,0,0,0,,РАЗМЕЩЕНИЯ ВООРУЖЕНИЙ И ВОЕННОЙ ИНФРАСТРУКТУРЫ.
Dialogue: 0,0:02:49.94,0:02:52.59,Caption,,0,0,0,,ТОГДА ДОГОВОРИТЬСЯ НЕ ПОЛУЧИЛОСЬ. ПРОШЛО ПОЧТИ ПЯТЬ
Dialogue: 0,0:02:52.67,0:02:55.31,Caption,,0,0,0,,ЛЕТ. И ТЕПЕРЬ АМЕРИКАНЦЫ САМИ ГОВОРЯТ ПРЕЖНЯЯ
Dialogue: 0,0:02:55.31,0:03:00.11,Caption,,0,0,0,,КОНСТРУКЦИЯ НЕ РАБОТАЕТ, НАДО СТРОИТЬ НОВУЮ. НУ ЗДРАВСТВУЙТЕ. ДОШЛО. ТОЛЬКО
Dialogue: 0,0:03:00.19,0:03:02.43,Caption,,0,0,0,,ПОКА ВАШИНГТОН И МОСКВА НАЧИНАЮТ ОБСУЖДАТЬ,
Dialogue: 0,0:03:02.60,0:03:06.75,Caption,,0,0,0,,ЧТО ИМЕННО СТРОИТЬ, ЕВРОПА СТАЛКИВАЕТСЯ С ЗАДАЧЕЙ ПОСЛОЖНЕЕ ЯДЕРНОЙ
Dialogue: 0,0:03:06.75,0:03:10.83,Caption,,0,0,0,,ФИЗИКИ. ЕЙ НАДО НАЙТИ ОДНОГО ЧЕЛОВЕКА. ДЖАРЕД КУШНЕР
Dialogue: 0,0:03:10.83,0:03:13.79,Caption,,0,0,0,,ГОВОРИТ ЕВРОПЕЙЦАМ ОПРЕДЕЛИТЕ ЕДИНОГО ПРЕДСТАВИТЕЛЯ
Dialogue: 0,0:03:13.79,0:03:17.31,Caption,,0,0,0,,ДЛЯ ПЕРЕГОВОРОВ С РОССИЕЙ. ОДНОГО. НЕ СЕМЬ КОМИССИЙ.
Dialogue: 0,0:03:17.60,0:03:20.27,Caption,,0,0,0,,НЕ ДВАДЦАТЬ СЕМЬ НАЦИОНАЛЬНЫХ ПОЗИЦИЙ. НЕ ПЯТЬ
Dialogue: 0,0:03:20.27,0:03:22.83,Caption,,0,0,0,,КАНЦЛЕРОВ НА ПОЛСТАВКИ. ОДНОГО ЧЕЛОВЕКА,
Dialogue: 0,0:03:23.01,0:03:25.55,Caption,,0,0,0,,КОТОРЫЙ МОЖЕТ СКАЗАТЬ Я ГОВОРЮ ОТ ИМЕНИ ЕВРОПЫ,
Dialogue: 0,0:03:25.79,0:03:30.35,Caption,,0,0,0,,ВОТ НАША ПОЗИЦИЯ, ВОТ НАШИ ПРЕДЛОЖЕНИЯ. МЕДИНСКИЙ ПОСЛЕ АБУ ДАБИ
Dialogue: 0,0:03:30.35,0:03:33.07,Caption,,0,0,0,,ОБЪЯСНИЛ ЕЩЁ ПРОЩЕ. РОССИЙСКАЯ ДЕЛЕГАЦИЯ С
Dialogue: 0,0:03:33.07,0:03:35.95,Caption,,0,0,0,,ПРИЕХАВШИМИ ЕВРОПЕЙЦАМИ НЕ РАЗГОВАРИВАЛА. ПОЧЕМУ?
Dialogue: 0,0:03:38.21,0:03:41.66,Caption,,0,0,0,,ПОТОМУ ЧТО НЕПОНЯТНО, В КАКОМ ОНИ ВООБЩЕ СТАТУСЕ И ЧТО КОНКРЕТНО
Dialogue: 0,0:03:41.66,0:03:44.14,Caption,,0,0,0,,ПРЕДЛАГАЮТ. ЕСЛИ ПРИЕХАЛИ ТУРИСТАМИ,
Dialogue: 0,0:03:44.22,0:03:47.42,Caption,,0,0,0,,СКАЗАЛ ОН, МОЖНО ПООБЩАТЬСЯ В ЛОББИ БАРЕ. ЖЁСТКО?
Dialogue: 0,0:03:47.56,0:03:51.18,Caption,,0,0,0,,ДА. НО САМА СИТУАЦИЯ ЕЩЁ ЖЁСТЧЕ. АМЕРИКАНЦЫ ГОВОРЯТ
Dialogue: 0,0:03:51.26,0:03:55.34,Caption,,0,0,0,,ЕВРОПЕ РЕБЯТА, ОПРЕДЕЛИТЕСЬ БЫСТРЕЕ. МЫ ДАЛЬШЕ ЕДЕМ. У НАС ВПЕРЕДИ
Dialogue: 0,0:03:55.34,0:03:58.86,Caption,,0,0,0,,РАЗГОВОРЫ УЖЕ НЕ ПРО ТО, КТО ГДЕ СЯДЕТ В АБУ ДАБИ. У НАС
Dialogue: 0,0:03:58.94,0:04:02.14,Caption,,0,0,0,,ВОПРОС О ТОМ, КАК ВООБЩЕ БУДЕТ УСТРОЕНА БЕЗОПАСНОСТЬ НА
Dialogue: 0,0:04:02.14,0:04:04.62,Caption,,0,0,0,,КОНТИНЕНТЕ. А ЕВРОПА ВСЁ ЕЩЁ РЕШАЕТ,
Dialogue: 0,0:04:04.86,0:04:07.02,Caption,,0,0,0,,КТО У НЕЁ ИМЕЕТ ПРАВО ОТКРЫТЬ РОТ ОТ
Dialogue: 0,0:04:07.02,0:04:10.94,Caption,,0,0,0,,ИМЕНИ ВСЕХ ОСТАЛЬНЫХ. И ВЕДЬ ЗДЕСЬ НЕ ПРОСТО АДМИНИСТРАТИВНАЯ ПРОБЛЕМА.
Dialogue: 0,0:04:11.26,0:04:14.94,Caption,,0,0,0,,ВНУТРИ ЕС РЕАЛЬНО РАЗНЫЕ ИНТЕРЕСЫ. ОДНИ СТРАНЫ ХОТЯТ
Dialogue: 0,0:04:15.02,0:04:17.74,Caption,,0,0,0,,ЕЩЁ БОЛЬШЕ ДАВЛЕНИЯ НА РОССИЮ. ДРУГИЕ ХОТЯТ
Dialogue: 0,0:04:17.74,0:04:21.18,Caption,,0,0,0,,ТОРГОВАТЬ. ТРЕТЬИ ХОТЯТ ГАРАНТИЙ. ЧЕТВЁРТЫЕ ХОТЯТ,
Dialogue: 0,0:04:21.34,0:04:24.22,Caption,,0,0,0,,ЧТОБЫ АМЕРИКАНЦЫ НИКУДА НЕ УХОДИЛИ. ПЯТЫЕ УЖЕ
Dialogue: 0,0:04:24.22,0:04:26.94,Caption,,0,0,0,,НАПРЯМУЮ ЗВОНЯТ МОСКВЕ. ВОТ И ВЫБЕРИ ОДНОГО
Dialogue: 0,0:04:26.94,0:04:29.74,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЯ ИЗ ЭТОЙ ДРУЖНОЙ КОМПАНИИ. ЕСЛИ ВАМ
Dialogue: 0,0:04:29.74,0:04:33.26,Caption,,0,0,0,,НРАВИТСЯ ТАКОЙ ФОРМАТ, ГДЕ МЫ НЕ СЧИТАЕМ КОЛИЧЕСТВО РУКОПОЖАТИЙ,
Dialogue: 0,0:04:33.34,0:04:36.70,Caption,,0,0,0,,А СМОТРИМ, КТО РЕАЛЬНО ПОЛУЧАЕТ ПРАВО ПРИНИМАТЬ РЕШЕНИЯ,
Dialogue: 0,0:04:36.84,0:04:39.58,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ДАЛЬШЕ МАСШТАБ СТАНОВИТСЯ
Dialogue: 0,0:04:39.58,0:04:42.94,Caption,,0,0,0,,ЕЩЁ ИНТЕРЕСНЕЕ. БЕЛОРУССКИЙ МИНИСТР ИНОСТРАННЫХ ДЕЛ
Dialogue: 0,0:04:42.94,0:04:46.86,Caption,,0,0,0,,РЫЖЕНКОВ ГОВОРИТ, ЧТО БЕЗОПАСНОСТЬ В ЕВРАЗИИ ПРИХОДИТСЯ ВЫСТРАИВАТЬ
Dialogue: 0,0:04:46.86,0:04:49.98,Caption,,0,0,0,,БЕЗ АКТИВНОГО УЧАСТИЯ ЕВРОСОЮЗА. ВЫ ВДУМАЙТЕСЬ В
Dialogue: 0,0:04:50.06,0:04:55.70,Caption,,0,0,0,,САМУ ФРАЗУ. БЕЗ АКТИВНОГО УЧАСТИЯ ЕВРОСОЮЗА. ТО ЕСТЬ
Dialogue: 0,0:04:55.70,0:04:58.90,Caption,,0,0,0,,БЕЗОПАСНОСТЬ ПРОСТРАНСТВА, В КОТОРОМ НАХОДИТСЯ САМА ЕВРОПА,
Dialogue: 0,0:04:59.15,0:05:02.18,Caption,,0,0,0,,УЖЕ ОБСУЖДАЮТ БЕЗ ЕЁ АКТИВНОГО УЧАСТИЯ. ЕЩЁ
Dialogue: 0,0:05:02.18,0:05:04.34,Caption,,0,0,0,,НЕСКОЛЬКО ЛЕТ НАЗАД ЗА ТАКОЕ В БРЮССЕЛЕ,
Dialogue: 0,0:05:04.58,0:05:07.94,Caption,,0,0,0,,НАВЕРНОЕ, ДОЛГО БЫ СМЕЯЛИСЬ. СЕГОДНЯ УЖЕ НЕ ТАК СМЕШНО.
Dialogue: 0,0:05:08.42,0:05:11.38,Caption,,0,0,0,,И ТУТ ОЧЕНЬ ВОВРЕМЯ ВСПОМИНАЕТСЯ ЯЛТА. ФЕВРАЛЬ
Dialogue: 0,0:05:11.38,0:05:14.10,Caption,,0,0,0,,ТЫСЯЧА ДЕВЯТЬСОТ СОРОК ПЯТОГО ГОДА. ЗА СТОЛОМ
Dialogue: 0,0:05:14.10,0:05:17.14,Caption,,0,0,0,,СТАЛИН, РУЗВЕЛЬТ И ЧЕРЧИЛЛЬ. СОВЕТСКИЙ СОЮЗ,
Dialogue: 0,0:05:17.29,0:05:20.34,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ И ВЕЛИКОБРИТАНИЯ. ФРАНЦИИ ЗА ЭТИМ
Dialogue: 0,0:05:20.34,0:05:23.38,Caption,,0,0,0,,СТОЛОМ НЕТ. ИТАЛИИ НЕТ. ГЕРМАНИЮ НИКТО НЕ
Dialogue: 0,0:05:23.38,0:05:25.94,Caption,,0,0,0,,СПРАШИВАЕТ. БОЛЬШИНСТВО ЕВРОПЕЙСКИХ ГОСУДАРСТВ
Dialogue: 0,0:05:26.02,0:05:28.34,Caption,,0,0,0,,ВООБЩЕ НЕ УЧАСТВУЮТ В РАЗГОВОРЕ. А РЕШЕНИЯ
Dialogue: 0,0:05:28.34,0:05:32.02,Caption,,0,0,0,,ПРИНИМАЮТСЯ ТАКИЕ, КОТОРЫЕ ПОТОМ ОПРЕДЕЛЯЮТ УСТРОЙСТВО ЕВРОПЫ НА
Dialogue: 0,0:05:32.02,0:05:34.66,Caption,,0,0,0,,ДЕСЯТИЛЕТИЯ. НИКТО НЕ БЕГАЛ ПО ЗАЛУ И НЕ
Dialogue: 0,0:05:34.66,0:05:38.02,Caption,,0,0,0,,СПРАШИВАЛ А УДОБНО ЛИ ПАРИЖУ, А СОГЛАСНЫ ЛИ В РИМЕ,
Dialogue: 0,0:05:38.26,0:05:40.10,Caption,,0,0,0,,А КАК НА ЭТО СМОТРЯТ ЕЩЁ ГДЕ НИБУДЬ.
Dialogue: 0,0:05:40.50,0:05:43.94,Caption,,0,0,0,,ДОГОВОРИЛИСЬ ТЕ, У КОГО БЫЛА СИЛА ДОГОВОРИТЬСЯ. ВОТ И ВСЁ.
Dialogue: 0,0:05:44.42,0:05:46.98,Caption,,0,0,0,,КОГДА КРУПНЕЙШИЕ ДЕРЖАВЫ РЕШАЮТ БОЛЬШОЙ ВОПРОС,
Dialogue: 0,0:05:47.24,0:05:50.82,Caption,,0,0,0,,ЧИХАТЬ ОНИ ХОТЕЛИ НА ТЕХ, КТО НЕ УСПЕЛ ЗАНЯТЬ СТУЛ. ПРО ВАС И
Dialogue: 0,0:05:50.82,0:05:53.30,Caption,,0,0,0,,НЕ ВСПОМНЯТ. БУДЕТЕ ПУТАТЬСЯ ПОД НОГАМИ,
Dialogue: 0,0:05:53.46,0:05:56.10,Caption,,0,0,0,,ПЕРЕСТУПЯТ И ПОЙДУТ ДАЛЬШЕ. ВОТ В ЧЁМ МАСШТАБ.
Dialogue: 0,0:05:56.50,0:06:00.10,Caption,,0,0,0,,А ТЕПЕРЬ ПОСМОТРИТЕ, ЧЕМ В ЭТОТ МОМЕНТ ЗАНЯТА КАЯ КАЛЛАС. ОНА
Dialogue: 0,0:06:00.10,0:06:03.86,Caption,,0,0,0,,ГОВОРИТ, ЧТО РОССИЯ ХОЧЕТ СНЯТИЯ САНКЦИЙ И РАЗМОРОЗКИ СВОИХ
Dialogue: 0,0:06:03.86,0:06:08.62,Caption,,0,0,0,,АКТИВОВ. И ПОДЧЁРКИВАЕТ ЭТО РЕШЕНИЯ ЕВРОПЫ,
Dialogue: 0,0:06:08.86,0:06:11.42,Caption,,0,0,0,,ПОЭТОМУ НИКТО КРОМЕ ЕВРОПЫ ИХ ПРИНЯТЬ НЕ МОЖЕТ.
Dialogue: 0,0:06:11.79,0:06:14.54,Caption,,0,0,0,,НУ ХОРОШО. ТОЛЬКО ОТКУДА ВООБЩЕ ВЗЯЛАСЬ УВЕРЕННОСТЬ,
Dialogue: 0,0:06:14.70,0:06:16.94,Caption,,0,0,0,,ЧТО ИМЕННО ЭТО БУДЕТ ГЛАВНЫМ ПРИЗОМ?
Dialogue: 0,0:06:17.39,0:06:19.98,Caption,,0,0,0,,ДВЕСТИ МИЛЛИАРДОВ ЕВРО ЗВУЧАТ ОЧЕНЬ СОЛИДНО,
Dialogue: 0,0:06:20.20,0:06:22.86,Caption,,0,0,0,,ПОКА РАЗГОВОР ИДЁТ В ПРЕДЕЛАХ ЕВРОПЕЙСКОГО КАБИНЕТА.
Dialogue: 0,0:06:23.18,0:06:25.66,Caption,,0,0,0,,А ЕСЛИ ДОГОВОРЁННОСТЬ ПОЙДЁТ НА УРОВНЕ США,
Dialogue: 0,0:06:25.75,0:06:29.90,Caption,,0,0,0,,РОССИИ И КИТАЯ, ЭТИ МИЛЛИАРДЫ ОЧЕНЬ БЫСТРО ПРЕВРАЩАЮТСЯ В МЕЛОЧЬ ПОД
Dialogue: 0,0:06:29.98,0:06:32.22,Caption,,0,0,0,,КОВРОМ. ПОТОМУ ЧТО ТОГДА ВОПРОС УЖЕ НЕ В
Dialogue: 0,0:06:32.30,0:06:36.30,Caption,,0,0,0,,ТОМ, КТО РАЗМОРОЗИТ КОНКРЕТНЫЙ СЧЁТ. ВОПРОС В ТОРГОВЛЕ. В
Dialogue: 0,0:06:36.30,0:06:39.90,Caption,,0,0,0,,РАСЧЁТАХ. В ТЕХНОЛОГИЯХ. В ЭНЕРГЕТИКЕ. В СЫРЬЕ. В
Dialogue: 0,0:06:39.90,0:06:43.02,Caption,,0,0,0,,РЫНКАХ. В ВООРУЖЕНИЯХ. В НОВЫХ ПРАВИЛАХ МЕЖДУ
Dialogue: 0,0:06:43.02,0:06:47.18,Caption,,0,0,0,,КРУПНЕЙШИМИ ЦЕНТРАМИ СИЛЫ. И ПРИ ТАКОМ РАСКЛАДЕ ЕВРОПЕЙСКИЕ САНКЦИИ
Dialogue: 0,0:06:47.18,0:06:50.14,Caption,,0,0,0,,ПРЕВРАЩАЮТСЯ В ОЧЕНЬ СТРАННЫЙ ИНСТРУМЕНТ. РОССИЯ
Dialogue: 0,0:06:50.14,0:06:53.26,Caption,,0,0,0,,ТОРГУЕТ ДАЛЬШЕ. АМЕРИКА ТОРГУЕТ ДАЛЬШЕ. КИТАЙ
Dialogue: 0,0:06:53.26,0:06:56.54,Caption,,0,0,0,,ТОРГУЕТ ДАЛЬШЕ. А ЕВРОПА ГОРДО ЗАПРЕЩАЕТ САМОЙ СЕБЕ
Dialogue: 0,0:06:56.54,0:06:59.74,Caption,,0,0,0,,УЧАСТВОВАТЬ. ОТЛИЧНО ПРИДУМАНО. МОЖНО ЕЩЁ ТАБЛИЧКУ
Dialogue: 0,0:06:59.74,0:07:04.54,Caption,,0,0,0,,ПОВЕСИТЬ САНКЦИИ РАБОТАЮТ, НЕ МЕШАЙТЕ. ПРИЧЁМ ЕВРОПА ВСЁ СИЛЬНЕЕ ЗАВИСИТ ОТ
Dialogue: 0,0:07:04.54,0:07:07.98,Caption,,0,0,0,,ТОГО, ЧТО ЕЙ ПРИХОДИТСЯ ПОКУПАТЬ СНАРУЖИ. ОГРОМНОЙ
Dialogue: 0,0:07:07.98,0:07:09.74,Caption,,0,0,0,,СОБСТВЕННОЙ НЕФТЕГАЗОВОЙ БАЗЫ,
Dialogue: 0,0:07:09.90,0:07:12.14,Caption,,0,0,0,,СОПОСТАВИМОЙ С РОССИЙСКОЙ ИЛИ АМЕРИКАНСКОЙ,
Dialogue: 0,0:07:12.29,0:07:15.50,Caption,,0,0,0,,У ЕВРОСОЮЗА НЕТ. ГЕРМАНИЯ ЗАКРЫЛА ПОСЛЕДНИЕ АТОМНЫЕ
Dialogue: 0,0:07:15.50,0:07:18.94,Caption,,0,0,0,,СТАНЦИИ. ВЕТРЯКИ КРУТЯТСЯ, ПАНЕЛИ БЛЕСТЯТ,
Dialogue: 0,0:07:19.10,0:07:25.70,Caption,,0,0,0,,ОТЧЁТЫ КРАСИВЫЕ. ТОЛЬКО СТАЛЕЛИТЕЙНЫЙ ЗАВОД ОТЧЁТОМ НЕ НАГРЕЕШЬ. И
Dialogue: 0,0:07:25.78,0:07:28.26,Caption,,0,0,0,,ЗДЕСЬ ПОЯВЛЯЕТСЯ ГЛАВНЫЙ ВОПРОС ВСЕЙ ЭТОЙ ИСТОРИИ.
Dialogue: 0,0:07:28.58,0:07:33.38,Caption,,0,0,0,,ЧТО ПРОИЗОЙДЁТ, ЕСЛИ США, РОССИЯ И КИТАЙ НЕ ПРОСТО ДОГОВОРЯТСЯ ПО ОДНОМУ
Dialogue: 0,0:07:33.38,0:07:36.42,Caption,,0,0,0,,ВОПРОСУ, А НАЙДУТ ОБЩИЙ ЯЗЫК СРАЗУ ПО НЕСКОЛЬКИМ?
Dialogue: 0,0:07:36.74,0:07:38.66,Caption,,0,0,0,,SOUTH CHINA MORNING POST ПИШЕТ,
Dialogue: 0,0:07:38.90,0:07:43.06,Caption,,0,0,0,,ЧТО МОСКВА, ВАШИНГТОН И ПЕКИН УЖЕ ОБСУЖДАЮТ ОТДЕЛЬНУЮ ТЕМУ,
Dialogue: 0,0:07:43.30,0:07:45.54,Caption,,0,0,0,,ПРАВИЛА ИСПОЛЬЗОВАНИЯ ИСКУССТВЕННОГО ИНТЕЛЛЕКТА В
Dialogue: 0,0:07:45.54,0:07:48.58,Caption,,0,0,0,,ЯДЕРНЫХ СИСТЕМАХ. ПРИЧЁМ РЕЧЬ ИДЁТ О ТРЁХСТОРОННЕМ
Dialogue: 0,0:07:48.58,0:07:50.90,Caption,,0,0,0,,РАЗГОВОРЕ ЛИДЕРОВ. ОБРАТИТЕ ВНИМАНИЕ,
Dialogue: 0,0:07:51.14,0:07:55.62,Caption,,0,0,0,,КАКАЯ ИНТЕРЕСНАЯ КОМПАНИЯ. США. РОССИЯ. КИТАЙ. И
Dialogue: 0,0:07:55.62,0:07:58.66,Caption,,0,0,0,,УКРАИНА ТАМ УЖЕ НЕ ЦЕНТР РАЗГОВОРА. КОРЕЙСКИЙ ВОПРОС
Dialogue: 0,0:07:58.66,0:08:00.82,Caption,,0,0,0,,ТОЖЕ УБРАЛИ В СТОРОНУ. ИЩУТ ТО,
Dialogue: 0,0:08:00.93,0:08:03.94,Caption,,0,0,0,,ГДЕ ТРОЕ СПОСОБНЫ ДОГОВОРИТЬСЯ. ВОТ ЭТО УЖЕ СОВСЕМ
Dialogue: 0,0:08:04.02,0:08:07.14,Caption,,0,0,0,,ДРУГОЙ ЭТАЖ. СЕГОДНЯ УКРАИНА КАЖЕТСЯ ЦЕНТРОМ МИРОВОЙ
Dialogue: 0,0:08:07.22,0:08:09.86,Caption,,0,0,0,,ПОЛИТИКИ, ПОТОМУ ЧТО ПРО НЕЁ КАЖДЫЙ ДЕНЬ ГОВОРЯТ ПО
Dialogue: 0,0:08:09.86,0:08:13.06,Caption,,0,0,0,,ТЕЛЕВИЗОРУ. А ДЛЯ ТРЁХ КРУПНЕЙШИХ ЯДЕРНЫХ ДЕРЖАВ ОНА
Dialogue: 0,0:08:13.06,0:08:16.18,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В ОДИН ПУНКТ ДЛИННОЙ ПОВЕСТКИ. ОДИН
Dialogue: 0,0:08:16.18,0:08:19.14,Caption,,0,0,0,,КОНФЛИКТ. ОДИН УЗЕЛ. ОДНА ПРОБЛЕМА,
Dialogue: 0,0:08:19.29,0:08:23.54,Caption,,0,0,0,,КОТОРУЮ НАДО РАЗВЯЗАТЬ, ЧТОБЫ ДВИГАТЬСЯ ДАЛЬШЕ. А ДАЛЬШЕ УЖЕ ГОРАЗДО БОЛЬШЕ.
Dialogue: 0,0:08:23.87,0:08:26.82,Caption,,0,0,0,,НОВЫЕ ПРАВИЛА БЕЗОПАСНОСТИ. КОНТРОЛЬ ВООРУЖЕНИЙ.
Dialogue: 0,0:08:27.03,0:08:29.14,Caption,,0,0,0,,ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ В ЯДЕРНЫХ СИСТЕМАХ.
Dialogue: 0,0:08:29.30,0:08:32.90,Caption,,0,0,0,,ТОРГОВЛЯ. ЭНЕРГЕТИКА. КИТАЙСКИЕ РЫНКИ. РОССИЙСКИЕ
Dialogue: 0,0:08:32.90,0:08:36.18,Caption,,0,0,0,,РЕСУРСЫ. АМЕРИКАНСКИЙ КАПИТАЛ И ТЕХНОЛОГИИ. ВОТ ВАМ
Dialogue: 0,0:08:36.26,0:08:40.13,Caption,,0,0,0,,И ЯЛТА ДВА НОЛЬ. НЕ ПОТОМУ,
Dialogue: 0,0:08:40.21,0:08:42.93,Caption,,0,0,0,,ЧТО ЗАВТРА ТРОЕ ВОЗЬМУТ КАРАНДАШ И НАЧНУТ РИСОВАТЬ
Dialogue: 0,0:08:42.93,0:08:46.37,Caption,,0,0,0,,ГРАНИЦЫ МИРА. ПРИНЦИП ПРОЩЕ. ЕСЛИ ТРИ ДЕРЖАВЫ
Dialogue: 0,0:08:46.37,0:08:48.93,Caption,,0,0,0,,ОБНАРУЖИВАЮТ, ЧТО ИМ ВЫГОДНЕЕ ДОГОВОРИТЬСЯ,
Dialogue: 0,0:08:49.01,0:08:52.85,Caption,,0,0,0,,ЧЕМ ПРОДОЛЖАТЬ БОДАТЬСЯ, У ОСТАЛЬНЫХ ЗАКАНЧИВАЕТСЯ ПРАВО ТРЕБОВАТЬ,
Dialogue: 0,0:08:53.01,0:08:55.73,Caption,,0,0,0,,ЧТОБЫ ИХ СНАЧАЛА СПРОСИЛИ. ЧИХАТЬ ОНИ ХОТЕЛИ.
Dialogue: 0,0:08:56.05,0:08:58.61,Caption,,0,0,0,,ДОГОВОРЯТСЯ И ПОЙДУТ ДАЛЬШЕ. И ВОТ ТУТ ДЛЯ
Dialogue: 0,0:08:58.61,0:09:01.41,Caption,,0,0,0,,ЕВРОПЫ НАЧИНАЕТСЯ ДЕЙСТВИТЕЛЬНО НЕПРИЯТНЫЙ РАЗГОВОР.
Dialogue: 0,0:09:01.68,0:09:05.25,Caption,,0,0,0,,ПОТОМУ ЧТО ОДНО ДЕЛО, КОГДА ТЫ НУЖЕН ВСЕМ. ДРУГОЕ,
Dialogue: 0,0:09:05.39,0:09:10.05,Caption,,0,0,0,,КОГДА БЕЗ ТЕБЯ УЖЕ ОБХОДЯТСЯ. ЕВРОПА ДЕСЯТИЛЕТИЯМИ БЫЛА ОГРОМНЫМ РЫНКОМ,
Dialogue: 0,0:09:10.21,0:09:12.85,Caption,,0,0,0,,ПРОМЫШЛЕННЫМ ЦЕНТРОМ, ФИНАНСОВЫМ ЦЕНТРОМ,
Dialogue: 0,0:09:13.03,0:09:15.89,Caption,,0,0,0,,ТЕХНОЛОГИЧЕСКИМ ЦЕНТРОМ. НО ТЕНДЕНЦИЯ ИДЁТ В
Dialogue: 0,0:09:15.89,0:09:19.25,Caption,,0,0,0,,НЕПРИЯТНУЮ СТОРОНУ. ЭНЕРГИЯ ДОРОГАЯ. ПРОМЫШЛЕННОСТЬ
Dialogue: 0,0:09:19.25,0:09:22.21,Caption,,0,0,0,,ПОЛУЧАЕТ ВСЁ БОЛЬШЕ КОНКУРЕНЦИИ. РЕСУРСЫ В ОСНОВНОМ
Dialogue: 0,0:09:22.21,0:09:25.17,Caption,,0,0,0,,ПРИВОЗНЫЕ. ВОЕННАЯ БЕЗОПАСНОСТЬ ДЕСЯТИЛЕТИЯМИ
Dialogue: 0,0:09:25.17,0:09:27.89,Caption,,0,0,0,,ДЕРЖАЛАСЬ НА АМЕРИКАНСКОМ УЧАСТИИ. ДАЖЕ СЕЙЧАС
Dialogue: 0,0:09:27.89,0:09:30.13,Caption,,0,0,0,,ВАШИНГТОН ГОВОРИТ ЕВРОПЕЙЦАМ ОПРЕДЕЛИТЕСЬ,
Dialogue: 0,0:09:30.37,0:09:32.85,Caption,,0,0,0,,КТО БУДЕТ ВАШИМ ПЕРЕГОВОРЩИКОМ. ТО ЕСТЬ ВАМ ЕЩЁ
Dialogue: 0,0:09:32.85,0:09:35.81,Caption,,0,0,0,,ПОМОГАЮТ ЗАНЯТЬ МЕСТО ЗА СТОЛОМ. А ЕСЛИ ПОМОГАТЬ
Dialogue: 0,0:09:35.81,0:09:39.57,Caption,,0,0,0,,ПЕРЕСТАНУТ? ТОГДА СИТУАЦИЯ СТАНОВИТСЯ СОВСЕМ ОБИДНОЙ. КОЛОНИЯ
Dialogue: 0,0:09:39.65,0:09:42.37,Caption,,0,0,0,,ХОТЯ БЫ НУЖНА МЕТРОПОЛИИ ЗАЧЕМ ТО. ТАМ РЕСУРСЫ.
Dialogue: 0,0:09:42.54,0:09:46.45,Caption,,0,0,0,,СЫРЬЁ. ТЕРРИТОРИЯ. ДЕШЁВАЯ РАБОЧАЯ СИЛА. ПОРТ.
Dialogue: 0,0:09:46.60,0:09:49.97,Caption,,0,0,0,,МАРШРУТ. ЕСТЬ КОНКРЕТНАЯ ЦЕННОСТЬ. А ЕВРОПА ПРИ
Dialogue: 0,0:09:49.97,0:09:53.01,Caption,,0,0,0,,ТАКОМ РАСКЛАДЕ РИСКУЕТ ОКАЗАТЬСЯ ДАЖЕ ХУЖЕ КОЛОНИИ.
Dialogue: 0,0:09:55.29,0:09:57.53,Caption,,0,0,0,,ПОТОМУ ЧТО КОЛОНИЯ ХОТЯ БЫ КОМУ ТО НУЖНА.
Dialogue: 0,0:09:57.86,0:10:00.65,Caption,,0,0,0,,А ЕСЛИ КРУПНЕЙШИЕ ДЕРЖАВЫ ДОГОВОРЯТСЯ МЕЖДУ СОБОЙ И
Dialogue: 0,0:10:00.65,0:10:03.21,Caption,,0,0,0,,БЕЗ ЕВРОПЫ, КОМУ ОНА ТОГДА ПОНАДОБИТСЯ?
Dialogue: 0,0:10:03.69,0:10:06.57,Caption,,0,0,0,,РЕСУРСОВ МИРОВОГО МАСШТАБА ПОЧТИ НЕТ. ДЕШЁВОЙ
Dialogue: 0,0:10:06.57,0:10:10.09,Caption,,0,0,0,,ЭНЕРГИИ НЕТ. ПРОМЫШЛЕННОСТЬ ТЕРЯЕТ ПОЗИЦИИ. И САМОЕ
Dialogue: 0,0:10:10.09,0:10:13.45,Caption,,0,0,0,,НЕПРИЯТНОЕ, ЗА ГЛАВНЫМ СТОЛОМ УЖЕ МОГУТ ОБОЙТИСЬ БЕЗ НЕЁ.
Dialogue: 0,0:10:13.68,0:10:16.25,Caption,,0,0,0,,А ЕСЛИ ТЫ САМ ОТКАЗАЛСЯ ОТ ДЕШЁВОЙ ЭНЕРГИИ,
Dialogue: 0,0:10:16.41,0:10:20.01,Caption,,0,0,0,,САМ ОГРАНИЧИЛ ТОРГОВЛЮ, САМ ЗАКРЫЛ ЧАСТЬ ГЕНЕРАЦИИ,
Dialogue: 0,0:10:20.25,0:10:23.05,Caption,,0,0,0,,САМ ТЕРЯЕШЬ ПРОМЫШЛЕННОСТЬ И ПРИ ЭТОМ ЕЩЁ ПОССОРИЛСЯ
Dialogue: 0,0:10:23.13,0:10:26.73,Caption,,0,0,0,,С ТЕМИ, У КОГО РЕСУРСЫ, ЧТО У ТЕБЯ ОСТАЁТСЯ КАК ГЛАВНЫЙ КОЗЫРЬ?
Dialogue: 0,0:10:27.01,0:10:31.69,Caption,,0,0,0,,ПРАВИЛЬНЫЕ ЦЕННОСТИ? ОЧЕНЬ ХОРОШО. ИМИ ДОМЕННУЮ ПЕЧЬ И ТОПИТЕ. ВОТ
Dialogue: 0,0:10:31.69,0:10:34.25,Caption,,0,0,0,,ПОЧЕМУ РАЗГОВОР КАЛЛАС ПРО САНКЦИИ ВЫГЛЯДИТ МЕЛКО.
Dialogue: 0,0:10:34.57,0:10:39.37,Caption,,0,0,0,,ОНА ГОВОРИТ РОССИЯ ХОЧЕТ, ЧТОБЫ МЫ СНЯЛИ ОГРАНИЧЕНИЯ. ДА ЕСЛИ КРУПНЫЕ ИГРОКИ
Dialogue: 0,0:10:39.37,0:10:43.77,Caption,,0,0,0,,МЕЖДУ СОБОЙ ДОГОВОРЯТСЯ, ВОПРОС БУДЕТ СТОЯТЬ УЖЕ НЕ ТАК. НИКАКИХ ОСОБЫХ
Dialogue: 0,0:10:43.77,0:10:46.89,Caption,,0,0,0,,САНКЦИЙ В ПРЕЖНЕМ СМЫСЛЕ УЖЕ НЕ ОСТАНЕТСЯ. ОСТАНУТСЯ
Dialogue: 0,0:10:46.89,0:10:50.97,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ЗАПРЕТЫ, КОТОРЫЕ ЕВРОПА САМА НА СЕБЯ И БУДЕТ СОБЛЮДАТЬ.
Dialogue: 0,0:10:51.27,0:10:55.13,Caption,,0,0,0,,РОССИЯ НАЙДЁТ РЫНКИ. КИТАЙ СВОИ. АМЕРИКА СВОИ. А
Dialogue: 0,0:10:55.13,0:10:57.69,Caption,,0,0,0,,БРЮССЕЛЬ БУДЕТ СИДЕТЬ С ОЧЕНЬ ПРАВИЛЬНЫМ ДОКУМЕНТОМ
Dialogue: 0,0:10:57.77,0:11:01.53,Caption,,0,0,0,,И ОБЪЯСНЯТЬ, ПОЧЕМУ ВСЁ ИДЁТ ПО ПЛАНУ. КАРЕТА ЕЩЁ КРАСИВАЯ.
Dialogue: 0,0:11:01.76,0:11:04.49,Caption,,0,0,0,,ТОЛЬКО ЧАСЫ УЖЕ ТИКАЮТ. А ЕСЛИ США,
Dialogue: 0,0:11:04.58,0:11:06.89,Caption,,0,0,0,,РОССИЯ И КИТАЙ ДОГОВОРЯТСЯ МЕЖДУ СОБОЙ,
Dialogue: 0,0:11:07.14,0:11:09.53,Caption,,0,0,0,,ВСЯ ЭТА ЕВРОПЕЙСКАЯ КАРЕТА ОЧЕНЬ БЫСТРО МОЖЕТ
Dialogue: 0,0:11:09.61,0:11:15.17,Caption,,0,0,0,,ПРЕВРАТИТЬСЯ В ТЫКВУ. И НИКАКИЕ ДВЕСТИ МИЛЛИАРДОВ УЖЕ НЕ ПОМОГУТ.
Dialogue: 0,0:11:15.88,0:11:18.37,Caption,,0,0,0,,И ТУТ В САМОМ КОНЦЕ ПОЯВЛЯЕТСЯ ФРИДРИХ МЕРЦ.
Dialogue: 0,0:11:18.79,0:11:21.49,Caption,,0,0,0,,ПОСЛЕ ПЕРЕГОВОРОВ В АБУ ДАБИ ГЕРМАНИЯ УЖЕ ДОПУСКАЕТ
Dialogue: 0,0:11:21.49,0:11:24.69,Caption,,0,0,0,,ПРЯМОЙ РАЗГОВОР КАНЦЛЕРА С ПУТИНЫМ. ВОТ ЭТО ОСОБЕННО
Dialogue: 0,0:11:24.69,0:11:27.09,Caption,,0,0,0,,ХОРОШО. ЕЩЁ СОВСЕМ НЕДАВНО ЗВУЧАЛО,
Dialogue: 0,0:11:27.25,0:11:29.33,Caption,,0,0,0,,ЧТО РОССИЯ ПОНИМАЕТ ТОЛЬКО ЯЗЫК СИЛЫ,
Dialogue: 0,0:11:29.57,0:11:34.13,Caption,,0,0,0,,ЧТО ДАВЛЕНИЕ НАДО УСИЛИВАТЬ, ЧТО ЕВРОПА ДОЛЖНА СТОЯТЬ ЕДИНЫМ ФРОНТОМ. А ТЕПЕРЬ
Dialogue: 0,0:11:34.21,0:11:37.97,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ, ЧТО РАЗГОВАРИВАТЬ ВСЁ ТАКИ ПРИДЁТСЯ. ПРИЧЁМ НЕ КОГДА
Dialogue: 0,0:11:37.97,0:11:41.33,Caption,,0,0,0,,НИБУДЬ ПОТОМ, ПОСЛЕ ИДЕАЛЬНОЙ ПОБЕДЫ И КРАСИВОГО ФИНАЛЬНОГО
Dialogue: 0,0:11:41.33,0:11:45.17,Caption,,0,0,0,,ПАРАДА. А СЕЙЧАС. КОГДА США УЖЕ ДВИГАЮТ ПЕРЕГОВОРНЫЙ
Dialogue: 0,0:11:45.17,0:11:48.37,Caption,,0,0,0,,ПРОЦЕСС ДАЛЬШЕ. И МЕРЦ ЗДЕСЬ ПОКАЗЫВАЕТ ГЛАВНОЕ
Dialogue: 0,0:11:48.45,0:11:51.57,Caption,,0,0,0,,ЛУЧШЕ ЛЮБЫХ ДЛИННЫХ ЗАЯВЛЕНИЙ. МОЖНО СКОЛЬКО УГОДНО
Dialogue: 0,0:11:51.57,0:11:54.85,Caption,,0,0,0,,РАССКАЗЫВАТЬ, ЧТО БЕЗ ЕВРОПЫ НИЧЕГО НЕ РЕШАТ. НО КОГДА
Dialogue: 0,0:11:54.85,0:11:56.77,Caption,,0,0,0,,РЯДОМ НАЧИНАЮТ ПРИНИМАТЬ РЕШЕНИЯ,
Dialogue: 0,0:11:57.01,0:11:59.65,Caption,,0,0,0,,ТЕЛЕФОН ПОЧЕМУ ТО ОЧЕНЬ БЫСТРО ОКАЗЫВАЕТСЯ В РУКЕ.
Dialogue: 0,0:11:59.85,0:12:02.13,Caption,,0,0,0,,ПОТОМУ ЧТО ОДНО ДЕЛО БЫТЬ ПРИНЦИПИАЛЬНЫМ,
Dialogue: 0,0:12:02.24,0:12:04.37,Caption,,0,0,0,,КОГДА ВСЕ ЖДУТ. И СОВСЕМ ДРУГОЕ,
Dialogue: 0,0:12:04.61,0:12:06.05,Caption,,0,0,0,,КОГДА НИКТО ЖДАТЬ НЕ ОБЯЗАН.
