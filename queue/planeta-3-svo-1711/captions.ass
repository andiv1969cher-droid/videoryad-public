Dialogue: 0,0:00:00.12,0:00:03.00,Caption,,0,0,0,,УКРАИНСКАЯ ИНЖЕНЕРНАЯ МЫСЛЬ НАШЛА СПОСОБ ПОБЕДИТЬ
Dialogue: 0,0:00:03.00,0:00:05.96,Caption,,0,0,0,,РАЗРУШЕННЫЕ МОСТЫ. НАДО ПОСТАВИТЬ РЯДОМ ВРЕМЕННЫЕ.
Dialogue: 0,0:00:06.18,0:00:08.44,Caption,,0,0,0,,ПРАВДА, В КИЕВЕ УЖЕ ПРЕДУПРЕЖДАЮТ,
Dialogue: 0,0:00:08.60,0:00:11.08,Caption,,0,0,0,,ЧТО ВРЕМЕННЫЕ ТОЖЕ МОГУТ БЫСТРО ПРЕВРАТИТЬСЯ В
Dialogue: 0,0:00:11.08,0:00:13.88,Caption,,0,0,0,,ВОСПОМИНАНИЕ. ПОЛУЧАЕТСЯ СТРОЙКА С ЗАРАНЕЕ
Dialogue: 0,0:00:13.88,0:00:17.00,Caption,,0,0,0,,ЗАКАЗАННЫМИ ПОМИНКАМИ. ЕЩЁ НИ ОДНОЙ ПЕРЕПРАВЫ НЕТ,
Dialogue: 0,0:00:17.24,0:00:21.96,Caption,,0,0,0,,А ЧИНОВНИКИ УЖЕ ПРИКИДЫВАЮТ, СКОЛЬКО РАЗ ЕЁ ПРИДЁТСЯ СОБИРАТЬ ЗАНОВО. ПОХОЖЕ,
Dialogue: 0,0:00:22.12,0:00:26.52,Caption,,0,0,0,,СТАРЫЕ РЕШЕНИЯ ЗАКОНЧИЛИСЬ, А НОВЫЕ ВЫДАЮТ ВМЕСТЕ С ИНСТРУКЦИЕЙ ПО СРОЧНОМУ
Dialogue: 0,0:00:26.52,0:00:30.76,Caption,,0,0,0,,РЕМОНТУ. ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ МЫ РАЗБИРАЕМ НЕ БОДРЫЕ ЗАЯВЛЕНИЯ,
Dialogue: 0,0:00:31.07,0:00:33.64,Caption,,0,0,0,,А ТО, ЧТО ПОСЛЕ НИХ ОСТАЁТСЯ НА ЗЕМЛЕ.
Dialogue: 0,0:00:34.28,0:00:36.84,Caption,,0,0,0,,ПЕРВОЙ В ЭТОМ СПИСКЕ СТОИТ ЖЕЛЕЗНАЯ ДОРОГА. С
Dialogue: 0,0:00:36.92,0:00:39.08,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА УКРАИНА ЛИШИЛАСЬ
Dialogue: 0,0:00:39.08,0:00:42.60,Caption,,0,0,0,,ШЕСТИСОТ ТРИДЦАТИ ЛОКОМОТИВОВ. ПОЧТИ ЧЕТЫРЕСТА МАШИН
Dialogue: 0,0:00:42.68,0:00:44.76,Caption,,0,0,0,,ВЫШЛИ ИЗ СТРОЯ ЗА ОДИН ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:00:44.76,0:00:47.88,Caption,,0,0,0,,ШЕСТОЙ ГОД. БОЛЬШЕ ПОЛОВИНЫ ВСЕХ НАЗВАННЫХ ПОТЕРЬ
Dialogue: 0,0:00:48.07,0:00:50.92,Caption,,0,0,0,,НАБРАЛОСЬ ЗА СРАВНИТЕЛЬНО КОРОТКИЙ ПЕРИОД. ЭТО УЖЕ
Dialogue: 0,0:00:50.92,0:00:56.04,Caption,,0,0,0,,НЕ НЕПРИЯТНАЯ СТАТИСТИКА, А УСКОРЕНИЕ ПРОЦЕССА. МИНИСТР ИНФРАСТРУКТУРЫ НИКОЛАЙ
Dialogue: 0,0:00:56.04,0:00:59.96,Caption,,0,0,0,,КАЛАШНИК СООБЩИЛ, ЧТО ЗА ОДИН НОЯБРЬ ПОВРЕЖДЕНЫ ЕЩЁ ПРИМЕРНО
Dialogue: 0,0:00:59.96,0:01:02.68,Caption,,0,0,0,,ПЯТНАДЦАТЬ ЛОКОМОТИВОВ. ОДНОВРЕМЕННО УДАРЫ
Dialogue: 0,0:01:02.68,0:01:05.16,Caption,,0,0,0,,ПРИХОДЯТСЯ ПО СТАНЦИЯМ. В ЗАПОРОЖСКОЙ И
Dialogue: 0,0:01:05.16,0:01:08.12,Caption,,0,0,0,,ДНЕПРОПЕТРОВСКОЙ ОБЛАСТЯХ ВНОВЬ ЗАЯВЛЯЮТ О ПОРАЖЕНИИ
Dialogue: 0,0:01:08.20,0:01:11.08,Caption,,0,0,0,,ТЯГОВОГО СОСТАВА. К ЭТОМУ ДОБАВЛЯЮТСЯ СКЛАДЫ,
Dialogue: 0,0:01:11.24,0:01:13.88,Caption,,0,0,0,,НЕФТЯНЫЕ ОБЪЕКТЫ И ПОРТОВЫЕ МОЩНОСТИ.
Dialogue: 0,0:01:16.16,0:01:18.40,Caption,,0,0,0,,ЗА ЧИСЛОМ ШЕСТЬСОТ ТРИДЦАТЬ ЛЕГКО НЕ ЗАМЕТИТЬ
Dialogue: 0,0:01:18.40,0:01:21.12,Caption,,0,0,0,,ГЛАВНОГО. ЛОКОМОТИВ НЕЛЬЗЯ ЗАМЕНИТЬ ТАК ЖЕ,
Dialogue: 0,0:01:21.29,0:01:24.16,Caption,,0,0,0,,КАК СЛУЖЕБНУЮ ЛЕГКОВУШКУ. НЕ ПОЛУЧИТСЯ ВЕЧЕРОМ
Dialogue: 0,0:01:24.24,0:01:29.12,Caption,,0,0,0,,СПИСАТЬ РАЗБИТУЮ МАШИНУ, УТРОМ ПРИГНАТЬ ПОДХОДЯЩУЮ ИЗ СОСЕДНЕГО ДВОРА И ПОСЛЕ
Dialogue: 0,0:01:29.12,0:01:31.84,Caption,,0,0,0,,ОБЕДА ВЕРНУТЬСЯ НА МАРШРУТ. УКРАИНСКАЯ СЕТЬ
Dialogue: 0,0:01:31.84,0:01:36.96,Caption,,0,0,0,,ИСПОЛЬЗУЕТ ШИРОКУЮ КОЛЕЮ, А СОВМЕСТИМЫХ ЛОКОМОТИВОВ В ЕВРОПЕ МАЛО. КАБИНЕТ
Dialogue: 0,0:01:36.96,0:01:39.68,Caption,,0,0,0,,МИНИСТРОВ УЖЕ РАЗРЕШИЛ ЗАКУПАТЬ ПОДЕРЖАННУЮ ТЕХНИКУ
Dialogue: 0,0:01:39.76,0:01:42.72,Caption,,0,0,0,,И ДЕТАЛИ БЕЗ ТЕНДЕРНЫХ ПРОЦЕДУР. ИНЫМИ СЛОВАМИ,
Dialogue: 0,0:01:43.04,0:01:45.52,Caption,,0,0,0,,БЕРУТ ВСЁ, ЧТО ЕЩЁ ПРИГОДНО ДЛЯ ТЯГИ.
Dialogue: 0,0:01:46.07,0:01:50.88,Caption,,0,0,0,,АВТОРЫ ПУБЛИКАЦИИ СЧИТАЮТ, ЧТО ЗАПАС ТЯГИ ПОЧТИ ВЫБРАН. REUTERS ОДНОВРЕМЕННО
Dialogue: 0,0:01:50.88,0:01:54.08,Caption,,0,0,0,,СООБЩАЕТ О ЗАМЕТНОМ СОКРАЩЕНИИ ГРУЗОВЫХ ПЕРЕВОЗОК.
Dialogue: 0,0:01:54.47,0:01:57.52,Caption,,0,0,0,,МЕНЬШЕ ИСПРАВНЫХ МАШИН ОЗНАЧАЕТ МЕНЬШЕ ПЕРЕВЕЗЁННЫХ
Dialogue: 0,0:01:57.60,0:02:00.24,Caption,,0,0,0,,ГРУЗОВ. ЗАТЕМ НАЧИНАЕТ БУКСОВАТЬ СНАБЖЕНИЕ,
Dialogue: 0,0:02:00.48,0:02:04.56,Caption,,0,0,0,,РАСТУТ СРОКИ, КОПЯТСЯ ВАГОНЫ, А ПРЕДПРИЯТИЯ ЖДУТ ТО,
Dialogue: 0,0:02:04.65,0:02:06.56,Caption,,0,0,0,,ЧТО РАНЬШЕ ПРИЕЗЖАЛО ПО РАСПИСАНИЮ.
Dialogue: 0,0:02:07.20,0:02:09.52,Caption,,0,0,0,,МОЖНО ПРОВЕСТИ ХОТЬ ДЕСЯТЬ СОВЕЩАНИЙ С ОЧЕНЬ
Dialogue: 0,0:02:09.52,0:02:12.88,Caption,,0,0,0,,СЕРЬЁЗНЫМИ ЛИЦАМИ, НО ОТ ЭТОГО НОВЫЙ ТЕПЛОВОЗ НА ПУТЯХ НЕ
Dialogue: 0,0:02:12.88,0:02:17.60,Caption,,0,0,0,,ПОЯВИТСЯ. ЖЕЛЕЗНОДОРОЖНАЯ ПРОБЛЕМА ТУТ ЖЕ УПИРАЕТСЯ В МОСТЫ. В
Dialogue: 0,0:02:17.60,0:02:19.84,Caption,,0,0,0,,ЗАПОРОЖЬЕ ЗАКРЫЛИ ПРОЕЗД ПО МОСТУ ИМЕНИ
Dialogue: 0,0:02:19.84,0:02:22.64,Caption,,0,0,0,,ПРЕОБРАЖЕНСКОГО. РОССИЙСКИЕ ИСТОЧНИКИ СВЯЗЫВАЮТ ЭТО
Dialogue: 0,0:02:22.72,0:02:26.96,Caption,,0,0,0,,С АВИАЦИОННЫМ УДАРОМ, ПОСЛЕ КОТОРОГО ПОСТРАДАЛИ РЕЛЬСЫ И ИЗМЕНИЛАСЬ
Dialogue: 0,0:02:26.96,0:02:32.91,Caption,,0,0,0,,ГЕОМЕТРИЯ КОНСТРУКЦИЙ. ОБЪЕХАТЬ ПОВРЕЖДЁННЫЙ УЧАСТОК МОЖНО ЧЕРЕЗ ДАМБУ
Dialogue: 0,0:02:32.91,0:02:35.95,Caption,,0,0,0,,ДНЕПРОГЭС И ВАНТОВЫЙ МОСТ. ОДНАКО ТЯЖЁЛОМУ
Dialogue: 0,0:02:35.95,0:02:38.83,Caption,,0,0,0,,ТРАНСПОРТУ ТАМ РАЗРЕШЕНО ДАЛЕКО НЕ ВСЁ. НО ДЛЯ
Dialogue: 0,0:02:38.83,0:02:41.55,Caption,,0,0,0,,ГРУЗОВИКА ЭТО ЕЩЁ НЕ ОЗНАЧАЕТ СВОБОДНЫЙ ПРОЕЗД.
Dialogue: 0,0:02:42.01,0:02:44.99,Caption,,0,0,0,,ПОЧТИ ОДНОВРЕМЕННО СЕРГЕЙ АКСЁНОВ ПОДТВЕРДИЛ УДАР ПО
Dialogue: 0,0:02:44.99,0:02:47.95,Caption,,0,0,0,,КРЫМСКОМУ МОСТУ. ПРОЕЗД ОГРАНИЧИВАЛИ ПРИМЕРНО ДО
Dialogue: 0,0:02:47.95,0:02:51.15,Caption,,0,0,0,,СЕРЕДИНЫ ДНЯ. КИЕВ АТАКУЕТ РОССИЙСКИЕ ОБЪЕКТЫ.
Dialogue: 0,0:02:51.39,0:02:54.19,Caption,,0,0,0,,МОСКВА ПОРАЖАЕТ УКРАИНСКИЕ ТРАНСПОРТНЫЕ УЗЛЫ.
Dialogue: 0,0:02:54.58,0:02:57.31,Caption,,0,0,0,,КРЫМСКИЙ МОСТ ОСТАЁТСЯ ОДНОЙ ИЗ ЦЕЛЕЙ УКРАИНЫ,
Dialogue: 0,0:02:57.47,0:03:00.27,Caption,,0,0,0,,А ПЕРЕПРАВЫ ЧЕРЕЗ ДНЕПР ПРЕВРАЩАЮТСЯ ДЛЯ УКРАИНСКОЙ
Dialogue: 0,0:03:00.27,0:03:02.67,Caption,,0,0,0,,СТОРОНЫ В ПРОБЛЕМУ СОВСЕМ ДРУГОГО МАСШТАБА.
Dialogue: 0,0:03:03.13,0:03:05.63,Caption,,0,0,0,,ОБСУЖДАЮТ ЕЁ УЖЕ НЕ КАБИНЕТНЫЕ МЕЧТАТЕЛИ,
Dialogue: 0,0:03:05.86,0:03:08.67,Caption,,0,0,0,,А ДЕЙСТВУЮЩИЕ ПОЛИТИКИ. ДЕПУТАТ ВЕРХОВНОЙ РАДЫ
Dialogue: 0,0:03:08.67,0:03:12.83,Caption,,0,0,0,,ВЛАДИМИР КРЕЙДЕНКО ЗАЯВИЛ, ЧТО ЗЕЛЁНАЯ ЛИНИЯ КИЕВСКОГО МЕТРО МЕЖДУ ДВУМЯ
Dialogue: 0,0:03:12.91,0:03:15.71,Caption,,0,0,0,,БЕРЕГАМИ НЕ ВЕРНЁТСЯ К НОРМАЛЬНОЙ РАБОТЕ ДО НАЧАЛА
Dialogue: 0,0:03:15.71,0:03:18.27,Caption,,0,0,0,,СЛЕДУЮЩЕГО ГОДА. ПАРАЛЛЕЛЬНО ВЛАСТИ ГОТОВЯТСЯ
Dialogue: 0,0:03:18.27,0:03:21.15,Caption,,0,0,0,,ИСПОЛЬЗОВАТЬ ПОНТОННЫЕ ПЕРЕПРАВЫ. НА ПОДГОТОВКУ
Dialogue: 0,0:03:21.15,0:03:24.51,Caption,,0,0,0,,ОТВОДЯТ ОТ ТРЁХ ДО ЧЕТЫРЁХ МЕСЯЦЕВ. НА ДОСТАВКУ,
Dialogue: 0,0:03:24.59,0:03:27.55,Caption,,0,0,0,,СБОРКУ И ЗАКРЕПЛЕНИЕ ВРЕМЕННОГО СООРУЖЕНИЯ УЙДЁТ
Dialogue: 0,0:03:27.55,0:03:30.35,Caption,,0,0,0,,НЕСКОЛЬКО МЕСЯЦЕВ, А СТАВИТЬ ЕГО ПРИДЁТСЯ ТАМ,
Dialogue: 0,0:03:30.53,0:03:33.87,Caption,,0,0,0,,ГДЕ МОСТЫ УЖЕ СТАЛИ ЦЕЛЯМИ. ПЛАН КРЕПКИЙ. ОСОБЕННО
Dialogue: 0,0:03:33.95,0:03:37.63,Caption,,0,0,0,,ТА ЧАСТЬ, ГДЕ ВСЁ ДОЛЖНО ПРОЙТИ ХОРОШО. СОВЕТНИК ЗЕЛЕНСКОГО
Dialogue: 0,0:03:37.63,0:03:40.59,Caption,,0,0,0,,СЕРГЕЙ БЕСКРЕСТНОВ ВНЁС В ЭТОТ ИНЖЕНЕРНЫЙ ПРАЗДНИК
Dialogue: 0,0:03:40.59,0:03:45.50,Caption,,0,0,0,,НЕМНОГО НЕУДОБНОЙ АРИФМЕТИКИ. ПО ЕГО ОЦЕНКЕ,
Dialogue: 0,0:03:45.70,0:03:48.54,Caption,,0,0,0,,ПРИ РАЗРУШЕНИИ ОСНОВНЫХ МОСТОВ НИ ПОНТОНЫ,
Dialogue: 0,0:03:48.70,0:03:51.90,Caption,,0,0,0,,НИ ПАРОМЫ НЕ СМОГУТ ПОЛНОЦЕННО ЗАМЕНИТЬ ПОСТОЯННЫЕ
Dialogue: 0,0:03:51.90,0:03:54.86,Caption,,0,0,0,,ПЕРЕПРАВЫ. У ПОНТОНА ПОЛОЖЕНИЕ ЕЩЁ БОДРЕЕ.
Dialogue: 0,0:03:55.50,0:03:59.42,Caption,,0,0,0,,БЕСКРЕСТНОВ СЧИТАЕТ, ЧТО ОДНОЙ "ГЕРАНИ" МОЖЕТ ОКАЗАТЬСЯ ДОСТАТОЧНО,
Dialogue: 0,0:03:59.58,0:04:02.06,Caption,,0,0,0,,ЧТОБЫ ВРЕМЕННЫЙ ПЕРЕХОД ПЕРЕСТАЛ ВЫПОЛНЯТЬ СВОЮ
Dialogue: 0,0:04:02.06,0:04:05.50,Caption,,0,0,0,,ЗАДАЧУ. ПОСЛЕ КАЖДОГО ПОВРЕЖДЕНИЯ КОНСТРУКЦИЮ НУЖНО
Dialogue: 0,0:04:05.50,0:04:08.46,Caption,,0,0,0,,ВОССТАНАВЛИВАТЬ И ЗАНОВО ПРОВЕРЯТЬ. ПЕРЕПРАВУ
Dialogue: 0,0:04:08.53,0:04:11.18,Caption,,0,0,0,,НЕОБХОДИМО МОНТИРОВАТЬ РУКАМИ. ПОСЛЕ КАЖДОГО
Dialogue: 0,0:04:11.18,0:04:13.90,Caption,,0,0,0,,ПОВРЕЖДЕНИЯ ТУДА ДОЛЖНЫ ПРИЕЗЖАТЬ ИНЖЕНЕРЫ,
Dialogue: 0,0:04:14.02,0:04:18.22,Caption,,0,0,0,,ВОДИТЕЛИ, СВАРЩИКИ И РЕМОНТНИКИ. КТО ТО ОБЯЗАН РАЗГРУЖАТЬ
Dialogue: 0,0:04:18.22,0:04:21.10,Caption,,0,0,0,,СЕКЦИИ, СОЕДИНЯТЬ ИХ И РАБОТАТЬ У ВОДЫ,
Dialogue: 0,0:04:21.28,0:04:24.62,Caption,,0,0,0,,ПОНИМАЯ, ЧТО СЛЕДУЮЩИЙ ПРИЛЁТ МОЖЕТ БЫТЬ ВОПРОСОМ ВРЕМЕНИ.
Dialogue: 0,0:04:25.26,0:04:27.74,Caption,,0,0,0,,ЖЕЛАЮЩИХ РЕГУЛЯРНО ЧИНИТЬ ОДИН И ТОТ ЖЕ ОБЪЕКТ
Dialogue: 0,0:04:27.82,0:04:30.62,Caption,,0,0,0,,ПОД УГРОЗОЙ УДАРА МНОГО ТОЛЬКО В ОТЧЁТАХ. В
Dialogue: 0,0:04:30.62,0:04:33.42,Caption,,0,0,0,,НАСТОЯЩЕЙ ЖИЗНИ СПЕЦИАЛИСТЫ ТОЖЕ ХОТЯТ ДОЖИТЬ ДО
Dialogue: 0,0:04:33.42,0:04:35.98,Caption,,0,0,0,,СЛЕДУЮЩЕГО УТРА. ЧЕЛОВЕКА НЕЛЬЗЯ БЕСКОНЕЧНО
Dialogue: 0,0:04:35.98,0:04:38.54,Caption,,0,0,0,,ЗАПИСЫВАТЬ В ГРАФУ "РАСХОДНЫЕ МАТЕРИАЛЫ". У
Dialogue: 0,0:04:38.54,0:04:41.34,Caption,,0,0,0,,БЕСКРЕСТНОВА ЕСТЬ БОЛЕЕ ФУНДАМЕНТАЛЬНОЕ ПРЕДЛОЖЕНИЕ.
Dialogue: 0,0:04:41.56,0:04:44.62,Caption,,0,0,0,,ПРОЛОЖИТЬ ТОННЕЛЬ ПОД ДНЕПРОМ. РАЗ ПОНТОН МОЖНО
Dialogue: 0,0:04:44.62,0:04:46.38,Caption,,0,0,0,,РАЗБИТЬ, ПОРА ЗАРЫТЬСЯ ПОД РЕКУ.
Dialogue: 0,0:04:46.98,0:04:51.18,Caption,,0,0,0,,ЛОГИКА МОНУМЕНТАЛЬНАЯ, ПОЧТИ КАК СТОИМОСТЬ ПРОЕКТА. ТОТ ЖЕ СОВЕТНИК
Dialogue: 0,0:04:51.18,0:04:54.38,Caption,,0,0,0,,ПРИЗНАЁТ, ЧТО ДАЖЕ ПРИ ЗАРУБЕЖНОЙ ПОДДЕРЖКЕ СТРОИТЕЛЬСТВО
Dialogue: 0,0:04:54.46,0:05:00.19,Caption,,0,0,0,,РАСТЯНЕТСЯ НА ГОДЫ. ОДНА УКРАИНСКАЯ ПУБЛИКАЦИЯ НА ЭТОМ МЕСТЕ ЗАДАЁТ
Dialogue: 0,0:05:00.19,0:05:03.87,Caption,,0,0,0,,ВОПРОС, КОТОРЫЙ ПОРТИТ ВСЮ ВЫСТАВКУ ИНЖЕНЕРНЫХ ДОСТИЖЕНИЙ.
Dialogue: 0,0:05:04.55,0:05:06.59,Caption,,0,0,0,,МОЖЕТ БЫТЬ, СУЩЕСТВУЕТ ПРОЕКТ,
Dialogue: 0,0:05:06.75,0:05:09.15,Caption,,0,0,0,,ПРИ КОТОРОМ БОЕВЫЕ ДЕЙСТВИЯ ЗАКАНЧИВАЮТСЯ,
Dialogue: 0,0:05:09.47,0:05:14.75,Caption,,0,0,0,,А МОСТЫ ОСТАЮТСЯ НА МЕСТЕ? ВОЗМОЖНОСТЬ ПРЕКРАТИТЬ ПОСТОЯННЫЙ ЦИКЛ РАЗРУШЕНИЯ И
Dialogue: 0,0:05:14.75,0:05:17.55,Caption,,0,0,0,,РЕМОНТА В ЭТОМ МЕНЮ ПОЧЕМУ ТО ЗАНИМАЕТ ПОСЛЕДНЕЕ
Dialogue: 0,0:05:17.55,0:05:20.59,Caption,,0,0,0,,МЕСТО. СО ВРЕМЕНИ ОБЕЩАНИЙ ПРОВЕСТИ СОРОКАДНЕВНУЮ
Dialogue: 0,0:05:20.59,0:05:23.55,Caption,,0,0,0,,ОПЕРАЦИЮ ПО ПРИНУЖДЕНИЮ РОССИИ К МИРУ ПРОШЛО БОЛЬШЕ
Dialogue: 0,0:05:23.55,0:05:26.83,Caption,,0,0,0,,СТА СОРОКА ДНЕЙ. ОБЕЩАННЫЙ СРОК ЗАКОНЧИЛСЯ ДАВНО.
Dialogue: 0,0:05:27.30,0:05:29.71,Caption,,0,0,0,,ЗАТО ТЕПЕРЬ В КИЕВЕ СЧИТАЮТ ПЕРЕПРАВЫ,
Dialogue: 0,0:05:29.79,0:05:33.63,Caption,,0,0,0,,ЛОКОМОТИВЫ И МЕСЯЦЫ ДО СЛЕДУЮЩЕГО РЕМОНТА. ЕСЛИ ВАМ
Dialogue: 0,0:05:33.63,0:05:36.35,Caption,,0,0,0,,НРАВИТСЯ ТАКОЙ РАЗБОР БЕЗ ПРИСЫПКИ ИЗ КАЗЁННЫХ СЛОВ,
Dialogue: 0,0:05:36.51,0:05:38.91,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. THE TELEGRAPH СООБЩАЕТ,
Dialogue: 0,0:05:39.15,0:05:42.11,Caption,,0,0,0,,ЧТО РОССИЙСКИЕ КОМПЛЕКСЫ "ИСКАНДЕР" ПОЛУЧИЛИ БОЛЕЕ
Dialogue: 0,0:05:42.11,0:05:45.23,Caption,,0,0,0,,ТОЧНОЕ НАВЕДЕНИЕ. РЕЧЬ ИДЁТ ОБ ОПТИЧЕСКИХ И
Dialogue: 0,0:05:45.23,0:05:48.19,Caption,,0,0,0,,РАДИОЛОКАЦИОННЫХ ГОЛОВКАХ САМОНАВЕДЕНИЯ. НА
Dialogue: 0,0:05:48.19,0:05:50.91,Caption,,0,0,0,,ПОСЛЕДНЕМ УЧАСТКЕ ПОЛЁТА РАКЕТА МОЖЕТ КОРРЕКТИРОВАТЬ
Dialogue: 0,0:05:50.91,0:05:53.71,Caption,,0,0,0,,КУРС И ТОЧНЕЕ ОПРЕДЕЛЯТЬ ПОЛОЖЕНИЕ ВЫБРАННОГО
Dialogue: 0,0:05:53.71,0:05:57.87,Caption,,0,0,0,,ОБЪЕКТА. ДЛЯ МОСТОВ ЭТА ДЕТАЛЬ ОСОБЕННО НЕПРИЯТНА. БОЛЬШАЯ
Dialogue: 0,0:05:57.87,0:06:00.67,Caption,,0,0,0,,ПЕРЕПРАВА ПРЕДСТАВЛЯЕТ СОБОЙ ОГРОМНУЮ И ПРОЧНУЮ
Dialogue: 0,0:06:00.75,0:06:03.39,Caption,,0,0,0,,КОНСТРУКЦИЮ. ПРИЛЕТЕТЬ ПОБЛИЗОСТИ И ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:06:03.39,0:06:05.55,Caption,,0,0,0,,ОСТАНОВИТЬ ЕЁ РАБОТУ ДАЛЕКО НЕ ОДНО И ТО
Dialogue: 0,0:06:05.63,0:06:08.43,Caption,,0,0,0,,ЖЕ. СПЕЦИАЛИСТ МАУРО ДЖИЛЛИ СЧИТАЕТ ПОЛНОЕ
Dialogue: 0,0:06:08.43,0:06:11.23,Caption,,0,0,0,,УНИЧТОЖЕНИЕ КРУПНЫХ КИЕВСКИХ МОСТОВ ЧРЕЗВЫЧАЙНО
Dialogue: 0,0:06:11.23,0:06:17.41,Caption,,0,0,0,,СЛОЖНОЙ ЗАДАЧЕЙ. ОДНАКО THE TELEGRAPH УКАЗЫВАЕТ НА БОЛЕЕ ШИРОКИЙ
Dialogue: 0,0:06:17.41,0:06:20.61,Caption,,0,0,0,,ЗАМЫСЕЛ. МОСТЫ МОГУТ ОКАЗАТЬСЯ ЛИШЬ ОДНОЙ ЧАСТЬЮ
Dialogue: 0,0:06:20.61,0:06:23.97,Caption,,0,0,0,,ДАВЛЕНИЯ НА ВСЮ УКРАИНСКУЮ ЭНЕРГОСИСТЕМУ. ДЛЯ ЭТОГО
Dialogue: 0,0:06:23.97,0:06:26.21,Caption,,0,0,0,,ИСПОЛЬЗУЕТСЯ ТЕРМИН "ОСТРОВИЗАЦИЯ".
Dialogue: 0,0:06:26.79,0:06:29.73,Caption,,0,0,0,,ЕДИНУЮ ЭНЕРГЕТИЧЕСКУЮ СЕТЬ ПОСЛЕДОВАТЕЛЬНО РАЗДЕЛЯЮТ
Dialogue: 0,0:06:29.73,0:06:32.69,Caption,,0,0,0,,НА ИЗОЛИРОВАННЫЕ УЧАСТКИ. ЭЛЕКТРИЧЕСТВО В ОДНОМ
Dialogue: 0,0:06:32.77,0:06:36.69,Caption,,0,0,0,,МЕСТЕ ПРОИЗВОДИТСЯ, ОДНАКО ПЕРЕБРОСИТЬ ЕГО В ДРУГОЙ РАЙОН СТАНОВИТСЯ ВСЁ
Dialogue: 0,0:06:36.69,0:06:39.73,Caption,,0,0,0,,ТРУДНЕЕ. ТОГДА ПОСЛЕДСТВИЯ НЕ ОГРАНИЧИВАЮТСЯ ОДНОЙ
Dialogue: 0,0:06:39.73,0:06:42.93,Caption,,0,0,0,,ПОВРЕЖДЁННОЙ ПОДСТАНЦИЕЙ. В ОДНОМ РАЙОНЕ ЛАМПЫ ГОРЯТ
Dialogue: 0,0:06:42.93,0:06:45.89,Caption,,0,0,0,,ПОСТОЯННО. В ДРУГОМ ПИТАНИЕ ПОЯВЛЯЕТСЯ НА ПАРУ
Dialogue: 0,0:06:45.97,0:06:49.81,Caption,,0,0,0,,ЧАСОВ. В ТРЕТЬЕМ ОСТЫВАЮТ БАТАРЕИ. ГДЕ ТО МОЩНОСТИ
Dialogue: 0,0:06:49.81,0:06:53.57,Caption,,0,0,0,,СОХРАНИЛИСЬ, НО ДОСТАВИТЬ ВЫРАБОТАННУЮ ЭНЕРГИЮ ПОТРЕБИТЕЛЯМ УЖЕ
Dialogue: 0,0:06:53.57,0:06:56.53,Caption,,0,0,0,,НЕЛЬЗЯ. СЛЕДОМ НАЧИНАЮТ СБОИТЬ ВОДОСНАБЖЕНИЕ,
Dialogue: 0,0:06:56.77,0:07:00.29,Caption,,0,0,0,,ОТОПЛЕНИЕ, ГОРОДСКОЙ ТРАНСПОРТ И ПРОМЫШЛЕННОСТЬ. ОДИН
Dialogue: 0,0:07:00.29,0:07:03.33,Caption,,0,0,0,,ОБОРВАННЫЙ УЗЕЛ ТЯНЕТ ЗА СОБОЙ СОСЕДНИЕ СИСТЕМЫ,
Dialogue: 0,0:07:03.49,0:07:06.61,Caption,,0,0,0,,КАК НЕУДАЧНО ВЫТАЩЕННАЯ ПОЛКА ВАЛИТ ПОЛОВИНУ ШКАФА.
Dialogue: 0,0:07:07.15,0:07:10.29,Caption,,0,0,0,,РЯДОМ С ЭТОЙ ИСТОРИЕЙ УКРАИНСКАЯ СИСТЕМА LIMA QUANT
Dialogue: 0,0:07:10.53,0:07:13.01,Caption,,0,0,0,,ПОЛУЧАЕТ БОЛЬШУЮ ПУБЛИКАЦИЮ В NEW YORK TIMES.
Dialogue: 0,0:07:13.30,0:07:16.21,Caption,,0,0,0,,ОПИСАНИЕ У НЕЁ ПОЧТИ ВОЛШЕБНОЕ. УТВЕРЖДАЕТСЯ,
Dialogue: 0,0:07:16.45,0:07:19.41,Caption,,0,0,0,,ЧТО СИСТЕМА СПОСОБНА УБЕДИТЬ РОССИЙСКИЙ БЕСПИЛОТНИК,
Dialogue: 0,0:07:19.65,0:07:22.21,Caption,,0,0,0,,БУДТО ВМЕСТО УКРАИНЫ ОН ОКАЗАЛСЯ ЕДВА ЛИ НЕ
Dialogue: 0,0:07:22.21,0:07:25.01,Caption,,0,0,0,,НАД ПЕРУ. ЕЙ ТАКЖЕ ПРИПИСЫВАЮТ ВОЗМОЖНОСТЬ
Dialogue: 0,0:07:25.01,0:07:26.85,Caption,,0,0,0,,ВОЗДЕЙСТВОВАТЬ НА РОССИЙСКИЕ РАКЕТЫ.
Dialogue: 0,0:07:29.14,0:07:32.10,Caption,,0,0,0,,ЗВУЧИТ ТАК, БУДТО ОПЕРАТОР НАЖИМАЕТ КНОПКУ,
Dialogue: 0,0:07:32.26,0:07:34.42,Caption,,0,0,0,,И ДРОН ВНЕЗАПНО НАЧИНАЕТ ИСКАТЬ ПАЛЬМЫ.
Dialogue: 0,0:07:35.12,0:07:37.78,Caption,,0,0,0,,РОССИЙСКИЙ ВОЕННЫЙ КАНАЛ ОТВЕЧАЕТ ВОПРОСОМ А ЧТО
Dialogue: 0,0:07:37.78,0:07:40.18,Caption,,0,0,0,,ИМЕННО ЗДЕСЬ ОБЪЯВИЛИ НОВЫМ ИЗОБРЕТЕНИЕМ?
Dialogue: 0,0:07:40.48,0:07:42.82,Caption,,0,0,0,,ПОДМЕНА СПУТНИКОВЫХ КООРДИНАТ ИЗВЕСТНА НЕ ПЕРВЫЙ
Dialogue: 0,0:07:42.90,0:07:46.10,Caption,,0,0,0,,ГОД. ТАКОЙ ПРИЁМ НАЗЫВАЕТСЯ СПУФИНГОМ. ЖИТЕЛИ МОСКВЫ
Dialogue: 0,0:07:46.10,0:07:50.10,Caption,,0,0,0,,ДАВНО ЗНАКОМЫ С ЭФФЕКТОМ, КОГДА НАВИГАТОР ВОЗЛЕ КРЕМЛЯ ОТПРАВЛЯЕТ ВЛАДЕЛЬЦА
Dialogue: 0,0:07:50.10,0:07:52.74,Caption,,0,0,0,,ТЕЛЕФОНА К АЭРОПОРТУ. ЧЕЛОВЕК СТОИТ В ЦЕНТРЕ
Dialogue: 0,0:07:52.74,0:07:56.34,Caption,,0,0,0,,СТОЛИЦЫ, А КАРТА МЫСЛЕННО УЖЕ РЕГИСТРИРУЕТ ЕГО НА РЕЙС.
Dialogue: 0,0:07:56.61,0:07:59.38,Caption,,0,0,0,,С ТЕЛЕФОНОМ ЭТО ЗАБАВНЫЙ СБОЙ. С ОРУЖИЕМ ВСЁ
Dialogue: 0,0:07:59.38,0:08:02.82,Caption,,0,0,0,,СЛОЖНЕЕ. С БАЛЛИСТИЧЕСКИМИ РАКЕТАМИ СПОР ВЫХОДИТ ЕЩЁ
Dialogue: 0,0:08:02.82,0:08:05.94,Caption,,0,0,0,,ИНТЕРЕСНЕЕ. ОНИ УМЕЛИ ДОСТИГАТЬ ЦЕЛИ ЗАДОЛГО ДО
Dialogue: 0,0:08:05.94,0:08:09.46,Caption,,0,0,0,,ПОЯВЛЕНИЯ GPS И ГЛОНАСС. ИНЕРЦИАЛЬНАЯ НАВИГАЦИЯ
Dialogue: 0,0:08:09.46,0:08:12.58,Caption,,0,0,0,,РАБОТАЛА В ЭПОХУ, КОГДА ВОДИТЕЛЬ МОГ ОРИЕНТИРОВАТЬСЯ ТОЛЬКО ПО
Dialogue: 0,0:08:12.58,0:08:16.82,Caption,,0,0,0,,БУМАЖНОЙ КАРТЕ, УКАЗАТЕЛЮ И СОБСТВЕННОМУ УПРЯМСТВУ. СУЩЕСТВОВАЛИ
Dialogue: 0,0:08:16.82,0:08:19.86,Caption,,0,0,0,,АСТРОКОРРЕКЦИЯ И ДРУГИЕ МЕТОДЫ УТОЧНЕНИЯ ПУТИ.
Dialogue: 0,0:08:20.34,0:08:22.66,Caption,,0,0,0,,ПОЭТОМУ РЕАКЦИЯ ВОЕННОГО КАНАЛА ПОЛУЧИЛАСЬ
Dialogue: 0,0:08:22.66,0:08:26.02,Caption,,0,0,0,,ПРЕДСКАЗУЕМОЙ. ЕСЛИ ГРОМКО НЕ ОБЪЯВИТЬ СЕБЯ ГЕНИЕМ,
Dialogue: 0,0:08:26.27,0:08:29.06,Caption,,0,0,0,,ПУБЛИКА МОЖЕТ ПРОЙТИ МИМО ДОСТИЖЕНИЯ. ОСОБЕННО
Dialogue: 0,0:08:29.06,0:08:31.54,Caption,,0,0,0,,НЕЛОВКО ЭТО СМОТРИТСЯ НА ФОНЕ СООБЩЕНИЙ ОБ
Dialogue: 0,0:08:31.54,0:08:34.10,Caption,,0,0,0,,ОБНОВЛЁННЫХ СРЕДСТВАХ НАВЕДЕНИЯ ДЛЯ "ИСКАНДЕРОВ".
Dialogue: 0,0:08:34.55,0:08:39.14,Caption,,0,0,0,,КИЕВ РАССКАЗЫВАЕТ, КАК БУДЕТ СБИВАТЬ ПРОТИВНИКУ КООРДИНАТЫ. МОСКВА
Dialogue: 0,0:08:39.14,0:08:43.06,Caption,,0,0,0,,УЛУЧШАЕТ СИСТЕМЫ, РАССЧИТАННЫЕ НА РАБОТУ ПРИ ТАКОМ ВМЕШАТЕЛЬСТВЕ.
Dialogue: 0,0:08:45.34,0:08:47.82,Caption,,0,0,0,,НО САМЫЙ ЗАНИМАТЕЛЬНЫЙ СПОР РАЗВЕРНУЛСЯ ВОКРУГ
Dialogue: 0,0:08:47.82,0:08:51.02,Caption,,0,0,0,,STARSHIELD. НИ ОДНА ИЗ ПРОТИВОРЕЧИВЫХ ВЕРСИЙ ОБ
Dialogue: 0,0:08:51.02,0:08:53.10,Caption,,0,0,0,,ОГРАНИЧЕНИЯХ STARSHIELD ПОКА НЕ ПОЛУЧИЛА
Dialogue: 0,0:08:53.10,0:08:58.22,Caption,,0,0,0,,ПРОВЕРЯЕМОГО ПОДТВЕРЖДЕНИЯ. AXIOS СО ССЫЛКОЙ НА УКРАИНСКОГО ЧИНОВНИКА СООБЩИЛ,
Dialogue: 0,0:08:58.53,0:09:01.42,Caption,,0,0,0,,ЧТО ОГРАНИЧЕНИЯ НАРАСТАЛИ НЕСКОЛЬКО СУТОК. СНАЧАЛА
Dialogue: 0,0:09:01.42,0:09:04.78,Caption,,0,0,0,,НАЗЫВАЛИСЬ ДЕСЯТЬ ПРОЦЕНТОВ, ПОТОМ ПЯТЬДЕСЯТ ПРОЦЕНТОВ,
Dialogue: 0,0:09:05.10,0:09:07.98,Caption,,0,0,0,,А ЗАТЕМ СОБЕСЕДНИК ИЗДАНИЯ ЗАГОВОРИЛ О СРЫВЕ ВСЕХ
Dialogue: 0,0:09:07.98,0:09:13.02,Caption,,0,0,0,,МИССИЙ. SPACEX ЗАЯВЛЯЕТ, ЧТО НИЧЕГО НЕ МЕНЯЛА. УКРАИНСКИЙ ПРЕДСТАВИТЕЛЬ
Dialogue: 0,0:09:13.10,0:09:14.86,Caption,,0,0,0,,СООБЩАЕТ О СОРВАННЫХ ОПЕРАЦИЯХ,
Dialogue: 0,0:09:15.12,0:09:17.90,Caption,,0,0,0,,А АМЕРИКАНСКАЯ КОМПАНИЯ ОТРИЦАЕТ ИЗМЕНЕНИЯ.
Dialogue: 0,0:09:18.54,0:09:21.66,Caption,,0,0,0,,ЗЕЛЕНСКИЙ СВЯЗЫВАЕТ СНИЖЕНИЕ СКОРОСТИ STARSHIELD С
Dialogue: 0,0:09:21.66,0:09:24.46,Caption,,0,0,0,,УДАРАМИ РОССИЙСКИХ "ШАХЕДОВ" ПО ПОДСТАНЦИЯМ. ПО ЕГО
Dialogue: 0,0:09:24.46,0:09:28.38,Caption,,0,0,0,,СЛОВАМ, УКРАИНСКИМ БЕСПИЛОТНИКАМ ПЕРЕХВАТЧИКАМ СТАЛО СЛОЖНЕЕ
Dialogue: 0,0:09:28.38,0:09:31.58,Caption,,0,0,0,,ДОГОНЯТЬ ВОЗДУШНЫЕ ЦЕЛИ. АВТОР УКРАИНСКОГО КАНАЛА
Dialogue: 0,0:09:31.58,0:09:35.42,Caption,,0,0,0,,ЗАМЕЧАЕТ, ЧТО ДОЛЯ КОСВЕННЫХ ПРЕТЕНЗИЙ К ТРАМПУ ДОБРАЛАСЬ ДО
Dialogue: 0,0:09:35.42,0:09:37.66,Caption,,0,0,0,,ПРЕДЕЛА. РАНЬШЕ ГЛАВНЫМ БЫЛ ВОПРОС,
Dialogue: 0,0:09:37.98,0:09:40.78,Caption,,0,0,0,,КТО ПРЕДОСТАВИЛ УКРАИНЕ СПУТНИКОВУЮ СВЯЗЬ. ТЕПЕРЬ
Dialogue: 0,0:09:40.78,0:09:44.62,Caption,,0,0,0,,ВЫЯСНЯЕТСЯ, КТО МОЖЕТ МЕНЯТЬ УСЛОВИЯ ЕЁ РАБОТЫ И НАСКОЛЬКО
Dialogue: 0,0:09:44.70,0:09:46.94,Caption,,0,0,0,,БЫСТРО ЭТИ ИЗМЕНЕНИЯ ОТРАЖАЮТСЯ НА БОЕВЫХ
Dialogue: 0,0:09:46.94,0:09:49.58,Caption,,0,0,0,,ВОЗМОЖНОСТЯХ. ЗАВИСИМОСТЬ ОБНАРУЖИЛАСЬ НЕ В
Dialogue: 0,0:09:49.58,0:09:52.94,Caption,,0,0,0,,ДОГОВОРЕ, А ПРЯМО В ВОЗДУХЕ. МОЖНО ДОЛГО ГОВОРИТЬ О
Dialogue: 0,0:09:52.94,0:09:55.82,Caption,,0,0,0,,САМОСТОЯТЕЛЬНОСТИ, НО СИСТЕМА ОСТАЁТСЯ ЧУЖОЙ.
Dialogue: 0,0:09:58.09,0:10:00.41,Caption,,0,0,0,,ЕЁ ПРАВИЛА ЗАДАЁТ ЗАРУБЕЖНАЯ КОМПАНИЯ,
Dialogue: 0,0:10:00.63,0:10:03.21,Caption,,0,0,0,,А ГОСУДАРСТВО ВЛАДЕЛЬЦА В ЛЮБОЙ МОМЕНТ СПОСОБНО
Dialogue: 0,0:10:03.21,0:10:06.41,Caption,,0,0,0,,ВМЕШАТЬСЯ В РАЗГОВОР. ПУЛЬТ ЛЕЖИТ НЕ НА УКРАИНСКОМ
Dialogue: 0,0:10:06.41,0:10:09.77,Caption,,0,0,0,,СТОЛЕ. ПОЗДНЕЕ SPACEX НАЗВАЛА ПРИЧИНОЙ ОГРАНИЧЕНИЙ
Dialogue: 0,0:10:09.77,0:10:15.53,Caption,,0,0,0,,ТЕХНИЧЕСКИЙ СБОЙ. ДОПУСТИМ. ТОГДА ВОПРОС СТАНОВИТСЯ ЕЩЁ МЕНЕЕ УДОБНЫМ. ПОЧЕМУ
Dialogue: 0,0:10:15.53,0:10:18.25,Caption,,0,0,0,,НЕПОЛАДКА СОХРАНЯЕТСЯ НЕСКОЛЬКО ДНЕЙ ИМЕННО В
Dialogue: 0,0:10:18.25,0:10:21.37,Caption,,0,0,0,,РАЙОНЕ, ГДЕ СНИЖЕНИЕ СКОРОСТИ ОСОБЕННО БОЛЕЗНЕННО?
Dialogue: 0,0:10:21.67,0:10:23.93,Caption,,0,0,0,,КИЕВ ОБСУЖДАЕТ ПРОИСХОДЯЩЕЕ С КОМПАНИЕЙ,
Dialogue: 0,0:10:24.17,0:10:27.53,Caption,,0,0,0,,НО ЯСНОГО ПУБЛИЧНОГО ОБЪЯСНЕНИЯ ПОКА НЕТ. СУТЬ
Dialogue: 0,0:10:27.61,0:10:29.93,Caption,,0,0,0,,ПРОБЛЕМЫ STARSHIELD НЕ ОБЯЗАТЕЛЬНО СВОДИТСЯ К
Dialogue: 0,0:10:29.93,0:10:32.25,Caption,,0,0,0,,ТАЙНОМУ РУБИЛЬНИКУ В КАБИНЕТЕ. ВСЁ ГОРАЗДО
Dialogue: 0,0:10:32.25,0:10:36.09,Caption,,0,0,0,,ПРОЗАИЧНЕЕ И ПОТОМУ ОПАСНЕЕ. МОЖЕТ ЛИ АРМИЯ СЧИТАТЬ
Dialogue: 0,0:10:36.09,0:10:38.09,Caption,,0,0,0,,СОБСТВЕННЫМ ИНСТРУМЕНТОМ СИСТЕМУ,
Dialogue: 0,0:10:38.33,0:10:40.33,Caption,,0,0,0,,КОТОРУЮ ОБСЛУЖИВАЕТ ЧУЖАЯ ФИРМА,
Dialogue: 0,0:10:40.49,0:10:43.53,Caption,,0,0,0,,КОНТРОЛИРУЕТ ЧУЖАЯ СТРАНА И ОБЪЯСНЯЕТ ПО СВОЕМУ
Dialogue: 0,0:10:43.53,0:10:47.05,Caption,,0,0,0,,РАСПИСАНИЮ? ПОКА КИЕВ ВЫЯСНЯЕТ ОТНОШЕНИЯ С АМЕРИКАНСКОЙ
Dialogue: 0,0:10:47.05,0:10:50.17,Caption,,0,0,0,,СПУТНИКОВОЙ СВЯЗЬЮ, ЭСТОНИЯ ПОКАЗАЛА НА ПРАКТИКЕ,
Dialogue: 0,0:10:50.33,0:10:52.41,Caption,,0,0,0,,ГДЕ ЗАКАНЧИВАЕТСЯ ГРОМКОСТЬ ЗАЯВЛЕНИЙ.
Dialogue: 0,0:10:52.99,0:10:55.53,Caption,,0,0,0,,УКРАИНСКИЕ БЕСПИЛОТНИКИ НАПРАВЛЯЛИСЬ К РОССИЙСКОМУ
Dialogue: 0,0:10:55.53,0:10:58.49,Caption,,0,0,0,,ПОРТУ УСТЬ ЛУГА И ВОШЛИ В ЭСТОНСКОЕ ВОЗДУШНОЕ
Dialogue: 0,0:10:58.49,0:11:01.61,Caption,,0,0,0,,ПРОСТРАНСТВО. ЭСТОНСКИЕ ВОЕННЫЕ ОБНАРУЖИЛИ АППАРАТЫ.
Dialogue: 0,0:11:02.00,0:11:04.81,Caption,,0,0,0,,САМОЛЁТЫ НАТО ПОДНЯЛИСЬ ДЛЯ НАБЛЮДЕНИЯ. ЦЕЛИ
Dialogue: 0,0:11:04.81,0:11:08.41,Caption,,0,0,0,,СОПРОВОЖДАЛИ, НО ПЕРЕХВАТЫВАТЬ НЕ СТАЛИ. ЭСТОНСКАЯ СТОРОНА
Dialogue: 0,0:11:08.41,0:11:11.13,Caption,,0,0,0,,ОБЪЯСНИЛА РЕШЕНИЕ ОПАСЕНИЕМ ЭСКАЛАЦИИ.
Dialogue: 0,0:11:13.40,0:11:16.04,Caption,,0,0,0,,ПОСЛЕ УНИЧТОЖЕНИЯ БЕСПИЛОТНИКОВ ОБЛОМКИ ЛИБО
Dialogue: 0,0:11:16.04,0:11:18.76,Caption,,0,0,0,,БОЕПРИПАСЫ МОГЛИ УПАСТЬ УЖЕ НА ТЕРРИТОРИИ РОССИИ.
Dialogue: 0,0:11:19.15,0:11:21.96,Caption,,0,0,0,,ЭТОТ МОМЕНТ ДОСТОИН ОТДЕЛЬНОЙ РАМКИ. ПОКА НУЖНО
Dialogue: 0,0:11:21.96,0:11:23.64,Caption,,0,0,0,,ПРИЗЫВАТЬ ОСТАЛЬНЫХ К ЖЁСТКОСТИ,
Dialogue: 0,0:11:23.96,0:11:26.68,Caption,,0,0,0,,ЭСТОНИЯ ВЫГЛЯДИТ РАЗМЕРОМ С ИМПЕРИЮ. ЗВУЧАТ
Dialogue: 0,0:11:26.68,0:11:31.88,Caption,,0,0,0,,ТРЕБОВАНИЯ НОВЫХ САНКЦИЙ, УСИЛЕНИЯ ДАВЛЕНИЯ И ДЕМОНСТРАЦИИ РЕШИМОСТИ. НО КАК
Dialogue: 0,0:11:31.96,0:11:33.88,Caption,,0,0,0,,ТОЛЬКО АППАРАТ ДЕЙСТВИТЕЛЬНО ПРОХОДИТ ЧЕРЕЗ
Dialogue: 0,0:11:33.88,0:11:35.80,Caption,,0,0,0,,ЭСТОНСКОЕ НЕБО В СТОРОНУ РОССИИ,
Dialogue: 0,0:11:36.12,0:11:40.92,Caption,,0,0,0,,СТРАНА ВНЕЗАПНО ВСПОМИНАЕТ, ЧТО У ДЕЙСТВИЙ БЫВАЮТ ПОСЛЕДСТВИЯ. РЕШИТЕЛЬНОСТЬ
Dialogue: 0,0:11:40.92,0:11:43.80,Caption,,0,0,0,,БЫСТРО НАДЕВАЕТ ТАПОЧКИ И ПРОСИТ ГОВОРИТЬ ПОТИШЕ.
Dialogue: 0,0:11:44.11,0:11:46.76,Caption,,0,0,0,,ОСТОРОЖНОСТЬ ВООБЩЕ ПОЛЕЗНА. СТРАННО ЛИШЬ,
Dialogue: 0,0:11:46.92,0:11:49.48,Caption,,0,0,0,,ЧТО ЕЁ ОБЫЧНО НАХОДЯТ ПОСЛЕ ВЫСТУПЛЕНИЯ,
Dialogue: 0,0:11:49.64,0:11:53.88,Caption,,0,0,0,,А НЕ ДО НЕГО. УКРАИНА ТЕМ ВРЕМЕНЕМ ПРОДОЛЖАЕТ АТАКОВАТЬ РОССИЙСКУЮ
Dialogue: 0,0:11:53.88,0:11:57.08,Caption,,0,0,0,,НЕФТЕПЕРЕРАБОТКУ. СОГЛАСНО ОПУБЛИКОВАННЫМ СВЕДЕНИЯМ,
Dialogue: 0,0:11:57.32,0:12:00.92,Caption,,0,0,0,,ЗА НЕДЕЛЮ НАРУШЕНА РАБОТА ДЕВЯТИ ИЗ ТРИДЦАТИ ПЯТИ
Dialogue: 0,0:12:00.92,0:12:04.04,Caption,,0,0,0,,КРУПНЕЙШИХ РОССИЙСКИХ НЕФТЕПЕРЕРАБАТЫВАЮЩИХ ЗАВОДОВ.
Dialogue: 0,0:12:04.44,0:12:06.68,Caption,,0,0,0,,ОБЪЁМ ПЕРЕРАБОТКИ, КАК УТВЕРЖДАЕТСЯ,
Dialogue: 0,0:12:06.96,0:12:10.20,Caption,,0,0,0,,УМЕНЬШИЛСЯ ПРИМЕРНО НА ТРИДЦАТЬ ПРОЦЕНТОВ И СОСТАВИЛ
Dialogue: 0,0:12:10.28,0:12:12.28,Caption,,0,0,0,,ОКОЛО ДВУХСОТ ТЫСЯЧ ТОНН В СУТКИ.
Dialogue: 0,0:12:12.86,0:12:15.32,Caption,,0,0,0,,РЕМОНТ ОТДЕЛЬНЫХ УСТАНОВОК ВТОРИЧНОЙ ПЕРЕРАБОТКИ
Dialogue: 0,0:12:15.32,0:12:18.52,Caption,,0,0,0,,ПОСЛЕ ПОРАЖЕНИЯ МОЖЕТ ЗАНИМАТЬ ОТ ШЕСТИ ДО ВОСЬМИ
Dialogue: 0,0:12:18.60,0:12:21.64,Caption,,0,0,0,,МЕСЯЦЕВ. ГЛАВНЫЙ УЩЕРБ ЗДЕСЬ НЕ ИЗМЕРЯЕТСЯ ВЫСОТОЙ
Dialogue: 0,0:12:21.64,0:12:24.52,Caption,,0,0,0,,ПЛАМЕНИ. ОГОНЬ МОЖНО ПОТУШИТЬ ЗА НЕСКОЛЬКО ЧАСОВ.
Dialogue: 0,0:12:26.80,0:12:28.96,Caption,,0,0,0,,СЛОЖНОЕ ОБОРУДОВАНИЕ ПОСЛЕ ЭТОГО ПРИХОДИТСЯ
Dialogue: 0,0:12:28.96,0:12:31.60,Caption,,0,0,0,,ВОССТАНАВЛИВАТЬ МЕСЯЦАМИ, ИСКАТЬ УЗЛЫ,
Dialogue: 0,0:12:31.79,0:12:34.72,Caption,,0,0,0,,ПРИВОЗИТЬ СПЕЦИАЛИСТОВ И ЗАНОВО ВЫСТРАИВАТЬ
Dialogue: 0,0:12:34.72,0:12:39.68,Caption,,0,0,0,,ПРОИЗВОДСТВЕННУЮ ЦЕПОЧКУ. У ЭТОЙ ЛИНИИ ПОЯВИЛАСЬ НОВАЯ ДЕТАЛЬ. ТРАМП РАНЕЕ
Dialogue: 0,0:12:39.68,0:12:42.40,Caption,,0,0,0,,ПРОСИЛ КИЕВ ПРЕКРАТИТЬ УДАРЫ ПО РОССИЙСКИМ НЕФТЯНЫМ
Dialogue: 0,0:12:42.40,0:12:45.52,Caption,,0,0,0,,ОБЪЕКТАМ. АТАКИ ПРОДОЛЖАЮТСЯ. ЗНАЧИТ,
Dialogue: 0,0:12:45.76,0:12:47.84,Caption,,0,0,0,,ПРОСЬБА ВАШИНГТОНА ИМЕЕТ ГРАНИЦУ,
Dialogue: 0,0:12:48.08,0:12:50.72,Caption,,0,0,0,,ЗА КОТОРОЙ КИЕВ ПРИНИМАЕТ РЕШЕНИЕ САМОСТОЯТЕЛЬНО.
Dialogue: 0,0:12:50.89,0:12:54.72,Caption,,0,0,0,,ВОПРОС ТОЛЬКО В ТОМ, НАСКОЛЬКО ДАЛЕКО МОЖНО ОТОЙТИ ОТ АМЕРИКАНСКОГО
Dialogue: 0,0:12:54.72,0:12:58.24,Caption,,0,0,0,,ПОЖЕЛАНИЯ, ОСТАВАЯСЬ ЗАВИСИМЫМ ОТ АМЕРИКАНСКИХ ТЕХНОЛОГИЙ.
Dialogue: 0,0:12:58.67,0:13:01.20,Caption,,0,0,0,,РЯДОМ СО СПОРОМ О STARSHIELD КОНТРАСТ ВЫГЛЯДИТ
Dialogue: 0,0:13:01.20,0:13:04.32,Caption,,0,0,0,,ОСОБЕННО ВЫРАЗИТЕЛЬНО. УКРАИНА ДЕМОНСТРИРУЕТ СВОБОДУ
Dialogue: 0,0:13:04.32,0:13:07.12,Caption,,0,0,0,,ДЕЙСТВИЙ ПРИ ВЫБОРЕ ЦЕЛЕЙ ДЛЯ БЕСПИЛОТНИКОВ. НО
Dialogue: 0,0:13:07.12,0:13:09.92,Caption,,0,0,0,,СТОИТ СПУТНИКОВОМУ СЕРВИСУ ПОТЕРЯТЬ ЧАСТЬ СКОРОСТИ,
Dialogue: 0,0:13:10.34,0:13:12.56,Caption,,0,0,0,,И ЗЕЛЕНСКИЙ УЖЕ ПУБЛИЧНО РАССКАЗЫВАЕТ,
Dialogue: 0,0:13:12.72,0:13:15.52,Caption,,0,0,0,,НАСКОЛЬКО ТЯЖЕЛО ЭТО БЬЁТ ПО ВОЗМОЖНОСТЯМ ПЕРЕХВАТА.
Dialogue: 0,0:13:16.08,0:13:19.12,Caption,,0,0,0,,НЕЗАВИСИМОСТЬ ПОЛУЧИЛАСЬ НА ДЛИННОМ ПРОВОДЕ. ХОДИТЬ
Dialogue: 0,0:13:19.20,0:13:21.92,Caption,,0,0,0,,МОЖНО ШИРОКО. ГЛАВНОЕ, НЕ ЗАБЫВАТЬ,
Dialogue: 0,0:13:22.08,0:13:26.56,Caption,,0,0,0,,У КОГО НАХОДИТСЯ РОЗЕТКА. НА ЭТОМ ФОНЕ ПОЯВИЛИСЬ ЕЩЁ ДВЕ ИСТОРИИ,
Dialogue: 0,0:13:26.73,0:13:31.68,Caption,,0,0,0,,СВЯЗАННЫЕ УЖЕ НЕ С ТЕХНИКОЙ, А С ЛЮДЬМИ. СЛУХОВОЙ УКРАИНСКИЙ КАНАЛ УТВЕРЖДАЕТ,
Dialogue: 0,0:13:32.00,0:13:34.72,Caption,,0,0,0,,ЧТО БАНКОВАЯ ЕЩЁ В СЕРЕДИНЕ ОКТЯБРЯ ПОТРЕБОВАЛА
Dialogue: 0,0:13:34.72,0:13:37.44,Caption,,0,0,0,,СОХРАНЯТЬ ВЫСОКИЙ ТЕМП НАСТУПАТЕЛЬНЫХ ДЕЙСТВИЙ НА
Dialogue: 0,0:13:37.44,0:13:43.01,Caption,,0,0,0,,УЧАСТКАХ, ГДЕ ЭТО ВОЗМОЖНО. ПО ВЕРСИИ ЕГО ИСТОЧНИКА,
Dialogue: 0,0:13:43.21,0:13:45.81,Caption,,0,0,0,,ПЕХОТУ ПРОДОЛЖАЮТ НАПРАВЛЯТЬ В АТАКИ ПРИ СКРОМНОМ
Dialogue: 0,0:13:45.81,0:13:49.17,Caption,,0,0,0,,РЕЗУЛЬТАТЕ И БОЛЬШИХ ПОТЕРЯХ ЛИЧНОГО СОСТАВА. ТАМ ЖЕ
Dialogue: 0,0:13:49.17,0:13:53.17,Caption,,0,0,0,,ГОВОРИТСЯ, ЧТО КОМАНДОВАНИЕ ПРЕДУПРЕЖДАЛО О ПРИБЛИЖЕНИИ ТЯЖЁЛОЙ
Dialogue: 0,0:13:53.17,0:13:58.21,Caption,,0,0,0,,СИТУАЦИИ С ЛЮДЬМИ. ОТВЕТОМ СТАЛО НАМЕРЕНИЕ УСИЛИТЬ МОБИЛИЗАЦИЮ И ТАКИМ
Dialogue: 0,0:13:58.21,0:14:01.25,Caption,,0,0,0,,СПОСОБОМ НАБРАТЬ ПОПОЛНЕНИЕ. ИСТОЧНИК НАЗЫВАЕТ
Dialogue: 0,0:14:01.25,0:14:04.21,Caption,,0,0,0,,БУДУЩИХ СОЛДАТ КРЕПОСТНЫМИ. ЭТО ИМЕННО ВЕРСИЯ
Dialogue: 0,0:14:04.21,0:14:08.13,Caption,,0,0,0,,СЛУХОВОГО КАНАЛА, А НЕ УСТАНОВЛЕННЫЙ ФАКТ. НО ОНА ВАЖНА КАК
Dialogue: 0,0:14:08.13,0:14:12.21,Caption,,0,0,0,,ОПИСАНИЕ ТОГО, КАКИЕ РЕШЕНИЯ ОБСУЖДАЮТСЯ ВНУТРИ УКРАИНСКОГО
Dialogue: 0,0:14:12.21,0:14:14.93,Caption,,0,0,0,,ИНФОРМАЦИОННОГО ПРОСТРАНСТВА. РЯДОМ ПОЯВИЛАСЬ
Dialogue: 0,0:14:14.93,0:14:18.05,Caption,,0,0,0,,ИСТОРИЯ ИЗ ХЕРСОНСКОЙ ОБЛАСТИ. МЕСТНАЯ ЖИТЕЛЬНИЦА
Dialogue: 0,0:14:18.05,0:14:21.65,Caption,,0,0,0,,УТВЕРЖДАЕТ, ЧТО ЗА СВЕДЕНИЯ О МУЖЧИНАХ ПРИЗЫВНОГО ВОЗРАСТА,
Dialogue: 0,0:14:21.81,0:14:26.21,Caption,,0,0,0,,КОТОРЫХ ИЩУТ СОТРУДНИКИ ТЦК, ВЫПЛАЧИВАЮТ ДЕНЬГИ. ПО ЕЁ РАССКАЗУ,
Dialogue: 0,0:14:26.45,0:14:29.33,Caption,,0,0,0,,К НАБЛЮДЕНИЮ ПОДКЛЮЧАЮТСЯ ДАЖЕ ПОДРОСТКИ НА МОПЕДАХ.
Dialogue: 0,0:14:29.72,0:14:32.45,Caption,,0,0,0,,ОНИ ЗАМЕЧАЮТ ПЕРЕМЕЩЕНИЯ МУЖЧИН И ПЕРЕДАЮТ
Dialogue: 0,0:14:32.45,0:14:35.73,Caption,,0,0,0,,ИНФОРМАЦИЮ ЗА ВОЗНАГРАЖДЕНИЕ. АВТОР СООБЩЕНИЯ НЕ
Dialogue: 0,0:14:35.73,0:14:38.37,Caption,,0,0,0,,ПРЕДЪЯВЛЯЕТ ПРОВЕРЯЕМЫХ ПОДТВЕРЖДЕНИЙ. ОДНАКО
Dialogue: 0,0:14:38.37,0:14:40.85,Caption,,0,0,0,,НАРИСОВАННЫЙ МЕХАНИЗМ СЛИШКОМ ПОКАЗАТЕЛЕН,
Dialogue: 0,0:14:41.01,0:14:44.05,Caption,,0,0,0,,ЧТОБЫ ЕГО НЕ ЗАМЕТИТЬ. НАВЕРХУ ТРЕБУЮТ СОХРАНЯТЬ
Dialogue: 0,0:14:44.05,0:14:47.25,Caption,,0,0,0,,ТЕМП ОПЕРАЦИЙ. ВНИЗУ СТАНОВИТСЯ МЕНЬШЕ ЛЮДЕЙ,
Dialogue: 0,0:14:47.41,0:14:49.89,Caption,,0,0,0,,КОТОРЫХ МОЖНО ОТПРАВИТЬ В СТРОЙ. МЕЖДУ ЭТИМИ
Dialogue: 0,0:14:49.97,0:14:53.01,Caption,,0,0,0,,УРОВНЯМИ ПОЯВЛЯЕТСЯ ПЛАТНАЯ СЕТЬ ПОИСКА ОЧЕРЕДНОГО
Dialogue: 0,0:14:53.01,0:14:55.65,Caption,,0,0,0,,ПОПОЛНЕНИЯ. ЖЕЛЕЗНОДОРОЖНОЙ СЕТИ НЕ ХВАТАЕТ
Dialogue: 0,0:14:55.65,0:15:01.13,Caption,,0,0,0,,ЛОКОМОТИВОВ. ПЕРЕПРАВАМ ТРЕБУЮТСЯ ПОСТОЯННЫЕ РЕМОНТНИКИ.
Dialogue: 0,0:15:01.36,0:15:04.25,Caption,,0,0,0,,БЕСПИЛОТНИКАМ НУЖНА СТАБИЛЬНАЯ СВЯЗЬ. ПЕХОТЕ
Dialogue: 0,0:15:04.25,0:15:07.61,Caption,,0,0,0,,НЕОБХОДИМО ПОПОЛНЕНИЕ. КАЖДЫЙ УЧАСТОК ПРОСИТ НОВЫЙ
Dialogue: 0,0:15:07.61,0:15:11.29,Caption,,0,0,0,,РЕСУРС В ТОТ МОМЕНТ, КОГДА СОСЕДНИЙ УЖЕ ТРЕБУЕТ ТОГО ЖЕ САМОГО.
Dialogue: 0,0:15:12.09,0:15:14.97,Caption,,0,0,0,,НАНЕСТИ ПРОТИВНИКУ УЩЕРБ И УДЕРЖАТЬ СОБСТВЕННУЮ
Dialogue: 0,0:15:14.97,0:15:17.77,Caption,,0,0,0,,СИСТЕМУ ОТ РАССЫПАНИЯ ПРЕДСТАВЛЯЮТ СОБОЙ ДВЕ
Dialogue: 0,0:15:17.77,0:15:20.73,Caption,,0,0,0,,СОВЕРШЕННО РАЗНЫЕ ЗАДАЧИ. УКРАИНСКИЕ БЕСПИЛОТНИКИ
Dialogue: 0,0:15:20.73,0:15:23.93,Caption,,0,0,0,,ПРОДОЛЖАЮТ ДОСТИГАТЬ РОССИЙСКИХ НПЗ И ПЫТАТЬСЯ
Dialogue: 0,0:15:23.93,0:15:26.97,Caption,,0,0,0,,АТАКОВАТЬ КРЫМСКИЙ МОСТ. РОССИЙСКАЯ СТОРОНА ДАВИТ НА
Dialogue: 0,0:15:26.97,0:15:32.41,Caption,,0,0,0,,УКРАИНСКИЙ ТРАНСПОРТ, ЭНЕРГЕТИКУ И ВОЕННОЕ СНАБЖЕНИЕ. КАЖДЫЙ ИЩЕТ МЕСТО,
Dialogue: 0,0:15:32.66,0:15:35.13,Caption,,0,0,0,,ГДЕ СОПЕРНИКУ БОЛЬНЕЕ И ДОРОЖЕ ВСЕГО
Dialogue: 0,0:15:35.13,0:15:37.69,Caption,,0,0,0,,ВОССТАНАВЛИВАТЬСЯ. НО НАСТОЯЩАЯ УСТОЙЧИВОСТЬ
Dialogue: 0,0:15:37.69,0:15:40.73,Caption,,0,0,0,,ПРОЯВЛЯЕТСЯ НЕ В КРАСИВОМ ВИДЕО ПОПАДАНИЯ И НЕ
Dialogue: 0,0:15:40.81,0:15:43.37,Caption,,0,0,0,,В ГРОМКОМ ОТЧЁТЕ. ОНА ИЗМЕРЯЕТСЯ КОЛИЧЕСТВОМ
Dialogue: 0,0:15:43.37,0:15:45.77,Caption,,0,0,0,,ИСПРАВНЫХ МАШИН, ДОСТУПНЫХ ДЕТАЛЕЙ,
Dialogue: 0,0:15:45.93,0:15:49.85,Caption,,0,0,0,,ПОДГОТОВЛЕННЫХ СПЕЦИАЛИСТОВ, РЕЗЕРВНЫХ МАРШРУТОВ И ЛЮДЕЙ,
Dialogue: 0,0:15:50.17,0:15:52.33,Caption,,0,0,0,,КОТОРЫЕ ЕЩЁ СПОСОБНЫ ВЫЙТИ НА РАБОТУ ПОСЛЕ
Dialogue: 0,0:15:52.33,0:15:57.13,Caption,,0,0,0,,ОЧЕРЕДНОГО УДАРА. РАКЕТЫ В ЭТОЙ АРИФМЕТИКЕ ЛИШЬ ОТКРЫВАЮТ СЧЁТ. ЕСЛИ
Dialogue: 0,0:15:57.13,0:15:59.77,Caption,,0,0,0,,ГОСУДАРСТВУ ОДНОВРЕМЕННО ПРИХОДИТСЯ ИСКАТЬ ЗАМЕНУ
Dialogue: 0,0:15:59.77,0:16:02.81,Caption,,0,0,0,,ЛОКОМОТИВАМ, ПРОЕКТИРОВАТЬ ВРЕМЕННЫЕ ПЕРЕПРАВЫ,
Dialogue: 0,0:16:02.98,0:16:06.17,Caption,,0,0,0,,ВЫЯСНЯТЬ СУДЬБУ СПУТНИКОВОГО КАНАЛА И ДОБЫВАТЬ НОВЫХ
Dialogue: 0,0:16:06.17,0:16:09.77,Caption,,0,0,0,,СОЛДАТ, ОТДЕЛЬНЫЕ ПОЛОМКИ СКЛАДЫВАЮТСЯ В НАГРУЗКУ НА ВСЮ
Dialogue: 0,0:16:09.77,0:16:12.89,Caption,,0,0,0,,КОНСТРУКЦИЮ. И ТОГДА ГЛАВНЫЙ ВОПРОС ЗВУЧИТ УЖЕ НЕ
Dialogue: 0,0:16:12.97,0:16:15.69,Caption,,0,0,0,,О ТОМ, КАКАЯ ПРОБЛЕМА ОКАЖЕТСЯ СЛЕДУЮЩЕЙ.
Dialogue: 0,0:16:17.88,0:16:22.20,Caption,,0,0,0,,В КОММЕНТАРИЯХ НАПИШИТЕ, КАКОЙ ПРЕДЕЛ ПРОЧНОСТИ ВЫ ВИДИТЕ У ТАКОЙ СИСТЕМЫ.
Dialogue: 0,0:16:22.58,0:16:27.16,Caption,,0,0,0,,СКОЛЬКО АВАРИЙ, РЕМОНТОВ И ДЕФИЦИТОВ ОНА СМОЖЕТ ТЯНУТЬ ОДНОВРЕМЕННО,
Dialogue: 0,0:16:27.37,0:16:29.96,Caption,,0,0,0,,ПРЕЖДЕ ЧЕМ ОЧЕРЕДНАЯ ВРЕМЕННАЯ ПОДПОРКА САМА
Dialogue: 0,0:16:29.96,0:16:31.08,Caption,,0,0,0,,ПОТРЕБУЕТ ПОДПОРКИ?
