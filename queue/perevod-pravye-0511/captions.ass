Dialogue: 0,0:00:00.12,0:00:04.20,Caption,,0,0,0,,ЕВРОПА ПРИДУМАЛА, КАК ПОБЕДИТЬ ПРАВЫХ. НЕ ПУСКАТЬ ИХ К ВЛАСТИ
Dialogue: 0,0:00:04.42,0:00:06.76,Caption,,0,0,0,,И ОДНОВРЕМЕННО ПОТИХОНЬКУ ЗАБИРАТЬ ИХ ПРОГРАММУ
Dialogue: 0,0:00:06.84,0:00:10.20,Caption,,0,0,0,,СЕБЕ. ОЧЕНЬ УДОБНО. ИЗБИРАТЕЛЮ ГОВОРЯТ ЭТИХ ЛЮДЕЙ
Dialogue: 0,0:00:10.20,0:00:12.92,Caption,,0,0,0,,ВЫБИРАТЬ НЕЛЬЗЯ. А ЧЕРЕЗ ПОЛГОДА НАЧИНАЮТ ДЕЛАТЬ
Dialogue: 0,0:00:13.00,0:00:16.52,Caption,,0,0,0,,ПРИМЕРНО ТО, О ЧЁМ ЭТИ ЛЮДИ ГОВОРИЛИ НЕСКОЛЬКО ЛЕТ. КРАСИВО
Dialogue: 0,0:00:16.60,0:00:19.00,Caption,,0,0,0,,РАБОТАЕТ ДЕМОКРАТИЯ. ЕСЛИ ВАМ НРАВЯТСЯ ТАКИЕ
Dialogue: 0,0:00:19.00,0:00:23.56,Caption,,0,0,0,,ПОЛИТИЧЕСКИЕ ФОКУСЫ, ПОДПИСЫВАЙТЕСЬ. ВОПРОС ЗДЕСЬ ПРОСТОЙ ЧТО ПРОИСХОДИТ,
Dialogue: 0,0:00:23.80,0:00:26.44,Caption,,0,0,0,,КОГДА МИЛЛИОНЫ ЕВРОПЕЙЦЕВ ГОЛОСУЮТ ЗА СИЛЫ,
Dialogue: 0,0:00:26.68,0:00:29.40,Caption,,0,0,0,,КОТОРЫЕ ПОЛИТИЧЕСКАЯ СИСТЕМА НЕ ХОЧЕТ ДОПУСКАТЬ К
Dialogue: 0,0:00:29.40,0:00:33.16,Caption,,0,0,0,,ВЛАСТИ? ТАК ВОТ. ПОЯВИЛСЯ ЕЩЁ ОДИН ОТВЕТ. МОЖНО НЕ
Dialogue: 0,0:00:33.16,0:00:36.04,Caption,,0,0,0,,ОТДАВАТЬ ИМ ВЛАСТЬ. И НАЧАТЬ ДВИГАТЬ САМУ ПОЛИТИКУ
Dialogue: 0,0:00:36.12,0:00:38.68,Caption,,0,0,0,,В ИХ СТОРОНУ. ПРИЧЁМ ПРОЦЕСС УЖЕ ХОРОШО ВИДЕН.
Dialogue: 0,0:00:39.00,0:00:41.72,Caption,,0,0,0,,ЕЩЁ НЕСКОЛЬКО ЛЕТ НАЗАД РАЗГОВОР ЕВРОПЕЙСКИХ ПРАВЫХ
Dialogue: 0,0:00:41.80,0:00:45.00,Caption,,0,0,0,,С ЕВРОСОЮЗОМ ЧАСТО ЗВУЧАЛ ПРИМЕРНО ТАК. БРЮССЕЛЬ
Dialogue: 0,0:00:45.00,0:00:47.72,Caption,,0,0,0,,ЗАБРАЛ СЛИШКОМ МНОГО ПОЛНОМОЧИЙ. НАЦИОНАЛЬНЫЕ
Dialogue: 0,0:00:47.72,0:00:50.76,Caption,,0,0,0,,ГОСУДАРСТВА ДОЛЖНЫ ВЕРНУТЬ СЕБЕ КОНТРОЛЬ. ЕВРОСОЮЗ
Dialogue: 0,0:00:50.84,0:00:52.36,Caption,,0,0,0,,ЛИБО НАДО ПОЛНОСТЬЮ ПЕРЕДЕЛЫВАТЬ,
Dialogue: 0,0:00:52.68,0:00:56.68,Caption,,0,0,0,,ЛИБО ВООБЩЕ ЗАДУМАТЬСЯ, НУЖЕН ЛИ ОН В ТАКОМ ВИДЕ. ТЕПЕРЬ ФОРМУЛИРОВКА
Dialogue: 0,0:00:56.68,0:00:59.56,Caption,,0,0,0,,МЕНЯЕТСЯ. МАРИН ЛЕ ПЕН ВО ФРАНЦИИ И АЛИСА
Dialogue: 0,0:00:59.64,0:01:02.60,Caption,,0,0,0,,ВАЙДЕЛЬ В ГЕРМАНИИ УЖЕ НЕ СТРОЯТ ГЛАВНУЮ КАМПАНИЮ
Dialogue: 0,0:01:02.68,0:01:05.80,Caption,,0,0,0,,ВОКРУГ ВЫХОДА СВОИХ СТРАН ИЗ ЕВРОПЕЙСКОГО СОЮЗА. ОБЕ
Dialogue: 0,0:01:05.80,0:01:09.64,Caption,,0,0,0,,ГОВОРЯТ О ДРУГОМ. ЕВРОСОЮЗ ОСТАВИТЬ. НО ПЕРЕДЕЛАТЬ.
Dialogue: 0,0:01:09.88,0:01:12.20,Caption,,0,0,0,,СДЕЛАТЬ ЕГО СОЮЗОМ СУВЕРЕННЫХ ГОСУДАРСТВ.
Dialogue: 0,0:01:14.49,0:01:17.45,Caption,,0,0,0,,ОСЛАБИТЬ НАДНАЦИОНАЛЬНЫЕ ИНСТИТУТЫ. ВЕРНУТЬ БОЛЬШЕ
Dialogue: 0,0:01:17.53,0:01:20.09,Caption,,0,0,0,,ПОЛНОМОЧИЙ НАЦИОНАЛЬНЫМ ПРАВИТЕЛЬСТВАМ. ТО ЕСТЬ
Dialogue: 0,0:01:20.09,0:01:22.97,Caption,,0,0,0,,РАНЬШЕ СПОР ВЫГЛЯДЕЛ КАК ВЫБОР МЕЖДУ ЕВРОСОЮЗОМ И
Dialogue: 0,0:01:23.05,0:01:25.85,Caption,,0,0,0,,ПРОТИВНИКАМИ ЕВРОСОЮЗА. ТЕПЕРЬ ПРАВЫЕ ГОВОРЯТ
Dialogue: 0,0:01:25.85,0:01:28.89,Caption,,0,0,0,,ЕВРОСОЮЗ БУДЕТ. ТОЛЬКО СОВСЕМ ДРУГОЙ. ВОТ ЭТО
Dialogue: 0,0:01:28.97,0:01:33.69,Caption,,0,0,0,,ИЗМЕНЕНИЕ ГОРАЗДО СЕРЬЁЗНЕЕ, ЧЕМ ОЧЕРЕДНОЙ ГРОМКИЙ МИТИНГ. ПОТОМУ ЧТО ЧЕЛОВЕК,
Dialogue: 0,0:01:33.85,0:01:38.41,Caption,,0,0,0,,КОТОРЫЙ ТРЕБУЕТ СНЕСТИ ДОМ, УДОБЕН ДЛЯ ХОЗЯИНА ДОМА. НА НЕГО МОЖНО ПОКАЗАТЬ
Dialogue: 0,0:01:38.49,0:01:42.97,Caption,,0,0,0,,ПАЛЬЦЕМ И СКАЗАТЬ СМОТРИТЕ, СУМАСШЕДШИЙ ПРИШЁЛ С КУВАЛДОЙ. ГОРАЗДО ХУЖЕ,
Dialogue: 0,0:01:43.21,0:01:45.77,Caption,,0,0,0,,КОГДА ЧЕЛОВЕК ГОВОРИТ ДОМ ОСТАВЛЯЕМ. ТОЛЬКО
Dialogue: 0,0:01:45.77,0:01:49.45,Caption,,0,0,0,,УПРАВЛЯЮЩУЮ КОМПАНИЮ МЕНЯЕМ, ПОЛОВИНУ ПРАВИЛ ОТМЕНЯЕМ,
Dialogue: 0,0:01:49.61,0:01:52.41,Caption,,0,0,0,,КЛЮЧИ ОТ НЕКОТОРЫХ ПОМЕЩЕНИЙ ВОЗВРАЩАЕМ ЖИЛЬЦАМ,
Dialogue: 0,0:01:52.72,0:01:56.09,Caption,,0,0,0,,А ПРЕДСЕДАТЕЛЯ БОЛЬШЕ НЕ СЛУШАЕМСЯ. ВОТ ЗДЕСЬ СПОР
Dialogue: 0,0:01:56.09,0:01:58.97,Caption,,0,0,0,,СТАНОВИТСЯ НЕПРИЯТНЫМ. ПОТОМУ ЧТО ТАКОЙ ЧЕЛОВЕК УЖЕ
Dialogue: 0,0:01:59.05,0:02:01.37,Caption,,0,0,0,,НЕ ПРЕДЛАГАЕТ РАЗРУШЕНИЕ. ОН ПРЕДЛАГАЕТ
Dialogue: 0,0:02:01.37,0:02:04.57,Caption,,0,0,0,,АЛЬТЕРНАТИВНОЕ УПРАВЛЕНИЕ. АДГ ИМЕННО ЭТИМ СЕЙЧАС И
Dialogue: 0,0:02:04.57,0:02:07.61,Caption,,0,0,0,,ЗАНИМАЕТСЯ. ПАРТИЯ КОГДА ТО ВЫРОСЛА В ТОМ ЧИСЛЕ
Dialogue: 0,0:02:07.69,0:02:10.01,Caption,,0,0,0,,ИЗ НЕДОВОЛЬСТВА ЕВРО И ЕВРОПЕЙСКОЙ ФИНАНСОВОЙ
Dialogue: 0,0:02:10.01,0:02:13.37,Caption,,0,0,0,,ПОЛИТИКОЙ. ПОТОМ ЕЁ ГЛАВНЫМ ТОПЛИВОМ СТАЛА МИГРАЦИЯ.
Dialogue: 0,0:02:13.69,0:02:16.33,Caption,,0,0,0,,А ТЕПЕРЬ, КОГДА ПОДДЕРЖКА ВЫРОСЛА НАСТОЛЬКО,
Dialogue: 0,0:02:16.63,0:02:19.21,Caption,,0,0,0,,ЧТО РЕЧЬ УЖЕ ИДЁТ О ВОЗМОЖНОСТИ РЕАЛЬНОГО УЧАСТИЯ
Dialogue: 0,0:02:19.29,0:02:23.45,Caption,,0,0,0,,ВО ВЛАСТИ В БУДУЩЕМ, ВНУТРИ ПАРТИИ ИДЁТ ПЕРЕСБОРКА ОТНОШЕНИЯ К САМОМУ
Dialogue: 0,0:02:23.45,0:02:26.01,Caption,,0,0,0,,ЕВРОСОЮЗУ. ПРИЧИНА ДОВОЛЬНО ПОНЯТНАЯ.
Dialogue: 0,0:02:28.28,0:02:32.85,Caption,,0,0,0,,КОГДА У ТЕБЯ ПЯТЬ ПРОЦЕНТОВ, МОЖНО ОБЕЩАТЬ ПЕРЕВЕРНУТЬ СТОЛ. КОГДА У ТЕБЯ ЕСТЬ
Dialogue: 0,0:02:32.85,0:02:34.77,Caption,,0,0,0,,ШАНС ОДНАЖДЫ ЗА ЭТОТ СТОЛ СЕСТЬ,
Dialogue: 0,0:02:34.93,0:02:39.01,Caption,,0,0,0,,НАЧИНАЕШЬ ИНТЕРЕСОВАТЬСЯ, ГДЕ ЛЕЖАТ ДОКУМЕНТЫ. REUTERS ПИШЕТ,
Dialogue: 0,0:02:39.24,0:02:41.97,Caption,,0,0,0,,ЧТО ПОСЛЕ СЕРЬЁЗНЫХ УСПЕХОВ АДГ И РОСТА ЕЁ
Dialogue: 0,0:02:41.97,0:02:44.53,Caption,,0,0,0,,ВЛИЯНИЯ ПАРТИЯ ВСЁ БОЛЬШЕ ДУМАЕТ УЖЕ НЕ КАК
Dialogue: 0,0:02:44.53,0:02:48.93,Caption,,0,0,0,,ВЕЧНЫЙ ПРОТЕСТ, А КАК СИЛА, КОТОРОЙ ПОТЕНЦИАЛЬНО ПРИДЁТСЯ ОБЪЯСНЯТЬ,
Dialogue: 0,0:02:49.09,0:02:51.49,Caption,,0,0,0,,ЧТО ИМЕННО ОНА БУДЕТ ДЕЛАТЬ С ЕВРОПОЙ,
Dialogue: 0,0:02:51.65,0:02:54.53,Caption,,0,0,0,,ЕСЛИ ПОЛУЧИТ ВЛАСТЬ. И ЗДЕСЬ БРАНДМАУЭР НАЧИНАЕТ
Dialogue: 0,0:02:54.53,0:02:57.57,Caption,,0,0,0,,ДАВАТЬ ИНТЕРЕСНЫЙ ПОБОЧНЫЙ ЭФФЕКТ. МЕРЦ МОЖЕТ
Dialogue: 0,0:02:57.65,0:03:02.13,Caption,,0,0,0,,СКОЛЬКО УГОДНО ПОВТОРЯТЬ, ЧТО СОТРУДНИЧЕСТВА С АДГ НЕ БУДЕТ. ТРАДИЦИОННЫЕ
Dialogue: 0,0:03:02.21,0:03:05.25,Caption,,0,0,0,,ПАРТИИ МОГУТ ДЕРЖАТЬ ПАРТИЙНУЮ ДВЕРЬ ЗАКРЫТОЙ. НО
Dialogue: 0,0:03:05.25,0:03:08.53,Caption,,0,0,0,,ЗАКРЫТЬ ТЕМУ МИГРАЦИИ УЖЕ НЕВОЗМОЖНО. ЗАКРЫТЬ ТЕМУ
Dialogue: 0,0:03:08.53,0:03:11.81,Caption,,0,0,0,,НАЦИОНАЛЬНОГО СУВЕРЕНИТЕТА НЕВОЗМОЖНО. ЗАКРЫТЬ
Dialogue: 0,0:03:11.89,0:03:15.25,Caption,,0,0,0,,РАЗГОВОР О ТОМ, СКОЛЬКО ПОЛНОМОЧИЙ ДОЛЖНО БЫТЬ У БРЮССЕЛЯ,
Dialogue: 0,0:03:15.33,0:03:18.37,Caption,,0,0,0,,НЕВОЗМОЖНО. НЕЛЬЗЯ ПРИКАЗАТЬ ИЗБИРАТЕЛЮ ПЕРЕСТАТЬ
Dialogue: 0,0:03:18.37,0:03:20.21,Caption,,0,0,0,,ИНТЕРЕСОВАТЬСЯ ЭТИМ ТОЛЬКО ПОТОМУ,
Dialogue: 0,0:03:20.37,0:03:23.57,Caption,,0,0,0,,ЧТО НЕПРАВИЛЬНАЯ ПАРТИЯ ПЕРВОЙ ПОСТАВИЛА ВОПРОС. И
Dialogue: 0,0:03:23.57,0:03:26.37,Caption,,0,0,0,,НАЧИНАЕТСЯ ПОЛИТИЧЕСКОЕ ЗАИМСТВОВАНИЕ. ПРИЧЁМ ЭТО
Dialogue: 0,0:03:26.45,0:03:29.41,Caption,,0,0,0,,ВООБЩЕ ОБЫЧНАЯ ВЕЩЬ. ЕСЛИ КОНКУРЕНТ ЗАБИРАЕТ У ТЕБЯ
Dialogue: 0,0:03:29.41,0:03:33.41,Caption,,0,0,0,,ИЗБИРАТЕЛЯ НА КАКОЙ ТО ТЕМЕ, МОЖНО ПРОДОЛЖАТЬ ОБЪЯСНЯТЬ ИЗБИРАТЕЛЮ,
Dialogue: 0,0:03:33.49,0:03:36.21,Caption,,0,0,0,,ЧТО ТЕМА НЕПРАВИЛЬНАЯ. А МОЖНО ОДНАЖДЫ ОТКРЫТЬ
Dialogue: 0,0:03:36.21,0:03:39.81,Caption,,0,0,0,,СОЦИОЛОГИЮ, ТЯЖЕЛО ВЗДОХНУТЬ И СКАЗАТЬ СОТРУДНИКАМ ЛАДНО,
Dialogue: 0,0:03:39.97,0:03:46.63,Caption,,0,0,0,,ПИШИТЕ НОВЫЙ ПУНКТ ПРОГРАММЫ. И ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ БЫВШАЯ МАРГИНАЛЬНАЯ ИДЕЯ УЖЕ
Dialogue: 0,0:03:46.63,0:03:49.59,Caption,,0,0,0,,СИДИТ ЗА БОЛЬШИМ СТОЛОМ В ХОРОШЕМ КОСТЮМЕ. ТОЛЬКО
Dialogue: 0,0:03:49.67,0:03:52.95,Caption,,0,0,0,,ФАМИЛИЯ АВТОРА КУДА ТО ИСЧЕЗЛА. ЕВРОПЕЙСКИЙ СОВЕТ ПО
Dialogue: 0,0:03:52.95,0:03:55.59,Caption,,0,0,0,,МЕЖДУНАРОДНЫМ ОТНОШЕНИЯМ СЕЙЧАС ВООБЩЕ ФОРМУЛИРУЕТ
Dialogue: 0,0:03:55.67,0:03:59.03,Caption,,0,0,0,,МЫСЛЬ ЕЩЁ ЖЁСТЧЕ. ПРАВЫЕ МОГУТ ВЫИГРАТЬ ЕВРОПЕЙСКУЮ
Dialogue: 0,0:03:59.03,0:04:03.83,Caption,,0,0,0,,ПОЛИТИЧЕСКУЮ БОРЬБУ ДАЖЕ ТАМ, ГДЕ НЕПОСРЕДСТВЕННО НЕ ПОЛУЧАЮТ ВЛАСТЬ. ПОТОМУ ЧТО
Dialogue: 0,0:04:03.91,0:04:06.55,Caption,,0,0,0,,ИХ ОСНОВНЫЕ ТЕМЫ УЖЕ НАЧИНАЮТ ОПРЕДЕЛЯТЬ ПОВЕСТКУ
Dialogue: 0,0:04:06.55,0:04:09.35,Caption,,0,0,0,,ОСТАЛЬНЫХ. МИГРАЦИЯ. БЕЗОПАСНОСТЬ.
Dialogue: 0,0:04:09.59,0:04:11.99,Caption,,0,0,0,,КОНКУРЕНТОСПОСОБНОСТЬ ЕВРОПЕЙСКОЙ ЭКОНОМИКИ.
Dialogue: 0,0:04:12.23,0:04:15.03,Caption,,0,0,0,,ОТНОШЕНИЯ НАЦИОНАЛЬНЫХ ГОСУДАРСТВ С БРЮССЕЛЕМ. ТО
Dialogue: 0,0:04:15.11,0:04:17.11,Caption,,0,0,0,,ЕСТЬ БОРЬБА ИДЁТ УЖЕ НЕ ТОЛЬКО ЗА КРЕСЛА.
Dialogue: 0,0:04:17.35,0:04:22.23,Caption,,0,0,0,,ОНА ИДЁТ ЗА СПИСОК ВОПРОСОВ, КОТОРЫМИ ЕВРОПА БУДЕТ ЗАНИМАТЬСЯ СЛЕДУЮЩИЕ ГОДЫ. ВОТ
Dialogue: 0,0:04:22.23,0:04:24.87,Caption,,0,0,0,,ЭТО И ЕСТЬ КЛЮЧЕВОЙ СДВИГ. ЕСЛИ ВАМ ИНТЕРЕСНЫ
Dialogue: 0,0:04:24.87,0:04:27.83,Caption,,0,0,0,,ТАКИЕ РАЗБОРЫ, ПОДПИШИТЕСЬ. ДАЛЬШЕ ПОСМОТРИМ,
Dialogue: 0,0:04:27.99,0:04:30.55,Caption,,0,0,0,,ПОЧЕМУ ЕВРОПЕЙСКИМ ПРАВЫМ УЖЕ НЕ ОБЯЗАТЕЛЬНО
Dialogue: 0,0:04:30.55,0:04:33.75,Caption,,0,0,0,,ДЕРЖАТЬСЯ ЗА САМОГО ТРАМПА. РАНЬШЕ ИСТЕБЛИШМЕНТ МОГ
Dialogue: 0,0:04:33.83,0:04:36.23,Caption,,0,0,0,,СКАЗАТЬ ВОТ ЕСТЬ НОРМАЛЬНАЯ ЕВРОПЕЙСКАЯ ПОЛИТИКА,
Dialogue: 0,0:04:36.48,0:04:38.63,Caption,,0,0,0,,А ГДЕ ТО СБОКУ СИДЯТ ПОПУЛИСТЫ И МЕШАЮТ
Dialogue: 0,0:04:38.71,0:04:41.99,Caption,,0,0,0,,РАБОТАТЬ. ТЕПЕРЬ САМИ ПОПУЛИСТЫ ВСЁ ЧАЩЕ ОПРЕДЕЛЯЮТ,
Dialogue: 0,0:04:42.23,0:04:44.63,Caption,,0,0,0,,О ЧЁМ ВООБЩЕ НАДО ГОВОРИТЬ. И ЗДЕСЬ ТРАМП
Dialogue: 0,0:04:44.63,0:04:47.59,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ УЖЕ СОВЕРШЕННО В ДРУГОЙ РОЛИ. ТРАМП ДАВНО
Dialogue: 0,0:04:47.59,0:04:50.39,Caption,,0,0,0,,СТАЛ МЕЖДУНАРОДНЫМ ПОЛИТИЧЕСКИМ ПОЛЮСОМ. СЕГОДНЯ
Dialogue: 0,0:04:50.47,0:04:53.59,Caption,,0,0,0,,МОЖНО ПОЙТИ ДАЛЬШЕ. ТРАМП ОКАЗАЛСЯ ДОНОРОМ. НЕ
Dialogue: 0,0:04:53.67,0:05:00.19,Caption,,0,0,0,,ДЕНЕГ. ПОЛИТИЧЕСКОГО ЯЗЫКА. ДО НЕГО НАЦИОНАЛЬНЫЙ ИНТЕРЕС ТОЖЕ СУЩЕСТВОВАЛ.
Dialogue: 0,0:05:00.43,0:05:03.39,Caption,,0,0,0,,МИГРАЦИОННЫЕ СПОРЫ СУЩЕСТВОВАЛИ. КОНФЛИКТ МЕЖДУ
Dialogue: 0,0:05:03.39,0:05:06.43,Caption,,0,0,0,,СТОЛИЦЕЙ И НАДНАЦИОНАЛЬНЫМИ ИНСТИТУТАМИ СУЩЕСТВОВАЛ.
Dialogue: 0,0:05:06.68,0:05:09.07,Caption,,0,0,0,,НЕДОВОЛЬСТВО ЭЛИТАМИ ТОЖЕ НИКТО ВЧЕРА УТРОМ НЕ
Dialogue: 0,0:05:09.07,0:05:14.19,Caption,,0,0,0,,ПРИДУМАЛ. НО ТРАМП ПОКАЗАЛ, КАК ВСЁ ЭТО СОБИРАТЬ В ОДНУ РАБОТАЮЩУЮ ПОЛИТИЧЕСКУЮ
Dialogue: 0,0:05:14.19,0:05:17.71,Caption,,0,0,0,,МАШИНУ. НЕ ИЗВИНЯТЬСЯ ЗА ЖЁСТКИЕ ФОРМУЛИРОВКИ. НЕ
Dialogue: 0,0:05:17.79,0:05:21.95,Caption,,0,0,0,,ПЫТАТЬСЯ ПОНРАВИТЬСЯ МЕДИА, КОТОРЫЕ ВСЁ РАВНО ТЕБЯ НЕНАВИДЯТ. ПРЕВРАЩАТЬ
Dialogue: 0,0:05:22.03,0:05:24.59,Caption,,0,0,0,,КОНФЛИКТ С ИНСТИТУТАМИ В ПОДТВЕРЖДЕНИЕ СОБСТВЕННОЙ
Dialogue: 0,0:05:24.59,0:05:27.07,Caption,,0,0,0,,ПРАВОТЫ. ГОВОРИТЬ ИЗБИРАТЕЛЮ ЕСЛИ ВСЯ ЭТА
Dialogue: 0,0:05:27.07,0:05:29.63,Caption,,0,0,0,,КОНСТРУКЦИЯ ТАК СИЛЬНО ПЫТАЕТСЯ МЕНЯ ОСТАНОВИТЬ,
Dialogue: 0,0:05:29.95,0:05:32.43,Caption,,0,0,0,,ЗНАЧИТ Я ДЕЙСТВИТЕЛЬНО МЕШАЮ ЕЙ ДЕЛАТЬ ТО,
Dialogue: 0,0:05:32.59,0:05:35.47,Caption,,0,0,0,,ЧТО ОНА ПРИВЫКЛА ДЕЛАТЬ. ЕВРОПЕЙСКИЕ ПРАВЫЕ ЭТУ
Dialogue: 0,0:05:35.47,0:05:38.35,Caption,,0,0,0,,ТЕХНОЛОГИЮ УВИДЕЛИ. И ТЕПЕРЬ ПРОИСХОДИТ ОСОБЕННО
Dialogue: 0,0:05:38.35,0:05:41.71,Caption,,0,0,0,,ИНТЕРЕСНАЯ ВЕЩЬ. САМ ТРАМП СТАНОВИТСЯ ИМ ВСЁ МЕНЕЕ
Dialogue: 0,0:05:41.71,0:05:44.59,Caption,,0,0,0,,НЕОБХОДИМ. ПОСЛЕ АМЕРИКАНСКИХ ПРОМЕЖУТОЧНЫХ ВЫБОРОВ
Dialogue: 0,0:05:44.59,0:05:47.07,Caption,,0,0,0,,НЕКОТОРЫЕ ЕВРОПЕЙСКИЕ ПРАВЫЕ УЖЕ НАЧАЛИ ДОВОЛЬНО
Dialogue: 0,0:05:47.07,0:05:49.71,Caption,,0,0,0,,АККУРАТНО ОТХОДИТЬ ОТ КОНКРЕТНЫХ РЕШЕНИЙ ТРАМПА.
Dialogue: 0,0:05:50.11,0:05:52.91,Caption,,0,0,0,,ЖОРДАН БАРДЕЛЛА КРИТИКУЕТ ПОСЛЕДСТВИЯ АМЕРИКАНСКОЙ
Dialogue: 0,0:05:52.91,0:05:56.03,Caption,,0,0,0,,ПОЛИТИКИ ВОКРУГ ИРАНА. АЛИСА ВАЙДЕЛЬ ВСПОМИНАЕТ,
Dialogue: 0,0:05:56.19,0:05:58.83,Caption,,0,0,0,,ЧТО ТРАМП ОБЕЩАЛ ИЗБЕГАТЬ ИНТЕРВЕНЦИОНИСТСКОЙ
Dialogue: 0,0:05:58.91,0:06:02.19,Caption,,0,0,0,,ВНЕШНЕЙ ПОЛИТИКИ. МАТТЕО САЛЬВИНИ ГОВОРИТ О ВОЙНАХ,
Dialogue: 0,0:06:02.43,0:06:04.99,Caption,,0,0,0,,МЕЖДУНАРОДНОЙ НАПРЯЖЁННОСТИ И СТОИМОСТИ ЖИЗНИ.
Dialogue: 0,0:06:07.27,0:06:09.67,Caption,,0,0,0,,САНТЬЯГО АБАСКАЛЬ ВООБЩЕ ЗАМЕЧАТЕЛЬНО ОТВЕТИЛ
Dialogue: 0,0:06:09.67,0:06:11.99,Caption,,0,0,0,,ЖУРНАЛИСТАМ, ЧТО НАХОДИТСЯ В ИСПАНИИ,
Dialogue: 0,0:06:12.15,0:06:14.07,Caption,,0,0,0,,А НЕ В МИЧИГАНЕ. ВОТ ТОЛЬКО ЭТО НЕ
Dialogue: 0,0:06:14.15,0:06:18.39,Caption,,0,0,0,,ОТХОД ОТ ВСЕГО, ЧТО ТРАМП ПОЛИТИЧЕСКИ ЗАПУСТИЛ. НАОБОРОТ. ЭТО
Dialogue: 0,0:06:18.39,0:06:21.51,Caption,,0,0,0,,ПОПЫТКА ОТДЕЛИТЬ ПРОДУКТ ОТ ПРОИЗВОДИТЕЛЯ. ЧАСТЬ
Dialogue: 0,0:06:21.51,0:06:24.23,Caption,,0,0,0,,ЕВРОПЕЙСКИХ ПРАВЫХ ГОВОРИТ ПРИБЛИЗИТЕЛЬНО СЛЕДУЮЩЕЕ.
Dialogue: 0,0:06:24.47,0:06:27.43,Caption,,0,0,0,,СУВЕРЕНИТЕТ БЕРЁМ. ЖЁСТКИЙ РАЗГОВОР О МИГРАЦИИ
Dialogue: 0,0:06:27.43,0:06:30.71,Caption,,0,0,0,,БЕРЁМ. КРИТИКУ СТАРОГО ПОЛИТИЧЕСКОГО КЛАССА БЕРЁМ.
Dialogue: 0,0:06:30.92,0:06:33.99,Caption,,0,0,0,,СПОР С НАДНАЦИОНАЛЬНОЙ БЮРОКРАТИЕЙ БЕРЁМ. ПРАВО
Dialogue: 0,0:06:33.99,0:06:36.31,Caption,,0,0,0,,ГОСУДАРСТВА ДЕЙСТВОВАТЬ ПРЕЖДЕ ВСЕГО В СОБСТВЕННЫХ
Dialogue: 0,0:06:36.31,0:06:39.59,Caption,,0,0,0,,ИНТЕРЕСАХ БЕРЁМ. А АМЕРИКАНСКИЕ ПРОБЛЕМЫ ОСТАВЬТЕ
Dialogue: 0,0:06:39.59,0:06:42.63,Caption,,0,0,0,,АМЕРИКАНЦАМ. И ВОТ ЗДЕСЬ ПРОТИВНИКИ ЕВРОПЕЙСКИХ
Dialogue: 0,0:06:42.71,0:06:45.83,Caption,,0,0,0,,ПРАВЫХ ПОПАДАЮТ В ОЧЕНЬ НЕУДОБНОЕ ПОЛОЖЕНИЕ. МОЖНО
Dialogue: 0,0:06:45.83,0:06:49.43,Caption,,0,0,0,,БЫЛО ОБЪЯСНЯТЬ, ЧТО ТРАМП ПЛОХОЙ. МОЖНО БЫЛО ГОВОРИТЬ,
Dialogue: 0,0:06:49.51,0:06:52.15,Caption,,0,0,0,,ЧТО ЕВРОПЕЙСКИЕ ПРАВЫЕ ЯВЛЯЮТСЯ ЕГО ПОЛИТИЧЕСКИМИ
Dialogue: 0,0:06:52.15,0:06:54.15,Caption,,0,0,0,,РОДСТВЕННИКАМИ. НО ЕСЛИ ОНИ НАЧИНАЮТ
Dialogue: 0,0:06:54.15,0:06:56.15,Caption,,0,0,0,,ДИСТАНЦИРОВАТЬСЯ ОТ САМОГО ТРАМПА,
Dialogue: 0,0:06:56.38,0:07:00.63,Caption,,0,0,0,,А ПОВЕСТКА ОСТАЁТСЯ, СТАРЫЙ ПРИЁМ ПЕРЕСТАЁТ РАБОТАТЬ. ПОТОМУ ЧТО
Dialogue: 0,0:07:00.63,0:07:03.75,Caption,,0,0,0,,ИЗБИРАТЕЛЬ СПРАШИВАЕТ НЕ ПРО ТРАМПА. ОН СПРАШИВАЕТ,
Dialogue: 0,0:07:04.01,0:07:07.03,Caption,,0,0,0,,ПОЧЕМУ У НЕГО ТАКОЙ СЧЁТ ЗА ЭЛЕКТРИЧЕСТВО. ПОЧЕМУ
Dialogue: 0,0:07:07.03,0:07:10.07,Caption,,0,0,0,,ИЗМЕНИЛАСЬ МИГРАЦИОННАЯ СИТУАЦИЯ. ПОЧЕМУ РЕШЕНИЯ
Dialogue: 0,0:07:10.07,0:07:12.55,Caption,,0,0,0,,НАЦИОНАЛЬНОГО ПРАВИТЕЛЬСТВА ЗАВИСЯТ ОТ БРЮССЕЛЯ.
Dialogue: 0,0:07:12.80,0:07:15.67,Caption,,0,0,0,,ПОЧЕМУ ЭКОНОМИКА РАСТЁТ МЕДЛЕННО. ПОЧЕМУ НАЛОГИ
Dialogue: 0,0:07:15.75,0:07:18.63,Caption,,0,0,0,,ВЫСОКИЕ. ПОЧЕМУ НА ОБОРОНУ ТРЕБУЕТСЯ ВСЁ БОЛЬШЕ
Dialogue: 0,0:07:18.63,0:07:23.46,Caption,,0,0,0,,ДЕНЕГ. И ОТВЕТИТЬ ЕМУ ЗАТО ТРАМП ПЛОХОЙ,
Dialogue: 0,0:07:23.62,0:07:26.58,Caption,,0,0,0,,СТАНОВИТСЯ НЕМНОГО НЕДОСТАТОЧНО. ФРАНЦИЯ СЕЙЧАС
Dialogue: 0,0:07:26.58,0:07:29.62,Caption,,0,0,0,,ПОКАЗЫВАЕТ ЭТО ПОЧТИ ИДЕАЛЬНО. ЕЩЁ ПОЛГОДА ДО
Dialogue: 0,0:07:29.62,0:07:32.58,Caption,,0,0,0,,ПРЕЗИДЕНТСКИХ ВЫБОРОВ. МАРИН ЛЕ ПЕН ОСТАЁТСЯ ОДНОЙ
Dialogue: 0,0:07:32.58,0:07:35.46,Caption,,0,0,0,,ИЗ ГЛАВНЫХ ФИГУР ГОНКИ. ПОЛИТИЧЕСКИЙ ЦЕНТР
Dialogue: 0,0:07:35.46,0:07:38.50,Caption,,0,0,0,,РАЗДРОБЛЕН. МАКРОН УЖЕ ГОВОРИТ О НЕОБХОДИМОСТИ ОЧЕНЬ
Dialogue: 0,0:07:38.50,0:07:42.82,Caption,,0,0,0,,ШИРОКОЙ КОАЛИЦИИ, КОТОРАЯ ДОЛЖНА ОБЪЕДИНИТЬ СИЛЫ ОТ СОЦИАЛ ДЕМОКРАТОВ
Dialogue: 0,0:07:43.06,0:07:46.02,Caption,,0,0,0,,ДО ТРАДИЦИОННЫХ ПРАВЫХ, ЧТОБЫ НЕ ДОПУСТИТЬ ФИНАЛА,
Dialogue: 0,0:07:46.24,0:07:48.66,Caption,,0,0,0,,ГДЕ ОСНОВНЫМИ СОПЕРНИКАМИ ОКАЖУТСЯ ЛЕ ПЕН И
Dialogue: 0,0:07:48.66,0:07:53.22,Caption,,0,0,0,,МЕЛАНШОН. ЗАМЕТЬТЕ, КАКОЙ ИНТЕРЕСНЫЙ РЕЗУЛЬТАТ. СНАЧАЛА ТЕБЕ ГОВОРЯТ,
Dialogue: 0,0:07:53.38,0:07:56.18,Caption,,0,0,0,,ЧТО ПРАВЫЕ ПРЕДСТАВЛЯЮТ МЕНЬШИНСТВО И ПОЛИТИЧЕСКУЮ
Dialogue: 0,0:07:56.18,0:07:58.74,Caption,,0,0,0,,КРАЙНОСТЬ. ПОТОМ ДЛЯ БОРЬБЫ С ЭТОЙ КРАЙНОСТЬЮ
Dialogue: 0,0:07:58.74,0:08:01.22,Caption,,0,0,0,,ТРЕБУЕТСЯ СОБРАТЬ ПОЧТИ ВСЕХ ОСТАЛЬНЫХ В ОДНУ
Dialogue: 0,0:08:01.22,0:08:04.02,Caption,,0,0,0,,КОНСТРУКЦИЮ. ЧЕЛОВЕК СО СТОРОНЫ МОЖЕТ ДАЖЕ СЛЕГКА
Dialogue: 0,0:08:04.02,0:08:07.22,Caption,,0,0,0,,ЗАПУТАТЬСЯ. ЕСЛИ ПРОТИВ ОДНОЙ ПАРТИИ НАДО ОБЪЕДИНЯТЬ
Dialogue: 0,0:08:07.30,0:08:08.98,Caption,,0,0,0,,ПОЛОВИНУ ПОЛИТИЧЕСКОГО СПЕКТРА,
Dialogue: 0,0:08:09.22,0:08:11.62,Caption,,0,0,0,,МОЖЕТ БЫТЬ, ПРОБЛЕМА УЖЕ НЕ ТОЛЬКО В ЭТОЙ ПАРТИИ?
Dialogue: 0,0:08:11.99,0:08:14.42,Caption,,0,0,0,,А ПАРАЛЛЕЛЬНО ФРАНЦИЯ ПРОДОЛЖАЕТ ЖИТЬ В РЕЖИМЕ
Dialogue: 0,0:08:14.50,0:08:17.38,Caption,,0,0,0,,МАССОВЫХ ПРОТЕСТОВ. ПЯТОГО НОЯБРЯ ВЛАСТИ ГОТОВИЛИСЬ
Dialogue: 0,0:08:17.46,0:08:20.02,Caption,,0,0,0,,К СОТНЯМ АКЦИЙ И ВЫВОДИЛИ ОГРОМНЫЕ СИЛЫ
Dialogue: 0,0:08:20.02,0:08:23.06,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ПРОТЕСТЫ НАЧАЛИСЬ С ОБРАЗОВАНИЯ И
Dialogue: 0,0:08:23.06,0:08:26.74,Caption,,0,0,0,,СОЦИАЛЬНЫХ ТРЕБОВАНИЙ, ПОТОМ К НИМ ДОБАВИЛИСЬ СТОИМОСТЬ ЖИЗНИ,
Dialogue: 0,0:08:26.90,0:08:29.38,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЕ УСЛУГИ, ЗАРПЛАТЫ,
Dialogue: 0,0:08:29.54,0:08:34.54,Caption,,0,0,0,,БЮДЖЕТ. ПОСЛЕ ОКТЯБРЬСКИХ БЕСПОРЯДКОВ ТАМ УЖЕ БЫЛИ
Dialogue: 0,0:08:34.54,0:08:39.10,Caption,,0,0,0,,СТОЛКНОВЕНИЯ, РАЗГРАБЛЕНИЯ И СЕРЬЁЗНЫЙ УЩЕРБ. И ЭТА УЛИЦА НИКУДА
Dialogue: 0,0:08:39.18,0:08:43.98,Caption,,0,0,0,,НЕ ИСЧЕЗАЕТ. ОСТАЁТСЯ ВОПРОС, ЧТО ПРОИЗОЙДЁТ С ТАКОЙ ПРОТЕСТНОЙ ИНФРАСТРУКТУРОЙ,
Dialogue: 0,0:08:44.22,0:08:47.26,Caption,,0,0,0,,ЕСЛИ ЛЕ ПЕН ДЕЙСТВИТЕЛЬНО ПОЛУЧИТ ВЛАСТЬ. ТЕПЕРЬ
Dialogue: 0,0:08:47.26,0:08:50.06,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ЕЩЁ ОДИН ВОПРОС. ЧТО ПРОИЗОЙДЁТ,
Dialogue: 0,0:08:50.46,0:08:53.18,Caption,,0,0,0,,ЕСЛИ ПОЛИТИЧЕСКИЙ ЦЕНТР НАЧНЁТ ПЕРЕНИМАТЬ ЧАСТЬ ЕЁ
Dialogue: 0,0:08:53.26,0:08:57.74,Caption,,0,0,0,,ПОВЕСТКИ ЕЩЁ ДО ВЫБОРОВ? ВОТ ЗДЕСЬ ВООБЩЕ НАЧИНАЕТСЯ ЦИРК. ПРЕДСТАВЬТЕ
Dialogue: 0,0:08:57.74,0:09:00.78,Caption,,0,0,0,,ИЗБИРАТЕЛЯ НАЦИОНАЛЬНОГО ОБЪЕДИНЕНИЯ. ЕМУ НЕСКОЛЬКО
Dialogue: 0,0:09:00.86,0:09:04.62,Caption,,0,0,0,,ЛЕТ ГОВОРЯТ, ЧТО ЕГО ПАРТИЯ ОПАСНАЯ. ПОТОМ ВЛАСТЬ НАЧИНАЕТ
Dialogue: 0,0:09:04.62,0:09:07.34,Caption,,0,0,0,,УЖЕСТОЧАТЬ МИГРАЦИОННУЮ ПОЛИТИКУ. ГОВОРИТЬ О
Dialogue: 0,0:09:07.34,0:09:10.30,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ГОВОРИТЬ О НЕОБХОДИМОСТИ ЗАЩИЩАТЬ
Dialogue: 0,0:09:10.30,0:09:13.26,Caption,,0,0,0,,НАЦИОНАЛЬНУЮ ПРОМЫШЛЕННОСТЬ. ВСЁ ГРОМЧЕ СПОРИТЬ О
Dialogue: 0,0:09:13.26,0:09:16.14,Caption,,0,0,0,,ЕВРОПЕЙСКИХ ПРАВИЛАХ. И ЧТО ДОЛЖЕН ПОДУМАТЬ ЭТОТ
Dialogue: 0,0:09:16.14,0:09:19.50,Caption,,0,0,0,,ЧЕЛОВЕК? СПАСИБО, ВЫ УБЕДИЛИ МЕНЯ ГОЛОСОВАТЬ ЗА ВАС?
Dialogue: 0,0:09:19.82,0:09:21.82,Caption,,0,0,0,,ИЛИ СОВСЕМ НАОБОРОТ. ПОЛУЧАЕТСЯ,
Dialogue: 0,0:09:22.14,0:09:24.38,Caption,,0,0,0,,МОИ РЕБЯТА СТОЛЬКО ЛЕТ ГОВОРИЛИ ПРАВИЛЬНО,
Dialogue: 0,0:09:24.58,0:09:26.94,Caption,,0,0,0,,РАЗ ТЕПЕРЬ ВЫ ПОВТОРЯЕТЕ ПРИМЕРНО ТО ЖЕ САМОЕ?
Dialogue: 0,0:09:27.24,0:09:30.38,Caption,,0,0,0,,ЭТО СТАРАЯ ПРОБЛЕМА ПОЛИТИЧЕСКОГО КОПИРОВАНИЯ. МОЖНО
Dialogue: 0,0:09:30.38,0:09:33.58,Caption,,0,0,0,,УКРАСТЬ ИДЕЮ КОНКУРЕНТА. НО ВМЕСТЕ С ИДЕЕЙ ИНОГДА
Dialogue: 0,0:09:33.58,0:09:37.90,Caption,,0,0,0,,ПРИХОДИТСЯ ПРИЗНАТЬ, ЧТО КОНКУРЕНТ ПЕРВЫМ ЗАМЕТИЛ ПРОБЛЕМУ. А ЭТО УЖЕ
Dialogue: 0,0:09:37.90,0:09:41.18,Caption,,0,0,0,,ОПАСНО. ИМЕННО ПОЭТОМУ ЕВРОПЕЙСКИЙ ЦЕНТР ОКАЗАЛСЯ В
Dialogue: 0,0:09:41.26,0:09:44.06,Caption,,0,0,0,,ЛОВУШКЕ. НЕ РЕАГИРОВАТЬ НА ТЕМЫ ПРАВЫХ НЕЛЬЗЯ.
Dialogue: 0,0:09:44.22,0:09:47.18,Caption,,0,0,0,,ИЗБИРАТЕЛИ УХОДЯТ. РЕАГИРОВАТЬ ТОЖЕ ОПАСНО.
Dialogue: 0,0:09:49.47,0:09:53.79,Caption,,0,0,0,,ПРАВЫЕ ГОВОРЯТ ВОТ ВИДИТЕ, МЫ ВАС ЗАСТАВИЛИ. ГЕРМАНИЯ ЗДЕСЬ ОСОБЕННО
Dialogue: 0,0:09:53.79,0:09:56.83,Caption,,0,0,0,,ПОКАЗАТЕЛЬНА. ЕСЛИ ТРАДИЦИОННЫЙ ПОЛИТИЧЕСКИЙ КЛАСС
Dialogue: 0,0:09:56.83,0:09:59.23,Caption,,0,0,0,,ПРОДОЛЖИТ ДЕРЖАТЬ АДГ ЗА БРАНДМАУЭРОМ,
Dialogue: 0,0:09:59.50,0:10:02.27,Caption,,0,0,0,,НО ОДНОВРЕМЕННО БУДЕТ ДВИГАТЬСЯ ВПРАВО НА МИГРАЦИИ,
Dialogue: 0,0:10:02.41,0:10:04.67,Caption,,0,0,0,,БЕЗОПАСНОСТИ И ВОПРОСАХ ЕВРОСОЮЗА,
Dialogue: 0,0:10:05.05,0:10:07.63,Caption,,0,0,0,,ИЗБИРАТЕЛЬ МОЖЕТ СДЕЛАТЬ ДОВОЛЬНО НЕПРИЯТНЫЙ ВЫВОД.
Dialogue: 0,0:10:07.86,0:10:11.07,Caption,,0,0,0,,ЗАЧЕМ МНЕ КОПИЯ, ЕСЛИ ОРИГИНАЛ УЖЕ ЛЕЖИТ В БЮЛЛЕТЕНЕ?
Dialogue: 0,0:10:11.38,0:10:14.27,Caption,,0,0,0,,ВОТ ЗДЕСЬ И НАЧИНАЕТСЯ РЕАЛЬНАЯ БИТВА СЛЕДУЮЩИХ ЛЕТ.
Dialogue: 0,0:10:14.51,0:10:16.99,Caption,,0,0,0,,НЕ ПРАВЫЕ ПРОТИВ ЛЕВЫХ. И ДАЖЕ НЕ ПРАВЫЕ
Dialogue: 0,0:10:17.07,0:10:19.95,Caption,,0,0,0,,ПРОТИВ ЦЕНТРА. БИТВА ИДЁТ ЗА ПРАВО ОБЪЯСНИТЬ,
Dialogue: 0,0:10:20.12,0:10:24.59,Caption,,0,0,0,,КТО ПЕРВЫМ ПОНЯЛ, ЧЕГО ХОЧЕТ ИЗБИРАТЕЛЬ. ПРАВЫЕ ГОВОРЯТ МЫ ГОВОРИЛИ ОБ
Dialogue: 0,0:10:24.59,0:10:28.03,Caption,,0,0,0,,ЭТОМ, КОГДА ВЫ НАД НАМИ СМЕЯЛИСЬ. ЦЕНТРИСТЫ ОТВЕЧАЮТ МЫ
Dialogue: 0,0:10:28.11,0:10:30.75,Caption,,0,0,0,,МОЖЕМ РЕШИТЬ ЭТИ ВОПРОСЫ БЕЗ РАДИКАЛОВ. ЛЕВЫЕ
Dialogue: 0,0:10:30.83,0:10:33.87,Caption,,0,0,0,,ГОВОРЯТ САМА ПОСТАНОВКА ВОПРОСА НЕПРАВИЛЬНАЯ И ВЕДЁТ
Dialogue: 0,0:10:33.95,0:10:36.83,Caption,,0,0,0,,ЕВРОПУ В ОПАСНУЮ СТОРОНУ. А ИЗБИРАТЕЛЬ СМОТРИТ НА
Dialogue: 0,0:10:36.91,0:10:39.79,Caption,,0,0,0,,ВСЁ ЭТО И РЕШАЕТ СОВСЕМ БЫТОВЫЕ ВЕЩИ. КОМУ
Dialogue: 0,0:10:39.87,0:10:42.75,Caption,,0,0,0,,ОН ВЕРИТ. КТО ЗАМЕТИЛ ЕГО ПРОБЛЕМУ РАНЬШЕ. И
Dialogue: 0,0:10:42.75,0:10:45.71,Caption,,0,0,0,,КТО ДЕЙСТВИТЕЛЬНО СПОСОБЕН ЧТО ТО ИЗМЕНИТЬ. ПОЛЬША
Dialogue: 0,0:10:45.79,0:10:48.67,Caption,,0,0,0,,ДОБАВЛЯЕТ К ЭТОМУ ЕЩЁ ОДИН СЛОЙ. ТАМ КОНФЛИКТ
Dialogue: 0,0:10:48.75,0:10:51.39,Caption,,0,0,0,,ТУСКА И НАВРОЦКОГО ВОКРУГ КОНСТИТУЦИОННОГО ТРИБУНАЛА
Dialogue: 0,0:10:51.39,0:10:56.03,Caption,,0,0,0,,НИКУДА НЕ ДЕЛСЯ. БОЛЕЕ ТОГО, КРИЗИС УЖЕ НАЧИНАЕТ РАБОТАТЬ КАК ПОДГОТОВКА К
Dialogue: 0,0:10:56.11,0:10:57.71,Caption,,0,0,0,,СЛЕДУЮЩЕЙ ПАРЛАМЕНТСКОЙ СХВАТКЕ.
Dialogue: 0,0:11:00.00,0:11:02.56,Caption,,0,0,0,,И ПОЯВЛЯЕТСЯ ВОЗМОЖНОСТЬ БОЛЕЕ ШИРОКОГО ПРАВОГО
Dialogue: 0,0:11:02.56,0:11:06.08,Caption,,0,0,0,,СОЮЗА, ГДЕ РЯДОМ С ТРАДИЦИОННЫМИ НАЦИОНАЛ КОНСЕРВАТОРАМИ
Dialogue: 0,0:11:06.25,0:11:10.40,Caption,,0,0,0,,МОГУТ ОКАЗАТЬСЯ СИЛЫ, КОТОРЫЕ ЕЩЁ НЕДАВНО СЧИТАЛИСЬ СЛИШКОМ РАДИКАЛЬНЫМИ
Dialogue: 0,0:11:10.40,0:11:13.12,Caption,,0,0,0,,ДАЖЕ ДЛЯ ПОЛЬСКОЙ ПРАВОЙ СТОРОНЫ. ТО ЕСТЬ ПРОЦЕСС
Dialogue: 0,0:11:13.12,0:11:16.08,Caption,,0,0,0,,ИДЁТ В ОБЕ СТОРОНЫ. ЦЕНТР ЗАБИРАЕТ ЧАСТЬ ПРАВОЙ
Dialogue: 0,0:11:16.08,0:11:19.60,Caption,,0,0,0,,ПОВЕСТКИ. А СПРАВА ПАРТИИ, КОТОРЫХ РАНЬШЕ РАЗДЕЛЯЛИ,
Dialogue: 0,0:11:19.84,0:11:22.56,Caption,,0,0,0,,НАЧИНАЮТ ИСКАТЬ СПОСОБЫ ПРЕВРАТИТЬ ОБЩИЕ ТЕМЫ В
Dialogue: 0,0:11:22.56,0:11:25.68,Caption,,0,0,0,,КОАЛИЦИОННУЮ АРИФМЕТИКУ. ИМЕННО ПОЭТОМУ ПРЕДЫДУЩИЙ
Dialogue: 0,0:11:25.68,0:11:28.48,Caption,,0,0,0,,ВОПРОС, СМОГУТ ЛИ ПРАВЫХ ОСТАНОВИТЬ БАРЬЕРЫ,
Dialogue: 0,0:11:28.64,0:11:31.44,Caption,,0,0,0,,УЖЕ ПОСТЕПЕННО УСТАРЕВАЕТ. ПОТОМУ ЧТО БАРЬЕР
Dialogue: 0,0:11:31.52,0:11:34.56,Caption,,0,0,0,,РАБОТАЕТ ПРОТИВ ПАРТИИ. ОН ХУЖЕ РАБОТАЕТ ПРОТИВ
Dialogue: 0,0:11:34.64,0:11:38.00,Caption,,0,0,0,,ИДЕИ. ПАРТИЮ МОЖНО НЕ ВЗЯТЬ В КОАЛИЦИЮ. ИДЕЮ
Dialogue: 0,0:11:38.08,0:11:42.16,Caption,,0,0,0,,НЕЛЬЗЯ НЕ ВЗЯТЬ В КОАЛИЦИЮ, ЕСЛИ ЗА НЕЁ НАЧИНАЕТ ГОЛОСОВАТЬ СЛИШКОМ БОЛЬШАЯ
Dialogue: 0,0:11:42.24,0:11:44.96,Caption,,0,0,0,,ЧАСТЬ СТРАНЫ. ПОЛИТИКА ВООБЩЕ ЖЕСТОКАЯ ШТУКА.
Dialogue: 0,0:11:45.35,0:11:48.40,Caption,,0,0,0,,ИЗБИРАТЕЛЬ НЕ ОБЯЗАН СОБЛЮДАТЬ САНИТАРНЫЙ КОРДОН. ОН
Dialogue: 0,0:11:48.48,0:11:51.20,Caption,,0,0,0,,МОЖЕТ ГОДАМИ ЗАСТАВЛЯТЬ СИСТЕМУ ВОЗВРАЩАТЬСЯ К ОДНОЙ
Dialogue: 0,0:11:51.28,0:11:53.52,Caption,,0,0,0,,И ТОЙ ЖЕ ТЕМЕ. ПОКА ОДНАЖДЫ ЭТА ТЕМА
Dialogue: 0,0:11:53.52,0:11:55.84,Caption,,0,0,0,,НЕ ОКАЖЕТСЯ В ПРОГРАММЕ ТЕХ САМЫХ ЛЮДЕЙ,
Dialogue: 0,0:11:56.00,0:11:59.12,Caption,,0,0,0,,КОТОРЫЕ РАНЬШЕ НАЗЫВАЛИ ЕЁ ОПАСНОЙ. ТРАМП ИМЕННО
Dialogue: 0,0:11:59.20,0:12:01.68,Caption,,0,0,0,,ПОЭТОМУ ОСТАЁТСЯ ВАЖЕН ДЛЯ ЕВРОПЫ ДАЖЕ В ТОТ
Dialogue: 0,0:12:01.68,0:12:05.20,Caption,,0,0,0,,МОМЕНТ, КОГДА ЧАСТЬ ЕВРОПЕЙСКИХ ПРАВЫХ НАЧИНАЕТ ОТХОДИТЬ ОТ
Dialogue: 0,0:12:05.20,0:12:08.72,Caption,,0,0,0,,САМОГО ТРАМПА. ОН ПОКАЗАЛ МЕХАНИЗМ. НО МЕХАНИЗМ УЖЕ
Dialogue: 0,0:12:08.72,0:12:14.52,Caption,,0,0,0,,НЕ ПРИНАДЛЕЖИТ ЕМУ. ВОТ ЭТО НАМНОГО ИНТЕРЕСНЕЕ ОЧЕРЕДНОЙ ФОТОГРАФИИ
Dialogue: 0,0:12:14.52,0:12:16.84,Caption,,0,0,0,,ЕВРОПЕЙСКОГО ПОЛИТИКА РЯДОМ С АМЕРИКАНСКИМ
Dialogue: 0,0:12:16.84,0:12:19.80,Caption,,0,0,0,,ПРЕЗИДЕНТОМ. ФОТОГРАФИЮ МОЖНО УБРАТЬ СО СТРАНИЦЫ.
Dialogue: 0,0:12:20.12,0:12:22.92,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ ЯЗЫК ОБРАТНО В КОРОБКУ УЖЕ НЕ ПОЛОЖИШЬ.
Dialogue: 0,0:12:23.40,0:12:25.80,Caption,,0,0,0,,И ПОЭТОМУ СЛЕДУЮЩАЯ ЕВРОПЕЙСКАЯ БОРЬБА БУДЕТ
Dialogue: 0,0:12:25.80,0:12:28.84,Caption,,0,0,0,,ВЫГЛЯДЕТЬ ДОВОЛЬНО СТРАННО. ПРАВЫХ БУДУТ ПРОДОЛЖАТЬ
Dialogue: 0,0:12:28.84,0:12:31.16,Caption,,0,0,0,,ОБВИНЯТЬ В УГРОЗЕ СУЩЕСТВУЮЩЕМУ ПОРЯДКУ.
Dialogue: 0,0:12:31.40,0:12:33.80,Caption,,0,0,0,,ОДНОВРЕМЕННО ЭТОТ ПОРЯДОК БУДЕТ МЕНЯТЬСЯ ПОД ИХ
Dialogue: 0,0:12:33.80,0:12:36.76,Caption,,0,0,0,,ДАВЛЕНИЕМ. ИМ БУДУТ ЗАКРЫВАТЬ ВХОД В ПРАВИТЕЛЬСТВА.
Dialogue: 0,0:12:36.99,0:12:39.40,Caption,,0,0,0,,ОДНОВРЕМЕННО ИХ ТЕМЫ БУДУТ ЗАХОДИТЬ ТУДА ЧЕРЕЗ
Dialogue: 0,0:12:39.40,0:12:41.96,Caption,,0,0,0,,ПРОГРАММЫ ДРУГИХ ПАРТИЙ. ИМ БУДУТ ГОВОРИТЬ,
Dialogue: 0,0:12:42.12,0:12:44.84,Caption,,0,0,0,,ЧТО ЕВРОПА НИКОГДА НЕ СТАНЕТ ТАКОЙ. А ПОТОМ
Dialogue: 0,0:12:44.92,0:12:47.64,Caption,,0,0,0,,ЕВРОПА БУДЕТ СТАНОВИТЬСЯ НЕМНОГО ТАКОЙ. ШАГ ЗА
Dialogue: 0,0:12:47.64,0:12:50.28,Caption,,0,0,0,,ШАГОМ. И ВОТ ЗДЕСЬ УЖЕ ВОЗНИКАЕТ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:12:50.28,0:12:53.00,Caption,,0,0,0,,НЕПРИЯТНЫЙ ВОПРОС ДЛЯ СТАРОГО ПОЛИТИЧЕСКОГО КЛАССА.
Dialogue: 0,0:12:53.31,0:12:57.48,Caption,,0,0,0,,ЧТО СЧИТАТЬ ПОБЕДОЙ? ЕСЛИ ЛЕ ПЕН НЕ СТАНОВИТСЯ ПРЕЗИДЕНТОМ,
Dialogue: 0,0:12:57.69,0:13:00.04,Caption,,0,0,0,,НО ФРАНЦУЗСКАЯ ПОЛИТИКА СЛЕДУЮЩИЕ ДЕСЯТЬ ЛЕТ
Dialogue: 0,0:13:00.04,0:13:04.60,Caption,,0,0,0,,ОБСУЖДАЕТ МИГРАЦИЮ, СУВЕРЕНИТЕТ И НАЦИОНАЛЬНЫЙ ПРИОРИТЕТ НА ЯЗЫКЕ,
Dialogue: 0,0:13:04.76,0:13:06.84,Caption,,0,0,0,,КОТОРЫЙ РАНЬШЕ СЧИТАЛСЯ ЯЗЫКОМ ЛЕ ПЕН,
Dialogue: 0,0:13:07.08,0:13:11.16,Caption,,0,0,0,,КТО ПРОИГРАЛ? ЕСЛИ АДГ НЕ ВХОДИТ В ФЕДЕРАЛЬНОЕ ПРАВИТЕЛЬСТВО,
Dialogue: 0,0:13:11.48,0:13:14.28,Caption,,0,0,0,,НО ГЕРМАНИЯ МЕНЯЕТ ПОЛИТИКУ ПОД ДАВЛЕНИЕМ ВОПРОСОВ,
Dialogue: 0,0:13:14.44,0:13:19.00,Caption,,0,0,0,,НА КОТОРЫХ РОСЛА АДГ, СРАБОТАЛ БРАНДМАУЭР ИЛИ ПРОСТО ЗАДЕРЖАЛ ФАМИЛИИ?
Dialogue: 0,0:13:21.30,0:13:23.54,Caption,,0,0,0,,ЕСЛИ БРЮССЕЛЬ СОХРАНЯЕТ ВСЕ ЗДАНИЯ,
Dialogue: 0,0:13:23.62,0:13:27.70,Caption,,0,0,0,,ФЛАГИ И ДОЛЖНОСТИ, НО СТРАНЫ НАЧИНАЮТ ТРЕБОВАТЬ ВЕРНУТЬ СЕБЕ БОЛЬШЕ
Dialogue: 0,0:13:27.70,0:13:30.50,Caption,,0,0,0,,ПОЛНОМОЧИЙ, ОСТАЛСЯ ЛИ ЕВРОСОЮЗ ПРЕЖНИМ?
Dialogue: 0,0:13:30.89,0:13:33.14,Caption,,0,0,0,,ВОТ ПОЧЕМУ СЕЙЧАС НАДО СМОТРЕТЬ УЖЕ НЕ ТОЛЬКО
Dialogue: 0,0:13:33.14,0:13:35.86,Caption,,0,0,0,,НА ПРОЦЕНТЫ ПАРТИЙ. ПРОЦЕНТЫ ПОКАЗЫВАЮТ,
Dialogue: 0,0:13:36.03,0:13:38.66,Caption,,0,0,0,,КТО ПОЛУЧИТ КРЕСЛО. ПОВЕСТКА ПОКАЗЫВАЕТ,
Dialogue: 0,0:13:38.82,0:13:41.94,Caption,,0,0,0,,КТО МЕНЯЕТ СТРАНУ. И ЗДЕСЬ ЕВРОПЕЙСКИЕ ПРАВЫЕ
Dialogue: 0,0:13:41.94,0:13:45.22,Caption,,0,0,0,,ПОЛУЧИЛИ ОЧЕНЬ ИНТЕРЕСНОЕ ПРЕИМУЩЕСТВО. ИМ ПОКА ДАЖЕ
Dialogue: 0,0:13:45.30,0:13:48.26,Caption,,0,0,0,,НЕ ОБЯЗАТЕЛЬНО ПОБЕЖДАТЬ ВЕЗДЕ. ДОСТАТОЧНО ЗАСТАВИТЬ
Dialogue: 0,0:13:48.26,0:13:50.66,Caption,,0,0,0,,ОСТАЛЬНЫХ ДВИГАТЬСЯ. А ПОТОМ МОЖНО ВЫЙТИ К
Dialogue: 0,0:13:50.66,0:13:54.02,Caption,,0,0,0,,ИЗБИРАТЕЛЮ И СКАЗАТЬ. СМОТРИТЕ ВНИМАТЕЛЬНО. НАС ВСЁ
Dialogue: 0,0:13:54.02,0:13:56.66,Caption,,0,0,0,,ЭТО ВРЕМЯ НАЗЫВАЛИ ПРОБЛЕМОЙ. А ТЕПЕРЬ ОНИ ДЕЛАЮТ
Dialogue: 0,0:13:56.66,0:14:00.18,Caption,,0,0,0,,ТО, ЧТО МЫ ПРЕДЛАГАЛИ. ТОГДА У СТАРОЙ СИСТЕМЫ ОСТАНЕТСЯ
Dialogue: 0,0:14:00.26,0:14:03.30,Caption,,0,0,0,,ТОЛЬКО ОДИН ДЕЙСТВИТЕЛЬНО НЕПРИЯТНЫЙ ВОПРОС. ЕСЛИ
Dialogue: 0,0:14:03.30,0:14:05.06,Caption,,0,0,0,,ПРАВЫХ ТАК УСПЕШНО ОСТАНОВИЛИ,
Dialogue: 0,0:14:05.38,0:14:08.26,Caption,,0,0,0,,ПОЧЕМУ ЕВРОПА ВСЁ БОЛЬШЕ РАЗГОВАРИВАЕТ НА ИХ ЯЗЫКЕ?
