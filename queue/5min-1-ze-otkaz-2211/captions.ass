Dialogue: 0,0:00:00.12,0:00:02.28,Caption,,0,0,0,,СКОЛЬКО РАЗ ЧЕЛОВЕКУ НУЖНО СКАЗАТЬ "НЕТ",
Dialogue: 0,0:00:02.37,0:00:04.68,Caption,,0,0,0,,ЧТОБЫ ОН НАКОНЕЦ ПОНЯЛ, ЧТО ЭТО "НЕТ"?
Dialogue: 0,0:00:05.08,0:00:07.80,Caption,,0,0,0,,ОДИН РАЗ СКАЗАЛИ, ВТОРОЙ РАЗ ПОВТОРИЛИ,
Dialogue: 0,0:00:08.04,0:00:09.80,Caption,,0,0,0,,ТРЕТИЙ РАЗ УЖЕ ЧУТЬ ЛИ НЕ ПО БУКВАМ
Dialogue: 0,0:00:09.80,0:00:12.28,Caption,,0,0,0,,ОБЪЯСНИЛИ. А ОН СНОВА ПРИХОДИТ С ТЕМ ЖЕ
Dialogue: 0,0:00:12.28,0:00:15.40,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕМ, ТОЛЬКО ТЕПЕРЬ ЕЩЁ КОЕ ЧТО СВЕРХУ ДОБАВИЛ.
Dialogue: 0,0:00:15.72,0:00:20.04,Caption,,0,0,0,,НАСТОЙЧИВОСТЬ, КОНЕЧНО, КАЧЕСТВО ХОРОШЕЕ. НО ТУТ ВОЗНИКАЕТ ВОПРОС ЧЕЛОВЕК
Dialogue: 0,0:00:20.04,0:00:22.36,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ХОЧЕТ ДОГОВОРИТЬСЯ ИЛИ ЕМУ ОЧЕНЬ
Dialogue: 0,0:00:22.36,0:00:24.12,Caption,,0,0,0,,УДОБНО КАЖДЫЙ РАЗ ПОЛУЧАТЬ ОТКАЗ?
Dialogue: 0,0:00:24.60,0:00:26.44,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:26.52,0:00:29.16,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ВАШИНГТОН ТОРОПИТСЯ.
Dialogue: 0,0:00:29.31,0:00:31.88,Caption,,0,0,0,,АДМИНИСТРАЦИЯ ТРАМПА ХОЧЕТ ЗАКРЫТЬ СОГЛАШЕНИЕ ДО
Dialogue: 0,0:00:31.96,0:00:35.16,Caption,,0,0,0,,ЯНВАРЯ, ПОКА НОВЫЙ СОСТАВ КОНГРЕССА НЕ НАЧАЛ РАБОТАТЬ В
Dialogue: 0,0:00:35.16,0:00:37.72,Caption,,0,0,0,,ПОЛНУЮ СИЛУ. И ВОТ ЗДЕСЬ КАЛЕНДАРЬ ВНЕЗАПНО
Dialogue: 0,0:00:37.72,0:00:40.44,Caption,,0,0,0,,СТАНОВИТСЯ НЕ ПРОСТО КАЛЕНДАРЁМ. ЗЕЛЕНСКИЙ САМ
Dialogue: 0,0:00:40.44,0:00:42.68,Caption,,0,0,0,,СКАЗАЛ ПОСЛЕ ЗИМЫ БУДЕТ НЕ ТОЛЬКО ВЕСНА,
Dialogue: 0,0:00:42.84,0:00:45.64,Caption,,0,0,0,,НО И КОНГРЕСС. ФРАЗА КОРОТКАЯ. А СМЫСЛ У
Dialogue: 0,0:00:45.72,0:00:48.52,Caption,,0,0,0,,НЕЁ ОЧЕНЬ ДЛИННЫЙ. РАСЧЁТ ПОНЯТЕН. ДЕМОКРАТЫ
Dialogue: 0,0:00:48.52,0:00:51.08,Caption,,0,0,0,,ПОЛУЧАЮТ БОЛЬШЕ ВОЗМОЖНОСТЕЙ ДАВИТЬ НА БЕЛЫЙ ДОМ,
Dialogue: 0,0:00:51.32,0:00:53.72,Caption,,0,0,0,,ТРЕБОВАТЬ ОТЧЁТА ПО ДОГОВОРЁННОСТЯМ С МОСКВОЙ,
Dialogue: 0,0:00:53.96,0:00:55.72,Caption,,0,0,0,,ПРОДВИГАТЬ НОВУЮ ПОМОЩЬ КИЕВУ,
Dialogue: 0,0:00:55.88,0:00:59.16,Caption,,0,0,0,,ТОРМОЗИТЬ ТО, ЧТО ИМ НЕ НРАВИТСЯ. ТО ЕСТЬ ЯНВАРЬ ДЛЯ
Dialogue: 0,0:00:59.16,0:01:00.76,Caption,,0,0,0,,ТРАМПА И ВЕСНА ДЛЯ ЗЕЛЕНСКОГО,
Dialogue: 0,0:01:01.09,0:01:04.28,Caption,,0,0,0,,ЭТО УЖЕ ДВА РАЗНЫХ ПОЛИТИЧЕСКИХ ВРЕМЕНИ. ОДИН ХОЧЕТ
Dialogue: 0,0:01:04.28,0:01:07.32,Caption,,0,0,0,,УСПЕТЬ ДО ИЗМЕНЕНИЯ РАСКЛАДА. ВТОРОЙ РАССЧИТЫВАЕТ
Dialogue: 0,0:01:07.32,0:01:10.44,Caption,,0,0,0,,ЭТОТ РАСКЛАД ДОЖДАТЬСЯ. И ВОТ ТУТ НАЧИНАЕТСЯ САМОЕ
Dialogue: 0,0:01:10.44,0:01:15.69,Caption,,0,0,0,,ИНТЕРЕСНОЕ. ПОТОМУ ЧТО ЖДАТЬ МОЖНО. ВОПРОС ТОЛЬКО,
Dialogue: 0,0:01:15.77,0:01:18.33,Caption,,0,0,0,,ЗА ЧЕЙ СЧЁТ. САМ ЗЕЛЕНСКИЙ ГОВОРИТ,
Dialogue: 0,0:01:18.41,0:01:20.89,Caption,,0,0,0,,ЧТО ЗИМА БУДЕТ ТЯЖЁЛОЙ. УКРАИНСКАЯ ЭКОНОМИКА
Dialogue: 0,0:01:20.89,0:01:23.85,Caption,,0,0,0,,ПРОДОЛЖАЕТ ЖИТЬ НА ВНЕШНЕМ ФИНАНСИРОВАНИИ. УДАРЫ
Dialogue: 0,0:01:23.85,0:01:26.49,Caption,,0,0,0,,ПРОДОЛЖАЮТСЯ. ИНФРАСТРУКТУРА ПОЛУЧАЕТ НОВЫЕ
Dialogue: 0,0:01:26.49,0:01:29.53,Caption,,0,0,0,,ПОВРЕЖДЕНИЯ. А ПОЛИТИЧЕСКАЯ СТАВКА ПРИ ЭТОМ ДЕЛАЕТСЯ
Dialogue: 0,0:01:29.53,0:01:32.49,Caption,,0,0,0,,НА ТО, ЧТО ЧЕРЕЗ НЕСКОЛЬКО МЕСЯЦЕВ ПОЛОЖЕНИЕ СТАНЕТ
Dialogue: 0,0:01:32.49,0:01:36.81,Caption,,0,0,0,,ВЫГОДНЕЕ. А ЕСЛИ НЕ СТАНЕТ? ЕСЛИ К ВЕСНЕ УСЛОВИЯ ОКАЖУТСЯ ХУЖЕ?
Dialogue: 0,0:01:37.10,0:01:41.29,Caption,,0,0,0,,ЕСЛИ ТРАМП НЕ ИЗМЕНИТ КУРС? ЕСЛИ НОВАЯ ПОМОЩЬ ОКАЖЕТСЯ НЕ ТАКОЙ,
Dialogue: 0,0:01:41.44,0:01:44.97,Caption,,0,0,0,,КАК РАССЧИТЫВАЛИ? ЕСЛИ ЗА НЕСКОЛЬКО МЕСЯЦЕВ НА СТОЛ ЛЯГУТ УЖЕ
Dialogue: 0,0:01:44.97,0:01:49.21,Caption,,0,0,0,,СОВСЕМ ДРУГИЕ УСЛОВИЯ? ЗА КРАСИВУЮ ФРАЗУ "ПОСЛЕ ЗИМЫ БУДЕТ КОНГРЕСС"
Dialogue: 0,0:01:49.21,0:01:52.25,Caption,,0,0,0,,РАСПЛАЧИВАТЬСЯ ПРИДЁТСЯ НЕ КАЛЕНДАРЮ. ТЕПЕРЬ СМОТРИМ
Dialogue: 0,0:01:52.25,0:01:55.13,Caption,,0,0,0,,НА ГАРАНТИИ БЕЗОПАСНОСТИ. ДЖАРЕД КУШНЕР ГОВОРИТ,
Dialogue: 0,0:01:55.43,0:01:58.01,Caption,,0,0,0,,ЧТО ВАШИНГТОН ПРОДВИНУЛСЯ В ОБСУЖДЕНИИ МОДЕЛИ,
Dialogue: 0,0:01:58.17,0:02:02.65,Caption,,0,0,0,,ПОХОЖЕЙ НА ПЯТУЮ СТАТЬЮ НАТО, И ЧТО МОСКВА СТАЛА ОТНОСИТЬСЯ К ТАКОЙ КОНСТРУКЦИИ
Dialogue: 0,0:02:02.73,0:02:05.69,Caption,,0,0,0,,С БОЛЬШИМ ПОНИМАНИЕМ. ПРИ ЭТОМ САМ КУШНЕР ПРИЗНАЁТ
Dialogue: 0,0:02:05.69,0:02:08.73,Caption,,0,0,0,,ДЛЯ США ЭТО ОЧЕНЬ СЕРЬЁЗНОЕ РЕШЕНИЕ. ОНО ДОЛЖНО
Dialogue: 0,0:02:08.73,0:02:11.69,Caption,,0,0,0,,ОТВЕЧАТЬ АМЕРИКАНСКИМ ИНТЕРЕСАМ И БЫТЬ ЧАСТЬЮ БОЛЕЕ
Dialogue: 0,0:02:11.69,0:02:16.89,Caption,,0,0,0,,ШИРОКОГО ПАКЕТА. КАЗАЛОСЬ БЫ, ВОТ ОН МОМЕНТ. УКРАИНА ГОДАМИ ГОВОРИЛА НАМ НУЖНЫ
Dialogue: 0,0:02:16.89,0:02:20.25,Caption,,0,0,0,,НАСТОЯЩИЕ ГАРАНТИИ. НАМ НУЖНА ЗАЩИТА УРОВНЯ НАТО.
Dialogue: 0,0:02:20.54,0:02:23.93,Caption,,0,0,0,,НАМ НУЖНО, ЧТОБЫ ПОСЛЕ СОГЛАШЕНИЯ НИКТО БОЛЬШЕ НЕ ПОЛЕЗ.
Dialogue: 0,0:02:26.20,0:02:28.04,Caption,,0,0,0,,АМЕРИКАНЦЫ КЛАДУТ НА СТОЛ ВАРИАНТ,
Dialogue: 0,0:02:28.32,0:02:31.00,Caption,,0,0,0,,КОТОРЫЙ САМИ НАЗЫВАЮТ ОЧЕНЬ СЕРЬЁЗНЫМ. И ЧТО
Dialogue: 0,0:02:31.00,0:02:33.00,Caption,,0,0,0,,ПРОИСХОДИТ ДАЛЬШЕ? ОКАЗЫВАЕТСЯ,
Dialogue: 0,0:02:33.23,0:02:35.88,Caption,,0,0,0,,ЭТОГО УЖЕ МАЛО. ЗЕЛЕНСКИЙ ОБЪЯСНЯЕТ ДЛЯ НЕГО
Dialogue: 0,0:02:35.88,0:02:39.48,Caption,,0,0,0,,ГАРАНТИИ, ЭТО ВООРУЖЁННЫЕ СИЛЫ США И ЕВРОПЕЙСКИХ СТРАН НА
Dialogue: 0,0:02:39.56,0:02:44.84,Caption,,0,0,0,,ТЕРРИТОРИИ УКРАИНЫ, БАЗЫ, ОРУЖИЕ И ОБЯЗАТЕЛЬСТВА ПАРТНЁРОВ ВСТУПАТЬ В КОНФЛИКТ
Dialogue: 0,0:02:44.84,0:02:47.48,Caption,,0,0,0,,НА СТОРОНЕ КИЕВА. ТО ЕСТЬ РАЗГОВОР НАЧИНАЛСЯ С
Dialogue: 0,0:02:47.48,0:02:51.40,Caption,,0,0,0,,АНАЛОГА ПЯТОЙ СТАТЬИ, А ПРИЕХАЛИ УЖЕ К ИНОСТРАННЫМ БАЗАМ. И ТУТ
Dialogue: 0,0:02:51.40,0:02:54.28,Caption,,0,0,0,,ХОЧЕТСЯ СПРОСИТЬ СОВСЕМ ПРОСТУЮ ВЕЩЬ. ЕСЛИ ПЯТОЙ
Dialogue: 0,0:02:54.28,0:02:58.28,Caption,,0,0,0,,СТАТЬИ НЕДОСТАТОЧНО, ТО РАДИ ЧЕГО ТОГДА СТОЛЬКО ЛЕТ ДОБИВАЛИСЬ НАТО?
Dialogue: 0,0:02:58.52,0:03:01.00,Caption,,0,0,0,,ЧТО ИМЕННО РАНЬШЕ СЧИТАЛОСЬ ГЛАВНЫМ ПРИЗОМ,
Dialogue: 0,0:03:01.16,0:03:03.64,Caption,,0,0,0,,ЕСЛИ ТЕПЕРЬ ВЫЯСНЯЕТСЯ, ЧТО И ЭТОГО МАЛО?
Dialogue: 0,0:03:04.04,0:03:06.68,Caption,,0,0,0,,ПРИЧЁМ МОСКВА ОТВЕЧАЕТ ВСЁ ТЕМ ЖЕ КОРОТКИМ СЛОВОМ
Dialogue: 0,0:03:06.68,0:03:11.40,Caption,,0,0,0,,НЕТ. РЯБКОВ ОТДЕЛЬНО ГОВОРИТ, ЧТО ДАЖЕ КВАЗИЧЛЕНСТВО УКРАИНЫ В НАТО ДЛЯ РОССИИ
Dialogue: 0,0:03:11.40,0:03:14.60,Caption,,0,0,0,,НЕПРИЕМЛЕМО. ТО ЕСТЬ МОСКВЕ ПРЕДЛАГАЮТ КОНСТРУКЦИЮ,
Dialogue: 0,0:03:14.84,0:03:18.04,Caption,,0,0,0,,КОТОРУЮ ОНА УЖЕ СЧИТАЕТ ПЕРЕХОДОМ ТОЙ САМОЙ ЛИНИИ,
Dialogue: 0,0:03:18.20,0:03:20.92,Caption,,0,0,0,,ВОКРУГ КОТОРОЙ СТОЛЬКО ЛЕТ ИДЁТ СПОР. ТАКОЕ
Dialogue: 0,0:03:20.92,0:03:24.52,Caption,,0,0,0,,ВПЕЧАТЛЕНИЕ, ЧТО ПРОСТО НЕ ПОНИМАЕТСЯ СЛОВО "НЕТ". ВОТ КАК
Dialogue: 0,0:03:24.60,0:03:28.20,Caption,,0,0,0,,ЕЩЁ ЕГО СКАЗАТЬ? ЕСТЬ ЕЩЁ ОДНА ДЕТАЛЬ. МАЛЕНЬКАЯ,
Dialogue: 0,0:03:28.42,0:03:31.72,Caption,,0,0,0,,НО КРАСИВАЯ. ЗЕЛЕНСКИЙ ТРЕБУЕТ ИНОСТРАННЫЕ ВОЕННЫЕ
Dialogue: 0,0:03:31.80,0:03:34.76,Caption,,0,0,0,,БАЗЫ. А СТАТЬЯ СЕМНАДЦАТАЯ КОНСТИТУЦИИ УКРАИНЫ
Dialogue: 0,0:03:34.76,0:03:38.20,Caption,,0,0,0,,ГОВОРИТ, ЧТО РАЗМЕЩЕНИЕ ИНОСТРАННЫХ ВОЕННЫХ БАЗ НА ТЕРРИТОРИИ
Dialogue: 0,0:03:38.20,0:03:44.88,Caption,,0,0,0,,СТРАНЫ НЕ ДОПУСКАЕТСЯ. СТАТЬЯ СТО ПЯТЬДЕСЯТ СЕДЬМАЯ НЕ ПОЗВОЛЯЕТ МЕНЯТЬ
Dialogue: 0,0:03:44.88,0:03:47.76,Caption,,0,0,0,,КОНСТИТУЦИЮ ВО ВРЕМЯ ВОЕННОГО ПОЛОЖЕНИЯ. ТО ЕСТЬ
Dialogue: 0,0:03:47.76,0:03:50.56,Caption,,0,0,0,,ТРЕБОВАНИЕ УПИРАЕТСЯ НЕ ТОЛЬКО В МОСКВУ. ОНО ЕЩЁ
Dialogue: 0,0:03:50.64,0:03:52.48,Caption,,0,0,0,,И ДОМА СТОИТ ПЕРЕД ЗАКРЫТОЙ ДВЕРЬЮ.
Dialogue: 0,0:03:53.04,0:03:57.44,Caption,,0,0,0,,И ВОТ ЗДЕСЬ ВЕРСИЯ О ТОМ, ЧТО КУШНЕР МОГ ПРОСТО ПРОВЕРИТЬ ГОТОВНОСТЬ КИЕВА К
Dialogue: 0,0:03:57.44,0:04:01.20,Caption,,0,0,0,,КОМПРОМИССУ, СТАНОВИТСЯ ОСОБЕННО ИНТЕРЕСНОЙ. ДАЛИ СЕРЬЁЗНОЕ
Dialogue: 0,0:04:01.28,0:04:04.24,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ. ПОСМОТРЕЛИ РЕАКЦИЮ. А В ОТВЕТ ПОЛУЧИЛИ
Dialogue: 0,0:04:04.24,0:04:08.08,Caption,,0,0,0,,НЕ ДВИЖЕНИЕ НАВСТРЕЧУ, А НОВЫЙ СПИСОК. ЭТО УЖЕ ПОХОЖЕ НА ИГРУ
Dialogue: 0,0:04:08.08,0:04:11.28,Caption,,0,0,0,,С ПОСТОЯННО ОТОДВИГАЮЩЕЙСЯ ПЛАНКОЙ. ТОЛЬКО ПОДОШЛИ,
Dialogue: 0,0:04:11.37,0:04:16.40,Caption,,0,0,0,,ЕЁ ПОДНЯЛИ. ЕЩЁ ПОДОШЛИ, ПОДНЯЛИ СНОВА. ПРИЧЁМ ВОКРУГ ЭТОЙ ИСТОРИИ РИТОРИКА
Dialogue: 0,0:04:16.48,0:04:19.76,Caption,,0,0,0,,УЖЕ ДОШЛА ДО ТОГО, ЧТО ЗВУЧАТ РАЗГОВОРЫ С НЫНЕШНИМ УКРАИНСКИМ
Dialogue: 0,0:04:19.76,0:04:22.16,Caption,,0,0,0,,РУКОВОДСТВОМ ДОГОВОРИТЬСЯ ВООБЩЕ НЕ ПОЛУЧИТСЯ И
Dialogue: 0,0:04:22.24,0:04:24.08,Caption,,0,0,0,,ДАЛЬШЕ ПРИДЁТСЯ ИМЕТЬ ДЕЛО УЖЕ С ДРУГИМ
Dialogue: 0,0:04:24.08,0:04:26.96,Caption,,0,0,0,,ПЕРЕГОВОРЩИКОМ. ТО ЕСТЬ ПРОБЛЕМА СТАНОВИТСЯ БОЛЬШЕ
Dialogue: 0,0:04:27.04,0:04:30.08,Caption,,0,0,0,,САМОГО СПОРНОГО ПУНКТА. ЕСЛИ КАЖДЫЙ НОВЫЙ ВАРИАНТ
Dialogue: 0,0:04:30.08,0:04:34.48,Caption,,0,0,0,,ЗАКАНЧИВАЕТСЯ НОВЫМ УСЛОВИЕМ, НАЧИНАЕТ МЕНЯТЬСЯ ОТНОШЕНИЕ УЖЕ НЕ К УСЛОВИЮ,
Dialogue: 0,0:04:34.72,0:04:37.76,Caption,,0,0,0,,А К САМОМУ УЧАСТНИКУ ПЕРЕГОВОРОВ. И ПАРАЛЛЕЛЬНО ИДЁТ
Dialogue: 0,0:04:37.76,0:04:41.12,Caption,,0,0,0,,СОВСЕМ ДРУГАЯ РАБОТА. ЕВРОПА УЖЕ НЕ ПРОСТО ОБСУЖДАЕТ
Dialogue: 0,0:04:41.12,0:04:44.16,Caption,,0,0,0,,БУДУЩИЙ КОНТИНГЕНТ. НА УЧЕНИЯХ МНОГОНАЦИОНАЛЬНЫХ СИЛ
Dialogue: 0,0:04:44.16,0:04:46.96,Caption,,0,0,0,,УЧАСТВОВАЛИ ОДИННАДЦАТЬ СТРАН И ОКОЛО ДВУХ ТЫСЯЧ
Dialogue: 0,0:04:47.04,0:04:50.16,Caption,,0,0,0,,ВОСЬМИСОТ ВОЕННЫХ. ФРАНЦИЯ ДАЛА ОКОЛО ТЫСЯЧИ СТА
Dialogue: 0,0:04:50.24,0:04:57.24,Caption,,0,0,0,,ЧЕЛОВЕК, БРИТАНИЯ, ТРИСТА. АМЕРИКАНСКИХ ВОЙСК ТАМ НЕ БЫЛО. ВОТ ЭТО ОСОБЕННО
Dialogue: 0,0:04:57.24,0:05:00.28,Caption,,0,0,0,,ЗАНЯТНО. ЗЕЛЕНСКИЙ ГОВОРИТ ОБ АМЕРИКАНСКИХ БАЗАХ КАК
Dialogue: 0,0:05:00.36,0:05:03.40,Caption,,0,0,0,,О ЧАСТИ РЕАЛЬНЫХ ГАРАНТИЙ. ЕВРОПЕЙЦЫ УЖЕ ТРЕНИРУЮТ
Dialogue: 0,0:05:03.40,0:05:06.28,Caption,,0,0,0,,КОНТИНГЕНТ. НО АМЕРИКАНЦЫ В ЭТИ УЧЕНИЯ ВОЙСКА НЕ
Dialogue: 0,0:05:06.28,0:05:09.40,Caption,,0,0,0,,ПРИСЫЛАЮТ. ЗАТО В ЕВРОПЕЙСКОЙ КОНСТРУКЦИИ ГАРАНТИЙ
Dialogue: 0,0:05:09.40,0:05:14.12,Caption,,0,0,0,,США ОТВОДИТСЯ ДРУГАЯ РОЛЬ, КОНТРОЛЬ ЗА СОБЛЮДЕНИЕМ ПЕРЕМИРИЯ. ЕВРОПА ГОТОВА
Dialogue: 0,0:05:14.12,0:05:18.52,Caption,,0,0,0,,ПРОДОЛЖАТЬ ВОЕННУЮ ПОМОЩЬ, ОБСУЖДАЕТ МНОГОНАЦИОНАЛЬНЫЕ СИЛЫ ПОД ЕВРОПЕЙСКИМ
Dialogue: 0,0:05:18.52,0:05:22.20,Caption,,0,0,0,,КОМАНДОВАНИЕМ, ОБЕЩАЕТ ДЕЙСТВИЯ В СЛУЧАЕ НОВОГО СТОЛКНОВЕНИЯ,
Dialogue: 0,0:05:22.44,0:05:26.60,Caption,,0,0,0,,НОВЫЙ ПАКЕТ ДЕНЕГ, САНКЦИОННОЕ ДАВЛЕНИЕ И ОТДЕЛЬНЫЕ ДОГОВОРЁННОСТИ ПО
Dialogue: 0,0:05:26.60,0:05:29.00,Caption,,0,0,0,,ЭНЕРГЕТИКЕ. ТО ЕСТЬ КОНСТРУКЦИЯ ПОЛУЧАЕТСЯ
Dialogue: 0,0:05:29.00,0:05:32.36,Caption,,0,0,0,,РОСКОШНАЯ. ОДИН КОНТРОЛИРУЕТ. ВТОРОЙ РАЗМЕЩАЕТ
Dialogue: 0,0:05:32.44,0:05:36.12,Caption,,0,0,0,,ВОЙСКА. ТРЕТИЙ ПЛАТИТ. ЧЕТВЁРТЫЙ ДАЁТ ОРУЖИЕ. ПЯТЫЙ
Dialogue: 0,0:05:36.12,0:05:40.84,Caption,,0,0,0,,ПОТОМ ДОЛЖЕН ОБЪЯСНИТЬ, ПОЧЕМУ МОСКВА ДОЛЖНА ВСЁ ЭТО ПРИНЯТЬ. ОЧЕНЬ УДОБНОЕ
Dialogue: 0,0:05:40.84,0:05:44.36,Caption,,0,0,0,,РАСПРЕДЕЛЕНИЕ РОЛЕЙ. КСТАТИ, ЕСЛИ ВАМ НРАВИТСЯ ТАКОЙ ФОРМАТ,
Dialogue: 0,0:05:44.52,0:05:47.32,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ДАЛЬШЕ НАЧИНАЕТСЯ САМОЕ
Dialogue: 0,0:05:47.32,0:05:50.76,Caption,,0,0,0,,ДОРОГОЕ. НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ ГОД УКРАИНА СНАЧАЛА
Dialogue: 0,0:05:50.84,0:05:53.08,Caption,,0,0,0,,РАССЧИТЫВАЛА ПРИМЕРНО НА СОРОК ПЯТЬ МИЛЛИАРДОВ.
Dialogue: 0,0:05:53.48,0:05:55.80,Caption,,0,0,0,,ПОТОМ ПОСЛЕ КОНСУЛЬТАЦИЙ С ВОЕННЫМ РУКОВОДСТВОМ
Dialogue: 0,0:05:55.80,0:05:59.24,Caption,,0,0,0,,ВЫЯСНИЛОСЬ, ЧТО НУЖНО ЕЩЁ СЕМЬДЕСЯТ МИЛЛИАРДОВ. И ВОТ УЖЕ
Dialogue: 0,0:05:59.24,0:06:01.80,Caption,,0,0,0,,ПОЛУЧАЕТСЯ СТО ПЯТНАДЦАТЬ МИЛЛИАРДОВ. НЕПЛОХАЯ
Dialogue: 0,0:06:01.80,0:06:07.51,Caption,,0,0,0,,ПОПРАВОЧКА. СОРОК ПЯТЬ ПРЕВРАТИЛИСЬ В СТО ПЯТНАДЦАТЬ БЫСТРЕЕ,
Dialogue: 0,0:06:07.77,0:06:10.47,Caption,,0,0,0,,ЧЕМ ОБЫЧНО УСПЕВАЮТ ПЕРЕПЕЧАТАТЬ БЮДЖЕТНУЮ ТАБЛИЦУ.
Dialogue: 0,0:06:10.95,0:06:14.95,Caption,,0,0,0,,ПРИЧЁМ ЗЕЛЕНСКИЙ ГОВОРИТ, ЧТО СОПОСТАВИМАЯ СУММА МОЖЕТ ПОНАДОБИТЬСЯ И В ДВЕ
Dialogue: 0,0:06:15.03,0:06:19.59,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОМ ГОДУ. ДЕВЯНОСТО МИЛЛИАРДОВ ИЗ ТРЕБУЕМОГО ОБЪЁМА УЖЕ ЛИБО
Dialogue: 0,0:06:19.59,0:06:23.27,Caption,,0,0,0,,СОГЛАСОВАНЫ, ЛИБО ПО НИМ ПОЛУЧЕНЫ ПОЛОЖИТЕЛЬНЫЕ СИГНАЛЫ. НО
Dialogue: 0,0:06:23.27,0:06:25.75,Caption,,0,0,0,,ПОЛНОЙ СУММЫ ВСЁ РАВНО НЕТ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:06:25.83,0:06:28.55,Caption,,0,0,0,,АППЕТИТЫ СТАНОВЯТСЯ ОТДЕЛЬНОЙ ТЕМОЙ. ЕСЛИ НА ДВЕ
Dialogue: 0,0:06:28.63,0:06:31.11,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ СНАЧАЛА БЫЛО СОРОК ПЯТЬ,
Dialogue: 0,0:06:31.35,0:06:35.67,Caption,,0,0,0,,А ПОТОМ СТАЛО СТО ПЯТНАДЦАТЬ, СКОЛЬКО ПОНАДОБИТСЯ НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОЙ?
Dialogue: 0,0:06:35.90,0:06:37.35,Caption,,0,0,0,,А НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ДЕВЯТЫЙ?
Dialogue: 0,0:06:37.50,0:06:42.23,Caption,,0,0,0,,А НА ДВЕ ТЫСЯЧИ ТРИДЦАТЫЙ? ПОТОМУ ЧТО ВОЕННАЯ ЧАСТЬ ЭТОЙ ИСТОРИИ УЖЕ СЧИТАЕТСЯ
Dialogue: 0,0:06:42.31,0:06:47.43,Caption,,0,0,0,,ИМЕННО ТАКИМИ СРОКАМИ. РАСЧЁТ ВОКРУГ БЕРЛИНСКОЙ ВСТРЕЧИ "КОАЛИЦИИ ЖЕЛАЮЩИХ"
Dialogue: 0,0:06:47.51,0:06:50.23,Caption,,0,0,0,,ИДЁТ НЕ ТОЛЬКО НА ТЕКУЩИЕ ПОСТАВКИ. ПЛАН ЗАКУПОК
Dialogue: 0,0:06:50.23,0:06:52.79,Caption,,0,0,0,,ОПИСЫВАЕТСЯ НА БЛИЖАЙШИЕ ГОДЫ С ТАКИМ РАСЧЁТОМ,
Dialogue: 0,0:06:52.95,0:06:55.67,Caption,,0,0,0,,ЧТОБЫ УКРАИНСКИЕ ВОЕННЫЕ УСПЕЛИ ОСВОИТЬ НОВЫЕ
Dialogue: 0,0:06:55.75,0:06:58.55,Caption,,0,0,0,,СИСТЕМЫ ВООРУЖЕНИЯ И ТЕХНИКУ К РУБЕЖУ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:06:58.55,0:07:01.75,Caption,,0,0,0,,ТРИДЦАТОГО ГОДА. В ТОМ ЧИСЛЕ ЗАРАНЕЕ ОБСУЖДАЕТСЯ,
Dialogue: 0,0:07:02.01,0:07:04.31,Caption,,0,0,0,,ЧЕМ ВООРУЖАТЬ БУДУЩИЕ УКРАИНСКИЕ GRIPEN,
Dialogue: 0,0:07:04.58,0:07:07.43,Caption,,0,0,0,,КАКИЕ СРЕДСТВА ПОРАЖЕНИЯ ЗАКУПАТЬ И КАК ВСЁ ЭТО
Dialogue: 0,0:07:07.51,0:07:10.23,Caption,,0,0,0,,ДОЛЖНО РАБОТАТЬ ВМЕСТЕ. ПАРАЛЛЕЛЬНО ШВЕЦИЯ И
Dialogue: 0,0:07:10.23,0:07:13.11,Caption,,0,0,0,,БРИТАНИЯ ДОГОВАРИВАЮТСЯ О РАКЕТАХ METEOR ДЛЯ GRIPEN.
Dialogue: 0,0:07:15.40,0:07:18.04,Caption,,0,0,0,,ЗАДАЧА КОНКРЕТНАЯ ДОСТАВАТЬ РОССИЙСКИЕ СУ ТРИДЦАТЬ
Dialogue: 0,0:07:18.12,0:07:21.00,Caption,,0,0,0,,ЧЕТЫРЕ НА БОЛЬШОЙ ДИСТАНЦИИ ЕЩЁ ДО ПРИМЕНЕНИЯ ИМИ
Dialogue: 0,0:07:21.00,0:07:24.04,Caption,,0,0,0,,ПЛАНИРУЮЩИХ АВИАБОМБ. И ВЫ ТОЛЬКО ПОСМОТРИТЕ НА ЭТУ
Dialogue: 0,0:07:24.12,0:07:27.00,Caption,,0,0,0,,КРАСОТУ. НА ОДНОМ СТОЛЕ ЛЕЖИТ СРОЧНОЕ МИРНОЕ
Dialogue: 0,0:07:27.00,0:07:29.24,Caption,,0,0,0,,СОГЛАШЕНИЕ ДО ЯНВАРЯ. НА ДРУГОМ,
Dialogue: 0,0:07:29.32,0:07:31.56,Caption,,0,0,0,,ДЕНЬГИ НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ И ДВЕ
Dialogue: 0,0:07:31.64,0:07:33.88,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОЙ. НА ТРЕТЬЕМ,
Dialogue: 0,0:07:34.12,0:07:38.28,Caption,,0,0,0,,ВООРУЖЕНИЯ И ПОДГОТОВКА, РАССЧИТАННЫЕ УЖЕ К ДВЕ ТЫСЯЧИ ТРИДЦАТОМУ. ЭТО
Dialogue: 0,0:07:38.28,0:07:42.92,Caption,,0,0,0,,ДОКАЗАТЕЛЬСТВО. ЗАДАЧА, ДОТЯНУТЬ ЭТУ КОНСТРУКЦИЮ ДО ДВЕ ТЫСЯЧИ ТРИДЦАТОГО
Dialogue: 0,0:07:42.92,0:07:46.12,Caption,,0,0,0,,ГОДА. И ТОГДА РОСТ ФИНАНСОВЫХ ЗАПРОСОВ ВЫГЛЯДИТ УЖЕ
Dialogue: 0,0:07:46.12,0:07:49.16,Caption,,0,0,0,,СОВСЕМ ИНАЧЕ. СТО ПЯТНАДЦАТЬ МИЛЛИАРДОВ ПЕРЕСТАЮТ
Dialogue: 0,0:07:49.16,0:07:51.96,Caption,,0,0,0,,БЫТЬ КАКОЙ ТО СЛУЧАЙНОЙ ОГРОМНОЙ ЦИФРОЙ. ЭТО ЦЕНА
Dialogue: 0,0:07:51.96,0:07:56.84,Caption,,0,0,0,,ЕЩЁ ОДНОГО ГОДА КОНСТРУКЦИИ, КОТОРУЮ ПРОДОЛЖАЮТ СТРОИТЬ ДАЛЬШЕ. И ВОПРОС УЖЕ НЕ
Dialogue: 0,0:07:56.84,0:08:00.68,Caption,,0,0,0,,ТОЛЬКО В ТОМ, ДАДУТ ЛИ КИЕВУ СТО ПЯТНАДЦАТЬ МИЛЛИАРДОВ. ВОПРОС В
Dialogue: 0,0:08:00.68,0:08:04.12,Caption,,0,0,0,,ТОМ, СКОЛЬКО РАЗ ЕЩЁ ЭТА СУММА БУДЕТ ПЕРЕСЧИТАНА ВВЕРХ.
Dialogue: 0,0:08:04.44,0:08:07.16,Caption,,0,0,0,,ПОТОМУ ЧТО АППЕТИТ ТО РАСТЁТ. СНАЧАЛА СОРОК ПЯТЬ.
Dialogue: 0,0:08:07.48,0:08:09.72,Caption,,0,0,0,,ПОТОМ СТО ПЯТНАДЦАТЬ. СЛЕДУЮЩИЙ ГОД,
Dialogue: 0,0:08:09.88,0:08:12.84,Caption,,0,0,0,,ЕЩЁ СОПОСТАВИМАЯ СУММА. А ВПЕРЕДИ ЕЩЁ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:08:12.92,0:08:15.48,Caption,,0,0,0,,ДВАДЦАТЬ ДЕВЯТЫЙ И ДВЕ ТЫСЯЧИ ТРИДЦАТЫЙ. ХОРОШО
Dialogue: 0,0:08:15.48,0:08:17.88,Caption,,0,0,0,,УСТРОИЛИСЬ. ЕВРОПЕЙЦАМ ЗДЕСЬ ВООБЩЕ ДОСТАЛАСЬ
Dialogue: 0,0:08:17.88,0:08:23.21,Caption,,0,0,0,,УДИВИТЕЛЬНАЯ РОЛЬ. С ФЕВРАЛЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА ПО
Dialogue: 0,0:08:23.29,0:08:25.53,Caption,,0,0,0,,СЕРЕДИНУ ОКТЯБРЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОГО
Dialogue: 0,0:08:25.85,0:08:28.49,Caption,,0,0,0,,ЕВРОСОЮЗ И ЕГО СТРАНЫ НАПРАВИЛИ УКРАИНЕ ОКОЛО
Dialogue: 0,0:08:28.49,0:08:31.13,Caption,,0,0,0,,ДВУХСОТ ТРИДЦАТИ ОДНОГО С ПОЛОВИНОЙ МИЛЛИАРДА ЕВРО
Dialogue: 0,0:08:31.13,0:08:34.01,Caption,,0,0,0,,ПОМОЩИ. А РОССИЯ ЗА ТОТ ЖЕ ПЕРИОД ПОЛУЧИЛА
Dialogue: 0,0:08:34.09,0:08:36.97,Caption,,0,0,0,,ОТ ЕВРОСОЮЗА ОКОЛО ДВУХСОТ ТРИДЦАТИ ДВУХ МИЛЛИАРДОВ
Dialogue: 0,0:08:36.97,0:08:41.45,Caption,,0,0,0,,ЕВРО ЗА ИМПОРТ, ВКЛЮЧАЯ ЭНЕРГОРЕСУРСЫ. ПРАКТИЧЕСКИ ЗЕРКАЛЬНЫЕ СУММЫ.
Dialogue: 0,0:08:41.74,0:08:44.41,Caption,,0,0,0,,ОСОБЕННО КРАСИВО ВЫГЛЯДИТ ФРАНЦИЯ ОКОЛО СОРОКА
Dialogue: 0,0:08:44.41,0:08:46.97,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО ПЛАТЕЖЕЙ РОССИИ ПРОТИВ ПРИМЕРНО
Dialogue: 0,0:08:47.05,0:08:50.01,Caption,,0,0,0,,ШЕСТНАДЦАТИ МИЛЛИАРДОВ ПОМОЩИ УКРАИНЕ. ТО ЕСТЬ ОДНОЙ
Dialogue: 0,0:08:50.01,0:08:54.33,Caption,,0,0,0,,РУКОЙ ПОМОГАЛИ КИЕВУ, ДРУГОЙ ПРОДОЛЖАЛИ ОПЛАЧИВАТЬ РОССИЙСКИЙ ИМПОРТ. В
Dialogue: 0,0:08:54.33,0:08:59.37,Caption,,0,0,0,,БУХГАЛТЕРИИ ТАКОЕ, НАВЕРНОЕ, НАЗЫВАЕТСЯ ДИВЕРСИФИКАЦИЕЙ. В ОБЫЧНОЙ ЖИЗНИ ВЫГЛЯДИТ
Dialogue: 0,0:08:59.45,0:09:02.41,Caption,,0,0,0,,ПРОЩЕ ПЛАТИМ ВСЕМ. А ПОТОМ ПРИХОДИТ СЛЕДУЮЩИЙ СЧЁТ
Dialogue: 0,0:09:02.49,0:09:05.05,Caption,,0,0,0,,НА СТО ПЯТНАДЦАТЬ МИЛЛИАРДОВ. И СЛЕДУЮЩИЙ ГОД УЖЕ
Dialogue: 0,0:09:05.05,0:09:07.93,Caption,,0,0,0,,СТОИТ ЗА ДВЕРЬЮ. НО ДЕНЕГ МАЛО. НУЖНЫ ЕЩЁ
Dialogue: 0,0:09:08.01,0:09:11.69,Caption,,0,0,0,,ВОЙСКА. НУЖНЫ БАЗЫ. НУЖНЫ ДАЛЬНОБОЙНЫЕ РАКЕТЫ. НУЖНЫ
Dialogue: 0,0:09:11.77,0:09:15.05,Caption,,0,0,0,,НОВЫЕ САМОЛЁТЫ. НУЖНЫ ОБЯЗАТЕЛЬСТВА США. НУЖЕН
Dialogue: 0,0:09:15.13,0:09:18.49,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ КОНТИНГЕНТ. НУЖЕН НОВЫЙ КОНГРЕСС. И ВСЁ
Dialogue: 0,0:09:18.49,0:09:21.13,Caption,,0,0,0,,ЭТО НАДО КАКИМ ТО ОБРАЗОМ ЗАСУНУТЬ В СОГЛАШЕНИЕ,
Dialogue: 0,0:09:21.37,0:09:24.09,Caption,,0,0,0,,КОТОРОЕ ВАШИНГТОН ХОЧЕТ ЗАКРЫТЬ ДО ЯНВАРЯ. СХЕМА
Dialogue: 0,0:09:24.09,0:09:26.65,Caption,,0,0,0,,ПОЧТИ ИДЕАЛЬНАЯ. ОСОБЕННО ЕСЛИ ЗАДАЧА,
Dialogue: 0,0:09:26.97,0:09:29.53,Caption,,0,0,0,,КАЖДЫЙ РАЗ ПОДХОДИТЬ К СОГЛАШЕНИЮ И НАХОДИТЬ ЕЩЁ
Dialogue: 0,0:09:29.53,0:09:32.89,Caption,,0,0,0,,ОДНУ ПРИЧИНУ, ПОЧЕМУ ИМЕННО СЕЙЧАС ПОДПИСАТЬ ЕГО НЕЛЬЗЯ.
Dialogue: 0,0:09:35.14,0:09:38.35,Caption,,0,0,0,,ТРАМП ТОРОПИТ. КИЕВ СМОТРИТ НА КОНГРЕСС. ЕВРОПА
Dialogue: 0,0:09:38.35,0:09:41.23,Caption,,0,0,0,,ГОТОВИТ ДЕНЬГИ И ВОЙСКА. ВОЕННЫЕ ПРОГРАММЫ УЖЕ
Dialogue: 0,0:09:41.31,0:09:43.55,Caption,,0,0,0,,СМОТРЯТ В СТОРОНУ ДВЕ ТЫСЯЧИ ТРИДЦАТОГО ГОДА.
Dialogue: 0,0:09:44.11,0:09:46.91,Caption,,0,0,0,,И ВОТ ЗДЕСЬ ВОЗВРАЩАЕМСЯ К САМОМУ ПЕРВОМУ ВОПРОСУ.
Dialogue: 0,0:09:47.23,0:09:49.55,Caption,,0,0,0,,СКОЛЬКО РАЗ ЧЕЛОВЕКУ НУЖНО СКАЗАТЬ "НЕТ",
Dialogue: 0,0:09:49.71,0:09:51.63,Caption,,0,0,0,,ЧТОБЫ ОН ПОНЯЛ, ЧТО ЭТО "НЕТ"?
Dialogue: 0,0:09:52.13,0:09:54.51,Caption,,0,0,0,,ПОТОМУ ЧТО ЕСЛИ ПОСЛЕ КАЖДОГО ОТКАЗА ТРЕБОВАНИЯ
Dialogue: 0,0:09:54.51,0:09:57.31,Caption,,0,0,0,,СТАНОВЯТСЯ ТОЛЬКО БОЛЬШЕ, РЕЧЬ УЖЕ НЕ О ТОМ,
Dialogue: 0,0:09:57.39,0:10:00.51,Caption,,0,0,0,,НАСКОЛЬКО СЛОЖНО ДОГОВОРИТЬСЯ. ЦЕНА САМОГО ОЖИДАНИЯ
Dialogue: 0,0:10:00.51,0:10:03.23,Caption,,0,0,0,,РАСТЁТ КАЖДЫЙ МЕСЯЦ. ПРИЧЁМ ПЛАТИТ ЗА НЕЁ НЕ
Dialogue: 0,0:10:03.31,0:10:06.67,Caption,,0,0,0,,ТОТ, КТО ПРИДУМЫВАЕТ СЛЕДУЮЩИЙ ПУНКТ ПЕРЕГОВОРОВ. ЕСЛИ У
Dialogue: 0,0:10:06.67,0:10:10.67,Caption,,0,0,0,,ВАС ЕСТЬ СВОЁ ОБЪЯСНЕНИЕ, ЗАЧЕМ ПРИ СРОЧНЫХ РАЗГОВОРАХ О СОГЛАШЕНИИ
