Dialogue: 0,0:00:00.11,0:00:04.04,Caption,,0,0,0,,ТРАМП, ПОХОЖЕ, РЕШИЛ ДЕЙСТВОВАТЬ ПО СТАРИНКЕ. ЕСТЬ ПРОБЛЕМА,
Dialogue: 0,0:00:04.12,0:00:07.00,Caption,,0,0,0,,НАДО САДИТЬСЯ И РАЗГОВАРИВАТЬ. СТОЛ ПОСТАВИЛИ,
Dialogue: 0,0:00:07.08,0:00:09.96,Caption,,0,0,0,,СТУЛЬЯ ПРИНЕСЛИ. А ЧАСТЬ ЕВРОПЫ УЖЕ ОБЪЯСНЯЕТ,
Dialogue: 0,0:00:10.04,0:00:13.24,Caption,,0,0,0,,ПОЧЕМУ САДИТЬСЯ ОНА НЕ СОБИРАЕТСЯ. НУ ХОРОШО. ТОГДА
Dialogue: 0,0:00:13.24,0:00:16.12,Caption,,0,0,0,,ВОЗНИКАЕТ СОВСЕМ ПРОСТОЙ ВОПРОС. А ДАЛЬШЕ ТО ЧТО
Dialogue: 0,0:00:16.20,0:00:19.08,Caption,,0,0,0,,У ВАС ПО ПЛАНУ? ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:19.19,0:00:21.24,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ТРАМП ЗАГОВОРИЛ О БОЛЬШОЙ
Dialogue: 0,0:00:21.24,0:00:25.24,Caption,,0,0,0,,ДОГОВОРЁННОСТИ, КОТОРАЯ ДОЛЖНА КАСАТЬСЯ УЖЕ НЕ ТОЛЬКО УКРАИНЫ. РЕЧЬ
Dialogue: 0,0:00:25.24,0:00:29.16,Caption,,0,0,0,,ПОШЛА ШИРЕ, О ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ ВООБЩЕ. ЕГО ЛЮДИ ГОВОРЯТ
Dialogue: 0,0:00:29.24,0:00:32.84,Caption,,0,0,0,,О ПОСТОЯННЫХ КОНСУЛЬТАЦИЯХ, ПРЯМОЙ СВЯЗИ НА СЛУЧАЙ КРИЗИСА,
Dialogue: 0,0:00:33.04,0:00:35.64,Caption,,0,0,0,,ВОЕННОЙ ПРОЗРАЧНОСТИ, ВЗАИМНЫХ МЕРАХ,
Dialogue: 0,0:00:35.88,0:00:39.00,Caption,,0,0,0,,КОТОРЫЕ ДОЛЖНЫ СНИЖАТЬ РИСК ЭСКАЛАЦИИ. ТО ЕСТЬ ИДЕЯ
Dialogue: 0,0:00:39.08,0:00:41.72,Caption,,0,0,0,,НА ЧЕЛОВЕЧЕСКОМ ЯЗЫКЕ ДОВОЛЬНО ПРОСТАЯ. ДАВАЙТЕ ХОТЯ
Dialogue: 0,0:00:41.72,0:00:43.80,Caption,,0,0,0,,БЫ ДОГОВОРИМСЯ, КТО КУДА НЕ ЛЕЗЕТ,
Dialogue: 0,0:00:43.88,0:00:46.36,Caption,,0,0,0,,КТО ЧЕГО НЕ СТАВИТ, КТО КОМУ ЗВОНИТ,
Dialogue: 0,0:00:46.60,0:00:48.36,Caption,,0,0,0,,КОГДА НАЧИНАЕТ ПАХНУТЬ ЖАРЕНЫМ,
Dialogue: 0,0:00:48.60,0:00:52.36,Caption,,0,0,0,,И КАК СДЕЛАТЬ ТАК, ЧТОБЫ СЛЕДУЮЩИЙ КРИЗИС НЕ ПРИХОДИЛОСЬ ТУШИТЬ УЖЕ
Dialogue: 0,0:00:52.36,0:00:55.24,Caption,,0,0,0,,ВСЕМ КОНТИНЕНТОМ. И ТУТ ВЫЯСНЯЕТСЯ ПРЕКРАСНАЯ
Dialogue: 0,0:00:55.24,0:00:58.68,Caption,,0,0,0,,ПОДРОБНОСТЬ. ЕВРОПЕЙСКИЕ СОЮЗНИКИ ПО НАТО ЗАРАНЕЕ ОБ
Dialogue: 0,0:00:58.68,0:01:01.56,Caption,,0,0,0,,ЭТИХ АМЕРИКАНСКИХ ПЛАНАХ ТОЛКОМ НЕ ЗНАЛИ. ВОТ ЭТО
Dialogue: 0,0:01:01.56,0:01:04.44,Caption,,0,0,0,,УЖЕ ХОРОШИЙ СЕМЕЙНЫЙ РАЗГОВОР. АМЕРИКА СОБИРАЕТСЯ
Dialogue: 0,0:01:04.44,0:01:07.56,Caption,,0,0,0,,ОБСУЖДАТЬ БЕЗОПАСНОСТЬ ЕВРОПЫ. ЕВРОПА УЗНАЁТ,
Dialogue: 0,0:01:07.72,0:01:10.04,Caption,,0,0,0,,ЧТО ЕЁ БЕЗОПАСНОСТЬ СОБИРАЮТСЯ ОБСУЖДАТЬ,
Dialogue: 0,0:01:10.20,0:01:15.60,Caption,,0,0,0,,ПРАКТИЧЕСКИ ИЗ НОВОСТЕЙ. А ПОТОМ ЕВРОПА ВОЗМУЩАЕТСЯ,
Dialogue: 0,0:01:15.76,0:01:18.40,Caption,,0,0,0,,ЧТО БЕЗ НЕЁ НИЧЕГО ОБСУЖДАТЬ НЕЛЬЗЯ. И ВЕДЬ
Dialogue: 0,0:01:18.48,0:01:21.36,Caption,,0,0,0,,ТУТ С САМОЙ ПРЕТЕНЗИЕЙ СПОРИТЬ ТРУДНО. КОНЕЧНО,
Dialogue: 0,0:01:21.52,0:01:23.52,Caption,,0,0,0,,ЕСЛИ РЕЧЬ ИДЁТ О БЕЗОПАСНОСТИ ЕВРОПЫ,
Dialogue: 0,0:01:23.77,0:01:26.96,Caption,,0,0,0,,ЕВРОПА ХОЧЕТ СИДЕТЬ ЗА СТОЛОМ. ЛОГИЧНО. ТОЛЬКО ЕСТЬ
Dialogue: 0,0:01:26.96,0:01:29.60,Caption,,0,0,0,,ОДИН НЮАНС. САДИТЬСЯ ЗА СТОЛ ОНА ХОЧЕТ,
Dialogue: 0,0:01:29.88,0:01:33.12,Caption,,0,0,0,,А ОБСУЖДАТЬ ТО, РАДИ ЧЕГО СТОЛ ВООБЩЕ НАЧАЛИ СОБИРАТЬ,
Dialogue: 0,0:01:33.43,0:01:36.00,Caption,,0,0,0,,ЧАСТЬ ЕВРОПЕЙСКИХ РУКОВОДИТЕЛЕЙ ЗАРАНЕЕ НЕ ХОЧЕТ.
Dialogue: 0,0:01:36.29,0:01:41.04,Caption,,0,0,0,,КАЯ КАЛЛАС СРАЗУ ЗАЯВЛЯЕТ, ЧТО НИКАКУЮ НОВУЮ АРХИТЕКТУРУ БЕЗОПАСНОСТИ ЕВРОПЕ
Dialogue: 0,0:01:41.04,0:01:43.84,Caption,,0,0,0,,ОСОБО НЕ НАДО. У ЕВРОПЫ УЖЕ ЕСТЬ НАТО,
Dialogue: 0,0:01:44.00,0:01:47.12,Caption,,0,0,0,,ЕСТЬ ЕВРОСОЮЗ, ВСЁ ДАВНО ПОСТРОЕНО. ПУТИН,
Dialogue: 0,0:01:47.28,0:01:50.80,Caption,,0,0,0,,ГОВОРИТ ОНА, НИКАКОГО ПРАВА ВЕТО НА ЕВРОПЕЙСКУЮ БЕЗОПАСНОСТЬ НЕ
Dialogue: 0,0:01:50.80,0:01:54.96,Caption,,0,0,0,,ИМЕЕТ. ХОРОШО. ТОГДА ВОПРОС. ЕСЛИ ВСЁ УЖЕ ПОСТРОЕНО,
Dialogue: 0,0:01:55.05,0:01:57.68,Caption,,0,0,0,,ВСЁ ПРЕКРАСНО РАБОТАЕТ И МЕНЯТЬ НИЧЕГО НЕ НАДО,
Dialogue: 0,0:01:58.00,0:02:00.00,Caption,,0,0,0,,ЗАЧЕМ ВООБЩЕ ПОНАДОБИЛИСЬ ЭТИ РАЗГОВОРЫ?
Dialogue: 0,0:02:00.20,0:02:03.68,Caption,,0,0,0,,ПЯТЫЙ ГОД ИДЁТ ТЯЖЕЛЕЙШИЙ КОНФЛИКТ. РОССИЯ ЕЩЁ ДО
Dialogue: 0,0:02:03.76,0:02:06.32,Caption,,0,0,0,,ЕГО НАЧАЛА СТАВИЛА ВОПРОС О ВОЕННОЙ ИНФРАСТРУКТУРЕ
Dialogue: 0,0:02:06.40,0:02:11.20,Caption,,0,0,0,,НАТО, ВООРУЖЕНИЯХ, РАСШИРЕНИИ АЛЬЯНСА И ПРАВИЛАХ БЕЗОПАСНОСТИ. ЗАПАД
Dialogue: 0,0:02:11.28,0:02:13.84,Caption,,0,0,0,,ЭТИ ТРЕБОВАНИЯ НЕ ПРИНЯЛ. УКРАИНА ИМЕЕТ СВОИ
Dialogue: 0,0:02:13.84,0:02:17.20,Caption,,0,0,0,,ТРЕБОВАНИЯ. ЕВРОПА СВОИ. АМЕРИКА СЕЙЧАС ПЫТАЕТСЯ
Dialogue: 0,0:02:17.28,0:02:19.84,Caption,,0,0,0,,ОТКРЫТЬ РАЗГОВОР О БОЛЕЕ ШИРОКОЙ КОНСТРУКЦИИ. И
Dialogue: 0,0:02:19.84,0:02:22.72,Caption,,0,0,0,,ОТВЕТ ЧАСТИ ЕВРОПЫ ЗВУЧИТ ПРИМЕРНО ТАК КОНСТРУКЦИЮ
Dialogue: 0,0:02:22.72,0:02:26.56,Caption,,0,0,0,,ОБСУЖДАТЬ НЕ БУДЕМ, ПОТОМУ ЧТО КОНСТРУКЦИЯ УЖЕ ЕСТЬ. ШИКАРНО.
Dialogue: 0,0:02:28.84,0:02:32.60,Caption,,0,0,0,,ДОМ ГОРИТ, А ПРЕДСЕДАТЕЛЬ ТСЖ ГОВОРИТ ПРОЕКТ ДОМА УТВЕРЖДЁН
Dialogue: 0,0:02:32.60,0:02:34.44,Caption,,0,0,0,,ДАВНО, МЕНЯТЬ НИЧЕГО НЕ БУДЕМ.
Dialogue: 0,0:02:35.04,0:02:37.32,Caption,,0,0,0,,КАЛЛАС ЗДЕСЬ ВООБЩЕ ФИГУРА ОЧЕНЬ ПОКАЗАТЕЛЬНАЯ.
Dialogue: 0,0:02:37.56,0:02:40.28,Caption,,0,0,0,,СЕЙЧАС ОНА ПРЕДСТАВЛЯЕТ ВЕСЬ ЕВРОСОЮЗ ВО ВНЕШНЕЙ
Dialogue: 0,0:02:40.28,0:02:43.32,Caption,,0,0,0,,ПОЛИТИКЕ. НО ДО ЭТОГО ОНА БЫЛА ПРЕМЬЕРОМ ЭСТОНИИ.
Dialogue: 0,0:02:43.63,0:02:45.56,Caption,,0,0,0,,И РЯДОМ С НЕЙ В ПЕРВЫХ РЯДАХ ВЫСТУПАЕТ
Dialogue: 0,0:02:45.56,0:02:48.68,Caption,,0,0,0,,НЫНЕШНИЙ ПРЕМЬЕР ЭСТОНИИ КРИСТЕН МИХАЛ. МИХАЛ
Dialogue: 0,0:02:48.68,0:02:51.88,Caption,,0,0,0,,ГОВОРИТ, ЧТО ЕВРОПЕ НЕ НАДО СТАНОВИТЬСЯ ПОСРЕДНИКОМ МЕЖДУ
Dialogue: 0,0:02:51.88,0:02:55.08,Caption,,0,0,0,,РОССИЕЙ И УКРАИНОЙ, НЕ НАДО ПЫТАТЬСЯ УГОДИТЬ ПУТИНУ,
Dialogue: 0,0:02:55.24,0:02:57.88,Caption,,0,0,0,,НЕ НАДО ИСКАТЬ ОТДЕЛЬНЫЙ КАНАЛ С МОСКВОЙ. НАДО
Dialogue: 0,0:02:57.88,0:03:03.08,Caption,,0,0,0,,ПРОДОЛЖАТЬ ДАВЛЕНИЕ, САНКЦИИ, ВИЗОВЫЕ ОГРАНИЧЕНИЯ. ТО ЕСТЬ ПОСРЕДНИК НЕ НУЖЕН.
Dialogue: 0,0:03:03.32,0:03:07.00,Caption,,0,0,0,,ПРЯМОЙ РАЗГОВОР НЕ НУЖЕН. ДАВЛЕНИЕ НУЖНО. ЛАДНО. А
Dialogue: 0,0:03:07.00,0:03:10.44,Caption,,0,0,0,,РЕЗУЛЬТАТ КАКОЙ? ЧТО ДОЛЖНО ПРОИЗОЙТИ В КОНЦЕ ЭТОЙ СХЕМЫ?
Dialogue: 0,0:03:10.66,0:03:12.76,Caption,,0,0,0,,РОССИЯ ДОЛЖНА ОДНАЖДЫ УТРОМ ПРОСНУТЬСЯ,
Dialogue: 0,0:03:13.00,0:03:15.40,Caption,,0,0,0,,ПОСМОТРЕТЬ НА ОЧЕРЕДНОЙ ПАКЕТ САНКЦИЙ И СКАЗАТЬ
Dialogue: 0,0:03:15.45,0:03:19.40,Caption,,0,0,0,,МУЖИКИ, ВСЁ, УБЕДИЛИ? ИЛИ САНКЦИЙ ДОЛЖНО СТАТЬ СТОЛЬКО,
Dialogue: 0,0:03:19.56,0:03:22.76,Caption,,0,0,0,,ЧТОБЫ ПОСЛЕ КАКОГО ТО ПАКЕТА АВТОМАТИЧЕСКИ ВКЛЮЧИЛСЯ
Dialogue: 0,0:03:22.76,0:03:26.44,Caption,,0,0,0,,МИР? ПОТОМУ ЧТО САНКЦИОННЫЕ ПАКЕТЫ ИДУТ ГОДАМИ. А ТЕПЕРЬ
Dialogue: 0,0:03:26.44,0:03:29.00,Caption,,0,0,0,,ЕВРОКОМИССИЯ ЕЩЁ И СОЗДАЁТ ПОСТОЯННЫЙ ОФИС ПО
Dialogue: 0,0:03:29.00,0:03:31.16,Caption,,0,0,0,,САНКЦИЯМ. НЕ ВРЕМЕННУЮ ГРУППУ,
Dialogue: 0,0:03:31.32,0:03:34.68,Caption,,0,0,0,,НЕ СОВЕЩАНИЕ НА ПАРУ МЕСЯЦЕВ. ОТДЕЛЬНУЮ ПОСТОЯННУЮ
Dialogue: 0,0:03:34.76,0:03:38.28,Caption,,0,0,0,,СТРУКТУРУ, КОТОРАЯ ДОЛЖНА ЗАНИМАТЬСЯ ВСЕЙ САНКЦИОННОЙ МАШИНОЙ,
Dialogue: 0,0:03:38.52,0:03:41.24,Caption,,0,0,0,,ОТ РАЗРАБОТКИ ДО ИСПОЛНЕНИЯ И БОРЬБЫ С ОБХОДОМ
Dialogue: 0,0:03:41.24,0:03:46.62,Caption,,0,0,0,,ОГРАНИЧЕНИЙ. ТО ЕСТЬ ЭТА РАБОТА УЖЕ ОФОРМЛЯЕТСЯ ПРАКТИЧЕСКИ КАК
Dialogue: 0,0:03:46.62,0:03:49.58,Caption,,0,0,0,,ПОСТОЯННАЯ ОТРАСЛЬ. У НАС ТУТ БИЗНЕС. НЕ В
Dialogue: 0,0:03:49.58,0:03:53.02,Caption,,0,0,0,,СМЫСЛЕ, ЧТО ТРАМП ВНЕЗАПНО ПОЛЮБИЛ РОССИЮ. НЕ ПОЛЮБИЛ.
Dialogue: 0,0:03:53.34,0:03:56.30,Caption,,0,0,0,,ГОСУДАРСТВА ВООБЩЕ РЕДКО СТРОЯТ ПОЛИТИКУ НА ЛЮБВИ. У
Dialogue: 0,0:03:56.30,0:03:58.46,Caption,,0,0,0,,АМЕРИКИ СВОИ ИНТЕРЕСЫ. ДЕНЬГИ,
Dialogue: 0,0:03:58.54,0:04:01.18,Caption,,0,0,0,,РЕСУРСЫ, СДЕЛКИ, ВЛИЯНИЕ,
Dialogue: 0,0:04:01.32,0:04:05.98,Caption,,0,0,0,,КИТАЙ, ЕВРОПА, ВОЕННЫЕ РАСХОДЫ. ТРАМП СМОТРИТ НА КОНФЛИКТ И
Dialogue: 0,0:04:06.06,0:04:09.10,Caption,,0,0,0,,СЧИТАЕТ, ЧТО ДОГОВОРЁННОСТЬ ЕМУ ВЫГОДНЕЕ БЕСКОНЕЧНОГО
Dialogue: 0,0:04:09.10,0:04:11.98,Caption,,0,0,0,,ПРОЦЕССА. ЕВРОПЕЙСКИЙ ПОЛИТИЧЕСКИЙ ЦЕНТР ПОКА
Dialogue: 0,0:04:11.98,0:04:15.18,Caption,,0,0,0,,ПРОДОЛЖАЕТ ДРУГУЮ ЛИНИЮ. ДАВИТЬ. ОГРАНИЧИВАТЬ.
Dialogue: 0,0:04:15.35,0:04:18.38,Caption,,0,0,0,,УСИЛИВАТЬ САНКЦИИ. НЕ ПОЗВОЛЯТЬ РОССИИ ВЛИЯТЬ НА
Dialogue: 0,0:04:18.38,0:04:21.26,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ СИСТЕМУ БЕЗОПАСНОСТИ. ЭТО ДВЕ РАЗНЫЕ
Dialogue: 0,0:04:21.34,0:04:25.26,Caption,,0,0,0,,ЛОГИКИ. ЭСТОНИЯ ТРЕБУЕТ СИЛЬНЕЕ ДАВИТЬ МОСКВУ. ЛИТВА
Dialogue: 0,0:04:25.26,0:04:29.82,Caption,,0,0,0,,СНОВА ПРЕДУПРЕЖДАЕТ, ЧТО РОССИИ ДОВЕРЯТЬ НЕЛЬЗЯ. ПРЕЗИДЕНТ ЛИТВЫ ГИТАНАС
Dialogue: 0,0:04:29.82,0:04:32.54,Caption,,0,0,0,,НАУСЕДА ГОВОРИТ О ПРОДОЛЖЕНИИ ПРОВОКАЦИЙ ПРОТИВ
Dialogue: 0,0:04:32.54,0:04:35.42,Caption,,0,0,0,,СТРАН НАТО И О ПРОВЕРКЕ КРАСНЫХ ЛИНИЙ АЛЬЯНСА.
Dialogue: 0,0:04:35.90,0:04:37.58,Caption,,0,0,0,,И ТУТ Я ОПЯТЬ ВСПОМИНАЮ ФРАЗУ,
Dialogue: 0,0:04:37.82,0:04:40.22,Caption,,0,0,0,,КОТОРУЮ ПРИПИСЫВАЮТ СТАЛИНУ. "А СКОЛЬКО У НИХ
Dialogue: 0,0:04:40.22,0:04:42.62,Caption,,0,0,0,,ДИВИЗИЙ?" ВОТ ПРАВДА. А СКОЛЬКО?
Dialogue: 0,0:04:42.85,0:04:44.78,Caption,,0,0,0,,ПОТОМУ ЧТО РИТОРИКА ИНОГДА ТАКАЯ,
Dialogue: 0,0:04:45.01,0:04:47.90,Caption,,0,0,0,,БУДТО ЗА ЭСТОНИЕЙ СТОИТ СОБСТВЕННАЯ АРМИЯ РАЗМЕРОМ С
Dialogue: 0,0:04:47.90,0:04:50.78,Caption,,0,0,0,,ПОЛОВИНУ ЕВРОПЫ, ЗА ЛИТВОЙ ВТОРАЯ ПОЛОВИНА,
Dialogue: 0,0:04:51.10,0:04:52.70,Caption,,0,0,0,,А КАЛЛАС ОСТАЛОСЬ ТОЛЬКО РЕШИТЬ,
Dialogue: 0,0:04:52.91,0:04:55.50,Caption,,0,0,0,,С КАКОЙ СТОРОНЫ ПРИНИМАТЬ ПАРАД. НО РЕАЛЬНОСТЬ
Dialogue: 0,0:04:55.50,0:05:00.82,Caption,,0,0,0,,ПРОЩЕ. БЕЗОПАСНОСТЬ ЭТИХ ГОСУДАРСТВ ДЕРЖИТСЯ ПРЕЖДЕ ВСЕГО
Dialogue: 0,0:05:00.90,0:05:04.18,Caption,,0,0,0,,НА КОЛЛЕКТИВНОЙ СИСТЕМЕ НАТО, НА АМЕРИКАНСКИХ ГАРАНТИЯХ,
Dialogue: 0,0:05:04.42,0:05:07.62,Caption,,0,0,0,,НА СИЛАХ СОЮЗНИКОВ, НА ОБЩЕЙ ИНФРАСТРУКТУРЕ АЛЬЯНСА.
Dialogue: 0,0:05:08.18,0:05:10.58,Caption,,0,0,0,,ТО ЕСТЬ САМЫЕ МАЛЕНЬКИЕ ОПЯТЬ ОКАЗАЛИСЬ САМЫМИ
Dialogue: 0,0:05:10.58,0:05:15.46,Caption,,0,0,0,,ГРОМКИМИ. И ЭТО НЕ ОЗНАЧАЕТ, ЧТО ИХ МНЕНИЕ НЕ НАДО СЛУШАТЬ. НАДО. НО
Dialogue: 0,0:05:15.54,0:05:17.86,Caption,,0,0,0,,ЕСЛИ ТЫ ПРИХОДИШЬ ЗА СТОЛ, ГДЕ РЕШАЕТСЯ,
Dialogue: 0,0:05:18.02,0:05:20.74,Caption,,0,0,0,,КАК НЕ ДОВЕСТИ ОГРОМНЫЙ КОНТИНЕНТ ДО БОЛЬШОЙ БЕДЫ,
Dialogue: 0,0:05:21.14,0:05:24.02,Caption,,0,0,0,,ОДНОГО ГРОМКОГО ГОЛОСА МАЛО. НУЖЕН ОТВЕТ НА ПРОСТОЙ
Dialogue: 0,0:05:24.02,0:05:26.42,Caption,,0,0,0,,ВОПРОС. ЧТО ТЫ ПРЕДЛАГАЕШЬ ТАКОГО,
Dialogue: 0,0:05:26.66,0:05:28.74,Caption,,0,0,0,,ПОСЛЕ ЧЕГО СИТУАЦИЯ СТАНЕТ БЕЗОПАСНЕЕ?
Dialogue: 0,0:05:28.89,0:05:31.46,Caption,,0,0,0,,НЕ В СЛЕДУЮЩЕМ ЗАЯВЛЕНИИ. НЕ В СЛЕДУЮЩЕМ ПАКЕТЕ
Dialogue: 0,0:05:31.46,0:05:34.34,Caption,,0,0,0,,САНКЦИЙ. В РЕАЛЬНОСТИ. ПОТОМУ ЧТО СТРАННАЯ
Dialogue: 0,0:05:34.34,0:05:36.74,Caption,,0,0,0,,АРИФМЕТИКА ПОЛУЧАЕТСЯ. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:05:36.98,0:05:40.34,Caption,,0,0,0,,НАМ ГОВОРЯТ, ЧТО РАЗГОВОР С МОСКВОЙ НИЧЕГО НЕ ДАСТ. С
Dialogue: 0,0:05:40.34,0:05:43.06,Caption,,0,0,0,,ДРУГОЙ, ЧТО УСТУПАТЬ НЕЛЬЗЯ. С ТРЕТЬЕЙ,
Dialogue: 0,0:05:43.22,0:05:45.94,Caption,,0,0,0,,ЧТО ДАВЛЕНИЕ НАДО УСИЛИВАТЬ. С ЧЕТВЁРТОЙ,
Dialogue: 0,0:05:46.18,0:05:48.74,Caption,,0,0,0,,ЧТО НАСЕЛЕНИЮ ЕВРОПЫ НАДО ГОТОВИТЬСЯ К СЕРЬЁЗНЫМ
Dialogue: 0,0:05:48.74,0:05:51.30,Caption,,0,0,0,,КРИЗИСАМ И УМЕТЬ КАКОЕ ТО ВРЕМЯ ВЫЖИВАТЬ
Dialogue: 0,0:05:51.30,0:05:54.02,Caption,,0,0,0,,САМОСТОЯТЕЛЬНО. ЕВРОПЕЙЦАМ УЖЕ ОБЪЯСНЯЮТ,
Dialogue: 0,0:05:54.26,0:05:56.42,Caption,,0,0,0,,ЧТО ДОМА ЖЕЛАТЕЛЬНО ИМЕТЬ ЗАПАС ЕДЫ,
Dialogue: 0,0:05:56.66,0:05:59.86,Caption,,0,0,0,,ВОДЫ, ЛЕКАРСТВ, ФОНАРИ, РАДИО,
Dialogue: 0,0:06:00.02,0:06:02.50,Caption,,0,0,0,,НАЛИЧНЫЕ И ВСЁ НЕОБХОДИМОЕ ХОТЯ БЫ НА ТРОЕ
Dialogue: 0,0:06:02.58,0:06:05.38,Caption,,0,0,0,,СУТОК. И ЭТО САМО ПО СЕБЕ НОРМАЛЬНАЯ ГРАЖДАНСКАЯ
Dialogue: 0,0:06:05.38,0:06:08.26,Caption,,0,0,0,,ПОДГОТОВКА. ЛЮБАЯ СТРАНА ДОЛЖНА БЫТЬ ГОТОВА К
Dialogue: 0,0:06:08.26,0:06:12.18,Caption,,0,0,0,,АВАРИЯМ, ОТКЛЮЧЕНИЯМ, КИБЕРАТАКАМ И ДРУГИМ КРИЗИСАМ.
Dialogue: 0,0:06:14.46,0:06:16.86,Caption,,0,0,0,,НО ПОСТАВЬТЕ ЭТО РЯДОМ С ПОЛИТИЧЕСКОЙ РИТОРИКОЙ.
Dialogue: 0,0:06:17.17,0:06:20.62,Caption,,0,0,0,,ПЕРЕГОВОРЫ НЕ НУЖНЫ. ДАВЛЕНИЕ УСИЛИВАЕМ. САНКЦИОННУЮ
Dialogue: 0,0:06:20.70,0:06:23.90,Caption,,0,0,0,,СИСТЕМУ ДЕЛАЕМ ПОСТОЯННОЙ. ОГРАНИЧЕНИЯ РАСШИРЯЕМ.
Dialogue: 0,0:06:24.14,0:06:26.70,Caption,,0,0,0,,НАСЕЛЕНИЕ УЧИМ ЖИТЬ НЕСКОЛЬКО СУТОК БЕЗ НОРМАЛЬНОЙ
Dialogue: 0,0:06:26.70,0:06:29.26,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ. МУЖИКИ, А КУДА ЕДЕМ ТО?
Dialogue: 0,0:06:29.50,0:06:33.10,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ПОТОМУ ЧТО ДАЛЬШЕ ВОПРОС
Dialogue: 0,0:06:33.18,0:06:35.66,Caption,,0,0,0,,УЖЕ НЕ В ОТДЕЛЬНЫХ ЗАЯВЛЕНИЯХ КАЛЛАС ИЛИ МИХАЛА.
Dialogue: 0,0:06:36.06,0:06:39.90,Caption,,0,0,0,,ВОПРОС В ТОМ, КАКОЙ КОНЕЧНЫЙ ПУНКТ ВООБЩЕ ЗАЛОЖЕН В ЭТУ ПОЛИТИКУ.
Dialogue: 0,0:06:40.33,0:06:43.10,Caption,,0,0,0,,ФИНЛЯНДИЯ ТЕМ ВРЕМЕНЕМ ГОТОВИТ НОВЫЕ ОГРАНИЧЕНИЯ НА
Dialogue: 0,0:06:43.18,0:06:45.90,Caption,,0,0,0,,ВЪЕЗД РОССИЯН. ПОД ОГРАНИЧЕНИЯ МОГУТ ПОПАСТЬ И
Dialogue: 0,0:06:45.90,0:06:48.46,Caption,,0,0,0,,ПРОФЕССИОНАЛЬНЫЕ СПОРТСМЕНЫ. ТО ЕСТЬ В БОЛЬШОЙ
Dialogue: 0,0:06:48.46,0:06:51.50,Caption,,0,0,0,,ЕВРОПЕЙСКОЙ СИСТЕМЕ БЕЗОПАСНОСТИ НАШЛОСЬ МЕСТО ДАЖЕ
Dialogue: 0,0:06:51.58,0:06:55.58,Caption,,0,0,0,,ДЛЯ ХОККЕИСТА. ОЧЕНЬ СЕРЬЁЗНАЯ ГЕОПОЛИТИКА. РОССИЯ,
Dialogue: 0,0:06:55.65,0:06:58.94,Caption,,0,0,0,,НАТО, УКРАИНА, СТРАТЕГИЧЕСКАЯ СТАБИЛЬНОСТЬ,
Dialogue: 0,0:06:59.02,0:07:02.38,Caption,,0,0,0,,РАКЕТЫ, АРМИИ. И ГДЕ ТО ПОСЕРЕДИНЕ СТОИТ ЧЕЛОВЕК С
Dialogue: 0,0:07:02.38,0:07:04.78,Caption,,0,0,0,,КЛЮШКОЙ. ОН ТОЖЕ, ОКАЗЫВАЕТСЯ,
Dialogue: 0,0:07:04.86,0:07:08.70,Caption,,0,0,0,,ЭЛЕМЕНТ ДАВЛЕНИЯ. ЛАДНО, ЗАПРЕТИЛИ СПОРТСМЕНА. ДАЛЬШЕ ЧТО?
Dialogue: 0,0:07:09.16,0:07:12.06,Caption,,0,0,0,,И ЗДЕСЬ ПОЯВЛЯЕТСЯ ПОЛЬША. РАДОСЛАВ СИКОРСКИЙ
Dialogue: 0,0:07:12.06,0:07:14.54,Caption,,0,0,0,,ПРИЗЫВАЕТ ПРЕЗИДЕНТА КАРОЛЯ НАВРОЦКОГО ИСПОЛЬЗОВАТЬ
Dialogue: 0,0:07:14.54,0:07:17.50,Caption,,0,0,0,,СВОИ ОТНОШЕНИЯ С ТРАМПОМ И ВЛИЯТЬ НА АМЕРИКАНСКУЮ
Dialogue: 0,0:07:17.58,0:07:20.70,Caption,,0,0,0,,ЛИНИЮ В ПОЛЬЗУ УКРАИНЫ. НИЧЕГО НЕОЖИДАННОГО ТУТ НЕТ.
Dialogue: 0,0:07:20.86,0:07:23.58,Caption,,0,0,0,,СИКОРСКИЙ ПРЕДСТАВЛЯЕТ ПРАВИТЕЛЬСТВО ДОНАЛЬДА ТУСКА
Dialogue: 0,0:07:23.72,0:07:26.30,Caption,,0,0,0,,И ЖЁСТКО ПРИДЕРЖИВАЕТСЯ НЫНЕШНЕЙ ПРОЕВРОПЕЙСКОЙ
Dialogue: 0,0:07:26.38,0:07:31.77,Caption,,0,0,0,,ЛИНИИ ВАРШАВЫ. ТО ЕСТЬ ПОЛЬСКОЕ ПРАВИТЕЛЬСТВО НЕ РАЗВОРАЧИВАЕТСЯ
Dialogue: 0,0:07:31.77,0:07:34.57,Caption,,0,0,0,,ВСЛЕД ЗА ТРАМПОМ. ОНО ПЫТАЕТСЯ ВОЗДЕЙСТВОВАТЬ НА
Dialogue: 0,0:07:34.57,0:07:38.01,Caption,,0,0,0,,ТРАМПА, ЧТОБЫ ТОТ НЕ РАЗВОРАЧИВАЛ АМЕРИКАНСКУЮ ЛИНИЮ СЛИШКОМ
Dialogue: 0,0:07:38.01,0:07:40.65,Caption,,0,0,0,,ДАЛЕКО ОТ ЕВРОПЕЙСКОЙ. И СИКОРСКИЙ ОДНОВРЕМЕННО
Dialogue: 0,0:07:40.65,0:07:43.93,Caption,,0,0,0,,ГОВОРИТ ВАЖНУЮ ВЕЩЬ. БЕЗ ВОСТОЧНОЙ ЕВРОПЫ ОБСУЖДАТЬ
Dialogue: 0,0:07:43.93,0:07:46.89,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ БЕЗОПАСНОСТЬ НЕЛЬЗЯ. ОПЯТЬ ПРАВИЛЬНО.
Dialogue: 0,0:07:47.13,0:07:49.45,Caption,,0,0,0,,ВСЕ ХОТЯТ БЫТЬ ЗА СТОЛОМ. ТОЛЬКО ЗАРАНЕЕ
Dialogue: 0,0:07:49.45,0:07:52.01,Caption,,0,0,0,,ДОГОВОРИТЬСЯ НИКТО НИ С КЕМ НЕ ХОЧЕТ. АМЕРИКА
Dialogue: 0,0:07:52.09,0:07:54.17,Caption,,0,0,0,,ПРЕДЛАГАЕТ ГОВОРИТЬ О ШИРОКОЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:07:54.49,0:07:56.65,Caption,,0,0,0,,ЕВРОПЕЙСКИЙ ЦЕНТР НЕ ХОЧЕТ ПЕРЕСМАТРИВАТЬ
Dialogue: 0,0:07:56.65,0:07:59.45,Caption,,0,0,0,,ДЕЙСТВУЮЩУЮ СИСТЕМУ. ПОЛЬША ТРЕБУЕТ УЧАСТИЯ
Dialogue: 0,0:07:59.53,0:08:02.17,Caption,,0,0,0,,ВОСТОЧНОЙ ЕВРОПЫ. ЭСТОНИЯ ВЫСТУПАЕТ ПРОТИВ
Dialogue: 0,0:08:02.17,0:08:06.25,Caption,,0,0,0,,ПОСРЕДНИЧЕСТВА, ЛИТВА НЕ ДОВЕРЯЕТ РОССИИ. УКРАИНА ОПАСАЕТСЯ,
Dialogue: 0,0:08:06.41,0:08:08.97,Caption,,0,0,0,,ЧТО НОВАЯ СДЕЛКА ПО БЕЗОПАСНОСТИ ОКАЖЕТСЯ ДЛЯ НЕЁ
Dialogue: 0,0:08:08.97,0:08:11.93,Caption,,0,0,0,,ОПАСНОЙ. И ВСЕ ВМЕСТЕ ТРЕБУЮТ МЕСТО ЗА ОДНИМ
Dialogue: 0,0:08:11.93,0:08:14.01,Caption,,0,0,0,,СТОЛОМ. Я СЕЙЧАС ДАЖЕ НЕ СПРАШИВАЮ,
Dialogue: 0,0:08:14.15,0:08:16.97,Caption,,0,0,0,,КТО ИЗ НИХ ПРАВ. Я СПРАШИВАЮ ПРОЩЕ. ЧТО
Dialogue: 0,0:08:17.05,0:08:18.65,Caption,,0,0,0,,ОНИ ТАМ СОБИРАЮТСЯ ПОДПИСЫВАТЬ?
Dialogue: 0,0:08:18.97,0:08:21.05,Caption,,0,0,0,,ПОТОМУ ЧТО ПЕРЕГОВОРЫ НУЖНЫ НЕ ДЛЯ ТОГО,
Dialogue: 0,0:08:21.21,0:08:23.45,Caption,,0,0,0,,ЧТОБЫ КАЖДЫЙ ПРИНЁС ПАПКУ СО СВОИМИ КРАСНЫМИ
Dialogue: 0,0:08:23.45,0:08:26.65,Caption,,0,0,0,,ЛИНИЯМИ, ПОЛОЖИЛ ЕЁ ПЕРЕД СОБОЙ И ТРИ ЧАСА ОБЪЯСНЯЛ
Dialogue: 0,0:08:26.73,0:08:30.49,Caption,,0,0,0,,ОСТАЛЬНЫМ, ПОЧЕМУ ДВИГАТЬ ПАПКУ НЕЛЬЗЯ. ПЕРЕГОВОРЫ НАЧИНАЮТСЯ
Dialogue: 0,0:08:30.57,0:08:34.57,Caption,,0,0,0,,ТАМ, ГДЕ ПОЯВЛЯЕТСЯ ПРЕДМЕТ ОБМЕНА. КТО ЧТО ОГРАНИЧИВАЕТ.
Dialogue: 0,0:08:34.83,0:08:37.77,Caption,,0,0,0,,КТО ЧТО ГАРАНТИРУЕТ. ГДЕ ПРОХОДИТ ВОЕННАЯ
Dialogue: 0,0:08:37.77,0:08:40.65,Caption,,0,0,0,,ИНФРАСТРУКТУРА. КАКИЕ ВООРУЖЕНИЯ РАЗМЕЩАЮТСЯ.
Dialogue: 0,0:08:42.93,0:08:45.82,Caption,,0,0,0,,КАК КОНТРОЛИРУЕТСЯ СОБЛЮДЕНИЕ ДОГОВОРЁННОСТЕЙ. ЧТО
Dialogue: 0,0:08:45.82,0:08:49.34,Caption,,0,0,0,,ПРОИСХОДИТ ПРИ НАРУШЕНИИ. КТО ЯВЛЯЕТСЯ ГАРАНТОМ. ВОТ
Dialogue: 0,0:08:49.42,0:08:51.90,Caption,,0,0,0,,ЭТО УЖЕ РАЗГОВОР. И ИМЕННО ПОЭТОМУ ВОПРОС
Dialogue: 0,0:08:51.90,0:08:54.14,Caption,,0,0,0,,БЕЗОПАСНОСТИ ГОРАЗДО ШИРЕ ДОНБАССА,
Dialogue: 0,0:08:54.22,0:08:57.26,Caption,,0,0,0,,УКРАИНЫ И ЛИНИИ ФРОНТА. ЕСЛИ ПРОСТО ОСТАНОВИТЬ
Dialogue: 0,0:08:57.26,0:09:01.26,Caption,,0,0,0,,СТРЕЛЬБУ, РОССИЯ НИКУДА НЕ ИСЧЕЗНЕТ. НАТО НИКУДА НЕ ИСЧЕЗНЕТ.
Dialogue: 0,0:09:01.43,0:09:06.54,Caption,,0,0,0,,ПОЛЬША, ЭСТОНИЯ, ЛИТВА НИКУДА НЕ ИСЧЕЗНУТ. УКРАИНА ТОЖЕ. СОСЕДИ
Dialogue: 0,0:09:06.54,0:09:11.34,Caption,,0,0,0,,ОСТАНУТСЯ СОСЕДЯМИ. А ЗНАЧИТ, ЛИБО ОНИ КОГДА НИБУДЬ ДОГОВАРИВАЮТСЯ О ПРАВИЛАХ,
Dialogue: 0,0:09:11.58,0:09:13.26,Caption,,0,0,0,,ЛИБО ПРОДОЛЖАЮТ ЖИТЬ В СИСТЕМЕ,
Dialogue: 0,0:09:13.50,0:09:16.14,Caption,,0,0,0,,ГДЕ КАЖДЫЙ СТРОИТ СВОЮ БЕЗОПАСНОСТЬ ПРОТИВ ДРУГОГО.
Dialogue: 0,0:09:16.78,0:09:19.50,Caption,,0,0,0,,НО БЕЗОПАСНОСТЬ ОДНОГО СОСЕДА НЕВОЗМОЖНО БЕСКОНЕЧНО
Dialogue: 0,0:09:19.50,0:09:22.22,Caption,,0,0,0,,СТРОИТЬ ЗА СЧЁТ ОЩУЩЕНИЯ НЕБЕЗОПАСНОСТИ ДРУГОГО.
Dialogue: 0,0:09:22.54,0:09:25.42,Caption,,0,0,0,,ИНАЧЕ НАЧИНАЕТСЯ СОВЕРШЕННО ПРЕДСКАЗУЕМАЯ ЦЕПОЧКА.
Dialogue: 0,0:09:25.86,0:09:30.38,Caption,,0,0,0,,ТЫ УСИЛИЛ АРМИЮ У ГРАНИЦЫ, ПОТОМУ ЧТО БОИШЬСЯ МЕНЯ. Я УСИЛИЛ АРМИЮ У
Dialogue: 0,0:09:30.38,0:09:33.82,Caption,,0,0,0,,ГРАНИЦЫ, ПОТОМУ ЧТО УВИДЕЛ ТВОЮ. ТЫ УВИДЕЛ МОЮ И
Dialogue: 0,0:09:33.82,0:09:37.26,Caption,,0,0,0,,РЕШИЛ, ЧТО БЫЛ ПРАВ. Я УВИДЕЛ ТВОЮ РЕАКЦИЮ И
Dialogue: 0,0:09:37.26,0:09:41.34,Caption,,0,0,0,,ТОЖЕ РЕШИЛ, ЧТО БЫЛ ПРАВ. ОЧЕНЬ УДОБНАЯ СИСТЕМА. ВСЕ ПРАВЫ.
Dialogue: 0,0:09:41.68,0:09:45.50,Caption,,0,0,0,,ТОЛЬКО РАКЕТ ВСЁ БОЛЬШЕ. ИМЕННО ПОЭТОМУ РАЗГОВОР О НОВОЙ АРХИТЕКТУРЕ
Dialogue: 0,0:09:45.50,0:09:48.14,Caption,,0,0,0,,БЕЗОПАСНОСТИ САМ ПО СЕБЕ НЕ ЯВЛЯЕТСЯ ПОДАРКОМ
Dialogue: 0,0:09:48.14,0:09:50.86,Caption,,0,0,0,,МОСКВЕ. ЭТО ПОПЫТКА ОПРЕДЕЛИТЬ ПРАВИЛА ТАМ,
Dialogue: 0,0:09:51.10,0:09:53.74,Caption,,0,0,0,,ГДЕ СТАРЫЕ ПРАВИЛА ЯВНО НЕ СМОГЛИ ПРЕДОТВРАТИТЬ
Dialogue: 0,0:09:53.74,0:09:56.38,Caption,,0,0,0,,НЫНЕШНИЙ КРИЗИС. А СОГЛАШАТЬСЯ НА АМЕРИКАНСКИЙ
Dialogue: 0,0:09:56.38,0:09:58.22,Caption,,0,0,0,,ВАРИАНТ ЕВРОПА ВООБЩЕ НЕ ОБЯЗАНА.
Dialogue: 0,0:10:00.49,0:10:04.49,Caption,,0,0,0,,НЕ НРАВИТСЯ, ПРЕДЛАГАЙТЕ СВОЙ. ВОТ ТОЛЬКО ОН ДОЛЖЕН СОСТОЯТЬ НЕ
Dialogue: 0,0:10:04.57,0:10:07.29,Caption,,0,0,0,,ИЗ СЛОВ "ЕЩЁ СИЛЬНЕЕ НАДАВИТЬ". ДАВЛЕНИЕ,
Dialogue: 0,0:10:07.38,0:10:10.89,Caption,,0,0,0,,САНКЦИИ, ОГРАНИЧЕНИЯ И ВОЕННОЕ СДЕРЖИВАНИЕ НЕ ЦЕЛЬ,
Dialogue: 0,0:10:11.13,0:10:14.09,Caption,,0,0,0,,А ИНСТРУМЕНТЫ. У ИНСТРУМЕНТОВ ДОЛЖЕН БЫТЬ РЕЗУЛЬТАТ.
Dialogue: 0,0:10:14.49,0:10:16.73,Caption,,0,0,0,,ВОТ ЗДЕСЬ И ХОЧЕТСЯ СПРОСИТЬ ВСЕХ СТОРОННИКОВ
Dialogue: 0,0:10:16.73,0:10:20.09,Caption,,0,0,0,,НЫНЕШНЕЙ ЖЁСТКОЙ ЛИНИИ КАКОЙ? РОССИЯ КАПИТУЛИРУЕТ?
Dialogue: 0,0:10:20.25,0:10:23.61,Caption,,0,0,0,,МЕНЯЕТ РУКОВОДСТВО? ОТКАЗЫВАЕТСЯ ОТ ТРЕБОВАНИЙ БЕЗОПАСНОСТИ?
Dialogue: 0,0:10:23.93,0:10:26.09,Caption,,0,0,0,,ПОЛНОСТЬЮ ВЫХОДИТ ИЗ КОНФЛИКТА НА ЕВРОПЕЙСКИХ
Dialogue: 0,0:10:26.09,0:10:28.49,Caption,,0,0,0,,УСЛОВИЯХ? И ЕСЛИ ЭТОГО НЕ ПРОИСХОДИТ,
Dialogue: 0,0:10:28.80,0:10:31.45,Caption,,0,0,0,,ЧТО ДЕЛАЕМ ЕЩЁ ЧЕРЕЗ ГОД? ЕЩЁ САНКЦИИ,
Dialogue: 0,0:10:31.54,0:10:35.85,Caption,,0,0,0,,ОРУЖИЕ, ОГРАНИЧЕНИЯ? ЕЩЁ ОДИН ПОСТОЯННЫЙ ОФИС РЯДОМ С ПЕРВЫМ?
Dialogue: 0,0:10:36.17,0:10:38.09,Caption,,0,0,0,,В КАКОЙ ТОЧКЕ КТО ТО СКАЖЕТ ВСЁ,
Dialogue: 0,0:10:38.33,0:10:41.37,Caption,,0,0,0,,ЦЕЛИ ДОСТИГНУТЫ? ПОТОМУ ЧТО ЕСЛИ ТАКОЙ ТОЧКИ НЕТ,
Dialogue: 0,0:10:41.61,0:10:44.17,Caption,,0,0,0,,ТО ЭТО УЖЕ НЕ СТРАТЕГИЯ ВЫХОДА. ЭТО ДОРОГА.
Dialogue: 0,0:10:44.49,0:10:48.33,Caption,,0,0,0,,ПРИЧЁМ ДОРОГА, НА КОТОРОЙ ВСЕ УЧАСТНИКИ ОДНОВРЕМЕННО УВЕЛИЧИВАЮТ
Dialogue: 0,0:10:48.33,0:10:52.25,Caption,,0,0,0,,СТАВКИ. И ВОТ ТУТ ШУТКИ ПОСТЕПЕННО ЗАКАНЧИВАЮТСЯ. Я
Dialogue: 0,0:10:52.25,0:10:54.97,Caption,,0,0,0,,ПРЕКРАСНО ПОНИМАЮ ПОЗИЦИЮ ГОСУДАРСТВ БАЛТИИ. ОНИ
Dialogue: 0,0:10:54.97,0:10:57.05,Caption,,0,0,0,,СМОТРЯТ НА РОССИЮ КАК НА УГРОЗУ СОБСТВЕННОЙ
Dialogue: 0,0:10:57.05,0:11:00.09,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ПОЛЬША СМОТРИТ НА РОССИЮ ЧЕРЕЗ СВОЮ
Dialogue: 0,0:11:00.17,0:11:02.73,Caption,,0,0,0,,ИСТОРИЮ. УКРАИНА НАХОДИТСЯ НЕПОСРЕДСТВЕННО В
Dialogue: 0,0:11:02.73,0:11:05.93,Caption,,0,0,0,,КОНФЛИКТЕ. У ВСЕХ СВОИ ПРИЧИНЫ. НО ИМЕННО ПОЭТОМУ
Dialogue: 0,0:11:06.01,0:11:09.29,Caption,,0,0,0,,И СУЩЕСТВУЕТ СТОЛ ПЕРЕГОВОРОВ. НЕ ДЛЯ ДРУЗЕЙ. ДРУЗЬЯ
Dialogue: 0,0:11:09.37,0:11:11.69,Caption,,0,0,0,,И БЕЗ НЕГО ДОГОВОРЯТСЯ. ЗА СТОЛ САДЯТСЯ КАК
Dialogue: 0,0:11:11.77,0:11:13.77,Caption,,0,0,0,,РАЗ ТЕ, КТО ДРУГ ДРУГУ НЕ ДОВЕРЯЕТ.
Dialogue: 0,0:11:16.04,0:11:18.84,Caption,,0,0,0,,И ЕСЛИ ГЛАВНЫЙ АРГУМЕНТ ПРОТИВ РАЗГОВОРА ЗВУЧИТ ТАК
Dialogue: 0,0:11:18.92,0:11:23.00,Caption,,0,0,0,,"МЫ ИМ НЕ ДОВЕРЯЕМ", ТОГДА ПЕРЕГОВОРЫ ЧЕЛОВЕЧЕСТВУ ВООБЩЕ МОЖНО ЗАКРЫВАТЬ
Dialogue: 0,0:11:23.08,0:11:25.80,Caption,,0,0,0,,КАК ЖАНР. ПОТОМУ ЧТО С ТЕМИ, КОМУ ДОВЕРЯЮТ,
Dialogue: 0,0:11:26.05,0:11:29.00,Caption,,0,0,0,,ДОГОВОР ОБЫЧНО НЕ САМАЯ БОЛЬШАЯ ПРОБЛЕМА. ЕВРОПА
Dialogue: 0,0:11:29.00,0:11:31.72,Caption,,0,0,0,,ВПРАВЕ ОТВЕРГНУТЬ АМЕРИКАНСКИЙ ВАРИАНТ. НО ТОГДА
Dialogue: 0,0:11:31.72,0:11:34.04,Caption,,0,0,0,,ПОКАЖИТЕ СВОЙ С КОНКРЕТНЫМИ УСЛОВИЯМИ,
Dialogue: 0,0:11:34.12,0:11:36.04,Caption,,0,0,0,,СПОСОБОМ ИХ ПРОВЕРИТЬ И ТОЧКОЙ,
Dialogue: 0,0:11:36.20,0:11:39.16,Caption,,0,0,0,,В КОТОРОЙ ДАВЛЕНИЕ ПРЕКРАЩАЕТСЯ. ВОТ И ВСЁ. СТОЛ
Dialogue: 0,0:11:39.24,0:11:42.36,Caption,,0,0,0,,УЖЕ СТОИТ. СТУЛЬЯ ТОЖЕ. ЖЕЛАЮЩИХ ОБЪЯСНИТЬ,
Dialogue: 0,0:11:42.51,0:11:47.64,Caption,,0,0,0,,ПОЧЕМУ САДИТЬСЯ НЕЛЬЗЯ, ХВАТАЕТ. ТЕПЕРЬ ОСТАЛОСЬ САМОЕ СЛОЖНОЕ. ОБЪЯСНИТЬ,
Dialogue: 0,0:11:47.88,0:11:49.80,Caption,,0,0,0,,ЧЕМ ВЫ СОБИРАЕТЕСЬ ЗАКОНЧИТЬ ПУТЬ,
Dialogue: 0,0:11:50.04,0:11:51.56,Caption,,0,0,0,,ЕСЛИ К СТОЛУ ТАК И НЕ СЯДЕТЕ?
