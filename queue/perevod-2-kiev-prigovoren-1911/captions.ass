Dialogue: 0,0:00:00.12,0:00:03.32,Caption,,0,0,0,,ВИТАЛИЙ КИМ ПОСМОТРЕЛ В ПОСЛЕВОЕННОЕ БУДУЩЕЕ УКРАИНЫ
Dialogue: 0,0:00:03.56,0:00:05.56,Caption,,0,0,0,,И УВИДЕЛ ТАМ НЕ ПРАЗДНИК ВОЗВРАЩЕНИЯ,
Dialogue: 0,0:00:05.74,0:00:09.80,Caption,,0,0,0,,А ПРЕСТУПНОСТЬ, НАПРЯЖЕНИЕ И РЕВОЛЮЦИИ. СТРАННАЯ ВСТРЕЧА С
Dialogue: 0,0:00:09.80,0:00:12.76,Caption,,0,0,0,,ПОБЕДИТЕЛЯМИ ПОЛУЧАЕТСЯ. ЧЕЛОВЕК ЕЩЁ НЕ УСПЕЛ СНЯТЬ
Dialogue: 0,0:00:12.76,0:00:14.84,Caption,,0,0,0,,ФОРМУ, А ЧИНОВНИК УЖЕ ПРОВЕРЯЕТ,
Dialogue: 0,0:00:14.95,0:00:18.04,Caption,,0,0,0,,КРЕПКО ЛИ ЗАПЕРТА ДВЕРЬ КАБИНЕТА. И ЧЕМ ВНИМАТЕЛЬНЕЕ
Dialogue: 0,0:00:18.04,0:00:22.44,Caption,,0,0,0,,СЛУШАЕШЬ КИМА, ТЕМ ЯСНЕЕ ВОПРОС ВЛАСТЬ ГОТОВИТСЯ ПОМОГАТЬ ВЕТЕРАНАМ
Dialogue: 0,0:00:22.68,0:00:27.16,Caption,,0,0,0,,ИЛИ СПАСАТЬСЯ ОТ ИХ ВОПРОСОВ? НЕ СЛУЧАЙНО РЯДОМ ВСЁ ГРОМЧЕ ЗВУЧИТ ТЕМА ЗАКРЫТЫХ
Dialogue: 0,0:00:27.16,0:00:32.41,Caption,,0,0,0,,ГРАНИЦ. ЕСЛИ ВАМ НРАВЯТСЯ РАЗБОРЫ БЕЗ ЦЕРЕМОНИАЛЬНЫХ
Dialogue: 0,0:00:32.41,0:00:39.08,Caption,,0,0,0,,ПОКЛОНОВ, ПОДПИШИТЕСЬ. С ДЕНЬГАМИ ВСЁ КОРОТКО И НЕВЕСЕЛО. МЕЖДУНАРОДНЫЙ
Dialogue: 0,0:00:39.08,0:00:41.64,Caption,,0,0,0,,ВАЛЮТНЫЙ ФОНД ПЕРЕСМОТРЕЛ ПРОГНОЗ ДЛЯ УКРАИНЫ.
Dialogue: 0,0:00:42.03,0:00:44.20,Caption,,0,0,0,,ВМЕСТО РОСТА НА ОДИН ПРОЦЕНТ В ДВЕ ТЫСЯЧИ
Dialogue: 0,0:00:44.20,0:00:47.32,Caption,,0,0,0,,ДВАДЦАТЬ ШЕСТОМ ГОДУ ОЖИДАЕТСЯ СНИЖЕНИЕ НА ПОЛОВИНУ
Dialogue: 0,0:00:47.32,0:00:50.60,Caption,,0,0,0,,ПРОЦЕНТА, А В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМ ГОДУ СНИЖЕНИЕ
Dialogue: 0,0:00:50.60,0:00:53.96,Caption,,0,0,0,,СОСТАВИТ ЕЩЁ ОДИН ПРОЦЕНТ. ПРИ ЭТОМ КИЕВУ ПРЕДЛАГАЮТ
Dialogue: 0,0:00:53.96,0:00:57.00,Caption,,0,0,0,,РАСШИРЯТЬ НАЛОГОВУЮ БАЗУ И УВЕЛИЧИВАТЬ СБОРЫ. ТО
Dialogue: 0,0:00:57.08,0:01:01.32,Caption,,0,0,0,,ЕСТЬ ПИРОГ СТАНОВИТСЯ МЕНЬШЕ, ЗАТО ЖЕЛАЮЩИХ ОТРЕЗАТЬ ОТ НЕГО БОЛЬШЕ.
Dialogue: 0,0:01:03.60,0:01:06.88,Caption,,0,0,0,,ЭНЕРГЕТИКА УСКОРЯЕТ ЭТОТ ПРОЦЕСС. НЬЮ ЙОРК ТАЙМС
Dialogue: 0,0:01:06.88,0:01:09.28,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ О КРАЙНЕЙ УЯЗВИМОСТИ ГОРОДОВ,
Dialogue: 0,0:01:09.51,0:01:12.24,Caption,,0,0,0,,А НАСЕЛЕНИЕ ГОТОВЯТ К НЕСКОЛЬКИМ ЧАСАМ ЭЛЕКТРИЧЕСТВА
Dialogue: 0,0:01:12.32,0:01:14.24,Caption,,0,0,0,,В СУТКИ. ПО СЛОВАМ КОРОЛЬЧУКА,
Dialogue: 0,0:01:14.56,0:01:16.64,Caption,,0,0,0,,ТАКОЙ РЕЖИМ МОЖЕТ ДЛИТЬСЯ НЕДЕЛЯМИ,
Dialogue: 0,0:01:16.84,0:01:21.44,Caption,,0,0,0,,ЗАДЕВАЯ ШКОЛЫ, БОЛЬНИЦЫ И ДЕТСКИЕ САДЫ. ТОЛЬКО ГЛАВНЫЙ УДАР БУДЕТ
Dialogue: 0,0:01:21.44,0:01:25.68,Caption,,0,0,0,,НЕ ПО РАСПИСАНИЮ СВЕТА, А ПО РАБОТЕ. ЕСЛИ ПРЕДПРИЯТИЕ ВСТАНЕТ,
Dialogue: 0,0:01:25.92,0:01:30.56,Caption,,0,0,0,,ЧЕЛОВЕКУ УЖЕ БЕЗ РАЗНИЦЫ, СКОЛЬКО ЧАСОВ ГОРЕЛА ЛАМПОЧКА. ЗАРПЛАТА ОТ ЕЁ СВЕТА
Dialogue: 0,0:01:30.64,0:01:36.52,Caption,,0,0,0,,НЕ ЗАВОДИТСЯ. И ПОСРЕДИ ЭТОЙ КАРТИНЫ КИМ ПРЕДЛАГАЕТ ЗАГЛЯНУТЬ В
Dialogue: 0,0:01:36.52,0:01:38.76,Caption,,0,0,0,,СТРАНУ ПОСЛЕ ЗАВЕРШЕНИЯ БОЕВЫХ ДЕЙСТВИЙ.
Dialogue: 0,0:01:41.03,0:01:43.51,Caption,,0,0,0,,ОН ОЖИДАЕТ ВОЗВРАЩЕНИЯ БОЛЕЕ ТРЁХ МИЛЛИОНОВ
Dialogue: 0,0:01:43.51,0:01:46.31,Caption,,0,0,0,,ВЕТЕРАНОВ. ЕСЛИ СЧИТАТЬ ВМЕСТЕ С СЕМЬЯМИ,
Dialogue: 0,0:01:46.48,0:01:49.51,Caption,,0,0,0,,ПОЛУЧИТСЯ ОКОЛО ДЕВЯТИ МИЛЛИОНОВ ЧЕЛОВЕК. ЭТО ПОЧТИ
Dialogue: 0,0:01:49.51,0:01:52.79,Caption,,0,0,0,,КАЖДЫЙ ТРЕТИЙ ЖИТЕЛЬ СТРАНЫ. ПОСАДИТЬ ТАКУЮ МАССУ
Dialogue: 0,0:01:52.87,0:01:57.43,Caption,,0,0,0,,ЛЮДЕЙ НА ПОСОБИЯ НЕВОЗМОЖНО, И ЗДЕСЬ КИМ ГОВОРИТ ЗДРАВУЮ ВЕЩЬ. БЮДЖЕТ НЕ
Dialogue: 0,0:01:57.43,0:02:01.11,Caption,,0,0,0,,БЕЗДОННЫЙ, ХОТЯ ЧИНОВНИКИ ИНОГДА НЫРЯЮТ ТУДА С ТАКИМ АЗАРТОМ,
Dialogue: 0,0:02:01.27,0:02:07.46,Caption,,0,0,0,,БУДТО ДНА ТОЧНО НЕТ. ДАЛЬШЕ СПОКОЙНЫЙ РАЗГОВОР ЗАКАНЧИВАЕТСЯ.
Dialogue: 0,0:02:09.66,0:02:13.50,Caption,,0,0,0,,НА ПРЯМОЙ ВОПРОС, ГОТОВА ЛИ УКРАИНА ПРИНЯТЬ МНОЖЕСТВО ВЕРНУВШИХСЯ
Dialogue: 0,0:02:13.50,0:02:16.30,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ, КИМ ОТВЕЧАЕТ ОТРИЦАТЕЛЬНО.
Dialogue: 0,0:02:18.57,0:02:21.05,Caption,,0,0,0,,А ЗАТЕМ В ЕГО РЕЧИ ПОЯВЛЯЮТСЯ ПРЕСТУПНОСТЬ,
Dialogue: 0,0:02:21.21,0:02:24.49,Caption,,0,0,0,,ОБЩЕСТВЕННОЕ НАПРЯЖЕНИЕ И РЕВОЛЮЦИИ. НЕ В КАЧЕСТВЕ
Dialogue: 0,0:02:24.49,0:02:29.13,Caption,,0,0,0,,ДАЛЁКОЙ СТРАШИЛКИ, А КАК ТО, ЧТО ОБЯЗАТЕЛЬНО ВОЗНИКНЕТ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:02:29.37,0:02:32.17,Caption,,0,0,0,,ЭКОНОМИКЕ ПРИДЁТСЯ ДАТЬ ВЕТЕРАНАМ РАБОТУ И ДОХОД,
Dialogue: 0,0:02:32.41,0:02:34.57,Caption,,0,0,0,,ЧТОБЫ ОНИ МОГЛИ ОБЕСПЕЧИВАТЬ СВОИ СЕМЬИ.
Dialogue: 0,0:02:36.85,0:02:39.42,Caption,,0,0,0,,НО ПОЧЕМУ ПРИ МЫСЛИ О ВОЗВРАЩЕНИИ СОБСТВЕННЫХ
Dialogue: 0,0:02:39.42,0:02:42.62,Caption,,0,0,0,,ВОЕННЫХ ЧИНОВНИК ПОЧТИ СРАЗУ ВСПОМИНАЕТ РЕВОЛЮЦИЮ?
Dialogue: 0,0:02:44.90,0:02:48.98,Caption,,0,0,0,,ДОМОЙ ПРИЕДУТ НЕ СОТРУДНИКИ, КОТОРЫХ НА НЕСКОЛЬКО ЛЕТ ОТПРАВЛЯЛИ ПРОВЕРЯТЬ
Dialogue: 0,0:02:49.06,0:02:53.82,Caption,,0,0,0,,ФИЛИАЛ. ТАК ВОЗНИКАЕТ ФРОНТОВОЕ БРАТСТВО.
Dialogue: 0,0:02:56.11,0:02:59.71,Caption,,0,0,0,,РАЗУМЕЕТСЯ, МИЛЛИОНЫ ВЕТЕРАНОВ НЕ ПРЕВРАТЯТСЯ ПО КОМАНДЕ В ОДНУ
Dialogue: 0,0:02:59.71,0:03:02.67,Caption,,0,0,0,,ОРГАНИЗАЦИЮ. НО У МНОГИХ УЖЕ СЛОЖИЛИСЬ ПРОЧНЫЕ
Dialogue: 0,0:03:02.67,0:03:07.23,Caption,,0,0,0,,СВЯЗИ, ЛИЧНОЕ ДОВЕРИЕ И ПРИВЫЧКА ДЕЙСТВОВАТЬ СООБЩА. ВНУТРИ
Dialogue: 0,0:03:07.23,0:03:11.15,Caption,,0,0,0,,ЭТИХ КРУГОВ ЕСТЬ СВОИ ЛИДЕРЫ, ЧЬЁ ВЛИЯНИЕ ЗАРАБОТАНО ПОД ОГНЁМ,
Dialogue: 0,0:03:11.31,0:03:14.51,Caption,,0,0,0,,А НЕ НАЗНАЧЕНО РАСПОРЯЖЕНИЕМ СВЕРХУ. ТАКОГО ЧЕЛОВЕКА
Dialogue: 0,0:03:14.51,0:03:16.83,Caption,,0,0,0,,НЕЛЬЗЯ СДЕЛАТЬ АВТОРИТЕТНЫМ НОВОЙ ТАБЛИЧКОЙ НА
Dialogue: 0,0:03:16.83,0:03:21.39,Caption,,0,0,0,,ДВЕРИ. ОН УЖЕ АВТОРИТЕТНЫЙ, И ИМЕННО ЭТО МОЖЕТ ОСОБЕННО РАЗДРАЖАТЬ ВЛАДЕЛЬЦЕВ
Dialogue: 0,0:03:21.39,0:03:26.61,Caption,,0,0,0,,ТАБЛИЧЕК. ПОВОДЫ ДЛЯ ТЯЖЁЛОГО РАЗГОВОРА С ВЛАСТЬЮ ДАВНО
Dialogue: 0,0:03:26.69,0:03:29.41,Caption,,0,0,0,,СОБРАНЫ. ПЯТЬ ЛЕТ ВОЕННЫЕ ВИДЕЛИ УЛИЧНУЮ
Dialogue: 0,0:03:29.41,0:03:31.81,Caption,,0,0,0,,МОБИЛИЗАЦИЮ, ПРОВАЛЫ СНАБЖЕНИЯ,
Dialogue: 0,0:03:31.89,0:03:34.37,Caption,,0,0,0,,КОРРУПЦИОННЫЕ ДЕЛА И ОГРОМНЫЕ СУММЫ,
Dialogue: 0,0:03:34.46,0:03:37.41,Caption,,0,0,0,,ПРОХОДИВШИЕ ЧЕРЕЗ ГОСУДАРСТВО. ОНИ СЛИШКОМ ХОРОШО
Dialogue: 0,0:03:37.41,0:03:40.37,Caption,,0,0,0,,ЗНАЮТ РАЗНИЦУ МЕЖДУ ОКОПОМ И КАБИНЕТОМ. ПОЭТОМУ
Dialogue: 0,0:03:40.37,0:03:43.81,Caption,,0,0,0,,КАРТИНКА, ГДЕ ДЕМОБИЛИЗОВАННЫЕ С УЛЫБКОЙ НАДЕВАЮТ КАСКИ
Dialogue: 0,0:03:43.81,0:03:46.29,Caption,,0,0,0,,СТРОИТЕЛЕЙ, ГОДИТСЯ РАЗВЕ ЧТО ДЛЯ ПЛАКАТА.
Dialogue: 0,0:03:48.56,0:03:50.56,Caption,,0,0,0,,МНОГИЕ ДЕЙСТВИТЕЛЬНО ВЕРНУТСЯ В СЕМЬИ,
Dialogue: 0,0:03:50.78,0:03:53.84,Caption,,0,0,0,,НАЙДУТ РАБОТУ ИЛИ ЗАЙМУТСЯ СВОИМ ДЕЛОМ. НО САМ
Dialogue: 0,0:03:53.84,0:03:56.96,Caption,,0,0,0,,КИМ ЗАГОВОРИЛ НЕ ТОЛЬКО О ЗАНЯТОСТИ. ОН ПОСТАВИЛ
Dialogue: 0,0:03:57.04,0:04:02.32,Caption,,0,0,0,,РЯДОМ ВЕТЕРАНОВ, НАПРЯЖЕНИЕ, ПРЕСТУПНОСТЬ И РЕВОЛЮЦИИ. ТАКИЕ СЛОВА СЛУЧАЙНО ИЗ
Dialogue: 0,0:04:02.40,0:04:08.36,Caption,,0,0,0,,КАРМАНА НЕ ВЫПАДАЮТ. ДЛЯ ЧИНОВНИКОВ УГРОЗА МОЖЕТ ЗАКЛЮЧАТЬСЯ ВОВСЕ НЕ В
Dialogue: 0,0:04:08.36,0:04:11.16,Caption,,0,0,0,,РАЗМЕРЕ ВЕТЕРАНСКИХ ВЫПЛАТ. НАМНОГО СТРАШНЕЕ
Dialogue: 0,0:04:11.16,0:04:13.48,Caption,,0,0,0,,ВСТРЕТИТЬСЯ С ЛЮДЬМИ, КОТОРЫЕ ЗНАЮТ,
Dialogue: 0,0:04:13.56,0:04:15.80,Caption,,0,0,0,,КОМУ И КАКИЕ ВОПРОСЫ ХОТЯТ ЗАДАТЬ.
Dialogue: 0,0:04:18.08,0:04:21.12,Caption,,0,0,0,,ЗДЕСЬ ПОСОБИЯМИ УЖЕ НЕ ОТДЕЛАЕШЬСЯ. НА СТОЛ КЛАДУТ
Dialogue: 0,0:04:21.12,0:04:23.52,Caption,,0,0,0,,СЧЁТ, КОТОРЫЙ ДОЛГО ПРЯТАЛИ ПОД ПАПКОЙ.
Dialogue: 0,0:04:25.78,0:04:29.62,Caption,,0,0,0,,ПОЧЕМУ НЕ ХВАТАЛО СНАБЖЕНИЯ? ГДЕ РАСТВОРИЛИСЬ ОГРОМНЫЕ СУММЫ?
Dialogue: 0,0:04:29.92,0:04:32.82,Caption,,0,0,0,,КТО РУКОВОДИЛ МОБИЛИЗАЦИЕЙ? КАК ПОЛУЧИЛОСЬ,
Dialogue: 0,0:04:32.98,0:04:35.62,Caption,,0,0,0,,ЧТО ОДИН НЕСКОЛЬКО ЛЕТ НЕ ВЫЛЕЗАЛ ИЗ ОПАСНОСТИ,
Dialogue: 0,0:04:35.86,0:04:37.94,Caption,,0,0,0,,А ДРУГОЙ ЗА ТОТ ЖЕ СРОК ЗАМЕТНО УЛУЧШИЛ
Dialogue: 0,0:04:37.94,0:04:41.62,Caption,,0,0,0,,ЖИЛИЩНЫЕ УСЛОВИЯ? КТО ЗАРАБАТЫВАЛ НА ГОСУДАРСТВЕННЫХ ПОТОКАХ?
Dialogue: 0,0:04:41.91,0:04:44.10,Caption,,0,0,0,,И КТО РИСКНЁТ ОТВЕЧАТЬ НА ВСЁ ЭТО ЛИЧНО,
Dialogue: 0,0:04:44.34,0:04:47.14,Caption,,0,0,0,,БЕЗ СУФЛЁРА И СПАСИТЕЛЬНОГО ТЕЛЕВИЗИОННОГО МОНТАЖА?
Dialogue: 0,0:04:49.43,0:04:52.07,Caption,,0,0,0,,ПОСЛЕ ТАКИХ ВОПРОСОВ МИРНАЯ ЖИЗНЬ ПЕРЕСТАЁТ
Dialogue: 0,0:04:52.07,0:04:57.94,Caption,,0,0,0,,ВЫГЛЯДЕТЬ ТИХОЙ. ОБЫЧНЫЙ РАССЕРЖЕННЫЙ ГРАЖДАНИН И ВЕТЕРАН С
Dialogue: 0,0:04:57.94,0:05:00.82,Caption,,0,0,0,,МНОГОЛЕТНИМ ОПЫТОМ РЕАГИРУЮТ НА ДАВЛЕНИЕ ПО РАЗНОМУ.
Dialogue: 0,0:05:01.14,0:05:03.54,Caption,,0,0,0,,ПОЛИЦЕЙСКОГО МОЖНО ПОДГОТОВИТЬ НА СТРЕЛЬБИЩЕ,
Dialogue: 0,0:05:03.78,0:05:05.86,Caption,,0,0,0,,НО СТРЕЛЬБИЩЕ НЕ ЗАМЕНИТ ГОДЫ ФРОНТА,
Dialogue: 0,0:05:06.19,0:05:08.58,Caption,,0,0,0,,ГДЕ ЛЮДИ УЧИЛИСЬ ДЕЙСТВОВАТЬ ВМЕСТЕ И ПРИНИМАТЬ
Dialogue: 0,0:05:08.58,0:05:12.10,Caption,,0,0,0,,РЕШЕНИЯ ЦЕНОЙ СОБСТВЕННОЙ ЖИЗНИ. ВЕТЕРАНЫ НЕ ОБЯЗАНЫ
Dialogue: 0,0:05:12.18,0:05:16.42,Caption,,0,0,0,,СТАТЬ ЕДИНЫМ ДВИЖЕНИЕМ, ОДНАКО СЧИТАТЬ ИХ БЕСПОМОЩНОЙ И ЛЕГКО УПРАВЛЯЕМОЙ
Dialogue: 0,0:05:16.42,0:05:20.02,Caption,,0,0,0,,МАССОЙ БУДЕТ РОСКОШНОЙ ГЛУПОСТЬЮ. А РОСКОШИ У КИЕВА,
Dialogue: 0,0:05:20.18,0:05:22.82,Caption,,0,0,0,,СУДЯ ПО ПРОГНОЗУ МЕЖДУНАРОДНОГО ВАЛЮТНОГО ФОНДА,
Dialogue: 0,0:05:23.04,0:05:27.58,Caption,,0,0,0,,И БЕЗ ТОГО ОСТАЛОСЬ НЕМНОГО. ПОДПИШИТЕСЬ,
Dialogue: 0,0:05:27.66,0:05:30.62,Caption,,0,0,0,,ЕСЛИ ХОТИТЕ ВИДЕТЬ ПРОДОЛЖЕНИЕ ЭТОГО РАЗГОВОРА. И
Dialogue: 0,0:05:30.70,0:05:35.10,Caption,,0,0,0,,НАПИШИТЕ В КОММЕНТАРИЯХ, ЧЕГО ВЛАСТЬ ОПАСАЕТСЯ СИЛЬНЕЕ РАСХОДОВ НА ВЕТЕРАНОВ
Dialogue: 0,0:05:35.42,0:05:37.34,Caption,,0,0,0,,ИЛИ ИХ ТРЕБОВАНИЙ НАЗВАТЬ ВИНОВНЫХ.
Dialogue: 0,0:05:39.53,0:05:42.33,Caption,,0,0,0,,ВЕТЕРАНСКИЕ СООБЩЕСТВА СПОСОБНЫ ВОЙТИ В ОБЩЕСТВЕННУЮ
Dialogue: 0,0:05:42.41,0:05:45.37,Caption,,0,0,0,,ЖИЗНЬ КАК САМОСТОЯТЕЛЬНАЯ СИЛА. ИХ БУДЕТ ТРУДНО
Dialogue: 0,0:05:45.37,0:05:47.29,Caption,,0,0,0,,РАСПРЕДЕЛИТЬ ПО ПРИВЫЧНЫМ ПАРТИЯМ,
Dialogue: 0,0:05:47.51,0:05:50.09,Caption,,0,0,0,,ПОСАДИТЬ ПО ЗАРАНЕЕ ПРИГОТОВЛЕННЫМ КРЕСЛАМ И
Dialogue: 0,0:05:50.09,0:05:52.73,Caption,,0,0,0,,ЗАСТАВИТЬ ГОЛОСОВАТЬ ПО КОМАНДЕ. У НИХ МОЖЕТ
Dialogue: 0,0:05:52.81,0:05:54.49,Caption,,0,0,0,,ПОЯВИТЬСЯ СОБСТВЕННАЯ ПОВЕСТКА,
Dialogue: 0,0:05:54.65,0:05:59.05,Caption,,0,0,0,,СВОИ ТРЕБОВАНИЯ И ЛИДЕРЫ, КОТОРЫМ НЕ ТРЕБУЕТСЯ РАЗРЕШЕНИЕ АДМИНИСТРАЦИИ.
Dialogue: 0,0:06:01.31,0:06:03.32,Caption,,0,0,0,,ПОКА ПРОДОЛЖАЮТСЯ БОЕВЫЕ ДЕЙСТВИЯ,
Dialogue: 0,0:06:03.71,0:06:05.96,Caption,,0,0,0,,ВЛАСТЬ ОБЪЯСНЯЕТ ВОЙНОЙ НЕХВАТКУ ДЕНЕГ,
Dialogue: 0,0:06:06.12,0:06:10.68,Caption,,0,0,0,,СПАД ЭКОНОМИКИ, ОГРАНИЧЕНИЯ И НЕРЕШЁННЫЕ СТАРЫЕ ПРОБЛЕМЫ. ЭТА
Dialogue: 0,0:06:10.68,0:06:12.60,Caption,,0,0,0,,ОТГОВОРКА ДОЛЖНА НАКРЫТЬ ВСЁ РАЗОМ,
Dialogue: 0,0:06:12.75,0:06:16.28,Caption,,0,0,0,,СЛОВНО КРЫШКА ОТ КАСТРЮЛИ, КОТОРОЙ ПЫТАЮТСЯ ОСТАНОВИТЬ ПОЖАР.
Dialogue: 0,0:06:18.56,0:06:20.88,Caption,,0,0,0,,НО ОДНАЖДЫ ЭТОТ ОТВЕТ ПЕРЕСТАНЕТ РАБОТАТЬ.
Dialogue: 0,0:06:23.15,0:06:27.55,Caption,,0,0,0,,В КАБИНЕТ ВОЙДЁТ ЧЕЛОВЕК, КОТОРЫЙ ПРОВЁЛ НА ФРОНТЕ НЕСКОЛЬКО ЛЕТ ПО ПРИКАЗУ
Dialogue: 0,0:06:27.63,0:06:33.92,Caption,,0,0,0,,ТОГО САМОГО ГОСУДАРСТВА. ПРОСИТЬ ЕГО ЕЩЁ НЕМНОГО ПОТЕРПЕТЬ БУДЕТ ЗНАЧИТЕЛЬНО
Dialogue: 0,0:06:33.92,0:06:36.40,Caption,,0,0,0,,СЛОЖНЕЕ, ОСОБЕННО ЕСЛИ РАБОТЫ НЕТ,
Dialogue: 0,0:06:36.72,0:06:38.88,Caption,,0,0,0,,ЖИЛЬЁ РАЗРУШЕНО, ЦЕНЫ ВЫРОСЛИ,
Dialogue: 0,0:06:39.19,0:06:43.28,Caption,,0,0,0,,А НАПРОТИВ СИДИТ ЧИНОВНИК, ВСЕ ЭТИ ГОДЫ ЖИВШИЙ СОВСЕМ ДРУГОЙ ЖИЗНЬЮ.
Dialogue: 0,0:06:45.57,0:06:48.69,Caption,,0,0,0,,ПОЭТОМУ СЛОВА КИМА СТОИТ РАССМАТРИВАТЬ ШИРЕ ОБЫЧНОЙ
Dialogue: 0,0:06:48.69,0:06:54.65,Caption,,0,0,0,,ПРОГРАММЫ ТРУДОУСТРОЙСТВА. ОН ТРЕБУЕТ ЗАРАНЕЕ ГОТОВИТЬСЯ К ВОЗВРАЩЕНИЮ
Dialogue: 0,0:06:54.65,0:06:56.81,Caption,,0,0,0,,ВЕТЕРАНОВ. НО ЧАСТЬ УПРАВЛЕНЦЕВ,
Dialogue: 0,0:06:56.89,0:07:00.97,Caption,,0,0,0,,ВЕРОЯТНО, ЗАНЯТА ДРУГИМ РАСЧЁТОМ. НЕ КАК ОБЕСПЕЧИТЬ ЭТИМ ЛЮДЯМ
Dialogue: 0,0:07:01.05,0:07:04.41,Caption,,0,0,0,,ДОСТОЙНУЮ ЖИЗНЬ, А КАК СОХРАНИТЬ СОБСТВЕННЫЕ ДОЛЖНОСТИ,
Dialogue: 0,0:07:04.54,0:07:08.89,Caption,,0,0,0,,ИМУЩЕСТВО И ПОКОЙ, КОГДА ФРОНТОВИКИ ПРИДУТ ДОМОЙ СО СТАРЫМИ ВОПРОСАМИ.
Dialogue: 0,0:07:11.17,0:07:13.73,Caption,,0,0,0,,КИМ ЭТОГО ВЫВОДА НЕ ПРОИЗНОСИТ. ЗАТО ЕГО
Dialogue: 0,0:07:13.73,0:07:16.53,Caption,,0,0,0,,ПРЕДУПРЕЖДЕНИЕ О РЕВОЛЮЦИЯХ ПОДВОДИТ К НЕМУ ПОЧТИ ЗА
Dialogue: 0,0:07:16.53,0:07:19.25,Caption,,0,0,0,,РУКУ. ЕСЛИ ЧИНОВНИК ПЕРВЫМ ДЕЛОМ ЖДЁТ НЕ
Dialogue: 0,0:07:19.25,0:07:22.13,Caption,,0,0,0,,БЛАГОДАРНОСТИ, А ПОТРЯСЕНИЙ, ЗНАЧИТ,
Dialogue: 0,0:07:22.23,0:07:24.77,Caption,,0,0,0,,ОН ПОНИМАЕТ ЦЕНУ НАКОПИВШЕГОСЯ НЕДОВЕРИЯ.
Dialogue: 0,0:07:27.05,0:07:29.53,Caption,,0,0,0,,ИМЕННО ЗДЕСЬ ВОЗНИКАЕТ РАЗГОВОР О ГРАНИЦАХ.
Dialogue: 0,0:07:31.80,0:07:33.96,Caption,,0,0,0,,КИМ ПРИЗНАЁТ ЕСЛИ ОГРАНИЧЕНИЯ СНЯТЬ,
Dialogue: 0,0:07:34.04,0:07:37.08,Caption,,0,0,0,,НАСЕЛЕНИЕ НАЧНЁТ УЕЗЖАТЬ. ВЛАСТЬ ЗАРАНЕЕ ЖДЁТ,
Dialogue: 0,0:07:37.32,0:07:39.40,Caption,,0,0,0,,ЧТО МНОЖЕСТВО ЛЮДЕЙ ВОСПОЛЬЗУЮТСЯ ПЕРВОЙ
Dialogue: 0,0:07:39.40,0:07:41.96,Caption,,0,0,0,,ВОЗМОЖНОСТЬЮ СОБРАТЬ ВЕЩИ И ПОКИНУТЬ СТРАНУ.
Dialogue: 0,0:07:44.16,0:07:46.80,Caption,,0,0,0,,ОПРОС ИССЛЕДОВАТЕЛЬСКОЙ КОМПАНИИ "ГРАДУС РИСЁРЧ"
Dialogue: 0,0:07:46.80,0:07:49.44,Caption,,0,0,0,,ПОКАЗЫВАЕТ МАСШТАБ. СРЕДИ УКРАИНЦЕВ,
Dialogue: 0,0:07:49.52,0:07:52.16,Caption,,0,0,0,,НАХОДЯЩИХСЯ В ЕВРОСОЮЗЕ, ДОЛЯ ТЕХ,
Dialogue: 0,0:07:52.32,0:07:54.72,Caption,,0,0,0,,КТО НЕ НАМЕРЕН ВОЗВРАЩАТЬСЯ ДАЖЕ ПРИ ЗАВЕРШЕНИИ
Dialogue: 0,0:07:54.80,0:07:57.12,Caption,,0,0,0,,КОНФЛИКТА НА ПРИЕМЛЕМЫХ ДЛЯ КИЕВА УСЛОВИЯХ,
Dialogue: 0,0:07:57.60,0:08:00.48,Caption,,0,0,0,,ЗА ГОД ВЫРОСЛА С СЕМНАДЦАТИ ДО ТРИДЦАТИ ЧЕТЫРЁХ
Dialogue: 0,0:08:00.48,0:08:04.42,Caption,,0,0,0,,ПРОЦЕНТОВ. ЭТО КАЖДЫЙ ТРЕТИЙ.
Dialogue: 0,0:08:06.70,0:08:10.46,Caption,,0,0,0,,ОТКРЫТЬ ГРАНИЦЫ ОПАСНО, ПОТОМУ ЧТО НАЧНЁТСЯ ОТТОК НАСЕЛЕНИЯ.
Dialogue: 0,0:08:12.74,0:08:15.86,Caption,,0,0,0,,НО У ЧИНОВНИКА, ОЖИДАЮЩЕГО НЕУДОБНЫХ ВЕТЕРАНОВ,
Dialogue: 0,0:08:16.10,0:08:21.58,Caption,,0,0,0,,МОЖЕТ БЫТЬ И ДРУГОЙ РАСЧЁТ. СТРАНА ПОТЕРЯЕТ РАБОТНИКОВ,
Dialogue: 0,0:08:21.66,0:08:23.90,Caption,,0,0,0,,ПРЕДПРИНИМАТЕЛЕЙ И НАЛОГОПЛАТЕЛЬЩИКОВ,
Dialogue: 0,0:08:24.21,0:08:27.26,Caption,,0,0,0,,ЗАТО ОТДЕЛЬНЫЕ НАЧАЛЬНИКИ ИЗБАВЯТСЯ ОТ ЧАСТИ ЛЮДЕЙ,
Dialogue: 0,0:08:27.34,0:08:29.38,Caption,,0,0,0,,СПОСОБНЫХ ЛИЧНО ПРЕДЪЯВИТЬ ИМ СЧЁТ.
Dialogue: 0,0:08:31.52,0:08:34.02,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАНЯТНАЯ БУХГАЛТЕРИЯ БУДУЩЕГО.
Dialogue: 0,0:08:36.30,0:08:41.02,Caption,,0,0,0,,ГРАЖДАН НАДО УДЕРЖИВАТЬ, ИНАЧЕ НЕКОМУ БУДЕТ РАБОТАТЬ. МИЛЛИОНАМ ВЕТЕРАНОВ
Dialogue: 0,0:08:41.02,0:08:42.86,Caption,,0,0,0,,НЕОБХОДИМО ПРЕДОСТАВИТЬ ЗАНЯТОСТЬ,
Dialogue: 0,0:08:43.10,0:08:45.90,Caption,,0,0,0,,ПОТОМУ ЧТО СОДЕРЖАТЬ ИХ ПОСОБИЯМИ БЮДЖЕТ НЕ СМОЖЕТ.
Dialogue: 0,0:08:46.28,0:08:49.34,Caption,,0,0,0,,СОТНИ ТЫСЯЧ СЕМЕЙ УЖЕ УСТРОИЛИСЬ В ЕВРОПЕ И
Dialogue: 0,0:08:49.34,0:08:52.38,Caption,,0,0,0,,ВСЁ МЕНЬШЕ ДУМАЮТ О ВОЗВРАЩЕНИИ. А ФРОНТОВИКИ,
Dialogue: 0,0:08:52.54,0:08:56.86,Caption,,0,0,0,,КОТОРЫЕ ВСЁ ЖЕ ПРИЕДУТ, МОГУТ СТАТЬ НАИБОЛЕЕ СПЛОЧЁННОЙ И ТРЕБОВАТЕЛЬНОЙ
Dialogue: 0,0:08:56.86,0:09:02.81,Caption,,0,0,0,,ЧАСТЬЮ ОБЩЕСТВА. ТЕМ ВРЕМЕНЕМ ВОЗЛЕ РУМЫНСКОЙ ГРАНИЦЫ ОБСУЖДАЕТСЯ
Dialogue: 0,0:09:02.81,0:09:05.93,Caption,,0,0,0,,КОЛЮЧАЯ ПРОВОЛОКА. У НЕЁ МОЖЕТ БЫТЬ СВОЁ КОНКРЕТНОЕ
Dialogue: 0,0:09:05.93,0:09:10.01,Caption,,0,0,0,,НАЗНАЧЕНИЕ, НО СИМВОЛ ПОЛУЧИЛСЯ СЛИШКОМ ТОЧНЫМ. СТРАНА,
Dialogue: 0,0:09:10.22,0:09:12.41,Caption,,0,0,0,,КОТОРОЙ ВСКОРЕ ПОНАДОБИТСЯ КАЖДЫЙ ЧЕЛОВЕК,
Dialogue: 0,0:09:12.65,0:09:14.49,Caption,,0,0,0,,УЖЕ СЕЙЧАС БОЛЬШЕ ВСЕГО БОИТСЯ,
Dialogue: 0,0:09:14.65,0:09:17.77,Caption,,0,0,0,,ЧТО ЛЮДИ РАЗБЕГУТСЯ. ПОХОЖЕ НА ХОЗЯИНА ПУСТЕЮЩЕГО
Dialogue: 0,0:09:17.77,0:09:20.81,Caption,,0,0,0,,МАГАЗИНА, КОТОРЫЙ ВМЕСТО ПОКУПАТЕЛЕЙ ЗАПИРАЕТ ДВЕРИ.
Dialogue: 0,0:09:23.07,0:09:25.33,Caption,,0,0,0,,ТУТ СНОВА ПРИХОДИТСЯ ВСПОМНИТЬ ЭКОНОМИКУ.
Dialogue: 0,0:09:27.60,0:09:30.08,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ ВАЛЮТНЫЙ ФОНД ТРЕБУЕТ УВЕЛИЧИТЬ
Dialogue: 0,0:09:30.08,0:09:33.44,Caption,,0,0,0,,БЮДЖЕТНЫЕ ПОСТУПЛЕНИЯ. ДОПУСТИМ. ТОЛЬКО ПЛАТИТЬ КТО
Dialogue: 0,0:09:33.52,0:09:37.00,Caption,,0,0,0,,БУДЕТ? МАЛЫЙ БИЗНЕС,
Dialogue: 0,0:09:37.24,0:09:40.20,Caption,,0,0,0,,КОТОРОМУ ПОДНИМУТ НАЛОГИ, ПОКА У НЕГО ПАДАЮТ ДОХОДЫ?
Dialogue: 0,0:09:42.46,0:09:46.23,Caption,,0,0,0,,ПРОИЗВОДСТВО, РАБОТАЮЩЕЕ ПО ГРАФИКУ ПОДАЧИ ЭЛЕКТРИЧЕСТВА?
Dialogue: 0,0:09:48.49,0:09:50.74,Caption,,0,0,0,,ГРАЖДАНЕ, ГОТОВЯЩИЕСЯ К ОТЪЕЗДУ?
Dialogue: 0,0:09:53.02,0:09:56.22,Caption,,0,0,0,,ИЛИ ВЕТЕРАНЫ, КОТОРЫМ СНАЧАЛА ПРЕДСТОИТ НАЙТИ ЗАРАБОТОК,
Dialogue: 0,0:09:56.52,0:09:58.86,Caption,,0,0,0,,КРЫШУ НАД ГОЛОВОЙ И МЕСТО В МИРНОЙ ЖИЗНИ?
Dialogue: 0,0:10:01.14,0:10:04.18,Caption,,0,0,0,,В РАСЧЁТАХ ВСЁ МОЖЕТ ВЫГЛЯДЕТЬ АККУРАТНО. ТАБЛИЦА НЕ
Dialogue: 0,0:10:04.18,0:10:07.38,Caption,,0,0,0,,МЁРЗНЕТ БЕЗ СВЕТА, НЕ ТЕРЯЕТ ДОМ И НЕ СПРАШИВАЕТ,
Dialogue: 0,0:10:07.62,0:10:09.54,Caption,,0,0,0,,ПОЧЕМУ ЕЁ СНОВА СДЕЛАЛИ КРАЙНЕЙ.
Dialogue: 0,0:10:11.83,0:10:14.63,Caption,,0,0,0,,ПОСЛЕ ЗАВЕРШЕНИЯ БОЕВЫХ ДЕЙСТВИЙ УКРАИНЕ ПОНАДОБЯТСЯ
Dialogue: 0,0:10:14.71,0:10:17.75,Caption,,0,0,0,,НЕ ОДНИ КРЕДИТЫ. РАЗБИТУЮ СТЕНУ МОЖНО ЗАЛИТЬ НОВЫМ
Dialogue: 0,0:10:17.75,0:10:21.27,Caption,,0,0,0,,БЕТОНОМ. КАБЕЛЬ МОЖНО ПРОТЯНУТЬ ЗАНОВО. НЕДОСТАЮЩУЮ
Dialogue: 0,0:10:21.27,0:10:23.99,Caption,,0,0,0,,СУММУ МОЖНО СНОВА ПОПРОСИТЬ У ВНЕШНИХ КРЕДИТОРОВ,
Dialogue: 0,0:10:24.23,0:10:26.71,Caption,,0,0,0,,ХОТЯ ТАМ УЖЕ НАВЕРНЯКА УЗНАЮТ ЗВОНОК КИЕВА С
Dialogue: 0,0:10:26.71,0:10:31.96,Caption,,0,0,0,,ПЕРВЫХ ДВУХ ГУДКОВ. С ДОВЕРИЕМ ТАКОЙ ФОКУС НЕ ПРОЙДЁТ.
Dialogue: 0,0:10:34.24,0:10:36.56,Caption,,0,0,0,,ЕСЛИ ЧЕЛОВЕК НЕСКОЛЬКО ЛЕТ ИСПОЛНЯЛ ПРИКАЗЫ
Dialogue: 0,0:10:36.56,0:10:39.12,Caption,,0,0,0,,ГОСУДАРСТВА, А ПОСЛЕ ВОЗВРАЩЕНИЯ РЕШИЛ,
Dialogue: 0,0:10:39.36,0:10:41.20,Caption,,0,0,0,,ЧТО ЕГО ИСПОЛЬЗОВАЛИ И ОБМАНУЛИ,
Dialogue: 0,0:10:41.44,0:10:43.76,Caption,,0,0,0,,ЗАНЯТЬ ЕГО ДОВЕРИЕ ДО СЛЕДУЮЩЕГО ТРАНША НЕ
Dialogue: 0,0:10:43.76,0:10:46.00,Caption,,0,0,0,,ПОЛУЧИТСЯ. ЕГО НЕЛЬЗЯ НАПЕЧАТАТЬ,
Dialogue: 0,0:10:46.17,0:10:48.80,Caption,,0,0,0,,КУПИТЬ ИЛИ ЗАЛОЖИТЬ В БЮДЖЕТ. И СУДЯ ПО
Dialogue: 0,0:10:48.88,0:10:52.16,Caption,,0,0,0,,СЛОВАМ КИМА О ПРЕСТУПНОСТИ, НАПРЯЖЕНИИ И РЕВОЛЮЦИЯХ,
Dialogue: 0,0:10:52.48,0:10:55.60,Caption,,0,0,0,,ОН ПОНИМАЕТ, НАСКОЛЬКО ОПАСНОЙ СТАНЕТ ЭТА РАСПЛАТА.
Dialogue: 0,0:10:57.88,0:11:00.44,Caption,,0,0,0,,ПОЭТОМУ ГЛАВНЫЙ ВОПРОС НЕ СВОДИТСЯ К СТОИМОСТИ
Dialogue: 0,0:11:00.44,0:11:04.72,Caption,,0,0,0,,ВОССТАНОВЛЕНИЯ. РЕШАТЬ ПРИДЁТСЯ,
Dialogue: 0,0:11:04.94,0:11:07.84,Caption,,0,0,0,,КТО ОСТАНЕТСЯ В СТРАНЕ, КТО ОКОНЧАТЕЛЬНО УЕДЕТ,
Dialogue: 0,0:11:08.08,0:11:11.12,Caption,,0,0,0,,КТО ВЕРНЁТСЯ С ФРОНТА И ЧЕМ ГОСУДАРСТВО ВСТРЕТИТ
Dialogue: 0,0:11:11.12,0:11:14.56,Caption,,0,0,0,,ЭТИХ ЛЮДЕЙ. РАБОТОЙ И ЧЕСТНЫМИ ОТВЕТАМИ ИЛИ НОВЫМ
Dialogue: 0,0:11:14.64,0:11:16.40,Caption,,0,0,0,,НАБОРОМ ОБЕЩАНИЙ ОТ ТЕХ ЖЕ ЛИЦ.
Dialogue: 0,0:11:18.68,0:11:21.32,Caption,,0,0,0,,ПРЕКРАТИТЬ БОЕВЫЕ ДЕЙСТВИЯ МОЖНО ОДНИМ РЕШЕНИЕМ.
Dialogue: 0,0:11:21.55,0:11:24.20,Caption,,0,0,0,,ПРЕКРАТИТЬ ВСЁ, ЧТО ОНИ СДЕЛАЛИ С ОБЩЕСТВОМ,
Dialogue: 0,0:11:24.43,0:11:30.64,Caption,,0,0,0,,ТАКИМ РЕШЕНИЕМ НЕЛЬЗЯ. САМАЯ ТЯЖЁЛАЯ ПРОВЕРКА ДЛЯ ВЛАСТИ МОЖЕТ НАЧАТЬСЯ
Dialogue: 0,0:11:30.64,0:11:34.24,Caption,,0,0,0,,ИМЕННО ТОГДА, КОГДА ВЕТЕРАНЫ ОТКРОЮТ ДВЕРИ СВОИХ ДОМОВ,
Dialogue: 0,0:11:34.56,0:11:39.28,Caption,,0,0,0,,ОГЛЯНУТСЯ ВОКРУГ И СПРОСЯТ, РАДИ ЧЕГО ИМ ПРЕДЛАГАЛИ ТЕРПЕТЬ ВСЕ ЭТИ ГОДЫ.
