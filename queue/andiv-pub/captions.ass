Dialogue: 0,0:00:00.12,0:00:02.60,Caption,,0,0,0,,У БОЛЬШОЙ ПОЛИТИКИ ОБНАРУЖИЛАСЬ ОДНА ЗАМЕЧАТЕЛЬНАЯ
Dialogue: 0,0:00:02.68,0:00:05.64,Caption,,0,0,0,,ОСОБЕННОСТЬ. ПОКА ВСЁ ХОРОШО, КРУГОМ ДРУЗЬЯ,
Dialogue: 0,0:00:05.74,0:00:10.20,Caption,,0,0,0,,ПАРТНЁРЫ, СОЮЗНИКИ И КРЕПКИЕ РУКОПОЖАТИЯ. НО СТОИТ КОМУ НИБУДЬ
Dialogue: 0,0:00:10.20,0:00:13.72,Caption,,0,0,0,,ЗАГОВОРИТЬ О ДЕНЬГАХ, БЛАГОДАРНОСТИ ИЛИ СТАРЫХ ОБЕЩАНИЯХ,
Dialogue: 0,0:00:14.04,0:00:17.24,Caption,,0,0,0,,КАК ДРУЖБА НАЧИНАЕТ ВЫГЛЯДЕТЬ НЕСКОЛЬКО ИНАЧЕ. И ВОТ
Dialogue: 0,0:00:17.24,0:00:20.84,Caption,,0,0,0,,ТЕПЕРЬ ЛЮДИ, КОТОРЫЕ ГОДАМИ ПОДДЕРЖИВАЛИ ОДНУ И ТУ ЖЕ СТОРОНУ,
Dialogue: 0,0:00:21.08,0:00:23.08,Caption,,0,0,0,,ВДРУГ НАЧАЛИ ГОВОРИТЬ ДРУГ О ДРУГЕ ДОВОЛЬНО
Dialogue: 0,0:00:23.08,0:00:26.28,Caption,,0,0,0,,НЕПРИЯТНЫЕ ВЕЩИ. ПРИЧЁМ НЕКОТОРЫЕ ВСПОМНИЛИ ТАКОЕ,
Dialogue: 0,0:00:26.60,0:00:29.32,Caption,,0,0,0,,О ЧЁМ РАНЬШЕ ПРЕДПОЧИТАЛИ ПОМАЛКИВАТЬ. А ЧТО ЖЕ
Dialogue: 0,0:00:29.32,0:00:33.24,Caption,,0,0,0,,ПРОИЗОШЛО, ЕСЛИ ДАЖЕ ПРЕЖНИЕ СОЮЗНИКИ УЖЕ НЕ СЧИТАЮТ НУЖНЫМ
Dialogue: 0,0:00:33.24,0:00:36.52,Caption,,0,0,0,,ВЫБИРАТЬ ВЫРАЖЕНИЯ? ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ ИСТОРИИ,
Dialogue: 0,0:00:36.60,0:00:40.76,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ДЖО БАЙДЕН ВЫПУСТИЛ МЕМУАРЫ И НЕОЖИДАННО ДОБАВИЛ К
Dialogue: 0,0:00:40.76,0:00:43.48,Caption,,0,0,0,,ОФИЦИАЛЬНОЙ ИСТОРИИ ОТНОШЕНИЙ С КИЕВОМ НЕСКОЛЬКО
Dialogue: 0,0:00:43.48,0:00:46.20,Caption,,0,0,0,,ОЧЕНЬ ЧЕЛОВЕЧЕСКИХ ДЕТАЛЕЙ. ЗЕЛЕНСКИЙ,
Dialogue: 0,0:00:46.30,0:00:49.40,Caption,,0,0,0,,ПИШЕТ ОН, В ЛИЧНЫХ РАЗГОВОРАХ БЫВАЛ КАПРИЗНЫМ,
Dialogue: 0,0:00:49.55,0:00:51.96,Caption,,0,0,0,,УПРЯМЫМ И НЕ НАСТОЛЬКО БЛАГОДАРНЫМ,
Dialogue: 0,0:00:52.19,0:00:55.16,Caption,,0,0,0,,КАК БАЙДЕН ОЖИДАЛ. ФОРМУЛИРОВКА ПРЕКРАСНАЯ УЖЕ САМА
Dialogue: 0,0:00:55.16,0:00:57.64,Caption,,0,0,0,,ПО СЕБЕ. ТО ЕСТЬ ПОМОЩЬ ШЛА ОГРОМНАЯ,
Dialogue: 0,0:00:57.81,0:01:01.64,Caption,,0,0,0,,ОРУЖИЕ ШЛО, ДЕНЬГИ ШЛИ, ПОЛИТИЧЕСКАЯ ПОДДЕРЖКА ШЛА,
Dialogue: 0,0:01:01.96,0:01:04.36,Caption,,0,0,0,,А ГДЕ ТО ВНУТРИ ВСЕГО ЭТОГО СУЩЕСТВОВАЛ ЕЩЁ
Dialogue: 0,0:01:04.44,0:01:07.40,Caption,,0,0,0,,И СЧЁТЧИК БЛАГОДАРНОСТИ. И, СУДЯ ПО ВСЕМУ,
Dialogue: 0,0:01:07.49,0:01:10.28,Caption,,0,0,0,,ПОКАЗЫВАЛ ОН НЕ ТУ ЦИФРУ. НО ГОРАЗДО ИНТЕРЕСНЕЕ
Dialogue: 0,0:01:10.28,0:01:16.71,Caption,,0,0,0,,ДРУГОЕ ПРИЗНАНИЕ БАЙДЕНА. ПОСЛЕ ПОБЕДЫ ТРАМПА ЕГО КОМАНДА ПОПРОСИЛА РАЗРЕШИТЬ
Dialogue: 0,0:01:16.79,0:01:20.31,Caption,,0,0,0,,ПРЯМЫЕ КОНТАКТЫ С ПУТИНЫМ ЕЩЁ ДО ИНАУГУРАЦИИ. БАЙДЕН
Dialogue: 0,0:01:20.31,0:01:23.11,Caption,,0,0,0,,ОТКАЗАЛ. ОН НЕ ХОТЕЛ ДАВАТЬ ТРАМПУ КАРТ БЛАНШ
Dialogue: 0,0:01:23.19,0:01:26.79,Caption,,0,0,0,,НА ТО, ЧТО СЧИТАЛ КАПИТУЛЯЦИЕЙ ЗА СЧЁТ УКРАИНЫ. ТО ЕСТЬ
Dialogue: 0,0:01:26.79,0:01:29.67,Caption,,0,0,0,,УХОДЯЩАЯ АДМИНИСТРАЦИЯ НЕ ПРОСТО НЕ ДОВЕРЯЛА БУДУЩЕЙ
Dialogue: 0,0:01:29.67,0:01:32.79,Caption,,0,0,0,,ЛИНИИ ТРАМПА. ОНА СОЗНАТЕЛЬНО НЕ ДАЛА ЕЙ СТАРТОВАТЬ
Dialogue: 0,0:01:32.79,0:01:36.79,Caption,,0,0,0,,РАНЬШЕ. С ПРИХОДОМ КОМАНДЫ ТРАМПА ТОН ПОМЕНЯЛСЯ ЕЩЁ СИЛЬНЕЕ.
Dialogue: 0,0:01:37.18,0:01:39.91,Caption,,0,0,0,,THE ATLANTIC ОПИСЫВАЕТ АТМОСФЕРУ В ПЕНТАГОНЕ ПОСЛЕ
Dialogue: 0,0:01:39.91,0:01:42.39,Caption,,0,0,0,,ЗНАМЕНИТОЙ ПЕРЕПАЛКИ ТРАМПА И ЗЕЛЕНСКОГО В БЕЛОМ
Dialogue: 0,0:01:42.39,0:01:44.95,Caption,,0,0,0,,ДОМЕ. ПО СЛОВАМ УКРАИНСКОГО ЧИНОВНИКА,
Dialogue: 0,0:01:45.12,0:01:47.75,Caption,,0,0,0,,ПИТ ХЕГСЕТ НЕ ХОТЕЛ ДАЖЕ СЛЫШАТЬ СЛОВО "УКРАИНА".
Dialogue: 0,0:01:48.15,0:01:49.75,Caption,,0,0,0,,АМЕРИКАНСКИЙ ОФИЦЕР ВСПОМИНАЛ,
Dialogue: 0,0:01:49.99,0:01:52.15,Caption,,0,0,0,,ЧТО РАЗГОВОР ОБ УКРАИНЕ В ПЕНТАГОНЕ В ЛУЧШЕМ
Dialogue: 0,0:01:52.15,0:01:55.11,Caption,,0,0,0,,СЛУЧАЕ ВСТРЕЧАЛИ ПРЕЗРИТЕЛЬНОЙ УСМЕШКОЙ. И ТАМ ЖЕ
Dialogue: 0,0:01:55.11,0:01:57.75,Caption,,0,0,0,,ПОЯВИЛАСЬ ОЧЕНЬ НЕПРИЯТНАЯ ДЛЯ КИЕВА ФОРМУЛА.
Dialogue: 0,0:01:57.98,0:02:00.39,Caption,,0,0,0,,УКРАИНА СТАЛА ВОСПРИНИМАТЬСЯ НЕ КАК СОЮЗНИК,
Dialogue: 0,0:02:00.55,0:02:03.27,Caption,,0,0,0,,А КАК ПРОСИТЕЛЬ. ПРИ БАЙДЕНЕ ОТ ЗЕЛЕНСКОГО ЖДАЛИ
Dialogue: 0,0:02:03.27,0:02:05.99,Caption,,0,0,0,,БЛАГОДАРНОСТИ. ПРИ ТРАМПЕ ЕМУ УЖЕ НАПОМНИЛИ,
Dialogue: 0,0:02:06.23,0:02:08.31,Caption,,0,0,0,,ЧТО КАРТОЧКИ НА СТОЛЕ ЛЕЖАТ НЕ У НЕГО.
Dialogue: 0,0:02:08.63,0:02:10.71,Caption,,0,0,0,,ХОРОШИЙ ПУТЬ ОТ "МЫ С ВАМИ СТОЛЬКО,
Dialogue: 0,0:02:10.79,0:02:13.67,Caption,,0,0,0,,СКОЛЬКО ПОТРЕБУЕТСЯ" ДО "А ВЫ ВООБЩЕ ЗАЧЕМ ОПЯТЬ
Dialogue: 0,0:02:13.75,0:02:16.63,Caption,,0,0,0,,ПРИШЛИ?". И ЗДЕСЬ СТОИТ ВСПОМНИТЬ ЕЩЁ ОДНУ ИСТОРИЮ.
Dialogue: 0,0:02:16.86,0:02:19.59,Caption,,0,0,0,,КАЯ КАЛЛАС СЕЙЧАС ГОВОРИТ О ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ
Dialogue: 0,0:02:19.59,0:02:22.63,Caption,,0,0,0,,ТАК, БУДТО ВСЁ НАЧАЛОСЬ УЖЕ ПОСЛЕ ФЕВРАЛЯ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:02:22.63,0:02:28.12,Caption,,0,0,0,,ДВАДЦАТЬ ВТОРОГО ГОДА. НО В КОНЦЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОГО МОСКВА
Dialogue: 0,0:02:28.12,0:02:30.44,Caption,,0,0,0,,ВЫНЕСЛА НА СТОЛ ПРЕДЛОЖЕНИЯ ПО НОВОЙ СИСТЕМЕ
Dialogue: 0,0:02:30.44,0:02:33.72,Caption,,0,0,0,,БЕЗОПАСНОСТИ В ЕВРОПЕ. ИХ НЕ ПРИНЯЛИ. ИРЛАНДСКИЙ
Dialogue: 0,0:02:33.72,0:02:36.12,Caption,,0,0,0,,ЖУРНАЛИСТ ЧЕЙ БОУЗ ТЕПЕРЬ СОПОСТАВЛЯЕТ ТЕ
Dialogue: 0,0:02:36.12,0:02:38.84,Caption,,0,0,0,,ПРЕДЛОЖЕНИЯ С НЫНЕШНИМИ РОССИЙСКИМИ ТРЕБОВАНИЯМИ И
Dialogue: 0,0:02:38.84,0:02:42.52,Caption,,0,0,0,,ДЕЛАЕТ ВЫВОД, ЧТО ОКНО ДЛЯ БОЛЕЕ МЯГКОГО РАЗГОВОРА ТОГДА БЫЛО
Dialogue: 0,0:02:42.52,0:02:45.56,Caption,,0,0,0,,УПУЩЕНО, А ЦЕНА СЛЕДУЮЩЕГО РАЗГОВОРА СТАЛА ВЫШЕ.
Dialogue: 0,0:02:46.19,0:02:48.76,Caption,,0,0,0,,И ЗДЕСЬ ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС. ХОРОШО,
Dialogue: 0,0:02:48.92,0:02:51.32,Caption,,0,0,0,,ЕВРОПА НЕ ХОЧЕТ САДИТЬСЯ ЗА СТОЛ НА УСЛОВИЯХ,
Dialogue: 0,0:02:51.40,0:02:53.56,Caption,,0,0,0,,КОТОРЫЕ ЕЙ НЕ НРАВЯТСЯ. А ДАЛЬШЕ ЧТО?
Dialogue: 0,0:02:53.89,0:02:55.88,Caption,,0,0,0,,КАКОЙ КОНЕЧНЫЙ ПУНКТ У ЭТОЙ ПОЛИТИКИ?
Dialogue: 0,0:02:56.20,0:02:59.24,Caption,,0,0,0,,ЕЩЁ ОДИН ПАКЕТ САНКЦИЙ? ЕЩЁ ОДИН ГОД ДАВЛЕНИЯ?
Dialogue: 0,0:02:59.48,0:03:02.68,Caption,,0,0,0,,ЕЩЁ ОДНА ДЕКЛАРАЦИЯ О ТОМ, ЧТО РАЗГОВАРИВАТЬ ПОКА РАНО?
Dialogue: 0,0:03:03.24,0:03:05.96,Caption,,0,0,0,,САМЫЕ МАЛЕНЬКИЕ ОПЯТЬ ОКАЗАЛИСЬ САМЫМИ ГРОМКИМИ,
Dialogue: 0,0:03:06.20,0:03:08.76,Caption,,0,0,0,,НО ЗНАМЕНИТЫЙ ВОПРОС НИКУДА НЕ ДЕЛСЯ. А СКОЛЬКО
Dialogue: 0,0:03:08.84,0:03:12.76,Caption,,0,0,0,,У НИХ ДИВИЗИЙ? ЕСЛИ ЧЕРЕЗ ПЯТЬ ЛЕТ ПОСЛЕ ПЕРВЫХ ПРЕДЛОЖЕНИЙ УСЛОВИЯ
Dialogue: 0,0:03:12.76,0:03:16.44,Caption,,0,0,0,,СТАЛИ ЖЁСТЧЕ, ВРЕМЯ УЖЕ САМО ПРЕВРАТИЛОСЬ В ЦЕНУ. ВМЕСТО
Dialogue: 0,0:03:16.44,0:03:18.60,Caption,,0,0,0,,ДОГОВОРЁННОСТИ ЕВРОПА ПОЛУЧИЛА ВОЙНУ,
Dialogue: 0,0:03:18.84,0:03:21.24,Caption,,0,0,0,,НОВЫЕ АРМИИ У ГРАНИЦ И СОВЕРШЕННО ДРУГОЙ
Dialogue: 0,0:03:21.24,0:03:24.28,Caption,,0,0,0,,ПЕРЕГОВОРНЫЙ РАСКЛАД. А ТЕПЕРЬ ПОЯВЛЯЕТСЯ ИЛОН МАСК
Dialogue: 0,0:03:24.36,0:03:27.00,Caption,,0,0,0,,И ВООБЩЕ ПЕРЕВОРАЧИВАЕТ СТОЛ. ОН ПРЯМО ГОВОРИТ,
Dialogue: 0,0:03:27.16,0:03:29.08,Caption,,0,0,0,,ЧТО РОССИЯ ЯВЛЯЕТСЯ АГРЕССОРОМ.
Dialogue: 0,0:03:31.37,0:03:33.05,Caption,,0,0,0,,И В ТОМ ЖЕ РАЗГОВОРЕ ЗАЯВЛЯЕТ,
Dialogue: 0,0:03:33.37,0:03:35.69,Caption,,0,0,0,,ЧТО МАЙДАН ДВЕ ТЫСЯЧИ ЧЕТЫРНАДЦАТОГО ГОДА БЫЛ
Dialogue: 0,0:03:35.69,0:03:40.25,Caption,,0,0,0,,ГОСУДАРСТВЕННЫМ ПЕРЕВОРОТОМ, ОРГАНИЗОВАННЫМ СОЕДИНЁННЫМИ ШТАТАМИ ДЛЯ СВЕРЖЕНИЯ
Dialogue: 0,0:03:40.25,0:03:43.13,Caption,,0,0,0,,ДЕМОКРАТИЧЕСКИ ИЗБРАННОГО ПРОРОССИЙСКОГО ПРЕЗИДЕНТА.
Dialogue: 0,0:03:43.69,0:03:46.57,Caption,,0,0,0,,ОБВИНЕНИЕ ПРЕДЕЛЬНО ТЯЖЁЛОЕ. ПРИЧЁМ ПРОИЗНОСИТ ЕГО
Dialogue: 0,0:03:46.57,0:03:49.61,Caption,,0,0,0,,НЕ РОССИЙСКИЙ ЧИНОВНИК. ЕГО ПРОИЗНОСИТ ОДИН ИЗ САМЫХ
Dialogue: 0,0:03:49.61,0:03:52.33,Caption,,0,0,0,,ИЗВЕСТНЫХ АМЕРИКАНСКИХ ПРЕДПРИНИМАТЕЛЕЙ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:03:52.33,0:03:55.13,Caption,,0,0,0,,У МЕНЯ ТОТ САМЫЙ ПРОСТОЙ ВОПРОС. НАМ ПОСТОЯННО
Dialogue: 0,0:03:55.13,0:03:58.33,Caption,,0,0,0,,ОБЪЯСНЯЮТ, ЧТО ВМЕШИВАТЬСЯ ВО ВНУТРЕННИЕ ДЕЛА ДРУГИХ СТРАН
Dialogue: 0,0:03:58.33,0:04:01.77,Caption,,0,0,0,,НЕЛЬЗЯ. ОСОБЕННО ЕСЛИ ВМЕШИВАЕТСЯ МОСКВА. ХОРОШО.
Dialogue: 0,0:04:02.09,0:04:04.81,Caption,,0,0,0,,ТОГДА ДАВАЙТЕ ПРОСТО ПОМЕНЯЕМ ФАМИЛИИ МЕСТАМИ. В
Dialogue: 0,0:04:04.81,0:04:07.05,Caption,,0,0,0,,ДЕКАБРЕ ДВЕ ТЫСЯЧИ ТРИНАДЦАТОГО ГОДА НА МАЙДАН
Dialogue: 0,0:04:07.05,0:04:11.93,Caption,,0,0,0,,ПРИЕЗЖАЛА ВИКТОРИЯ НУЛАНД, ПОМОЩНИК ГОССЕКРЕТАРЯ США ПО ДЕЛАМ ЕВРОПЫ И ЕВРАЗИИ,
Dialogue: 0,0:04:12.25,0:04:16.09,Caption,,0,0,0,,И РАЗДАВАЛА ЛЮДЯМ ЕДУ. ДА, ТЕ САМЫЕ ЗНАМЕНИТЫЕ ПЕЧЕНЬКИ,
Dialogue: 0,0:04:16.41,0:04:18.25,Caption,,0,0,0,,ХОТЯ САМА НУЛАНД ПОТОМ УТОЧНЯЛА,
Dialogue: 0,0:04:18.49,0:04:23.37,Caption,,0,0,0,,ЧТО ЭТО БЫЛИ БУТЕРБРОДЫ. РЯДОМ ПРИЕЗЖАЛИ И ДРУГИЕ ЗАПАДНЫЕ ПОЛИТИКИ. КЭТРИН
Dialogue: 0,0:04:23.38,0:04:27.37,Caption,,0,0,0,,ЭШТОН, ГЛАВА ВНЕШНЕПОЛИТИЧЕСКОЙ СЛУЖБЫ ЕВРОСОЮЗА. ТОГДАШНЯЯ
Dialogue: 0,0:04:27.37,0:04:30.65,Caption,,0,0,0,,КАЯ КАЛЛАС. МИНИСТР ИНОСТРАННЫХ ДЕЛ ГЕРМАНИИ ГИДО
Dialogue: 0,0:04:30.65,0:04:33.53,Caption,,0,0,0,,ВЕСТЕРВЕЛЛЕ ВЫХОДИЛ НА МАЙДАН ВМЕСТЕ С ЛИДЕРАМИ
Dialogue: 0,0:04:33.53,0:04:36.41,Caption,,0,0,0,,УКРАИНСКОЙ ОППОЗИЦИИ. АМЕРИКАНСКИЕ СЕНАТОРЫ ДЖОН
Dialogue: 0,0:04:36.41,0:04:39.45,Caption,,0,0,0,,МАККЕЙН И КРИС МЁРФИ ВЫСТУПАЛИ ПЕРЕД ПРОТЕСТУЮЩИМИ.
Dialogue: 0,0:04:39.66,0:04:45.82,Caption,,0,0,0,,А ТЕПЕРЬ МЕНЯЕМ ТАБЛИЧКИ. В ПАРИЖЕ ИДУТ МАССОВЫЕ ПРОТЕСТЫ ПРОТИВ ФРАНЦУЗСКОГО
Dialogue: 0,0:04:45.82,0:04:48.06,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА. ПРИЕЗЖАЕТ СЕРГЕЙ РЯБКОВ,
Dialogue: 0,0:04:48.15,0:04:52.62,Caption,,0,0,0,,ВЫХОДИТ К ПРОТЕСТУЮЩИМ, РАЗДАЁТ ИМ БУТЕРБРОДЫ. СЛЕДОМ ПРИЕЗЖАЕТ ГЛАВА
Dialogue: 0,0:04:52.70,0:04:54.62,Caption,,0,0,0,,РОССИЙСКОЙ ВНЕШНЕПОЛИТИЧЕСКОЙ СЛУЖБЫ,
Dialogue: 0,0:04:54.85,0:04:57.10,Caption,,0,0,0,,ИДЁТ ПО ПЛОЩАДИ ВМЕСТЕ С ЛИДЕРАМИ ФРАНЦУЗСКОЙ
Dialogue: 0,0:04:57.10,0:05:00.22,Caption,,0,0,0,,ОППОЗИЦИИ. ПОТОМ РОССИЙСКИЕ СЕНАТОРЫ ПОДНИМАЮТСЯ НА
Dialogue: 0,0:05:00.30,0:05:03.82,Caption,,0,0,0,,СЦЕНУ И ОБЕЩАЮТ ПРОТЕСТУЮЩИМ ПОДДЕРЖКУ. КАК БЫ ЭТО
Dialogue: 0,0:05:03.82,0:05:06.06,Caption,,0,0,0,,НАЗВАЛИ В ПАРИЖЕ? ДРУЖЕСКИМ ВИЗИТОМ?
Dialogue: 0,0:05:06.32,0:05:09.02,Caption,,0,0,0,,КУЛЬТУРНЫМ ОБМЕНОМ? ЗАБОТОЙ О ДЕМОКРАТИИ?
Dialogue: 0,0:05:09.42,0:05:11.58,Caption,,0,0,0,,ИЛИ ФРАНЦУЗСКОЕ ПРАВИТЕЛЬСТВО ЧЕРЕЗ ПЯТЬ МИНУТ
Dialogue: 0,0:05:11.58,0:05:13.98,Caption,,0,0,0,,ЗАЯВИЛО БЫ О ГРУБОМ ВМЕШАТЕЛЬСТВЕ РОССИИ ВО
Dialogue: 0,0:05:14.06,0:05:18.46,Caption,,0,0,0,,ВНУТРЕННИЕ ДЕЛА СТРАНЫ? ВОТ ПОЭТОМУ СЛОВА МАСКА ЦЕПЛЯЮТ НЕ ТОЛЬКО САМИМ
Dialogue: 0,0:05:18.46,0:05:21.58,Caption,,0,0,0,,ОБВИНЕНИЕМ. ОН ЗАСТАВЛЯЕТ СНОВА ПОСМОТРЕТЬ НА СТАРЫЙ
Dialogue: 0,0:05:21.58,0:05:26.30,Caption,,0,0,0,,ЭПИЗОД ЧЕРЕЗ ПРАВИЛО, КОТОРОЕ ЗАПАД ПОСТОЯННО ПРИМЕНЯЕТ К РОССИИ. ЕСЛИ
Dialogue: 0,0:05:26.30,0:05:29.10,Caption,,0,0,0,,ПУБЛИЧНОЕ УЧАСТИЕ ИНОСТРАННОГО ЧИНОВНИКА В ПРОТЕСТАХ
Dialogue: 0,0:05:29.18,0:05:33.42,Caption,,0,0,0,,СЧИТАЕТСЯ ВМЕШАТЕЛЬСТВОМ, ПРАВИЛО ДОЛЖНО РАБОТАТЬ В ОБЕ СТОРОНЫ. А ЕСЛИ
Dialogue: 0,0:05:33.42,0:05:35.82,Caption,,0,0,0,,В ОДНУ СТОРОНУ ЭТО ПОДДЕРЖКА ДЕМОКРАТИИ,
Dialogue: 0,0:05:36.06,0:05:40.06,Caption,,0,0,0,,А В ДРУГУЮ ВМЕШАТЕЛЬСТВО, ТОГДА ПРОБЛЕМА УЖЕ НЕ В ПРАВИЛЕ. ПРОБЛЕМА В
Dialogue: 0,0:05:40.06,0:05:43.34,Caption,,0,0,0,,ТОМ, КТО ЕГО ПРИМЕНЯЕТ. И МАСК НА МАЙДАНЕ НЕ
Dialogue: 0,0:05:43.34,0:05:46.46,Caption,,0,0,0,,ОСТАНОВИЛСЯ. ОН ОТДЕЛЬНО ПРОШЁЛСЯ ПО ЗЕЛЕНСКОМУ И ПО
Dialogue: 0,0:05:46.46,0:05:49.26,Caption,,0,0,0,,ИСТОРИИ СО СПУТНИКОВОЙ СВЯЗЬЮ. ЗЕЛЕНСКИЙ ОБВИНЯЛ
Dialogue: 0,0:05:49.26,0:05:51.18,Caption,,0,0,0,,АМЕРИКАНСКУЮ СТОРОНУ В ОГРАНИЧЕНИЯХ.
Dialogue: 0,0:05:53.45,0:05:56.73,Caption,,0,0,0,,МАСК ОТВЕЧАЕТ, ЧТО ЗЕЛЕНСКИЙ НЕ ВСЕГДА ГОВОРИТ ПРАВДУ,
Dialogue: 0,0:05:57.04,0:05:59.29,Caption,,0,0,0,,И РАЗВОДИТ ДВЕ СИСТЕМЫ. STARLINK,
Dialogue: 0,0:05:59.43,0:06:02.17,Caption,,0,0,0,,КОММЕРЧЕСКАЯ СВЯЗЬ SPACEX, И STARSHIELD,
Dialogue: 0,0:06:02.33,0:06:05.45,Caption,,0,0,0,,ВОЕННАЯ СИСТЕМА, КОНТРОЛИРУЕМАЯ ПРАВИТЕЛЬСТВОМ США.
Dialogue: 0,0:06:06.06,0:06:08.97,Caption,,0,0,0,,ТУТ У КИЕВА НАЧИНАЕТСЯ СОВСЕМ НЕПРИЯТНАЯ АРИФМЕТИКА.
Dialogue: 0,0:06:09.37,0:06:13.85,Caption,,0,0,0,,МАСК ОДНОВРЕМЕННО НАПОМИНАЕТ, ЧТО ИМЕННО ЕГО КОМПАНИЯ ДАЛА УКРАИНЕ СВЯЗЬ В
Dialogue: 0,0:06:13.85,0:06:15.85,Caption,,0,0,0,,КРИТИЧЕСКИЙ МОМЕНТ, И ЗАЯВЛЯЕТ,
Dialogue: 0,0:06:16.01,0:06:18.97,Caption,,0,0,0,,ЧТО КОММЕРЧЕСКИЙ STARLINK НЕ ДОЛЖЕН ИСПОЛЬЗОВАТЬСЯ
Dialogue: 0,0:06:18.97,0:06:21.77,Caption,,0,0,0,,ДЛЯ НАСТУПАТЕЛЬНЫХ УДАРОВ БЕСПИЛОТНИКАМИ. ПРИ ЭТОМ
Dialogue: 0,0:06:21.85,0:06:25.53,Caption,,0,0,0,,ОН УТВЕРЖДАЕТ, ЧТО БЕЗ STARLINK УКРАИНСКИЙ ФРОНТ МОГ БЫ ВООБЩЕ
Dialogue: 0,0:06:25.53,0:06:28.57,Caption,,0,0,0,,ОБРУШИТЬСЯ. ТО ЕСТЬ ЧЕЛОВЕК СПОРИТ С ЗЕЛЕНСКИМ НЕ
Dialogue: 0,0:06:28.65,0:06:31.77,Caption,,0,0,0,,ИЗ ЗРИТЕЛЬНОГО ЗАЛА. В РУКАХ ЕГО КОМПАНИИ НАХОДИТСЯ
Dialogue: 0,0:06:31.77,0:06:35.29,Caption,,0,0,0,,ТЕХНОЛОГИЯ, КОТОРУЮ САМ МАСК НАЗЫВАЕТ КРИТИЧЕСКОЙ ДЛЯ
Dialogue: 0,0:06:35.29,0:06:38.41,Caption,,0,0,0,,УСТОЙЧИВОСТИ УКРАИНСКОЙ АРМИИ. И ЭТО УЖЕ НЕ ПЕРВЫЙ
Dialogue: 0,0:06:38.41,0:06:40.09,Caption,,0,0,0,,КОНФЛИКТ ЗЕЛЕНСКОГО С ЧЕЛОВЕКОМ,
Dialogue: 0,0:06:40.33,0:06:43.29,Caption,,0,0,0,,ОТ КОТОРОГО УКРАИНА СЕРЬЁЗНО ЗАВИСИТ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:06:43.29,0:06:45.13,Caption,,0,0,0,,ЛЮБИТ РАЗГОВАРИВАТЬ С ПАРТНЁРАМИ ТАК,
Dialogue: 0,0:06:45.37,0:06:48.01,Caption,,0,0,0,,БУДТО ЗАВИСИМОСТЬ СУЩЕСТВУЕТ ТОЛЬКО В ОДНУ СТОРОНУ.
Dialogue: 0,0:06:48.25,0:06:51.05,Caption,,0,0,0,,С БАЙДЕНОМ БЛАГОДАРНОСТИ ОКАЗАЛОСЬ МАЛОВАТО. С
Dialogue: 0,0:06:51.05,0:06:53.85,Caption,,0,0,0,,ТРАМПОМ ДОШЛО ДО ПУБЛИЧНОЙ ПЕРЕПАЛКИ. ТЕПЕРЬ МАСК
Dialogue: 0,0:06:53.85,0:06:56.57,Caption,,0,0,0,,ФАКТИЧЕСКИ ГОВОРИТ РЕБЯТА, ДАВАЙТЕ НЕ ЗАБЫВАТЬ,
Dialogue: 0,0:06:56.74,0:06:59.45,Caption,,0,0,0,,КТО ВАМ ВООБЩЕ ДАЛ ЭТУ СВЯЗЬ. МАСК ПРОВОДИТ
Dialogue: 0,0:06:59.53,0:07:02.41,Caption,,0,0,0,,ГРАНИЦУ МЕЖДУ ПОМОЩЬЮ УКРАИНЕ И ПРЕВРАЩЕНИЕМ СВОЕЙ
Dialogue: 0,0:07:02.41,0:07:04.81,Caption,,0,0,0,,КОМПАНИИ В УЧАСТНИКА НАСТУПАТЕЛЬНЫХ ОПЕРАЦИЙ.
Dialogue: 0,0:07:07.09,0:07:09.09,Caption,,0,0,0,,А КНОПКА ВСЁ РАВНО НАХОДИТСЯ НЕ В КИЕВЕ.
Dialogue: 0,0:07:09.29,0:07:13.89,Caption,,0,0,0,,ЕСЛИ ВЫ ЕЩЁ НЕ ПОДПИСАЛИСЬ, САМОЕ ВРЕМЯ. ПОТОМУ ЧТО ДАЛЬШЕ НАЧИНАЕТСЯ ИСТОРИЯ О
Dialogue: 0,0:07:13.89,0:07:17.17,Caption,,0,0,0,,ТОМ, КАК ГРОМКИЕ ПОЛИТИЧЕСКИЕ ПРИНЦИПЫ ВСТРЕЧАЮТСЯ С
Dialogue: 0,0:07:17.25,0:07:19.09,Caption,,0,0,0,,ОЧЕНЬ ТИХИМИ БАНКОВСКИМИ СЧЕТАМИ.
Dialogue: 0,0:07:19.73,0:07:21.81,Caption,,0,0,0,,ПОКА ЕВРОПЕЙСКИЕ ЧИНОВНИКИ РАССКАЗЫВАЮТ,
Dialogue: 0,0:07:22.05,0:07:24.53,Caption,,0,0,0,,КАК ОНИ ГОДАМИ ДАВЯТ НА РОССИЙСКИЕ КАПИТАЛЫ,
Dialogue: 0,0:07:24.85,0:07:27.57,Caption,,0,0,0,,КРУПНЕЙШИЙ НЕМЕЦКИЙ БАНК ПОПАЛ В КРАЙНЕ НЕУДОБНУЮ
Dialogue: 0,0:07:27.57,0:07:30.85,Caption,,0,0,0,,ИСТОРИЮ. ZDF ПОЛУЧИЛ ОГРОМНЫЙ МАССИВ ВНУТРЕННИХ
Dialogue: 0,0:07:30.85,0:07:33.33,Caption,,0,0,0,,ДОКУМЕНТОВ DEUTSCHE BANK. ИЗ НИХ СЛЕДУЕТ,
Dialogue: 0,0:07:33.57,0:07:36.13,Caption,,0,0,0,,ЧТО БАНК ГОДАМИ ПРОДОЛЖАЛ РАБОТАТЬ С КЛИЕНТАМИ
Dialogue: 0,0:07:36.13,0:07:39.49,Caption,,0,0,0,,ВЫСОКОГО РИСКА, СРЕДИ КОТОРЫХ БЫЛИ РОССИЙСКИЕ МИЛЛИАРДЕРЫ,
Dialogue: 0,0:07:39.76,0:07:42.77,Caption,,0,0,0,,НЕСМОТРЯ НА ВНУТРЕННИЕ ПРЕДУПРЕЖДЕНИЯ И САНКЦИОННЫЕ
Dialogue: 0,0:07:42.77,0:07:46.13,Caption,,0,0,0,,РИСКИ. ЧАСТЬ ТАКИХ КЛИЕНТОВ ПЕРЕВОДИЛИ НА ОБСЛУЖИВАНИЕ В
Dialogue: 0,0:07:46.13,0:07:49.17,Caption,,0,0,0,,ШВЕЙЦАРИЮ И ЛЮКСЕМБУРГ. СРЕДИ ФАМИЛИЙ ФИГУРИРУЮТ
Dialogue: 0,0:07:49.17,0:07:53.73,Caption,,0,0,0,,ОЛЕГ ДЕРИПАСКА, ГЕННАДИЙ ТИМЧЕНКО И СУЛЕЙМАН КЕРИМОВ. В ДОКУМЕНТАХ
Dialogue: 0,0:07:53.73,0:07:56.85,Caption,,0,0,0,,ВСПЛЫВАЮТ ОПЕРАЦИИ НА ОГРОМНЫЕ СУММЫ. В ОДНОМ ИЗ
Dialogue: 0,0:07:56.85,0:07:59.41,Caption,,0,0,0,,ЭПИЗОДОВ РЕЧЬ ШЛА О ПЕРЕВОДЕ ПРИМЕРНО ОДНОГО
Dialogue: 0,0:07:59.41,0:08:04.21,Caption,,0,0,0,,МИЛЛИАРДА СТА МИЛЛИОНОВ ЕВРО, ПРЕДПОЛОЖИТЕЛЬНО В ИНТЕРЕСАХ КЕРИМОВА. ВОТ ПОСЛЕ
Dialogue: 0,0:08:04.21,0:08:06.69,Caption,,0,0,0,,ЭТОГО ОСОБЕННО ХОРОШО ЗВУЧАТ РАССКАЗЫ О ДВАДЦАТЬ
Dialogue: 0,0:08:06.69,0:08:10.37,Caption,,0,0,0,,ПЯТОМ, ТРИДЦАТЬ ПЯТОМ И ХОТЬ ТРИСТА ДВАДЦАТЬ ПЯТОМ ПАКЕТЕ
Dialogue: 0,0:08:10.37,0:08:13.57,Caption,,0,0,0,,САНКЦИЙ. НА ПОЛИТИЧЕСКОМ ЭТАЖЕ ГОВОРЯТ ПЕРЕКРЫВАЕМ,
Dialogue: 0,0:08:13.72,0:08:20.02,Caption,,0,0,0,,ОГРАНИЧИВАЕМ, ИЗОЛИРУЕМ. НА БАНКОВСКОМ ЭТАЖЕ СМОТРЯТ НА КЛИЕНТА,
Dialogue: 0,0:08:20.18,0:08:24.42,Caption,,0,0,0,,НА КОМИССИЮ, НА ЮРИДИЧЕСКУЮ КОНСТРУКЦИЮ И ПОЧЕМУ ТО НАХОДЯТ ЕЩЁ
Dialogue: 0,0:08:24.42,0:08:27.46,Caption,,0,0,0,,ОДНУ ДВЕРЬ. И ЭТО ТА САМАЯ ЕВРОПЕЙСКАЯ ИСТОРИЯ
Dialogue: 0,0:08:27.54,0:08:30.18,Caption,,0,0,0,,С БУМЕРАНГОМ. ЭКОНОМИЧЕСКИХ РЫЧАГОВ СТАНОВИТСЯ
Dialogue: 0,0:08:30.18,0:08:33.30,Caption,,0,0,0,,МЕНЬШЕ, А ЗАМОРОЖЕННЫЕ РОССИЙСКИЕ АКТИВЫ ВЫГЛЯДЯТ ВСЁ
Dialogue: 0,0:08:33.30,0:08:36.42,Caption,,0,0,0,,ВАЖНЕЕ. DEUTSCHE BANK ПОКАЗЫВАЕТ ПРОСТУЮ ВЕЩЬ МЕЖДУ
Dialogue: 0,0:08:36.42,0:08:39.78,Caption,,0,0,0,,ПОЛИТИЧЕСКИМ ЛОЗУНГОМ И ТЕМ, КАК РЕАЛЬНО ДВИЖУТСЯ ДЕНЬГИ,
Dialogue: 0,0:08:40.02,0:08:42.82,Caption,,0,0,0,,ИНОГДА ПОМЕЩАЕТСЯ ЦЕЛЫЙ ЛЮКСЕМБУРГ. А ТЕПЕРЬ
Dialogue: 0,0:08:42.82,0:08:47.14,Caption,,0,0,0,,ВЕРНЁМСЯ В ВАШИНГТОН, ПОТОМУ ЧТО ТАМ УЖЕ ГОТОВИТСЯ СЛЕДУЮЩАЯ СЕРИЯ. ДЖЕЙ
Dialogue: 0,0:08:47.14,0:08:49.54,Caption,,0,0,0,,ДИ ВЭНС В ДВЕ ТЫСЯЧИ ШЕСТНАДЦАТОМ ГОДУ НАЗЫВАЛ
Dialogue: 0,0:08:49.54,0:08:53.46,Caption,,0,0,0,,ТРАМПА МОШЕННИКОМ, ГОВОРИЛ, ЧТО ЕМУ ПЛЕВАТЬ НА ОБЫЧНЫХ ЛЮДЕЙ,
Dialogue: 0,0:08:53.70,0:08:57.70,Caption,,0,0,0,,И СЧИТАЛ ЕГО ЧЕЛОВЕКОМ, КОТОРЫЙ ВЕДЁТ БЕЛЫЙ РАБОЧИЙ КЛАСС В ОЧЕНЬ ТЁМНОЕ
Dialogue: 0,0:08:57.70,0:09:01.14,Caption,,0,0,0,,МЕСТО. ПОТОМ ЭТОТ ЖЕ ВЭНС СТАЛ СЕНАТОРОМ. ПОТОМ
Dialogue: 0,0:09:01.22,0:09:04.50,Caption,,0,0,0,,ВИЦЕ ПРЕЗИДЕНТОМ. ПОТОМ ОДНИМ ИЗ ГЛАВНЫХ НАСЛЕДНИКОВ
Dialogue: 0,0:09:04.50,0:09:07.22,Caption,,0,0,0,,ТРАМПИЗМА. И ВОТ ЭТО ПРЕВРАЩЕНИЕ СЕЙЧАС СНОВА
Dialogue: 0,0:09:07.22,0:09:09.94,Caption,,0,0,0,,СТАНОВИТСЯ ПОЛЕЗНЫМ. РЕСПУБЛИКАНЦЫ ПРОИГРАЛИ
Dialogue: 0,0:09:09.94,0:09:12.50,Caption,,0,0,0,,ПРОМЕЖУТОЧНЫЕ ВЫБОРЫ. ВЭНС УЖЕ ОТДЕЛЬНО
Dialogue: 0,0:09:12.50,0:09:14.26,Caption,,0,0,0,,РАЗГОВАРИВАЕТ С ТОЙ ЧАСТЬЮ MAGA,
Dialogue: 0,0:09:14.42,0:09:16.42,Caption,,0,0,0,,КОТОРАЯ НЕДОВОЛЬНА ВНЕШНЕЙ ПОЛИТИКОЙ,
Dialogue: 0,0:09:16.59,0:09:20.50,Caption,,0,0,0,,ИРАНОМ, РАСХОДАМИ И ВЕЧНЫМИ ВОЙНАМИ. ДЛЯ ПОЛИТИКА,
Dialogue: 0,0:09:20.63,0:09:22.34,Caption,,0,0,0,,КОТОРЫЙ ХОЧЕТ ЖИТЬ ПОСЛЕ ТРАМПА,
Dialogue: 0,0:09:22.50,0:09:25.70,Caption,,0,0,0,,БИОГРАФИЯ ПОЧТИ ИДЕАЛЬНАЯ. ОН БЫЛ ПРОТИВ ТРАМПА.
Dialogue: 0,0:09:25.94,0:09:29.89,Caption,,0,0,0,,ПОТОМ БЫЛ С ТРАМПОМ. ЗНАЧИТ,
Dialogue: 0,0:09:30.05,0:09:32.45,Caption,,0,0,0,,ЗАВТРА ПРИ НЕОБХОДИМОСТИ СМОЖЕТ СКАЗАТЬ ОБЕИМ
Dialogue: 0,0:09:32.45,0:09:34.29,Caption,,0,0,0,,ПОЛОВИНАМ ПАРТИИ Я ВАС ПОНИМАЮ.
Dialogue: 0,0:09:35.15,0:09:38.13,Caption,,0,0,0,,ЕСТЬ ВЕРСИЯ ЕЩЁ ИНТЕРЕСНЕЕ. ЧТО ЭТО НЕ СЛУЧАЙНОЕ
Dialogue: 0,0:09:38.13,0:09:41.89,Caption,,0,0,0,,ПЕРЕОБУВАНИЕ, А ОЧЕНЬ УДОБНАЯ ПОЛИТИЧЕСКАЯ КОНСТРУКЦИЯ ДЛЯ САМОГО
Dialogue: 0,0:09:41.89,0:09:45.33,Caption,,0,0,0,,ТРАМПА. БЕРЁШЬ БЫВШЕГО КРИТИКА. ДЕЛАЕШЬ ЕГО СВОИМ
Dialogue: 0,0:09:45.33,0:09:48.29,Caption,,0,0,0,,ЧЕЛОВЕКОМ. ПОТОМ СВОИМ НАСЛЕДНИКОМ. А КОГДА НА
Dialogue: 0,0:09:48.29,0:09:50.77,Caption,,0,0,0,,ХОЗЯИНА НАЧИНАЕТ ПАДАТЬ СЛИШКОМ МНОГО ЧУЖОГО
Dialogue: 0,0:09:50.77,0:09:54.61,Caption,,0,0,0,,РАЗДРАЖЕНИЯ, НАСЛЕДНИК ЧУТЬ ОТХОДИТ В СТОРОНУ. ТРАМП УХОДИТ,
Dialogue: 0,0:09:54.76,0:09:57.89,Caption,,0,0,0,,ТРАМПИЗМ ОСТАЁТСЯ. А СТАРЫЕ СЛОВА ВЭНСА ВДРУГ
Dialogue: 0,0:09:57.89,0:10:00.45,Caption,,0,0,0,,ПРЕВРАЩАЮТСЯ ИЗ КОМПРОМАТА В ПРОПУСК К ТЕМ,
Dialogue: 0,0:10:00.61,0:10:03.65,Caption,,0,0,0,,КТО ТРАМПА ТЕРПЕТЬ НЕ МОЖЕТ. БАЙДЕН УЖЕ НАПИСАЛ
Dialogue: 0,0:10:03.73,0:10:06.37,Caption,,0,0,0,,СВОЮ ВЕРСИЮ ПРОШЛОГО. ТРАМП СТРОИТ СВОЮ ВЕРСИЮ
Dialogue: 0,0:10:06.37,0:10:09.65,Caption,,0,0,0,,НАСТОЯЩЕГО. МАСК ОБОЗНАЧАЕТ СВОИ КРАСНЫЕ ЛИНИИ.
Dialogue: 0,0:10:09.89,0:10:13.09,Caption,,0,0,0,,ЕВРОПА СПОРИТ О БЕЗОПАСНОСТИ И САНКЦИЯХ. А ВЭНС
Dialogue: 0,0:10:13.09,0:10:15.89,Caption,,0,0,0,,УЖЕ ДУМАЕТ О МИРЕ ПОСЛЕ ТРАМПА. ПОЭТОМУ ГЛАВНЫЙ
Dialogue: 0,0:10:15.89,0:10:18.45,Caption,,0,0,0,,ВОПРОС ДЛЯ УКРАИНЫ СТАНОВИТСЯ ГОРАЗДО ЖЁСТЧЕ
Dialogue: 0,0:10:18.53,0:10:22.29,Caption,,0,0,0,,ОБЫЧНОГО СПОРА О ТОМ, КТО ДАЛ БОЛЬШЕ ОРУЖИЯ И КТО КОМУ СКАЗАЛ
Dialogue: 0,0:10:22.29,0:10:26.05,Caption,,0,0,0,,СПАСИБО. ЛЮДИ, ОТ КОТОРЫХ КИЕВ ЗАВИСИТ ПОЛИТИЧЕСКИ,
Dialogue: 0,0:10:26.14,0:10:31.57,Caption,,0,0,0,,ФИНАНСОВО И ТЕХНОЛОГИЧЕСКИ, МЕНЯЮТСЯ. ИХ ИНТЕРЕСЫ МЕНЯЮТСЯ ЕЩЁ БЫСТРЕЕ. А
Dialogue: 0,0:10:31.57,0:10:34.13,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА УКРАИНЫ ПЕРЕД СОБСТВЕННОЙ РЕАЛЬНОСТЬЮ
Dialogue: 0,0:10:34.17,0:10:40.57,Caption,,0,0,0,,НИКУДА НЕ ИСЧЕЗАЮТ. КОГДА СУДЬБА СТРАНЫ СЛИШКОМ ДОЛГО ЗАВИСИТ ОТ РЕШЕНИЙ
Dialogue: 0,0:10:40.57,0:10:43.37,Caption,,0,0,0,,ЛЮДЕЙ В ВАШИНГТОНЕ, БРЮССЕЛЕ И КАЛИФОРНИИ,
Dialogue: 0,0:10:43.74,0:10:48.17,Caption,,0,0,0,,ОДНАЖДЫ МОЖНО ОБНАРУЖИТЬ, ЧТО СТАРЫЕ ДРУЗЬЯ УЖЕ ОБСУЖДАЮТ СЛЕДУЮЩИЙ ПОРЯДОК
Dialogue: 0,0:10:48.25,0:10:50.81,Caption,,0,0,0,,БЕЗ ТЕБЯ. И ВЭНС В САМОМ КОНЦЕ ЭТОЙ
Dialogue: 0,0:10:50.81,0:10:54.01,Caption,,0,0,0,,ЦЕПОЧКИ НУЖЕН ИМЕННО ПОЭТОМУ. ОН НАПОМИНАЕТ,
Dialogue: 0,0:10:54.24,0:10:57.29,Caption,,0,0,0,,КАК БЫСТРО БЫВШИЙ ПРОТИВНИК СТАНОВИТСЯ НАСЛЕДНИКОМ,
Dialogue: 0,0:10:57.53,0:11:00.01,Caption,,0,0,0,,А ПРЕЖНИЙ СОЮЗНИК ПРЕВРАЩАЕТСЯ В НЕУДОБНОГО
Dialogue: 0,0:11:00.01,0:11:03.05,Caption,,0,0,0,,ПРОСИТЕЛЯ. В БОЛЬШОЙ ПОЛИТИКЕ БЛАГОДАРНОСТЬ БЫСТРО
Dialogue: 0,0:11:03.05,0:11:05.21,Caption,,0,0,0,,ЗАБЫВАЕТСЯ. ИНТЕРЕСЫ ОСТАЮТСЯ.
