Dialogue: 0,0:00:00.12,0:00:03.40,Caption,,0,0,0,,НУ ВСЁ, ТЕПЕРЬ МОЖНО СПАТЬ СПОКОЙНО. НАМ УЖЕ РАССКАЗАЛИ,
Dialogue: 0,0:00:03.72,0:00:06.28,Caption,,0,0,0,,ЧТО РОССИЙСКОЕ КОМАНДОВАНИЕ СОБИРАЕТСЯ ДЕЛАТЬ. ПРО
Dialogue: 0,0:00:06.36,0:00:09.16,Caption,,0,0,0,,МОСТЫ ЗНАЮТ. ПРО ГОРОДА ЗНАЮТ. ВОЕННЫЕ
Dialogue: 0,0:00:09.16,0:00:13.56,Caption,,0,0,0,,ПРЕДУПРЕЖДЕНЫ, НАСЕЛЕНИЕ ТОЖЕ ПРЕДУПРЕДИЛИ. КРАСОТА. ТОЛЬКО ЕСТЬ
Dialogue: 0,0:00:13.56,0:00:15.64,Caption,,0,0,0,,ОДИН МАЛЕНЬКИЙ ВОПРОС А ДАЛЬШЕ ТО ЧТО?
Dialogue: 0,0:00:16.27,0:00:18.76,Caption,,0,0,0,,ЕСЛИ ВАМ НУЖЕН НЕ ОЧЕРЕДНОЙ ПЕРЕСКАЗ ЗАГОЛОВКОВ,
Dialogue: 0,0:00:18.92,0:00:20.92,Caption,,0,0,0,,А ПОПЫТКА ПОНЯТЬ, ЧТО ЗА НИМИ СТОИТ,
Dialogue: 0,0:00:21.10,0:00:23.48,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:23.63,0:00:26.28,Caption,,0,0,0,,КОГДА ОТДЕЛЬНЫЕ НОВОСТИ ВЫГЛЯДЯТ КУДА ИНТЕРЕСНЕЕ,
Dialogue: 0,0:00:26.44,0:00:31.08,Caption,,0,0,0,,ЕСЛИ ПОСТАВИТЬ ИХ РЯДОМ. ОФИЦЕР УКРАИНСКИХ ШТУРМОВЫХ ВОЙСК ДЕНИС ЯРОСЛАВСКИЙ
Dialogue: 0,0:00:31.08,0:00:34.20,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО РОССИЙСКОЕ КОМАНДОВАНИЕ ЯКОБЫ СОБИРАЕТСЯ
Dialogue: 0,0:00:34.20,0:00:37.08,Caption,,0,0,0,,РАЗРУШИТЬ МОСТЫ ЧЕРЕЗ ДНЕПР И СДЕЛАТЬ КРУПНЫЕ
Dialogue: 0,0:00:37.08,0:00:40.04,Caption,,0,0,0,,УКРАИНСКИЕ ГОРОДА НЕПРИГОДНЫМИ ДЛЯ ЖИЗНИ. ПРИКАЗА
Dialogue: 0,0:00:40.04,0:00:43.00,Caption,,0,0,0,,НАМ НИКТО НЕ ПОКАЗАЛ. ДОКУМЕНТА НЕТ. НО САМА
Dialogue: 0,0:00:43.00,0:00:45.80,Caption,,0,0,0,,ТЕМА ПОЯВИЛАСЬ НЕ ВЧЕРА. ЕЩЁ РАНЬШЕ УКРАИНСКАЯ
Dialogue: 0,0:00:45.80,0:00:48.20,Caption,,0,0,0,,СТОРОНА ПРЕДУПРЕЖДАЛА ОБ УГРОЗЕ УДАРА ПО МОСТАМ
Dialogue: 0,0:00:48.28,0:00:51.24,Caption,,0,0,0,,ЧЕРЕЗ ДНЕПР. А РОССИЙСКИЙ ГЕНШТАБ ПУБЛИЧНО ГОВОРИЛ
Dialogue: 0,0:00:51.32,0:00:54.28,Caption,,0,0,0,,ОБ УДАРАХ ПО СТРАТЕГИЧЕСКИМ МОСТАМ И ЖЕЛЕЗНОДОРОЖНЫМ
Dialogue: 0,0:00:54.28,0:00:56.92,Caption,,0,0,0,,УЗЛАМ, КОТОРЫЕ ИСПОЛЬЗУЮТСЯ В ИНТЕРЕСАХ ВСУ.
Dialogue: 0,0:00:57.48,0:00:59.72,Caption,,0,0,0,,ТО ЕСТЬ САМ СМЫСЛ ЗДЕСЬ КАКОЙ ТО СЕНСАЦИЕЙ
Dialogue: 0,0:00:59.80,0:01:03.32,Caption,,0,0,0,,НЕ ЯВЛЯЕТСЯ. МОСТ НА ВОЙНЕ, ПРОСТИТЕ ЗА БАНАЛЬНОСТЬ,
Dialogue: 0,0:01:03.57,0:01:06.52,Caption,,0,0,0,,НЕ ПАМЯТНИК АРХИТЕКТУРЫ. ЧЕРЕЗ НЕГО ИДУТ ЛЮДИ,
Dialogue: 0,0:01:06.60,0:01:13.52,Caption,,0,0,0,,ТЕХНИКА, ГРУЗЫ, ТОПЛИВО. ЕСЛИ ХОЧЕШЬ ЗАТРУДНИТЬ СНАБЖЕНИЕ ПРОТИВНИКА,
Dialogue: 0,0:01:13.76,0:01:15.92,Caption,,0,0,0,,БЬЁШЬ ПО ДОРОГАМ, ЖЕЛЕЗНОЙ ДОРОГЕ,
Dialogue: 0,0:01:16.00,0:01:19.04,Caption,,0,0,0,,УЗЛАМ И ПЕРЕПРАВАМ. ЭТОЙ ФОРМУЛЕ НЕ СТО ЛЕТ
Dialogue: 0,0:01:19.12,0:01:21.76,Caption,,0,0,0,,И ДАЖЕ НЕ ДВЕСТИ. ПОЭТОМУ ДОЛГО РАССУЖДАТЬ О
Dialogue: 0,0:01:21.76,0:01:25.04,Caption,,0,0,0,,ТОМ, ЗАЧЕМ КОМУ ТО ПОНАДОБИЛИСЬ МОСТЫ ЧЕРЕЗ ДНЕПР,
Dialogue: 0,0:01:25.12,0:01:29.44,Caption,,0,0,0,,СМЫСЛА НЕТ. ГОРАЗДО ИНТЕРЕСНЕЕ ДРУГОЕ. УКРАИНЦАМ СЕЙЧАС ОЧЕНЬ
Dialogue: 0,0:01:29.52,0:01:33.12,Caption,,0,0,0,,ПОДРОБНО РАССКАЗЫВАЮТ, ЧТО РОССИЙСКОЕ КОМАНДОВАНИЕ СОБИРАЕТСЯ ДЕЛАТЬ
Dialogue: 0,0:01:33.20,0:01:35.60,Caption,,0,0,0,,ДАЛЬШЕ. МЫ ЗНАЕМ ПРО МОСТЫ. МЫ ЗНАЕМ ПРО
Dialogue: 0,0:01:35.60,0:01:38.56,Caption,,0,0,0,,ЭНЕРГЕТИКУ. МЫ ЗНАЕМ ПРО КРУПНЫЕ ГОРОДА. МЫ ВСЁ
Dialogue: 0,0:01:38.56,0:01:41.04,Caption,,0,0,0,,ЗНАЕМ. И ВОТ ЗДЕСЬ ВОЗНИКАЕТ ОЧЕНЬ УДОБНАЯ
Dialogue: 0,0:01:41.04,0:01:43.76,Caption,,0,0,0,,КОНСТРУКЦИЯ. ЕСЛИ ДАЛЬШЕ ДЕЙСТВИТЕЛЬНО СТАНОВИТСЯ
Dialogue: 0,0:01:43.84,0:01:46.40,Caption,,0,0,0,,ХУЖЕ, ВСЕГДА МОЖНО РАЗВЕСТИ РУКАМИ И СКАЗАТЬ А МЫ
Dialogue: 0,0:01:46.48,0:01:49.76,Caption,,0,0,0,,ВАС ПРЕДУПРЕЖДАЛИ. МЫ ЗНАЛИ. МЫ ГОВОРИЛИ. НИКТО
Dialogue: 0,0:01:49.84,0:01:52.16,Caption,,0,0,0,,НИЧЕГО НЕ СКРЫВАЛ. ИНФОРМАЦИОННО ВСЁ ПРОСТО
Dialogue: 0,0:01:52.16,0:01:55.12,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНО. ТОЛЬКО ЖИТЕЛЮ КИЕВА ОТ ЭТОГО ЗНАНИЯ НИ
Dialogue: 0,0:01:55.20,0:01:58.00,Caption,,0,0,0,,ХОЛОДНО НИ ЖАРКО. ЕМУ НЕ ДОКЛАД РАЗВЕДКИ НУЖЕН.
Dialogue: 0,0:01:58.18,0:02:02.16,Caption,,0,0,0,,ЕМУ НУЖЕН СВЕТ. ВОДА. ТРАНСПОРТ. ОТОПЛЕНИЕ. ЕМУ
Dialogue: 0,0:02:02.16,0:02:06.16,Caption,,0,0,0,,НУЖНО ПОНИМАТЬ, СМОЖЕТ ЛИ ГОРОД РАБОТАТЬ ДАЛЬШЕ. ПОТОМУ ЧТО ЗНАТЬ
Dialogue: 0,0:02:06.16,0:02:08.72,Caption,,0,0,0,,ПЛАН ПРОТИВНИКА И ИМЕТЬ ВОЗМОЖНОСТЬ ЕГО СОРВАТЬ,
Dialogue: 0,0:02:08.95,0:02:11.84,Caption,,0,0,0,,ЭТО ДВЕ СОВЕРШЕННО РАЗНЫЕ ВЕЩИ. МОЖНО ХОТЬ КАЖДОЕ
Dialogue: 0,0:02:11.84,0:02:14.24,Caption,,0,0,0,,УТРО ВЫПУСКАТЬ ПРОГНОЗ СЕГОДНЯ ПРОТИВНИК ХОЧЕТ
Dialogue: 0,0:02:14.24,0:02:16.48,Caption,,0,0,0,,СДЕЛАТЬ ВОТ ЭТО, ЗАВТРА ВОТ ЭТО,
Dialogue: 0,0:02:16.64,0:02:19.44,Caption,,0,0,0,,ПОСЛЕЗАВТРА ЕЩЁ ЧТО НИБУДЬ. ОТ ОДНОГО КОЛИЧЕСТВА
Dialogue: 0,0:02:19.52,0:02:21.76,Caption,,0,0,0,,ПРОГНОЗОВ СИСТЕМ ПВО БОЛЬШЕ НЕ СТАНОВИТСЯ.
Dialogue: 0,0:02:24.06,0:02:26.62,Caption,,0,0,0,,И ВОТ ТУТ ВСЯ ИСТОРИЯ ПРО ОСВЕДОМЛЁННОСТЬ НАЧИНАЕТ
Dialogue: 0,0:02:26.62,0:02:28.62,Caption,,0,0,0,,ВЫГЛЯДЕТЬ НЕМНОГО ИНАЧЕ. СМОТРИТЕ,
Dialogue: 0,0:02:28.85,0:02:31.26,Caption,,0,0,0,,МЫ ВСЁ ЗНАЕМ. ПРЕКРАСНО. А ЗАЩИТИТЬ?
Dialogue: 0,0:02:31.89,0:02:34.85,Caption,,0,0,0,,ВОТ ЗДЕСЬ УЖЕ РАЗГОВОР ПОЧЕМУ ТО КОРОЧЕ. НАРОДНЫЙ
Dialogue: 0,0:02:34.85,0:02:37.82,Caption,,0,0,0,,ДЕПУТАТ ВЛАДИМИР КРЕЙДЕНКО ОТДЕЛЬНО ПРЕДУПРЕЖДАЕТ,
Dialogue: 0,0:02:38.00,0:02:40.62,Caption,,0,0,0,,ЧТО КИЕВ ПРИ ТЯЖЁЛОМ РАЗВИТИИ СОБЫТИЙ РИСКУЕТ
Dialogue: 0,0:02:40.62,0:02:42.29,Caption,,0,0,0,,СТОЛКНУТЬСЯ С ПРОБЛЕМАМИ МОСТОВ,
Dialogue: 0,0:02:42.38,0:02:45.26,Caption,,0,0,0,,МЕТРО И ЭЛЕКТРИЧЕСТВА. ГОРОД МОЖЕТ ОКАЗАТЬСЯ
Dialogue: 0,0:02:45.26,0:02:48.06,Caption,,0,0,0,,ФАКТИЧЕСКИ РАЗДЕЛЁННЫМ НА ЧАСТИ. И ОПЯТЬ ЖЕ,
Dialogue: 0,0:02:48.38,0:02:50.70,Caption,,0,0,0,,НЕ НАДО УСТРАИВАТЬ ДВАДЦАТИМИНУТНУЮ ЛЕКЦИЮ О
Dialogue: 0,0:02:50.70,0:02:54.14,Caption,,0,0,0,,МОСТОСТРОЕНИИ. МЫ ЭТО УЖЕ ПРОХОДИЛИ. ВАЖНЕЕ САМА
Dialogue: 0,0:02:54.14,0:02:57.26,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТЬ. СНАЧАЛА ПРЕДУПРЕЖДЕНИЕ. ПОТОМ
Dialogue: 0,0:02:57.26,0:02:59.90,Caption,,0,0,0,,ЕЩЁ ПРЕДУПРЕЖДЕНИЕ. ПОТОМ ОБЪЯСНЕНИЕ,
Dialogue: 0,0:03:00.14,0:03:02.14,Caption,,0,0,0,,ЧТО СТОЛИЦА МОЖЕТ ОСТАТЬСЯ БЕЗ ПРИВЫЧНОЙ
Dialogue: 0,0:03:02.22,0:03:04.78,Caption,,0,0,0,,ТРАНСПОРТНОЙ СВЯЗНОСТИ. ПОТОМ РАЗГОВОР О ТОМ,
Dialogue: 0,0:03:05.01,0:03:07.74,Caption,,0,0,0,,ЧТО КРУПНЫЕ ГОРОДА ЗИМОЙ ВООБЩЕ МОГУТ СТОЛКНУТЬСЯ С
Dialogue: 0,0:03:07.74,0:03:10.94,Caption,,0,0,0,,КРИТИЧЕСКИМИ УСЛОВИЯМИ. ЯРОСЛАВСКИЙ НАЗЫВАЕТ КИЕВ,
Dialogue: 0,0:03:11.05,0:03:13.90,Caption,,0,0,0,,ХАРЬКОВ И ОДЕССУ И ГОВОРИТ О НЕОБХОДИМОСТИ
Dialogue: 0,0:03:13.90,0:03:17.34,Caption,,0,0,0,,ДОГОВОРИТЬСЯ О ПРЕКРАЩЕНИИ ОГНЯ ЭТОЙ ЗИМОЙ. ОБРАТИТЕ
Dialogue: 0,0:03:17.34,0:03:20.62,Caption,,0,0,0,,ВНИМАНИЕ НА ФОРМУЛИРОВКУ. НЕ О БОЛЬШОМ ОКОНЧАТЕЛЬНОМ
Dialogue: 0,0:03:20.62,0:03:25.66,Caption,,0,0,0,,МИРЕ. НЕ О ТОМ, ЧТО ВСЕ ВОПРОСЫ РЕШЕНЫ. ПРЕКРАЩЕНИЕ ОГНЯ. ТО ЕСТЬ
Dialogue: 0,0:03:25.74,0:03:28.54,Caption,,0,0,0,,ОПЯТЬ ВОЗВРАЩАЕМСЯ К СТАРОЙ ИСТОРИИ. ОСТАНОВИТЬСЯ
Dialogue: 0,0:03:28.62,0:03:32.14,Caption,,0,0,0,,СЕЙЧАС, А ДАЛЬШЕ РАЗБИРАТЬСЯ ПОТОМ. И ЗДЕСЬ УКРАИНСКИЕ
Dialogue: 0,0:03:32.14,0:03:34.30,Caption,,0,0,0,,ЗАЯВЛЕНИЯ НАЧИНАЮТ РАБОТАТЬ СРАЗУ В ДВУХ
Dialogue: 0,0:03:34.30,0:03:36.22,Caption,,0,0,0,,НАПРАВЛЕНИЯХ. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:03:36.46,0:03:38.70,Caption,,0,0,0,,НАСЕЛЕНИЮ ОБЪЯСНЯЮТ МАСШТАБ УГРОЗЫ.
Dialogue: 0,0:03:40.98,0:03:44.42,Caption,,0,0,0,,С ДРУГОЙ, ЗАРАНЕЕ СОЗДАЁТСЯ ОТВЕТ НА БУДУЩИЙ ВОПРОС КАК ЖЕ
Dialogue: 0,0:03:44.42,0:03:48.74,Caption,,0,0,0,,ТАК ПОЛУЧИЛОСЬ? А ВОТ ТАК. МЫ ПРЕДУПРЕЖДАЛИ. МЫ ЗНАЛИ. ВРАГ
Dialogue: 0,0:03:48.82,0:03:51.54,Caption,,0,0,0,,ХОТЕЛ ИМЕННО ЭТОГО. ТУТ ГЛАВНОЕ НЕ ПЕРЕПУТАТЬ
Dialogue: 0,0:03:51.54,0:03:54.42,Caption,,0,0,0,,ПРЕДУПРЕЖДЕНИЕ С ЗАЩИТОЙ. ПОТОМУ ЧТО ФРАЗА "МЫ
Dialogue: 0,0:03:54.42,0:03:56.66,Caption,,0,0,0,,ЗНАЛИ, ЧТО СЮДА ПРИЛЕТИТ" ПОСЛЕ ТОГО,
Dialogue: 0,0:03:56.83,0:03:59.94,Caption,,0,0,0,,КАК ТУДА ПРИЛЕТЕЛО, ЗВУЧИТ, МЯГКО ГОВОРЯ,
Dialogue: 0,0:04:00.10,0:04:02.98,Caption,,0,0,0,,НЕ КАК БЛЕСТЯЩИЙ ОТЧЁТ О ПРОДЕЛАННОЙ РАБОТЕ. НО
Dialogue: 0,0:04:02.98,0:04:05.06,Caption,,0,0,0,,МОСТАМИ И ЭЛЕКТРИЧЕСТВОМ ЭТА ИСТОРИЯ УЖЕ НЕ
Dialogue: 0,0:04:05.06,0:04:08.18,Caption,,0,0,0,,ЗАКАНЧИВАЕТСЯ. УКРАИНСКИЕ СМИ СО ССЫЛКОЙ НА ИСТОЧНИК
Dialogue: 0,0:04:08.26,0:04:10.98,Caption,,0,0,0,,В ВОЕННОЙ РАЗВЕДКЕ ТЕПЕРЬ РАССКАЗЫВАЮТ ЕЩЁ ОБ ОДНОМ
Dialogue: 0,0:04:10.98,0:04:13.30,Caption,,0,0,0,,ПРЕДПОЛАГАЕМОМ НАПРАВЛЕНИИ РОССИЙСКИХ УДАРОВ.
Dialogue: 0,0:04:13.70,0:04:16.50,Caption,,0,0,0,,ПИЩЕВАЯ ПРОМЫШЛЕННОСТЬ. В СПИСКЕ НАЗЫВАЮТСЯ
Dialogue: 0,0:04:16.50,0:04:21.23,Caption,,0,0,0,,ЭЛЕВАТОРЫ, ЗЕРНОХРАНИЛИЩА, ПРЕДПРИЯТИЯ ПО ПЕРЕРАБОТКЕ СЕЛЬХОЗПРОДУКЦИИ,
Dialogue: 0,0:04:21.42,0:04:23.30,Caption,,0,0,0,,ПРОИЗВОДСТВО РАСТИТЕЛЬНОГО МАСЛА,
Dialogue: 0,0:04:23.46,0:04:26.10,Caption,,0,0,0,,МОЛОЧНЫЕ ПРЕДПРИЯТИЯ, МЯСОКОМБИНАТЫ,
Dialogue: 0,0:04:26.19,0:04:29.54,Caption,,0,0,0,,ПТИЦЕФАБРИКИ. СПИСОК ТАКОЙ, ЧТО ЕЩЁ НЕМНОГО,
Dialogue: 0,0:04:29.66,0:04:32.42,Caption,,0,0,0,,И ОСТАНЕТСЯ ДОБАВИТЬ БУЛОЧНУЮ ВОЗЛЕ ДОМА. ПРИЧЁМ
Dialogue: 0,0:04:32.42,0:04:35.06,Caption,,0,0,0,,САМА УКРАИНСКАЯ ВЕРСИЯ ОБЪЯСНЯЕТ ПРЕДПОЛАГАЕМЫЙ
Dialogue: 0,0:04:35.14,0:04:37.86,Caption,,0,0,0,,РАСЧЁТ СРАЗУ ШИРОКО. УДАР ПО ПРОДОВОЛЬСТВЕННОЙ
Dialogue: 0,0:04:37.86,0:04:40.18,Caption,,0,0,0,,БЕЗОПАСНОСТИ, УЩЕРБ ЭКОНОМИКЕ,
Dialogue: 0,0:04:40.35,0:04:43.54,Caption,,0,0,0,,СОКРАЩЕНИЕ ВАЛЮТНЫХ ПОСТУПЛЕНИЙ. ПЛЮС КОНКУРЕНЦИЯ
Dialogue: 0,0:04:43.54,0:04:45.94,Caption,,0,0,0,,РОССИИ С УКРАИНСКИМ СЕЛЬХОЗЭКСПОРТОМ НА РЫНКАХ
Dialogue: 0,0:04:45.95,0:04:49.70,Caption,,0,0,0,,АФРИКИ, БЛИЖНЕГО ВОСТОКА И АЗИИ. ТО ЕСТЬ НАМ ПРЕДЛАГАЮТ
Dialogue: 0,0:04:49.79,0:04:51.38,Caption,,0,0,0,,УЖЕ НЕ ПРОСТО ВОЕННУЮ КАРТИНУ.
Dialogue: 0,0:04:53.66,0:04:57.02,Caption,,0,0,0,,НАМ РИСУЮТ СЦЕНАРИЙ, ГДЕ ДАВЛЕНИЕ ИДЁТ ПО ВСЕМУ ТОМУ,
Dialogue: 0,0:04:57.20,0:05:00.62,Caption,,0,0,0,,НА ЧЁМ СТРАНА ЖИВЁТ КАЖДЫЙ ДЕНЬ. СВЕТ. ТРАНСПОРТ.
Dialogue: 0,0:05:00.77,0:05:05.26,Caption,,0,0,0,,МОСТЫ. ПРЕДПРИЯТИЯ. ЕДА. И ТУТ Я БЫ ОБРАТИЛ ВНИМАНИЕ НЕ НА
Dialogue: 0,0:05:05.34,0:05:08.30,Caption,,0,0,0,,СТРАШНЫЙ СПИСОК САМ ПО СЕБЕ. СПИСКИ ПИСАТЬ УМЕЮТ
Dialogue: 0,0:05:08.38,0:05:11.42,Caption,,0,0,0,,ВСЕ. ВОПРОС В ДРУГОМ. ПОЧЕМУ ИМЕННО СЕЙЧАС
Dialogue: 0,0:05:11.42,0:05:14.38,Caption,,0,0,0,,УКРАИНСКОЕ ИНФОРМАЦИОННОЕ ПОЛЕ ВСЁ ЧАЩЕ ПЕРЕВОДЯТ ИЗ
Dialogue: 0,0:05:14.46,0:05:18.22,Caption,,0,0,0,,РЕЖИМА "МЫ СПРАВИМСЯ" В РЕЖИМ "БУДЕТ ОЧЕНЬ ТЯЖЕЛО,
Dialogue: 0,0:05:18.38,0:05:19.90,Caption,,0,0,0,,НО МЫ ВАС ЗАРАНЕЕ ПРЕДУПРЕДИЛИ"?
Dialogue: 0,0:05:20.12,0:05:23.10,Caption,,0,0,0,,ПОТОМУ ЧТО ЕЩЁ НЕДАВНО ЛЮБАЯ НЕПРИЯТНАЯ ПЕРСПЕКТИВА
Dialogue: 0,0:05:23.10,0:05:25.58,Caption,,0,0,0,,ОБЪЯСНЯЛАСЬ СОВЕРШЕННО ИНАЧЕ. А ТЕПЕРЬ
Dialogue: 0,0:05:25.58,0:05:27.42,Caption,,0,0,0,,ПРЕДУПРЕЖДЕНИЙ СТАНОВИТСЯ СТОЛЬКО,
Dialogue: 0,0:05:27.58,0:05:29.82,Caption,,0,0,0,,ЧТО СКОРО ДЛЯ НИХ ОТДЕЛЬНЫЙ ГРАФИК ПРИДЁТСЯ
Dialogue: 0,0:05:29.82,0:05:33.58,Caption,,0,0,0,,СОСТАВЛЯТЬ. В ПОНЕДЕЛЬНИК МОСТЫ. ВО ВТОРНИК СВЕТ. В
Dialogue: 0,0:05:33.58,0:05:36.86,Caption,,0,0,0,,СРЕДУ ГОРОДА. В ЧЕТВЕРГ МОЛОЧНЫЙ ЗАВОД. В ПЯТНИЦУ
Dialogue: 0,0:05:36.94,0:05:40.86,Caption,,0,0,0,,УЖЕ МОЖНО ОТДЫХАТЬ, ВСЁ РАВНО НАСЕЛЕНИЕ ПРЕДУПРЕЖДЕНО. И ВОТ НА ЭТОМ
Dialogue: 0,0:05:40.86,0:05:43.98,Caption,,0,0,0,,ФОНЕ ПОЯВЛЯЮТСЯ НОВОСТИ СОВСЕМ ДРУГОГО ТИПА. ПРО
Dialogue: 0,0:05:43.98,0:05:47.10,Caption,,0,0,0,,ЛЮДЕЙ. ОФИЦЕР ВСУ АНДРЕЙ ОНИСТРАТ ПРЕДЛАГАЕТ
Dialogue: 0,0:05:47.10,0:05:49.74,Caption,,0,0,0,,ЗАПРЕТИТЬ УКРАИНЦАМ ВЫЕЗЖАТЬ ЗА ГРАНИЦУ УЖЕ С
Dialogue: 0,0:05:49.74,0:05:52.78,Caption,,0,0,0,,ПЯТНАДЦАТИ ЛЕТ. С ПЯТНАДЦАТИ. НЕ С ВОЗРАСТА
Dialogue: 0,0:05:52.78,0:05:56.22,Caption,,0,0,0,,МОБИЛИЗАЦИИ. НЕ КОГДА ЧЕЛОВЕК УЖЕ ВОЕННООБЯЗАННЫЙ. С
Dialogue: 0,0:05:56.22,0:05:59.42,Caption,,0,0,0,,ПЯТНАДЦАТИ. ОБЪЯСНЕНИЕ У НЕГО ПРОСТОЕ. МОЛОДЁЖЬ
Dialogue: 0,0:05:59.50,0:06:01.98,Caption,,0,0,0,,УЕЗЖАЕТ. В СТАРШИХ КЛАССАХ СТАНОВИТСЯ МЕНЬШЕ
Dialogue: 0,0:06:01.98,0:06:05.10,Caption,,0,0,0,,МАЛЬЧИКОВ. УЕЗЖАЮТ СПЕЦИАЛИСТЫ. В ТОМ ЧИСЛЕ ЛЮДИ С
Dialogue: 0,0:06:05.10,0:06:07.82,Caption,,0,0,0,,ХОРОШИМ ОБРАЗОВАНИЕМ. И ЗДЕСЬ УЖЕ РАЗГОВОР НЕ ПРО
Dialogue: 0,0:06:07.90,0:06:12.49,Caption,,0,0,0,,СЕГОДНЯШНЮЮ ПОВЕСТКУ. ЭТО РАЗГОВОР ПРО ТО,
Dialogue: 0,0:06:12.71,0:06:15.13,Caption,,0,0,0,,КТО ВООБЩЕ ОСТАНЕТСЯ В СТРАНЕ ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ.
Dialogue: 0,0:06:15.53,0:06:17.21,Caption,,0,0,0,,ЕСЛИ ПАРЕНЬ УЕХАЛ В ПЯТНАДЦАТЬ,
Dialogue: 0,0:06:17.45,0:06:19.45,Caption,,0,0,0,,ПОТОМ ЗАКОНЧИЛ ШКОЛУ В ДРУГОЙ СТРАНЕ,
Dialogue: 0,0:06:19.69,0:06:22.49,Caption,,0,0,0,,ПОСТУПИЛ ТАМ В УНИВЕРСИТЕТ, НАШЁЛ РАБОТУ,
Dialogue: 0,0:06:22.65,0:06:26.17,Caption,,0,0,0,,ЗАВЁЛ СЕМЬЮ, ТО ЧЕРЕЗ ДЕСЯТЬ ЛЕТ ПРИЗЫВ "ВОЗВРАЩАЙСЯ,
Dialogue: 0,0:06:26.33,0:06:28.65,Caption,,0,0,0,,РОДИНА ЖДЁТ" МОЖЕТ ВЫЗВАТЬ У НЕГО МНОГО РАЗНЫХ
Dialogue: 0,0:06:28.65,0:06:31.45,Caption,,0,0,0,,ЭМОЦИЙ. НО ЧЕМОДАН ОН ОТ ЭТОГО АВТОМАТИЧЕСКИ НЕ
Dialogue: 0,0:06:31.45,0:06:35.05,Caption,,0,0,0,,СОБЕРЁТ. ПОЭТОМУ ИДЕЯ ОЧЕНЬ ПРОСТАЯ. НЕ ВЫПУСКАТЬ.
Dialogue: 0,0:06:35.34,0:06:39.21,Caption,,0,0,0,,ЕСТЬ ПРОБЛЕМА УТЕЧКИ ЛЮДЕЙ? ЗАКРЫВАЕМ КРАН. ЕСТЬ ПОДРОСТКИ,
Dialogue: 0,0:06:39.29,0:06:42.41,Caption,,0,0,0,,КОТОРЫЕ ХОТЯТ УЕХАТЬ? ЗНАЧИТ, НАДО СДЕЛАТЬ ТАК,
Dialogue: 0,0:06:42.49,0:06:48.17,Caption,,0,0,0,,ЧТОБЫ НЕ ХОТЕЛИ... ТОЧНЕЕ, ЧТОБЫ НЕ МОГЛИ. КРАСИВО. РАБОТА С ПРИЧИНОЙ ПРОБЛЕМЫ
Dialogue: 0,0:06:48.25,0:06:51.45,Caption,,0,0,0,,ОТМЕНЯЕТСЯ. РАБОТАЕМ С ДВЕРЬЮ. И ВОТ ЗДЕСЬ ВОЗНИКАЕТ
Dialogue: 0,0:06:51.46,0:06:54.65,Caption,,0,0,0,,ОЧЕНЬ НЕПРИЯТНОЕ СОСЕДСТВО ДВУХ НОВОСТЕЙ. С ОДНОЙ
Dialogue: 0,0:06:54.65,0:06:56.49,Caption,,0,0,0,,СТОРОНЫ, НАСЕЛЕНИЮ РАССКАЗЫВАЮТ,
Dialogue: 0,0:06:56.74,0:06:59.37,Caption,,0,0,0,,ЧТО КРУПНЫЕ ГОРОДА МОГУТ СТОЛКНУТЬСЯ С ТЯЖЕЛЕЙШИМИ
Dialogue: 0,0:06:59.37,0:07:03.61,Caption,,0,0,0,,УСЛОВИЯМИ. С ДРУГОЙ, ПРЕДЛАГАЮТ УЖЕ С ПЯТНАДЦАТИ ЛЕТ ОГРАНИЧИТЬ
Dialogue: 0,0:07:03.61,0:07:06.17,Caption,,0,0,0,,ВОЗМОЖНОСТЬ УЕХАТЬ. ТО ЕСТЬ ЧЕЛОВЕК ЕЩЁ ШКОЛУ НЕ
Dialogue: 0,0:07:06.17,0:07:09.45,Caption,,0,0,0,,ЗАКОНЧИЛ, НО ГОСУДАРСТВО УЖЕ ЗАРАНЕЕ ИНТЕРЕСУЕТСЯ,
Dialogue: 0,0:07:09.69,0:07:12.33,Caption,,0,0,0,,НЕ СЛИШКОМ ЛИ ДАЛЕКО ОН СОБРАЛСЯ. А ДАЛЬШЕ
Dialogue: 0,0:07:12.33,0:07:15.53,Caption,,0,0,0,,ЕЩЁ ИНТЕРЕСНЕЕ. РОССИЙСКАЯ СВР ЗАЯВЛЯЕТ,
Dialogue: 0,0:07:15.77,0:07:18.17,Caption,,0,0,0,,ЧТО В ЕВРОПЕЙСКОМ СОЮЗЕ ОБСУЖДАЮТ МЕРЫ,
Dialogue: 0,0:07:18.45,0:07:20.97,Caption,,0,0,0,,КОТОРЫЕ ДОЛЖНЫ ПОДТОЛКНУТЬ УКРАИНСКИХ МУЖЧИН К
Dialogue: 0,0:07:20.97,0:07:25.98,Caption,,0,0,0,,ВОЗВРАЩЕНИЮ ДОМОЙ. ПО ВЕРСИИ РОССИЙСКОЙ РАЗВЕДКИ,
Dialogue: 0,0:07:26.07,0:07:28.94,Caption,,0,0,0,,РЕЧЬ ИДЁТ О БОЛЕЕ ЧЕМ МИЛЛИОНЕ УКРАИНСКИХ МУЖЧИН,
Dialogue: 0,0:07:29.18,0:07:32.30,Caption,,0,0,0,,НАХОДЯЩИХСЯ В СТРАНАХ ЕС. ТАКЖЕ УТВЕРЖДАЕТСЯ,
Dialogue: 0,0:07:32.54,0:07:35.02,Caption,,0,0,0,,ЧТО ИМ СОБИРАЮТСЯ УСЛОЖНЯТЬ ТРУДОУСТРОЙСТВО И АРЕНДУ
Dialogue: 0,0:07:35.02,0:07:38.94,Caption,,0,0,0,,ЖИЛЬЯ. ОТДЕЛЬНОГО ПОДТВЕРЖДЁННОГО РЕШЕНИЯ ЕВРОСОЮЗА НА ЭТОТ
Dialogue: 0,0:07:38.94,0:07:41.66,Caption,,0,0,0,,СЧЁТ В ЭТИХ МАТЕРИАЛАХ НЕТ. НО САМА ЛОГИКА
Dialogue: 0,0:07:41.74,0:07:44.30,Caption,,0,0,0,,ТАКОЙ КОНСТРУКЦИИ ПОНЯТНА БЕЗ ДВАДЦАТИ ЭКСПЕРТОВ
Dialogue: 0,0:07:44.30,0:07:47.02,Caption,,0,0,0,,ВОКРУГ КРУГЛОГО СТОЛА. ЕСЛИ ЕВРОПЕЙСКИЕ СТРАНЫ
Dialogue: 0,0:07:47.02,0:07:49.42,Caption,,0,0,0,,НАМЕРЕНЫ ДАЛЬШЕ ПОДДЕРЖИВАТЬ ПРОДОЛЖЕНИЕ БОЕВЫХ
Dialogue: 0,0:07:49.42,0:07:53.26,Caption,,0,0,0,,ДЕЙСТВИЙ УКРАИНОЙ, ВОПРОС ЛЮДЕЙ НИКУДА НЕ ИСЧЕЗАЕТ. ДЕНЬГИ МОЖНО
Dialogue: 0,0:07:53.26,0:07:56.54,Caption,,0,0,0,,ВЫДЕЛИТЬ. ОРУЖИЕ МОЖНО ПЕРЕДАТЬ. БОЕПРИПАСЫ МОЖНО
Dialogue: 0,0:07:56.54,0:07:59.58,Caption,,0,0,0,,ПРОИЗВЕСТИ. А ЧЕЛОВЕКА НА СКЛАДЕ НЕ ВОЗЬМЁШЬ. И
Dialogue: 0,0:07:59.58,0:08:02.06,Caption,,0,0,0,,ТОГДА НЕИЗБЕЖНО ВОЗНИКАЕТ ВОПРОС А ЧТО ДЕЛАТЬ С
Dialogue: 0,0:08:02.14,0:08:05.42,Caption,,0,0,0,,УКРАИНСКИМИ МУЖЧИНАМИ, КОТОРЫЕ УЖЕ НАХОДЯТСЯ В ЕВРОПЕ?
Dialogue: 0,0:08:05.57,0:08:08.54,Caption,,0,0,0,,СНАЧАЛА ПРОСИТЬ ВЕРНУТЬСЯ? ПОТОМ СОЗДАВАТЬ УСЛОВИЯ,
Dialogue: 0,0:08:08.69,0:08:10.62,Caption,,0,0,0,,ПРИ КОТОРЫХ ЖИТЬ СТАНОВИТСЯ НЕУДОБНЕЕ?
Dialogue: 0,0:08:10.84,0:08:13.10,Caption,,0,0,0,,ПОТОМ ЖЁСТЧЕ? А ДАЛЬШЕ ГДЕ ГРАНИЦА?
Dialogue: 0,0:08:13.66,0:08:17.90,Caption,,0,0,0,,ВОТ ЗДЕСЬ И НАЧИНАЕТСЯ ТЕМА, КОТОРУЮ СЕЙЧАС ПРЕДПОЧИТАЮТ ОБСУЖДАТЬ ОЧЕНЬ
Dialogue: 0,0:08:17.90,0:08:21.42,Caption,,0,0,0,,ОСТОРОЖНО. ЕСЛИ ЕВРОПА СОБИРАЕТСЯ И ДАЛЬШЕ ПОДДЕРЖИВАТЬ
Dialogue: 0,0:08:21.50,0:08:23.34,Caption,,0,0,0,,ПРОДОЛЖЕНИЕ БОЕВЫХ ДЕЙСТВИЙ УКРАИНОЙ,
Dialogue: 0,0:08:23.59,0:08:26.30,Caption,,0,0,0,,ЕЙ ПОНАДОБИТСЯ ПОПОЛНЯТЬ УКРАИНСКИЙ МОБИЛИЗАЦИОННЫЙ
Dialogue: 0,0:08:26.30,0:08:30.46,Caption,,0,0,0,,РЕСУРС. И МУЖЧИНЫ, КОТОРЫЕ УЖЕ НАХОДЯТСЯ В ЕВРОПЕЙСКИХ СТРАНАХ,
Dialogue: 0,0:08:30.62,0:08:33.26,Caption,,0,0,0,,СТАНОВЯТСЯ ОЧЕВИДНЫМ РЕЗЕРВОМ. СНАЧАЛА БУДУТ
Dialogue: 0,0:08:33.26,0:08:34.78,Caption,,0,0,0,,УБЕЖДАТЬ ВЕРНУТЬСЯ ДОБРОВОЛЬНО.
Dialogue: 0,0:08:37.05,0:08:40.74,Caption,,0,0,0,,ПОТОМ НАЧНУТ ДАВИТЬ. ПОТОМ ЕЩЁ ЖЁСТЧЕ. А ДАЛЬШЕ,
Dialogue: 0,0:08:40.90,0:08:44.26,Caption,,0,0,0,,ПО МОЕМУ ПРОГНОЗУ, ДЕЛО ДОЙДЁТ И ДО СИЛОВОГО ВЫДВОРЕНИЯ.
Dialogue: 0,0:08:44.82,0:08:49.14,Caption,,0,0,0,,НЕ ЗАХОЧЕШЬ ВОЗВРАЩАТЬСЯ САМ, ОТПРАВЯТ ПРИНУДИТЕЛЬНО. И ВОПРОС ЗДЕСЬ УЖЕ НЕ В
Dialogue: 0,0:08:49.14,0:08:52.74,Caption,,0,0,0,,ТОМ, ХОЧЕТ ЧЕЛОВЕК ВОЗВРАЩАТЬСЯ ИЛИ НЕТ. ВОПРОС В ТОМ,
Dialogue: 0,0:08:52.90,0:08:55.62,Caption,,0,0,0,,ДАДУТ ЛИ ЕМУ ВЫБИРАТЬ. ВОТ ВАМ И ЕВРОПЕЙСКОЕ
Dialogue: 0,0:08:55.62,0:08:59.14,Caption,,0,0,0,,ГОСТЕПРИИМСТВО. СПАСИБО, ЧТО ПРИЕХАЛИ. СПАСИБО,
Dialogue: 0,0:08:59.30,0:09:02.18,Caption,,0,0,0,,ЧТО ПОЖИЛИ. А ТЕПЕРЬ РОДИНА ЗОВЁТ. ПРИЧЁМ САМОЕ
Dialogue: 0,0:09:02.18,0:09:05.94,Caption,,0,0,0,,ИНТЕРЕСНОЕ, ЧТО ВНУТРИ САМОЙ УКРАИНЫ ОДНОВРЕМЕННО ОБСУЖДАЕТСЯ
Dialogue: 0,0:09:05.94,0:09:08.90,Caption,,0,0,0,,ОБРАТНАЯ ПРОБЛЕМА. НАРОДНЫЙ ДЕПУТАТ СЕРГЕЙ КОЗЫРЬ
Dialogue: 0,0:09:09.13,0:09:12.34,Caption,,0,0,0,,ПРЕДЛАГАЕТ ДАТЬ МУЖЧИНАМ, КОТОРЫЕ ВОЗВРАЩАЮТСЯ С ТЕРРИТОРИЙ,
Dialogue: 0,0:09:12.58,0:09:17.14,Caption,,0,0,0,,НЕ ПОДКОНТРОЛЬНЫХ КИЕВУ, ДЕВЯНОСТО ДНЕЙ ОТСРОЧКИ ОТ МОБИЛИЗАЦИИ. ЧТОБЫ
Dialogue: 0,0:09:17.14,0:09:19.30,Caption,,0,0,0,,ЧЕЛОВЕК УСПЕЛ ПРИЕХАТЬ, УСТРОИТЬСЯ,
Dialogue: 0,0:09:19.46,0:09:22.18,Caption,,0,0,0,,НАЙТИ РАБОТУ С БРОНИРОВАНИЕМ. А ЕСЛИ НЕ НАШЁЛ,
Dialogue: 0,0:09:22.30,0:09:25.14,Caption,,0,0,0,,ТОГДА УЖЕ ДАЛЬШЕ ПО ИЗВЕСТНОМУ АДРЕСУ. И ПОЛУЧАЕТСЯ
Dialogue: 0,0:09:25.14,0:09:27.54,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ КОНСТРУКЦИЯ. С ОДНОЙ СТОРОНЫ,
Dialogue: 0,0:09:27.66,0:09:32.42,Caption,,0,0,0,,ЛЮДЕЙ НАДО ВЕРНУТЬ. С ДРУГОЙ, ОНИ ВОЗВРАЩАТЬСЯ БОЯТСЯ. ТОГДА ИМ ГОВОРЯТ НЕ
Dialogue: 0,0:09:32.42,0:09:36.10,Caption,,0,0,0,,ПЕРЕЖИВАЙТЕ, ДЕВЯНОСТО ДНЕЙ ВАС НЕ ТРОНУТ. ДЕВЯНОСТО. НЕ
Dialogue: 0,0:09:36.10,0:09:39.22,Caption,,0,0,0,,ДЕВЯНОСТО ЛЕТ. НЕ НОВАЯ ЖИЗНЬ. ТРИ МЕСЯЦА. ТО
Dialogue: 0,0:09:39.22,0:09:41.70,Caption,,0,0,0,,ЕСТЬ РЕКЛАМА ВОЗВРАЩЕНИЯ ПОЛУЧАЕТСЯ ПРИМЕРНО ТАКАЯ
Dialogue: 0,0:09:41.70,0:09:44.10,Caption,,0,0,0,,ПРИЕЗЖАЙТЕ, У ВАС БУДЕТ ЦЕЛОЕ ЛЕТО,
Dialogue: 0,0:09:44.26,0:09:46.66,Caption,,0,0,0,,А ПОТОМ РАЗБЕРЁМСЯ. И ТУТ ВОПРОС ПРОСТОЙ А
Dialogue: 0,0:09:46.74,0:09:48.90,Caption,,0,0,0,,С ОТСРОЧКОЙ В ДЕВЯНОСТО ДНЕЙ ОНИ СРАЗУ ПОБЕГУТ
Dialogue: 0,0:09:48.90,0:09:52.62,Caption,,0,0,0,,ОБРАТНО? СИЛЬНО СОМНЕВАЮСЬ,
Dialogue: 0,0:09:52.94,0:09:55.18,Caption,,0,0,0,,ЧТО НА ЕВРОПЕЙСКОМ ВОКЗАЛЕ ПОСЛЕ ТАКОЙ НОВОСТИ
Dialogue: 0,0:09:55.18,0:09:57.90,Caption,,0,0,0,,НАЧНЁТСЯ ДАВКА У КАСС. ПОДПИСЫВАЙТЕСЬ,
Dialogue: 0,0:09:57.98,0:10:00.94,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСЕН ИМЕННО ТАКОЙ РАЗБОР. ПОТОМУ ЧТО
Dialogue: 0,0:10:00.94,0:10:03.10,Caption,,0,0,0,,СЕЙЧАС ЭТИ ИСТОРИИ ПРО ПОДРОСТКОВ,
Dialogue: 0,0:10:03.34,0:10:06.46,Caption,,0,0,0,,МУЖЧИН В ЕВРОПЕ И ДЕВЯНОСТО ДНЕЙ ОТСРОЧКИ ВЫГЛЯДЯТ
Dialogue: 0,0:10:06.54,0:10:11.02,Caption,,0,0,0,,ГОРАЗДО ВАЖНЕЕ, ЧЕМ ОЧЕРЕДНОЕ ГРОМКОЕ ЗАЯВЛЕНИЕ ПОЛИТИКА. ЗДЕСЬ УЖЕ
Dialogue: 0,0:10:11.02,0:10:14.06,Caption,,0,0,0,,НАЧИНАЕТ ПРОЯВЛЯТЬСЯ СОВСЕМ ДРУГАЯ ПРОБЛЕМА. УКРАИНЕ
Dialogue: 0,0:10:14.14,0:10:17.10,Caption,,0,0,0,,НУЖНЫ ЛЮДИ. НЕ КОГДА НИБУДЬ ПОТОМ. НЕ ПОСЛЕ
Dialogue: 0,0:10:17.10,0:10:20.62,Caption,,0,0,0,,КРАСИВОГО МИРНОГО ДОГОВОРА. СЕЙЧАС И ДАЛЬШЕ. НУЖНЫ
Dialogue: 0,0:10:20.70,0:10:26.22,Caption,,0,0,0,,ТЕ, КТО ВОЮЕТ. НУЖНЫ ТЕ, КТО РАБОТАЕТ. НУЖНЫ СПЕЦИАЛИСТЫ. НУЖНЫ МОЛОДЫЕ.
Dialogue: 0,0:10:26.46,0:10:29.90,Caption,,0,0,0,,НУЖНЫ ТЕ, КТО БУДЕТ ПЛАТИТЬ НАЛОГИ ЧЕРЕЗ ПЯТЬ ЛЕТ. И
Dialogue: 0,0:10:29.90,0:10:32.46,Caption,,0,0,0,,ВОТ ВСЯ ЭТА СИСТЕМА НАЧИНАЕТ ОДНОВРЕМЕННО СМОТРЕТЬ
Dialogue: 0,0:10:32.54,0:10:35.34,Caption,,0,0,0,,СРАЗУ В НЕСКОЛЬКО СТОРОН. ПОДРОСТКОВ НЕ ВЫПУСКАТЬ.
Dialogue: 0,0:10:35.57,0:10:39.02,Caption,,0,0,0,,МУЖЧИН ИЗ ЕВРОПЫ ВЕРНУТЬ. ВЕРНУВШИМСЯ ДАТЬ КОРОТКОЕ
Dialogue: 0,0:10:39.02,0:10:41.82,Caption,,0,0,0,,ОКНО, ЧТОБЫ ОНИ ХОТЯ БЫ НЕ РАЗВОРАЧИВАЛИСЬ ОБРАТНО ПРЯМО
Dialogue: 0,0:10:41.90,0:10:44.54,Caption,,0,0,0,,НА ГРАНИЦЕ. А НАСЕЛЕНИЮ КРУПНЫХ ГОРОДОВ В ЭТО
Dialogue: 0,0:10:44.62,0:10:49.02,Caption,,0,0,0,,ЖЕ ВРЕМЯ ОБЪЯСНЯТЬ, ЧТО ВПЕРЕДИ МОГУТ БЫТЬ ОЧЕНЬ ТЯЖЁЛЫЕ МЕСЯЦЫ. ВОТ
Dialogue: 0,0:10:49.10,0:10:51.34,Caption,,0,0,0,,ТУТ УЖЕ НЕ НАДО НИЧЕГО СПЕЦИАЛЬНО ДРАМАТИЗИРОВАТЬ.
Dialogue: 0,0:10:51.58,0:10:54.22,Caption,,0,0,0,,САМА КОНСТРУКЦИЯ ДОСТАТОЧНО ЗАНЯТНАЯ. ЧЕЛОВЕКУ
Dialogue: 0,0:10:54.22,0:10:57.10,Caption,,0,0,0,,ГОВОРЯТ ОСТАВАТЬСЯ ЗДЕСЬ БУДЕТ ТЯЖЕЛО. НО УЕЗЖАТЬ
Dialogue: 0,0:10:57.18,0:10:59.34,Caption,,0,0,0,,ТОЖЕ НЕ НАДО. А ЕСЛИ УЖЕ УЕХАЛ,
Dialogue: 0,0:10:59.58,0:11:02.22,Caption,,0,0,0,,НЕПЛОХО БЫ ВЕРНУТЬСЯ. ПРИЧЁМ ЖЕЛАТЕЛЬНО ДОБРОВОЛЬНО.
Dialogue: 0,0:11:02.54,0:11:07.13,Caption,,0,0,0,,ПОКА ДОБРОВОЛЬНО. И ЭТО КАК РАЗ ТОТ МОМЕНТ,
Dialogue: 0,0:11:07.45,0:11:09.93,Caption,,0,0,0,,ГДЕ ВОПРОС МОБИЛИЗАЦИИ ПЕРЕСТАЁТ БЫТЬ ВОПРОСОМ
Dialogue: 0,0:11:09.93,0:11:14.01,Caption,,0,0,0,,ОДНОГО ТЦК, ОДНОЙ ПОВЕСТКИ ИЛИ ОДНОГО ЗАКОНА. ОН ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:11:14.01,0:11:16.97,Caption,,0,0,0,,ВОПРОС ЧЕЛОВЕЧЕСКОГО РЕСУРСА ВСЕЙ СТРАНЫ. У КОГО
Dialogue: 0,0:11:17.05,0:11:19.93,Caption,,0,0,0,,ЕСТЬ ЛЮДИ? ГДЕ ОНИ НАХОДЯТСЯ? КАК ИХ УДЕРЖАТЬ?
Dialogue: 0,0:11:20.17,0:11:23.21,Caption,,0,0,0,,КАК ВЕРНУТЬ ТЕХ, КТО УЕХАЛ? КАК СДЕЛАТЬ ТАК,
Dialogue: 0,0:11:23.43,0:11:25.61,Caption,,0,0,0,,ЧТОБЫ ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ ВООБЩЕ БЫЛО КОГО
Dialogue: 0,0:11:25.61,0:11:29.29,Caption,,0,0,0,,ВОЗВРАЩАТЬ? ПОЭТОМУ ПРЕДЛОЖЕНИЕ ЗАКРЫВАТЬ ВЫЕЗД С ПЯТНАДЦАТИ ЛЕТ
Dialogue: 0,0:11:29.29,0:11:32.01,Caption,,0,0,0,,ЗДЕСЬ СОВСЕМ НЕ СЛУЧАЙНО ВЫГЛЯДИТ РЯДОМ С РАЗГОВОРОМ
Dialogue: 0,0:11:32.01,0:11:35.53,Caption,,0,0,0,,О МУЖЧИНАХ В ЕВРОПЕ. ОДНО КАСАЕТСЯ БУДУЩЕГО РЕСУРСА.
Dialogue: 0,0:11:35.77,0:11:40.65,Caption,,0,0,0,,ВТОРОЕ КАСАЕТСЯ РЕСУРСА, КОТОРЫЙ УЖЕ УЕХАЛ. А ДЕВЯНОСТОДНЕВНАЯ ОТСРОЧКА
Dialogue: 0,0:11:40.65,0:11:43.61,Caption,,0,0,0,,ПОКАЗЫВАЕТ ТРЕТЬЮ ПРОБЛЕМУ. ЛЮДЕЙ МАЛО ПРОСТО
Dialogue: 0,0:11:43.61,0:11:46.57,Caption,,0,0,0,,ФИЗИЧЕСКИ ВЕРНУТЬ ЧЕРЕЗ ГРАНИЦУ. НУЖНО ЕЩЁ СДЕЛАТЬ
Dialogue: 0,0:11:46.57,0:11:49.93,Caption,,0,0,0,,ТАК, ЧТОБЫ ОНИ САМИ СОГЛАСИЛИСЬ ЭТУ ГРАНИЦУ ПЕРЕСЕЧЬ В
Dialogue: 0,0:11:49.93,0:11:52.89,Caption,,0,0,0,,НУЖНУЮ СТОРОНУ. И ЗДЕСЬ НАЧИНАЕТСЯ БОРЬБА УЖЕ НЕ
Dialogue: 0,0:11:52.97,0:11:56.01,Caption,,0,0,0,,ЗА ТЕРРИТОРИЮ НА КАРТЕ. ЗДЕСЬ НАЧИНАЕТСЯ БОРЬБА ЗА
Dialogue: 0,0:11:56.01,0:11:59.69,Caption,,0,0,0,,ЧЕЛОВЕКА. ЗА ЕГО РЕШЕНИЕ. ЗА ЕГО СТРАХ. ЗА
Dialogue: 0,0:11:59.77,0:12:02.65,Caption,,0,0,0,,ЕГО ВОЗМОЖНОСТЬ УЕХАТЬ. ЗА ЕГО ВОЗМОЖНОСТЬ ОСТАТЬСЯ.
Dialogue: 0,0:12:03.05,0:12:05.85,Caption,,0,0,0,,ЗА ЕГО ГОТОВНОСТЬ ВЕРНУТЬСЯ. И НА ЭТОМ ФОНЕ
Dialogue: 0,0:12:05.85,0:12:08.41,Caption,,0,0,0,,ВСЯ ИСТОРИЯ С ПРЕДУПРЕЖДЕНИЯМИ О МОСТАХ И ГОРОДАХ
Dialogue: 0,0:12:08.41,0:12:11.37,Caption,,0,0,0,,ПРИОБРЕТАЕТ ЕЩЁ ОДИН СМЫСЛ. ПОТОМУ ЧТО НАСЕЛЕНИЮ
Dialogue: 0,0:12:11.37,0:12:14.41,Caption,,0,0,0,,ОДНОВРЕМЕННО СООБЩАЮТ ДВЕ ВЕЩИ. ПЕРВАЯ СИТУАЦИЯ
Dialogue: 0,0:12:14.49,0:12:17.29,Caption,,0,0,0,,МОЖЕТ СТАТЬ НАМНОГО ТЯЖЕЛЕЕ. ВТОРАЯ ЛЮДЕЙ СТРАНЕ
Dialogue: 0,0:12:17.29,0:12:24.04,Caption,,0,0,0,,НУЖНО БОЛЬШЕ, А НЕ МЕНЬШЕ. ВОТ ТАКУЮ ЗАДАЧКУ ТЕПЕРЬ И НАДО РЕШАТЬ. ПРИЧЁМ
Dialogue: 0,0:12:24.04,0:12:27.24,Caption,,0,0,0,,ЛОЗУНГОМ ЕЁ НЕ ЗАКРОЕШЬ. НЕЛЬЗЯ ОДНОВРЕМЕННО ГОДАМИ
Dialogue: 0,0:12:27.24,0:12:29.32,Caption,,0,0,0,,РАССКАЗЫВАТЬ ЧЕЛОВЕКУ О ТЯЖЁЛОЙ ЗИМЕ,
Dialogue: 0,0:12:29.40,0:12:31.88,Caption,,0,0,0,,ПЕРЕБОЯХ, УГРОЗЕ ИНФРАСТРУКТУРЕ,
Dialogue: 0,0:12:32.15,0:12:34.60,Caption,,0,0,0,,ПРОБЛЕМАХ ТРАНСПОРТА, А ПОТОМ УДИВЛЯТЬСЯ,
Dialogue: 0,0:12:34.76,0:12:37.24,Caption,,0,0,0,,ПОЧЕМУ ОН ПРИ ПЕРВОЙ ВОЗМОЖНОСТИ ОТПРАВЛЯЕТ РЕБЁНКА
Dialogue: 0,0:12:37.24,0:12:41.16,Caption,,0,0,0,,УЧИТЬСЯ В ДРУГУЮ СТРАНУ. И НЕЛЬЗЯ БЕСКОНЕЧНО РЕШАТЬ ЭТУ ПРОБЛЕМУ ТОЛЬКО
Dialogue: 0,0:12:41.24,0:12:44.44,Caption,,0,0,0,,НОВЫМИ ЗАПРЕТАМИ. ПОТОМУ ЧТО ЗАПРЕТ МОЖЕТ УДЕРЖАТЬ
Dialogue: 0,0:12:44.44,0:12:47.48,Caption,,0,0,0,,ТЕЛО. НО ОН СОВЕРШЕННО НЕ ОБЯЗАН УДЕРЖАТЬ ЧЕЛОВЕКА.
Dialogue: 0,0:12:47.86,0:12:52.44,Caption,,0,0,0,,ВОТ ЭТО УЖЕ, ПОЖАЛУЙ, ГЛАВНЫЙ ВОПРОС БЛИЖАЙШЕГО ВРЕМЕНИ. НЕ СКОЛЬКО ЕЩЁ
Dialogue: 0,0:12:52.52,0:12:54.68,Caption,,0,0,0,,МОСТОВ ОСТАНЕТСЯ. НЕ СКОЛЬКО ОЧЕРЕДНЫХ
Dialogue: 0,0:12:54.68,0:12:57.48,Caption,,0,0,0,,ПРЕДУПРЕЖДЕНИЙ ПРОЗВУЧИТ. И ДАЖЕ НЕ СКОЛЬКО МУЖЧИН
Dialogue: 0,0:12:57.56,0:13:00.44,Caption,,0,0,0,,СЕЙЧАС НАХОДИТСЯ В ЕВРОПЕ. ГЛАВНЫЙ ВОПРОС В ТОМ,
Dialogue: 0,0:13:00.52,0:13:03.32,Caption,,0,0,0,,СКОЛЬКО ЛЮДЕЙ ЕЩЁ ГОТОВЫ СВЯЗЫВАТЬ СВОЁ БУДУЩЕЕ С
Dialogue: 0,0:13:03.32,0:13:07.16,Caption,,0,0,0,,СИСТЕМОЙ, КОТОРАЯ ОДНОВРЕМЕННО ГОВОРИТ ИМ ЗДЕСЬ БУДЕТ ТЯЖЕЛЕЕ,
Dialogue: 0,0:13:07.30,0:13:09.64,Caption,,0,0,0,,УЕЗЖАТЬ НЕЛЬЗЯ, А ЕСЛИ УЕХАЛИ,
Dialogue: 0,0:13:09.80,0:13:12.44,Caption,,0,0,0,,ПОРА ВОЗВРАЩАТЬСЯ. ПОТОМУ ЧТО МОСТ МОЖНО
Dialogue: 0,0:13:12.52,0:13:15.00,Caption,,0,0,0,,ВОССТАНОВИТЬ. ЛИНИЮ ЭЛЕКТРОПЕРЕДАЧИ МОЖНО
Dialogue: 0,0:13:15.00,0:13:18.12,Caption,,0,0,0,,ВОССТАНОВИТЬ. ЗАВОД МОЖНО ВОССТАНОВИТЬ. А ВОТ
Dialogue: 0,0:13:18.12,0:13:21.88,Caption,,0,0,0,,ПОКОЛЕНИЕ, КОТОРОЕ УЕХАЛО И ПОСТРОИЛО ЖИЗНЬ В ДРУГОМ МЕСТЕ,
Dialogue: 0,0:13:22.19,0:13:24.60,Caption,,0,0,0,,ОБРАТНО ОДНИМ ПОСТАНОВЛЕНИЕМ УЖЕ НЕ СОБЕРЁШЬ.
