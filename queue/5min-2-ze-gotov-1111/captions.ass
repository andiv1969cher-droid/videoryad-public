Dialogue: 0,0:00:00.12,0:00:03.00,Caption,,0,0,0,,ЕСТЬ ТАКОЙ ЗАМЕЧАТЕЛЬНЫЙ ЕВРОПЕЙСКИЙ ХОР. ВСЕ ВРОДЕ
Dialogue: 0,0:00:03.08,0:00:06.20,Caption,,0,0,0,,СТОЯТ НА ОДНОЙ СЦЕНЕ, У ВСЕХ ОДИНАКОВЫЕ ПАПОЧКИ,
Dialogue: 0,0:00:06.36,0:00:09.24,Caption,,0,0,0,,ДИРИЖЁР МАШЕТ РУКАМИ. ТОЛЬКО ОДИН УЖЕ ПОЁТ ПРО
Dialogue: 0,0:00:09.24,0:00:11.32,Caption,,0,0,0,,ДЕНЬГИ, ВТОРОЙ ПРО ПЕРЕГОВОРЫ,
Dialogue: 0,0:00:11.56,0:00:14.76,Caption,,0,0,0,,ТРЕТИЙ ВООБЩЕ ЗАБЫЛ, НА КАКУЮ ПЕСНЮ ПРИШЁЛ. А МЕРЦ,
Dialogue: 0,0:00:14.92,0:00:18.20,Caption,,0,0,0,,СУДЯ ПО ВСЕМУ, РЕШИЛ, ЧТО ЕСЛИ ОСТАЛЬНЫЕ СБИЛИСЬ,
Dialogue: 0,0:00:18.44,0:00:20.76,Caption,,0,0,0,,НАДО ПРОСТО ПЕТЬ ГРОМЧЕ ВСЕХ. И ВОТ ТУТ
Dialogue: 0,0:00:20.76,0:00:23.00,Caption,,0,0,0,,ВОПРОС УЖЕ НЕ В МУЗЫКЕ. ВОПРОС В ТОМ,
Dialogue: 0,0:00:23.23,0:00:25.88,Caption,,0,0,0,,СКОЛЬКО ЕЩЁ ЭТОТ ХОР ВООБЩЕ СМОЖЕТ ИЗОБРАЖАТЬ
Dialogue: 0,0:00:25.88,0:00:28.92,Caption,,0,0,0,,УНИСОН. ПОДПИШИТЕСЬ НА КАНАЛ. ПОТОМУ ЧТО ЗА ОБЩИМИ
Dialogue: 0,0:00:28.92,0:00:31.64,Caption,,0,0,0,,СЛОВАМИ ПРО ЕДИНСТВО СЕЙЧАС ПРОИСХОДИТ КУДА БОЛЕЕ
Dialogue: 0,0:00:31.64,0:00:34.68,Caption,,0,0,0,,ИНТЕРЕСНАЯ ИСТОРИЯ. ФРИДРИХ МЕРЦ РЕШИЛ ОБЪЯСНИТЬ
Dialogue: 0,0:00:34.68,0:00:39.16,Caption,,0,0,0,,ПАРТНЁРАМ ПО ЕВРОСОЮЗУ, КАК ИМЕННО ДОЛЖНО ВЫГЛЯДЕТЬ ЭТО САМОЕ ЕДИНСТВО.
Dialogue: 0,0:00:39.56,0:00:43.32,Caption,,0,0,0,,ГЕРМАНИЯ ХОЧЕТ, ЧТОБЫ ВСЕ УЧАСТВОВАЛИ В ДАЛЬНЕЙШЕМ ФИНАНСИРОВАНИИ
Dialogue: 0,0:00:43.32,0:00:46.60,Caption,,0,0,0,,УКРАИНЫ. НЕ ТОЛЬКО ТЕ, КТО ХОЧЕТ. НЕ ТОЛЬКО ТЕ,
Dialogue: 0,0:00:46.69,0:00:49.32,Caption,,0,0,0,,КТО ГОТОВ. ВСЕ. А ЕСЛИ НЕ ВСЕ,
Dialogue: 0,0:00:49.40,0:00:51.96,Caption,,0,0,0,,ТОГДА МЕРЦ УГРОЖАЕТ НЕ СОГЛАСОВЫВАТЬ СЛЕДУЮЩИЙ
Dialogue: 0,0:00:51.96,0:00:54.92,Caption,,0,0,0,,СЕМИЛЕТНИЙ БЮДЖЕТ ЕВРОСОЮЗА НА ПЕРИОД С ДВЕ ТЫСЯЧИ
Dialogue: 0,0:00:55.00,0:00:57.32,Caption,,0,0,0,,ДВАДЦАТЬ ВОСЬМОГО ПО ДВЕ ТЫСЯЧИ ТРИДЦАТЬ ЧЕТВЁРТЫЙ
Dialogue: 0,0:00:57.32,0:01:00.36,Caption,,0,0,0,,ГОД. НОРМАЛЬНЫЙ ТАКОЙ РАЗГОВОР МЕЖДУ СОЮЗНИКАМИ. У
Dialogue: 0,0:01:00.44,0:01:02.60,Caption,,0,0,0,,НАС ПОЛНОЕ ЕДИНСТВО. А ЕСЛИ КТО ТО НЕ
Dialogue: 0,0:01:02.60,0:01:05.48,Caption,,0,0,0,,СОГЛАСЕН, МЫ ЕМУ БЮДЖЕТ ЗАБЛОКИРУЕМ. ПО СУТИ,
Dialogue: 0,0:01:05.72,0:01:08.76,Caption,,0,0,0,,ЭТО УЖЕ ФИНАНСОВЫЙ ШАНТАЖ. ПРИЧЁМ ШАНТАЖ ВЕДЁТ НЕ
Dialogue: 0,0:01:08.84,0:01:12.20,Caption,,0,0,0,,КАКАЯ НИБУДЬ СТРАНА, КОТОРУЮ В БРЮССЕЛЕ МОЖНО ВЫСЛУШАТЬ,
Dialogue: 0,0:01:12.28,0:01:14.28,Caption,,0,0,0,,ПОБЛАГОДАРИТЬ И ОТПРАВИТЬ ПИТЬ КОФЕ.
Dialogue: 0,0:01:16.55,0:01:19.67,Caption,,0,0,0,,ЭТО ГЕРМАНИЯ. ОДНА ИЗ КРУПНЕЙШИХ ЭКОНОМИК ЕВРОСОЮЗА
Dialogue: 0,0:01:19.75,0:01:23.75,Caption,,0,0,0,,И ОДИН ИЗ ТЕХ СТОЛБОВ, НА КОТОРЫХ ВСЯ ЭТА КОНСТРУКЦИЯ ФИНАНСОВО ДЕРЖИТСЯ.
Dialogue: 0,0:01:24.15,0:01:26.39,Caption,,0,0,0,,ПОЭТОМУ МЕРЦ ДЕЙСТВИТЕЛЬНО МОЖЕТ РАЗГОВАРИВАТЬ
Dialogue: 0,0:01:26.47,0:01:29.83,Caption,,0,0,0,,ГРОМЧЕ МНОГИХ ДРУГИХ. ВОПРОС ТОЛЬКО В ДРУГОМ. ЕСЛИ
Dialogue: 0,0:01:29.83,0:01:31.67,Caption,,0,0,0,,ПРИХОДИТСЯ ВЫКРУЧИВАТЬ РУКИ ТЕМ,
Dialogue: 0,0:01:31.88,0:01:34.07,Caption,,0,0,0,,КОГО ЕЩЁ ВЧЕРА НАЗЫВАЛИ ЕДИНЫМ ФРОНТОМ,
Dialogue: 0,0:01:34.40,0:01:36.63,Caption,,0,0,0,,ЗНАЧИТ С ЭТИМ ФРОНТОМ УЖЕ ЧТО ТО ОЧЕНЬ
Dialogue: 0,0:01:36.63,0:01:39.51,Caption,,0,0,0,,СЕРЬЁЗНО НЕ ТАК. ВЕНГРИЯ И СЛОВАКИЯ НЕ ХОТЯТ
Dialogue: 0,0:01:39.59,0:01:41.99,Caption,,0,0,0,,БРАТЬ НА СЕБЯ НОВЫЕ ОБЯЗАТЕЛЬСТВА ПО ФИНАНСИРОВАНИЮ
Dialogue: 0,0:01:41.99,0:01:46.71,Caption,,0,0,0,,КИЕВА. ЕСТЬ И ДРУГИЕ СТРАНЫ, КОТОРЫМ ИДЕЯ БЕСКОНЕЧНО ОТКРЫТОГО КОШЕЛЬКА НРАВИТСЯ
Dialogue: 0,0:01:46.71,0:01:50.31,Caption,,0,0,0,,ВСЁ МЕНЬШЕ. А БЕРЛИН ХОЧЕТ, ЧТОБЫ ДЕНЬГИ ШЛИ СТАБИЛЬНО,
Dialogue: 0,0:01:50.41,0:01:53.67,Caption,,0,0,0,,НА ГОДЫ ВПЕРЁД. ПРИЧЁМ ГЕРМАНИЯ ДОБИВАЕТСЯ ЕЩЁ ОДНОЙ
Dialogue: 0,0:01:53.67,0:01:56.39,Caption,,0,0,0,,ИНТЕРЕСНОЙ ВЕЩИ ЧТОБЫ РЕШЕНИЯ ПО ДАЛЬНЕЙШЕЙ ПОМОЩИ
Dialogue: 0,0:01:56.64,0:02:01.11,Caption,,0,0,0,,ПРИНИМАЛИСЬ НЕ ЕДИНОГЛАСНО, А КВАЛИФИЦИРОВАННЫМ БОЛЬШИНСТВОМ. ПЕРЕВОЖУ НА
Dialogue: 0,0:02:01.11,0:02:04.39,Caption,,0,0,0,,ЧЕЛОВЕЧЕСКИЙ ЯЗЫК. ЕСЛИ КТО ТО ОДИН ИЛИ НЕСКОЛЬКО
Dialogue: 0,0:02:04.39,0:02:07.03,Caption,,0,0,0,,ГОСУДАРСТВ СКАЖУТ РЕБЯТА, МЫ БОЛЬШЕ НЕ ХОТИМ,
Dialogue: 0,0:02:07.36,0:02:09.83,Caption,,0,0,0,,ИХ МОЖНО БУДЕТ ПРОСТО ОБОЙТИ. ОЧЕНЬ УДОБНАЯ
Dialogue: 0,0:02:09.83,0:02:13.27,Caption,,0,0,0,,КОНСТРУКЦИЯ. ЕДИНСТВО СОХРАНЯЕТСЯ. ПРОСТО МНЕНИЕ
Dialogue: 0,0:02:13.27,0:02:16.23,Caption,,0,0,0,,НЕСОГЛАСНЫХ СТАНОВИТСЯ НЕОБЯЗАТЕЛЬНЫМ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:02:16.23,0:02:20.07,Caption,,0,0,0,,УЖЕ ХОРОШО ВИДНО ТО, О ЧЁМ РАНЬШЕ МОЖНО БЫЛО СПОРИТЬ СКОЛЬКО УГОДНО.
Dialogue: 0,0:02:20.40,0:02:23.35,Caption,,0,0,0,,В УНИСОН ЭТОТ ХОР ДАВНО НЕ ПОЁТ. ОДИН
Dialogue: 0,0:02:23.35,0:02:26.23,Caption,,0,0,0,,ГОЛОС ТЯНЕТ В ОДНУ СТОРОНУ, ВТОРОЙ В ДРУГУЮ,
Dialogue: 0,0:02:26.43,0:02:29.03,Caption,,0,0,0,,ТРЕТИЙ ВООБЩЕ ХОЧЕТ ЗАКОНЧИТЬ ПЕСНЮ И УЙТИ ДОМОЙ.
Dialogue: 0,0:02:31.32,0:02:34.04,Caption,,0,0,0,,ПРИ ЭТОМ ПЕРЕГОВОРЫ ИДУТ СВОИМ ЧЕРЕДОМ. КИЕВ,
Dialogue: 0,0:02:34.21,0:02:37.88,Caption,,0,0,0,,ПО ДАННЫМ THE TELEGRAPH, УЖЕ ГОТОВ ОБСУЖДАТЬ ТЕРРИТОРИАЛЬНЫЕ УСТУПКИ.
Dialogue: 0,0:02:38.34,0:02:39.96,Caption,,0,0,0,,АМЕРИКАНСКИЕ ИСТОЧНИКИ ГОВОРЯТ,
Dialogue: 0,0:02:40.12,0:02:43.48,Caption,,0,0,0,,ЧТО И МОСКВА, И КИЕВ ПРОЯВЛЯЮТ НЕКОТОРУЮ ГИБКОСТЬ,
Dialogue: 0,0:02:43.72,0:02:45.88,Caption,,0,0,0,,А ТЕРРИТОРИАЛЬНЫЙ ВОПРОС СОБИРАЮТСЯ ОСТАВЛЯТЬ НА
Dialogue: 0,0:02:45.88,0:02:49.56,Caption,,0,0,0,,ПОТОМ, ПОСЛЕ РАЗГОВОРА О ГАРАНТИЯХ БЕЗОПАСНОСТИ. НО САМИ
Dialogue: 0,0:02:49.56,0:02:52.44,Caption,,0,0,0,,ПЕРЕГОВОРЫ ЗДЕСЬ ДАЖЕ НЕ САМОЕ ВАЖНОЕ. ПОТОМУ ЧТО
Dialogue: 0,0:02:52.44,0:02:56.36,Caption,,0,0,0,,ПОКА ОДНИ ИЩУТ, О ЧЁМ И НА КАКИХ УСЛОВИЯХ МОЖНО ДОГОВОРИТЬСЯ,
Dialogue: 0,0:02:56.61,0:02:58.52,Caption,,0,0,0,,ДРУГИЕ УЖЕ РАСКЛАДЫВАЮТ ДЕНЬГИ,
Dialogue: 0,0:02:58.61,0:03:01.88,Caption,,0,0,0,,ПОДГОТОВКУ АРМИИ И ВОЕННЫЕ ПРОГРАММЫ НА ГОДЫ ВПЕРЁД.
Dialogue: 0,0:03:02.22,0:03:04.92,Caption,,0,0,0,,ВОТ ЭТО И ЕСТЬ ГЛАВНЫЙ РАЗРЫВ. НЕ ПОЛУЧИЛОСЬ.
Dialogue: 0,0:03:05.16,0:03:07.08,Caption,,0,0,0,,УЖЕ СЛИШКОМ МНОГОЕ ГОВОРИТ О ТОМ,
Dialogue: 0,0:03:07.32,0:03:09.40,Caption,,0,0,0,,ЧТО ПРЕЖНИЙ РАСЧЁТ НЕ СРАБОТАЛ ТАК,
Dialogue: 0,0:03:09.56,0:03:12.44,Caption,,0,0,0,,КАК ЕГО РИСОВАЛИ НЕСКОЛЬКО ЛЕТ НАЗАД. И СОЮЗНИКИ
Dialogue: 0,0:03:12.52,0:03:15.48,Caption,,0,0,0,,СМОТРЯТ НА ПОСЛЕДСТВИЯ СОВЕРШЕННО ПО РАЗНОМУ. ОДНИ
Dialogue: 0,0:03:15.48,0:03:19.16,Caption,,0,0,0,,ИЩУТ ВЫХОД. ДРУГИЕ СОБИРАЮТСЯ ИДТИ ДАЛЬШЕ. А МЕРЦ
Dialogue: 0,0:03:19.16,0:03:20.84,Caption,,0,0,0,,ПРЕДСТАВЛЯЕТ КАК РАЗ ТУ ГРУППУ,
Dialogue: 0,0:03:21.00,0:03:23.00,Caption,,0,0,0,,КОТОРАЯ НЕ ПРОСТО ГОВОРИТ "НИ ШАГУ НАЗАД",
Dialogue: 0,0:03:23.24,0:03:27.00,Caption,,0,0,0,,А ПЫТАЕТСЯ СДЕЛАТЬ ТАК, ЧТОБЫ НАЗАД НЕ СМОГЛИ ОТОЙТИ И ОСТАЛЬНЫЕ.
Dialogue: 0,0:03:27.64,0:03:29.72,Caption,,0,0,0,,ТОЛЬКО ПОКА В БЕРЛИНЕ СЧИТАЮТ МИЛЛИАРДЫ,
Dialogue: 0,0:03:29.96,0:03:32.92,Caption,,0,0,0,,В КИЕВЕ НАЧАЛИ СЧИТАТЬ КОЕ ЧТО ДРУГОЕ. ДЕПУТАТ
Dialogue: 0,0:03:32.92,0:03:35.24,Caption,,0,0,0,,ВЕРХОВНОЙ РАДЫ СЕРГЕЙ НАГОРНЯК ПРЕДУПРЕДИЛ,
Dialogue: 0,0:03:35.40,0:03:37.64,Caption,,0,0,0,,ЧТО ЕСЛИ СТОЛИЦА ОСТАНЕТСЯ БЕЗ ТЕПЛА,
Dialogue: 0,0:03:37.72,0:03:40.92,Caption,,0,0,0,,ВОДЫ И ЭЛЕКТРИЧЕСТВА, ЛЮДИ МОГУТ СМЕСТИ ВСЕХ.
Dialogue: 0,0:03:43.20,0:03:46.01,Caption,,0,0,0,,ПРИЧЁМ ОН ПЕРЕЧИСЛИЛ БЕЗ ОСОБОГО РАЗБОРА ЦЕНТРАЛЬНУЮ
Dialogue: 0,0:03:46.09,0:03:48.81,Caption,,0,0,0,,ВЛАСТЬ, ПАРЛАМЕНТ, ИСПОЛНИТЕЛЬНУЮ ВЛАСТЬ,
Dialogue: 0,0:03:48.97,0:03:51.05,Caption,,0,0,0,,МЕСТНЫХ ЧИНОВНИКОВ. ВСЕХ ВМЕСТЕ.
Dialogue: 0,0:03:51.60,0:03:54.49,Caption,,0,0,0,,ВОТ ЭТО УЖЕ РАЗГОВОР НЕМНОГО ДРУГОГО УРОВНЯ. ПОТОМУ
Dialogue: 0,0:03:54.49,0:03:57.13,Caption,,0,0,0,,ЧТО МОЖНО НАПИСАТЬ ПРЕКРАСНЫЙ ФИНАНСОВЫЙ ПЛАН ДО ДВЕ
Dialogue: 0,0:03:57.21,0:03:59.93,Caption,,0,0,0,,ТЫСЯЧИ ТРИДЦАТЬ ЧЕТВЁРТОГО ГОДА. МОЖНО РАСПИСАТЬ
Dialogue: 0,0:03:59.93,0:04:02.17,Caption,,0,0,0,,ПОДГОТОВКУ ВОЕННОСЛУЖАЩИХ ДО ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:04:02.17,0:04:04.25,Caption,,0,0,0,,ВОСЬМОГО ГОДА. МОЖНО ПОСЧИТАТЬ,
Dialogue: 0,0:04:04.43,0:04:06.81,Caption,,0,0,0,,СКОЛЬКО РАКЕТ БУДЕТ ПРОИЗВЕДЕНО ЧЕРЕЗ ГОД,
Dialogue: 0,0:04:06.89,0:04:10.65,Caption,,0,0,0,,ЧЕРЕЗ ДВА, ЧЕРЕЗ ТРИ. А У ЧЕЛОВЕКА ДОМА ХОЛОДНО СЕЙЧАС.
Dialogue: 0,0:04:10.73,0:04:14.41,Caption,,0,0,0,,СВЕТА НЕТ СЕЙЧАС. ВОДЫ НЕТ СЕЙЧАС. РЕБЁНКА НАКОРМИТЬ
Dialogue: 0,0:04:14.41,0:04:17.13,Caption,,0,0,0,,И СОГРЕТЬ НУЖНО ТОЖЕ СЕЙЧАС. И ЕМУ СОВЕРШЕННО
Dialogue: 0,0:04:17.13,0:04:20.33,Caption,,0,0,0,,ВСЁ РАВНО, КАКОЙ ТАМ КРАСИВЫЙ МНОГОСТРАНИЧНЫЙ ДОКУМЕНТ
Dialogue: 0,0:04:20.33,0:04:22.33,Caption,,0,0,0,,ПОДГОТОВИЛИ В БРЮССЕЛЕ НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:04:22.33,0:04:25.29,Caption,,0,0,0,,ВОСЬМОЙ ГОД. КОГДА НЕСКОЛЬКО ЧАСОВ НЕТ СВЕТА,
Dialogue: 0,0:04:25.45,0:04:28.17,Caption,,0,0,0,,ЧЕЛОВЕК ЕЩЁ РУГАЕТСЯ НА ЭНЕРГЕТИКОВ. КОГДА ЭТО
Dialogue: 0,0:04:28.17,0:04:32.49,Caption,,0,0,0,,ПРОДОЛЖАЕТСЯ ДОЛГО, ОН НАЧИНАЕТ ЗАДАВАТЬ ВОПРОСЫ ГОРОДСКОЙ ВЛАСТИ. КОГДА
Dialogue: 0,0:04:32.49,0:04:34.97,Caption,,0,0,0,,НЕТ СВЕТА, ВОДЫ И ТЕПЛА ОДНОВРЕМЕННО,
Dialogue: 0,0:04:35.21,0:04:38.17,Caption,,0,0,0,,СПИСОК ВОПРОСОВ СТАНОВИТСЯ ЗНАЧИТЕЛЬНО ШИРЕ. А
Dialogue: 0,0:04:38.17,0:04:40.57,Caption,,0,0,0,,ЭНЕРГЕТИКИ ПРЕДУПРЕЖДАЮТ, ЧТО КИЕВ,
Dialogue: 0,0:04:40.72,0:04:43.93,Caption,,0,0,0,,ОДЕССА И ДНЕПР ПРИ ПОВРЕЖДЕНИИ КЛЮЧЕВЫХ СОЕДИНЕНИЙ
Dialogue: 0,0:04:44.01,0:04:46.57,Caption,,0,0,0,,МОГУТ ОСТАТЬСЯ БЕЗ ЭЛЕКТРИЧЕСТВА НЕ НА ПАРУ ЧАСОВ
Dialogue: 0,0:04:46.65,0:04:48.65,Caption,,0,0,0,,И ДАЖЕ НЕ НА СУТКИ. РЕЧЬ ИДЁТ О
Dialogue: 0,0:04:48.65,0:04:52.25,Caption,,0,0,0,,ТРЁХ ПЯТИ ДНЯХ, А В ТЯЖЁЛОМ СЦЕНАРИИ ДО ОДНОЙ ДВУХ НЕДЕЛЬ.
Dialogue: 0,0:04:52.54,0:04:55.77,Caption,,0,0,0,,ДВЕ НЕДЕЛИ. ВОТ ТЕПЕРЬ ПОСТАВЬТЕ РЯДОМ ДВЕ НОВОСТИ.
Dialogue: 0,0:04:57.97,0:05:01.41,Caption,,0,0,0,,В ЕВРОПЕ СПОРЯТ, КТО И СКОЛЬКО БУДЕТ ФИНАНСИРОВАТЬ УКРАИНУ ЧЕРЕЗ
Dialogue: 0,0:05:01.41,0:05:04.45,Caption,,0,0,0,,НЕСКОЛЬКО ЛЕТ. А ВНУТРИ УКРАИНЫ УЖЕ ОБСУЖДАЮТ,
Dialogue: 0,0:05:04.55,0:05:08.21,Caption,,0,0,0,,ЧТО ПРОИЗОЙДЁТ, ЕСЛИ КРУПНЫЕ ГОРОДА НАДОЛГО ОСТАНУТСЯ БЕЗ
Dialogue: 0,0:05:08.21,0:05:10.61,Caption,,0,0,0,,ЭЛЕМЕНТАРНЫХ ВЕЩЕЙ. И ВОПРОС О ТОМ,
Dialogue: 0,0:05:10.87,0:05:12.77,Caption,,0,0,0,,КТО КОГО ПЕРЕУБЕДИТ В БРЮССЕЛЕ,
Dialogue: 0,0:05:13.01,0:05:16.21,Caption,,0,0,0,,СРАЗУ СТАНОВИТСЯ ЧУТЬ МЕНЕЕ ВАЖНЫМ. ПОТОМУ ЧТО ЛЮДИ,
Dialogue: 0,0:05:16.53,0:05:18.93,Caption,,0,0,0,,КОТОРЫЕ СИДЯТ В ХОЛОДНЫХ КВАРТИРАХ БЕЗ СВЕТА,
Dialogue: 0,0:05:19.21,0:05:21.49,Caption,,0,0,0,,СПОСОБНЫ ДОГОВОРИТЬСЯ МЕЖДУ СОБОЙ ЗНАЧИТЕЛЬНО
Dialogue: 0,0:05:21.49,0:05:25.17,Caption,,0,0,0,,БЫСТРЕЕ, ЧЕМ ЕВРОПЕЙСКИЕ МИНИСТРЫ ФИНАНСОВ. ИМ НЕ НУЖНО
Dialogue: 0,0:05:25.25,0:05:27.65,Caption,,0,0,0,,СОГЛАСОВЫВАТЬ СЕМИЛЕТНИЙ БЮДЖЕТ. ИМ НЕ НУЖНО
Dialogue: 0,0:05:27.65,0:05:30.29,Caption,,0,0,0,,КВАЛИФИЦИРОВАННОЕ БОЛЬШИНСТВО. ИМ НЕ НУЖНО ЖДАТЬ
Dialogue: 0,0:05:30.29,0:05:35.17,Caption,,0,0,0,,ШЕСТЬСОТ РАКЕТ. ИМ НУЖНО, ЧТОБЫ ДОМА БЫЛО ТЕПЛО. И ВОТ ТУТ ВСПОМИНАЕТСЯ
Dialogue: 0,0:05:35.17,0:05:39.49,Caption,,0,0,0,,ПУШКИН РУССКИЙ БУНТ, БЕССМЫСЛЕННЫЙ И БЕСПОЩАДНЫЙ. САМ ФАКТ,
Dialogue: 0,0:05:39.77,0:05:42.21,Caption,,0,0,0,,ЧТО ТАКОЙ РАЗГОВОР УЖЕ ЗВУЧИТ В ВЕРХОВНОЙ РАДЕ,
Dialogue: 0,0:05:42.44,0:05:45.41,Caption,,0,0,0,,ОЧЕНЬ ХОРОШО ПОКАЗЫВАЕТ РАЗНИЦУ МЕЖДУ ЖИЗНЬЮ НАВЕРХУ
Dialogue: 0,0:05:45.49,0:05:48.69,Caption,,0,0,0,,И ЖИЗНЬЮ ВНИЗУ. НАВЕРХУ ГОРИЗОНТ ПЛАНИРОВАНИЯ ДО ДВЕ
Dialogue: 0,0:05:48.69,0:05:51.41,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ГОДА. ВНИЗУ ГОРИЗОНТ
Dialogue: 0,0:05:51.49,0:05:54.29,Caption,,0,0,0,,ПЛАНИРОВАНИЯ ДО ВЕЧЕРА. И ЕСЛИ ЭТИ ДВА ГОРИЗОНТА
Dialogue: 0,0:05:54.29,0:05:57.25,Caption,,0,0,0,,СТОЛКНУТСЯ, ДАЛЕКО НЕ ФАКТ, ЧТО ПОБЕДИТ ТОТ,
Dialogue: 0,0:05:57.56,0:06:00.37,Caption,,0,0,0,,У КОГО ТОЛЩЕ ПАПКА С ПРОГРАММОЙ ФИНАНСИРОВАНИЯ. НА
Dialogue: 0,0:06:00.37,0:06:02.85,Caption,,0,0,0,,ЭТОМ ФОНЕ ОСОБЕННО ВЕСЕЛО СМОТРИТСЯ ЕЩЁ ОДНА
Dialogue: 0,0:06:02.85,0:06:05.81,Caption,,0,0,0,,ИСТОРИЯ. ЗЕЛЕНСКИЙ ГОТОВ ВСТРЕТИТЬСЯ С ПУТИНЫМ ХОТЬ
Dialogue: 0,0:06:05.89,0:06:08.69,Caption,,0,0,0,,В АНТАРКТИДЕ. ТАК ЗАЯВИЛ ПОСТПРЕД УКРАИНЫ ПРИ ООН
Dialogue: 0,0:06:08.69,0:06:12.56,Caption,,0,0,0,,АНДРЕЙ МЕЛЬНИК. ГДЕ УГОДНО,
Dialogue: 0,0:06:12.66,0:06:15.60,Caption,,0,0,0,,ХОТЬ СРЕДИ ПИНГВИНОВ. НО НЕ В МОСКВЕ. ДЕВЯНОСТО
Dialogue: 0,0:06:15.60,0:06:19.04,Caption,,0,0,0,,ПЯТЫЙ КВАРТАЛ ПРОДОЛЖАЕТ РАБОТУ. ТУРЦИЯ БЫЛА. ДРУГИЕ
Dialogue: 0,0:06:19.04,0:06:21.76,Caption,,0,0,0,,ПЛОЩАДКИ БЫЛИ. ТЕПЕРЬ АНТАРКТИДА. НУ ХОРОШО.
Dialogue: 0,0:06:22.08,0:06:24.48,Caption,,0,0,0,,АНТАРКТИДА ТАК АНТАРКТИДА. ПИНГВИНЫ,
Dialogue: 0,0:06:24.56,0:06:27.12,Caption,,0,0,0,,ЛЁД, КРАСИВЫЙ ФОН. ОСТАЛОСЬ ПОНЯТЬ,
Dialogue: 0,0:06:27.28,0:06:29.92,Caption,,0,0,0,,ЧЕМ ТАМ БУДУТ ЗАНИМАТЬСЯ. ПОТОМУ ЧТО ОДНОВРЕМЕННО
Dialogue: 0,0:06:29.92,0:06:32.24,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ИНФОРМАЦИЯ О ГОТОВНОСТИ ОБСУЖДАТЬ
Dialogue: 0,0:06:32.24,0:06:35.84,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЕ УСТУПКИ, АМЕРИКАНЦЫ ГОВОРЯТ О ГИБКОСТИ СТОРОН,
Dialogue: 0,0:06:36.08,0:06:39.12,Caption,,0,0,0,,А ВОПРОС ГАРАНТИЙ БЕЗОПАСНОСТИ ВЫХОДИТ ВПЕРЁД. ТО
Dialogue: 0,0:06:39.12,0:06:41.92,Caption,,0,0,0,,ЕСТЬ СЕРЬЁЗНЫЕ ВЕЩИ ВСЁ РАВНО ПРИДЁТСЯ ОБСУЖДАТЬ. И
Dialogue: 0,0:06:41.92,0:06:44.16,Caption,,0,0,0,,ОТ ТОГО, ПОСТАВЯТ СТОЛ В МОСКВЕ,
Dialogue: 0,0:06:44.32,0:06:46.48,Caption,,0,0,0,,АБУ ДАБИ ИЛИ РЯДОМ С ПИНГВИНАМИ,
Dialogue: 0,0:06:46.64,0:06:49.60,Caption,,0,0,0,,САМИ ВОПРОСЫ НИКУДА НЕ ИСЧЕЗНУТ. НО ПОКА ДЕВЯНОСТО
Dialogue: 0,0:06:49.60,0:06:51.60,Caption,,0,0,0,,ПЯТЫЙ КВАРТАЛ ВЫБИРАЕТ ДЕКОРАЦИИ,
Dialogue: 0,0:06:51.83,0:06:55.28,Caption,,0,0,0,,ЕВРОПА ГОТОВИТСЯ НАДОЛГО. СОВЕТ ЕВРОСОЮЗА ПРОДЛИЛ
Dialogue: 0,0:06:55.28,0:06:58.00,Caption,,0,0,0,,МИССИЮ ПО ПОДГОТОВКЕ УКРАИНСКИХ ВОЕННЫХ ДО НОЯБРЯ
Dialogue: 0,0:06:58.08,0:07:00.24,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ГОДА. НА НЕЁ
Dialogue: 0,0:07:00.24,0:07:02.96,Caption,,0,0,0,,ПРЕДУСМОТРЕНО ПОЧТИ ТРИСТА МИЛЛИОНОВ ЕВРО. В
Dialogue: 0,0:07:03.04,0:07:05.20,Caption,,0,0,0,,ПРОГРАММУ ВХОДИТ НЕ ТОЛЬКО САМО ОБУЧЕНИЕ,
Dialogue: 0,0:07:05.44,0:07:09.04,Caption,,0,0,0,,НО И АНАЛИЗ БОЕВОГО ОПЫТА, МОДЕРНИЗАЦИЯ ПОДГОТОВКИ,
Dialogue: 0,0:07:09.25,0:07:11.04,Caption,,0,0,0,,КООРДИНАЦИЯ С ВЕЛИКОБРИТАНИЕЙ,
Dialogue: 0,0:07:11.14,0:07:16.00,Caption,,0,0,0,,КАНАДОЙ, НОРВЕГИЕЙ, СОЕДИНЁННЫМИ ШТАТАМИ И СТРУКТУРАМИ НАТО. ТО ЕСТЬ
Dialogue: 0,0:07:16.00,0:07:18.56,Caption,,0,0,0,,КАЛЕНДАРЬ УЖЕ ОТКРЫТ НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОЙ.
Dialogue: 0,0:07:18.80,0:07:21.52,Caption,,0,0,0,,И ЭТО ОЧЕНЬ ХОРОШО ПОКАЗЫВАЕТ ПОЗИЦИЮ ТОЙ ЧАСТИ
Dialogue: 0,0:07:21.52,0:07:24.16,Caption,,0,0,0,,ЕВРОПЫ, КОТОРУЮ СЕГОДНЯ ПРЕДСТАВЛЯЕТ МЕРЦ.
Dialogue: 0,0:07:26.37,0:07:30.45,Caption,,0,0,0,,ПЕРЕГОВОРЫ ПЕРЕГОВОРАМИ, А ВОЕННУЮ МАШИНУ ОСТАНАВЛИВАТЬ НИКТО НЕ СОБИРАЕТСЯ.
Dialogue: 0,0:07:30.60,0:07:34.05,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ПОТОМУ ЧТО ДАЛЬШЕ ЦИФРЫ
Dialogue: 0,0:07:34.05,0:07:36.85,Caption,,0,0,0,,СТАНОВЯТСЯ ЕЩЁ ИНТЕРЕСНЕЕ. С РАКЕТАМИ ВООБЩЕ
Dialogue: 0,0:07:36.85,0:07:39.25,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ОТДЕЛЬНЫЙ АНЕКДОТ. ТОЛЬКО ДОРОГОЙ.
Dialogue: 0,0:07:39.62,0:07:43.81,Caption,,0,0,0,,BLOOMBERG ПИШЕТ, ЧТО РОССИЯ ПРОИЗВОДИТ БАЛЛИСТИЧЕСКИЕ РАКЕТЫ БЫСТРЕЕ,
Dialogue: 0,0:07:44.05,0:07:46.69,Caption,,0,0,0,,ЧЕМ ВСЕ ПРОИЗВОДИТЕЛИ ПЕРЕХВАТЧИКОВ PATRIOT В МИРЕ
Dialogue: 0,0:07:46.69,0:07:49.49,Caption,,0,0,0,,УСПЕВАЮТ ВЫПУСКАТЬ ПРОТИВОРАКЕТЫ. ЭТО УЖЕ НЕ
Dialogue: 0,0:07:49.49,0:07:53.57,Caption,,0,0,0,,РАЗГОВОР О ТОМ, ЧЬЯ РАКЕТА КРАСИВЕЕ НА ВЫСТАВКЕ. ЭТО АРИФМЕТИКА.
Dialogue: 0,0:07:53.89,0:07:56.53,Caption,,0,0,0,,ЕСЛИ С ОДНОЙ СТОРОНЫ ИЗДЕЛИЙ ПОЯВЛЯЕТСЯ БОЛЬШЕ,
Dialogue: 0,0:07:56.76,0:07:59.25,Caption,,0,0,0,,ЧЕМ С ДРУГОЙ СТОРОНЫ СРЕДСТВ ДЛЯ ИХ ПЕРЕХВАТА,
Dialogue: 0,0:07:59.58,0:08:02.61,Caption,,0,0,0,,ДЕФИЦИТ НЕ ЛЕЧИТСЯ ЗАЯВЛЕНИЯМИ О ПОДДЕРЖКЕ СТОЛЬКО,
Dialogue: 0,0:08:02.69,0:08:06.29,Caption,,0,0,0,,СКОЛЬКО ПОТРЕБУЕТСЯ. ЕГО ЛЕЧАТ ЗАВОДЫ. А С ЗАВОДАМИ
Dialogue: 0,0:08:06.37,0:08:09.25,Caption,,0,0,0,,СРОКИ СОВЕРШЕННО ДРУГИЕ. УКРАИНА ДОЛЖНА ПОЛУЧИТЬ
Dialogue: 0,0:08:09.33,0:08:13.65,Caption,,0,0,0,,ШЕСТЬСОТ РАКЕТ P A C, ДВА НЕМЕЦКОГО ПРОИЗВОДСТВА В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:08:13.65,0:08:15.89,Caption,,0,0,0,,СЕДЬМОМ И ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОМ ГОДАХ.
Dialogue: 0,0:08:16.37,0:08:19.09,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО ОБЪЯВЛЕН ПРОЕКТ ПРОИЗВОДСТВА P A C,
Dialogue: 0,0:08:19.20,0:08:22.37,Caption,,0,0,0,,ТРИ В ПОЛЬШЕ. ШЕСТЬСОТ ЗВУЧИТ СОЛИДНО. ТОЛЬКО
Dialogue: 0,0:08:22.45,0:08:25.09,Caption,,0,0,0,,СНАЧАЛА НУЖНО ДОЖИТЬ ДО ЭТИХ ПОСТАВОК. И ЗДЕСЬ
Dialogue: 0,0:08:25.17,0:08:28.05,Caption,,0,0,0,,СНОВА СТАЛКИВАЮТСЯ ДВА КАЛЕНДАРЯ. В ОДНОМ КАЛЕНДАРЕ
Dialogue: 0,0:08:28.28,0:08:30.61,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ И ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:08:30.61,0:08:33.65,Caption,,0,0,0,,ВОСЬМОЙ ГОДЫ. ПРОИЗВОДСТВО, НОВЫЕ ЛИНИИ,
Dialogue: 0,0:08:33.83,0:08:36.53,Caption,,0,0,0,,НОВЫЕ ДОГОВОРЁННОСТИ, НОВЫЕ ПРЕДПРИЯТИЯ.
Dialogue: 0,0:08:38.81,0:08:40.89,Caption,,0,0,0,,А В ДРУГОМ КАЛЕНДАРЕ БЛИЖАЙШАЯ ЗИМА,
Dialogue: 0,0:08:41.04,0:08:42.97,Caption,,0,0,0,,ПОВРЕЖДЁННАЯ ЭНЕРГЕТИКА И ГОРОДА,
Dialogue: 0,0:08:43.28,0:08:45.37,Caption,,0,0,0,,КОТОРЫМ ПРИ РАЗРУШЕНИИ КЛЮЧЕВЫХ СВЯЗЕЙ С
Dialogue: 0,0:08:45.37,0:08:48.25,Caption,,0,0,0,,ОБЪЕДИНЁННОЙ ЭНЕРГОСИСТЕМОЙ ОБЕЩАЮТ ОТКЛЮЧЕНИЯ ДО
Dialogue: 0,0:08:48.33,0:08:51.85,Caption,,0,0,0,,ДВУХ НЕДЕЛЬ. ВОТ ПОЭТОМУ ДЛЯ ЧЕЛОВЕКА В КИЕВЕ ИЛИ ОДЕССЕ
Dialogue: 0,0:08:51.85,0:08:53.77,Caption,,0,0,0,,СЕГОДНЯ СОВЕРШЕННО НЕ ГЛАВНЫЙ ВОПРОС,
Dialogue: 0,0:08:54.01,0:08:56.25,Caption,,0,0,0,,КОГДА ПОЯВИТСЯ ОЧЕРЕДНАЯ ПАРТИЯ PATRIOT.
Dialogue: 0,0:08:56.86,0:09:00.57,Caption,,0,0,0,,КОГДА ДОМА ХОЛОДНО, ПОЛИТИЧЕСКИЕ ПРИОРИТЕТЫ УДИВИТЕЛЬНО БЫСТРО
Dialogue: 0,0:09:00.57,0:09:04.33,Caption,,0,0,0,,СТАНОВЯТСЯ ПРОСТЫМИ. СНАЧАЛА СВЕТ. ПОТОМ ВОДА. ПОТОМ
Dialogue: 0,0:09:04.33,0:09:06.81,Caption,,0,0,0,,ТЕПЛО. А УЖЕ ПОСЛЕ ЭТОГО МОЖНО САДИТЬСЯ И
Dialogue: 0,0:09:06.81,0:09:09.13,Caption,,0,0,0,,ОБСУЖДАТЬ ГЕОПОЛИТИКУ, РАКЕТЫ,
Dialogue: 0,0:09:09.29,0:09:12.25,Caption,,0,0,0,,АРХИТЕКТУРУ БЕЗОПАСНОСТИ И КТО КОМУ ЧТО ДОЛЖЕН ЧЕРЕЗ
Dialogue: 0,0:09:12.33,0:09:14.89,Caption,,0,0,0,,ДВА ГОДА. И КОГДА ДОМА ХОЛОДНО,
Dialogue: 0,0:09:15.13,0:09:17.45,Caption,,0,0,0,,ДЕТИ МЁРЗНУТ, А СВЕТА НЕТ СУТКАМИ,
Dialogue: 0,0:09:17.77,0:09:20.25,Caption,,0,0,0,,ЛЮДИ МОГУТ ПОТРЕБОВАТЬ НЕ ПРОДОЛЖЕНИЯ КОНФЛИКТА,
Dialogue: 0,0:09:20.41,0:09:23.45,Caption,,0,0,0,,А ЕГО ОКОНЧАНИЯ. ИМ СНАЧАЛА НУЖНО ВЕРНУТЬ НОРМАЛЬНУЮ
Dialogue: 0,0:09:23.45,0:09:26.49,Caption,,0,0,0,,ЖИЗНЬ. ПРИЧЁМ ПРОБЛЕМА НЕ ТОЛЬКО В КИЕВЕ. ЭКСПЕРТ
Dialogue: 0,0:09:26.49,0:09:29.37,Caption,,0,0,0,,АНДРИАН ПРОКИП ОТДЕЛЬНО ГОВОРИТ ОБ ОДЕССЕ И ДНЕПРЕ.
Dialogue: 0,0:09:29.52,0:09:33.13,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, УДАРЫ НАПРАВЛЕНЫ В ТОМ ЧИСЛЕ НА ЭНЕРГЕТИЧЕСКИЕ
Dialogue: 0,0:09:33.13,0:09:36.73,Caption,,0,0,0,,СОЕДИНЕНИЯ, ЧЕРЕЗ КОТОРЫЕ ГОРОДА ПОЛУЧАЮТ ЭЛЕКТРИЧЕСТВО ИЗ ОБЩЕЙ
Dialogue: 0,0:09:36.73,0:09:39.77,Caption,,0,0,0,,СИСТЕМЫ. ЕСЛИ ТАКИЕ СОЕДИНЕНИЯ ВЫБИВАЮТСЯ,
Dialogue: 0,0:09:40.01,0:09:43.13,Caption,,0,0,0,,ГОРОД ПРЕВРАЩАЕТСЯ В ОСТРОВ. А ЭЛЕКТРИЧЕСКИЙ ОСТРОВ
Dialogue: 0,0:09:43.21,0:09:47.53,Caption,,0,0,0,,РАЗМЕРОМ С КИЕВ ИЛИ ОДЕССУ, ЭТО УЖЕ НЕ ИСТОРИЯ ПРО НЕУДОБСТВА. ТАМ СРАЗУ
Dialogue: 0,0:09:47.61,0:09:50.49,Caption,,0,0,0,,НАЧИНАЮТ РАБОТАТЬ ВСЕ ОСТАЛЬНЫЕ ПРОБЛЕМЫ. ВОДА
Dialogue: 0,0:09:50.49,0:09:57.08,Caption,,0,0,0,,ЗАВИСИТ ОТ ЭЛЕКТРОЭНЕРГИИ. СВЯЗЬ ЗАВИСИТ ОТ ЭЛЕКТРОЭНЕРГИИ. НАСОСЫ,
Dialogue: 0,0:09:57.16,0:09:59.55,Caption,,0,0,0,,ТРАНСПОРТ, ОТОПЛЕНИЕ, МАГАЗИНЫ,
Dialogue: 0,0:09:59.79,0:10:04.12,Caption,,0,0,0,,БЫТОВАЯ ИНФРАСТРУКТУРА, ВСЁ ОЧЕНЬ БЫСТРО ПЕРЕСТАЁТ БЫТЬ ОТДЕЛЬНЫМИ ВОПРОСАМИ
Dialogue: 0,0:10:04.12,0:10:05.55,Caption,,0,0,0,,И СКЛАДЫВАЕТСЯ В ОДИН БОЛЬШОЙ.
Dialogue: 0,0:10:06.11,0:10:08.76,Caption,,0,0,0,,И ВОТ ПОСЛЕ ЭТОГО СТАНОВИТСЯ ПОНЯТНЕЕ НЕРВНОЕ
Dialogue: 0,0:10:08.76,0:10:11.88,Caption,,0,0,0,,ЗАЯВЛЕНИЕ НАГОРНЯКА. ОН ГОВОРИТ НЕ ПРО АБСТРАКТНЫЙ
Dialogue: 0,0:10:11.88,0:10:14.12,Caption,,0,0,0,,НАРОДНЫЙ ГНЕВ. ОН ГОВОРИТ ПРО ЛЮДЕЙ,
Dialogue: 0,0:10:14.36,0:10:18.36,Caption,,0,0,0,,КОТОРЫЕ НЕ БУДУТ РАЗБИРАТЬСЯ, КТО ИМЕННО ВИНОВАТ ЦЕНТРАЛЬНАЯ ВЛАСТЬ,
Dialogue: 0,0:10:18.44,0:10:22.52,Caption,,0,0,0,,ГОРОДСКАЯ ВЛАСТЬ, ПАРЛАМЕНТ ИЛИ ЕЩЁ КТО НИБУДЬ. КОГДА ХОЛОДНО,
Dialogue: 0,0:10:22.76,0:10:25.00,Caption,,0,0,0,,ИСКАТЬ ОТВЕТСТВЕННОГО ПО ДОЛЖНОСТНОЙ ИНСТРУКЦИИ
Dialogue: 0,0:10:25.00,0:10:27.32,Caption,,0,0,0,,НИКТО НЕ БУДЕТ. И ЗДЕСЬ МЕРЦ СО СВОИМ
Dialogue: 0,0:10:27.32,0:10:29.72,Caption,,0,0,0,,БЮДЖЕТОМ ВДРУГ ОКАЗЫВАЕТСЯ В ОЧЕНЬ СТРАННОМ
Dialogue: 0,0:10:29.72,0:10:32.60,Caption,,0,0,0,,ПОЛОЖЕНИИ. ОН ПЫТАЕТСЯ ЗАСТАВИТЬ ЕВРОПУ ПРИНЯТЬ
Dialogue: 0,0:10:32.60,0:10:34.76,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА НА ГОДЫ ВПЕРЁД В ОТНОШЕНИИ
Dialogue: 0,0:10:34.76,0:10:38.92,Caption,,0,0,0,,ГОСУДАРСТВА, ВНУТРИ КОТОРОГО БЛИЖАЙШИЕ МЕСЯЦЫ САМИ СПОСОБНЫ ОЧЕНЬ
Dialogue: 0,0:10:38.92,0:10:41.96,Caption,,0,0,0,,СЕРЬЁЗНО ПОМЕНЯТЬ ПОЛИТИЧЕСКУЮ СИТУАЦИЮ. МОЖНО
Dialogue: 0,0:10:41.96,0:10:45.00,Caption,,0,0,0,,УТВЕРДИТЬ ФИНАНСИРОВАНИЕ. МОЖНО ПРОДЛИТЬ ПОДГОТОВКУ
Dialogue: 0,0:10:45.00,0:10:48.60,Caption,,0,0,0,,АРМИИ. МОЖНО ЗАКАЗАТЬ РАКЕТЫ. НО НЕЛЬЗЯ ГОЛОСОВАНИЕМ
Dialogue: 0,0:10:48.60,0:10:51.24,Caption,,0,0,0,,ЕВРОПЕЙСКОГО СОВЕТА ПРИКАЗАТЬ КИЕВЛЯНАМ СПОКОЙНО
Dialogue: 0,0:10:51.24,0:10:53.88,Caption,,0,0,0,,СИДЕТЬ ДВЕ НЕДЕЛИ БЕЗ СВЕТА И БЛАГОДАРИТЬ ЗА
Dialogue: 0,0:10:53.96,0:10:56.04,Caption,,0,0,0,,ПРОГРАММУ НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОЙ ГОД.
Dialogue: 0,0:10:56.59,0:10:59.16,Caption,,0,0,0,,В ЭТОМ И ЗАКЛЮЧАЕТСЯ ГЛАВНАЯ ПРОБЛЕМА ВСЕЙ НЫНЕШНЕЙ
Dialogue: 0,0:10:59.16,0:11:03.48,Caption,,0,0,0,,КОНСТРУКЦИИ. НАВЕРХУ ВСЁ ЕЩЁ ЖИВУТ ДЛИННЫМИ СТРАТЕГИЯМИ. КТО
Dialogue: 0,0:11:03.48,0:11:07.00,Caption,,0,0,0,,СКОЛЬКО ДАСТ. КТО СКОЛЬКО ПРОИЗВЕДЁТ. КТО ГДЕ БУДЕТ
Dialogue: 0,0:11:07.00,0:11:12.86,Caption,,0,0,0,,УЧИТЬСЯ. КТО КАКИЕ ГАРАНТИИ ПОДПИШЕТ. ГДЕ ВСТРЕТЯТСЯ ЛИДЕРЫ.
Dialogue: 0,0:11:13.11,0:11:16.06,Caption,,0,0,0,,КАКИМ БОЛЬШИНСТВОМ ПРОГОЛОСУЮТ. А СНИЗУ НАЧИНАЕТ
Dialogue: 0,0:11:16.14,0:11:18.54,Caption,,0,0,0,,ПОДНИМАТЬСЯ СОВСЕМ ДРУГАЯ РЕАЛЬНОСТЬ. ОНА НЕ
Dialogue: 0,0:11:18.54,0:11:22.06,Caption,,0,0,0,,СПРАШИВАЕТ, КАКОЙ ПЛАН БЫЛ ПРАВИЛЬНЫМ ПЯТЬ ЛЕТ НАЗАД. ОНА
Dialogue: 0,0:11:22.06,0:11:25.98,Caption,,0,0,0,,СПРАШИВАЕТ, ПОЧЕМУ ДОМА ХОЛОДНО СЕЙЧАС. И ЕСЛИ ОТВЕТ НА
Dialogue: 0,0:11:26.06,0:11:30.46,Caption,,0,0,0,,ЭТОТ ВОПРОС НЕ ПОЯВИТСЯ, ТО ВЕСЬ ЕВРОПЕЙСКИЙ ХОР РИСКУЕТ ОДНАЖДЫ ОБНАРУЖИТЬ,
Dialogue: 0,0:11:30.78,0:11:34.94,Caption,,0,0,0,,ЧТО СПОРИЛ О ПАРТИИ, КОТОРОЙ УЖЕ НЕКОМУ ИГРАТЬ. МЕРЦ МОЖЕТ ДАВИТЬ НА
Dialogue: 0,0:11:35.02,0:11:37.82,Caption,,0,0,0,,ВЕНГРИЮ. МОЖЕТ ДАВИТЬ НА СЛОВАКИЮ. ГЕРМАНИЯ
Dialogue: 0,0:11:37.82,0:11:40.06,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО МОЖЕТ ИСПОЛЬЗОВАТЬ СВОЙ ЭКОНОМИЧЕСКИЙ
Dialogue: 0,0:11:40.14,0:11:42.38,Caption,,0,0,0,,ВЕС И ЗАСТАВЛЯТЬ ПАРТНЁРОВ СЧИТАТЬСЯ СО СВОЕЙ
Dialogue: 0,0:11:42.38,0:11:45.42,Caption,,0,0,0,,ПОЗИЦИЕЙ. НО ДАЖЕ ГЕРМАНИЯ НЕ МОЖЕТ ОТМЕНИТЬ ПРОСТУЮ
Dialogue: 0,0:11:45.50,0:11:48.14,Caption,,0,0,0,,ВЕЩЬ ПОЛИТИЧЕСКИЕ ПЛАНЫ РАБОТАЮТ ТОЛЬКО ДО ТЕХ ПОР,
Dialogue: 0,0:11:48.30,0:11:50.38,Caption,,0,0,0,,ПОКА ЛЮДИ ГОТОВЫ ИХ ОПЛАЧИВАТЬ И ТЕРПЕТЬ ИХ
Dialogue: 0,0:11:50.38,0:11:53.10,Caption,,0,0,0,,ПОСЛЕДСТВИЯ. ВОТ ПОЭТОМУ ИСТОРИЯ СЕЙЧАС НЕ ПРО
Dialogue: 0,0:11:53.10,0:11:56.06,Caption,,0,0,0,,ОЧЕРЕДНОЙ РАУНД ПЕРЕГОВОРОВ. ПЕРЕГОВОРЫ ЕЩЁ БУДУТ.
Dialogue: 0,0:11:56.38,0:11:59.74,Caption,,0,0,0,,БУДУТ КРАСИВЫЕ ЗАЯВЛЕНИЯ. БУДУТ НОВЫЕ МЕСТА ВСТРЕЧ.
Dialogue: 0,0:11:59.98,0:12:03.90,Caption,,0,0,0,,ЕСЛИ ПОНАДОБИТСЯ, ПИНГВИНЫ ТОЖЕ ПОТЕРПЯТ. НО НАСТОЯЩАЯ РАЗВИЛКА
Dialogue: 0,0:12:03.90,0:12:06.70,Caption,,0,0,0,,НАХОДИТСЯ СОВСЕМ НЕ ТАМ. ОДНИ УЖЕ ПОНЯЛИ,
Dialogue: 0,0:12:06.88,0:12:09.10,Caption,,0,0,0,,ЧТО ПРЕЖНИЙ РАСЧЁТ НЕ ДАЛ ТОГО РЕЗУЛЬТАТА,
Dialogue: 0,0:12:09.41,0:12:12.86,Caption,,0,0,0,,НА КОТОРЫЙ РАССЧИТЫВАЛИ, И ИЩУТ ДРУГУЮ ДОРОГУ. ДРУГИЕ,
Dialogue: 0,0:12:13.02,0:12:16.62,Caption,,0,0,0,,КАК МЕРЦ, ПЫТАЮТСЯ ЛЮБОЙ ЦЕНОЙ УДЕРЖАТЬ ПРЕЖНИЙ КУРС И ЕЩЁ
Dialogue: 0,0:12:16.62,0:12:18.38,Caption,,0,0,0,,ПРИСТЕГНУТЬ К НЕМУ ВСЕХ ОСТАЛЬНЫХ.
Dialogue: 0,0:12:20.66,0:12:22.82,Caption,,0,0,0,,А ТРЕТЬЯ СТОРОНА В ЭТОМ СПОРЕ ПОКА ВООБЩЕ
Dialogue: 0,0:12:22.82,0:12:25.86,Caption,,0,0,0,,СИДИТ БЕЗ МИКРОФОНА. ЭТО ОБЫЧНЫЕ ЛЮДИ. И ЕСЛИ
Dialogue: 0,0:12:25.94,0:12:28.26,Caption,,0,0,0,,В ДОМАХ ДЕЙСТВИТЕЛЬНО СТАНЕТ ТЕМНО И ХОЛОДНО
Dialogue: 0,0:12:28.26,0:12:30.66,Caption,,0,0,0,,НАДОЛГО, МИКРОФОН ИМ УЖЕ НЕ ПОНАДОБИТСЯ.
