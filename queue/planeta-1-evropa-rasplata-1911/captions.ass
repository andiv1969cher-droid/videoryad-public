Dialogue: 0,0:00:00.04,0:00:02.76,Caption,,0,0,0,,В БРЮССЕЛЕ НЕСКОЛЬКО ЛЕТ ГОТОВИЛИ ДЛЯ РОССИИ ОЧЕНЬ
Dialogue: 0,0:00:02.76,0:00:05.96,Caption,,0,0,0,,ГОРЬКОЕ ЛЕКАРСТВО. РЕЦЕПТ ВЫПИСЫВАЛИ ТОРЖЕСТВЕННО,
Dialogue: 0,0:00:06.20,0:00:11.00,Caption,,0,0,0,,ДОЗУ УВЕЛИЧИВАЛИ РЕГУЛЯРНО, А ПРЕДУПРЕЖДЕНИЯ О ПОБОЧНЫХ ЭФФЕКТАХ СЧИТАЛИ ВРЕДНОЙ
Dialogue: 0,0:00:11.00,0:00:14.52,Caption,,0,0,0,,ПРОПАГАНДОЙ. ТЕПЕРЬ ВЛАДИМИР ПУТИН ПРЕДЛАГАЕТ ПОСМОТРЕТЬ НА
Dialogue: 0,0:00:14.52,0:00:17.24,Caption,,0,0,0,,ПАЦИЕНТА И НА ВРАЧЕЙ. РОССИЯ,
Dialogue: 0,0:00:17.40,0:00:22.04,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ВЫСТОЯЛА, А ЕВРОПА ОБНАРУЖИЛА У СЕБЯ ПРОМЫШЛЕННУЮ СЛАБОСТЬ,
Dialogue: 0,0:00:22.20,0:00:25.80,Caption,,0,0,0,,РАСТУЩИЕ ДОЛГИ И ПАДЕНИЕ УРОВНЯ ЖИЗНИ. ПОЛУЧИЛСЯ
Dialogue: 0,0:00:25.88,0:00:28.28,Caption,,0,0,0,,РЕДКИЙ МЕДИЦИНСКИЙ СЛУЧАЙ ЛЕЧИЛИ СОСЕДА,
Dialogue: 0,0:00:28.52,0:00:31.40,Caption,,0,0,0,,А ДАВЛЕНИЕ ПОЧЕМУ ТО ПОДСКОЧИЛО У ВСЕГО КОНСИЛИУМА.
Dialogue: 0,0:00:31.52,0:00:34.36,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ ПОСЛЕДСТВИЯ ОКАЗАЛИСЬ НАМНОГО
Dialogue: 0,0:00:34.36,0:00:38.20,Caption,,0,0,0,,КРАСНОРЕЧИВЕЕ ТЕХ, КТО ГОДАМИ ОБЕЩАЛ ИХ ИСКЛЮЧИТЕЛЬНО МОСКВЕ.
Dialogue: 0,0:00:38.99,0:00:41.24,Caption,,0,0,0,,НА ДЕЛОВОМ САММИТЕ АТЭС ПУТИН НАПОМНИЛ,
Dialogue: 0,0:00:41.48,0:00:44.28,Caption,,0,0,0,,ЧТО РОССИЯ СТАЛА МИРОВЫМ РЕКОРДСМЕНОМ ПО КОЛИЧЕСТВУ
Dialogue: 0,0:00:44.28,0:00:47.24,Caption,,0,0,0,,ВВЕДЁННЫХ ПРОТИВ НЕЁ САНКЦИЙ. ОГРАНИЧЕНИЙ НАКОПИЛИ
Dialogue: 0,0:00:47.24,0:00:50.44,Caption,,0,0,0,,СТОЛЬКО, ЧТО ИХ УЖЕ МОЖНО РАСКЛАДЫВАТЬ НЕ ПО ПАКЕТАМ,
Dialogue: 0,0:00:50.52,0:00:53.40,Caption,,0,0,0,,А ПО ШКАФАМ. ВЕРХНЯЯ ПОЛКА ДЛЯ ФИНАНСОВЫХ МЕР,
Dialogue: 0,0:00:53.70,0:00:56.60,Caption,,0,0,0,,НИЖНЯЯ ДЛЯ ТОРГОВЫХ, ОТДЕЛЬНЫЙ ЯЩИК ДЛЯ ТЕХ,
Dialogue: 0,0:00:56.76,0:00:59.96,Caption,,0,0,0,,СМЫСЛ КОТОРЫХ ЗАБЫЛИ ЕЩЁ ДО ПУБЛИКАЦИИ. НО РЕКОРД
Dialogue: 0,0:00:59.96,0:01:02.60,Caption,,0,0,0,,САМ ПО СЕБЕ НИЧЕГО НЕ ДОКАЗЫВАЕТ. САНКЦИИ
Dialogue: 0,0:01:02.60,0:01:04.92,Caption,,0,0,0,,ЗАДУМЫВАЛИСЬ НЕ КАК КОЛЛЕКЦИЯ БРЮССЕЛЬСКИХ
Dialogue: 0,0:01:04.92,0:01:07.96,Caption,,0,0,0,,ДОСТИЖЕНИЙ. ОНИ ДОЛЖНЫ БЫЛИ ЛОМАТЬ ЭКОНОМИКУ,
Dialogue: 0,0:01:08.12,0:01:12.52,Caption,,0,0,0,,ЗАКРЫВАТЬ РЫНКИ, ОСТАНАВЛИВАТЬ РАСЧЁТЫ И ДЕЛАТЬ ПРЕЖНЮЮ МОДЕЛЬ
Dialogue: 0,0:01:12.52,0:01:18.32,Caption,,0,0,0,,РАЗВИТИЯ НЕВОЗМОЖНОЙ. ЕСЛИ ПОСЛЕ МНОЖЕСТВА УДАРОВ ЦЕЛЬ ПРОДОЛЖАЕТ
Dialogue: 0,0:01:18.32,0:01:21.12,Caption,,0,0,0,,ДВИГАТЬСЯ, СТОИТ ПРОВЕРИТЬ НЕ ГРОМКОСТЬ ЗАМАХА,
Dialogue: 0,0:01:21.43,0:01:24.48,Caption,,0,0,0,,А РЕЗУЛЬТАТ ПОПАДАНИЯ. ПО ОЦЕНКЕ ПУТИНА,
Dialogue: 0,0:01:24.72,0:01:27.84,Caption,,0,0,0,,РОССИЯ ДАВЛЕНИЕ ВЫДЕРЖАЛА И ПЕРЕСТРОИЛАСЬ. ПРИШЛОСЬ
Dialogue: 0,0:01:27.84,0:01:30.64,Caption,,0,0,0,,МЕНЯТЬ ТОРГОВЫЕ МАРШРУТЫ, СПОСОБЫ ОПЛАТЫ,
Dialogue: 0,0:01:30.80,0:01:33.84,Caption,,0,0,0,,ПОСТАВЩИКОВ И ПОКУПАТЕЛЕЙ. ЛЕГКО НЕ БЫЛО. ЗАТО
Dialogue: 0,0:01:33.84,0:01:37.28,Caption,,0,0,0,,ЕВРОПА, КОТОРАЯ ДОБРОВОЛЬНО ОТКАЗАЛАСЬ ОТ РОССИЙСКОГО РЫНКА
Dialogue: 0,0:01:37.36,0:01:41.36,Caption,,0,0,0,,И ПРИВЫЧНЫХ СВЯЗЕЙ, ТЕПЕРЬ САМА РАЗБИРАЕТСЯ С ДОРОГИМ ПРОИЗВОДСТВОМ,
Dialogue: 0,0:01:41.60,0:01:43.36,Caption,,0,0,0,,ПОТЕРЕЙ КОНКУРЕНТОСПОСОБНОСТИ,
Dialogue: 0,0:01:43.52,0:01:48.72,Caption,,0,0,0,,ДОЛГАМИ И УХУДШЕНИЕМ ЖИЗНИ. ЗАМЫСЕЛ ВЕДЬ КАЗАЛСЯ ПОЧТИ БЕЗУПРЕЧНЫМ. РОССИИ
Dialogue: 0,0:01:48.72,0:01:51.60,Caption,,0,0,0,,ПЕРЕКРОЮТ ДОСТУП К РЫНКАМ. ОГРАНИЧАТ РАСЧЁТЫ.
Dialogue: 0,0:01:51.94,0:01:54.80,Caption,,0,0,0,,ОТКАЖУТСЯ ОТ РЕСУРСОВ. ПОДНИМУТ ЦЕНУ КАЖДОГО
Dialogue: 0,0:01:54.80,0:01:57.04,Caption,,0,0,0,,РЕШЕНИЯ. МОСКВА БУДЕТ МЕТАТЬСЯ,
Dialogue: 0,0:01:57.20,0:01:59.92,Caption,,0,0,0,,А ЕВРОПА СПОКОЙНО НАБЛЮДАТЬ С БЕЗОПАСНОГО БАЛКОНА.
Dialogue: 0,0:02:00.29,0:02:03.28,Caption,,0,0,0,,СПУСТЯ НЕСКОЛЬКО ЛЕТ СЛОВО "ДОРОГО" ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:02:03.36,0:02:06.40,Caption,,0,0,0,,СТАЛО ГЛАВНЫМ. ТОЛЬКО ПРОИЗНОСЯТ ЕГО ТЕПЕРЬ НЕ ТАМ,
Dialogue: 0,0:02:06.48,0:02:10.40,Caption,,0,0,0,,ГДЕ ПЛАНИРОВАЛИ. ДЛЯ ПОДТВЕРЖДЕНИЯ НЕ НУЖНО ПОГРУЖАТЬСЯ В ОТЧЁТЫ,
Dialogue: 0,0:02:10.56,0:02:12.80,Caption,,0,0,0,,ОТ КОТОРЫХ ДАЖЕ КАЛЬКУЛЯТОР ПРОСИТ ОТПУСК.
Dialogue: 0,0:02:13.04,0:02:15.92,Caption,,0,0,0,,ДОСТАТОЧНО ПОСМОТРЕТЬ НА MERCEDES. ДЛЯ ГЕРМАНИИ ЭТО
Dialogue: 0,0:02:15.92,0:02:19.76,Caption,,0,0,0,,НАМНОГО БОЛЬШЕ, ЧЕМ АВТОМОБИЛЬНАЯ КОМПАНИЯ. ТРЁХЛУЧЕВАЯ ЗВЕЗДА
Dialogue: 0,0:02:19.76,0:02:22.56,Caption,,0,0,0,,ДЕСЯТИЛЕТИЯМИ РАБОТАЛА КАК НАЦИОНАЛЬНАЯ ПОДПИСЬ ПОД
Dialogue: 0,0:02:22.56,0:02:25.28,Caption,,0,0,0,,СЛОВАМИ "МЫ УМЕЕМ ПРОИЗВОДИТЬ СЛОЖНЫЕ ВЕЩИ".
Dialogue: 0,0:02:25.70,0:02:28.00,Caption,,0,0,0,,НЕМЕЦКИЕ МАШИНЫ ПРОДАВАЛИ НЕ ТОЛЬКО МЕТАЛЛ,
Dialogue: 0,0:02:28.16,0:02:33.42,Caption,,0,0,0,,ДВИГАТЕЛЬ И СИДЕНЬЯ. ОНИ ПРОДАВАЛИ УВЕРЕННОСТЬ В ТОМ,
Dialogue: 0,0:02:33.58,0:02:36.06,Caption,,0,0,0,,ЧТО НЕМЕЦКАЯ ПРОМЫШЛЕННОСТЬ ПЕРЕЖИВЁТ ОЧЕРЕДНОЙ
Dialogue: 0,0:02:36.06,0:02:39.50,Caption,,0,0,0,,КРИЗИС И ЕЩЁ ОСТАНЕТСЯ, ЧТОБЫ ОБЪЯСНИТЬ КОНКУРЕНТАМ,
Dialogue: 0,0:02:39.73,0:02:44.06,Caption,,0,0,0,,ГДЕ ТЕ ОШИБЛИСЬ. MERCEDES ПРОШЁЛ ЧЕРЕЗ НАЦИСТСКУЮ ЭПОХУ,
Dialogue: 0,0:02:44.28,0:02:46.94,Caption,,0,0,0,,МИРОВУЮ ВОЙНУ, РАЗРУШЕНИЕ ГЕРМАНИИ,
Dialogue: 0,0:02:47.09,0:02:49.74,Caption,,0,0,0,,РАЗДЕЛ СТРАНЫ И ПОСЛЕДУЮЩЕЕ ОБЪЕДИНЕНИЕ.
Dialogue: 0,0:02:50.45,0:02:52.62,Caption,,0,0,0,,КОМПАНИЯ ВЫДЕРЖИВАЛА НЕФТЯНЫЕ КРИЗИСЫ,
Dialogue: 0,0:02:52.78,0:02:55.98,Caption,,0,0,0,,ИНФЛЯЦИЮ И НАСТУПЛЕНИЕ ПРОИЗВОДИТЕЛЕЙ ИЗ ЯПОНИИ,
Dialogue: 0,0:02:56.06,0:02:59.18,Caption,,0,0,0,,СОЕДИНЁННЫХ ШТАТОВ И КОРЕИ. ПРЕДПРИЯТИЯ ПРОДОЛЖАЛИ
Dialogue: 0,0:02:59.18,0:03:01.26,Caption,,0,0,0,,РАБОТАТЬ. КОМПАНИЯ ИНВЕСТИРОВАЛА,
Dialogue: 0,0:03:01.41,0:03:05.58,Caption,,0,0,0,,РАСШИРЯЛАСЬ И ДОКАЗЫВАЛА, ЧТО НЕМЕЦКИЙ ЗАВОД МОЖЕТ БЫТЬ ДОРОГИМ,
Dialogue: 0,0:03:05.73,0:03:08.86,Caption,,0,0,0,,НО ВСЁ РАВНО ВЫГОДНЫМ. ТЕПЕРЬ РУКОВОДСТВО MERCEDES
Dialogue: 0,0:03:09.10,0:03:11.82,Caption,,0,0,0,,ПРИОСТАНАВЛИВАЕТ ДАЛЬНЕЙШИЕ ВЛОЖЕНИЯ В ПРЕДПРИЯТИЯ
Dialogue: 0,0:03:11.90,0:03:15.26,Caption,,0,0,0,,НА ТЕРРИТОРИИ ГЕРМАНИИ. РЕЧЬ НЕ О МАЛЕНЬКОЙ МАСТЕРСКОЙ,
Dialogue: 0,0:03:15.51,0:03:17.90,Caption,,0,0,0,,КОТОРАЯ РЕШИЛА ПЕРЕБРАТЬСЯ В СОСЕДНИЙ КВАРТАЛ ПОСЛЕ
Dialogue: 0,0:03:17.90,0:03:21.10,Caption,,0,0,0,,ПОВЫШЕНИЯ АРЕНДЫ. ОДНА ИЗ ГЛАВНЫХ НЕМЕЦКИХ КОМПАНИЙ
Dialogue: 0,0:03:21.18,0:03:23.58,Caption,,0,0,0,,НЕ СПЕШИТ ВКЛАДЫВАТЬ НОВЫЕ СРЕДСТВА В НЕМЕЦКОЕ
Dialogue: 0,0:03:23.58,0:03:26.86,Caption,,0,0,0,,ПРОИЗВОДСТВО. ГЕРМАНИЯ ОСТАЛАСЬ НА МЕСТЕ. ШТУТГАРТ
Dialogue: 0,0:03:26.94,0:03:29.66,Caption,,0,0,0,,ТОЖЕ НИКУДА НЕ ИСЧЕЗ. ИНЖЕНЕРЫ НЕ ИСПАРИЛИСЬ.
Dialogue: 0,0:03:29.98,0:03:32.62,Caption,,0,0,0,,ЭМБЛЕМЫ С КАПОТОВ ПО НОЧАМ НИКТО НЕ СКРУЧИВАЕТ.
Dialogue: 0,0:03:32.85,0:03:35.26,Caption,,0,0,0,,ПРОБЛЕМА В СТОИМОСТИ ПРОИЗВОДСТВА. РУКОВОДСТВО
Dialogue: 0,0:03:35.26,0:03:39.02,Caption,,0,0,0,,ИЗУЧАЕТ, КАКИЕ ПРЕДПРИЯТИЯ КОМПАНИЯ ЕЩЁ СПОСОБНА СОДЕРЖАТЬ.
Dialogue: 0,0:03:39.57,0:03:41.98,Caption,,0,0,0,,В ОБСУЖДЕНИИ УЖЕ ВОЗНИКЛА ВОЗМОЖНОСТЬ ЗАКРЫТИЯ
Dialogue: 0,0:03:41.98,0:03:45.10,Caption,,0,0,0,,ОТДЕЛЬНЫХ ЗАВОДОВ. РАНЬШЕ НЕМЕЦКИМ ПРЕДПРИЯТИЕМ
Dialogue: 0,0:03:45.10,0:03:50.01,Caption,,0,0,0,,ГОРДИЛИСЬ. ТЕПЕРЬ НА НЕГО СМОТРЯТ И ПРИКИДЫВАЮТ,
Dialogue: 0,0:03:50.22,0:03:53.13,Caption,,0,0,0,,СКОЛЬКО ИМЕННО СТОИТ ПРОДОЛЖЕНИЕ ЭТОЙ ГОРДОСТИ.
Dialogue: 0,0:03:53.83,0:03:56.73,Caption,,0,0,0,,ГЛАВА ПРОИЗВОДСТВА MERCEDES МИХАЭЛЬ ШИБЕ НАЗВАЛ
Dialogue: 0,0:03:56.73,0:04:00.17,Caption,,0,0,0,,РАЗНИЦУ, ПОСЛЕ КОТОРОЙ МНОГИЕ КРАСИВЫЕ РЕЧИ ЛУЧШЕ СРАЗУ
Dialogue: 0,0:04:00.25,0:04:03.29,Caption,,0,0,0,,УБРАТЬ ПОДАЛЬШЕ. ОДИН ЧАС ПРОИЗВОДСТВА В ГЕРМАНИИ
Dialogue: 0,0:04:03.29,0:04:08.01,Caption,,0,0,0,,ОБХОДИТСЯ В ПЯТЬ РАЗ ДОРОЖЕ, ЧЕМ В ВОСТОЧНОЙ ЕВРОПЕ. НЕ НА ДЕСЯТЬ ПРОЦЕНТОВ.
Dialogue: 0,0:04:08.25,0:04:10.73,Caption,,0,0,0,,НЕ НА ТРЕТЬ. В ПЯТЬ РАЗ. ЭТО УЖЕ
Dialogue: 0,0:04:10.81,0:04:14.89,Caption,,0,0,0,,НЕ СПОР О ТОМ, ГДЕ ДЕШЕВЛЕ ОБЕД ДЛЯ СОТРУДНИКОВ. ДВА ПРЕДПРИЯТИЯ
Dialogue: 0,0:04:14.89,0:04:16.97,Caption,,0,0,0,,МОГУТ ВЫПУСКАТЬ ОДИНАКОВУЮ ПРОДУКЦИЮ,
Dialogue: 0,0:04:17.37,0:04:19.61,Caption,,0,0,0,,НО ОДНО ЕЩЁ ДО СТАРТА ПОЛУЧАЕТ К НОГЕ
Dialogue: 0,0:04:19.61,0:04:23.05,Caption,,0,0,0,,БЕТОННУЮ ТУМБУ. ЗАТЕМ ЕМУ СОВЕТУЮТ БЫСТРЕЕ БЕЖАТЬ И
Dialogue: 0,0:04:23.05,0:04:25.21,Caption,,0,0,0,,НЕ ЖАЛОВАТЬСЯ НА МЕЖДУНАРОДНУЮ КОНКУРЕНЦИЮ.
Dialogue: 0,0:04:25.88,0:04:28.89,Caption,,0,0,0,,ОСОБЕННО ЕДКО ТЕПЕРЬ ЗВУЧИТ ВЫРАЖЕНИЕ MADE IN
Dialogue: 0,0:04:28.89,0:04:31.77,Caption,,0,0,0,,GERMANY. КОГДА ТО ЭТИ СЛОВА ЗАМЕНЯЛИ РЕКЛАМНУЮ
Dialogue: 0,0:04:31.77,0:04:34.57,Caption,,0,0,0,,КАМПАНИЮ. ПОКУПАТЕЛЬ ВИДЕЛ НЕМЕЦКОЕ ПРОИСХОЖДЕНИЕ
Dialogue: 0,0:04:34.57,0:04:37.37,Caption,,0,0,0,,ТОВАРА И ПОНИМАЛ, ЗА ЧТО ПЛАТИТ. ДОРОГО,
Dialogue: 0,0:04:37.66,0:04:40.17,Caption,,0,0,0,,ЗАТО НАДЁЖНО, КАЧЕСТВЕННО И НАДОЛГО.
Dialogue: 0,0:04:40.79,0:04:43.85,Caption,,0,0,0,,ТЕПЕРЬ ПОЯВИЛСЯ ДРУГОЙ ВЫВОД БРЕНД MADE IN GERMANY
Dialogue: 0,0:04:43.93,0:04:46.33,Caption,,0,0,0,,МЁРТВ. ФОРМУЛИРОВКА БЕСПОЩАДНАЯ,
Dialogue: 0,0:04:46.56,0:04:49.29,Caption,,0,0,0,,НО ПОЯВИЛАСЬ ОНА НЕ НА ПУСТОМ МЕСТЕ. ЕСЛИ
Dialogue: 0,0:04:49.29,0:04:52.09,Caption,,0,0,0,,ОДНА ИЗ САМЫХ УЗНАВАЕМЫХ НЕМЕЦКИХ КОМПАНИЙ РЕШАЕТ,
Dialogue: 0,0:04:52.33,0:04:54.49,Caption,,0,0,0,,НЕ СТАЛО ЛИ ПРОИЗВОДСТВО В САМОЙ ГЕРМАНИИ
Dialogue: 0,0:04:54.49,0:04:58.73,Caption,,0,0,0,,НЕПОЗВОЛИТЕЛЬНОЙ РОСКОШЬЮ, ИЗОБРАЖАТЬ РЯДОВУЮ ДЕЛОВУЮ КОРРЕКТИРОВКУ УЖЕ НЕ
Dialogue: 0,0:04:58.73,0:05:01.53,Caption,,0,0,0,,ПОЛУЧАЕТСЯ. А ВЕДЬ ПАРАЛЛЕЛЬНО ЕВРОПА ГОДАМИ
Dialogue: 0,0:05:01.53,0:05:03.77,Caption,,0,0,0,,РАССУЖДАЛА О СТРАТЕГИЧЕСКОЙ АВТОНОМИИ.
Dialogue: 0,0:05:06.04,0:05:09.48,Caption,,0,0,0,,ЗВУЧАЛО ВНУШИТЕЛЬНО. ЕВРОПА САМА ПРИНИМАЕТ РЕШЕНИЯ,
Dialogue: 0,0:05:09.67,0:05:12.36,Caption,,0,0,0,,ЗАЩИЩАЕТ ИНТЕРЕСЫ И НИ ОТ КОГО НЕ ЗАВИСИТ.
Dialogue: 0,0:05:12.84,0:05:15.48,Caption,,0,0,0,,ОСТАЛОСЬ ЛИШЬ УГОВОРИТЬ СОБСТВЕННУЮ ПРОМЫШЛЕННОСТЬ
Dialogue: 0,0:05:15.48,0:05:18.04,Caption,,0,0,0,,НЕ ИСКАТЬ ТЕРРИТОРИЮ, ГДЕ РАБОТАТЬ ДЕШЕВЛЕ.
Dialogue: 0,0:05:18.68,0:05:21.40,Caption,,0,0,0,,НАСТОЯЩАЯ САМОСТОЯТЕЛЬНОСТЬ НАЧИНАЕТСЯ НЕ С НОВОЙ
Dialogue: 0,0:05:21.40,0:05:24.04,Caption,,0,0,0,,ДЕКЛАРАЦИИ. ОНА НАЧИНАЕТСЯ С СИТУАЦИИ,
Dialogue: 0,0:05:24.36,0:05:27.40,Caption,,0,0,0,,В КОТОРОЙ ГЛАВНЫЙ АВТОМОБИЛЬНЫЙ СИМВОЛ СТРАНЫ НЕ
Dialogue: 0,0:05:27.40,0:05:30.12,Caption,,0,0,0,,РАССМАТРИВАЕТ РОДИНУ КАК ПЛОЩАДКУ С НЕПРИЛИЧНО
Dialogue: 0,0:05:30.12,0:05:32.92,Caption,,0,0,0,,ВЫСОКИМ ЦЕННИКОМ. ПОЭТОМУ СЛОВА ПУТИНА ПОЛУЧАЮТ
Dialogue: 0,0:05:32.92,0:05:35.96,Caption,,0,0,0,,ВПОЛНЕ МАТЕРИАЛЬНОЕ ПРОДОЛЖЕНИЕ. ЕВРОПА ОТКАЗАЛАСЬ
Dialogue: 0,0:05:36.04,0:05:39.08,Caption,,0,0,0,,ОТ РОССИЙСКОГО РЫНКА, РАЗРУШИЛА ПРЕЖНИЕ СВЯЗИ,
Dialogue: 0,0:05:39.24,0:05:42.68,Caption,,0,0,0,,ВВОДИЛА ОГРАНИЧЕНИЯ И ОБЕЩАЛА ОСЛАБИТЬ РОССИЮ. В
Dialogue: 0,0:05:42.68,0:05:45.40,Caption,,0,0,0,,РЕЗУЛЬТАТЕ ОНА РИСКУЕТ ЛИШИТЬСЯ ЧАСТИ СОБСТВЕННОГО
Dialogue: 0,0:05:45.40,0:05:48.44,Caption,,0,0,0,,ПРОМЫШЛЕННОГО ПОТЕНЦИАЛА. MERCEDES НЕ ЗАЯВЛЯЕТ,
Dialogue: 0,0:05:48.60,0:05:51.24,Caption,,0,0,0,,ЧТО ЕГО РЕШЕНИЯ ВЫЗВАНЫ САНКЦИЯМИ ПРОТИВ РОССИИ.
Dialogue: 0,0:05:51.53,0:05:54.68,Caption,,0,0,0,,КОМПАНИЯ ГОВОРИТ ОБ ИЗДЕРЖКАХ. ПУТИН ТОЖЕ РАССУЖДАЕТ
Dialogue: 0,0:05:54.76,0:05:57.80,Caption,,0,0,0,,НЕ О СУДЬБЕ ОДНОГО ПРЕДПРИЯТИЯ. ЕГО ВЫВОД КАСАЕТСЯ
Dialogue: 0,0:05:57.81,0:06:00.84,Caption,,0,0,0,,ОБЩЕГО РЕЗУЛЬТАТА ЕВРОПЕЙСКОГО КУРСА. А ЭТОТ
Dialogue: 0,0:06:00.92,0:06:03.96,Caption,,0,0,0,,РЕЗУЛЬТАТ УЖЕ НЕ СПРЯЧЕШЬ ЗА БОДРОЙ РЕЧЬЮ. ЗАЯВЛЕНИЕ
Dialogue: 0,0:06:03.96,0:06:07.00,Caption,,0,0,0,,НЕ ОПЛАЧИВАЕТ ЗАРПЛАТУ. ОНО НЕ УМЕНЬШАЕТ СТОИМОСТЬ
Dialogue: 0,0:06:07.00,0:06:10.12,Caption,,0,0,0,,ПРОИЗВОДСТВЕННОГО ЧАСА И НЕ ВОЗВРАЩАЕТ НЕМЕЦКОМУ
Dialogue: 0,0:06:10.20,0:06:13.08,Caption,,0,0,0,,ПРЕДПРИЯТИЮ КОНКУРЕНТОСПОСОБНОСТЬ. ЕСЛИ ВАМ НРАВИТСЯ
Dialogue: 0,0:06:13.08,0:06:16.68,Caption,,0,0,0,,РАЗБИРАТЬ, КОМУ ДОСТАЮТСЯ РАСХОДЫ ПОСЛЕ ТОРЖЕСТВЕННЫХ ОБЕЩАНИЙ,
Dialogue: 0,0:06:16.82,0:06:22.08,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ДАЛЬШЕ СПОР ПОЙДЁТ УЖЕ НЕ ТОЛЬКО О ДЕНЬГАХ,
Dialogue: 0,0:06:22.22,0:06:25.20,Caption,,0,0,0,,НО И О ВЛАСТИ. ПОКА НЕМЕЦКАЯ ПРОМЫШЛЕННОСТЬ ИЗУЧАЕТ
Dialogue: 0,0:06:25.20,0:06:29.04,Caption,,0,0,0,,СВОИ СЧЕТА, ВО ФРАНЦИИ ПРЕДЛАГАЮТ ПРОВЕСТИ РЕВИЗИЮ ПОЛНОМОЧИЙ
Dialogue: 0,0:06:29.04,0:06:32.64,Caption,,0,0,0,,БРЮССЕЛЯ. МАРИН ЛЕ ПЕН И ЕЁ СОЮЗНИКИ ВЫСТУПИЛИ ЗА
Dialogue: 0,0:06:32.64,0:06:35.52,Caption,,0,0,0,,ЛИКВИДАЦИЮ ЛИБО РЕЗКОЕ СОКРАЩЕНИЕ ЕВРОПЕЙСКОЙ
Dialogue: 0,0:06:35.52,0:06:40.24,Caption,,0,0,0,,ДИПЛОМАТИЧЕСКОЙ СЛУЖБЫ, КОТОРОЙ РУКОВОДИТ КАЯ КАЛЛАС. ЭТО НЕ ОБЫЧНАЯ АТАКА
Dialogue: 0,0:06:40.24,0:06:43.28,Caption,,0,0,0,,НА НЕУГОДНОГО ЧИНОВНИКА. УБРАТЬ КАЛЛАС И НАЗНАЧИТЬ
Dialogue: 0,0:06:43.28,0:06:46.08,Caption,,0,0,0,,ДРУГОГО РУКОВОДИТЕЛЯ НЕСЛОЖНО. С ДВЕРИ СНИМУТ ОДНУ
Dialogue: 0,0:06:46.08,0:06:49.76,Caption,,0,0,0,,ТАБЛИЧКУ, ПОВЕСЯТ НОВУЮ, СОТРУДНИКИ РАЗОШЛЮТ ПОЗДРАВЛЕНИЯ,
Dialogue: 0,0:06:50.00,0:06:52.96,Caption,,0,0,0,,А АППАРАТ ПРОДОЛЖИТ ЖИТЬ ПРИВЫЧНОЙ ЖИЗНЬЮ. ЛЕ ПЕН
Dialogue: 0,0:06:52.96,0:06:56.32,Caption,,0,0,0,,СТАВИТ ВОПРОС ОПАСНЕЕ. НУЖНА ЛИ ЭТА СЛУЖБА ВООБЩЕ?
Dialogue: 0,0:06:57.03,0:06:59.76,Caption,,0,0,0,,СОВЕТНИК РУКОВОДСТВА НАЦИОНАЛЬНОГО ОБЪЕДИНЕНИЯ ШАРЛЬ
Dialogue: 0,0:06:59.84,0:07:04.80,Caption,,0,0,0,,АНРИ ГАЛЛУА УТВЕРЖДАЕТ, ЧТО ПОЛЬЗА КАЛЛАС КРАЙНЕ ОГРАНИЧЕНА. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:07:04.92,0:07:07.68,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ СЛУЖБА ПОВТОРЯЕТ РАБОТУ НАЦИОНАЛЬНЫХ
Dialogue: 0,0:07:07.68,0:07:11.84,Caption,,0,0,0,,ГОСУДАРСТВ, А ЕЁ ЛЕГИТИМНОСТЬ НЕ ПРИЗНАЮТ НИ СОЕДИНЁННЫЕ ШТАТЫ,
Dialogue: 0,0:07:12.06,0:07:15.12,Caption,,0,0,0,,НИ КИТАЙ. ДЛЯ БРЮССЕЛЯ ТАКАЯ ПОСТАНОВКА ВОПРОСА
Dialogue: 0,0:07:15.12,0:07:18.32,Caption,,0,0,0,,ЗВУЧИТ ПОЧТИ КАК НАРУШЕНИЕ ПРАВИЛ ПРИЛИЧИЯ. У
Dialogue: 0,0:07:18.32,0:07:20.96,Caption,,0,0,0,,ГОСУДАРСТВ УЖЕ ЕСТЬ МИНИСТЕРСТВА ИНОСТРАННЫХ ДЕЛ.
Dialogue: 0,0:07:21.10,0:07:24.96,Caption,,0,0,0,,ЗНАЧИТ, СВЕРХУ ТРЕБУЕТСЯ ЕЩЁ ОДНА СЛУЖБА. ЕСТЬ НАЦИОНАЛЬНЫЕ
Dialogue: 0,0:07:24.96,0:07:28.00,Caption,,0,0,0,,МИНИСТРЫ. ТОГДА НУЖЕН ВЕРХОВНЫЙ ПРЕДСТАВИТЕЛЬ.
Dialogue: 0,0:07:30.18,0:07:33.14,Caption,,0,0,0,,К ВЕРХОВНОМУ ПРЕДСТАВИТЕЛЮ ПОЛАГАЮТСЯ КАБИНЕТЫ,
Dialogue: 0,0:07:33.22,0:07:36.34,Caption,,0,0,0,,СОВЕТНИКИ, ПОМОЩНИКИ, ДЕПАРТАМЕНТЫ,
Dialogue: 0,0:07:36.50,0:07:39.94,Caption,,0,0,0,,ДЕЛЕГАЦИИ И НЕСКОЛЬКО УПРАВЛЕНИЙ. ГДЕ ТО МЕЖДУ НИМИ
Dialogue: 0,0:07:39.94,0:07:44.66,Caption,,0,0,0,,ОБЯЗАТЕЛЬНО СИДИТ СПЕЦИАЛИСТ, КОТОРЫЙ СОГЛАСОВЫВАЕТ ВРЕМЯ СЛЕДУЮЩЕГО СОГЛАСОВАНИЯ.
Dialogue: 0,0:07:45.37,0:07:47.94,Caption,,0,0,0,,ЛЕ ПЕН ПРЕДЛАГАЕТ ВЕРНУТЬ ВНЕШНЮЮ ПОЛИТИКУ
Dialogue: 0,0:07:48.10,0:07:51.22,Caption,,0,0,0,,НАЦИОНАЛЬНЫМ СТОЛИЦАМ. И СРАЗУ ВОЗНИКАЕТ ВОПРОС,
Dialogue: 0,0:07:51.46,0:07:53.94,Caption,,0,0,0,,СПОСОБНЫЙ ИСПОРТИТЬ НАСТРОЕНИЕ ЦЕЛОМУ
Dialogue: 0,0:07:53.94,0:07:56.74,Caption,,0,0,0,,АДМИНИСТРАТИВНОМУ КВАРТАЛУ. ЕСЛИ РЕШЕНИЯ СНОВА
Dialogue: 0,0:07:56.74,0:07:59.70,Caption,,0,0,0,,ПРИНИМАЮТ ГОСУДАРСТВА, ЗА ЧТО ОТВЕЧАЕТ НАДСТРОЙКА?
Dialogue: 0,0:08:00.14,0:08:02.74,Caption,,0,0,0,,ЗДАНИЯ НИКУДА НЕ ДЕЛИСЬ. СОТРУДНИКИ НА МЕСТЕ.
Dialogue: 0,0:08:02.98,0:08:05.86,Caption,,0,0,0,,ЗАРПЛАТЫ НАЧИСЛЯЮТСЯ. КОМАНДИРОВКИ СОГЛАСОВАНЫ.
Dialogue: 0,0:08:06.06,0:08:08.98,Caption,,0,0,0,,ПЕРЕВОДЧИКИ ГОТОВЫ. ПРЕСС СЛУЖБА ЖДЁТ ПОВОД ДЛЯ
Dialogue: 0,0:08:08.98,0:08:11.86,Caption,,0,0,0,,СООБЩЕНИЯ. КОФЕ В АВТОМАТЕ НАВЕРНЯКА ТОЖЕ
Dialogue: 0,0:08:11.86,0:08:14.66,Caption,,0,0,0,,ОПЛАЧИВАЕТСЯ ИСПРАВНО. ИСЧЕЗАЕТ ТОЛЬКО ГЛАВНАЯ
Dialogue: 0,0:08:14.74,0:08:19.06,Caption,,0,0,0,,ФУНКЦИЯ. ВПРОЧЕМ, ВЫХОД ВСЕГДА НАЙДЁТСЯ. МОЖНО УЧРЕДИТЬ КОМИССИЮ ПО
Dialogue: 0,0:08:19.06,0:08:22.02,Caption,,0,0,0,,ИЗУЧЕНИЮ ПОСЛЕДСТВИЙ СОКРАЩЕНИЯ КОМИССИЙ. ЗАТЕМ
Dialogue: 0,0:08:22.02,0:08:25.94,Caption,,0,0,0,,ПРОВЕСТИ ФОРУМ, ПОДГОТОВИТЬ ДОКЛАД НА НЕСКОЛЬКО СОТЕН СТРАНИЦ И
Dialogue: 0,0:08:25.94,0:08:29.22,Caption,,0,0,0,,НАЗВАТЬ ЕГО "БУДУЩЕЕ ОБЩЕЕВРОПЕЙСКОЙ ВНЕШНЕЙ
Dialogue: 0,0:08:29.22,0:08:32.02,Caption,,0,0,0,,ПОЛИТИКИ ПОСЛЕ ВОЗВРАЩЕНИЯ ВНЕШНЕЙ ПОЛИТИКИ
Dialogue: 0,0:08:32.02,0:08:34.82,Caption,,0,0,0,,ГОСУДАРСТВАМ". БРЮССЕЛЬ ЕЩЁ И ПРЕЗЕНТАЦИЮ К НЕМУ
Dialogue: 0,0:08:34.82,0:08:37.62,Caption,,0,0,0,,СДЕЛАЕТ. ОДНАКО ВОПРОС ОСТАНЕТСЯ. ПОДОБНЫЕ
Dialogue: 0,0:08:37.62,0:08:39.70,Caption,,0,0,0,,ПРЕДЛОЖЕНИЯ ЗВУЧАТ НЕ ТОЛЬКО ВО ФРАНЦИИ.
Dialogue: 0,0:08:39.90,0:08:42.98,Caption,,0,0,0,,ПОЛИТИЧЕСКИЕ СИЛЫ ГЕРМАНИИ И ПОЛЬШИ ТАКЖЕ ВЫСТУПАЮТ
Dialogue: 0,0:08:43.06,0:08:45.94,Caption,,0,0,0,,ЗА ПЕРЕДАЧУ ЧАСТИ ПОЛНОМОЧИЙ ОБРАТНО НАЦИОНАЛЬНЫМ
Dialogue: 0,0:08:45.94,0:08:51.90,Caption,,0,0,0,,ПРАВИТЕЛЬСТВАМ. ВОТ ЭТО УЖЕ ЗАТРАГИВАЕТ УСТРОЙСТВО ВСЕГО ЕВРОСОЮЗА.
Dialogue: 0,0:08:52.52,0:08:55.50,Caption,,0,0,0,,ОН СУЩЕСТВУЕТ НЕ БЛАГОДАРЯ ЗВЁЗДАМ НА СИНЕМ ПОЛОТНЕ
Dialogue: 0,0:08:55.81,0:08:58.46,Caption,,0,0,0,,И НЕ БЛАГОДАРЯ УЗНАВАЕМЫМ ФАСАДАМ ЕВРОПЕЙСКИХ
Dialogue: 0,0:08:58.46,0:09:01.90,Caption,,0,0,0,,УЧРЕЖДЕНИЙ. ЕГО ОСНОВА В СОГЛАСИИ ГОСУДАРСТВ
Dialogue: 0,0:09:01.98,0:09:05.02,Caption,,0,0,0,,ОТДАВАТЬ ЧАСТЬ СОБСТВЕННЫХ ПРАВ ОБЩИМ ОРГАНАМ.
Dialogue: 0,0:09:05.66,0:09:07.90,Caption,,0,0,0,,НАВЕРХ ПЕРЕДАВАЛИСЬ РЕШЕНИЯ О ДЕНЬГАХ,
Dialogue: 0,0:09:07.99,0:09:12.86,Caption,,0,0,0,,ТОРГОВЛЕ, ПРАВИЛАХ, РЕГУЛИРОВАНИИ И ВНЕШНЕЙ ПОЛИТИКЕ. КАЖДАЯ ТАКАЯ
Dialogue: 0,0:09:12.94,0:09:16.46,Caption,,0,0,0,,ПЕРЕДАЧА ОЗНАЧАЛА, ЧТО ОТДЕЛЬНЫЙ ВОПРОС ТЕПЕРЬ БУДЕТ РЕШАТЬСЯ
Dialogue: 0,0:09:16.46,0:09:19.74,Caption,,0,0,0,,СОВМЕСТНО. ПРЕДЛОЖЕНИЕ ЛЕ ПЕН ЗАПУСКАЕТ ОБРАТНОЕ
Dialogue: 0,0:09:19.74,0:09:23.10,Caption,,0,0,0,,ДВИЖЕНИЕ. СНАЧАЛА СТОЛИЦЫ ЗАБИРАЮТ ВНЕШНЮЮ ПОЛИТИКУ.
Dialogue: 0,0:09:23.50,0:09:27.90,Caption,,0,0,0,,ЗАТЕМ КТО ТО ЗАМЕЧАЕТ, ЧТО МОЖНО ВЕРНУТЬ ЕЩЁ ОДНО ПОЛНОМОЧИЕ. ПОСЛЕ НЕГО
Dialogue: 0,0:09:27.90,0:09:31.82,Caption,,0,0,0,,НАЙДЁТСЯ ВТОРОЕ, ПОТОМ ТРЕТЬЕ. БОЛЬШАЯ КОНСТРУКЦИЯ РЕДКО
Dialogue: 0,0:09:31.82,0:09:35.26,Caption,,0,0,0,,РАЗВАЛИВАЕТСЯ ОТ ОДНОГО ГРОМКОГО УДАРА. НАМНОГО ЧАЩЕ
Dialogue: 0,0:09:35.26,0:09:37.18,Caption,,0,0,0,,ИЗ НЕЁ СПОКОЙНО ВЫНИМАЮТ ДЕТАЛИ,
Dialogue: 0,0:09:37.42,0:09:39.90,Caption,,0,0,0,,ПОКА ОДНАЖДЫ ДВЕРЬ ОТКРЫВАЕТСЯ ВМЕСТЕ СО СТЕНОЙ.
Dialogue: 0,0:09:40.20,0:09:42.86,Caption,,0,0,0,,ТОГДА СПОР О КАЕ КАЛЛАС ПОТЕРЯЕТ ЗНАЧЕНИЕ.
Dialogue: 0,0:09:43.42,0:09:46.46,Caption,,0,0,0,,ГЛАВНЫМ СТАНЕТ ВОПРОС О ПРЕДНАЗНАЧЕНИИ ВСЕЙ СИСТЕМЫ.
Dialogue: 0,0:09:46.85,0:09:48.86,Caption,,0,0,0,,НУЖНА ЛИ ОНА ДЛЯ ВЫПУСКА РЕКОМЕНДАЦИЙ?
Dialogue: 0,0:09:49.15,0:09:53.42,Caption,,0,0,0,,ДЛЯ РАСПРЕДЕЛЕНИЯ ДОЛЖНОСТЕЙ? ДЛЯ ОБЪЯСНЕНИЯ ДВАДЦАТИ СЕМИ ПРАВИТЕЛЬСТВАМ,
Dialogue: 0,0:09:53.66,0:09:56.06,Caption,,0,0,0,,КАК ПРАВИЛЬНО САМОСТОЯТЕЛЬНО РЕШАТЬ ВОПРОСЫ,
Dialogue: 0,0:09:56.24,0:10:00.86,Caption,,0,0,0,,КОТОРЫЕ У НИХ ПРЕЖДЕ ЗАБРАЛИ? ИНИЦИАТИВА ЛЕ ПЕН ОПАСНА ДЛЯ БРЮССЕЛЯ ИМЕННО
Dialogue: 0,0:10:00.86,0:10:03.90,Caption,,0,0,0,,ПОЭТОМУ. ОНА НАПРАВЛЕНА НЕ ПРОТИВ ОДНОЙ ФАМИЛИИ,
Dialogue: 0,0:10:04.14,0:10:06.62,Caption,,0,0,0,,А ПРОТИВ ПРИНЦИПА ПЕРЕДАЧИ ВЛАСТИ НАВЕРХ.
Dialogue: 0,0:10:08.90,0:10:11.70,Caption,,0,0,0,,ЕСЛИ ГОСУДАРСТВА СПОСОБНЫ САМИ ЗАНИМАТЬСЯ ВНЕШНЕЙ
Dialogue: 0,0:10:11.70,0:10:15.94,Caption,,0,0,0,,ПОЛИТИКОЙ, ЗАЧЕМ ОНИ ОТДАЛИ ЭТУ РАБОТУ ОБЩЕЕВРОПЕЙСКОЙ СЛУЖБЕ?
Dialogue: 0,0:10:16.38,0:10:19.54,Caption,,0,0,0,,ЛЮБОЙ АППАРАТ ОХОТНО ОБСУЖДАЕТ НОВЫЕ ОБЯЗАННОСТИ,
Dialogue: 0,0:10:19.70,0:10:22.02,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЕ БЮДЖЕТЫ И РАСШИРЕНИЕ ШТАТА.
Dialogue: 0,0:10:22.58,0:10:25.06,Caption,,0,0,0,,РАЗГОВОР О ТОМ, ЧТО У НЕГО МОЖНО ЗАБРАТЬ,
Dialogue: 0,0:10:25.40,0:10:28.66,Caption,,0,0,0,,ОБЫЧНО ВЫЗЫВАЕТ ВНЕЗАПНУЮ ЛЮБОВЬ К СТАБИЛЬНОСТИ. ЛЕ
Dialogue: 0,0:10:28.66,0:10:31.70,Caption,,0,0,0,,ПЕН ПРЕДЛАГАЕТ НАЧАТЬ ИМЕННО С ИЗЪЯТИЯ ФУНКЦИЙ.
Dialogue: 0,0:10:32.02,0:10:35.38,Caption,,0,0,0,,РЯДОМ ВОЗНИКАЕТ УКРАИНСКИЙ ВОПРОС. КИЕВ ТРЕБУЕТ
Dialogue: 0,0:10:35.38,0:10:37.94,Caption,,0,0,0,,МИРНОЙ КОНФЕРЕНЦИИ И ОДНОВРЕМЕННО ГОВОРИТ,
Dialogue: 0,0:10:38.10,0:10:40.58,Caption,,0,0,0,,ЧТО У ЕВРОПЫ БОЛЬШЕ НЕТ ДЕНЕГ ДЛЯ ДАЛЬНЕЙШЕЙ
Dialogue: 0,0:10:40.58,0:10:43.46,Caption,,0,0,0,,ПОДДЕРЖКИ УКРАИНЫ. В ОДНОЙ ТОЧКЕ СХОДЯТСЯ ДВА
Dialogue: 0,0:10:43.46,0:10:46.82,Caption,,0,0,0,,РАСЧЁТА. КТО ПРИНИМАЕТ РЕШЕНИЕ И КТО ЕГО ОПЛАЧИВАЕТ?
Dialogue: 0,0:10:47.26,0:10:49.86,Caption,,0,0,0,,КТО ПОСЛЕ ЭТОГО ИДЁТ К ИЗБИРАТЕЛЯМ И ОБЪЯСНЯЕТ,
Dialogue: 0,0:10:50.02,0:10:52.90,Caption,,0,0,0,,ПОЧЕМУ СРЕДСТВА СНОВА ТРЕБУЮТСЯ ИМЕННО ОТ НИХ?
Dialogue: 0,0:10:53.35,0:10:57.70,Caption,,0,0,0,,ПОКА РАСХОДЫ НЕВЕЛИКИ, ВСЁ ВЫГЛЯДИТ ТОРЖЕСТВЕННО. РЕШЕНИЕ ОБЩЕЕ,
Dialogue: 0,0:10:57.86,0:11:01.62,Caption,,0,0,0,,ЦЕННОСТИ ОБЩИЕ, ОТВЕТСТВЕННОСТЬ ОБЩАЯ. КОГДА ПРИНОСЯТ СЧЁТ,
Dialogue: 0,0:11:01.92,0:11:04.58,Caption,,0,0,0,,ОБЩНОСТЬ КУДА ТО ИСПАРЯЕТСЯ. НАЛОГИ СОБИРАЮТ
Dialogue: 0,0:11:04.58,0:11:07.54,Caption,,0,0,0,,ГОСУДАРСТВА. РАБОЧИЕ МЕСТА СУЩЕСТВУЮТ В КОНКРЕТНЫХ
Dialogue: 0,0:11:07.54,0:11:10.42,Caption,,0,0,0,,СТРАНАХ. ПРЕДПРИЯТИЯ ЗАКРЫВАЮТСЯ НЕ В АБСТРАКТНОЙ
Dialogue: 0,0:11:10.42,0:11:13.94,Caption,,0,0,0,,ЕВРОПЕ, А В РЕАЛЬНОМ НЕМЕЦКОМ ГОРОДЕ. ГОЛОСОВАНИЕ ТОЖЕ
Dialogue: 0,0:11:13.94,0:11:16.66,Caption,,0,0,0,,ПРОХОДИТ НЕ В БРЮССЕЛЬСКОМ КОРИДОРЕ. НА ЭТОМ МЕСТЕ
Dialogue: 0,0:11:16.74,0:11:18.90,Caption,,0,0,0,,МЕХАНИЗМ НАЧИНАЕТ СКРИПЕТЬ УЖЕ БЕЗ ПОМОЩИ
Dialogue: 0,0:11:18.90,0:11:24.53,Caption,,0,0,0,,ПЕРЕВОДЧИКА. РАБОЧЕМУ В ГЕРМАНИИ ТРУДНО ВОСХИЩАТЬСЯ МАСШТАБОМ
Dialogue: 0,0:11:24.53,0:11:27.65,Caption,,0,0,0,,ЕВРОПЕЙСКИХ ЗАДАЧ, КОГДА MERCEDES ОЦЕНИВАЕТ,
Dialogue: 0,0:11:27.81,0:11:30.77,Caption,,0,0,0,,КАКИЕ ПРЕДПРИЯТИЯ В ГЕРМАНИИ СТАЛИ СЛИШКОМ ДОРОГИМИ.
Dialogue: 0,0:11:31.54,0:11:34.45,Caption,,0,0,0,,ФРАНЦУЗСКОМУ НАЛОГОПЛАТЕЛЬЩИКУ НЕЛЕГКО ОБЪЯСНИТЬ
Dialogue: 0,0:11:34.45,0:11:36.45,Caption,,0,0,0,,ПОЛЬЗУ БОЛЬШОГО ЕВРОПЕЙСКОГО АППАРАТА,
Dialogue: 0,0:11:36.85,0:11:39.41,Caption,,0,0,0,,ЕСЛИ ФРАНЦУЗСКИЕ ПОЛИТИКИ ПРЯМО СПРАШИВАЮТ,
Dialogue: 0,0:11:39.57,0:11:43.73,Caption,,0,0,0,,ЗАЧЕМ ОПЛАЧИВАТЬ СЛУЖБУ, КОТОРАЯ ПОВТОРЯЕТ РАБОТУ ФРАНЦУЗСКОЙ ДИПЛОМАТИИ.
Dialogue: 0,0:11:44.12,0:11:47.97,Caption,,0,0,0,,ИЗБИРАТЕЛЮ В ПОЛЬШЕ, ГЕРМАНИИ ИЛИ ФРАНЦИИ В КОНЦЕ КОНЦОВ СТАНОВИТСЯ
Dialogue: 0,0:11:47.97,0:11:51.81,Caption,,0,0,0,,БЕЗРАЗЛИЧНО, НАСКОЛЬКО ВЕЛИЧЕСТВЕННО НАЗВАЛИ ОЧЕРЕДНУЮ ПРОГРАММУ.
Dialogue: 0,0:11:52.22,0:11:54.69,Caption,,0,0,0,,ОН ХОЧЕТ ЗНАТЬ ЕЁ ЦЕНУ И ПОЛУЧИТЬ ОТВЕТ
Dialogue: 0,0:11:54.77,0:11:57.81,Caption,,0,0,0,,БЕЗ ЧЕТЫРЁХ ПРИЛОЖЕНИЙ МЕЛКИМ ШРИФТОМ. НАПИШИТЕ В
Dialogue: 0,0:11:57.81,0:12:01.81,Caption,,0,0,0,,КОММЕНТАРИЯХ, ЧТО ДЛЯ ЕВРОПЫ ОПАСНЕЕ ДОРОГАЯ ПРОМЫШЛЕННОСТЬ ИЛИ
Dialogue: 0,0:12:01.81,0:12:04.93,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ ПОЛНОМОЧИЙ НАЦИОНАЛЬНЫМ СТОЛИЦАМ. И
Dialogue: 0,0:12:05.01,0:12:07.89,Caption,,0,0,0,,ЗДЕСЬ ЗАМЫКАЕТСЯ ВСЯ ИСТОРИЯ. ЕВРОПА СОБИРАЛАСЬ
Dialogue: 0,0:12:07.89,0:12:11.25,Caption,,0,0,0,,ДОКАЗАТЬ, ЧТО РОССИЯ БЕЗ НЕЁ НЕ СПРАВИТСЯ. РОССИЯ
Dialogue: 0,0:12:11.25,0:12:13.73,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО СТОЛКНУЛАСЬ С ОГРОМНЫМИ ТРУДНОСТЯМИ.
Dialogue: 0,0:12:13.98,0:12:16.53,Caption,,0,0,0,,ЕЙ ПРИШЛОСЬ ПЕРЕСТРАИВАТЬ РАСЧЁТЫ И ЛОГИСТИКУ,
Dialogue: 0,0:12:16.77,0:12:19.57,Caption,,0,0,0,,ИСКАТЬ ДРУГИЕ РЫНКИ И СОЗДАВАТЬ НОВЫЕ ТОРГОВЫЕ
Dialogue: 0,0:12:19.57,0:12:22.53,Caption,,0,0,0,,СВЯЗИ. СПУСТЯ НЕСКОЛЬКО ЛЕТ ПУТИН ПРИЕЗЖАЕТ НА
Dialogue: 0,0:12:22.53,0:12:25.89,Caption,,0,0,0,,ПЛОЩАДКУ АТЭС В КИТАЕ И ГОВОРИТ АЗИАТСКИМ ПАРТНЁРАМ,
Dialogue: 0,0:12:26.05,0:12:29.17,Caption,,0,0,0,,ЧТО СТРАНА ВЫДЕРЖАЛА ДАВЛЕНИЕ. В ЭТО ЖЕ ВРЕМЯ
Dialogue: 0,0:12:29.33,0:12:32.05,Caption,,0,0,0,,MERCEDES ПОДСЧИТЫВАЕТ СТОИМОСТЬ РАБОТЫ В ГЕРМАНИИ.
Dialogue: 0,0:12:32.35,0:12:34.93,Caption,,0,0,0,,НАЦИОНАЛЬНЫЕ ПОЛИТИКИ ПЕРЕСМАТРИВАЮТ ПОЛНОМОЧИЯ
Dialogue: 0,0:12:34.93,0:12:39.46,Caption,,0,0,0,,БРЮССЕЛЯ. НАЛОГОПЛАТЕЛЬЩИКИ ВЫЯСНЯЮТ,
Dialogue: 0,0:12:39.54,0:12:43.78,Caption,,0,0,0,,СКОЛЬКО ИМ ОБОШЛИСЬ РЕШЕНИЯ, КОТОРЫЕ ПОДАВАЛИСЬ КАК ВЫГОДНЫЕ И ПОЧТИ
Dialogue: 0,0:12:43.78,0:12:46.42,Caption,,0,0,0,,БЕЗБОЛЕЗНЕННЫЕ. МОСКВА ДОЛЖНА БЫЛА ПОЛУЧИТЬ
Dialogue: 0,0:12:46.42,0:12:49.06,Caption,,0,0,0,,ОКОНЧАТЕЛЬНЫЙ СЧЁТ. ТЕПЕРЬ СУММЫ ОБСУЖДАЮТ В
Dialogue: 0,0:12:49.06,0:12:53.38,Caption,,0,0,0,,БЕРЛИНЕ, ПАРИЖЕ И БРЮССЕЛЕ. НО ТРУДНОСТИ MERCEDES ЕЩЁ МОЖНО
Dialogue: 0,0:12:53.38,0:12:56.26,Caption,,0,0,0,,СЧИТАТЬ РЕШАЕМОЙ ЗАДАЧЕЙ. ИНВЕСТИЦИОННЫЙ ПЛАН
Dialogue: 0,0:12:56.34,0:12:59.22,Caption,,0,0,0,,МЕНЯЮТ. ПРОИЗВОДСТВЕННЫЕ РАСХОДЫ СОКРАЩАЮТ.
Dialogue: 0,0:12:59.54,0:13:04.42,Caption,,0,0,0,,ПРЕДПРИЯТИЯ ПЕРЕСТРАИВАЮТ, ЕСЛИ ХВАТАЕТ ДЕНЕГ И ВРЕМЕНИ. НАМНОГО СЕРЬЁЗНЕЕ
Dialogue: 0,0:13:04.42,0:13:07.86,Caption,,0,0,0,,МОМЕНТ, КОГДА ЭКОНОМИЧЕСКАЯ СЛАБОСТЬ СТАНОВИТСЯ ПРИЧИНОЙ
Dialogue: 0,0:13:07.86,0:13:10.66,Caption,,0,0,0,,ПЕРЕСМОТРА ВЛАСТИ. ТОГДА СПОР ИДЁТ УЖЕ НЕ О
Dialogue: 0,0:13:10.66,0:13:14.42,Caption,,0,0,0,,ТОМ, УДАЧНЫМ ЛИ ОКАЗАЛСЯ ОТДЕЛЬНЫЙ КУРС. ЛЮДИ НАЧИНАЮТ
Dialogue: 0,0:13:14.42,0:13:18.50,Caption,,0,0,0,,СПРАШИВАТЬ, КТО ПОЛУЧИЛ ПРАВО ПРИНИМАТЬ ТАКИЕ РЕШЕНИЯ И ПОЧЕМУ
Dialogue: 0,0:13:18.50,0:13:20.34,Caption,,0,0,0,,РАСПЛАЧИВАТЬСЯ ЗА НИХ ДОЛЖНЫ ТЕ,
Dialogue: 0,0:13:20.49,0:13:23.38,Caption,,0,0,0,,КОГО НЕ СПРОСИЛИ. ЕСЛИ НАЦИОНАЛЬНЫЕ СТОЛИЦЫ
Dialogue: 0,0:13:23.38,0:13:28.26,Caption,,0,0,0,,ПОТРЕБУЮТ ВЕРНУТЬ ЭТО ПРАВО, БРЮССЕЛЮ ПРИДЁТСЯ ОБЪЯСНЯТЬ НЕ ДЕЙСТВИЯ РОССИИ,
Dialogue: 0,0:13:28.55,0:13:31.62,Caption,,0,0,0,,НЕ ЗАЯВЛЕНИЯ ПУТИНА И НЕ СОДЕРЖАНИЕ ОЧЕРЕДНОГО
Dialogue: 0,0:13:31.62,0:13:34.42,Caption,,0,0,0,,ПАКЕТА ОГРАНИЧЕНИЙ. ЕМУ ПРИДЁТСЯ ДОКАЗЫВАТЬ
Dialogue: 0,0:13:34.42,0:13:37.70,Caption,,0,0,0,,СОБСТВЕННУЮ НЕОБХОДИМОСТЬ. ПОЧЕМУ ЭТИ ВОПРОСЫ НЕЛЬЗЯ
Dialogue: 0,0:13:37.70,0:13:40.42,Caption,,0,0,0,,РЕШАТЬ В ПАРИЖЕ, БЕРЛИНЕ ИЛИ ВАРШАВЕ?
Dialogue: 0,0:13:40.89,0:13:44.02,Caption,,0,0,0,,КАКИЕ ФУНКЦИИ ДОЛЖНЫ ОСТАВАТЬСЯ У ОБЩЕЕВРОПЕЙСКИХ
Dialogue: 0,0:13:44.02,0:13:47.78,Caption,,0,0,0,,ОРГАНОВ? ПОЧЕМУ ГОСУДАРСТВА ОБЯЗАНЫ ФИНАНСИРОВАТЬ ОГРОМНЫЙ
Dialogue: 0,0:13:47.78,0:13:50.74,Caption,,0,0,0,,АППАРАТ, ЕСЛИ ЕГО РАБОТУ МОЖНО ВЕРНУТЬ НАЦИОНАЛЬНЫМ
Dialogue: 0,0:13:50.74,0:13:56.06,Caption,,0,0,0,,ПРАВИТЕЛЬСТВАМ? ДЛЯ ЕВРОПЕЙСКОЙ БЮРОКРАТИИ ЭТО И ЕСТЬ САМАЯ
Dialogue: 0,0:13:56.06,0:13:59.58,Caption,,0,0,0,,НЕПРИЯТНАЯ ЧАСТЬ ИСТОРИИ. ОГРАНИЧЕНИЯ ЗАПУСКАЛИ КАК
Dialogue: 0,0:13:59.58,0:14:02.78,Caption,,0,0,0,,МЕХАНИЗМ ДАВЛЕНИЯ НА РОССИЮ. НО МЕХАНИЗМ СДЕЛАЛ
Dialogue: 0,0:14:02.78,0:14:05.26,Caption,,0,0,0,,КРУГ, ЗАЦЕПИЛ НЕМЕЦКУЮ ПРОМЫШЛЕННОСТЬ,
Dialogue: 0,0:14:05.50,0:14:08.38,Caption,,0,0,0,,ФРАНЦУЗСКУЮ ПОЛИТИКУ И БРЮССЕЛЬСКИЕ ПОЛНОМОЧИЯ.
Dialogue: 0,0:14:08.85,0:14:11.42,Caption,,0,0,0,,ТЕПЕРЬ ЕГО СОЗДАТЕЛЯМ ОСТАЁТСЯ УВЕРЯТЬ ПУБЛИКУ,
Dialogue: 0,0:14:11.66,0:14:14.86,Caption,,0,0,0,,ЧТО ИМЕННО ТАКОГО РЕЗУЛЬТАТА ОНИ И ДОБИВАЛИСЬ. ЖАЛЬ
Dialogue: 0,0:14:14.94,0:14:17.42,Caption,,0,0,0,,ТОЛЬКО, ЧТО MERCEDES УЖЕ ДОСТАЛ КАЛЬКУЛЯТОР.
