Dialogue: 0,0:00:00.12,0:00:03.56,Caption,,0,0,0,,ВЫБОРЫ ПРОВЕСТИ МОЖНО. НО НЕЛЬЗЯ. ТЕХНИЧЕСКИ ГОТОВЫ.
Dialogue: 0,0:00:03.72,0:00:07.00,Caption,,0,0,0,,ПРАКТИЧЕСКИ НЕ ПОЛУЧАЕТСЯ. ШАНС БЫЛ. А УЖЕ ВСЁ!
Dialogue: 0,0:00:07.07,0:00:11.16,Caption,,0,0,0,,НАДО БЫЛО РАНЬШЕ! СЛУШАЙТЕ, ЭТО ВООБЩЕ РАЗГОВОР О ПРЕЗИДЕНТСКИХ ВЫБОРАХ ИЛИ
Dialogue: 0,0:00:11.24,0:00:15.80,Caption,,0,0,0,,НОВАЯ СЕРИЯ СТАРОЙ КОМЕДИИ? ПРИЧЁМ КАЖДЫЙ СЛЕДУЮЩИЙ ОТВЕТ ВЫЗЫВАЕТ ЕЩЁ БОЛЬШЕ
Dialogue: 0,0:00:15.80,0:00:18.84,Caption,,0,0,0,,ВОПРОСОВ, ЧЕМ ПРЕДЫДУЩИЙ. И САМОЕ ЗАНЯТНОЕ,
Dialogue: 0,0:00:19.08,0:00:20.84,Caption,,0,0,0,,ЧТО ОДНОВРЕМЕННО ПОЯВЛЯЮТСЯ ЛЮДИ,
Dialogue: 0,0:00:21.08,0:00:23.40,Caption,,0,0,0,,КОТОРЫЕ СМОТРЯТ НА ВСЮ ЭТУ ИСТОРИЮ СОВСЕМ С
Dialogue: 0,0:00:23.40,0:00:25.64,Caption,,0,0,0,,ДРУГОЙ СТОРОНЫ. ТАК ЧТО ДАВАЙТЕ ПОСМОТРИМ,
Dialogue: 0,0:00:25.88,0:00:28.44,Caption,,0,0,0,,КТО КОМУ ТЕПЕРЬ ЧТО ПРЕДЛАГАЕТ И ПОЧЕМУ СТОЛЬКО
Dialogue: 0,0:00:28.44,0:00:32.44,Caption,,0,0,0,,РАЗГОВОРОВ, А ЯСНОСТИ ВСЁ МЕНЬШЕ. ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ЗДЕСЬ
Dialogue: 0,0:00:32.52,0:00:36.12,Caption,,0,0,0,,КАК РАЗ ТОТ СЛУЧАЙ, КОГДА ПОЛЕЗНО ПОСТАВИТЬ РЯДОМ НЕСКОЛЬКО ЗАЯВЛЕНИЙ
Dialogue: 0,0:00:36.12,0:00:38.60,Caption,,0,0,0,,ОДНОГО И ТОГО ЖЕ ЧЕЛОВЕКА. ИНОГДА ПОСЛЕ ЭТОГО
Dialogue: 0,0:00:38.68,0:00:43.48,Caption,,0,0,0,,НИЧЕГО ОБЪЯСНЯТЬ УЖЕ НЕ НАДО. ЗЕЛЕНСКИЙ ДАЛ ИНТЕРВЬЮ НЕМЕЦКОМУ ТЕЛЕВИДЕНИЮ И ОЧЕНЬ
Dialogue: 0,0:00:43.48,0:00:46.12,Caption,,0,0,0,,ТЕПЛО ЗАГОВОРИЛ О ДЕМОКРАТАХ В СОЕДИНЁННЫХ ШТАТАХ.
Dialogue: 0,0:00:46.51,0:00:48.20,Caption,,0,0,0,,РЕСПУБЛИКАНЦАМ ОН ТОЖЕ БЛАГОДАРЕН,
Dialogue: 0,0:00:48.28,0:00:50.76,Caption,,0,0,0,,КОНЕЧНО. НО ДЕМОКРАТЫ, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:00:51.00,0:00:53.56,Caption,,0,0,0,,ГОРАЗДО ЧЁТЧЕ ГОВОРЯТ О ПОДДЕРЖКЕ УКРАИНЫ,
Dialogue: 0,0:00:53.79,0:00:57.96,Caption,,0,0,0,,О ФИНАНСОВОЙ ПОМОЩИ, ОБ ОРУЖИИ И О БОЛЕЕ ТЕСНОЙ РАБОТЕ ВАШИНГТОНА
Dialogue: 0,0:00:58.04,0:01:00.92,Caption,,0,0,0,,С ЕВРОПОЙ. ТО ЕСТЬ НАПРАВЛЕНИЕ ПОНЯТНО. ПОСЛЕ
Dialogue: 0,0:01:00.92,0:01:03.56,Caption,,0,0,0,,АМЕРИКАНСКИХ ПРОМЕЖУТОЧНЫХ ВЫБОРОВ КИЕВ УЖЕ СМОТРИТ
Dialogue: 0,0:01:03.64,0:01:05.72,Caption,,0,0,0,,НА НОВЫЙ РАСКЛАД В КОНГРЕССЕ И РАССЧИТЫВАЕТ,
Dialogue: 0,0:01:05.96,0:01:08.36,Caption,,0,0,0,,ЧТО ОТТУДА ПОЙДЁТ БОЛЬШЕ ДЕНЕГ И ВООРУЖЕНИЙ.
Dialogue: 0,0:01:10.65,0:01:14.81,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПРЯМО ГОВОРИТ, ЧТО СЕРЬЁЗНАЯ АМЕРИКАНСКАЯ ФИНАНСОВАЯ И ВОЕННАЯ
Dialogue: 0,0:01:14.81,0:01:17.21,Caption,,0,0,0,,ПОМОЩЬ ВМЕСТЕ С ЕВРОПЕЙСКОЙ ДОЛЖНА ПОВЛИЯТЬ НА
Dialogue: 0,0:01:17.21,0:01:20.25,Caption,,0,0,0,,ПУТИНА. ВСЁ ХОРОШО. ТОЛЬКО ПРЕЗИДЕНТОМ США ПО
Dialogue: 0,0:01:20.25,0:01:22.97,Caption,,0,0,0,,ПРЕЖНЕМУ ОСТАЁТСЯ ДОНАЛЬД ТРАМП. И ПОЛУЧАЕТСЯ
Dialogue: 0,0:01:22.97,0:01:25.93,Caption,,0,0,0,,ДОВОЛЬНО ИНТЕРЕСНАЯ КОНСТРУКЦИЯ. С БЕЛЫМ ДОМОМ НАДО
Dialogue: 0,0:01:25.93,0:01:28.73,Caption,,0,0,0,,ДОГОВАРИВАТЬСЯ СЕГОДНЯ. А НАДЕЖДЫ НА ЗАВТРА УЖЕ
Dialogue: 0,0:01:28.73,0:01:31.45,Caption,,0,0,0,,СВЯЗЫВАЮТСЯ С ПОЛИТИЧЕСКИМИ ПРОТИВНИКАМИ ХОЗЯИНА
Dialogue: 0,0:01:31.53,0:01:34.49,Caption,,0,0,0,,ЭТОГО САМОГО БЕЛОГО ДОМА. ПРИЧЁМ ЗЕЛЕНСКИЙ В ТОМ
Dialogue: 0,0:01:34.57,0:01:36.97,Caption,,0,0,0,,ЖЕ ИНТЕРВЬЮ УСПЕЛ ПРОЙТИСЬ И ПО ИЛОНУ МАСКУ.
Dialogue: 0,0:01:37.13,0:01:41.93,Caption,,0,0,0,,SPACEX, ГОВОРИТ, СПАСИБО. СВЯЗЬ В НАЧАЛЕ КОНФЛИКТА ОЧЕНЬ ПОМОГЛА. НО
Dialogue: 0,0:01:42.01,0:01:44.97,Caption,,0,0,0,,ПОЗИЦИЯ САМОГО МАСКА КИЕВУ НЕ НРАВИТСЯ. А ДЕМОКРАТЫ
Dialogue: 0,0:01:45.05,0:01:47.13,Caption,,0,0,0,,ТЕМ ВРЕМЕНЕМ УЖЕ ИНТЕРЕСУЮТСЯ ОГРАНИЧЕНИЯМИ
Dialogue: 0,0:01:47.13,0:01:49.37,Caption,,0,0,0,,STARSHIELD И ТРЕБУЮТ СОХРАНЯТЬ ДОКУМЕНТЫ ДЛЯ
Dialogue: 0,0:01:49.37,0:01:52.25,Caption,,0,0,0,,ДАЛЬНЕЙШЕГО РАЗБИРАТЕЛЬСТВА. ТО ЕСТЬ МАСК ВНЕЗАПНО
Dialogue: 0,0:01:52.25,0:01:55.45,Caption,,0,0,0,,ОКАЗЫВАЕТСЯ СРАЗУ В НЕСКОЛЬКИХ РОЛЯХ. ЕГО КОМПАНИЯ
Dialogue: 0,0:01:55.45,0:01:58.73,Caption,,0,0,0,,ДАЛА УКРАИНЕ СВЯЗЬ. ЕГО ВОЕННАЯ СПУТНИКОВАЯ СИСТЕМА
Dialogue: 0,0:01:58.73,0:02:01.29,Caption,,0,0,0,,НУЖНА УКРАИНСКИМ ВОЙСКАМ. ДЕМОКРАТЫ ХОТЯТ
Dialogue: 0,0:02:01.29,0:02:05.21,Caption,,0,0,0,,РАЗБИРАТЬСЯ, ПОЧЕМУ ЭТА СИСТЕМА РАБОТАЛА С ОГРАНИЧЕНИЯМИ. А САМ
Dialogue: 0,0:02:05.21,0:02:09.77,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ОБЪЯСНЯЕТ МАСКУ, ГДЕ ЗАКАНЧИВАЕТСЯ ЕГО ПРАВО ВЛИЯТЬ НА ПОЛИТИКУ.
Dialogue: 0,0:02:10.01,0:02:12.89,Caption,,0,0,0,,ХОРОШАЯ КОМПАНИЯ СОБРАЛАСЬ. НО ЗЕЛЕНСКИЙ НА ЭТОМ НЕ
Dialogue: 0,0:02:12.89,0:02:15.53,Caption,,0,0,0,,ОСТАНОВИЛСЯ. ОН ЕЩЁ И РАССКАЗАЛ АМЕРИКАНЦАМ,
Dialogue: 0,0:02:15.61,0:02:17.45,Caption,,0,0,0,,КОГДА У НИХ БЫЛ ШАНС ЕГО ЗАМЕНИТЬ.
Dialogue: 0,0:02:19.64,0:02:23.32,Caption,,0,0,0,,ПО ЕГО СЛОВАМ, ОН ПРЕДЛАГАЛ ДОГОВОРИТЬСЯ С РОССИЕЙ О ПРЕКРАЩЕНИИ
Dialogue: 0,0:02:23.32,0:02:25.88,Caption,,0,0,0,,ОГНЯ НА ЗИМНИЙ ПЕРИОД. ТОГДА У ЛЮДЕЙ БУДУТ
Dialogue: 0,0:02:25.88,0:02:28.68,Caption,,0,0,0,,ВОДА И ЭЛЕКТРИЧЕСТВО. А ЗАОДНО МОЖНО БУДЕТ ПРОВЕСТИ
Dialogue: 0,0:02:28.68,0:02:31.32,Caption,,0,0,0,,ПРЕЗИДЕНТСКИЕ ВЫБОРЫ. И ДАЛЬШЕ ВЫДАЁТ ЕСЛИ В
Dialogue: 0,0:02:31.32,0:02:33.32,Caption,,0,0,0,,СОЕДИНЁННЫХ ШТАТАХ ХОТЯТ ЕГО ЗАМЕНИТЬ,
Dialogue: 0,0:02:33.40,0:02:36.60,Caption,,0,0,0,,ШАНС БЫЛ. А УЖЕ ВСЁ! НАДО БЫЛО РАНЬШЕ!
Dialogue: 0,0:02:36.84,0:02:39.72,Caption,,0,0,0,,ЭТО ДАЖЕ ПРИДУМЫВАТЬ НЕ НАДО. ГОТОВЫЙ МЕМ САМ
Dialogue: 0,0:02:39.80,0:02:42.12,Caption,,0,0,0,,ПРИШЁЛ В ПОЛИТИЧЕСКУЮ ЖИЗНЬ. ТОЛЬКО ЕСТЬ ОДИН
Dialogue: 0,0:02:42.12,0:02:44.68,Caption,,0,0,0,,МАЛЕНЬКИЙ ВОПРОС. ЕСЛИ РЕЧЬ ИДЁТ О ВЫБОРАХ
Dialogue: 0,0:02:44.68,0:02:48.60,Caption,,0,0,0,,ПРЕЗИДЕНТА УКРАИНЫ, ПРИ ЧЁМ ЗДЕСЬ ВООБЩЕ ФОРМУЛИРОВКА ПРО АМЕРИКАНЦЕВ,
Dialogue: 0,0:02:48.69,0:02:50.52,Caption,,0,0,0,,КОТОРЫЕ ХОТЯТ КОГО ТО ЗАМЕНИТЬ?
Dialogue: 0,0:02:50.80,0:02:55.32,Caption,,0,0,0,,КОГО ВЫБИРАЮТ УКРАИНЦЫ? ПРЕЗИДЕНТА УКРАИНЫ. ТОГДА ПОЧЕМУ РАЗГОВОР ЗВУЧИТ
Dialogue: 0,0:02:55.32,0:02:58.68,Caption,,0,0,0,,ТАК, БУДТО ГДЕ ТО В ВАШИНГТОНЕ ПРОПУСТИЛИ УДОБНОЕ ОКНО
Dialogue: 0,0:02:58.76,0:03:01.96,Caption,,0,0,0,,ДЛЯ ЗАМЕНЫ ДИРЕКТОРА ФИЛИАЛА? ЛАДНО. ДОПУСТИМ,
Dialogue: 0,0:03:02.12,0:03:04.76,Caption,,0,0,0,,ЭТО ПРОСТО ПОЛИТИЧЕСКАЯ ШПИЛЬКА В АДРЕС АМЕРИКАНЦЕВ.
Dialogue: 0,0:03:05.08,0:03:07.56,Caption,,0,0,0,,НО ДАЛЬШЕ ЕЩЁ ВЕСЕЛЕЕ. ЗЕЛЕНСКИЙ ГОВОРИТ,
Dialogue: 0,0:03:07.80,0:03:10.60,Caption,,0,0,0,,ЧТО МОЖНО ПОДУМАТЬ ОБ ОНЛАЙН ВЫБОРАХ. ПАРЛАМЕНТ
Dialogue: 0,0:03:10.60,0:03:13.40,Caption,,0,0,0,,ДОЛЖЕН НАЙТИ НУЖНОЕ РЕШЕНИЕ. ТО ЕСТЬ ТЕХНИЧЕСКИЙ
Dialogue: 0,0:03:13.40,0:03:16.36,Caption,,0,0,0,,ВАРИАНТ УЖЕ ОБСУЖДАЕТСЯ. ОТЛИЧНО. ТОЛЬКО ЧЕРЕЗ
Dialogue: 0,0:03:16.44,0:03:19.88,Caption,,0,0,0,,МИНУТУ ВЫЯСНЯЕТСЯ, ЧТО ВЫБОРЫ ПРОВОДИТЬ НЕЛЬЗЯ. ПОЧЕМУ?
Dialogue: 0,0:03:20.20,0:03:23.08,Caption,,0,0,0,,ПОТОМУ ЧТО ВОЕННОСЛУЖАЩИЕ НАХОДЯТСЯ НА ФРОНТЕ. ИМ
Dialogue: 0,0:03:23.08,0:03:25.96,Caption,,0,0,0,,ТЯЖЕЛО ОБЕСПЕЧИТЬ УЧАСТИЕ В ГОЛОСОВАНИИ. ПРОВОДИТЬ
Dialogue: 0,0:03:26.04,0:03:28.92,Caption,,0,0,0,,ВЫБОРЫ БЕЗ НИХ НЕСПРАВЕДЛИВО. И ВОТ ЗДЕСЬ ВОЗНИКАЕТ
Dialogue: 0,0:03:29.00,0:03:34.17,Caption,,0,0,0,,ТА САМАЯ ПРЕКРАСНАЯ ФОРМУЛА. ВЫБОРЫ ПРОВЕСТИ МОЖНО,
Dialogue: 0,0:03:34.33,0:03:37.13,Caption,,0,0,0,,НО НЕЛЬЗЯ. СОЛДАТЫ ОБИДЯТСЯ. ПРАВО ГОЛОСА
Dialogue: 0,0:03:37.13,0:03:40.09,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ НИКТО НЕ ОТМЕНЯЛ. И ИМЕННО ПОЭТОМУ
Dialogue: 0,0:03:40.09,0:03:42.97,Caption,,0,0,0,,ВОПРОС СТАНОВИТСЯ ЕЩЁ НЕПРИЯТНЕЕ ЕСЛИ НОВЫЙ СПОСОБ
Dialogue: 0,0:03:42.97,0:03:46.57,Caption,,0,0,0,,ГОЛОСОВАНИЯ ОБСУЖДАЮТ, ЧТО МЕШАЕТ ДОВЕСТИ ЕГО ДО РЕШЕНИЯ?
Dialogue: 0,0:03:46.99,0:03:49.61,Caption,,0,0,0,,НО ТОГДА ОБЪЯСНИТЕ ДО КОНЦА. ЕСЛИ ПРОБЛЕМА В
Dialogue: 0,0:03:49.69,0:03:53.37,Caption,,0,0,0,,ДОСТУПЕ К ГОЛОСОВАНИЮ, ДЛЯ ЧЕГО ПОДНЯЛИ ТЕМУ ОНЛАЙН ВЫБОРОВ?
Dialogue: 0,0:03:53.51,0:03:56.41,Caption,,0,0,0,,ЕСЛИ ЭЛЕКТРОННЫЙ ВАРИАНТ НЕ РЕШАЕТ ВОПРОС УЧАСТИЯ
Dialogue: 0,0:03:56.41,0:03:59.05,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ, ПОЧЕМУ ЕГО ВООБЩЕ ПРЕДЛАГАЮТ?
Dialogue: 0,0:03:59.41,0:04:01.53,Caption,,0,0,0,,А ЕСЛИ РЕШЕНИЕ ДОЛЖЕН НАЙТИ ПАРЛАМЕНТ,
Dialogue: 0,0:04:01.78,0:04:04.01,Caption,,0,0,0,,ТО ГДЕ КОНКРЕТНОЕ ПРЕДЛОЖЕНИЕ ПАРЛАМЕНТУ?
Dialogue: 0,0:04:04.61,0:04:06.41,Caption,,0,0,0,,У ЗЕЛЕНСКОГО ПОЛУЧАЕТСЯ ЛЮБОПЫТНАЯ
Dialogue: 0,0:04:06.41,0:04:09.05,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТЬ. ВЫБОРЫ НУЖНЫ. ВЫБОРЫ
Dialogue: 0,0:04:09.05,0:04:12.57,Caption,,0,0,0,,ОБСУЖДАЮТСЯ. ЭЛЕКТРОННОЕ ГОЛОСОВАНИЕ ДОПУСКАЕТСЯ. НО
Dialogue: 0,0:04:12.65,0:04:14.97,Caption,,0,0,0,,ПРОВЕСТИ ИХ СЕЙЧАС НЕЛЬЗЯ. И ВОТ ТУТ УЖЕ
Dialogue: 0,0:04:14.97,0:04:19.61,Caption,,0,0,0,,ХОЧЕТСЯ СПРОСИТЬ. РЕБЯТА, ВЫ ДЕЙСТВИТЕЛЬНО ИЩЕТЕ СПОСОБ ОРГАНИЗОВАТЬ ВЫБОРЫ
Dialogue: 0,0:04:19.61,0:04:22.41,Caption,,0,0,0,,ИЛИ ПРОСТО СОСТАВЛЯЕТЕ ВСЁ БОЛЕЕ ПОДРОБНЫЙ ПЕРЕЧЕНЬ
Dialogue: 0,0:04:22.41,0:04:24.33,Caption,,0,0,0,,ПРИЧИН, ПОЧЕМУ ИХ ПОКА НЕ БУДЕТ?
Dialogue: 0,0:04:24.73,0:04:28.09,Caption,,0,0,0,,ПЯТИЛЕТНИЙ СРОК, НА КОТОРЫЙ ЗЕЛЕНСКОГО ИЗБРАЛИ ПРЕЗИДЕНТОМ В ДВЕ
Dialogue: 0,0:04:28.17,0:04:32.57,Caption,,0,0,0,,ТЫСЯЧИ ДЕВЯТНАДЦАТОМ ГОДУ, ЗАКОНЧИЛСЯ ЕЩЁ В МАЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ЧЕТВЁРТОГО.
Dialogue: 0,0:04:32.97,0:04:35.69,Caption,,0,0,0,,НОВЫЕ ПРЕЗИДЕНТСКИЕ ВЫБОРЫ НЕ ПРОВОДИЛИСЬ.
Dialogue: 0,0:04:35.88,0:04:38.33,Caption,,0,0,0,,УКРАИНСКАЯ ВЛАСТЬ ОБЪЯСНЯЕТ ПРОДОЛЖЕНИЕ ЕГО
Dialogue: 0,0:04:38.33,0:04:40.73,Caption,,0,0,0,,ПОЛНОМОЧИЙ ВОЕННЫМ ПОЛОЖЕНИЕМ И ДЕЙСТВУЮЩИМИ
Dialogue: 0,0:04:40.73,0:04:47.18,Caption,,0,0,0,,ПРАВОВЫМИ НОРМАМИ. ХОРОШО. НО ЕСЛИ САМ ЗЕЛЕНСКИЙ ТЕПЕРЬ ВЫНОСИТ НА СТОЛ
Dialogue: 0,0:04:47.18,0:04:50.46,Caption,,0,0,0,,ОНЛАЙН ГОЛОСОВАНИЕ, ЗНАЧИТ ВОПРОС УЖЕ НЕ ЛЕЖИТ ГДЕ ТО В
Dialogue: 0,0:04:50.54,0:04:53.42,Caption,,0,0,0,,ДАЛЬНЕМ ЯЩИКЕ. ОН САМ ЕГО ДОСТАЛ. ВОТ ТОГДА
Dialogue: 0,0:04:53.42,0:04:56.46,Caption,,0,0,0,,И ХОЧЕТСЯ УСЛЫШАТЬ НЕ ТОЛЬКО СПИСОК ПРЕПЯТСТВИЙ. ЧТО
Dialogue: 0,0:04:56.46,0:04:58.14,Caption,,0,0,0,,КОНКРЕТНО ПРЕДЛАГАЕТСЯ ДЕЛАТЬ?
Dialogue: 0,0:04:58.61,0:05:01.10,Caption,,0,0,0,,И ТУТ ЗЕЛЕНСКИЙ ВЫДАЁТ ЕЩЁ ОДНУ ПРЕКРАСНУЮ МЫСЛЬ.
Dialogue: 0,0:05:01.58,0:05:05.74,Caption,,0,0,0,,ОКАЗЫВАЕТСЯ, КОНЦЕНТРАЦИЯ ВЛАСТИ У ОДНОГО ЧЕЛОВЕКА ОПАСНА. ВОТ
Dialogue: 0,0:05:05.82,0:05:08.54,Caption,,0,0,0,,ТУТ ХОЧЕТСЯ ДАЖЕ ПЕРЕСПРОСИТЬ. А САМ К СОБСТВЕННЫМ
Dialogue: 0,0:05:08.54,0:05:09.98,Caption,,0,0,0,,СОВЕТАМ ПРИСЛУШАТЬСЯ НЕ ХОЧЕШЬ?
Dialogue: 0,0:05:10.37,0:05:12.86,Caption,,0,0,0,,ЧЕЛОВЕК СИДИТ В ПРЕЗИДЕНТСКОМ КРЕСЛЕ ПОСЛЕ ОКОНЧАНИЯ
Dialogue: 0,0:05:12.86,0:05:14.70,Caption,,0,0,0,,ПЕРВОНАЧАЛЬНОГО ПЯТИЛЕТНЕГО СРОКА,
Dialogue: 0,0:05:14.94,0:05:18.21,Caption,,0,0,0,,НОВЫХ ВЫБОРОВ НЕТ, А ТЕПЕРЬ РАССКАЗЫВАЕТ ИЛОНУ МАСКУ,
Dialogue: 0,0:05:18.45,0:05:21.33,Caption,,0,0,0,,ПОЧЕМУ КОНЦЕНТРАЦИЯ ВЛАСТИ У ОДНОГО ЧЕЛОВЕКА ОПАСНА.
Dialogue: 0,0:05:21.57,0:05:23.98,Caption,,0,0,0,,ВОТ ТАКОЙ РАССУЖДАТОР. ПРИЧЁМ ГОВОРИТ ОН НЕ О
Dialogue: 0,0:05:23.98,0:05:27.02,Caption,,0,0,0,,СЕБЕ. ОН ГОВОРИТ О МАСКЕ. ПО СЛОВАМ ЗЕЛЕНСКОГО,
Dialogue: 0,0:05:27.26,0:05:30.14,Caption,,0,0,0,,КОГДА САМЫЙ БОГАТЫЙ ЧЕЛОВЕК В МИРЕ СПОСОБЕН ВЛИЯТЬ
Dialogue: 0,0:05:30.14,0:05:32.94,Caption,,0,0,0,,НА АМЕРИКАНСКУЮ ПОЛИТИКУ, НА НЕМЕЦКУЮ ПОЛИТИКУ,
Dialogue: 0,0:05:33.10,0:05:36.06,Caption,,0,0,0,,РАССУЖДАТЬ О ТОМ, КТО ДОЛЖЕН РУКОВОДИТЬ УКРАИНОЙ,
Dialogue: 0,0:05:36.22,0:05:38.78,Caption,,0,0,0,,ЭТО ОПАСНО ДЛЯ НЕБОЛЬШИХ ГОСУДАРСТВ. ДАЖЕ
Dialogue: 0,0:05:38.78,0:05:40.94,Caption,,0,0,0,,НЕПРАВИЛЬНЫЙ ВЫБОР, ГОВОРИТ ЗЕЛЕНСКИЙ,
Dialogue: 0,0:05:41.09,0:05:44.22,Caption,,0,0,0,,ЛУЧШЕ, ЧЕМ КОГДА ТЕБЕ КОГО ТО НАВЯЗЫВАЮТ. ПРЕКРАСНО
Dialogue: 0,0:05:44.22,0:05:47.18,Caption,,0,0,0,,СКАЗАНО. ТОЛЬКО ДЛЯ НАЧАЛА ЭТОТ ВЫБОР НАДО ПРОВЕСТИ.
Dialogue: 0,0:05:47.33,0:05:49.34,Caption,,0,0,0,,ВОТ ТАКАЯ МЕЛОЧЬ. ПОДПИСЫВАЙТЕСЬ.
Dialogue: 0,0:05:51.62,0:05:53.86,Caption,,0,0,0,,ДАЛЬШЕ ИСТОРИЯ СТАНОВИТСЯ ЕЩЁ ИНТЕРЕСНЕЕ,
Dialogue: 0,0:05:54.10,0:05:56.26,Caption,,0,0,0,,ПОТОМУ ЧТО ОДНОВРЕМЕННО С РАЗГОВОРАМИ О ВЫБОРАХ
Dialogue: 0,0:05:56.26,0:05:58.66,Caption,,0,0,0,,ВНЕЗАПНО ВСПЛЫВАЕТ ПРЕДПОЛАГАЕМЫЙ БОЛЬШОЙ ПЛАН
Dialogue: 0,0:05:58.66,0:06:02.66,Caption,,0,0,0,,ПЕРЕГОВОРОВ, И ТАМ МАСШТАБЫ УЖЕ СОВСЕМ ДРУГИЕ. В УКРАИНСКОМ
Dialogue: 0,0:06:02.66,0:06:04.74,Caption,,0,0,0,,ИНФОРМАЦИОННОМ ПОЛЕ ПОЯВИЛАСЬ ВЕРСИЯ,
Dialogue: 0,0:06:05.06,0:06:07.70,Caption,,0,0,0,,ЧТО КИРИЛЛ ДМИТРИЕВ ПЕРЕДАЛ ТРАМПУ И КУШНЕРУ ЦЕЛЫЙ
Dialogue: 0,0:06:07.70,0:06:10.42,Caption,,0,0,0,,ПАКЕТ РОССИЙСКИХ УСЛОВИЙ. ЭТУ ВЕРСИЮ ИЗЛОЖИЛ
Dialogue: 0,0:06:10.50,0:06:13.14,Caption,,0,0,0,,УКРАИНСКИЙ АНАЛИТИК СЕРГЕЙ ПАВЛЮЧЕНКО. КРЕМЛЬ И
Dialogue: 0,0:06:13.14,0:06:15.54,Caption,,0,0,0,,БЕЛЫЙ ДОМ ТАКОЙ ПАКЕТ ПУБЛИЧНО НЕ ПОДТВЕРЖДАЛИ,
Dialogue: 0,0:06:15.78,0:06:18.42,Caption,,0,0,0,,ПОЭТОМУ ОТНОСИМСЯ К НЕМУ ИМЕННО КАК К ОПУБЛИКОВАННОЙ
Dialogue: 0,0:06:18.42,0:06:21.70,Caption,,0,0,0,,ВЕРСИИ. НО САМА КОНСТРУКЦИЯ ЗАНЯТНАЯ. ПЕРВЫЙ ЭТАП,
Dialogue: 0,0:06:22.02,0:06:24.98,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКОЕ ПЕРЕМИРИЕ ДО КОНЦА ГОДА. СТОРОНЫ
Dialogue: 0,0:06:24.98,0:06:27.62,Caption,,0,0,0,,ПРЕКРАЩАЮТ УДАРЫ ПО ЭНЕРГЕТИЧЕСКОЙ ИНФРАСТРУКТУРЕ.
Dialogue: 0,0:06:27.94,0:06:30.34,Caption,,0,0,0,,МОСКВА ПРИ ЭТОМ ТРЕБУЕТ ПОЛНОГО ПРЕКРАЩЕНИЯ
Dialogue: 0,0:06:30.34,0:06:32.50,Caption,,0,0,0,,УКРАИНСКИХ АТАК НА РОССИЙСКИЕ ГРАЖДАНСКИЕ
Dialogue: 0,0:06:32.50,0:06:35.54,Caption,,0,0,0,,НЕФТЕГАЗОВЫЕ ОБЪЕКТЫ И НЕФТЕПЕРЕРАБАТЫВАЮЩИЕ ЗАВОДЫ.
Dialogue: 0,0:06:35.75,0:06:38.02,Caption,,0,0,0,,НА ПЕРВЫЙ ВЗГЛЯД ВСЁ ПРОСТО. НЕ БЬЁМ ПО
Dialogue: 0,0:06:38.02,0:06:40.18,Caption,,0,0,0,,ЭНЕРГЕТИКЕ, ЛЮДИ ПОЛУЧАЮТ СВЕТ,
Dialogue: 0,0:06:40.29,0:06:45.06,Caption,,0,0,0,,ВОДУ И ОТОПЛЕНИЕ, ЗЕЛЕНСКИЙ ПРОВОДИТ СВОИ ВЫБОРЫ. КРАСОТА. НО ДАЛЬШЕ
Dialogue: 0,0:06:45.06,0:06:47.86,Caption,,0,0,0,,ОТКРЫВАЕМ СЛЕДУЮЩИЙ ПУНКТ, И ВНЕЗАПНО ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:06:48.09,0:06:50.66,Caption,,0,0,0,,ЧТО РЕЧЬ ВООБЩЕ НЕ ТОЛЬКО ОБ ЭНЕРГЕТИКЕ. ПО
Dialogue: 0,0:06:50.66,0:06:54.90,Caption,,0,0,0,,ВЕРСИИ ПАВЛЮЧЕНКО, МОСКВА ГОТОВА ОСТАВИТЬ ПОД КОНТРОЛЕМ КИЕВА ТУ ЧАСТЬ
Dialogue: 0,0:06:54.90,0:06:57.70,Caption,,0,0,0,,ДОНБАССА, КОТОРУЮ УКРАИНА УДЕРЖИВАЕТ СЕЙЧАС.
Dialogue: 0,0:06:59.99,0:07:02.71,Caption,,0,0,0,,НО В ОБМЕН ТРЕБУЕТ РЕЗКОГО СОКРАЩЕНИЯ ЧИСЛЕННОСТИ
Dialogue: 0,0:07:02.71,0:07:05.75,Caption,,0,0,0,,УКРАИНСКОЙ АРМИИ И ТЯЖЁЛЫХ ВООРУЖЕНИЙ. ДАЛЬШЕ
Dialogue: 0,0:07:05.83,0:07:08.31,Caption,,0,0,0,,РУССКИЙ ЯЗЫК. ПОТОМ ПОЛОЖЕНИЕ КАНОНИЧЕСКОЙ
Dialogue: 0,0:07:08.31,0:07:10.87,Caption,,0,0,0,,ПРАВОСЛАВНОЙ ЦЕРКВИ. ПОТОМ ЗАПАДНЫЙ ВОЕННЫЙ
Dialogue: 0,0:07:10.87,0:07:13.83,Caption,,0,0,0,,КОНТИНГЕНТ. ПОТОМ ВОЕННАЯ ИНФРАСТРУКТУРА НАТО В
Dialogue: 0,0:07:13.91,0:07:17.03,Caption,,0,0,0,,ПРИБАЛТИКЕ И СКАНДИНАВИИ. ПОДОЖДИТЕ. МЫ ТОЛЬКО ЧТО
Dialogue: 0,0:07:17.03,0:07:21.35,Caption,,0,0,0,,СОБИРАЛИСЬ ДОГОВОРИТЬСЯ, ЧТОБЫ ЗИМОЙ НЕ РАЗБИВАТЬ ЭЛЕКТРОСТАНЦИИ. А ЧЕРЕЗ
Dialogue: 0,0:07:21.35,0:07:23.83,Caption,,0,0,0,,ПЯТЬ МИНУТ УЖЕ ПЕРЕДВИГАЕМ ВОЕННУЮ ИНФРАСТРУКТУРУ
Dialogue: 0,0:07:23.83,0:07:27.75,Caption,,0,0,0,,НАТО ПО ВСЕЙ ЕВРОПЕ. ВОТ ПОЭТОМУ РАЗГОВОР О ТЕРРИТОРИЯХ САМ ПО СЕБЕ
Dialogue: 0,0:07:27.83,0:07:30.47,Caption,,0,0,0,,НИЧЕГО НЕ ОБЪЯСНЯЕТ. ВОПРОС НЕ ТОЛЬКО В ТОМ,
Dialogue: 0,0:07:30.79,0:07:33.35,Caption,,0,0,0,,ГДЕ ЗАВТРА ПРОЙДЁТ ЛИНИЯ НА КАРТЕ. ВОПРОС В
Dialogue: 0,0:07:33.35,0:07:37.19,Caption,,0,0,0,,ТОМ, ЧТО СТОРОНЫ СЧИТАЮТ КОНЕЧНЫМ РЕЗУЛЬТАТОМ. РОССИЯ
Dialogue: 0,0:07:37.27,0:07:39.99,Caption,,0,0,0,,МНОГО ЛЕТ ГОВОРИТ НЕ ТОЛЬКО О ДОНБАССЕ. МОСКВА
Dialogue: 0,0:07:39.99,0:07:45.03,Caption,,0,0,0,,ГОВОРИТ О НАТО, ВООРУЖЕНИЯХ, СТАТУСЕ УКРАИНЫ И ОБЩЕЙ СИСТЕМЕ БЕЗОПАСНОСТИ.
Dialogue: 0,0:07:45.32,0:07:49.43,Caption,,0,0,0,,ПОЭТОМУ ДАЖЕ ЕСЛИ ДОПУСТИТЬ, ЧТО ТЕРРИТОРИАЛЬНАЯ ЧАСТЬ СДЕЛКИ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:07:49.43,0:07:51.75,Caption,,0,0,0,,ОБСУЖДАЕТСЯ, ЭТО ЕЩЁ НЕ ОЗНАЧАЕТ,
Dialogue: 0,0:07:51.92,0:07:56.23,Caption,,0,0,0,,ЧТО ГЛАВНЫЙ СПОР РЕШЁН. ТЕРРИТОРИИ ЗДЕСЬ СКОРЕЕ ОТВЕЧАЮТ НА ВОПРОС,
Dialogue: 0,0:07:56.47,0:07:59.75,Caption,,0,0,0,,НАСКОЛЬКО ДАЛЕКО РОССИЯ СОБИРАЕТСЯ ИДТИ. А ВОПРОС
Dialogue: 0,0:07:59.75,0:08:02.63,Caption,,0,0,0,,БУДУЩЕЙ СИСТЕМЫ БЕЗОПАСНОСТИ ОСТАЁТСЯ НАМНОГО ШИРЕ.
Dialogue: 0,0:08:03.03,0:08:06.95,Caption,,0,0,0,,КТО И ГДЕ ДЕРЖИТ ВОЙСКА? КАКАЯ АРМИЯ БУДЕТ У УКРАИНЫ?
Dialogue: 0,0:08:07.09,0:08:10.55,Caption,,0,0,0,,КАКИЕ ВООРУЖЕНИЯ? ГДЕ БУДУТ НАХОДИТЬСЯ ЗАПАДНЫЕ ВОЕННЫЕ?
Dialogue: 0,0:08:10.78,0:08:12.71,Caption,,0,0,0,,ЧТО БУДЕТ С ИНФРАСТРУКТУРОЙ НАТО?
Dialogue: 0,0:08:12.79,0:08:14.63,Caption,,0,0,0,,КАКИЕ ГАРАНТИИ ПОЛУЧИТ УКРАИНА?
Dialogue: 0,0:08:16.81,0:08:18.73,Caption,,0,0,0,,КАКИЕ ГАРАНТИИ ПОТРЕБУЕТ РОССИЯ?
Dialogue: 0,0:08:19.05,0:08:22.09,Caption,,0,0,0,,И ЧТО ПРОИСХОДИТ, ЕСЛИ КТО ТО ЧЕРЕЗ ГОД РЕШАЕТ,
Dialogue: 0,0:08:22.36,0:08:24.81,Caption,,0,0,0,,ЧТО СТАРЫЕ ДОГОВОРЁННОСТИ ЕМУ БОЛЬШЕ НЕ ПОДХОДЯТ?
Dialogue: 0,0:08:25.37,0:08:27.61,Caption,,0,0,0,,ВОТ ЭТО УЖЕ РАЗГОВОР НЕ ПРО НЕСКОЛЬКО РАЙОНОВ
Dialogue: 0,0:08:27.69,0:08:32.33,Caption,,0,0,0,,НА КАРТЕ. ЭТО РАЗГОВОР О ТОМ, КАК ВООБЩЕ БУДЕТ УСТРОЕНА БЕЗОПАСНОСТЬ В ЕВРОПЕ
Dialogue: 0,0:08:32.33,0:08:35.69,Caption,,0,0,0,,ПОСЛЕ ОКОНЧАНИЯ НЫНЕШНЕГО КОНФЛИКТА. И ЗДЕСЬ ИСТОРИЯ
Dialogue: 0,0:08:35.77,0:08:38.73,Caption,,0,0,0,,С ВЫБОРАМИ НЕОЖИДАННО ВОЗВРАЩАЕТСЯ ЕЩЁ РАЗ. ПОТОМУ
Dialogue: 0,0:08:38.81,0:08:41.21,Caption,,0,0,0,,ЧТО ОКОНЧАТЕЛЬНОЕ СОГЛАШЕНИЕ КТО ТО ДОЛЖЕН
Dialogue: 0,0:08:41.21,0:08:44.09,Caption,,0,0,0,,ПОДПИСЫВАТЬ. МОСКВА УЖЕ СТАВИЛА ВОПРОС О ТОМ,
Dialogue: 0,0:08:44.31,0:08:47.29,Caption,,0,0,0,,КОГО ОНА СЧИТАЕТ ЛЕГИТИМНЫМ УКРАИНСКИМ ПОДПИСАНТОМ.
Dialogue: 0,0:08:47.67,0:08:50.57,Caption,,0,0,0,,КИЕВ ЭТУ РОССИЙСКУЮ ТРАКТОВКУ ОТВЕРГАЕТ. НО САМ
Dialogue: 0,0:08:50.65,0:08:53.37,Caption,,0,0,0,,ВОПРОС НИКУДА НЕ ИСЧЕЗАЕТ. МОЖНО СОГЛАСОВАТЬ
Dialogue: 0,0:08:53.37,0:08:56.49,Caption,,0,0,0,,КРАСИВЫЙ ДОКУМЕНТ НА ДЕСЯТКИ СТРАНИЦ. А ПОТОМ ОДНА
Dialogue: 0,0:08:56.57,0:08:59.21,Caption,,0,0,0,,СТОРОНА СКАЖЕТ ЧЕЛОВЕК, КОТОРЫЙ ЕГО ПОДПИСАЛ,
Dialogue: 0,0:08:59.37,0:09:01.85,Caption,,0,0,0,,НЕ ИМЕЛ НЕОБХОДИМЫХ ПОЛНОМОЧИЙ. ОТЛИЧНО
Dialogue: 0,0:09:01.85,0:09:06.49,Caption,,0,0,0,,ДОГОВОРИЛИСЬ. ПОЭТОМУ ВЫБОРЫ, РАЗГОВОРЫ О ПОЛНОМОЧИЯХ ЗЕЛЕНСКОГО И ПЕРЕГОВОРНЫЙ
Dialogue: 0,0:09:06.49,0:09:08.81,Caption,,0,0,0,,ПРОЦЕСС СВЯЗАНЫ ГОРАЗДО ТЕСНЕЕ,
Dialogue: 0,0:09:08.90,0:09:11.69,Caption,,0,0,0,,ЧЕМ КАЖЕТСЯ НА ПЕРВЫЙ ВЗГЛЯД. А ПОКА ПОЛИТИКИ
Dialogue: 0,0:09:11.69,0:09:16.33,Caption,,0,0,0,,ОБСУЖДАЮТ МИР, ЕВРОПА ПРОДОЛЖАЕТ ОТПРАВЛЯТЬ ПОМОЩЬ. ПРИЧЁМ ИТАЛИЯ,
Dialogue: 0,0:09:16.41,0:09:19.53,Caption,,0,0,0,,ИСПАНИЯ И СЛОВАКИЯ СЕЙЧАС ДЕЙСТВУЮТ СОВЕРШЕННО ПО
Dialogue: 0,0:09:19.53,0:09:21.85,Caption,,0,0,0,,РАЗНОМУ. И ПО СОДЕРЖАНИЮ ПОМОЩИ,
Dialogue: 0,0:09:22.02,0:09:24.97,Caption,,0,0,0,,И ПО ПОЛИТИЧЕСКИМ РЕШЕНИЯМ. МИНИСТР ОБОРОНЫ ИТАЛИИ
Dialogue: 0,0:09:24.97,0:09:27.77,Caption,,0,0,0,,ГУИДО КРОЗЕТТО НАМЕРЕН ПРЕДЛОЖИТЬ ПРОДЛИТЬ МЕХАНИЗМ
Dialogue: 0,0:09:27.85,0:09:30.33,Caption,,0,0,0,,ВОЕННОЙ ПОМОЩИ УКРАИНЕ ЕЩЁ НА СЛЕДУЮЩИЙ ГОД.
Dialogue: 0,0:09:32.62,0:09:34.14,Caption,,0,0,0,,ТО ЕСТЬ РЕЧЬ НЕ ТОЛЬКО О КАКОМ ТО
Dialogue: 0,0:09:34.14,0:09:37.26,Caption,,0,0,0,,ОДНОМ ЯЩИКЕ С РАКЕТАМИ. РЕЧЬ О ПРОДОЛЖЕНИИ САМОЙ
Dialogue: 0,0:09:37.26,0:09:39.98,Caption,,0,0,0,,ГОСУДАРСТВЕННОЙ ПРОГРАММЫ ПОСТАВОК. КРОЗЕТТО
Dialogue: 0,0:09:39.98,0:09:43.50,Caption,,0,0,0,,НАПОМИНАЕТ, ЧТО МЕХАНИЗМ ПОЯВИЛСЯ ЕЩЁ ПРИ ПРАВИТЕЛЬСТВЕ МАРИО
Dialogue: 0,0:09:43.50,0:09:45.98,Caption,,0,0,0,,ДРАГИ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОМ ГОДУ. ТОГДА
Dialogue: 0,0:09:45.98,0:09:49.42,Caption,,0,0,0,,ЕГО ПОДДЕРЖИВАЛИ ПАРТИИ, КОТОРЫЕ СЕЙЧАС СИДЯТ И ВО ВЛАСТИ,
Dialogue: 0,0:09:49.50,0:09:52.30,Caption,,0,0,0,,И В ОППОЗИЦИИ. А ПОТОМ ПОЗИЦИИ НАЧАЛИ МЕНЯТЬСЯ.
Dialogue: 0,0:09:52.62,0:09:55.18,Caption,,0,0,0,,И КРОЗЕТТО ЗАДАЁТ СВОИМ КОЛЛЕГАМ ПРОСТОЙ ВОПРОС.
Dialogue: 0,0:09:55.51,0:09:57.42,Caption,,0,0,0,,ЕСЛИ ПОМОЩЬ БЫЛА ПРАВИЛЬНОЙ ТОГДА,
Dialogue: 0,0:09:57.66,0:09:59.42,Caption,,0,0,0,,ПОЧЕМУ ТЕПЕРЬ ОНА СТАЛА НЕПРАВИЛЬНОЙ?
Dialogue: 0,0:09:59.76,0:10:02.46,Caption,,0,0,0,,НУ, ВООБЩЕ ТО ЗА ЧЕТЫРЕ ГОДА КОЕ ЧТО ПРОИЗОШЛО.
Dialogue: 0,0:10:02.94,0:10:05.66,Caption,,0,0,0,,ПЯТЫЙ ГОД ИДЁТ КОНФЛИКТ. МЕНЯЕТСЯ СИТУАЦИЯ НА
Dialogue: 0,0:10:05.66,0:10:08.78,Caption,,0,0,0,,ФРОНТЕ. МЕНЯЮТСЯ БЮДЖЕТЫ. МЕНЯЕТСЯ НАСТРОЕНИЕ
Dialogue: 0,0:10:08.78,0:10:12.06,Caption,,0,0,0,,ИЗБИРАТЕЛЕЙ. МЕНЯЮТСЯ ОТНОШЕНИЯ С ВАШИНГТОНОМ. ТАК
Dialogue: 0,0:10:12.06,0:10:14.70,Caption,,0,0,0,,ЧТО ПОЛИТИЧЕСКАЯ ПАРТИЯ ВПОЛНЕ СПОСОБНА ПЕРЕСМОТРЕТЬ
Dialogue: 0,0:10:14.78,0:10:17.34,Caption,,0,0,0,,ПОЗИЦИЮ. НО ПРАВИТЕЛЬСТВО ДЖОРДЖИ МЕЛОНИ,
Dialogue: 0,0:10:17.50,0:10:21.82,Caption,,0,0,0,,СУДЯ ПО СЛОВАМ КРОЗЕТТО, ПЕРЕСМАТРИВАТЬ ОБЩИЙ КУРС ПОКА НЕ СОБИРАЕТСЯ. НА
Dialogue: 0,0:10:21.82,0:10:24.38,Caption,,0,0,0,,ДЕСЯТОЕ НОЯБРЯ НАЗНАЧЕНО ЗАСЕДАНИЕ ПАРЛАМЕНТСКОГО
Dialogue: 0,0:10:24.38,0:10:27.10,Caption,,0,0,0,,КОМИТЕТА ПО БЕЗОПАСНОСТИ. ТАМ МИНИСТР ДОЛЖЕН
Dialogue: 0,0:10:27.10,0:10:29.98,Caption,,0,0,0,,ПРЕДСТАВИТЬ УЖЕ ТРИНАДЦАТЫЙ ПАКЕТ ПОМОЩИ УКРАИНЕ.
Dialogue: 0,0:10:30.30,0:10:32.38,Caption,,0,0,0,,ТРИНАДЦАТЫЙ. ПО ДАННЫМ REUTERS,
Dialogue: 0,0:10:32.62,0:10:34.62,Caption,,0,0,0,,В НЕГО МОГУТ ВОЙТИ РАКЕТЫ ДЛЯ КОМПЛЕКСА
Dialogue: 0,0:10:34.62,0:10:38.06,Caption,,0,0,0,,ПРОТИВОВОЗДУШНОЙ ОБОРОНЫ S A M P КОСАЯ ЧЕРТА
Dialogue: 0,0:10:38.06,0:10:41.02,Caption,,0,0,0,,T. САМ СОСТАВ ИТАЛЬЯНСКИХ ПАКЕТОВ ТРАДИЦИОННО
Dialogue: 0,0:10:41.02,0:10:47.54,Caption,,0,0,0,,ПОДРОБНО НЕ РАСКРЫВАЕТСЯ. И ВНУТРИ ПРАВЯЩЕЙ КОАЛИЦИИ ЕДИНСТВА ПО ЭТОМУ ВОПРОСУ
Dialogue: 0,0:10:47.62,0:10:50.34,Caption,,0,0,0,,НЕТ. "ЛИГА" МАТТЕО САЛЬВИНИ ВЫСТУПАЕТ ПРОТИВ
Dialogue: 0,0:10:50.34,0:10:53.30,Caption,,0,0,0,,ДАЛЬНЕЙШИХ ПОСТАВОК ОРУЖИЯ. ТО ЕСТЬ ИТАЛИЯ НЕ ПРОСТО
Dialogue: 0,0:10:53.30,0:10:55.86,Caption,,0,0,0,,СОБИРАЕТ ОЧЕРЕДНОЙ ПАКЕТ. ТАМ ЕЩЁ ПРЕДСТОИТ
Dialogue: 0,0:10:55.86,0:10:58.58,Caption,,0,0,0,,ВНУТРЕННИЙ РАЗГОВОР О ТОМ, ЗАЧЕМ ПРОДОЛЖАТЬ,
Dialogue: 0,0:10:58.82,0:11:01.86,Caption,,0,0,0,,СКОЛЬКО ПРОДОЛЖАТЬ И ГДЕ ВООБЩЕ НАХОДИТСЯ КОНЕЧНАЯ
Dialogue: 0,0:11:01.86,0:11:04.74,Caption,,0,0,0,,ТОЧКА ВСЕЙ ЭТОЙ ПРОГРАММЫ. А ИСПАНИЯ ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:11:04.75,0:11:07.86,Caption,,0,0,0,,УЖЕ ОБЪЯВЛЯЕТ КОНКРЕТНУЮ СУММУ. ЧЕТЫРЕСТА ТРИДЦАТЬ
Dialogue: 0,0:11:07.94,0:11:10.90,Caption,,0,0,0,,СЕМЬ МИЛЛИОНОВ ЕВРО. И ЗДЕСЬ ВАЖНО РАЗЛИЧАТЬ СУММЫ,
Dialogue: 0,0:11:11.14,0:11:13.86,Caption,,0,0,0,,ПОТОМУ ЧТО У ИТАЛИИ И ИСПАНИИ СОВЕРШЕННО РАЗНЫЕ
Dialogue: 0,0:11:13.86,0:11:16.50,Caption,,0,0,0,,РЕШЕНИЯ. ЧЕТЫРЕСТА ТРИДЦАТЬ СЕМЬ МИЛЛИОНОВ ЭТО
Dialogue: 0,0:11:16.50,0:11:19.46,Caption,,0,0,0,,ИМЕННО ИСПАНСКИЙ ПАКЕТ. НЕ ИСПАНИЯ ПЛЮС ИТАЛИЯ.
Dialogue: 0,0:11:19.69,0:11:22.58,Caption,,0,0,0,,ИМЕННО ИСПАНИЯ. ЗЕЛЕНСКИЙ ПОСЛЕ ВСТРЕЧИ С ПЕДРО
Dialogue: 0,0:11:22.58,0:11:26.90,Caption,,0,0,0,,САНЧЕСОМ СООБЩИЛ, ЧТО СТОРОНЫ ОБСУДИЛИ СОДЕРЖАНИЕ ПОСТАВОК И ТЕКУЩИЕ
Dialogue: 0,0:11:26.98,0:11:29.62,Caption,,0,0,0,,ПОТРЕБНОСТИ УКРАИНСКОЙ АРМИИ. ЧЕТЫРЕСТА ТРИДЦАТЬ
Dialogue: 0,0:11:29.70,0:11:32.42,Caption,,0,0,0,,СЕМЬ МИЛЛИОНОВ ЕВРО. ЭТО ЧЕТЫРЕСТА ТРИДЦАТЬ СЕМЬ
Dialogue: 0,0:11:32.50,0:11:35.38,Caption,,0,0,0,,ТЫСЯЧ ВЫПЛАТ ПО ТЫСЯЧЕ ЕВРО КАЖДАЯ. И ЭТО
Dialogue: 0,0:11:35.38,0:11:37.94,Caption,,0,0,0,,ВСЕГО ОДИН ИСПАНСКИЙ ПАКЕТ ВОЕННОЙ ПОМОЩИ.
Dialogue: 0,0:11:38.23,0:11:39.86,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО ИТАЛИЯ ГОТОВИТ СВОЙ.
Dialogue: 0,0:11:40.50,0:11:42.90,Caption,,0,0,0,,В ЕВРОПЕЙСКОЙ КАРТИНЕ ПОЯВЛЯЮТСЯ И ДРУГИЕ ДЕНЬГИ.
Dialogue: 0,0:11:43.06,0:11:46.18,Caption,,0,0,0,,ЕВРОСОЮЗ РАНЕЕ ВЫДЕЛИЛ КИЕВУ ЕЩЁ ЧЕТЫРЕ МИЛЛИАРДА
Dialogue: 0,0:11:46.26,0:11:49.30,Caption,,0,0,0,,ТРИСТА ШЕСТЬДЕСЯТ МИЛЛИОНОВ ЕВРО. ГЕРМАНИЯ ОБЪЯВИЛА
Dialogue: 0,0:11:49.30,0:11:51.62,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЕ ДВЕСТИ МИЛЛИОНОВ НА ПОДДЕРЖКУ
Dialogue: 0,0:11:51.62,0:11:54.58,Caption,,0,0,0,,УКРАИНСКОЙ ЭНЕРГЕТИКИ. И ВОТ ЗДЕСЬ НАЧИНАЕТСЯ ОЧЕНЬ
Dialogue: 0,0:11:54.66,0:11:59.57,Caption,,0,0,0,,ВАЖНЫЙ МОМЕНТ. НЕ НАДО ВСЁ ЭТО СВАЛИВАТЬ В ОДНУ КУЧУ
Dialogue: 0,0:11:59.65,0:12:03.81,Caption,,0,0,0,,И КРИЧАТЬ СМОТРИТЕ, СКОЛЬКО МИЛЛИАРДОВ. ВОЕННАЯ ПОМОЩЬ ЭТО ОДНО.
Dialogue: 0,0:12:04.05,0:12:06.93,Caption,,0,0,0,,ЭНЕРГЕТИКА ДРУГОЕ. БЮДЖЕТНАЯ ПОДДЕРЖКА ТРЕТЬЕ.
Dialogue: 0,0:12:07.20,0:12:10.53,Caption,,0,0,0,,ДОЛГОСРОЧНЫЕ ПРОГРАММЫ ЧЕТВЁРТОЕ. НО ОБЩАЯ КАРТИНА
Dialogue: 0,0:12:10.61,0:12:13.09,Caption,,0,0,0,,ОТ ЭТОГО НЕ СТАНОВИТСЯ МЕНЕЕ ИНТЕРЕСНОЙ. ПОКА
Dialogue: 0,0:12:13.09,0:12:15.17,Caption,,0,0,0,,ПОЛИТИКИ ГОВОРЯТ О БУДУЩЕМ ПЕРЕМИРИИ,
Dialogue: 0,0:12:15.41,0:12:17.81,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ ПРАВИТЕЛЬСТВА ПРОДОЛЖАЮТ ВКЛАДЫВАТЬ
Dialogue: 0,0:12:17.81,0:12:20.21,Caption,,0,0,0,,ДЕНЬГИ В ПРОДОЛЖЕНИЕ УКРАИНСКОЙ УСТОЙЧИВОСТИ И
Dialogue: 0,0:12:20.29,0:12:23.49,Caption,,0,0,0,,ОБОРОНЫ. ОДНО ДРУГОМУ НЕ МЕШАЕТ. ЗА ОДНИМ СТОЛОМ
Dialogue: 0,0:12:23.49,0:12:26.77,Caption,,0,0,0,,ОБСУЖДАЕМ, КАК ПРЕКРАЩАТЬ. ЗА ДРУГИМ ПОДПИСЫВАЕМ,
Dialogue: 0,0:12:26.91,0:12:30.69,Caption,,0,0,0,,ЧЕМ ПРОДОЛЖАТЬ, ЕСЛИ ПРЕКРАТИТЬ НЕ ПОЛУЧИТСЯ. НОРМАЛЬНАЯ БОЛЬШАЯ
Dialogue: 0,0:12:30.69,0:12:33.57,Caption,,0,0,0,,ПОЛИТИКА. А ТЕПЕРЬ СЛОВАКИЯ. И ВОТ ЗДЕСЬ ВООБЩЕ
Dialogue: 0,0:12:33.65,0:12:36.69,Caption,,0,0,0,,ДРУГОЙ ПОДХОД. РОБЕРТ ФИЦО ОБЪЯВИЛ О ФИНАНСОВОЙ
Dialogue: 0,0:12:36.69,0:12:39.73,Caption,,0,0,0,,ПОМОЩИ УКРАИНЕ НА ГЕНЕРАТОРЫ И ОБУСТРОЙСТВО УКРЫТИЙ.
Dialogue: 0,0:12:39.97,0:12:43.97,Caption,,0,0,0,,НЕ РАКЕТЫ. НЕ БРОНЕТЕХНИКА. ГЕНЕРАТОРЫ И УКРЫТИЯ.
Dialogue: 0,0:12:44.22,0:12:46.29,Caption,,0,0,0,,ПЛЮС БРАТИСЛАВА СОБИРАЕТСЯ УЧАСТВОВАТЬ В
Dialogue: 0,0:12:46.29,0:12:49.25,Caption,,0,0,0,,ПОСЛЕВОЕННОМ ВОССТАНОВЛЕНИИ УКРАИНЫ. РЕЧЬ ИДЁТ ОБ
Dialogue: 0,0:12:49.25,0:12:51.89,Caption,,0,0,0,,ИНФРАСТРУКТУРНЫХ ПРОЕКТАХ И НОВЫХ АВТОМАГИСТРАЛЯХ
Dialogue: 0,0:12:51.89,0:12:54.53,Caption,,0,0,0,,МЕЖДУ УКРАИНОЙ И СЛОВАКИЕЙ. НА ПЕРВЫЙ ВЗГЛЯД
Dialogue: 0,0:12:54.53,0:12:58.53,Caption,,0,0,0,,ГЕНЕРАТОРЫ, УКРЫТИЯ И ДОРОГИ ВЫГЛЯДЯТ СКРОМНЕЕ РАКЕТ И СОТЕН
Dialogue: 0,0:12:58.53,0:13:01.25,Caption,,0,0,0,,МИЛЛИОНОВ ЕВРО. НО ИМЕННО ЗДЕСЬ ХОРОШО ВИДНО,
Dialogue: 0,0:13:01.49,0:13:04.53,Caption,,0,0,0,,НАСКОЛЬКО РАЗНОЙ БЫВАЕТ ЕВРОПЕЙСКАЯ ПОМОЩЬ. ОДНА
Dialogue: 0,0:13:04.53,0:13:07.97,Caption,,0,0,0,,СТРАНА ОБСУЖДАЕТ РАКЕТЫ ДЛЯ ПВО. ДРУГАЯ ОБЪЯВЛЯЕТ
Dialogue: 0,0:13:07.97,0:13:09.97,Caption,,0,0,0,,ВОЕННЫЙ ПАКЕТ ПОЧТИ НА ПОЛМИЛЛИАРДА.
Dialogue: 0,0:13:12.26,0:13:14.66,Caption,,0,0,0,,ТРЕТЬЯ ГОВОРИТ ГЕНЕРАТОРЫ, УКРЫТИЯ,
Dialogue: 0,0:13:14.74,0:13:17.70,Caption,,0,0,0,,ДОРОГИ И ВОССТАНОВЛЕНИЕ. И ВСЁ ЭТО ОДНОВРЕМЕННО
Dialogue: 0,0:13:17.70,0:13:20.90,Caption,,0,0,0,,НАЗЫВАЕТСЯ ПОДДЕРЖКОЙ УКРАИНЫ. ТЕПЕРЬ ВОЗВРАЩАЕМСЯ К
Dialogue: 0,0:13:20.98,0:13:23.46,Caption,,0,0,0,,МАСКУ. ПОТОМУ ЧТО ЗДЕСЬ НАЧИНАЕТСЯ СОВСЕМ
Dialogue: 0,0:13:23.46,0:13:26.18,Caption,,0,0,0,,ЗАМЕЧАТЕЛЬНАЯ ИСТОРИЯ. ЗЕЛЕНСКИЙ ЗАЯВЛЯЕТ,
Dialogue: 0,0:13:26.42,0:13:28.90,Caption,,0,0,0,,ЧТО ИЛОН МАСК НЕ ИМЕЕТ ПРАВА ВЛИЯТЬ НА
Dialogue: 0,0:13:28.98,0:13:32.34,Caption,,0,0,0,,ТО, КТО ДОЛЖЕН БЫТЬ У ВЛАСТИ НА УКРАИНЕ. АРГУМЕНТ
Dialogue: 0,0:13:32.42,0:13:35.70,Caption,,0,0,0,,ТАКОЙ МАСК ГРАЖДАНИН ДРУГОГО ГОСУДАРСТВА. ОН БОГАТ.
Dialogue: 0,0:13:36.04,0:13:38.66,Caption,,0,0,0,,У НЕГО ОГРОМНОЕ ИНФОРМАЦИОННОЕ ВЛИЯНИЕ. ОН
Dialogue: 0,0:13:38.66,0:13:40.58,Caption,,0,0,0,,ВЫСКАЗЫВАЕТСЯ О ПОЛИТИКЕ ЕВРОПЫ,
Dialogue: 0,0:13:40.66,0:13:45.86,Caption,,0,0,0,,ГЕРМАНИИ И УКРАИНЫ. ЗНАЧИТ, ДЛЯ НЕБОЛЬШИХ ГОСУДАРСТВ ТАКОЕ ВЛИЯНИЕ НЕСЁТ РИСКИ.
Dialogue: 0,0:13:46.09,0:13:49.54,Caption,,0,0,0,,ХОРОШО. ДОПУСТИМ. НО ТОГДА ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС.
Dialogue: 0,0:13:49.78,0:13:52.74,Caption,,0,0,0,,А ИНОСТРАННЫЕ ПОЛИТИКИ ИМЕЮТ ПРАВО ВЛИЯТЬ НА ТО,
Dialogue: 0,0:13:52.90,0:13:54.82,Caption,,0,0,0,,КТО ДОЛЖЕН БЫТЬ У ВЛАСТИ НА УКРАИНЕ?
Dialogue: 0,0:13:55.06,0:13:57.54,Caption,,0,0,0,,АМЕРИКАНСКИЕ СЕНАТОРЫ? ЕВРОПЕЙСКИЕ ЛИДЕРЫ?
Dialogue: 0,0:13:57.86,0:14:00.10,Caption,,0,0,0,,ПРАВИТЕЛЬСТВА СТРАН, КОТОРЫЕ ДАЮТ ДЕНЬГИ?
Dialogue: 0,0:14:00.48,0:14:03.70,Caption,,0,0,0,,ОРГАНИЗАЦИИ, КОТОРЫЕ ФИНАНСИРУЮТ УКРАИНСКОЕ ГОСУДАРСТВО?
Dialogue: 0,0:14:04.02,0:14:09.54,Caption,,0,0,0,,ГДЕ ПРОХОДИТ ЭТА ГРАНИЦА? ПОЧЕМУ МНЕНИЕ МАСКА ЭТО ОПАСНОЕ ИНОСТРАННОЕ ВЛИЯНИЕ,
Dialogue: 0,0:14:09.85,0:14:13.22,Caption,,0,0,0,,А НАДЕЖДА НА ТО, ЧТО АМЕРИКАНСКИЕ ДЕМОКРАТЫ ИЗМЕНЯТ ПОЛОЖЕНИЕ
Dialogue: 0,0:14:13.30,0:14:15.22,Caption,,0,0,0,,УКРАИНЫ, ЭТО НОРМАЛЬНАЯ ПОЛИТИКА?
Dialogue: 0,0:14:15.80,0:14:20.50,Caption,,0,0,0,,ВОПРОС ДАЖЕ НЕ В ТОМ, ПРАВ ЗЕЛЕНСКИЙ ИЛИ НЕТ. ВОПРОС В ПРИНЦИПЕ. ЕСЛИ
Dialogue: 0,0:14:20.50,0:14:23.06,Caption,,0,0,0,,УКРАИНСКУЮ ВЛАСТЬ ДОЛЖНЫ ОПРЕДЕЛЯТЬ ИСКЛЮЧИТЕЛЬНО
Dialogue: 0,0:14:23.06,0:14:26.66,Caption,,0,0,0,,УКРАИНЦЫ, ЗАМЕЧАТЕЛЬНО. ТОГДА ЭТОТ ПРИНЦИП ДОЛЖЕН РАБОТАТЬ ДЛЯ
Dialogue: 0,0:14:26.66,0:14:30.86,Caption,,0,0,0,,ВСЕХ. А НЕ ТОЛЬКО ДЛЯ ИЛОНА МАСКА,
Dialogue: 0,0:14:31.03,0:14:33.82,Caption,,0,0,0,,КОГДА ОН ГОВОРИТ ЧТО ТО НЕПРИЯТНОЕ. И ДАЛЬШЕ
Dialogue: 0,0:14:33.82,0:14:36.78,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ИДЁТ ЕЩЁ ДАЛЬШЕ. БОЛЬШАЯ КОНЦЕНТРАЦИЯ
Dialogue: 0,0:14:36.78,0:14:39.74,Caption,,0,0,0,,ВЛАСТИ У ОДНОГО БОГАТОГО ЧЕЛОВЕКА ОПАСНА. ВООБЩЕ
Dialogue: 0,0:14:39.74,0:14:42.94,Caption,,0,0,0,,КОНЦЕНТРАЦИЯ ВЛАСТИ У ОДНОГО ЧЕЛОВЕКА ОПАСНА. И ТУТ
Dialogue: 0,0:14:42.94,0:14:45.74,Caption,,0,0,0,,УЖЕ СОВСЕМ ТРУДНО УДЕРЖАТЬСЯ. СОБСТВЕННЫМ СОВЕТАМ
Dialogue: 0,0:14:45.74,0:14:50.14,Caption,,0,0,0,,ПРИСЛУШАТЬСЯ НЕ ХОЧЕШЬ? ПОТОМУ ЧТО СО СТОРОНЫ ВЫГЛЯДИТ ЗАБАВНО. ВЫБОРОВ НЕТ.
Dialogue: 0,0:14:50.39,0:14:53.58,Caption,,0,0,0,,НОВЫЙ СПОСОБ ГОЛОСОВАНИЯ ТОЛЬКО ОБСУЖДАЕТСЯ. ПРИЧИНЫ
Dialogue: 0,0:14:53.66,0:14:56.06,Caption,,0,0,0,,НЕ ПРОВОДИТЬ ГОЛОСОВАНИЕ ПЕРЕЧИСЛЯЮТСЯ ОДНА ЗА
Dialogue: 0,0:14:56.06,0:14:59.02,Caption,,0,0,0,,ДРУГОЙ. А ЧЕЛОВЕК, КОТОРЫЙ ВСЁ ЭТО ОБЪЯСНЯЕТ,
Dialogue: 0,0:14:59.26,0:15:01.66,Caption,,0,0,0,,ОДНОВРЕМЕННО ЧИТАЕТ МАСКУ ЛЕКЦИЮ О РАЗДЕЛЕНИИ
Dialogue: 0,0:15:01.66,0:15:05.34,Caption,,0,0,0,,ВЛАСТИ. ДА ЛАДНО? ПРИЧЁМ ОН ЕЩЁ ГОВОРИТ ОЧЕНЬ ПРАВИЛЬНУЮ ВЕЩЬ ДАЖЕ
Dialogue: 0,0:15:05.34,0:15:10.06,Caption,,0,0,0,,НЕПРАВИЛЬНЫЙ ВЫБОР ЛУЧШЕ, ЧЕМ НАВЯЗАННЫЙ. ТАК ПРОВЕДИТЕ ВЫБОР. ПОКАЖИТЕ ЭТОТ
Dialogue: 0,0:15:10.06,0:15:13.02,Caption,,0,0,0,,ПРИНЦИП НА ПРАКТИКЕ. ИЛИ ОН РАБОТАЕТ ТОЛЬКО ТОГДА,
Dialogue: 0,0:15:13.18,0:15:14.94,Caption,,0,0,0,,КОГДА РЕЧЬ ИДЁТ О ДРУГОМ ЧЕЛОВЕКЕ?
Dialogue: 0,0:15:15.17,0:15:17.82,Caption,,0,0,0,,НО ЗДЕСЬ ЗЕЛЕНСКОМУ ПРИХОДИТСЯ СЧИТАТЬСЯ ЕЩЁ С ОДНОЙ
Dialogue: 0,0:15:17.82,0:15:20.78,Caption,,0,0,0,,КРАЙНЕ НЕПРИЯТНОЙ ДЕТАЛЬЮ. МАСК ЭТО НЕ ПРОСТО
Dialogue: 0,0:15:20.78,0:15:24.62,Caption,,0,0,0,,БОГАТЫЙ ЧЕЛОВЕК, КОТОРЫЙ ПИШЕТ ПОСТЫ В СОЦИАЛЬНОЙ СЕТИ. ЗА НИМ
Dialogue: 0,0:15:24.62,0:15:28.38,Caption,,0,0,0,,SPACEX. А ЗА SPACEX STARLINK И STARSHIELD. И
Dialogue: 0,0:15:28.46,0:15:30.70,Caption,,0,0,0,,ВОТ ЗДЕСЬ РАЗГОВОР О ЧУЖОМ ВЛИЯНИИ ВНЕЗАПНО
Dialogue: 0,0:15:30.70,0:15:33.66,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В ВОПРОС ОЧЕНЬ КОНКРЕТНОЙ ЗАВИСИМОСТИ.
Dialogue: 0,0:15:35.93,0:15:38.09,Caption,,0,0,0,,УКРАИНСКИЙ КОНТРАКТ НА ИСПОЛЬЗОВАНИЕ ВОЕННОЙ
Dialogue: 0,0:15:38.09,0:15:40.57,Caption,,0,0,0,,СПУТНИКОВОЙ СЕТИ STARSHIELD ЧЕРЕЗ АМЕРИКАНСКОЕ
Dialogue: 0,0:15:40.57,0:15:43.45,Caption,,0,0,0,,ПРАВИТЕЛЬСТВО ЗАКАНЧИВАЕТСЯ В СЕРЕДИНЕ ДВЕ ТЫСЯЧИ
Dialogue: 0,0:15:43.45,0:15:46.41,Caption,,0,0,0,,ДВАДЦАТЬ СЕДЬМОГО ГОДА. КИЕВ УЖЕ ХОЧЕТ НАЧИНАТЬ
Dialogue: 0,0:15:46.41,0:15:49.93,Caption,,0,0,0,,ПЕРЕГОВОРЫ О ПРОДЛЕНИИ. НЕ ЧЕРЕЗ ГОД. СЕЙЧАС. ПОТОМУ
Dialogue: 0,0:15:50.01,0:15:52.33,Caption,,0,0,0,,ЧТО НОВЫЙ ДОГОВОР НАДО СОГЛАСОВАТЬ ЗАРАНЕЕ.
Dialogue: 0,0:15:52.73,0:15:55.29,Caption,,0,0,0,,УКРАИНСКИЙ ДИПЛОМАТ ДЕНИС СЕНИК ПРЯМО ГОВОРИТ,
Dialogue: 0,0:15:55.54,0:15:59.45,Caption,,0,0,0,,ЧТО КИЕВУ НУЖНО ПОНИМАТЬ, СМОГУТ ЛИ ОНИ ПРОДОЛЖАТЬ РАБОТУ И НА КАКИХ
Dialogue: 0,0:15:59.45,0:16:01.45,Caption,,0,0,0,,УСЛОВИЯХ. А ПОЧЕМУ ТАКАЯ СПЕШКА?
Dialogue: 0,0:16:02.01,0:16:04.09,Caption,,0,0,0,,ПОТОМУ ЧТО НЕДАВНЯЯ ИСТОРИЯ С ОГРАНИЧЕНИЯМИ
Dialogue: 0,0:16:04.09,0:16:08.33,Caption,,0,0,0,,STARSHIELD ПОКАЗАЛА, НАСКОЛЬКО ВСЁ ЭТО ЧУВСТВИТЕЛЬНО. УКРАИНСКАЯ СТОРОНА
Dialogue: 0,0:16:08.33,0:16:11.21,Caption,,0,0,0,,ПЫТАЛАСЬ ПОЛУЧИТЬ ОБЪЯСНЕНИЯ ОТ ПЕНТАГОНА. ОТ БЕЛОГО
Dialogue: 0,0:16:11.21,0:16:14.41,Caption,,0,0,0,,ДОМА. ОТ SPACEX. ОТВЕТА, ПО ДАННЫМ REUTERS,
Dialogue: 0,0:16:14.72,0:16:17.93,Caption,,0,0,0,,НЕ ПОЛУЧИЛА. ПРЕКРАСНАЯ РОМАШКА. РАБОТАЕТ. НЕ
Dialogue: 0,0:16:17.93,0:16:21.29,Caption,,0,0,0,,РАБОТАЕТ. ОГРАНИЧИЛИ. СНЯЛИ ОГРАНИЧЕНИЕ. КТО
Dialogue: 0,0:16:21.29,0:16:26.33,Caption,,0,0,0,,ОГРАНИЧИЛ? НЕ ЗНАЕМ. ПОЧЕМУ? НЕ ОБЪЯСНЯЕМ. А СИСТЕМА ПРИ ЭТОМ ИСПОЛЬЗУЕТСЯ В
Dialogue: 0,0:16:26.33,0:16:29.13,Caption,,0,0,0,,ВОЕННЫХ ОПЕРАЦИЯХ. ВОТ ВАМ И ВОПРОС О ВЛАСТИ.
Dialogue: 0,0:16:29.61,0:16:31.21,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО РАССУЖДАТЬ,
Dialogue: 0,0:16:31.37,0:16:34.01,Caption,,0,0,0,,ИМЕЕТ МАСК ПРАВО ВЛИЯТЬ НА УКРАИНСКУЮ ПОЛИТИКУ ИЛИ
Dialogue: 0,0:16:34.09,0:16:36.97,Caption,,0,0,0,,НЕ ИМЕЕТ. НО ЕСЛИ УКРАИНА ЗАВИСИТ ОТ СОЗДАННОЙ
Dialogue: 0,0:16:37.05,0:16:41.45,Caption,,0,0,0,,ЕГО КОМПАНИЕЙ ИНФРАСТРУКТУРЫ, ВЛИЯНИЕ ВОЗНИКАЕТ УЖЕ НЕ ИЗ ПОСТОВ В ИНТЕРНЕТЕ.
Dialogue: 0,0:16:41.66,0:16:44.81,Caption,,0,0,0,,ОНО ВОЗНИКАЕТ ИЗ САМОЙ ТЕХНОЛОГИИ. СВЯЗЬ ЕСТЬ,
Dialogue: 0,0:16:44.97,0:16:49.61,Caption,,0,0,0,,ОДНИ ВОЗМОЖНОСТИ. СВЯЗИ НЕТ, СОВСЕМ ДРУГИЕ. И ТЕПЕРЬ ЕЩЁ ОДНА ДЕТАЛЬ.
Dialogue: 0,0:16:51.90,0:16:55.10,Caption,,0,0,0,,МАСК ПОДДЕРЖАЛ ПУБЛИКАЦИЮ, АВТОР КОТОРОЙ НАПИСАЛ,
Dialogue: 0,0:16:55.33,0:16:58.62,Caption,,0,0,0,,ЧТО SPACEX ЗРЯ ОТПРАВИЛА УКРАИНЕ ТЫСЯЧИ БЕСПЛАТНЫХ
Dialogue: 0,0:16:58.62,0:17:01.18,Caption,,0,0,0,,ТЕРМИНАЛОВ STARLINK В НАЧАЛЕ КОНФЛИКТА И
Dialogue: 0,0:17:01.18,0:17:03.82,Caption,,0,0,0,,ПРЕДОСТАВЛЯЛА СВЯЗЬ НА МИЛЛИОНЫ ДОЛЛАРОВ В МЕСЯЦ.
Dialogue: 0,0:17:04.13,0:17:06.86,Caption,,0,0,0,,САМ МАСК ЭТИХ СЛОВ НЕ ПИСАЛ. НО ПОДДЕРЖАЛ
Dialogue: 0,0:17:06.94,0:17:09.82,Caption,,0,0,0,,И РАСПРОСТРАНИЛ ПУБЛИКАЦИЮ С ТАКОЙ ОЦЕНКОЙ. А ТАМ
Dialogue: 0,0:17:09.90,0:17:13.02,Caption,,0,0,0,,ЛОГИКА СЛЕДУЮЩАЯ. ИЗНАЧАЛЬНО STARLINK ДАВАЛИ КАК
Dialogue: 0,0:17:13.10,0:17:16.14,Caption,,0,0,0,,СВЯЗЬ ДЛЯ ГРАЖДАНСКОГО НАСЕЛЕНИЯ. ПОТОМ СПУТНИКОВАЯ
Dialogue: 0,0:17:16.14,0:17:18.38,Caption,,0,0,0,,СИСТЕМА СТАЛА ВАЖНЕЙШЕЙ ЧАСТЬЮ ВОЕННОЙ
Dialogue: 0,0:17:18.38,0:17:21.90,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ, В ТОМ ЧИСЛЕ ДЛЯ БЕСПИЛОТНИКОВ. А ТЕПЕРЬ,
Dialogue: 0,0:17:22.11,0:17:24.78,Caption,,0,0,0,,КОГДА КОМПАНИЯ НЕ ХОЧЕТ ПОДДЕРЖИВАТЬ ОПРЕДЕЛЁННЫЕ
Dialogue: 0,0:17:24.86,0:17:26.94,Caption,,0,0,0,,ВИДЫ ВОЕННОГО ПРИМЕНЕНИЯ СВОЕЙ СИСТЕМЫ,
Dialogue: 0,0:17:27.24,0:17:29.97,Caption,,0,0,0,,ЕЁ ЗА ЭТО НАЧИНАЮТ АТАКОВАТЬ ПУБЛИЧНО. И ВОТ
Dialogue: 0,0:17:29.97,0:17:33.02,Caption,,0,0,0,,ТЕПЕРЬ ПОСТАВЬТЕ РЯДОМ ДВЕ ФРАЗЫ. ЗЕЛЕНСКИЙ ГОВОРИТ
Dialogue: 0,0:17:33.02,0:17:35.34,Caption,,0,0,0,,МАСК НЕ ИМЕЕТ ПРАВА ВЛИЯТЬ НА ТО,
Dialogue: 0,0:17:35.44,0:17:38.54,Caption,,0,0,0,,КТО ДОЛЖЕН УПРАВЛЯТЬ УКРАИНОЙ. А УКРАИНСКИЕ ВЛАСТИ
Dialogue: 0,0:17:38.54,0:17:40.70,Caption,,0,0,0,,ОДНОВРЕМЕННО ХОТЯТ ЗАРАНЕЕ ДОГОВАРИВАТЬСЯ О
Dialogue: 0,0:17:40.78,0:17:44.06,Caption,,0,0,0,,ПРОДЛЕНИИ ДОСТУПА К СИСТЕМЕ, СОЗДАННОЙ КОМПАНИЕЙ МАСКА,
Dialogue: 0,0:17:44.30,0:17:46.86,Caption,,0,0,0,,ПОТОМУ ЧТО ОНА НУЖНА ДЛЯ ВОЕННЫХ ЗАДАЧ. ВОТ
Dialogue: 0,0:17:46.94,0:17:49.49,Caption,,0,0,0,,ВАМ И ВСЯ БОЛЬШАЯ ПОЛИТИКА. КОГДА ЧЕЛОВЕК ПИШЕТ
Dialogue: 0,0:17:49.58,0:17:53.34,Caption,,0,0,0,,НЕПРИЯТНЫЙ ПОСТ, ОН ИНОСТРАННЫЙ ГРАЖДАНИН И НЕЧЕГО ЕМУ ВМЕШИВАТЬСЯ.
Dialogue: 0,0:17:53.64,0:17:55.42,Caption,,0,0,0,,КОГДА ЕГО СПУТНИКИ НУЖНЫ АРМИИ,
Dialogue: 0,0:17:55.59,0:17:58.14,Caption,,0,0,0,,СРОЧНО НАДО ВЫЯСНИТЬ УСЛОВИЯ СОТРУДНИЧЕСТВА НА
Dialogue: 0,0:17:58.14,0:18:01.18,Caption,,0,0,0,,СЛЕДУЮЩИЙ ГОД. ПРИЧЁМ ДЕМОКРАТЫ В США УЖЕ ГОТОВЯТСЯ
Dialogue: 0,0:18:01.18,0:18:03.82,Caption,,0,0,0,,РАЗБИРАТЬСЯ, КТО И ПОЧЕМУ ОГРАНИЧИВАЛ STARSHIELD.
Dialogue: 0,0:18:06.08,0:18:08.80,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ТАКОЙ ЗАМЕЧАТЕЛЬНЫЙ УЗЕЛ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:18:08.80,0:18:11.84,Caption,,0,0,0,,НАДЕЕТСЯ НА ДЕМОКРАТОВ. ДЕМОКРАТЫ ДАВЯТ НА МАСКА.
Dialogue: 0,0:18:12.08,0:18:14.96,Caption,,0,0,0,,ЗЕЛЕНСКИЙ КРИТИКУЕТ МАСКА. МАСК ПОДДЕРЖИВАЕТ
Dialogue: 0,0:18:14.96,0:18:18.88,Caption,,0,0,0,,ПУБЛИКАЦИЮ О ТОМ, ЧТО ДАВАТЬ УКРАИНЕ БЕСПЛАТНУЮ СПУТНИКОВУЮ СВЯЗЬ БЫЛО
Dialogue: 0,0:18:18.88,0:18:21.68,Caption,,0,0,0,,ОШИБКОЙ. А УКРАИНА В ЭТО ВРЕМЯ ПЫТАЕТСЯ ПОНЯТЬ,
Dialogue: 0,0:18:21.84,0:18:24.16,Caption,,0,0,0,,ОСТАНЕТСЯ ЛИ У НЕЁ STARSHIELD ПОСЛЕ СЕРЕДИНЫ
Dialogue: 0,0:18:24.16,0:18:28.40,Caption,,0,0,0,,СЛЕДУЮЩЕГО ГОДА. И ВОТ ЗДЕСЬ ВОЗНИКАЕТ НЕПРИЯТНАЯ ДЛЯ КИЕВА СИТУАЦИЯ.
Dialogue: 0,0:18:28.69,0:18:31.20,Caption,,0,0,0,,ЧЕМ БОЛЬШЕ ВНЕШНЯЯ ПОДДЕРЖКА СТАНОВИТСЯ ЧАСТЬЮ
Dialogue: 0,0:18:31.20,0:18:33.44,Caption,,0,0,0,,ПОВСЕДНЕВНОЙ РАБОТЫ ГОСУДАРСТВА И АРМИИ,
Dialogue: 0,0:18:33.75,0:18:36.32,Caption,,0,0,0,,ТЕМ СЛОЖНЕЕ ОТДЕЛЯТЬ ОБЫЧНОЕ СОТРУДНИЧЕСТВО ОТ
Dialogue: 0,0:18:36.32,0:18:39.44,Caption,,0,0,0,,ПОЛИТИЧЕСКОГО ВЛИЯНИЯ. ПРИЧЁМ РЕЧЬ НЕ ОБЯЗАТЕЛЬНО О
Dialogue: 0,0:18:39.44,0:18:42.16,Caption,,0,0,0,,ПРЯМЫХ ПРИКАЗАХ. ИНОГДА ДОСТАТОЧНО РЕШЕНИЯ О
Dialogue: 0,0:18:42.24,0:18:45.84,Caption,,0,0,0,,ПОСТАВКАХ, ДОСТУПЕ К СВЯЗИ ИЛИ УСЛОВИЯХ НОВОГО ДОГОВОРА,
Dialogue: 0,0:18:46.02,0:18:48.48,Caption,,0,0,0,,ЧТОБЫ ВНУТРИ СТРАНЫ ПРИШЛОСЬ МЕНЯТЬ СОБСТВЕННЫЕ
Dialogue: 0,0:18:48.48,0:18:51.28,Caption,,0,0,0,,ПЛАНЫ. И ИМЕННО ЭТО ДЕЛАЕТ СПОР ЗЕЛЕНСКОГО С
Dialogue: 0,0:18:51.36,0:18:54.00,Caption,,0,0,0,,МАСКОМ ГОРАЗДО СЕРЬЁЗНЕЕ ОБЫЧНОЙ ПЕРЕПАЛКИ ДВУХ
Dialogue: 0,0:18:54.08,0:18:57.76,Caption,,0,0,0,,ИЗВЕСТНЫХ ЛЮДЕЙ. ЕСЛИ УКРАИНА НАСТОЛЬКО ЗАВИСИТ ОТ РЕШЕНИЙ
Dialogue: 0,0:18:57.76,0:18:59.92,Caption,,0,0,0,,ВАШИНГТОНА, ЕВРОПЕЙСКИХ ДЕНЕГ,
Dialogue: 0,0:19:00.16,0:19:02.56,Caption,,0,0,0,,ИНОСТРАННЫХ ВООРУЖЕНИЙ И ЧАСТНОЙ СПУТНИКОВОЙ
Dialogue: 0,0:19:02.56,0:19:06.40,Caption,,0,0,0,,ИНФРАСТРУКТУРЫ, ТО ГДЕ ЗАКАНЧИВАЕТСЯ ПОМОЩЬ И НАЧИНАЕТСЯ ВЛИЯНИЕ?
Dialogue: 0,0:19:06.88,0:19:09.12,Caption,,0,0,0,,ПОТОМУ ЧТО ЗАЯВИТЬ "НЕ ВМЕШИВАЙТЕСЬ В НАШИ ДЕЛА"
Dialogue: 0,0:19:09.20,0:19:12.08,Caption,,0,0,0,,ОЧЕНЬ ЛЕГКО. ГОРАЗДО СЛОЖНЕЕ СКАЗАТЬ ЭТО ТЕМ,
Dialogue: 0,0:19:12.24,0:19:16.88,Caption,,0,0,0,,ОТ ЧЬИХ ДЕНЕГ, РАКЕТ, СПУТНИКОВ И ПОЛИТИЧЕСКИХ РЕШЕНИЙ ТЫ ЗАВИСИШЬ КАЖДЫЙ
Dialogue: 0,0:19:16.96,0:19:17.20,Caption,,0,0,0,,ДЕНЬ.
