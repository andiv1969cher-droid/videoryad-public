Dialogue: 0,0:00:00.12,0:00:02.04,Caption,,0,0,0,,В КИЕВЕ ТЕПЕРЬ СПОРЯТ УЖЕ НЕ О ТОМ,
Dialogue: 0,0:00:02.13,0:00:07.48,Caption,,0,0,0,,БУДЕТ СВЕТ ИЛИ НЕТ. СПОРЯТ, СКОЛЬКО СУТОК ЕГО НЕ БУДЕТ. ОДИН ЭКСПЕРТ ГОВОРИТ
Dialogue: 0,0:00:07.60,0:00:12.68,Caption,,0,0,0,,ПОЛТОРА ДНЯ. ДРУГОЙ, ДО ПЯТИ. ХОРОШАЯ АРИФМЕТИКА. ТОЛЬКО КОГДА РЕЧЬ УЖЕ
Dialogue: 0,0:00:12.68,0:00:17.24,Caption,,0,0,0,,ИДЁТ НЕ О ЧАСАХ, А О СУТКАХ, ВОПРОС СТАНОВИТСЯ СОВСЕМ ДРУГИМ А ГДЕ У ЭТОЙ
Dialogue: 0,0:00:17.32,0:00:21.48,Caption,,0,0,0,,ИСТОРИИ ВООБЩЕ ПРЕДЕЛ? ЕСЛИ ВАМ ИНТЕРЕСЕН ТАКОЙ РАЗБОР БЕЗ ДИПЛОМАТИЧЕСКОЙ
Dialogue: 0,0:00:21.56,0:00:24.36,Caption,,0,0,0,,ВАТЫ, ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:24.52,0:00:26.84,Caption,,0,0,0,,КОГДА ОДНА НОВОСТЬ БЕЗ ДРУГОЙ ВООБЩЕ МАЛО ЧТО
Dialogue: 0,0:00:26.92,0:00:29.72,Caption,,0,0,0,,ОБЪЯСНЯЕТ. В КИЕВЕ УЖЕ РАЗВОРАЧИВАЮТ ПУНКТЫ
Dialogue: 0,0:00:29.80,0:00:31.88,Caption,,0,0,0,,ОБОГРЕВА. НАЧАЛИСЬ ПЕРЕБОИ С ВОДОЙ,
Dialogue: 0,0:00:32.19,0:00:35.08,Caption,,0,0,0,,ВОЗНИКЛИ ПРОБЛЕМЫ С ЭЛЕКТРОТРАНСПОРТОМ. В НЕКОТОРЫХ
Dialogue: 0,0:00:35.08,0:00:36.92,Caption,,0,0,0,,РАЙОНАХ СВЕТ ПРОПАДАЛ НА ЧЕТЫРЕ,
Dialogue: 0,0:00:37.00,0:00:40.44,Caption,,0,0,0,,ПЯТЬ СУТОК, ПОЯВЛЯЛСЯ БУКВАЛЬНО НА СЧИТАНЫЕ МИНУТЫ И СНОВА
Dialogue: 0,0:00:40.52,0:00:43.16,Caption,,0,0,0,,ИСЧЕЗАЛ. ПЛАНОВЫЕ ГРАФИКИ В ТАКОЙ СИТУАЦИИ
Dialogue: 0,0:00:43.16,0:00:45.88,Caption,,0,0,0,,ПРЕВРАЩАЮТСЯ В ДОВОЛЬНО СТРАННЫЙ ЖАНР ЛИТЕРАТУРЫ.
Dialogue: 0,0:00:46.16,0:00:48.84,Caption,,0,0,0,,ОНИ ВРОДЕ ЕСТЬ. ТОЛЬКО ЭЛЕКТРИЧЕСТВО О НИХ,
Dialogue: 0,0:00:48.92,0:00:51.00,Caption,,0,0,0,,СУДЯ ПО ВСЕМУ, НИКТО НЕ ПРЕДУПРЕДИЛ.
Dialogue: 0,0:00:51.70,0:00:54.04,Caption,,0,0,0,,НА ЭТОМ ФОНЕ ЖИТЕЛИ НАЧАЛИ ВЫХОДИТЬ НА УЛИЦЫ
Dialogue: 0,0:00:54.12,0:00:56.68,Caption,,0,0,0,,И ПЕРЕКРЫВАТЬ ДОРОГИ. И ВОТ ЭТО УЖЕ ВАЖНЫЙ
Dialogue: 0,0:00:56.68,0:01:00.60,Caption,,0,0,0,,ПОВОРОТ. НЕ ПОТОМУ, ЧТО КТО ТО ВПЕРВЫЕ ВОЗМУТИЛСЯ ОТКЛЮЧЕНИЯМИ.
Dialogue: 0,0:01:00.76,0:01:06.15,Caption,,0,0,0,,ВОЗМУЩАЛИСЬ И РАНЬШЕ. НО КОГДА ЧЕЛОВЕК НЕСКОЛЬКО СУТОК СИДИТ БЕЗ
Dialogue: 0,0:01:06.15,0:01:09.83,Caption,,0,0,0,,НОРМАЛЬНОГО СВЕТА, А ПОТОМ ВЫХОДИТ ИЗ КВАРТИРЫ И ИДЁТ ПЕРЕКРЫВАТЬ
Dialogue: 0,0:01:09.91,0:01:13.59,Caption,,0,0,0,,ДВИЖЕНИЕ, ЗНАЧИТ ВНУТРИ СИСТЕМЫ УЖЕ НАКОПИЛОСЬ ДОСТАТОЧНО
Dialogue: 0,0:01:13.59,0:01:17.35,Caption,,0,0,0,,НАПРЯЖЕНИЯ, ЧТОБЫ БЫТОВАЯ ПРОБЛЕМА ПОЛЕЗЛА НАРУЖУ. ПРИЧЁМ
Dialogue: 0,0:01:17.35,0:01:20.47,Caption,,0,0,0,,ПРОИЗОШЛО ЭТО ЕЩЁ ДО НОРМАЛЬНЫХ ЗИМНИХ МОРОЗОВ. И
Dialogue: 0,0:01:20.47,0:01:23.19,Caption,,0,0,0,,ВОТ ЗДЕСЬ НАЧИНАЕТСЯ САМОЕ ИНТЕРЕСНОЕ В ЦИФРАХ.
Dialogue: 0,0:01:23.48,0:01:25.91,Caption,,0,0,0,,ДИРЕКТОР ЦЕНТРА ИССЛЕДОВАНИЙ ЭНЕРГЕТИКИ АЛЕКСАНДР
Dialogue: 0,0:01:25.99,0:01:29.91,Caption,,0,0,0,,ХАРЧЕНКО ГОВОРИТ, ЧТО ВСЯ ГЕНЕРАЦИЯ КИЕВСКИХ ТЭЦ УНИЧТОЖЕНА
Dialogue: 0,0:01:29.91,0:01:32.39,Caption,,0,0,0,,ОБСТРЕЛАМИ. ВОССТАНОВИТЬ, ПО ЕГО ОЦЕНКЕ,
Dialogue: 0,0:01:32.55,0:01:37.19,Caption,,0,0,0,,УДАСТСЯ МАКСИМУМ ДЕСЯТЬ, ПЯТНАДЦАТЬ ПРОЦЕНТОВ. А СТОЛИЦА ПРИ ТЯЖЁЛОМ СЦЕНАРИИ
Dialogue: 0,0:01:37.27,0:01:39.91,Caption,,0,0,0,,МОЖЕТ ОСТАВАТЬСЯ БЕЗ ЭЛЕКТРИЧЕСТВА ДО ПОЛУТОРА СУТОК
Dialogue: 0,0:01:39.91,0:01:43.03,Caption,,0,0,0,,ПОДРЯД. ПОЛТОРА СУТОК. ЭТО УЖЕ НЕ ИСТОРИЯ ПРО
Dialogue: 0,0:01:43.11,0:01:45.75,Caption,,0,0,0,,ВЕЧЕР СО СВЕЧКОЙ. ЭТО УЖЕ СОВСЕМ ДРУГОЙ РЕЖИМ
Dialogue: 0,0:01:45.75,0:01:48.39,Caption,,0,0,0,,РАБОТЫ ГОРОДА. НО ДАЛЬШЕ ВЫХОДИТ ГЛАВА СОЮЗА
Dialogue: 0,0:01:48.39,0:01:51.11,Caption,,0,0,0,,ПОТРЕБИТЕЛЕЙ КОММУНАЛЬНЫХ УСЛУГ УКРАИНЫ ОЛЕГ ПОПЕНКО
Dialogue: 0,0:01:51.23,0:01:54.31,Caption,,0,0,0,,И ПОДНИМАЕТ СТАВКУ ЕЩЁ ВЫШЕ. ПРИ МОРОЗАХ ДАЖЕ
Dialogue: 0,0:01:54.31,0:01:56.63,Caption,,0,0,0,,ОКОЛО МИНУС ПЯТИ ГРАДУСОВ ОН ГОВОРИТ УЖЕ НЕ
Dialogue: 0,0:01:56.71,0:02:01.67,Caption,,0,0,0,,О ПОЛУТОРА СУТКАХ, А О ТРЁХ, ПЯТИ СУТКАХ БЕЗ СВЕТА. ЭЛЕКТРИЧЕСТВО ПРИ ТАКОМ
Dialogue: 0,0:02:01.67,0:02:03.67,Caption,,0,0,0,,СЦЕНАРИИ МОГУТ ДАВАТЬ НА ПОЛЧАСА,
Dialogue: 0,0:02:03.75,0:02:06.63,Caption,,0,0,0,,НА ЧАС. ТО ЕСТЬ СПОР ТЕПЕРЬ ВЫГЛЯДИТ ЗАМЕЧАТЕЛЬНО.
Dialogue: 0,0:02:06.87,0:02:10.23,Caption,,0,0,0,,ПОЛТОРА ДНЯ ИЛИ ПЯТЬ. ПРЯМО ЧУВСТВУЕТСЯ ПРОСТОР ДЛЯ
Dialogue: 0,0:02:10.23,0:02:12.71,Caption,,0,0,0,,ОПТИМИЗМА. И ДЕЛО ЗДЕСЬ НЕ ТОЛЬКО В КОЛИЧЕСТВЕ
Dialogue: 0,0:02:12.79,0:02:18.68,Caption,,0,0,0,,РАЗБИТЫХ ОБЪЕКТОВ. КИЕВ ГОДАМИ ЖИЛ С КРУПНОЙ СОБСТВЕННОЙ ГЕНЕРАЦИЕЙ.
Dialogue: 0,0:02:19.00,0:02:21.56,Caption,,0,0,0,,ТЕПЕРЬ ЗНАЧИТЕЛЬНУЮ ЧАСТЬ НЕОБХОДИМЫХ ОБЪЁМОВ НАДО
Dialogue: 0,0:02:21.56,0:02:24.51,Caption,,0,0,0,,ЗАТЯГИВАТЬ В СТОЛИЦУ ИЗВНЕ. А ПЕРЕДАТЬ ОГРОМНУЮ
Dialogue: 0,0:02:24.51,0:02:27.79,Caption,,0,0,0,,МОЩНОСТЬ В ОДИН МЕГАПОЛИС ТОЖЕ НАДО ЧЕРЕЗ КОНКРЕТНЫЕ
Dialogue: 0,0:02:27.88,0:02:31.07,Caption,,0,0,0,,СЕТИ, КОНКРЕТНЫЕ ПОДСТАНЦИИ И КОНКРЕТНЫЕ ЛИНИИ.
Dialogue: 0,0:02:31.87,0:02:36.51,Caption,,0,0,0,,КОГДА УДАРЫ ИДУТ ПОВТОРНО, РЕМОНТ НАЧИНАЕТ НАПОМИНАТЬ ОЧЕНЬ НЕХОРОШУЮ ИГРУ.
Dialogue: 0,0:02:36.83,0:02:40.60,Caption,,0,0,0,,ПОЧИНИЛИ. ЗАПУСТИЛИ. ПОЛУЧИЛИ НОВЫЙ УДАР. ПОЕХАЛИ
Dialogue: 0,0:02:40.60,0:02:43.40,Caption,,0,0,0,,СНОВА. МЫ УЖЕ ВИДЕЛИ ПОХОЖУЮ ЛОГИКУ НА ПРИМЕРЕ
Dialogue: 0,0:02:43.40,0:02:46.52,Caption,,0,0,0,,ДРУГИХ УКРАИНСКИХ ГОРОДОВ. КОНОТОП В ЭТОМ СМЫСЛЕ БЫЛ
Dialogue: 0,0:02:46.52,0:02:49.24,Caption,,0,0,0,,ХОРОШИМ ПРЕДУПРЕЖДЕНИЕМ. ГОРОД ОЧЕНЬ БЫСТРО
Dialogue: 0,0:02:49.24,0:02:52.44,Caption,,0,0,0,,ПЕРЕХОДИТ ИЗ ОБЫЧНОЙ ЖИЗНИ В АВАРИЙНЫЙ РЕЖИМ. ПРИЧЁМ
Dialogue: 0,0:02:52.44,0:02:56.76,Caption,,0,0,0,,ПЕРЕХОД ПРОИСХОДИТ БЫСТРЕЕ, ЧЕМ ЛЮДИ УСПЕВАЮТ К НЕМУ ПСИХОЛОГИЧЕСКИ ПРИВЫКНУТЬ.
Dialogue: 0,0:02:57.08,0:03:02.04,Caption,,0,0,0,,И ЗДЕСЬ ВАЖНА ЕЩЁ ОДНА ВЕЩЬ, О КОТОРОЙ ОБЫЧНО ВСПОМИНАЮТ В ПОСЛЕДНЮЮ ОЧЕРЕДЬ. ВСЁ
Dialogue: 0,0:03:02.12,0:03:05.24,Caption,,0,0,0,,ЭТО ВОССТАНАВЛИВАЮТ ЖИВЫЕ ЛЮДИ. НЕ ВОЛШЕБНЫЕ РОБОТЫ
Dialogue: 0,0:03:05.32,0:03:08.20,Caption,,0,0,0,,ИЗ ТЕЛЕВИЗОРА. ЭНЕРГЕТИКИ, РЕМОНТНИКИ,
Dialogue: 0,0:03:08.28,0:03:12.92,Caption,,0,0,0,,ИНЖЕНЕРЫ, МОНТАЖНИКИ. И КАЖДЫЙ НОВЫЙ ЦИКЛ РАЗРУШЕНИЯ ОЗНАЧАЕТ,
Dialogue: 0,0:03:13.15,0:03:15.96,Caption,,0,0,0,,ЧТО ЭТИМ ЖЕ ЛЮДЯМ СНОВА НАДО ЕХАТЬ ТУДА,
Dialogue: 0,0:03:16.04,0:03:20.84,Caption,,0,0,0,,ГДЕ НЕДАВНО УЖЕ РАБОТАЛИ. ВОТ ТОЛЬКО ЛЮДИ НЕ БЕСКОНЕЧНЫЙ РАСХОДНЫЙ МАТЕРИАЛ
Dialogue: 0,0:03:20.84,0:03:24.12,Caption,,0,0,0,,ИНЖЕНЕРНОЙ СХЕМЫ. ЕСЛИ КАНАЛ ВАМ ЕЩЁ НЕ НАДОЕЛ,
Dialogue: 0,0:03:24.26,0:03:27.40,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ДАЛЬШЕ ЦИФРЫ СТАНОВЯТСЯ ЕЩЁ
Dialogue: 0,0:03:27.40,0:03:32.22,Caption,,0,0,0,,ВЕСЕЛЕЕ. УКРАИНСКАЯ РАЗВЕДКА ОЦЕНИВАЕТ РОССИЙСКОЕ
Dialogue: 0,0:03:32.22,0:03:34.86,Caption,,0,0,0,,ПРОИЗВОДСТВО РАКЕТ БОЛЕЕ ЧЕМ В ДВЕСТИ ЕДИНИЦ В
Dialogue: 0,0:03:34.94,0:03:39.34,Caption,,0,0,0,,МЕСЯЦ. И ЭТО УЖЕ ТОТ МАСШТАБ, КОТОРЫЙ НАДО СТАВИТЬ РЯДОМ С ЭНЕРГЕТИЧЕСКИМ
Dialogue: 0,0:03:39.34,0:03:41.50,Caption,,0,0,0,,КРИЗИСОМ. ПО ОЗВУЧЕННЫМ ОЦЕНКАМ,
Dialogue: 0,0:03:41.74,0:03:44.46,Caption,,0,0,0,,В РОССИЙСКОМ АРСЕНАЛЕ ОКОЛО СЕМИСОТ БАЛЛИСТИЧЕСКИХ
Dialogue: 0,0:03:44.46,0:03:47.82,Caption,,0,0,0,,РАКЕТ И ТЫСЯЧИ КРЫЛАТЫХ. ПРОИЗВОДСТВО ОДНИХ ТОЛЬКО
Dialogue: 0,0:03:47.82,0:03:50.86,Caption,,0,0,0,,РАКЕТ ДЛЯ "ИСКАНДЕРОВ" ИДЁТ ДЕСЯТКАМИ В МЕСЯЦ. Х
Dialogue: 0,0:03:50.94,0:03:53.66,Caption,,0,0,0,,СТО ОДИН ВЫПУСКАЮТСЯ БОЛЕЕ ЧЕМ ПО ВОСЕМЬДЕСЯТ ЕДИНИЦ
Dialogue: 0,0:03:53.66,0:03:56.86,Caption,,0,0,0,,ЕЖЕМЕСЯЧНО. "КАЛИБРОВ" ЕЩЁ ОКОЛО ТРИДЦАТИ. ПЛЮС
Dialogue: 0,0:03:56.86,0:04:00.78,Caption,,0,0,0,,ДРУГИЕ СИСТЕМЫ. ТО ЕСТЬ ВОПРОС ВОССТАНОВЛЕНИЯ УКРАИНСКОЙ ЭНЕРГЕТИКИ
Dialogue: 0,0:04:00.78,0:04:03.50,Caption,,0,0,0,,СУЩЕСТВУЕТ НЕ В ВАКУУМЕ. С ОДНОЙ СТОРОНЫ СТОЯТ
Dialogue: 0,0:04:03.50,0:04:05.74,Caption,,0,0,0,,РЕМОНТНЫЕ БРИГАДЫ, ОБОРУДОВАНИЕ,
Dialogue: 0,0:04:05.82,0:04:09.18,Caption,,0,0,0,,ТРАНСФОРМАТОРЫ И ПОПЫТКИ ВЕРНУТЬ СИСТЕМУ В СТРОЙ. С
Dialogue: 0,0:04:09.26,0:04:11.02,Caption,,0,0,0,,ДРУГОЙ СТОРОНЫ СТОИТ ПРОМЫШЛЕННОСТЬ,
Dialogue: 0,0:04:11.18,0:04:13.98,Caption,,0,0,0,,КОТОРАЯ ПРОДОЛЖАЕТ ВЫДАВАТЬ НОВЫЕ СРЕДСТВА ПОРАЖЕНИЯ
Dialogue: 0,0:04:14.06,0:04:17.42,Caption,,0,0,0,,СОТНЯМИ В МЕСЯЦ. ВОТ ЭТО УЖЕ НАСТОЯЩАЯ АРИФМЕТИКА
Dialogue: 0,0:04:17.50,0:04:20.46,Caption,,0,0,0,,ЗИМЫ. И ЗДЕСЬ ПОЯВЛЯЕТСЯ ОЧЕНЬ НЕПРИЯТНЫЙ РАЗРЫВ ВО
Dialogue: 0,0:04:20.46,0:04:23.50,Caption,,0,0,0,,ВРЕМЕНИ. ПОВРЕЖДЁННУЮ КРУПНУЮ ГЕНЕРАЦИЮ НЕЛЬЗЯ
Dialogue: 0,0:04:23.58,0:04:26.06,Caption,,0,0,0,,ВОССТАНОВИТЬ НАЖАТИЕМ КНОПКИ. ХАРЧЕНКО ГОВОРИТ О
Dialogue: 0,0:04:26.06,0:04:29.66,Caption,,0,0,0,,ДЕСЯТИ, ПЯТНАДЦАТИ ПРОЦЕНТАХ. А ПРОИЗВОДСТВО РАКЕТ ИДЁТ
Dialogue: 0,0:04:29.74,0:04:34.89,Caption,,0,0,0,,КАЖДЫЙ МЕСЯЦ. И ЕСЛИ УДАРЫ ПРОДОЛЖАТСЯ В ТОМ ЖЕ РИТМЕ,
Dialogue: 0,0:04:35.13,0:04:37.93,Caption,,0,0,0,,БОРЬБА ПРЕВРАЩАЕТСЯ НЕ В ЗАДАЧУ "ПОЧИНИТЬ ОДИН РАЗ",
Dialogue: 0,0:04:38.09,0:04:41.45,Caption,,0,0,0,,А В ГОНКУ, ГДЕ ОДНУ СТОРОНУ ИНТЕРЕСУЕТ ВОССТАНОВЛЕНИЕ,
Dialogue: 0,0:04:41.70,0:04:44.17,Caption,,0,0,0,,А ДРУГУЮ ВОЗМОЖНОСТЬ СНОВА ЭТО ВОССТАНОВЛЕНИЕ
Dialogue: 0,0:04:44.25,0:04:47.21,Caption,,0,0,0,,ОБНУЛИТЬ. ПРИЧЁМ НА ПЯТОМ ГОДУ КОНФЛИКТА РЕЧЬ ИДЁТ
Dialogue: 0,0:04:47.21,0:04:49.93,Caption,,0,0,0,,УЖЕ НЕ О ПЕРВОМ ПОВРЕЖДЕНИИ ЭНЕРГОСИСТЕМЫ. ОНА
Dialogue: 0,0:04:49.93,0:04:52.49,Caption,,0,0,0,,ПЕРЕСТРАИВАЛАСЬ МНОГО РАЗ. МЕНЯЛИСЬ СХЕМЫ
Dialogue: 0,0:04:52.49,0:04:55.69,Caption,,0,0,0,,РАСПРЕДЕЛЕНИЯ. МЕНЯЛИСЬ МАРШРУТЫ ПЕРЕДАЧИ ЭНЕРГИИ.
Dialogue: 0,0:04:55.91,0:04:59.21,Caption,,0,0,0,,СОЗДАВАЛИСЬ АВАРИЙНЫЕ ВАРИАНТЫ. И КАЖДЫЙ НОВЫЙ РАУНД
Dialogue: 0,0:04:59.21,0:05:01.61,Caption,,0,0,0,,УДАРОВ ПРОВЕРЯЕТ УЖЕ НЕ СТАРУЮ СИСТЕМУ,
Dialogue: 0,0:05:01.77,0:05:05.13,Caption,,0,0,0,,А ЕЁ ОЧЕРЕДНУЮ ПЕРЕДЕЛАННУЮ ВЕРСИЮ. ЕСТЬ ПРЕДЕЛ У
Dialogue: 0,0:05:05.13,0:05:08.41,Caption,,0,0,0,,ЛЮБОЙ КОНСТРУКЦИИ. ДАЖЕ ЕСЛИ ЕЁ ОЧЕНЬ ДОЛГО ЧИНИТЬ
Dialogue: 0,0:05:08.50,0:05:12.65,Caption,,0,0,0,,И ОЧЕНЬ КРАСИВО РАССКАЗЫВАТЬ, ЧТО ОНА СТАЛА УСТОЙЧИВЕЕ. А ТЕПЕРЬ ВООБЩЕ В
Dialogue: 0,0:05:12.73,0:05:15.61,Caption,,0,0,0,,ДРУГУЮ СТОРОНУ. ПОКА КИЕВ СЧИТАЕТ ЧАСЫ БЕЗ СВЕТА
Dialogue: 0,0:05:15.69,0:05:19.85,Caption,,0,0,0,,И ДУМАЕТ, КАК ПРОЙТИ ЗИМУ, В УКРАИНСКОЙ НАЦПОЛИЦИИ ВСПЛЫВАЕТ ИСТОРИЯ,
Dialogue: 0,0:05:20.02,0:05:22.57,Caption,,0,0,0,,КОТОРУЮ ОТДЕЛЬНОЙ СТРОКОЙ ДАЖЕ НЕУДОБНО НАЗЫВАТЬ.
Dialogue: 0,0:05:22.97,0:05:25.29,Caption,,0,0,0,,НАБУ ЗАДЕРЖАЛО ПЕРВОГО ЗАМЕСТИТЕЛЯ ГЛАВЫ
Dialogue: 0,0:05:25.29,0:05:28.01,Caption,,0,0,0,,ДЕПАРТАМЕНТА СТРАТЕГИЧЕСКИХ РАССЛЕДОВАНИЙ НАЦПОЛИЦИИ
Dialogue: 0,0:05:28.01,0:05:30.89,Caption,,0,0,0,,ВЛАДИМИРА ЦЕНОВА. ЭТОТ ЧЕЛОВЕК ДОЛЖЕН БЫЛ БОРОТЬСЯ С
Dialogue: 0,0:05:30.89,0:05:33.53,Caption,,0,0,0,,ОРГАНИЗОВАННОЙ ПРЕСТУПНОСТЬЮ. А В МАТЕРИАЛАХ ДЕЛА ОН
Dialogue: 0,0:05:33.53,0:05:36.01,Caption,,0,0,0,,ПРОХОДИТ ПОД КЛИЧКОЙ "ПРАЙС". НАЗВАНИЕ,
Dialogue: 0,0:05:36.14,0:05:39.93,Caption,,0,0,0,,НАДО СКАЗАТЬ, ДОВОЛЬНО УДАЧНОЕ. СЛЕДСТВИЕ ГОВОРИТ О ГИГАНТСКОЙ
Dialogue: 0,0:05:39.93,0:05:42.81,Caption,,0,0,0,,СЕТИ МОШЕННИЧЕСКИХ КОЛЛ ЦЕНТРОВ. ПЯТЬДЕСЯТ ДВЕ
Dialogue: 0,0:05:42.81,0:05:48.92,Caption,,0,0,0,,ТОЧКИ. ПОЧТИ ТРИ ТЫСЯЧИ СОТРУДНИКОВ. ЗА БЕЗОПАСНОСТЬ КАЖДОЙ
Dialogue: 0,0:05:48.92,0:05:52.04,Caption,,0,0,0,,ТОЧКИ СИЛОВИКАМ ЕЖЕМЕСЯЧНО ЯКОБЫ ЗАНОСИЛИ ОКОЛО СЕМИ
Dialogue: 0,0:05:52.04,0:05:55.16,Caption,,0,0,0,,ТЫСЯЧ ДОЛЛАРОВ. ПЯТЬДЕСЯТ ДВЕ ТОЧКИ ПО СЕМЬ ТЫСЯЧ.
Dialogue: 0,0:05:55.45,0:05:58.44,Caption,,0,0,0,,КАЖДЫЙ МЕСЯЦ. ВОТ ТУТ ДАЖЕ КАЛЬКУЛЯТОР НАЧИНАЕТ
Dialogue: 0,0:05:58.44,0:06:01.24,Caption,,0,0,0,,НЕРВНИЧАТЬ. НО И ЭТО ЕЩЁ НЕ ВСЯ КОНСТРУКЦИЯ.
Dialogue: 0,0:06:01.64,0:06:04.76,Caption,,0,0,0,,ОПЕРАЦИЯ ПОЛУЧИЛА НАЗВАНИЕ "КАРФАГЕН". В ИСТОРИИ
Dialogue: 0,0:06:04.76,0:06:06.84,Caption,,0,0,0,,ФИГУРИРУЮТ СОТРУДНИКИ НАЦПОЛИЦИИ,
Dialogue: 0,0:06:06.99,0:06:09.96,Caption,,0,0,0,,СБУ И ПРОКУРАТУРЫ. В ТОТ ЖЕ ДЕНЬ ЗАДЕРЖАЛИ
Dialogue: 0,0:06:09.96,0:06:13.32,Caption,,0,0,0,,ГЕНЕРАЛ МАЙОРА СБУ СЕРГЕЯ ДУКУ. ПРИ ОБЫСКЕ ОН,
Dialogue: 0,0:06:13.40,0:06:17.96,Caption,,0,0,0,,СОГЛАСНО МАТЕРИАЛАМ ДЕЛА, ПЫТАЛСЯ СОПРОТИВЛЯТЬСЯ И УГРОЖАЛ ДЕТЕКТИВАМ ОРУЖИЕМ.
Dialogue: 0,0:06:18.29,0:06:21.32,Caption,,0,0,0,,И КОЛЛ ЦЕНТРАМИ ДЕЛО НЕ ОГРАНИЧИВАЕТСЯ. В МАТЕРИАЛАХ
Dialogue: 0,0:06:21.32,0:06:23.88,Caption,,0,0,0,,ФИГУРИРУЮТ НАРКОТИКИ, ФАЛЬШИВЫЕ ЕВРО,
Dialogue: 0,0:06:24.06,0:06:26.52,Caption,,0,0,0,,СЛИВ ИНФОРМАЦИИ ИЗ ЗАКРЫТЫХ БАЗ МВД,
Dialogue: 0,0:06:26.84,0:06:29.88,Caption,,0,0,0,,ПОХИЩЕНИЯ ЛЮДЕЙ И ВЫМОГАТЕЛЬСТВО. ТО ЕСТЬ ПЕРЕД НАМИ
Dialogue: 0,0:06:29.96,0:06:32.76,Caption,,0,0,0,,УЖЕ НЕ СЮЖЕТ "ОДИН ПЛОХОЙ ПОЛИЦЕЙСКИЙ ВЗЯЛ КОНВЕРТ".
Dialogue: 0,0:06:32.92,0:06:36.20,Caption,,0,0,0,,ТУТ НАРИСОВАНА ЦЕЛАЯ СИСТЕМА УСЛУГ. НУЖНА ИНФОРМАЦИЯ
Dialogue: 0,0:06:36.28,0:06:39.16,Caption,,0,0,0,,ИЗ БАЗЫ, ПОЖАЛУЙСТА. НУЖНА ЗАЩИТА БИЗНЕСА,
Dialogue: 0,0:06:39.31,0:06:41.40,Caption,,0,0,0,,ПОЖАЛУЙСТА. НУЖНЫ ПРЕДУПРЕЖДЕНИЯ,
Dialogue: 0,0:06:41.56,0:06:43.96,Caption,,0,0,0,,ПОЖАЛУЙСТА. ПРАЙС, СУДЯ ПО ПРОЗВИЩУ,
Dialogue: 0,0:06:44.05,0:06:47.72,Caption,,0,0,0,,ГДЕ ТО РЯДОМ. И ВОТ ЭТОТ КОНТРАСТ ДЛЯ КИЕВА СЕЙЧАС ОСОБЕННО
Dialogue: 0,0:06:47.72,0:06:50.68,Caption,,0,0,0,,КРАСИВ. С ОДНОЙ СТОРОНЫ ГОСУДАРСТВО СЧИТАЕТ КАЖДЫЙ
Dialogue: 0,0:06:50.68,0:06:53.56,Caption,,0,0,0,,МЕГАВАТТ И ИЩЕТ РЕСУРСЫ НА ЗАЩИТУ ИНФРАСТРУКТУРЫ.
Dialogue: 0,0:06:55.83,0:06:58.47,Caption,,0,0,0,,С ДРУГОЙ СТОРОНЫ ВНУТРИ СИЛОВОЙ СИСТЕМЫ ВСПЛЫВАЮТ
Dialogue: 0,0:06:58.47,0:07:01.27,Caption,,0,0,0,,ЛЮДИ, КОТОРЫЕ, ПО МАТЕРИАЛАМ РАССЛЕДОВАНИЯ,
Dialogue: 0,0:07:01.54,0:07:04.39,Caption,,0,0,0,,ГОДАМИ ОБСЛУЖИВАЛИ СОВЕРШЕННО ДРУГОЙ БИЗНЕС И ТОЖЕ
Dialogue: 0,0:07:04.39,0:07:07.11,Caption,,0,0,0,,ОЧЕНЬ НЕПЛОХО УМЕЛИ СЧИТАТЬ ДЕНЬГИ. НЕ НАДО ДАЖЕ
Dialogue: 0,0:07:07.11,0:07:09.91,Caption,,0,0,0,,НИЧЕГО ДОДУМЫВАТЬ. ПЯТЬДЕСЯТ ДВА КОЛЛ ЦЕНТРА УЖЕ
Dialogue: 0,0:07:09.91,0:07:12.39,Caption,,0,0,0,,САМИ ПО СЕБЕ ПРЕКРАСНЫЙ ПАМЯТНИК УПРАВЛЕНЧЕСКОЙ
Dialogue: 0,0:07:12.39,0:07:15.27,Caption,,0,0,0,,ЭФФЕКТИВНОСТИ. ПРОСТО НЕМНОГО НЕ В ТОЙ ОТРАСЛИ. А
Dialogue: 0,0:07:15.35,0:07:18.15,Caption,,0,0,0,,ТЕПЕРЬ ЕЩЁ ОДИН ПОВОРОТ. ИРАН ПРИГРОЗИЛ УДАРИТЬ ПО
Dialogue: 0,0:07:18.23,0:07:21.91,Caption,,0,0,0,,УКРАИНЕ В СЛУЧАЕ АТАКИ США. ИРАНСКИЙ ТЕЛЕКАНАЛ IRINN
Dialogue: 0,0:07:21.99,0:07:24.47,Caption,,0,0,0,,ПОКАЗАЛ СЮЖЕТ ОБ ОТВЕТНЫХ УДАРАХ ПО АМЕРИКАНСКИМ
Dialogue: 0,0:07:24.55,0:07:28.63,Caption,,0,0,0,,ОБЪЕКТАМ В ЕВРОПЕ, ЕСЛИ ВАШИНГТОН НАЧНЁТ НОВУЮ ОПЕРАЦИЮ ПРОТИВ ИРАНА.
Dialogue: 0,0:07:29.03,0:07:31.19,Caption,,0,0,0,,СРЕДИ ВОЗМОЖНЫХ ЦЕЛЕЙ НАЗВАНЫ КИЕВ,
Dialogue: 0,0:07:31.27,0:07:34.47,Caption,,0,0,0,,ЛЬВОВ И ОДЕССА. ВОТ ТУТ УКРАИНСКАЯ ГЕОГРАФИЯ
Dialogue: 0,0:07:34.47,0:07:37.59,Caption,,0,0,0,,ВНЕЗАПНО ЗАЛЕЗАЕТ УЖЕ СОВСЕМ В ДРУГУЮ ВОЙНУ. ЕЩЁ
Dialogue: 0,0:07:37.59,0:07:40.39,Caption,,0,0,0,,НЕДАВНО ВОПРОС ЗВУЧАЛ ТАК ЧТО БУДЕТ ДЕЛАТЬ ИРАН,
Dialogue: 0,0:07:40.63,0:07:43.11,Caption,,0,0,0,,ЕСЛИ США СНОВА УДАРЯТ ПО ЕГО ОБЪЕКТАМ?
Dialogue: 0,0:07:43.59,0:07:46.07,Caption,,0,0,0,,ТЕПЕРЬ ОТВЕТНАЯ ЛОГИКА ВЫХОДИТ ДАЛЕКО ЗА ГРАНИЦЫ
Dialogue: 0,0:07:46.07,0:07:49.19,Caption,,0,0,0,,ПЕРСИДСКОГО ЗАЛИВА. ЕСЛИ ТЕГЕРАН СЧИТАЕТ ОБЪЕКТЫ И
Dialogue: 0,0:07:49.19,0:07:51.99,Caption,,0,0,0,,СОЮЗНИКОВ США ЧАСТЬЮ ЕДИНОЙ СИСТЕМЫ УГРОЗЫ,
Dialogue: 0,0:07:52.39,0:07:54.71,Caption,,0,0,0,,ТО И ГЕОГРАФИЯ ОТВЕТА ПЕРЕСТАЁТ ОГРАНИЧИВАТЬСЯ
Dialogue: 0,0:07:54.79,0:07:57.59,Caption,,0,0,0,,БЛИЖНИМ ВОСТОКОМ. И ЗДЕСЬ ВОЗВРАЩАЕТСЯ СТАРАЯ
Dialogue: 0,0:07:57.59,0:08:00.79,Caption,,0,0,0,,ПРОБЛЕМА, КОТОРУЮ ВАШИНГТОН ТАК И НЕ РЕШИЛ. ИРАН УЖЕ
Dialogue: 0,0:08:00.79,0:08:03.03,Caption,,0,0,0,,ПЕРЕЖИВАЛ УДАРЫ, ГИБЕЛЬ КОМАНДИРОВ,
Dialogue: 0,0:08:03.19,0:08:05.67,Caption,,0,0,0,,УНИЧТОЖЕНИЕ ОБЪЕКТОВ И ДАВЛЕНИЕ НА РУКОВОДСТВО.
Dialogue: 0,0:08:05.99,0:08:10.91,Caption,,0,0,0,,СИСТЕМА НЕ РАЗВАЛИЛАСЬ. А ЕСЛИ ПРОТИВНИК СЧИТАЕТ,
Dialogue: 0,0:08:11.15,0:08:13.15,Caption,,0,0,0,,ЧТО ЕГО ВСЁ РАВНО ПЫТАЮТСЯ УНИЧТОЖИТЬ,
Dialogue: 0,0:08:13.47,0:08:15.95,Caption,,0,0,0,,ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС ЧТО ЕМУ ТОГДА БЕРЕЧЬ?
Dialogue: 0,0:08:16.32,0:08:19.39,Caption,,0,0,0,,ВОТ ЭТО УЖЕ НАМНОГО ОПАСНЕЕ ОБЫЧНОГО ТОРГА. КОГДА
Dialogue: 0,0:08:19.47,0:08:21.79,Caption,,0,0,0,,У ГОСУДАРСТВА ОСТАЁТСЯ НАДЕЖДА ДОГОВОРИТЬСЯ И
Dialogue: 0,0:08:21.79,0:08:25.95,Caption,,0,0,0,,СОХРАНИТЬ СИСТЕМУ, У НЕГО ЕСТЬ ПРИЧИНЫ ОГРАНИЧИВАТЬ ОТВЕТ. КОГДА
Dialogue: 0,0:08:26.03,0:08:28.59,Caption,,0,0,0,,РУКОВОДСТВО СЧИТАЕТ СЛЕДУЮЩИЙ УДАР ПОПЫТКОЙ ДОБИТЬ
Dialogue: 0,0:08:28.67,0:08:32.51,Caption,,0,0,0,,РЕЖИМ, НАБОР ДОПУСТИМЫХ ДЕЙСТВИЙ РЕЗКО РАСШИРЯЕТСЯ. ПОЭТОМУ
Dialogue: 0,0:08:32.59,0:08:35.23,Caption,,0,0,0,,ОЧЕРЕДНАЯ ОПЕРАЦИЯ ПРОТИВ ИРАНА УЖЕ НЕ ВЫГЛЯДИТ
Dialogue: 0,0:08:35.31,0:08:38.03,Caption,,0,0,0,,ПОВТОРОМ ПРЕДЫДУЩЕЙ. ПОСЛЕ ПРОШЛОГО РАУНДА ВСЕ
Dialogue: 0,0:08:38.03,0:08:40.67,Caption,,0,0,0,,УСПЕЛИ ПОСМОТРЕТЬ, КТО ЧЕМ РАСПОЛАГАЕТ,
Dialogue: 0,0:08:40.91,0:08:44.03,Caption,,0,0,0,,КТО КУДА ДОСТАЁТ, ГДЕ СТОЯТ АМЕРИКАНСКИЕ БАЗЫ,
Dialogue: 0,0:08:44.27,0:08:47.31,Caption,,0,0,0,,КАКИЕ ОБЪЕКТЫ УЯЗВИМЫ И ЧЕРЕЗ КАКИЕ СТРАНЫ ВООБЩЕ
Dialogue: 0,0:08:47.31,0:08:50.59,Caption,,0,0,0,,ПРОХОДИТ ВСЯ РЕГИОНАЛЬНАЯ КОНСТРУКЦИЯ. И ЕСЛИ ТЕПЕРЬ
Dialogue: 0,0:08:50.67,0:08:52.67,Caption,,0,0,0,,В ИРАНСКОМ СЮЖЕТЕ ПОЯВЛЯЮТСЯ КИЕВ,
Dialogue: 0,0:08:52.75,0:08:57.39,Caption,,0,0,0,,ЛЬВОВ И ОДЕССА, ЭТО ОЗНАЧАЕТ ЕЩЁ ОДНУ НЕПРИЯТНУЮ ВЕЩЬ. УКРАИНА ВСЁ
Dialogue: 0,0:08:57.39,0:08:59.39,Caption,,0,0,0,,ГЛУБЖЕ ОКАЗЫВАЕТСЯ ВНУТРИ КОНФЛИКТОВ,
Dialogue: 0,0:08:59.71,0:09:02.27,Caption,,0,0,0,,КОТОРЫЕ НАПРЯМУЮ К УКРАИНСКОЙ ТЕРРИТОРИИ ИЗНАЧАЛЬНО
Dialogue: 0,0:09:02.35,0:09:05.07,Caption,,0,0,0,,ВООБЩЕ НЕ ОТНОСИЛИСЬ. А РЕСУРСОВ ОТ ЭТОГО БОЛЬШЕ
Dialogue: 0,0:09:05.07,0:09:07.79,Caption,,0,0,0,,НЕ СТАНОВИТСЯ. И ВОТ ЗДЕСЬ ПОЯВЛЯЕТСЯ ВОПРОС,
Dialogue: 0,0:09:07.87,0:09:10.75,Caption,,0,0,0,,НА КОТОРЫЙ ПОКА НИКТО НЕ ДАЛ ОТВЕТА. СКОЛЬКО
Dialogue: 0,0:09:10.75,0:09:13.55,Caption,,0,0,0,,РАЗНЫХ УДАРОВ И КРИЗИСОВ СПОСОБНА ОДНОВРЕМЕННО
Dialogue: 0,0:09:13.55,0:09:18.03,Caption,,0,0,0,,ВЫДЕРЖИВАТЬ ОДНА СТРАНА? УКРАИНА ОДНОВРЕМЕННО ПОЛУЧАЕТ ДАВЛЕНИЕ СРАЗУ ПО
Dialogue: 0,0:09:18.11,0:09:22.19,Caption,,0,0,0,,НЕСКОЛЬКИМ РАЗНЫМ КОНТУРАМ, КОТОРЫЕ РАНЬШЕ МОЖНО БЫЛО РАССМАТРИВАТЬ ОТДЕЛЬНО.
Dialogue: 0,0:09:24.47,0:09:27.91,Caption,,0,0,0,,ЭНЕРГЕТИКА. ВОЕННАЯ НАГРУЗКА. ВНУТРЕННЯЯ СИСТЕМА
Dialogue: 0,0:09:27.91,0:09:31.43,Caption,,0,0,0,,УПРАВЛЕНИЯ. ВНЕШНИЕ ОБЯЗАТЕЛЬСТВА. НОВЫЕ РИСКИ,
Dialogue: 0,0:09:31.73,0:09:34.47,Caption,,0,0,0,,КОТОРЫЕ ПРИХОДЯТ ВООБЩЕ ИЗ ЧУЖИХ КОНФЛИКТОВ. И У
Dialogue: 0,0:09:34.47,0:09:37.35,Caption,,0,0,0,,КАЖДОГО ТАКОГО КОНТУРА ЕСТЬ СВОЙ ПРЕДЕЛ ПРОЧНОСТИ.
Dialogue: 0,0:09:37.67,0:09:40.71,Caption,,0,0,0,,ВОТ ТОЛЬКО НИКТО НЕ ЗНАЕТ, КАКОЙ ИЗ НИХ ОКАЖЕТСЯ ПЕРВЫМ.
