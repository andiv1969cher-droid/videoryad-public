Dialogue: 0,0:00:00.12,0:00:02.04,Caption,,0,0,0,,ИНОГДА ДОСТАТОЧНО ПОСМОТРЕТЬ НА СЧЁТ,
Dialogue: 0,0:00:02.33,0:00:05.16,Caption,,0,0,0,,ЧТОБЫ ВЕСЬ БОДРЫЙ РАЗГОВОР О БЛЕСТЯЩИХ ПЕРСПЕКТИВАХ
Dialogue: 0,0:00:05.16,0:00:10.20,Caption,,0,0,0,,ЗАКОНЧИЛСЯ САМ СОБОЙ. ЕВРОКОМИССИЯ ПРЕДЛАГАЕТ ВЫДЕЛИТЬ УКРАИНЕ ЕЩЁ СОРОК
Dialogue: 0,0:00:10.20,0:00:12.60,Caption,,0,0,0,,ПЯТЬ МИЛЛИАРДОВ ЕВРО НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ
Dialogue: 0,0:00:12.68,0:00:15.16,Caption,,0,0,0,,ГОД. И ЭТО УЖЕ НЕ ПРОСТО ОЧЕРЕДНАЯ СУММА.
Dialogue: 0,0:00:15.48,0:00:19.08,Caption,,0,0,0,,ЭТО ПРОВЕРКА ТОГО, КТО В ИТОГЕ ОПЛАТИТ ВЕСЬ БАНКЕТ И КОМУ
Dialogue: 0,0:00:19.08,0:00:21.80,Caption,,0,0,0,,ОСТАВЯТ ПОСУДУ. ЕСЛИ ВАМ НРАВЯТСЯ РАЗБОРЫ,
Dialogue: 0,0:00:21.96,0:00:23.88,Caption,,0,0,0,,В КОТОРЫХ НОВОСТИ НЕ ЛЕЖАТ РОССЫПЬЮ,
Dialogue: 0,0:00:24.04,0:00:25.64,Caption,,0,0,0,,А СКЛАДЫВАЮТСЯ В ОДНУ КАРТИНУ,
Dialogue: 0,0:00:25.84,0:00:28.44,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЦИФРЫ СЕЙЧАС РАССКАЗЫВАЮТ О
Dialogue: 0,0:00:28.44,0:00:31.88,Caption,,0,0,0,,ПРОИСХОДЯЩЕМ ЧЕСТНЕЕ МНОГИХ РЕЧЕЙ. НОВЫЕ МИЛЛИАРДЫ
Dialogue: 0,0:00:31.96,0:00:34.76,Caption,,0,0,0,,ДОЛЖНЫ ЗАКРЫТЬ УКРАИНСКИЙ БЮДЖЕТ И ВОЕННЫЕ РАСХОДЫ.
Dialogue: 0,0:00:35.20,0:00:38.52,Caption,,0,0,0,,МЕХАНИЗМ ВЫГЛЯДИТ ПОЧТИ ИЗЯЩНО. ЕВРОСОЮЗ ЗАНИМАЕТ
Dialogue: 0,0:00:38.60,0:00:41.40,Caption,,0,0,0,,ДЕНЬГИ НА ФИНАНСОВЫХ РЫНКАХ, ПЕРЕДАЁТ ИХ КИЕВУ,
Dialogue: 0,0:00:41.71,0:00:44.36,Caption,,0,0,0,,А ОСНОВНОЙ ДОЛГ УКРАИНА НАЧИНАЕТ ВОЗВРАЩАТЬ ПОСЛЕ
Dialogue: 0,0:00:44.36,0:00:45.96,Caption,,0,0,0,,ПОЛУЧЕНИЯ РОССИЙСКИХ РЕПАРАЦИЙ.
Dialogue: 0,0:00:46.52,0:00:49.48,Caption,,0,0,0,,НА БУМАГЕ ВСЁ ЗАМЕЧАТЕЛЬНО. ОСОБЕННО ТА ЧАСТЬ,
Dialogue: 0,0:00:49.88,0:00:52.60,Caption,,0,0,0,,ГДЕ БУДУЩИЙ ПЛАТЁЖ УЖЕ МЫСЛЕННО ПОЛОЖИЛИ В КАССУ,
Dialogue: 0,0:00:52.92,0:00:54.68,Caption,,0,0,0,,ХОТЯ САМОЙ КАССЫ ПОКА НИКТО НЕ ВИДЕЛ.
Dialogue: 0,0:00:55.32,0:00:58.84,Caption,,0,0,0,,И ТУТ РОБЕРТ ФИЦО ПОРТИТ ТОРЖЕСТВЕННОЕ НАСТРОЕНИЕ.
Dialogue: 0,0:00:59.07,0:01:01.64,Caption,,0,0,0,,ОН ПРЯМО НАЗЫВАЕТ ПОДОБНЫЕ КРЕДИТЫ ПОДАРКАМИ И
Dialogue: 0,0:01:01.64,0:01:05.16,Caption,,0,0,0,,УТВЕРЖДАЕТ, ЧТО УКРАИНА НЕ ВЕРНЁТ НИ ПРЕЖНИЕ ДЕВЯНОСТО
Dialogue: 0,0:01:05.16,0:01:09.56,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО, НИ НОВЫЕ СРЕДСТВА. СЛОВАКИЯ ВПИСЫВАТЬСЯ В СЛЕДУЮЩИЙ
Dialogue: 0,0:01:09.64,0:01:12.76,Caption,,0,0,0,,КРУГ ОБЯЗАТЕЛЬСТВ НЕ НАМЕРЕНА. СПОР ЗДЕСЬ УЖЕ НЕ
Dialogue: 0,0:01:12.84,0:01:15.56,Caption,,0,0,0,,О СОЧУВСТВИИ КИЕВУ И НЕ О ГРОМКИХ ЛОЗУНГАХ.
Dialogue: 0,0:01:17.83,0:01:21.19,Caption,,0,0,0,,ВОПРОС КУДА ПРОЗАИЧНЕЕ. ЕСЛИ ВОЗВРАТА НИКТО ВСЕРЬЁЗ
Dialogue: 0,0:01:21.27,0:01:24.63,Caption,,0,0,0,,НЕ ЖДЁТ, ПОЧЕМУ ЭТУ ПОМОЩЬ ПРОДОЛЖАЮТ НАЗЫВАТЬ КРЕДИТОМ?
Dialogue: 0,0:01:25.07,0:01:28.39,Caption,,0,0,0,,НАВЕРНОЕ, СЛОВО ПОДАРОК СЛИШКОМ БЫСТРО ОТРЕЗВЛЯЕТ
Dialogue: 0,0:01:28.39,0:01:31.67,Caption,,0,0,0,,НАЛОГОПЛАТЕЛЬЩИКА. ОДНОВРЕМЕННО РАСТУТ И УКРАИНСКИЕ
Dialogue: 0,0:01:31.75,0:01:34.79,Caption,,0,0,0,,ЗАПРОСЫ. МИНФИН УКРАИНЫ ОЦЕНИВАЛ ПОТРЕБНОСТЬ СТРАНЫ
Dialogue: 0,0:01:34.87,0:01:37.35,Caption,,0,0,0,,НА ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОЙ ГОД В ПЯТЬДЕСЯТ
Dialogue: 0,0:01:37.35,0:01:40.39,Caption,,0,0,0,,ДВА ЦЕЛЫХ ШЕСТЬ ДЕСЯТЫХ МИЛЛИАРДА ДОЛЛАРОВ ВНЕШНЕЙ
Dialogue: 0,0:01:40.39,0:01:43.19,Caption,,0,0,0,,ПОМОЩИ. ВСКОРЕ ЗЕЛЕНСКИЙ ЗАГОВОРИЛ УЖЕ О СТА
Dialogue: 0,0:01:43.27,0:01:46.47,Caption,,0,0,0,,ПЯТНАДЦАТИ МИЛЛИАРДАХ ЕВРО. РАСХОДНЫЕ КАТЕГОРИИ НЕ
Dialogue: 0,0:01:46.47,0:01:50.07,Caption,,0,0,0,,ПОЛНОСТЬЮ СОВПАДАЮТ, ПОЭТОМУ ВЫЧИТАТЬ ОДНУ СУММУ ИЗ ДРУГОЙ КАК В
Dialogue: 0,0:01:50.07,0:01:53.03,Caption,,0,0,0,,ШКОЛЬНОЙ ЗАДАЧЕ НЕ СТОИТ. НО ОБЩИЙ ВЕКТОР ТРУДНО
Dialogue: 0,0:01:53.03,0:01:56.15,Caption,,0,0,0,,НЕ ЗАМЕТИТЬ. ЗАПРОС УВЕЛИЧИЛСЯ БОЛЕЕ ЧЕМ ВДВОЕ,
Dialogue: 0,0:01:56.31,0:01:59.19,Caption,,0,0,0,,ДА ЕЩЁ УСПЕЛ ПЕРЕОДЕТЬСЯ ИЗ ДОЛЛАРОВ В ЕВРО.
Dialogue: 0,0:01:59.83,0:02:02.79,Caption,,0,0,0,,ЕСТЬ У ЭТОЙ ИСТОРИИ ЛЮБОПЫТНЫЙ ИСТОРИЧЕСКИЙ ФОН. ПРИ
Dialogue: 0,0:02:02.79,0:02:05.59,Caption,,0,0,0,,ЯНУКОВИЧЕ НА ПЕРЕСТРОЙКУ УКРАИНСКОЙ ЭКОНОМИКИ РАДИ
Dialogue: 0,0:02:05.59,0:02:08.47,Caption,,0,0,0,,СБЛИЖЕНИЯ С ЕВРОСОЮЗОМ НАЗЫВАЛИ СУММУ В СТО
Dialogue: 0,0:02:08.47,0:02:13.19,Caption,,0,0,0,,ВОСЕМЬДЕСЯТ МИЛЛИАРДОВ ЕВРО. ТОГДА ЕВРОПЕЙСКИЕ ПАРТНЁРЫ КОШЕЛЁК НЕ ОТКРЫЛИ.
Dialogue: 0,0:02:13.42,0:02:15.83,Caption,,0,0,0,,ПОЯВИЛИСЬ ЗАЙМЫ, ОРУЖЕЙНЫЕ ПРОГРАММЫ,
Dialogue: 0,0:02:16.03,0:02:18.39,Caption,,0,0,0,,РЕГУЛЯРНЫЕ ПАКЕТЫ ПОДДЕРЖКИ. ТО,
Dialogue: 0,0:02:18.55,0:02:20.39,Caption,,0,0,0,,ЧТО ПРЕЖДЕ КАЗАЛОСЬ НЕПОДЪЁМНЫМ,
Dialogue: 0,0:02:20.71,0:02:23.51,Caption,,0,0,0,,ВДРУГ СТАЛО ПРОХОДИТЬ ПОЧТИ БУДНИЧНО. ДЕСЯТКИ
Dialogue: 0,0:02:23.51,0:02:25.19,Caption,,0,0,0,,МИЛЛИАРДОВ ПЕРЕСТАЛИ УДИВЛЯТЬ,
Dialogue: 0,0:02:25.43,0:02:27.59,Caption,,0,0,0,,СОТНИ МИЛЛИАРДОВ ПЕРЕСТАЛИ ПУГАТЬ.
Dialogue: 0,0:02:29.88,0:02:32.92,Caption,,0,0,0,,САМОСТОЯТЕЛЬНАЯ И БЛАГОПОЛУЧНАЯ УКРАИНА ЗАПАДУ БЫЛА
Dialogue: 0,0:02:33.00,0:02:37.24,Caption,,0,0,0,,НЕ ТАК НУЖНА, КАК УКРАИНА, КОТОРУЮ МОЖНО НАПРАВИТЬ ПРОТИВ РОССИИ.
Dialogue: 0,0:02:37.96,0:02:40.04,Caption,,0,0,0,,ДЛЯ ЭКОНОМИЧЕСКОГО РАЗВИТИЯ СТО ВОСЕМЬДЕСЯТ
Dialogue: 0,0:02:40.04,0:02:43.72,Caption,,0,0,0,,МИЛЛИАРДОВ СОЧЛИ ЧРЕЗМЕРНОЙ ЦЕНОЙ. ДЛЯ ВОЙНЫ РАСХОДЫ
Dialogue: 0,0:02:43.72,0:02:46.36,Caption,,0,0,0,,ИНОГО МАСШТАБА ПРИНИМАЮТСЯ ОДИН ЗА ДРУГИМ. НЕ
Dialogue: 0,0:02:46.36,0:02:50.28,Caption,,0,0,0,,СОГЛАСНЫ, СПОРЬТЕ. НО ПРЕДЛОЖИТЕ ТОГДА БОЛЕЕ УБЕДИТЕЛЬНОЕ
Dialogue: 0,0:02:50.28,0:02:54.12,Caption,,0,0,0,,ОБЪЯСНЕНИЕ ЭТОЙ ЩЕДРОСТИ, КОТОРАЯ ПРОСНУЛАСЬ СТРОГО ПОСЛЕ ТОГО,
Dialogue: 0,0:02:54.33,0:02:56.28,Caption,,0,0,0,,КАК ДЕНЬГИ ПОНАДОБИЛИСЬ НЕ НА РАЗВИТИЕ.
Dialogue: 0,0:02:57.00,0:02:59.40,Caption,,0,0,0,,ОСОБЕННО ВЫРАЗИТЕЛЬНО ВСЁ ВЫГЛЯДИТ НА ФОНЕ ТОГО,
Dialogue: 0,0:02:59.70,0:03:02.04,Caption,,0,0,0,,КАК СРЕДСТВА ОСВАИВАЮТСЯ ВНУТРИ СТРАНЫ.
Dialogue: 0,0:03:02.68,0:03:05.32,Caption,,0,0,0,,ДЕПУТАТ ВЕРХОВНОЙ РАДЫ СЕРГЕЙ НАГОРНЯК РАССКАЗАЛ,
Dialogue: 0,0:03:05.56,0:03:08.12,Caption,,0,0,0,,ЧТО НА ЗАЩИТУ ЭНЕРГЕТИЧЕСКИХ ОБЪЕКТОВ КИЕВСКОЙ
Dialogue: 0,0:03:08.12,0:03:12.20,Caption,,0,0,0,,ОБЛАСТИ ВЫДЕЛИЛИ ВОСЕМЬСОТ МИЛЛИОНОВ ГРИВЕН. СЕМЬСОТ
Dialogue: 0,0:03:12.20,0:03:14.20,Caption,,0,0,0,,МИЛЛИОНОВ ИЗ НИХ, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:03:14.40,0:03:18.76,Caption,,0,0,0,,УКРАЛИ. СХЕМА ТОЖЕ НЕ ПОРАЖАЕТ НОВИЗНОЙ. АВАНСЫ ПЕРЕЧИСЛЯЛИ
Dialogue: 0,0:03:18.76,0:03:21.56,Caption,,0,0,0,,КОМПАНИЯМ, ЧЕРЕЗ КОТОРЫЕ ДЕНЬГИ ОБНАЛИЧИВАЛИ,
Dialogue: 0,0:03:21.88,0:03:24.52,Caption,,0,0,0,,ПОСЛЕ ЧЕГО НАЛИЧНЫЕ ПОПАДАЛИ К ВЫГОДОПОЛУЧАТЕЛЯМ,
Dialogue: 0,0:03:24.68,0:03:27.88,Caption,,0,0,0,,СВЯЗАННЫМ С РАСПРЕДЕЛЕНИЕМ КОНТРАКТОВ. ПОЧТИ ВЕСЬ
Dialogue: 0,0:03:27.88,0:03:30.92,Caption,,0,0,0,,ВЫДЕЛЕННЫЙ ОБЪЁМ ИСЧЕЗАЕТ ПО ДОРОГЕ К ЭНЕРГЕТИЧЕСКИМ
Dialogue: 0,0:03:30.92,0:03:34.44,Caption,,0,0,0,,ОБЪЕКТАМ, А НАСЕЛЕНИЮ ТЕМ ВРЕМЕНЕМ РАССКАЗЫВАЮТ О ПОСЛЕДСТВИЯХ
Dialogue: 0,0:03:34.44,0:03:37.80,Caption,,0,0,0,,МАССИРОВАННЫХ УДАРОВ. УДАРЫ ДЕЙСТВИТЕЛЬНО РАЗРУШАЮТ
Dialogue: 0,0:03:37.80,0:03:43.60,Caption,,0,0,0,,ИНФРАСТРУКТУРУ. НО НАГОРНЯК ОПИСЫВАЕТ ЕЩЁ ОДИН ИСТОЧНИК УЩЕРБА
Dialogue: 0,0:03:43.68,0:03:46.08,Caption,,0,0,0,,ДЕНЬГИ, ВЫДЕЛЕННЫЕ НА ОБОРОНУ ОБЪЕКТОВ,
Dialogue: 0,0:03:46.34,0:03:49.52,Caption,,0,0,0,,ДО САМИХ ОБЪЕКТОВ ПОПРОСТУ НЕ ДОШЛИ. ЭЛЕКТРИЧЕСТВО
Dialogue: 0,0:03:49.52,0:03:52.96,Caption,,0,0,0,,ПРОПАДАЕТ ПОСЛЕ ПОПАДАНИЙ, А БЮДЖЕТНЫЕ МИЛЛИОНЫ,
Dialogue: 0,0:03:53.12,0:03:57.28,Caption,,0,0,0,,ВИДИМО, РЕШИЛИ УЙТИ ЗАРАНЕЕ. КАРТИНА ПОЛУЧАЕТСЯ БЕЗУПРЕЧНОЙ
Dialogue: 0,0:03:57.36,0:04:00.56,Caption,,0,0,0,,В СВОЕЙ НАГЛОСТИ. ЗА ПРЕДЕЛАМИ УКРАИНЫ ТРЕБУЮТ НОВЫЕ
Dialogue: 0,0:04:00.56,0:04:04.08,Caption,,0,0,0,,СУММЫ РАДИ СПАСЕНИЯ ЭНЕРГЕТИКИ. ВНУТРИ СТРАНЫ СОТНИ
Dialogue: 0,0:04:04.16,0:04:06.64,Caption,,0,0,0,,МИЛЛИОНОВ ГРИВЕН, ВЫДЕЛЕННЫХ НА ЭТУ ЦЕЛЬ,
Dialogue: 0,0:04:06.80,0:04:09.36,Caption,,0,0,0,,ПРЕВРАЩАЮТСЯ В НАЛИЧНОСТЬ И РАСТВОРЯЮТСЯ СРЕДИ
Dialogue: 0,0:04:09.36,0:04:12.32,Caption,,0,0,0,,НУЖНЫХ ЛЮДЕЙ. ТАМ НЕТ РАЗГОВОРОВ О МЕЖДУНАРОДНЫХ
Dialogue: 0,0:04:12.32,0:04:16.00,Caption,,0,0,0,,РЫНКАХ, РЕПАРАЦИЯХ И БЮДЖЕТНЫХ МЕХАНИЗМАХ. ТАМ ВИСИТ
Dialogue: 0,0:04:16.00,0:04:18.40,Caption,,0,0,0,,ОГРАНИЧЕНИЕ НЕ БОЛЬШЕ ДВУХ БУТЫЛОК МАСЛА НА
Dialogue: 0,0:04:18.40,0:04:21.68,Caption,,0,0,0,,ЧЕЛОВЕКА. ТАКИЕ МЕРЫ СВЯЗЫВАЮТ С РОСТОМ ЦЕН И
Dialogue: 0,0:04:21.68,0:04:25.12,Caption,,0,0,0,,ВОЗМОЖНЫМ ДЕФИЦИТОМ. ВСЕОБЩЕЙ КАРТОЧНОЙ СИСТЕМЫ ПОКА
Dialogue: 0,0:04:25.20,0:04:27.20,Caption,,0,0,0,,НЕТ. НО ЧЕЛОВЕКУ ВАЖНЕЕ НЕ ТЕРМИН,
Dialogue: 0,0:04:27.47,0:04:30.16,Caption,,0,0,0,,А ПРОСТАЯ ВОЗМОЖНОСТЬ КУПИТЬ НУЖНЫЙ ТОВАР БЕЗ
Dialogue: 0,0:04:30.16,0:04:33.60,Caption,,0,0,0,,РАЗРЕШЕНИЯ ТАБЛИЧКИ. НА ЭТОМ ЖЕ ФОНЕ РАЗВОРАЧИВАЕТСЯ
Dialogue: 0,0:04:33.60,0:04:36.88,Caption,,0,0,0,,ИСТОРИЯ С РАКЕТАМИ PATRIOT. ЕВРОПЕЙСКИЕ ГОСУДАРСТВА
Dialogue: 0,0:04:36.88,0:04:39.92,Caption,,0,0,0,,ОПЛАЧИВАЮТ ИХ ДЛЯ УКРАИНЫ, ОДНАКО ЗЕЛЕНСКИЙ ГОВОРИТ,
Dialogue: 0,0:04:40.08,0:04:42.72,Caption,,0,0,0,,ЧТО ПЕРЕДАЧУ ВСЁ РАВНО ДОЛЖНЫ РАЗРЕШИТЬ СОЕДИНЁННЫЕ
Dialogue: 0,0:04:42.72,0:04:46.32,Caption,,0,0,0,,ШТАТЫ. ПОЛУЧАЕТСЯ СИСТЕМА С НЕСКОЛЬКИМИ ХОЗЯЕВАМИ И
Dialogue: 0,0:04:46.32,0:04:50.56,Caption,,0,0,0,,ОДНИМ ПЛАТЕЛЬЩИКОМ, КОТОРЫЙ ПОЧЕМУ ТО НЕ ХОЗЯИН. ЕВРОПА ПРИНОСИТ ДЕНЬГИ,
Dialogue: 0,0:04:50.79,0:04:53.44,Caption,,0,0,0,,УКРАИНА ЖДЁТ ОРУЖИЕ, А ВАШИНГТОН РЕШАЕТ,
Dialogue: 0,0:04:53.59,0:05:00.92,Caption,,0,0,0,,МОЖНО ЛИ ОТКРЫТЬ КОРОБКУ. ПРОГРАММУ PURL НАЗЫВАЮТ ГЛАВНЫМ КАНАЛОМ ПОСТУПЛЕНИЯ
Dialogue: 0,0:05:00.92,0:05:03.48,Caption,,0,0,0,,ПРОТИВОБАЛЛИСТИЧЕСКИХ РАКЕТ. ВЗНОСЫ В НЕЁ
Dialogue: 0,0:05:03.48,0:05:07.71,Caption,,0,0,0,,ПРЕДЛАГАЕТСЯ ПРОДОЛЖАТЬ, ПОТОМУ ЧТО УКРАИНСКАЯ ПОТРЕБНОСТЬ НИКУДА НЕ ДЕЛАСЬ.
Dialogue: 0,0:05:08.19,0:05:11.24,Caption,,0,0,0,,РАСПРЕДЕЛЕНИЕ РОЛЕЙ ПРЕДЕЛЬНО ЯСНОЕ. СРЕДСТВА ДАЮТ
Dialogue: 0,0:05:11.24,0:05:15.15,Caption,,0,0,0,,ЕВРОПЕЙЦЫ. ПРОИЗВОДЯТ ОРУЖИЕ АМЕРИКАНЦЫ. РАЗРЕШЕНИЕ
Dialogue: 0,0:05:15.15,0:05:18.44,Caption,,0,0,0,,ВЫДАЁТ АМЕРИКА. ИСПОЛЬЗОВАТЬ РАКЕТЫ ДОЛЖНА УКРАИНА.
Dialogue: 0,0:05:18.80,0:05:21.71,Caption,,0,0,0,,И ПОСЛЕ ЭТОГО ОСОБЕННО ЗАБАВНО СЛУШАТЬ РАССУЖДЕНИЯ О
Dialogue: 0,0:05:21.71,0:05:24.52,Caption,,0,0,0,,РАВНОПРАВИИ ВСЕХ УЧАСТНИКОВ. РАВНОПРАВИЕ ТАМ
Dialogue: 0,0:05:24.52,0:05:27.24,Caption,,0,0,0,,ПРИМЕРНО КАК В ТАКСИ ОДИН ОПЛАЧИВАЕТ ПОЕЗДКУ,
Dialogue: 0,0:05:27.38,0:05:31.64,Caption,,0,0,0,,ВТОРОЙ ВЫБИРАЕТ МАРШРУТ, А ТРЕТИЙ ВСЁ РАВНО ОКАЗЫВАЕТСЯ НА ЗАДНЕМ СИДЕНЬЕ.
Dialogue: 0,0:05:32.04,0:05:35.24,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ВАМ ИНТЕРЕСНА МЕХАНИКА ТАКИХ РЕШЕНИЙ,
Dialogue: 0,0:05:35.47,0:05:37.96,Caption,,0,0,0,,А НЕ ТОЛЬКО ИХ ПАРАДНАЯ УПАКОВКА. ПОТОМУ ЧТО
Dialogue: 0,0:05:37.96,0:05:39.80,Caption,,0,0,0,,ДАЛЬШЕ В РАЗГОВОР ВХОДИТ ЧЕЛОВЕК,
Dialogue: 0,0:05:40.04,0:05:43.32,Caption,,0,0,0,,У КОТОРОГО НАХОДИТСЯ НЕМАЛАЯ ЧАСТЬ КЛЮЧЕЙ. ТРАМП
Dialogue: 0,0:05:43.32,0:05:46.04,Caption,,0,0,0,,ПОДКЛЮЧАЕТСЯ К СОВЕЩАНИЮ ЕВРОПЕЙСКИХ РУКОВОДИТЕЛЕЙ
Dialogue: 0,0:05:46.04,0:05:48.04,Caption,,0,0,0,,ПРЯМО С БОРТА ПРЕЗИДЕНТСКОГО САМОЛЁТА.
Dialogue: 0,0:05:48.67,0:05:51.16,Caption,,0,0,0,,НЕЗАДОЛГО ДО ЭТОГО ОН РАЗГОВАРИВАЛ С ПУТИНЫМ И
Dialogue: 0,0:05:51.16,0:05:54.92,Caption,,0,0,0,,СИ ЦЗИНЬПИНОМ. ЕВРОПЕЙСКИЕ ЛИДЕРЫ ЖДУТ ОБСУЖДЕНИЯ ОЧЕРЕДНЫХ
Dialogue: 0,0:05:54.92,0:05:58.68,Caption,,0,0,0,,РАСХОДОВ, А ТРАМП НАЧИНАЕТ СОМНЕВАТЬСЯ В РАЗУМНОСТИ НОВЫХ
Dialogue: 0,0:05:58.68,0:06:02.12,Caption,,0,0,0,,ВЛИВАНИЙ. ВМЕСТО ПРИВЫЧНОГО ВОПРОСА О РАЗМЕРЕ СЛЕДУЮЩЕГО
Dialogue: 0,0:06:02.12,0:06:04.84,Caption,,0,0,0,,ПАКЕТА ОН ПРЕДЛАГАЕТ СОСРЕДОТОЧИТЬСЯ НА ПЕРЕГОВОРАХ
Dialogue: 0,0:06:04.84,0:06:08.12,Caption,,0,0,0,,О МИРЕ. СЦЕНА ПОЧТИ БЫТОВАЯ. ЕВРОПА СЧИТАЕТ,
Dialogue: 0,0:06:08.30,0:06:12.96,Caption,,0,0,0,,СКОЛЬКО ЕЩЁ МОЖНО СОБРАТЬ. КИЕВ ОБЪЯСНЯЕТ,
Dialogue: 0,0:06:13.27,0:06:16.24,Caption,,0,0,0,,ПОЧЕМУ СОБРАННОГО СНОВА МАЛО. И ТУТ ЧЕЛОВЕК С
Dialogue: 0,0:06:16.32,0:06:18.32,Caption,,0,0,0,,ДОСТУПОМ К АМЕРИКАНСКОМУ ОРУЖЕЙНОМУ ШКАФУ
Dialogue: 0,0:06:18.32,0:06:21.44,Caption,,0,0,0,,СПРАШИВАЕТ, А ПРОДОЛЖАТЬ ВСЁ ЭТО ВООБЩЕ ОБЯЗАТЕЛЬНО?
Dialogue: 0,0:06:22.30,0:06:24.88,Caption,,0,0,0,,ПОСЛЕ ТАКОГО ВОПРОСА СОРОК ПЯТЬ МИЛЛИАРДОВ УЖЕ
Dialogue: 0,0:06:24.96,0:06:27.84,Caption,,0,0,0,,НЕЛЬЗЯ СЧИТАТЬ ПРОСТО ФИНАНСОВОЙ СТРОКОЙ. СУММА
Dialogue: 0,0:06:27.84,0:06:30.88,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В ПОКАЗАТЕЛЬ ГОТОВНОСТИ СОЮЗНИКОВ И
Dialogue: 0,0:06:30.88,0:06:34.16,Caption,,0,0,0,,ДАЛЬШЕ ОПЛАЧИВАТЬ ПРЕЖНИЙ КУРС. РЯДОМ ВОЗНИКАЕТ
Dialogue: 0,0:06:34.16,0:06:37.44,Caption,,0,0,0,,ИСТОРИЯ ДАВИДА АРАХАМИИ. ЕГО СТАРШИЙ СЫН,
Dialogue: 0,0:06:37.60,0:06:40.32,Caption,,0,0,0,,КАК СООБЩАЕТСЯ, НАХОДИТСЯ В ЧЕХИИ И,
Dialogue: 0,0:06:40.40,0:06:44.24,Caption,,0,0,0,,ПРЕДПОЛОЖИТЕЛЬНО, ЖИВЁТ В БРНО. ОТСЮДА РОЖДАЕТСЯ ВЕРСИЯ,
Dialogue: 0,0:06:44.52,0:06:47.20,Caption,,0,0,0,,ЧТО ПРЕДСТАВИТЕЛИ ВЕРХУШКИ ЗАРАНЕЕ ГОТОВЯТ ЗАПАСНЫЕ
Dialogue: 0,0:06:47.20,0:06:50.00,Caption,,0,0,0,,ВЫХОДЫ. НЕ ОБЯЗАТЕЛЬНО ОБЪЯВЛЯТЬ ЭВАКУАЦИЮ,
Dialogue: 0,0:06:50.16,0:06:52.40,Caption,,0,0,0,,ЕСЛИ ЧЕМОДАН УЖЕ СТОИТ В ПРАВИЛЬНОМ ГОРОДЕ.
Dialogue: 0,0:06:52.96,0:06:57.60,Caption,,0,0,0,,ПУБЛИЧНО НАСЕЛЕНИЮ ГОВОРЯТ, ЧТО СТРАНУ НАДО УДЕРЖАТЬ ЛЮБОЙ ЦЕНОЙ. ЛЮДЯМ
Dialogue: 0,0:06:57.68,0:06:59.68,Caption,,0,0,0,,ПРЕДЛАГАЮТ ОСТАВАТЬСЯ, ЭКОНОМИТЬ,
Dialogue: 0,0:06:59.76,0:07:03.60,Caption,,0,0,0,,СЛУЖИТЬ И ЖДАТЬ УЛУЧШЕНИЙ. А СЕМЬИ ВЛИЯТЕЛЬНЫХ ЛЮДЕЙ
Dialogue: 0,0:07:03.60,0:07:05.84,Caption,,0,0,0,,РАЗ ЗА РАЗОМ ОБНАРУЖИВАЮТСЯ В МЕСТАХ,
Dialogue: 0,0:07:06.13,0:07:08.80,Caption,,0,0,0,,ГДЕ ТРЕВОГА ЧАЩЕ ЗВУЧИТ НА ЭКРАНЕ ТЕЛЕФОНА,
Dialogue: 0,0:07:08.92,0:07:13.52,Caption,,0,0,0,,ЧЕМ НАД КРЫШЕЙ ДОМА. ВАЛЕРИЙ ЗАЛУЖНЫЙ ПОЛУЧАЕТ НАГРАДУ ЗА ОБОРОННЫЕ
Dialogue: 0,0:07:13.52,0:07:16.72,Caption,,0,0,0,,ИННОВАЦИИ НА КОНФЕРЕНЦИИ ПОД НАЗВАНИЕМ ЦЕНА ВОЙНЫ.
Dialogue: 0,0:07:17.43,0:07:20.08,Caption,,0,0,0,,ЛУЧШЕЕ НАЗВАНИЕ ПРИДУМАТЬ ТРУДНО. ОНО СЛУЧАЙНО
Dialogue: 0,0:07:20.08,0:07:22.40,Caption,,0,0,0,,ЗАДАЁТ ВОПРОС, КОТОРЫЙ ОРГАНИЗАТОРЫ,
Dialogue: 0,0:07:22.54,0:07:26.16,Caption,,0,0,0,,ВОЗМОЖНО, ЗАДАВАТЬ НЕ СОБИРАЛИСЬ У КОГО ИМЕННО КАКАЯ ЦЕНА?
Dialogue: 0,0:07:28.43,0:07:30.59,Caption,,0,0,0,,УКРАИНА ПЛАТИТ РАЗРУШЕННОЙ ЭНЕРГЕТИКОЙ,
Dialogue: 0,0:07:30.72,0:07:33.71,Caption,,0,0,0,,ПОГИБШИМИ, РАНЕНЫМИ, МОБИЛИЗАЦИЕЙ,
Dialogue: 0,0:07:33.79,0:07:37.87,Caption,,0,0,0,,ДОЛГАМИ, УТРАТОЙ НАСЕЛЕНИЯ И МИЛЛИОНАМИ ГРАЖДАН ЗА ГРАНИЦЕЙ.
Dialogue: 0,0:07:38.50,0:07:40.91,Caption,,0,0,0,,ДЛЯ ПРИНИМАЮЩЕЙ СТОРОНЫ ЦЕНА ВЫГЛЯДИТ ИНАЧЕ.
Dialogue: 0,0:07:41.14,0:07:43.79,Caption,,0,0,0,,КОНФЕРЕНЦИОННЫЙ ЗАЛ, ТОРЖЕСТВЕННАЯ РЕЧЬ,
Dialogue: 0,0:07:43.87,0:07:47.39,Caption,,0,0,0,,СТАТУЭТКА И БЛАГОДАРНОСТЬ ЗА ВЫДАЮЩИЙСЯ ВКЛАД. ДАЖЕ
Dialogue: 0,0:07:47.39,0:07:50.43,Caption,,0,0,0,,СЧЁТ ЗА ФУРШЕТ НАВЕРНЯКА ЗАКРЫЛИ ВОВРЕМЯ. ОТСЮДА И
Dialogue: 0,0:07:50.43,0:07:52.67,Caption,,0,0,0,,ВОЗНИКАЕТ РЕЗКОЕ СРАВНЕНИЕ С ИНДЕЙЦЕМ,
Dialogue: 0,0:07:52.91,0:07:55.95,Caption,,0,0,0,,КОТОРОМУ ВРУЧИЛИ БУСЫ ЗА ХОРОШУЮ СЛУЖБУ БЕЛЫМ ЛЮДЯМ.
Dialogue: 0,0:07:56.49,0:07:58.75,Caption,,0,0,0,,ПОСЛЕ ЭТОГО ОСОБЕННО ЛЮБОПЫТНО ЗВУЧАТ СЛОВА
Dialogue: 0,0:07:58.75,0:08:02.99,Caption,,0,0,0,,ЗЕЛЕНСКОГО О ТОМ, ЧТО РОССИЯ ПРОИГРАЛА УКРАИНЕ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:08:02.99,0:08:05.63,Caption,,0,0,0,,ШЕСТОЙ ГОД НА ПОЛЕ БОЯ. ДОПУСТИМ.
Dialogue: 0,0:08:06.27,0:08:09.23,Caption,,0,0,0,,РОССИЙСКИЕ ДЕЙСТВИЯ СОРВАНЫ. УКРАИНА ВЫСТОЯЛА.
Dialogue: 0,0:08:09.47,0:08:12.75,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ПОДДЕРЖКА КРЕПКА. ПОБЕДА ПРОТИВНИКА,
Dialogue: 0,0:08:12.92,0:08:17.39,Caption,,0,0,0,,КАК НАМ СООБЩАЮТ, ОТМЕНЕНА. ТОГДА ЗАЧЕМ ПЯТНАДЦАТИЛЕТНИХ ШКОЛЬНИЦ УЖЕ
Dialogue: 0,0:08:17.39,0:08:19.07,Caption,,0,0,0,,ЗНАКОМЯТ С ВОЕННОЙ ПОДГОТОВКОЙ?
Dialogue: 0,0:08:19.39,0:08:21.63,Caption,,0,0,0,,ЕСЛИ ВРАГ ДЕЙСТВИТЕЛЬНО ПРОИГРЫВАЕТ И ЕГО
Dialogue: 0,0:08:21.63,0:08:26.27,Caption,,0,0,0,,ВОЗМОЖНОСТИ ИСЧЕРПАНЫ, ПОЧЕМУ ГОСУДАРСТВО ТЯНЕТСЯ НЕ К БУДУЩИМ ИНЖЕНЕРАМ И
Dialogue: 0,0:08:26.27,0:08:29.95,Caption,,0,0,0,,ВРАЧАМ, А К ШКОЛЬНЫМ КЛАССАМ В ПОИСКАХ СЛЕДУЮЩЕГО РЕЗЕРВА?
Dialogue: 0,0:08:30.46,0:08:32.75,Caption,,0,0,0,,СЛИШКОМ СТРАННЫЙ НАБОР МЕР ДЛЯ СТРАНЫ,
Dialogue: 0,0:08:32.99,0:08:35.79,Caption,,0,0,0,,ЧЬЕГО ПРОТИВНИКА ТОЛЬКО ЧТО ТОРЖЕСТВЕННО ЗАПИСАЛИ В
Dialogue: 0,0:08:35.79,0:08:38.91,Caption,,0,0,0,,ПРОИГРАВШИЕ. В ТОМ ЖЕ СООБЩЕНИИ ПОТЕРИ ОЦЕНИВАЮТСЯ
Dialogue: 0,0:08:38.91,0:08:42.03,Caption,,0,0,0,,ПРИМЕРНО В ТРИДЦАТЬ ПЯТЬ ТЫСЯЧ ЧЕЛОВЕК ЕЖЕМЕСЯЧНО.
Dialogue: 0,0:08:44.32,0:08:48.32,Caption,,0,0,0,,ТАМ ЖЕ ГОВОРИТСЯ, ЧТО ПРИНУДИТЕЛЬНОЕ ПОПОЛНЕНИЕ УЖЕ НЕ ПЕРЕКРЫВАЕТ
Dialogue: 0,0:08:48.40,0:08:52.72,Caption,,0,0,0,,ЭТОТ УРОВЕНЬ. ИМЕННО ЭТА ЦИФРА ОБЪЯСНЯЕТ ШКОЛЬНУЮ ПОДГОТОВКУ КУДА
Dialogue: 0,0:08:52.72,0:08:54.72,Caption,,0,0,0,,УБЕДИТЕЛЬНЕЕ ПОБЕДНЫХ ЗАЯВЛЕНИЙ.
Dialogue: 0,0:08:55.32,0:08:57.44,Caption,,0,0,0,,КОГДА ТЕКУЩЕГО ПОПОЛНЕНИЯ НЕ ХВАТАЕТ,
Dialogue: 0,0:08:57.84,0:09:00.00,Caption,,0,0,0,,ГОСУДАРСТВО НАЧИНАЕТ ПРИСМАТРИВАТЬСЯ К ТЕМ,
Dialogue: 0,0:09:00.16,0:09:04.40,Caption,,0,0,0,,КТО ПОКА СИДИТ ЗА ПАРТОЙ. ЕСЛИ ПОЛОЖЕНИЕ НАСТОЛЬКО БЛЕСТЯЩЕЕ,
Dialogue: 0,0:09:04.64,0:09:06.48,Caption,,0,0,0,,ЗАЧЕМ ЗАБИРАТЬ В РАСЧЁТ ЛЮДЕЙ,
Dialogue: 0,0:09:06.72,0:09:09.12,Caption,,0,0,0,,КОТОРЫМ ДО ВЗРОСЛОЙ ЖИЗНИ ЕЩЁ НЕСКОЛЬКО ЛЕТ?
Dialogue: 0,0:09:09.52,0:09:11.68,Caption,,0,0,0,,ТЕПЕРЬ СОБЕРЁМ ЭТИ ЭПИЗОДЫ В ОДНУ КАРТИНУ.
Dialogue: 0,0:09:11.99,0:09:14.80,Caption,,0,0,0,,ЕВРОКОМИССИЯ ПРЕДЛАГАЕТ ЕЩЁ СОРОК ПЯТЬ МИЛЛИАРДОВ
Dialogue: 0,0:09:14.80,0:09:17.60,Caption,,0,0,0,,ЕВРО. ДО ЭТОГО УЖЕ БЫЛИ ДЕВЯНОСТО МИЛЛИАРДОВ.
Dialogue: 0,0:09:17.99,0:09:20.64,Caption,,0,0,0,,УКРАИНСКАЯ ОЦЕНКА ВНЕШНЕЙ ПОТРЕБНОСТИ НА СЛЕДУЮЩИЙ
Dialogue: 0,0:09:20.64,0:09:23.76,Caption,,0,0,0,,ГОД УСПЕВАЕТ ВЫРАСТИ С ПЯТИДЕСЯТИ ДВУХ ЦЕЛЫХ ШЕСТИ
Dialogue: 0,0:09:23.76,0:09:26.72,Caption,,0,0,0,,ДЕСЯТЫХ МИЛЛИАРДА ДОЛЛАРОВ ДО СТА ПЯТНАДЦАТИ
Dialogue: 0,0:09:26.72,0:09:29.28,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО. ФИЦО ПРЯМО ГОВОРИТ,
Dialogue: 0,0:09:29.43,0:09:31.52,Caption,,0,0,0,,ЧТО ПЕРЕД НАМИ НЕ ВОЗВРАТНЫЕ ЗАЙМЫ,
Dialogue: 0,0:09:31.76,0:09:34.80,Caption,,0,0,0,,А ПОДАРКИ. ТРАМП ЗАДАЁТ ВОПРОС О СМЫСЛЕ ДАЛЬНЕЙШИХ
Dialogue: 0,0:09:34.80,0:09:37.68,Caption,,0,0,0,,РАСХОДОВ И ПРЕДЛАГАЕТ ГОВОРИТЬ О МИРЕ. ЕВРОПА
Dialogue: 0,0:09:37.68,0:09:41.44,Caption,,0,0,0,,ОПЛАЧИВАЕТ РАКЕТЫ, НО БЕЗ АМЕРИКАНСКОГО СОГЛАСИЯ ПЕРЕДАТЬ ИХ НЕЛЬЗЯ.
Dialogue: 0,0:09:41.91,0:09:44.32,Caption,,0,0,0,,УКРАИНСКИЙ ДЕПУТАТ РАССКАЗЫВАЕТ ОБ ИСЧЕЗНОВЕНИИ
Dialogue: 0,0:09:44.32,0:09:49.04,Caption,,0,0,0,,СЕМИСОТ МИЛЛИОНОВ ГРИВЕН, ПРЕДНАЗНАЧЕННЫХ ДЛЯ ЗАЩИТЫ ЭНЕРГЕТИКИ. В ТОРГОВЛЕ
Dialogue: 0,0:09:49.04,0:09:51.84,Caption,,0,0,0,,ПОЯВЛЯЮТСЯ ОГРАНИЧЕНИЯ НА ПРОДУКТЫ. РОДСТВЕННИКИ
Dialogue: 0,0:09:51.84,0:09:54.08,Caption,,0,0,0,,ПРЕДСТАВИТЕЛЕЙ РУКОВОДСТВА ЖИВУТ ЗА ГРАНИЦЕЙ.
Dialogue: 0,0:09:54.33,0:09:57.20,Caption,,0,0,0,,ВОЕНАЧАЛЬНИКИ ПОЛУЧАЮТ СТАТУЭТКИ НА МЕРОПРИЯТИЯХ О
Dialogue: 0,0:09:57.20,0:10:02.76,Caption,,0,0,0,,ЦЕНЕ ВОЙНЫ. ПЯТНАДЦАТИЛЕТНИХ ДЕВОЧЕК НАЧИНАЮТ ГОТОВИТЬ К ТОМУ,
Dialogue: 0,0:10:03.00,0:10:05.64,Caption,,0,0,0,,ЧТО ВОЕННАЯ СЛУЖБА МОЖЕТ СТАТЬ ЧАСТЬЮ ИХ ВЗРОСЛОЙ
Dialogue: 0,0:10:05.64,0:10:08.76,Caption,,0,0,0,,ЖИЗНИ. КАЖДЫЙ ТАКОЙ ЭПИЗОД ПРЕДЛАГАЮТ РАССМАТРИВАТЬ
Dialogue: 0,0:10:08.84,0:10:11.16,Caption,,0,0,0,,В ОТДЕЛЬНОЙ КОРОБОЧКЕ. ЗДЕСЬ ФИНАНСЫ,
Dialogue: 0,0:10:11.40,0:10:16.92,Caption,,0,0,0,,ТАМ КОРРУПЦИЯ, ДАЛЬШЕ ОРУЖИЕ, ПОТОМ МОБИЛИЗАЦИЯ И НАГРАДЫ. НО ВМЕСТЕ ОНИ СТАВЯТ
Dialogue: 0,0:10:16.92,0:10:20.21,Caption,,0,0,0,,ВОПРОС, ОТ КОТОРОГО УЖЕ НЕ ОТДЕЛАЕШЬСЯ ОЧЕРЕДНОЙ РЕЧЬЮ О
Dialogue: 0,0:10:20.21,0:10:23.40,Caption,,0,0,0,,ПОДДЕРЖКЕ. КАКУЮ УКРАИНУ СТРОИЛИ ВСЕ ЭТИ ГОДЫ?
Dialogue: 0,0:10:23.80,0:10:27.88,Caption,,0,0,0,,ЕСЛИ ЦЕЛЬЮ БЫЛА БОГАТАЯ, СИЛЬНАЯ И САМОСТОЯТЕЛЬНАЯ СТРАНА,
Dialogue: 0,0:10:28.35,0:10:31.16,Caption,,0,0,0,,ПОЧЕМУ НА МИРНОЕ ПЕРЕУСТРОЙСТВО ДЕНЕГ НЕ НАШЛОСЬ,
Dialogue: 0,0:10:31.32,0:10:33.24,Caption,,0,0,0,,А НА ВОЙНУ ИХ ВЫДАЮТ СНОВА И СНОВА?
Dialogue: 0,0:10:33.80,0:10:37.08,Caption,,0,0,0,,ПОЧЕМУ КАЖДЫЙ СЛЕДУЮЩИЙ ЭТАП ДЕЛАЕТ КИЕВ ЗАВИСИМЕЕ
Dialogue: 0,0:10:37.16,0:10:40.36,Caption,,0,0,0,,ОТ ЧУЖИХ ЗАЙМОВ, ЧУЖОГО ОРУЖИЯ И ЧУЖИХ РАЗРЕШЕНИЙ?
Dialogue: 0,0:10:40.85,0:10:43.88,Caption,,0,0,0,,ПОЧЕМУ ПУБЛИЧНЫЕ РАССКАЗЫ ОБ УСПЕХАХ СОПРОВОЖДАЮТСЯ
Dialogue: 0,0:10:43.96,0:10:46.68,Caption,,0,0,0,,ПОИСКОМ ВСЁ БОЛЕЕ МОЛОДОГО ЧЕЛОВЕЧЕСКОГО РЕЗЕРВА?
Dialogue: 0,0:10:47.16,0:10:50.45,Caption,,0,0,0,,УКРАИНУ ИСПОЛЬЗОВАЛИ КАК ТАРАН ПРОТИВ РОССИИ. ПОКА
Dialogue: 0,0:10:50.45,0:10:53.40,Caption,,0,0,0,,ЭТОТ ИНСТРУМЕНТ НУЖЕН, ДЛЯ НЕГО НАЙДУТ КРЕДИТЫ,
Dialogue: 0,0:10:53.49,0:10:57.16,Caption,,0,0,0,,СНАРЯДЫ И НОВЫЕ ФИНАНСОВЫЕ СХЕМЫ. СУММУ НАЗОВУТ
Dialogue: 0,0:10:57.16,0:10:59.80,Caption,,0,0,0,,НЕОБХОДИМОЙ, РАСХОДЫ ОБЪЯВЯТ НЕИЗБЕЖНЫМИ,
Dialogue: 0,0:11:00.10,0:11:02.60,Caption,,0,0,0,,А ЛЮБОЙ ВОПРОС О РЕЗУЛЬТАТЕ ПОПРОСЯТ ОТЛОЖИТЬ ДО
Dialogue: 0,0:11:02.60,0:11:05.88,Caption,,0,0,0,,ПОБЕДЫ. ТОЛЬКО СУДЬБА САМОГО ТАРАНА УСТРОИТЕЛЕЙ
Dialogue: 0,0:11:05.96,0:11:09.16,Caption,,0,0,0,,ИНТЕРЕСУЕТ ЗАМЕТНО МЕНЬШЕ. ДОЛГИ ДОСТАНУТСЯ УКРАИНЕ.
Dialogue: 0,0:11:09.56,0:11:12.28,Caption,,0,0,0,,РАЗБИТЫЕ ЭЛЕКТРОСТАНЦИИ И СЕТИ ДОСТАНУТСЯ УКРАИНЕ.
Dialogue: 0,0:11:12.67,0:11:15.56,Caption,,0,0,0,,ИСЧЕЗАЮЩЕЕ НАСЕЛЕНИЕ И ПРОВАЛ МЕЖДУ ПОКОЛЕНИЯМИ
Dialogue: 0,0:11:15.56,0:11:19.53,Caption,,0,0,0,,ДОСТАНУТСЯ УКРАИНЕ. ПОДРОСТКИ,
Dialogue: 0,0:11:19.74,0:11:22.17,Caption,,0,0,0,,КОТОРЫХ ЗАРАНЕЕ ПРИУЧАЮТ К БУДУЩЕЙ ВОЙНЕ,
Dialogue: 0,0:11:22.48,0:11:25.13,Caption,,0,0,0,,ТОЖЕ ОСТАНУТСЯ УКРАИНЕ. А КРЕДИТОРЫ,
Dialogue: 0,0:11:25.31,0:11:29.85,Caption,,0,0,0,,ПОСТАВЩИКИ ОРУЖИЯ, РАСПОРЯДИТЕЛИ РАЗРЕШЕНИЙ И ОРГАНИЗАТОРЫ ЦЕРЕМОНИЙ
Dialogue: 0,0:11:30.00,0:11:32.57,Caption,,0,0,0,,ВСЕГДА СМОГУТ ОТОЙТИ В СТОРОНУ. ОНИ СКАЖУТ,
Dialogue: 0,0:11:32.65,0:11:35.69,Caption,,0,0,0,,ЧТО ПОДДЕРЖИВАЛИ, ПОМОГАЛИ И ЖЕЛАЛИ ЛУЧШЕГО.
Dialogue: 0,0:11:36.24,0:11:39.21,Caption,,0,0,0,,ВОТ ТОЛЬКО НОРМАЛЬНАЯ ПОМОЩЬ УВЕЛИЧИВАЕТ СОБСТВЕННЫЕ
Dialogue: 0,0:11:39.21,0:11:43.53,Caption,,0,0,0,,СИЛЫ ТОГО, КОМУ ЕЁ ОКАЗЫВАЮТ. ЗДЕСЬ ВЫХОДИТ НАОБОРОТ. ЧЕМ
Dialogue: 0,0:11:43.53,0:11:46.73,Caption,,0,0,0,,ДОЛЬШЕ ДЛИТСЯ ПОМОЩЬ, ТЕМ БОЛЬШЕ У УКРАИНЫ ДОЛГОВ,
Dialogue: 0,0:11:47.03,0:11:52.01,Caption,,0,0,0,,ТЕМ ВЫШЕ ЕЁ НОВЫЕ ЗАПРОСЫ, ТЕМ СИЛЬНЕЕ ЗАВИСИМОСТЬ ОТ ЧУЖИХ РЕШЕНИЙ И ТЕМ
Dialogue: 0,0:11:52.01,0:11:55.53,Caption,,0,0,0,,МОЛОЖЕ ЛЮДИ, КОТОРЫХ НАЧИНАЮТ ГОТОВИТЬ К ПРОДОЛЖЕНИЮ ВОЙНЫ.
