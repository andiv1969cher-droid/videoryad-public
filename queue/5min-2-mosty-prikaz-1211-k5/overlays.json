  "1": {
    "text": {
      "words": "НАМ УЖЕ ВСЁ РАССКАЗАЛИ",
      "at": 2.5
    }
  },
  "3": {
    "text": {
      "words": "ПРИКАЗ: УНИЧТОЖИТЬ МОСТЫ",
      "at": 2.5
    }
  },
  "6": {
    "text": {
      "words": "МОСТ — ЭТО СНАБЖЕНИЕ",
      "at": 2.5
    }
  },
  "7": {
    "text": {
      "words": "ДОРОГИ, ЖЕЛЕЗНАЯ ДОРОГА, ПЕРЕПРАВЫ",
      "at": 2.5
    }
  },
  "8": {
    "text": {
      "words": "ФОРМУЛЕ ВОЙНЫ НЕ СТО ЛЕТ",
      "at": 2.5
    }
  },
  "11": {
    "text": {
      "words": "ЖИТЕЛЮ КИЕВА НУЖЕН НЕ ДОКЛАД",
      "at": 2.5
    }
  },
  "12": {
    "text": {
      "words": "ЗНАТЬ ПЛАН — НЕ ЗНАЧИТ ОСТАНОВИТЬ",
      "at": 2.5
    }
  },
  "15": {
    "text": {
      "words": "КРЕЙДЕНКО: БЕЗ МОСТОВ, МЕТРО И СВЕТА",
      "at": 2.5
    }
  },
  "17": {
    "text": {
      "words": "СНАЧАЛА ПРЕДУПРЕЖДЕНИЕ",
      "at": 2.5
    }
  },
  "19": {
    "text": {
      "words": "ЯРОСЛАВСКИЙ: КИЕВ, ХАРЬКОВ, ОДЕССА",
      "at": 2.5
    }
  },
  "20": {
    "text": {
      "words": "СНОВА О ПРЕКРАЩЕНИИ ОГНЯ",
      "at": 2.5
    }
  },
  "23": {
    "text": {
      "words": "«МЫ ЗНАЛИ» — ЭТО НЕ ЗАЩИТА",
      "at": 2.5
    }
  },
  "25": {
    "text": {
      "words": "ЦЕЛЬ — ПИЩЕВАЯ ПРОМЫШЛЕННОСТЬ",
      "at": 2.5
    }
  },
  "26": {
    "text": {
      "words": "ЭЛЕВАТОРЫ, ЗЕРНО, ПЕРЕРАБОТКА",
      "at": 2.5
    }
  },
  "29": {
    "text": {
      "words": "СПИСКИ ПИСАТЬ УМЕЮТ ВСЕ",
      "at": 2.5
    }
  },
  "30": {
    "text": {
      "words": "ОТ «СПРАВИМСЯ» К «БУДЕТ ТЯЖЕЛО»",
      "at": 2.5
    }
  },
  "32": {
    "text": {
      "words": "ТЕПЕРЬ НОВОСТИ ПРО ЛЮДЕЙ",
      "at": 2.5
    }
