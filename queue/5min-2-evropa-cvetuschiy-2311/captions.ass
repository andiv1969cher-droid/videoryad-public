Dialogue: 0,0:00:00.12,0:00:02.60,Caption,,0,0,0,,ЕСТЬ ЗАМЕЧАТЕЛЬНЫЙ СПОСОБ УСПОКОИТЬ ЧЕЛОВЕКА,
Dialogue: 0,0:00:02.74,0:00:06.92,Caption,,0,0,0,,КОТОРЫЙ СПРАШИВАЕТ, КУДА УХОДЯТ ЕГО ДЕНЬГИ. НУЖНО ОБЪЯСНИТЬ ЕМУ,
Dialogue: 0,0:00:07.08,0:00:11.72,Caption,,0,0,0,,ЧТО ЭТО НЕ РАСХОДЫ, А ИНВЕСТИЦИИ. ПРИЧЁМ ОЧЕНЬ ВЫГОДНЫЕ. ПРОСТО ПРИБЫЛЬ
Dialogue: 0,0:00:11.80,0:00:16.28,Caption,,0,0,0,,ПРИДЁТ ПОТОМ, КОГДА НИБУДЬ, ЗАТО ОБЯЗАТЕЛЬНО МНОГОКРАТНО. КРАСОТА!
Dialogue: 0,0:00:16.52,0:00:18.84,Caption,,0,0,0,,ОСОБЕННО КОГДА ЧЕЛОВЕК УЖЕ СЕГОДНЯ НАЧИНАЕТ
Dialogue: 0,0:00:18.84,0:00:22.04,Caption,,0,0,0,,ИНТЕРЕСОВАТЬСЯ, ЗА ЧЕЙ СЧЁТ ВЕСЬ ЭТОТ ПРАЗДНИК. И ВОТ
Dialogue: 0,0:00:22.12,0:00:24.60,Caption,,0,0,0,,В ЕВРОПЕ СЕЙЧАС ПРОИСХОДИТ ОДНА ВЕСЬМА ЛЮБОПЫТНАЯ
Dialogue: 0,0:00:24.60,0:00:27.80,Caption,,0,0,0,,ИСТОРИЯ С ТАКИМИ ОБЕЩАНИЯМИ. ФРИДРИХ МЕРЦ ТЕПЕРЬ
Dialogue: 0,0:00:27.80,0:00:31.72,Caption,,0,0,0,,ОБЪЯСНЯЕТ НЕМЦАМ, ЧТО НЫНЕШНИЕ ВЛОЖЕНИЯ В УКРАИНУ ВЕРНУТСЯ ГЕРМАНИИ
Dialogue: 0,0:00:31.72,0:00:33.80,Caption,,0,0,0,,МНОГОКРАТНО. В ВИДЕ СТАБИЛЬНОСТИ,
Dialogue: 0,0:00:34.04,0:00:38.76,Caption,,0,0,0,,ЭКСПОРТНЫХ ВОЗМОЖНОСТЕЙ, СОВМЕСТНЫХ ПРОЕКТОВ И ЭКОНОМИЧЕСКОГО РОСТА. ФОРМУЛА
Dialogue: 0,0:00:38.76,0:00:43.32,Caption,,0,0,0,,ОТЛИЧНАЯ. ПЛАТИМ СЕЙЧАС, ПОТОМ ПОЛУЧАЕМ ДИВИДЕНДЫ. ВОПРОС ТОЛЬКО В ТОМ,
Dialogue: 0,0:00:43.55,0:00:46.20,Caption,,0,0,0,,ЧТО СЛОВО "ПОТОМ" В СЕМЕЙНОЙ БУХГАЛТЕРИИ ПОЧЕМУ ТО
Dialogue: 0,0:00:46.20,0:00:49.40,Caption,,0,0,0,,ВСЕГДА ЗВУЧИТ НЕМНОГО ХУЖЕ СЛОВА "СЕЙЧАС". ЕСЛИ ВАМ
Dialogue: 0,0:00:49.40,0:00:53.56,Caption,,0,0,0,,ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ, ПОДПИШИТЕСЬ. ЗДЕСЬ ЦИФРЫ ДЕЙСТВИТЕЛЬНО ИНТЕРЕСНЕЕ
Dialogue: 0,0:00:53.56,0:00:57.56,Caption,,0,0,0,,ЛОЗУНГОВ. МЕРЦ ДОБАВЛЯЕТ, ЧТО РОССИЯ ЭТУ ВОЙНУ НЕ ВЫИГРАЕТ,
Dialogue: 0,0:00:57.88,0:01:00.44,Caption,,0,0,0,,А ГЕРМАНИЯ УЖЕ СТАЛА ГЛАВНЫМ СТОРОННИКОМ УКРАИНЫ,
Dialogue: 0,0:01:00.68,0:01:02.92,Caption,,0,0,0,,ПРЕЖДЕ ВСЕГО В ОБОРОННОЙ СФЕРЕ. ПОСТАВКИ
Dialogue: 0,0:01:02.92,0:01:05.40,Caption,,0,0,0,,ПРОДОЛЖАЮТСЯ. ДРОНЫ БОЛЬШОЙ ДАЛЬНОСТИ,
Dialogue: 0,0:01:05.54,0:01:12.49,Caption,,0,0,0,,АРТИЛЛЕРИЯ, БОЕПРИПАСЫ. И ЕЩЁ ОДИН АРГУМЕНТ КАНЦЛЕРА ПОСЛЕ НАЧАЛА КОНФЛИКТА
Dialogue: 0,0:01:12.57,0:01:15.21,Caption,,0,0,0,,НИ ОДНА НЕМЕЦКАЯ КОМПАНИЯ НЕ УШЛА С УКРАИНЫ,
Dialogue: 0,0:01:15.53,0:01:18.33,Caption,,0,0,0,,А ЧИСЛО РАБОТАЮЩИХ ТАМ НЕМЕЦКИХ КОМПАНИЙ ПОЧТИ
Dialogue: 0,0:01:18.33,0:01:21.85,Caption,,0,0,0,,УТРОИЛОСЬ. ТО ЕСТЬ МЕРЦ ПРОДАЁТ ЭТУ ПОЛИТИКУ НЕ ТОЛЬКО
Dialogue: 0,0:01:21.93,0:01:24.57,Caption,,0,0,0,,КАК ВОПРОС БЕЗОПАСНОСТИ. ОН ПРОДАЁТ ЕЁ ЕЩЁ И
Dialogue: 0,0:01:24.65,0:01:27.53,Caption,,0,0,0,,КАК БУДУЩИЙ БИЗНЕС. ВОТ ЗДЕСЬ И ПОЯВЛЯЕТСЯ МАРКУС
Dialogue: 0,0:01:27.53,0:01:30.57,Caption,,0,0,0,,ФРОНМАЙЕР ИЗ АДГ С СОВЕРШЕННО ДРУГОЙ БУХГАЛТЕРИЕЙ.
Dialogue: 0,0:01:30.94,0:01:33.93,Caption,,0,0,0,,ОН СПРАШИВАЕТ, ПОЧЕМУ ДЕНЬГИ ДЛЯ КИЕВА НАХОДЯТСЯ,
Dialogue: 0,0:01:34.17,0:01:36.81,Caption,,0,0,0,,А ОБЛЕГЧИТЬ ФИНАНСОВОЕ БРЕМЯ СОБСТВЕННЫХ ГРАЖДАН
Dialogue: 0,0:01:36.81,0:01:41.29,Caption,,0,0,0,,БЕРЛИН НЕ СПЕШИТ. ГЕРМАНИЯ С ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА ВЫДЕЛИЛА
Dialogue: 0,0:01:41.37,0:01:44.25,Caption,,0,0,0,,ИЛИ ЗАРЕЗЕРВИРОВАЛА БОЛЬШЕ СОРОКА ПЯТИ ЦЕЛЫХ СЕМИ
Dialogue: 0,0:01:44.25,0:01:47.45,Caption,,0,0,0,,ДЕСЯТЫХ МИЛЛИАРДА ЕВРО ГРАЖДАНСКОЙ ПОМОЩИ И ОКОЛО
Dialogue: 0,0:01:47.45,0:01:50.01,Caption,,0,0,0,,ПЯТИДЕСЯТИ СЕМИ ЦЕЛЫХ ВОСЬМИ ДЕСЯТЫХ МИЛЛИАРДА
Dialogue: 0,0:01:50.01,0:01:53.21,Caption,,0,0,0,,ВОЕННОЙ. В СУММЕ ЭТО БОЛЬШЕ СТА МИЛЛИАРДОВ ЕВРО.
Dialogue: 0,0:01:53.37,0:01:57.53,Caption,,0,0,0,,МАСШТАБ УЖЕ ТАКОЙ, ЧТО ВОПРОС НЕИЗБЕЖЕН КТО ПЛАТИТ СЕЙЧАС И КТО
Dialogue: 0,0:01:57.61,0:01:59.45,Caption,,0,0,0,,ПОЛУЧИТ ОБЕЩАННЫЕ ДИВИДЕНДЫ ПОТОМ?
Dialogue: 0,0:02:00.17,0:02:02.81,Caption,,0,0,0,,МИНИСТР ИНОСТРАННЫХ ДЕЛ ЙОХАНН ВАДЕФУЛЬ ПРЕДЛАГАЕТ
Dialogue: 0,0:02:02.81,0:02:05.69,Caption,,0,0,0,,СТРАНАМ ЕВРОСОЮЗА РАВНОМЕРНЕЕ РАСПРЕДЕЛИТЬ РАСХОДЫ
Dialogue: 0,0:02:05.77,0:02:08.65,Caption,,0,0,0,,НА ПОДДЕРЖКУ УКРАИНЫ ПРЕДСТОЯЩЕЙ ЗИМОЙ. КОГДА
Dialogue: 0,0:02:08.65,0:02:11.13,Caption,,0,0,0,,ИНВЕСТИЦИЯ ТАКАЯ ЗАМЕЧАТЕЛЬНАЯ И ПРИБЫЛЬНАЯ,
Dialogue: 0,0:02:11.40,0:02:13.93,Caption,,0,0,0,,ПОЧЕМУ РАЗГОВОР ДОВОЛЬНО БЫСТРО ПЕРЕХОДИТ К ТОМУ,
Dialogue: 0,0:02:14.24,0:02:16.25,Caption,,0,0,0,,КАК РАЗДЕЛИТЬ СЧЁТ МЕЖДУ СОСЕДЯМИ?
Dialogue: 0,0:02:16.45,0:02:18.73,Caption,,0,0,0,,НЕМЕЦКИЙ ИЗБИРАТЕЛЬ ТЕМ ВРЕМЕНЕМ ТОЖЕ РЕШИЛ
Dialogue: 0,0:02:18.73,0:02:24.84,Caption,,0,0,0,,ПОУЧАСТВОВАТЬ В ОБСУЖДЕНИИ. ПО ОПРОСУ ИНСА ДЛЯ "БИЛЬД" ПЯТЬДЕСЯТ ВОСЕМЬ
Dialogue: 0,0:02:24.84,0:02:27.64,Caption,,0,0,0,,ПРОЦЕНТОВ ЖИТЕЛЕЙ ГЕРМАНИИ ХОТЯТ ДОСРОЧНЫХ ВЫБОРОВ В
Dialogue: 0,0:02:27.64,0:02:30.68,Caption,,0,0,0,,БУНДЕСТАГ. ТОЛЬКО ДВАДЦАТЬ ШЕСТЬ ПРОЦЕНТОВ СЧИТАЮТ,
Dialogue: 0,0:02:30.84,0:02:36.04,Caption,,0,0,0,,ЧТО НЫНЕШНЯЯ КОАЛИЦИЯ ХДС, ХСС И СДПГ ДОЛЖНА СПОКОЙНО ДОСИДЕТЬ ДО ДВЕ
Dialogue: 0,0:02:36.12,0:02:37.48,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ДЕВЯТОГО ГОДА.
Dialogue: 0,0:02:38.15,0:02:41.00,Caption,,0,0,0,,У СТОРОННИКОВ СОЮЗА САРЫ ВАГЕНКНЕХТ ЗА ДОСРОЧНЫЕ
Dialogue: 0,0:02:41.08,0:02:43.72,Caption,,0,0,0,,ВЫБОРЫ ВЫСТУПАЮТ ДЕВЯНОСТО ПЯТЬ ПРОЦЕНТОВ. У АДГ
Dialogue: 0,0:02:44.16,0:02:47.56,Caption,,0,0,0,,ВОСЕМЬДЕСЯТ ПЯТЬ. У ЛЕВОЙ ПАРТИИ СЕМЬДЕСЯТ ПЯТЬ. У
Dialogue: 0,0:02:47.56,0:02:50.52,Caption,,0,0,0,,СВДП ШЕСТЬДЕСЯТ ЧЕТЫРЕ. ДАЖЕ СРЕДИ СТОРОННИКОВ
Dialogue: 0,0:02:50.60,0:02:53.00,Caption,,0,0,0,,ЗЕЛЁНЫХ СОРОК СЕМЬ ПРОЦЕНТОВ ХОТЯТ ВЫБОРОВ РАНЬШЕ
Dialogue: 0,0:02:53.00,0:02:55.88,Caption,,0,0,0,,СРОКА, А ПРОТИВ СОРОК ОДИН. ТО ЕСТЬ ВОПРОС УЖЕ
Dialogue: 0,0:02:55.88,0:02:58.04,Caption,,0,0,0,,ДАВНО НЕ ПОМЕЩАЕТСЯ В КОРОБОЧКУ С НАДПИСЬЮ
Dialogue: 0,0:02:58.04,0:03:01.88,Caption,,0,0,0,,"НЕДОВОЛЬНЫЕ ПРАВЫЕ". ЮГОВ ДЛЯ "ВЕЛЬТ АМ ЗОНТАГ" ДАЁТ ЕЩЁ ОДНУ
Dialogue: 0,0:03:01.88,0:03:04.76,Caption,,0,0,0,,ЦИФРУ. ДВАДЦАТЬ ПЯТЬ ПРОЦЕНТОВ НЕМЦЕВ ХОТЯТ
Dialogue: 0,0:03:04.84,0:03:07.72,Caption,,0,0,0,,ПОЛНОСТЬЮ ПРЕКРАТИТЬ ПОМОЩЬ УКРАИНЕ. ЕЩЁ ДВАДЦАТЬ
Dialogue: 0,0:03:07.80,0:03:10.36,Caption,,0,0,0,,ЧЕТЫРЕ ПРОЦЕНТА ХОТЯТ ЕЁ СОКРАТИТЬ. ТРИДЦАТЬ
Dialogue: 0,0:03:10.36,0:03:12.52,Caption,,0,0,0,,ПРОЦЕНТОВ ГОТОВЫ ОСТАВИТЬ НЫНЕШНИЙ УРОВЕНЬ,
Dialogue: 0,0:03:12.84,0:03:15.80,Caption,,0,0,0,,ДЕВЯТЬ ПРОЦЕНТОВ ХОТЯТ УВЕЛИЧИТЬ. ПОЛУЧАЕТСЯ СОРОК
Dialogue: 0,0:03:15.88,0:03:18.44,Caption,,0,0,0,,ДЕВЯТЬ ПРОЦЕНТОВ ЗА СОКРАЩЕНИЕ ИЛИ ПРЕКРАЩЕНИЕ
Dialogue: 0,0:03:18.60,0:03:21.24,Caption,,0,0,0,,ПРОТИВ ТРИДЦАТИ ДЕВЯТИ ПРОЦЕНТОВ ЗА СОХРАНЕНИЕ ИЛИ
Dialogue: 0,0:03:21.24,0:03:23.72,Caption,,0,0,0,,УВЕЛИЧЕНИЕ. ЕЩЁ ОДИННАДЦАТЬ ПРОЦЕНТОВ НЕ
Dialogue: 0,0:03:23.72,0:03:25.96,Caption,,0,0,0,,ОПРЕДЕЛИЛИСЬ. И ЭТО НА ФОНЕ ТОГО,
Dialogue: 0,0:03:26.12,0:03:29.08,Caption,,0,0,0,,ЧТО В ЕВРОПЕЙСКОЙ ПОЛИТИКЕ УЖЕ ЗВУЧИТ ФОРМУЛА СТО
Dialogue: 0,0:03:29.08,0:03:31.40,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО ЭТО "НЕ ОЧЕНЬ БОЛЬШИЕ ДЕНЬГИ".
Dialogue: 0,0:03:33.67,0:03:36.07,Caption,,0,0,0,,А В ОТДЕЛЬНОМ ВОПРОСЕ СОРОК ДЕВЯТЬ ПРОЦЕНТОВ
Dialogue: 0,0:03:36.15,0:03:38.95,Caption,,0,0,0,,ВЫСКАЗАЛИСЬ ЗА СКОРЫЙ РАЗГОВОР МЕРЦА С ПУТИНЫМ ДАЖЕ
Dialogue: 0,0:03:38.95,0:03:40.87,Caption,,0,0,0,,БЕЗ ПРЕДВАРИТЕЛЬНЫХ УСТУПОК МОСКВЫ.
Dialogue: 0,0:03:41.43,0:03:45.43,Caption,,0,0,0,,ПО ТЕМ ЖЕ ДАННЫМ, БОЛЬШИНСТВО ИЗБИРАТЕЛЕЙ ХДС И ХСС ВЫСТУПАЮТ ЗА
Dialogue: 0,0:03:45.43,0:03:48.39,Caption,,0,0,0,,СКОРЕЙШИЕ ПЕРЕГОВОРЫ С РОССИЕЙ. ЭТО УЖЕ ПРЯМОЙ
Dialogue: 0,0:03:48.39,0:03:51.59,Caption,,0,0,0,,КОНФЛИКТ ДВУХ ПОЛИТИЧЕСКИХ КАРТИН. КАНЦЛЕР ГОВОРИТ О
Dialogue: 0,0:03:51.67,0:03:54.31,Caption,,0,0,0,,БУДУЩИХ ДИВИДЕНДАХ И ПРОДОЛЖЕНИИ КУРСА. ПОЧТИ
Dialogue: 0,0:03:54.31,0:03:56.71,Caption,,0,0,0,,ПОЛОВИНА ОПРОШЕННЫХ ХОЧЕТ УМЕНЬШИТЬ САМ ОБЪЁМ
Dialogue: 0,0:03:56.71,0:04:00.71,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВ, А ПОЧТИ ПОЛОВИНА ОТДЕЛЬНО ХОЧЕТ ПЕРЕГОВОРОВ. ЕЩЁ В
Dialogue: 0,0:04:00.71,0:04:05.11,Caption,,0,0,0,,СЕНТЯБРЕ ЗВУЧАЛ ПРОГНОЗ, ЧТО СПОР О ПОДДЕРЖКЕ УКРАИНЫ В ГЕРМАНИИ ПОСТЕПЕННО
Dialogue: 0,0:04:05.11,0:04:09.27,Caption,,0,0,0,,СТАНЕТ СПОРОМ О ЦЕНЕ ГАЗА, РАБОЧИХ МЕСТАХ И ДЕНЬГАХ НА СОБСТВЕННУЮ
Dialogue: 0,0:04:09.27,0:04:12.15,Caption,,0,0,0,,ПРОМЫШЛЕННОСТЬ. СЕЙЧАС ЭТОТ ПРОГНОЗ ПОЛУЧИЛ ВПОЛНЕ
Dialogue: 0,0:04:12.15,0:04:15.11,Caption,,0,0,0,,КОНКРЕТНЫЕ ЦИФРЫ. ДЛЯ ОППОЗИЦИИ ВОПРОС УДОБНЕЙШИЙ
Dialogue: 0,0:04:15.11,0:04:17.91,Caption,,0,0,0,,ПОЧЕМУ НА ОЧЕРЕДНОЙ ПАКЕТ ДЛЯ КИЕВА ДЕНЬГИ НАХОДЯТСЯ
Dialogue: 0,0:04:17.99,0:04:19.83,Caption,,0,0,0,,БЫСТРЕЕ, ЧЕМ НА МЕСТНЫЙ ЗАВОД?
Dialogue: 0,0:04:20.31,0:04:22.39,Caption,,0,0,0,,ДЛЯ ПРАВИТЕЛЬСТВА ОТВЕТ ТОЖЕ ПРОСМАТРИВАЕТСЯ
Dialogue: 0,0:04:22.39,0:04:25.91,Caption,,0,0,0,,ТРЕБОВАТЬ, ЧТОБЫ БОЛЬШУЮ ДОЛЮ РАСХОДОВ БРАЛИ НА СЕБЯ ДРУГИЕ
Dialogue: 0,0:04:25.99,0:04:28.87,Caption,,0,0,0,,ГОСУДАРСТВА ЕВРОСОЮЗА. ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ
Dialogue: 0,0:04:28.87,0:04:31.51,Caption,,0,0,0,,ИСТОРИИ, ПОДПИШИТЕСЬ. А ТЕПЕРЬ ПОСМОТРИМ,
Dialogue: 0,0:04:31.67,0:04:34.71,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ С САМИМИ ДЕНЬГАМИ. ДЛЯ КИЕВА ЗДЕСЬ
Dialogue: 0,0:04:34.71,0:04:37.75,Caption,,0,0,0,,ПРОБЛЕМА ПРАКТИЧЕСКАЯ. ЧЕМ ДОЛЬШЕ СПОРЯТ О ГАРАНТИЯХ
Dialogue: 0,0:04:37.83,0:04:41.67,Caption,,0,0,0,,И ДОЛЯХ, ТЕМ ДОЛЬШЕ СОГЛАСОВЫВАЮТ СЛЕДУЮЩИЙ ТРАНШ. ОБЕЩАНИЕ
Dialogue: 0,0:04:41.75,0:04:44.39,Caption,,0,0,0,,БЕЗ ДАТЫ ПОСТУПЛЕНИЯ ДЕНЕГ БЮДЖЕТ НЕ НАПОЛНЯЕТ.
Dialogue: 0,0:04:46.66,0:04:50.34,Caption,,0,0,0,,КСТАТИ, О НЕМЕЦКИХ БЮДЖЕТАХ. В КИРХХАЙМ БАЙ МЮНХЕНЕ,
Dialogue: 0,0:04:50.42,0:04:53.70,Caption,,0,0,0,,ГЕСТАХТЕ, ХАГЕН ХОЭНЛИМБУРГЕ, ТРИМБУРГЕ,
Dialogue: 0,0:04:53.94,0:04:57.54,Caption,,0,0,0,,ТАННХАУЗЕНЕ И ВИНТЕРХАУЗЕНЕ ОТМЕНИЛИ РОЖДЕСТВЕНСКИЕ
Dialogue: 0,0:04:57.54,0:04:59.94,Caption,,0,0,0,,ЯРМАРКИ ИЗ ЗА НЕХВАТКИ ДЕНЕГ В МУНИЦИПАЛЬНЫХ
Dialogue: 0,0:04:59.94,0:05:02.98,Caption,,0,0,0,,БЮДЖЕТАХ. В БЕРЛИНЕ ОТМЕНИЛИ ЕЖЕГОДНЫЙ ФЕСТИВАЛЬ
Dialogue: 0,0:05:02.98,0:05:06.02,Caption,,0,0,0,,"БЕРЛИН ВИНТЕР ДРИМ". ГАМБУРГ ОТКАЗАЛСЯ ОТ ЧАСТИ
Dialogue: 0,0:05:06.02,0:05:09.06,Caption,,0,0,0,,РОЖДЕСТВЕНСКОЙ ПРОГРАММЫ. РОЖДЕСТВЕНСКИЕ ЯРМАРКИ НЕ
Dialogue: 0,0:05:09.14,0:05:11.46,Caption,,0,0,0,,СТОЯТ В ОДНОЙ БУХГАЛТЕРСКОЙ СТРОКЕ С УКРАИНСКОЙ
Dialogue: 0,0:05:11.46,0:05:14.34,Caption,,0,0,0,,ПОМОЩЬЮ. НО ДЛЯ ИЗБИРАТЕЛЯ КОНТРАСТ ПРОСТОЙ НАВЕРХУ
Dialogue: 0,0:05:14.34,0:05:17.06,Caption,,0,0,0,,ОБЕЩАЮТ БУДУЩИЕ ДИВИДЕНДЫ, ВНИЗУ ГОВОРЯТ,
Dialogue: 0,0:05:17.22,0:05:19.62,Caption,,0,0,0,,ЧТО НА ПРАЗДНИК ДЕНЕГ НЕТ. А ПРАВИЛА ДЛЯ
Dialogue: 0,0:05:19.62,0:05:22.74,Caption,,0,0,0,,САМИХ УКРАИНЦЕВ В ЕВРОПЕ ТОЖЕ МЕНЯЮТСЯ. В ГЕРМАНИИ
Dialogue: 0,0:05:22.74,0:05:24.98,Caption,,0,0,0,,ХРИСТИАНСКИЕ ДЕМОКРАТЫ ПРЕДЛАГАЮТ УВЕЛИЧИТЬ
Dialogue: 0,0:05:24.98,0:05:27.54,Caption,,0,0,0,,МИНИМАЛЬНЫЙ СРОК ПРОЖИВАНИЯ ДЛЯ ГРАЖДАНСТВА С ПЯТИ
Dialogue: 0,0:05:27.62,0:05:30.50,Caption,,0,0,0,,ДО ВОСЬМИ ЛЕТ. ТРЕБОВАНИЕ ПО НЕМЕЦКОМУ ПОДНЯТЬ С
Dialogue: 0,0:05:30.50,0:05:33.46,Caption,,0,0,0,,УРОВНЯ БИ ОДИН ДО БИ ДВА. ДВОЙНОЕ ГРАЖДАНСТВО
Dialogue: 0,0:05:33.46,0:05:36.26,Caption,,0,0,0,,РАЗРЕШАТЬ ТОЛЬКО В ИСКЛЮЧИТЕЛЬНЫХ СЛУЧАЯХ. ТЕХ,
Dialogue: 0,0:05:36.41,0:05:40.02,Caption,,0,0,0,,У КОГО ДВА ПАСПОРТА УЖЕ ЕСТЬ, ИЗМЕНЕНИЯ ЗАТРАГИВАТЬ НЕ ДОЛЖНЫ.
Dialogue: 0,0:05:40.57,0:05:43.46,Caption,,0,0,0,,ЕСТЬ И ЕЩЁ ОДНО ПРЕДЛОЖЕНИЕ. НА ВСЁМ ПРОТЯЖЕНИИ
Dialogue: 0,0:05:43.46,0:05:46.26,Caption,,0,0,0,,ОЖИДАНИЯ ГРАЖДАНСТВА НЕ ПОЛУЧАТЬ СОЦИАЛЬНУЮ ПОМОЩЬ.
Dialogue: 0,0:05:46.58,0:05:49.94,Caption,,0,0,0,,ЗАТО ДЛЯ ИНОСТРАНЦЕВ, КОТОРЫЕ РАБОТАЮТ В ГЕРМАНИИ ИЛИ ПРОХОДЯТ
Dialogue: 0,0:05:49.94,0:05:54.26,Caption,,0,0,0,,ПРОФЕССИОНАЛЬНОЕ ОБУЧЕНИЕ, ХОТЯТ РАСШИРИТЬ ВОЗМОЖНОСТИ ПОЛУЧЕНИЯ ВИДА НА
Dialogue: 0,0:05:54.26,0:05:59.40,Caption,,0,0,0,,ЖИТЕЛЬСТВО. ТО ЕСТЬ ЛИНИЯ СТАНОВИТСЯ ДОВОЛЬНО ПОНЯТНОЙ ХОЧЕШЬ
Dialogue: 0,0:05:59.40,0:06:01.72,Caption,,0,0,0,,ЗАКРЕПЛЯТЬСЯ В СТРАНЕ, ПОКАЖИ ЯЗЫК,
Dialogue: 0,0:06:01.80,0:06:04.92,Caption,,0,0,0,,РАБОТУ И СПОСОБНОСТЬ ЖИТЬ БЕЗ ПОСТОЯННОЙ СОЦИАЛЬНОЙ
Dialogue: 0,0:06:04.92,0:06:07.40,Caption,,0,0,0,,ПОДДЕРЖКИ. ДЛЯ ЧАСТИ УКРАИНЦЕВ,
Dialogue: 0,0:06:07.56,0:06:10.20,Caption,,0,0,0,,ПРИЕХАВШИХ В НАЧАЛЕ ПОЛНОМАСШТАБНЫХ БОЕВЫХ ДЕЙСТВИЙ,
Dialogue: 0,0:06:10.49,0:06:13.72,Caption,,0,0,0,,СРОК ВОЗМОЖНОЙ НАТУРАЛИЗАЦИИ УЖЕ ПРИБЛИЖАЛСЯ. ТЕПЕРЬ
Dialogue: 0,0:06:13.80,0:06:16.68,Caption,,0,0,0,,ФИНИШНУЮ ЧЕРТУ ХОТЯТ ОТОДВИНУТЬ. В ПОЛЬШЕ ПОСЛЕ
Dialogue: 0,0:06:16.68,0:06:19.56,Caption,,0,0,0,,ОКОНЧАНИЯ ЛЬГОТНЫХ МЕР ДЛЯ БЕЖЕНЦЕВ ВСЁ УЖЕ ЖЁСТЧЕ
Dialogue: 0,0:06:19.64,0:06:22.36,Caption,,0,0,0,,И ГОРАЗДО ПРАКТИЧНЕЕ. ТОЛЬКО ЗА ОДНУ НОЧЬ РЕШЕНИЕ
Dialogue: 0,0:06:22.44,0:06:24.92,Caption,,0,0,0,,О НЕМЕДЛЕННОЙ ДЕПОРТАЦИИ ПОЛУЧИЛ ДЕВЯНОСТО ОДИН
Dialogue: 0,0:06:24.92,0:06:27.88,Caption,,0,0,0,,ГРАЖДАНИН УКРАИНЫ. ПРИЧЁМ ПРОБЛЕМЫ ВОЗНИКАЮТ И У
Dialogue: 0,0:06:27.88,0:06:31.08,Caption,,0,0,0,,ОФИЦИАЛЬНО РАБОТАЮЩИХ ЛЮДЕЙ. ЕСЛИ РЕАЛЬНЫЕ УСЛОВИЯ
Dialogue: 0,0:06:31.08,0:06:34.12,Caption,,0,0,0,,ТРУДА НЕ СОВПАДАЮТ С ТЕМ, ЧТО ЗАПИСАНО В ДОКУМЕНТАХ,
Dialogue: 0,0:06:34.44,0:06:36.84,Caption,,0,0,0,,ИЛИ РАБОТОДАТЕЛЬ НЕПРАВИЛЬНО УВЕДОМИЛ МВД,
Dialogue: 0,0:06:37.08,0:06:39.88,Caption,,0,0,0,,СТАТУС ТОЖЕ МОЖЕТ ОКАЗАТЬСЯ ПОД УДАРОМ. ЧИСЛО
Dialogue: 0,0:06:39.88,0:06:42.60,Caption,,0,0,0,,ВЫДВОРЕНИЙ ИНОСТРАНЦЕВ ИЗ ПОЛЬШИ ВЫРОСЛО ПРИМЕРНО С
Dialogue: 0,0:06:42.68,0:06:44.92,Caption,,0,0,0,,ТРЁХ ТЫСЯЧ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ТРЕТЬЕМ ГОДУ
Dialogue: 0,0:06:45.20,0:06:47.72,Caption,,0,0,0,,ДО ДЕСЯТИ ТЫСЯЧ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ПЯТОМ.
Dialogue: 0,0:06:47.89,0:06:50.60,Caption,,0,0,0,,БОЛЬШЕ ЧЕМ ВТРОЕ. КРУПНЕЙШУЮ ДОЛЮ СРЕДИ
Dialogue: 0,0:06:50.60,0:06:53.72,Caption,,0,0,0,,ДЕПОРТИРОВАННЫХ СОСТАВЛЯЮТ ГРАЖДАНЕ УКРАИНЫ. ЛИТВА
Dialogue: 0,0:06:53.80,0:06:56.36,Caption,,0,0,0,,ТЕМ ВРЕМЕНЕМ РЕШИЛА ЗАЛЕЗТЬ В СОВСЕМ ДРУГУЮ ОБЛАСТЬ.
Dialogue: 0,0:06:56.52,0:06:59.08,Caption,,0,0,0,,ТАМ КОНСЕРВАТОРЫ ВНЕСЛИ В СЕЙМ ИНИЦИАТИВЫ,
Dialogue: 0,0:06:59.32,0:07:01.88,Caption,,0,0,0,,КОТОРЫЕ ЗАТРАГИВАЛИ ИМУЩЕСТВО И ПРАВОВОЙ СТАТУС
Dialogue: 0,0:07:01.88,0:07:03.64,Caption,,0,0,0,,КРУПНЕЙШЕЙ ПРАВОСЛАВНОЙ ОБЩИНЫ.
Dialogue: 0,0:07:05.92,0:07:08.32,Caption,,0,0,0,,ОДИН ПРОЕКТ ПОЗВОЛЯЛ ИЗМЕНИТЬ СУДЬБУ ЦЕРКОВНОЙ
Dialogue: 0,0:07:08.32,0:07:12.64,Caption,,0,0,0,,СОБСТВЕННОСТИ, ДРУГОЙ КАСАЛСЯ СТАТУСА САМОЙ ОБЩИНЫ. В ВИЛЬНЮСЕ
Dialogue: 0,0:07:12.64,0:07:15.20,Caption,,0,0,0,,СОБРАЛИСЬ СТО СОРОК ВОСЕМЬ ДЕЛЕГАТОВ И ЗАЯВИЛИ,
Dialogue: 0,0:07:15.44,0:07:17.92,Caption,,0,0,0,,ЧТО МЕНЯТЬ ЦЕРКОВНОЕ ПОДЧИНЕНИЕ ПО УКАЗАНИЮ
Dialogue: 0,0:07:17.92,0:07:20.96,Caption,,0,0,0,,ПОЛИТИКОВ НЕ СОБИРАЮТСЯ. ПОТОМ В РАЗГОВОР ВОШЛИ
Dialogue: 0,0:07:20.96,0:07:24.16,Caption,,0,0,0,,ПАРЛАМЕНТСКИЕ ЮРИСТЫ И НАПОМНИЛИ ДЕПУТАТАМ ПРОСТУЮ
Dialogue: 0,0:07:24.16,0:07:26.88,Caption,,0,0,0,,НЕПРИЯТНОСТЬ ЧАСТНАЯ СОБСТВЕННОСТЬ ЗАЩИЩЕНА
Dialogue: 0,0:07:26.88,0:07:30.24,Caption,,0,0,0,,КОНСТИТУЦИЕЙ. ИМУЩЕСТВЕННУЮ ЧАСТЬ ИНИЦИАТИВЫ КОМИТЕТ
Dialogue: 0,0:07:30.32,0:07:32.80,Caption,,0,0,0,,В ИТОГЕ ЗАБЛОКИРОВАЛ. НО ВТОРОЙ ПРОЕКТ,
Dialogue: 0,0:07:32.96,0:07:37.04,Caption,,0,0,0,,О СТАТУСЕ ЦЕРКВИ, НИКУДА НЕ ИСЧЕЗ. МАЛЕНЬКИЙ ЭКЗАРХАТ ПОЛУЧАЕТ
Dialogue: 0,0:07:37.04,0:07:41.44,Caption,,0,0,0,,ГОСУДАРСТВЕННУЮ ПОДДЕРЖКУ, А ИСТОРИЧЕСКИЕ ПРИХОДЫ ВЫНУЖДЕНЫ ЗАЩИЩАТЬ ПРАВО
Dialogue: 0,0:07:41.52,0:07:43.44,Caption,,0,0,0,,САМИМ РЕШАТЬ, КОМУ ПОДЧИНЯТЬСЯ.
Dialogue: 0,0:07:43.99,0:07:46.56,Caption,,0,0,0,,ПОЛИТИКИ ХОТЕЛИ РЕШИТЬ ЦЕРКОВНЫЙ ВОПРОС СВЕРХУ.
Dialogue: 0,0:07:46.88,0:07:49.60,Caption,,0,0,0,,КОНСТИТУЦИЯ ОКАЗАЛАСЬ НЕУДОБНОЙ ПРЕГРАДОЙ. В
Dialogue: 0,0:07:49.60,0:07:52.80,Caption,,0,0,0,,СОСЕДНЕЙ ЛАТВИИ УРОВЕНЬ АМБИЦИЙ ЕЩЁ ШИРЕ. ПРЕМЬЕР
Dialogue: 0,0:07:52.88,0:07:55.84,Caption,,0,0,0,,АНДРИС КУЛБЕРГС ПРИЗВАЛ ВООБЩЕ ЗАКРЫТЬ ЕВРОСОЮЗ ДЛЯ
Dialogue: 0,0:07:55.84,0:07:59.28,Caption,,0,0,0,,ВСЕХ ГРАЖДАН РОССИИ. АРГУМЕНТ ПРОСТОЙ СОТНИ ТЫСЯЧ
Dialogue: 0,0:07:59.28,0:08:01.76,Caption,,0,0,0,,РОССИЙСКИХ ПУТЕШЕСТВЕННИКОВ ПРОВЕРИТЬ НЕВОЗМОЖНО,
Dialogue: 0,0:08:02.00,0:08:05.28,Caption,,0,0,0,,А ЗНАЧИТ, ВПУСКАТЬ ТАКОЕ КОЛИЧЕСТВО ЛЮДЕЙ СЛИШКОМ ОПАСНО.
Dialogue: 0,0:08:05.76,0:08:08.32,Caption,,0,0,0,,ЛАТВИЯ ЕЩЁ В ИЮНЕ ВОШЛА В ЧИСЛО ОДИННАДЦАТИ
Dialogue: 0,0:08:08.32,0:08:11.68,Caption,,0,0,0,,СТРАН, ПОДДЕРЖАВШИХ ИНИЦИИРОВАННОЕ ШВЕЦИЕЙ ТРЕБОВАНИЕ
Dialogue: 0,0:08:11.68,0:08:13.60,Caption,,0,0,0,,ОГРАНИЧИТЬ ВЫДАЧУ ВИЗ РОССИЯНАМ.
Dialogue: 0,0:08:15.79,0:08:18.67,Caption,,0,0,0,,ЕВРОКОМИССАР ПО МИГРАЦИИ МАГНУС БРУННЕР В ОКТЯБРЕ
Dialogue: 0,0:08:18.67,0:08:21.95,Caption,,0,0,0,,ГОВОРИЛ, ЧТО ЕВРОКОМИССИЯ МОЖЕТ ПРЕДСТАВИТЬ СООТВЕТСТВУЮЩЕЕ
Dialogue: 0,0:08:21.95,0:08:24.27,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМ ГОДУ.
Dialogue: 0,0:08:24.83,0:08:29.47,Caption,,0,0,0,,КУЛБЕРГС ТАКЖЕ ЗАЯВИЛ, ЧТО ЛАТВИЙСКИЙ И ЭСТОНСКИЙ СПЕЦНАЗ ЗАДЕРЖАЛИ В
Dialogue: 0,0:08:29.47,0:08:33.39,Caption,,0,0,0,,ЭСТОНИИ ВОСЕМЬ ЧЕЛОВЕК, ПОЛУЧИВШИХ УКАЗАНИЯ АТАКОВАТЬ ПРЕДПРИЯТИЕ,
Dialogue: 0,0:08:33.55,0:08:36.75,Caption,,0,0,0,,ПОДДЕРЖИВАЮЩЕЕ УКРАИНУ. ОТВЕТСТВЕННОСТЬ ОН ВОЗЛАГАЕТ
Dialogue: 0,0:08:36.83,0:08:40.03,Caption,,0,0,0,,НА РОССИЮ, НО НА ЧЁМ ИМЕННО СТРОИТСЯ ЭТО ОБВИНЕНИЕ,
Dialogue: 0,0:08:40.17,0:08:43.47,Caption,,0,0,0,,НЕ ОБЪЯСНЯЕТ. ПРЕДСТОЯЩИЕ МЕСЯЦЫ ОН НАЗЫВАЕТ "ЗИМОЙ
Dialogue: 0,0:08:43.47,0:08:46.83,Caption,,0,0,0,,ИСТИНЫ", ОБВИНЯЯ МОСКВУ В УДАРАХ ПО ВОДОСНАБЖЕНИЮ,
Dialogue: 0,0:08:46.94,0:08:50.27,Caption,,0,0,0,,ОТОПЛЕНИЮ И ЭЛЕКТРИЧЕСТВУ УКРАИНЫ И В ПОПЫТКЕ ДАВИТЬ
Dialogue: 0,0:08:50.35,0:08:52.99,Caption,,0,0,0,,ЧЕРЕЗ ЭТО НА НЕМЕЦКОЕ ОБЩЕСТВО. И ПАРАЛЛЕЛЬНО ОН
Dialogue: 0,0:08:53.07,0:08:56.03,Caption,,0,0,0,,ТРЕБУЕТ, ЧТОБЫ ГЕРМАНИЯ И ДРУГИЕ КРУПНЫЕ СТРАНЫ НЕ
Dialogue: 0,0:08:56.03,0:08:59.23,Caption,,0,0,0,,ПОДДАВАЛИСЬ УСТАЛОСТИ ОТ КОНФЛИКТА. ДАЖЕ УТВЕРЖДАЕТ,
Dialogue: 0,0:08:59.40,0:09:02.35,Caption,,0,0,0,,ЧТО ПОДДЕРЖКА УКРАИНЫ НЕ МЕШАЕТ ВЫИГРЫВАТЬ ВЫБОРЫ.
Dialogue: 0,0:09:02.67,0:09:05.55,Caption,,0,0,0,,НА ФОНЕ НЕМЕЦКИХ ОПРОСОВ ЭТО ЗВУЧИТ ОСОБЕННО БОДРО.
Dialogue: 0,0:09:06.27,0:09:08.51,Caption,,0,0,0,,ОТНОШЕНИЯ С РОССИЕЙ КУЛБЕРГС НЕ СОБИРАЕТСЯ
Dialogue: 0,0:09:08.51,0:09:10.75,Caption,,0,0,0,,НОРМАЛИЗОВАТЬ ДАЖЕ ПОСЛЕ ПРЕКРАЩЕНИЯ БОЕВЫХ
Dialogue: 0,0:09:10.75,0:09:13.63,Caption,,0,0,0,,ДЕЙСТВИЙ. ЕГО ФОРМУЛА ПРЕДЕЛЬНО ЯСНАЯ НАСТУПИЛА
Dialogue: 0,0:09:13.63,0:09:16.43,Caption,,0,0,0,,НОВАЯ ЭПОХА. ТО ЕСТЬ ПЕРЕМИРИЕ ДЛЯ ЭТОЙ ПОЗИЦИИ
Dialogue: 0,0:09:16.51,0:09:18.83,Caption,,0,0,0,,ВООБЩЕ НЕ ЯВЛЯЕТСЯ ДВЕРЬЮ ОБРАТНО К ПРЕЖНИМ
Dialogue: 0,0:09:18.83,0:09:20.91,Caption,,0,0,0,,ОТНОШЕНИЯМ. НА ВСТРЕЧУ ТРАМПА,
Dialogue: 0,0:09:21.08,0:09:23.47,Caption,,0,0,0,,СИ ЦЗИНЬПИНА И ПУТИНА В ШЭНЬЧЖЭНЕ ОН ТОЖЕ
Dialogue: 0,0:09:23.47,0:09:29.27,Caption,,0,0,0,,ПОСМОТРЕЛ ПО СВОЕМУ. С ЯЛТИНСКОЙ КОНФЕРЕНЦИЕЙ ТЫСЯЧА ДЕВЯТЬСОТ СОРОК
Dialogue: 0,0:09:29.35,0:09:31.03,Caption,,0,0,0,,ПЯТОГО ГОДА СРАВНИВАТЬ ОТКАЗАЛСЯ,
Dialogue: 0,0:09:31.35,0:09:33.59,Caption,,0,0,0,,НАЗВАЛ ЭТО ПРЕУВЕЛИЧЕНИЕМ И ЗАЯВИЛ,
Dialogue: 0,0:09:33.78,0:09:35.43,Caption,,0,0,0,,ЧТО ПУТИН ТАМ ОКАЗАЛСЯ УНИЖЕН.
Dialogue: 0,0:09:36.17,0:09:38.23,Caption,,0,0,0,,А ТЕПЕРЬ МАЛЕНЬКАЯ БЫТОВАЯ ДЕТАЛЬ БОЛЬШОЙ
Dialogue: 0,0:09:38.23,0:09:41.03,Caption,,0,0,0,,ПРИНЦИПИАЛЬНОСТИ. ЭСТОНИЯ ОБЪЯВИЛА О ЗАКРЫТИИ
Dialogue: 0,0:09:41.11,0:09:44.15,Caption,,0,0,0,,ГРАНИЦЫ С РОССИЕЙ. В САМОЙ ЛАТВИИ АНАЛОГИЧНЫЙ ШАГ
Dialogue: 0,0:09:44.15,0:09:46.95,Caption,,0,0,0,,ОТВЕРГЛИ. ТО ЕСТЬ ВСЕМУ ЕВРОСОЮЗУ ПРЕДЛАГАЕТСЯ
Dialogue: 0,0:09:46.95,0:09:50.71,Caption,,0,0,0,,СДЕЛАТЬ ТО, ЧЕГО ДОМА ПОКА ДЕЛАТЬ НЕ ХОТЯТ. ОЧЕНЬ УДОБНАЯ
Dialogue: 0,0:09:50.79,0:09:53.67,Caption,,0,0,0,,ФОРМА КОЛЛЕКТИВНОЙ СМЕЛОСТИ. РЕШЕНИЕ ОБЩЕЕ,
Dialogue: 0,0:09:53.83,0:09:55.67,Caption,,0,0,0,,НЕУДОБСТВА ЖЕЛАТЕЛЬНО ТОЖЕ ОБЩИЕ.
Dialogue: 0,0:09:56.23,0:09:58.87,Caption,,0,0,0,,ВО ФРАНЦИИ ЖАН ЛЮК МЕЛАНШОН ПРЕДЛАГАЕТ ИЗБИРАТЕЛЮ
Dialogue: 0,0:09:58.95,0:10:01.99,Caption,,0,0,0,,ДРУГУЮ СДЕЛКУ. ОН ГОВОРИТ ПРЯМО ПРИ НЁМ ФРАНЦИЯ
Dialogue: 0,0:10:02.07,0:10:04.23,Caption,,0,0,0,,НЕ БУДЕТ ВОЕВАТЬ С РОССИЕЙ. И ТУТ ЖЕ
Dialogue: 0,0:10:04.23,0:10:07.11,Caption,,0,0,0,,ДОБАВЛЯЕТ, ЧТО НЕ СОБИРАЕТСЯ ВОЕВАТЬ И С КИТАЕМ ИЗ
Dialogue: 0,0:10:07.11,0:10:09.91,Caption,,0,0,0,,ЗА ТАЙВАНЯ. ЭТО УЖЕ НЕ ОДИН РОССИЙСКИЙ ВОПРОС.
Dialogue: 0,0:10:10.19,0:10:13.03,Caption,,0,0,0,,ОН ПРЕВРАЩАЕТ ОТКАЗ ОТ УЧАСТИЯ В ДВУХ КРУПНЫХ
Dialogue: 0,0:10:13.03,0:10:15.51,Caption,,0,0,0,,КОНФЛИКТАХ В ЧАСТЬ СВОЕЙ ПРЕЗИДЕНТСКОЙ КАМПАНИИ ДВЕ
Dialogue: 0,0:10:15.51,0:10:16.87,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОГО ГОДА.
Dialogue: 0,0:10:17.43,0:10:19.75,Caption,,0,0,0,,ДЛЯ МЕЛАНШОНА ЭТО УЖЕ ЧЕТВЁРТАЯ ПРЕЗИДЕНТСКАЯ
Dialogue: 0,0:10:19.75,0:10:22.63,Caption,,0,0,0,,КАМПАНИЯ. ФОРМУЛИРОВКА ПРОСТАЯ ХОТИТЕ ТЕХ,
Dialogue: 0,0:10:22.69,0:10:24.71,Caption,,0,0,0,,КТО ГОТОВ ВОЕВАТЬ, ГОЛОСУЙТЕ ЗА НИХ.
Dialogue: 0,0:10:25.26,0:10:28.63,Caption,,0,0,0,,ОН СЧИТАЕТ, ЧТО ФРАНЦИЮ ПЫТАЮТСЯ ВТЯНУТЬ В КОНФЛИКТЫ,
Dialogue: 0,0:10:28.87,0:10:31.59,Caption,,0,0,0,,КОТОРЫЕ ПАРИЖУ НЕ НУЖНЫ. ИСПАНИЯ В ЭТО ВРЕМЯ
Dialogue: 0,0:10:31.67,0:10:34.23,Caption,,0,0,0,,ПОДАРИЛА ОТДЕЛЬНЫЙ ЖАНР ПОЛИТИЧЕСКОЙ АРИФМЕТИКИ.
Dialogue: 0,0:10:36.52,0:10:39.16,Caption,,0,0,0,,ЕСЛИ СОБРАТЬ ПУБЛИЧНЫЕ ОБВИНЕНИЯ ИСПАНСКИХ ПАРТИЙ
Dialogue: 0,0:10:39.24,0:10:41.16,Caption,,0,0,0,,ДРУГ ПРОТИВ ДРУГА В СВЯЗЯХ С МОСКВОЙ,
Dialogue: 0,0:10:41.56,0:10:43.48,Caption,,0,0,0,,ПОД ПОДОЗРЕНИЕМ ОКАЗЫВАЮТСЯ СИЛЫ,
Dialogue: 0,0:10:43.61,0:10:46.52,Caption,,0,0,0,,КОНТРОЛИРУЮЩИЕ ТРИСТА СОРОК ТРИ МЕСТА ИЗ ТРЁХСОТ
Dialogue: 0,0:10:46.52,0:10:49.16,Caption,,0,0,0,,ПЯТИДЕСЯТИ. ОКОЛО ДЕВЯНОСТА ВОСЬМИ ПРОЦЕНТОВ
Dialogue: 0,0:10:49.16,0:10:53.72,Caption,,0,0,0,,ПАРЛАМЕНТА. ТО ЕСТЬ РОССИЯ, ЕСЛИ ВЕРИТЬ ВСЕМ ЭТИМ ОБВИНЕНИЯМ ОДНОВРЕМЕННО,
Dialogue: 0,0:10:54.02,0:10:55.96,Caption,,0,0,0,,УМУДРЯЕТСЯ КОНТРОЛИРОВАТЬ ПРАВЫХ,
Dialogue: 0,0:10:56.05,0:10:58.28,Caption,,0,0,0,,ЛЕВЫХ И ЕЩЁ РЕГИОНАЛЬНЫХ СЕПАРАТИСТОВ,
Dialogue: 0,0:10:58.60,0:11:01.32,Caption,,0,0,0,,КОТОРЫЕ МЕЖДУ СОБОЙ РЕГУЛЯРНО ГРЫЗУТСЯ. ТАЛАНТ
Dialogue: 0,0:11:01.40,0:11:04.44,Caption,,0,0,0,,УПРАВЛЕНИЯ ПРОСТО ВЫДАЮЩИЙСЯ. ОСТАЛОСЬ НАЙТИ СЕМЬ
Dialogue: 0,0:11:04.44,0:11:07.56,Caption,,0,0,0,,ДЕПУТАТОВ, КОТОРЫЕ ПОЧЕМУ ТО ВЫПАЛИ ИЗ МОСКОВСКОГО ОТДЕЛА
Dialogue: 0,0:11:07.56,0:11:10.68,Caption,,0,0,0,,КАДРОВ. САМ МАСШТАБ УЖЕ НАЧИНАЕТ РАБОТАТЬ ПРОТИВ
Dialogue: 0,0:11:10.68,0:11:13.56,Caption,,0,0,0,,ОБВИНИТЕЛЕЙ. КОГДА ОДИН И ТОТ ЖЕ ЯРЛЫК ПРИКЛЕИВАЮТ
Dialogue: 0,0:11:13.56,0:11:15.24,Caption,,0,0,0,,ПРАКТИЧЕСКИ КО ВСЕМ ПРОТИВНИКАМ,
Dialogue: 0,0:11:15.55,0:11:18.60,Caption,,0,0,0,,ВОПРОС ПОСТЕПЕННО МЕНЯЕТСЯ. УЖЕ НЕ "КТО СВЯЗАН С
Dialogue: 0,0:11:18.60,0:11:21.88,Caption,,0,0,0,,МОСКВОЙ", А "КТО СЛЕДУЮЩИМ ДОСТАНЕТ МОСКВУ ИЗ КАРМАНА,
Dialogue: 0,0:11:22.04,0:11:25.08,Caption,,0,0,0,,ЧТОБЫ УДАРИТЬ ЕЙ ПОЛИТИЧЕСКОГО КОНКУРЕНТА". НА ЭТОМ
Dialogue: 0,0:11:25.08,0:11:27.96,Caption,,0,0,0,,ФОНЕ ЕВРОКОМИССИЯ ГОТОВИТ УКРАИНЕ ЕЩЁ ОДИН КРЕДИТ,
Dialogue: 0,0:11:28.20,0:11:30.76,Caption,,0,0,0,,СОРОК ПЯТЬ МИЛЛИАРДОВ ЕВРО В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ
Dialogue: 0,0:11:30.76,0:11:33.40,Caption,,0,0,0,,СЕДЬМОМ ГОДУ. ДВАДЦАТЬ ПЯТЬ МИЛЛИАРДОВ ХОТЯТ
Dialogue: 0,0:11:33.48,0:11:35.88,Caption,,0,0,0,,НАПРАВИТЬ НА ВОЕННЫЕ НУЖДЫ. ЕЩЁ ДВАДЦАТЬ НА
Dialogue: 0,0:11:35.88,0:11:39.16,Caption,,0,0,0,,СОДЕРЖАНИЕ УКРАИНСКОГО БЮДЖЕТА. УРСУЛА ФОН ДЕР ЛЯЙЕН
Dialogue: 0,0:11:39.16,0:11:42.44,Caption,,0,0,0,,ГОВОРИТ, ЧТО УКРАИНА ДОЛЖНА БУДЕТ ПОГАСИТЬ КРЕДИТ ТОЛЬКО
Dialogue: 0,0:11:42.44,0:11:45.16,Caption,,0,0,0,,ПОСЛЕ ТОГО, КАК РОССИЯ ВЫПЛАТИТ РЕПАРАЦИИ.
Dialogue: 0,0:11:47.44,0:11:51.36,Caption,,0,0,0,,ТО ЕСТЬ ДЕНЬГИ НУЖНЫ СЕЙЧАС, ВОЗВРАТ ПРИВЯЗЫВАЮТ К СОБЫТИЮ В БУДУЩЕМ,
Dialogue: 0,0:11:51.58,0:11:54.16,Caption,,0,0,0,,А ГАРАНТИИ ПРЕДЛАГАЮТ ДАТЬ ЧЕРЕЗ ОБЩИЙ БЮДЖЕТ
Dialogue: 0,0:11:54.16,0:11:57.28,Caption,,0,0,0,,ЕВРОСОЮЗА. ДО ЭТОГО УЖЕ БЫЛ ЗАЁМ НА ДЕВЯНОСТО
Dialogue: 0,0:11:57.28,0:11:59.68,Caption,,0,0,0,,МИЛЛИАРДОВ ЕВРО. НОВЫЙ КРЕДИТ ПРЕДЛАГАЮТ
Dialogue: 0,0:11:59.68,0:12:01.52,Caption,,0,0,0,,ОБЕСПЕЧИВАТЬ ПО ПОХОЖЕМУ ПРИНЦИПУ.
Dialogue: 0,0:12:02.08,0:12:04.88,Caption,,0,0,0,,ВАЛДИС ДОМБРОВСКИС ОБЪЯСНЯЕТ ПОТРЕБНОСТЬ УСИЛЕНИЕМ
Dialogue: 0,0:12:04.96,0:12:07.76,Caption,,0,0,0,,РОССИЙСКИХ УДАРОВ ПО КРИТИЧЕСКОЙ ИНФРАСТРУКТУРЕ И
Dialogue: 0,0:12:07.76,0:12:11.92,Caption,,0,0,0,,ПРОБЛЕМАМИ ТОРГОВЛИ, ОСОБЕННО ЭКСПОРТА ЧЕРЕЗ ЧЁРНОЕ МОРЕ. НО ДАЛЬШЕ
Dialogue: 0,0:12:11.92,0:12:15.04,Caption,,0,0,0,,НАЧИНАЕТСЯ ЛЮБИМАЯ ЧАСТЬ ЛЮБОГО ОБЩЕГО ЕВРОПЕЙСКОГО
Dialogue: 0,0:12:15.04,0:12:20.48,Caption,,0,0,0,,ПРОЕКТА. ЧЕХИЯ, СЛОВАКИЯ, ВЕНГРИЯ И БОЛГАРИЯ ОТКАЗАЛИСЬ УЧАСТВОВАТЬ В
Dialogue: 0,0:12:20.48,0:12:23.36,Caption,,0,0,0,,ДАЛЬНЕЙШЕМ ФИНАНСИРОВАНИИ УКРАИНЫ. ГЕРМАНИЯ,
Dialogue: 0,0:12:23.44,0:12:27.20,Caption,,0,0,0,,НАОБОРОТ, ТРЕБУЕТ ОТ ОСТАЛЬНЫХ ГАРАНТИЙ УЧАСТИЯ И УГРОЖАЕТ
Dialogue: 0,0:12:27.20,0:12:29.68,Caption,,0,0,0,,ЗАБЛОКИРОВАТЬ БЮДЖЕТ ЕВРОСОЮЗА НА ПЕРИОД С ДВЕ
Dialogue: 0,0:12:29.76,0:12:32.24,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ПО ДВЕ ТЫСЯЧИ ТРИДЦАТЬ
Dialogue: 0,0:12:32.24,0:12:35.28,Caption,,0,0,0,,ЧЕТВЁРТЫЙ ГОД. ВОТ ВАМ И ПРАКТИЧЕСКИЙ СМЫСЛ СЛОВА
Dialogue: 0,0:12:35.28,0:12:37.68,Caption,,0,0,0,,"СОЛИДАРНОСТЬ". КОГДА НУЖНО ПОДПИСАТЬСЯ ПОД
Dialogue: 0,0:12:37.76,0:12:40.72,Caption,,0,0,0,,ГАРАНТИЯМИ, НЕКОТОРЫЕ ПАССАЖИРЫ ВНЕЗАПНО ВСПОМИНАЮТ,
Dialogue: 0,0:12:40.94,0:12:44.00,Caption,,0,0,0,,ЧТО СОБИРАЛИСЬ ТОЛЬКО ПОСМОТРЕТЬ НА ВОДУ. ДЛЯ КИЕВА
Dialogue: 0,0:12:44.08,0:12:46.72,Caption,,0,0,0,,ЭТО НЕ ФИЛОСОФИЯ. ЕСЛИ СПОР О ГАРАНТИЯХ
Dialogue: 0,0:12:46.72,0:12:50.80,Caption,,0,0,0,,ЗАТЯГИВАЕТСЯ, ЗАТЯГИВАЕТСЯ И СОГЛАСОВАНИЕ ДЕНЕГ. ЕВРОПЕЙСКИЕ
Dialogue: 0,0:12:50.80,0:12:52.88,Caption,,0,0,0,,ЛИДЕРЫ МОГУТ СКОЛЬКО УГОДНО ПОВТОРЯТЬ СЛОВО
Dialogue: 0,0:12:52.88,0:12:56.08,Caption,,0,0,0,,"ПОДДЕРЖКА". УКРАИНСКОМУ МИНФИНУ НУЖНА НЕ ПОДДЕРЖКА
Dialogue: 0,0:12:56.16,0:12:58.64,Caption,,0,0,0,,В МИКРОФОН, А ДАТА ПОСТУПЛЕНИЯ СРЕДСТВ.
Dialogue: 0,0:13:00.84,0:13:03.40,Caption,,0,0,0,,И ОДНОВРЕМЕННО ЕВРОСОЮЗ ПЕРЕДЕЛЫВАЕТ СОБСТВЕННЫЙ
Dialogue: 0,0:13:03.40,0:13:06.52,Caption,,0,0,0,,ДОЛГОСРОЧНЫЙ БЮДЖЕТ. В ПРОЕКТЕ АНТОНИУ КОШТЫ НА
Dialogue: 0,0:13:06.52,0:13:08.52,Caption,,0,0,0,,ПЕРИОД С ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВОСЬМОГО ПО ДВЕ
Dialogue: 0,0:13:08.60,0:13:11.24,Caption,,0,0,0,,ТЫСЯЧИ ТРИДЦАТЬ ЧЕТВЁРТЫЙ ГОД ОБОРОННЫЕ РАСХОДЫ
Dialogue: 0,0:13:11.24,0:13:13.96,Caption,,0,0,0,,ХОТЯТ УВЕЛИЧИТЬ НА ДВЕСТИ ТРИДЦАТЬ ДВА ПРОЦЕНТА.
Dialogue: 0,0:13:14.12,0:13:17.08,Caption,,0,0,0,,БОЛЬШЕ ЧЕМ ВТРОЕ. ПРИ ЭТОМ ОБЩИЙ ОБЪЁМ БЮДЖЕТА
Dialogue: 0,0:13:17.16,0:13:20.20,Caption,,0,0,0,,УРЕЗАН НА ДВЕСТИ ЧЕТЫРЕ МИЛЛИАРДА ЕВРО ПО СРАВНЕНИЮ
Dialogue: 0,0:13:20.28,0:13:22.44,Caption,,0,0,0,,С ПЕРВОНАЧАЛЬНЫМ ПРЕДЛОЖЕНИЕМ ЕВРОКОМИССИИ.
Dialogue: 0,0:13:22.73,0:13:25.00,Caption,,0,0,0,,ЭКОНОМИТЬ СОБИРАЮТСЯ В ТОМ ЧИСЛЕ НА ПРОГРАММАХ
Dialogue: 0,0:13:25.00,0:13:28.20,Caption,,0,0,0,,РЕГИОНАЛЬНОГО РАЗВИТИЯ. ВЫБОР КОНКРЕТНЫЙ. ОБОРОНА
Dialogue: 0,0:13:28.20,0:13:30.92,Caption,,0,0,0,,РАСТЁТ В РАЗЫ, ОБЩИЙ БЮДЖЕТ УМЕНЬШАЕТСЯ,
Dialogue: 0,0:13:31.16,0:13:34.20,Caption,,0,0,0,,ЭКОНОМИТЬ ПРЕДЛАГАЮТ В ТОМ ЧИСЛЕ НА РЕГИОНАХ. ПУТИН
Dialogue: 0,0:13:34.20,0:13:37.24,Caption,,0,0,0,,НАЗЫВАЕТ ЕВРОПЕЙСКУЮ МИЛИТАРИЗАЦИЮ СЕРЬЁЗНЫМ ВЫЗОВОМ
Dialogue: 0,0:13:37.32,0:13:39.08,Caption,,0,0,0,,ДЛЯ РОССИИ И ОТДЕЛЬНО ГОВОРИТ,
Dialogue: 0,0:13:39.24,0:13:42.20,Caption,,0,0,0,,ЧТО САМИ ЕВРОПЕЙЦЫ НЕ ХОТЯТ НИ МИЛИТАРИЗАЦИИ,
Dialogue: 0,0:13:42.29,0:13:45.00,Caption,,0,0,0,,НИ ВОЙН. МОЖНО СПОРИТЬ С ЕГО ОЦЕНКОЙ СКОЛЬКО
Dialogue: 0,0:13:45.08,0:13:48.28,Caption,,0,0,0,,УГОДНО, НО ЕВРОПЕЙСКИЙ БЮДЖЕТНЫЙ ДОКУМЕНТ ДАЁТ КУДА БОЛЕЕ
Dialogue: 0,0:13:48.28,0:13:50.92,Caption,,0,0,0,,ПРИЗЕМЛЁННЫЙ ВОПРОС. ЕСЛИ ОБОРОННУЮ СТРОКУ
Dialogue: 0,0:13:50.92,0:13:53.40,Caption,,0,0,0,,УВЕЛИЧИВАЮТ НА ДВЕСТИ ТРИДЦАТЬ ДВА ПРОЦЕНТА ПРИ
Dialogue: 0,0:13:53.40,0:13:57.08,Caption,,0,0,0,,СОКРАЩЕНИИ ОБЩЕЙ СУММЫ, КТО ИМЕННО УСТУПАЕТ ЕЙ МЕСТО?
Dialogue: 0,0:13:57.64,0:14:00.20,Caption,,0,0,0,,У КАЖДОЙ ИЗ ЭТИХ ИСТОРИЙ СВОЙ МЕХАНИЗМ. ОБЩИЙ
Dialogue: 0,0:14:00.20,0:14:03.00,Caption,,0,0,0,,ВОПРОС ПРЕДЕЛЬНО ЗЕМНОЙ КТО ПОЛУЧАЕТ ПРАВО ПРИНЯТЬ
Dialogue: 0,0:14:03.00,0:14:05.56,Caption,,0,0,0,,БОЛЬШОЕ РЕШЕНИЕ И КТО ПОТОМ ПОЛУЧАЕТ СЧЁТ?
Dialogue: 0,0:14:05.83,0:14:08.20,Caption,,0,0,0,,ПОТОМУ ЧТО ДОГОВОРИТЬСЯ О КРАСИВОЙ ФОРМУЛИРОВКЕ
Dialogue: 0,0:14:08.28,0:14:11.16,Caption,,0,0,0,,ОБЫЧНО ЛЕГЧЕ ВСЕГО. СКАЗАТЬ "ПОДДЕРЖИМ" ТОЖЕ
Dialogue: 0,0:14:11.16,0:14:16.41,Caption,,0,0,0,,НЕСЛОЖНО. НАСТОЯЩАЯ ДРАКА НАЧИНАЕТСЯ В ТОТ МОМЕНТ,
Dialogue: 0,0:14:16.65,0:14:18.89,Caption,,0,0,0,,КОГДА РЯДОМ ПОЯВЛЯЕТСЯ СТРОКА "ГАРАНТ",
Dialogue: 0,0:14:19.03,0:14:21.53,Caption,,0,0,0,,СУММА И ПОДПИСЬ. И СУДЯ ПО ТОМУ,
Dialogue: 0,0:14:21.71,0:14:24.57,Caption,,0,0,0,,КАК БЫСТРО ЕВРОПЕЙСКИЕ СТРАНЫ НАЧИНАЮТ СЧИТАТЬ СВОЮ
Dialogue: 0,0:14:24.65,0:14:28.01,Caption,,0,0,0,,ДОЛЮ, СЛЕДУЮЩИЙ СПОР БУДЕТ УЖЕ НЕ О ГРОМКОСТИ ОБЕЩАНИЙ.
Dialogue: 0,0:14:28.25,0:14:32.25,Caption,,0,0,0,,ОН БУДЕТ О ТОМ, КОМУ ИМЕННО ПРИДЁТСЯ ПОСТАВИТЬ ПОДПИСЬ ПОД СЧЁТОМ.
