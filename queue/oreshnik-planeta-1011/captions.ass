Dialogue: 0,0:00:00.12,0:00:01.80,Caption,,0,0,0,,"ОРЕШНИК БУДУТ СБИВАТЬ В КОСМОСЕ".
Dialogue: 0,0:00:02.40,0:00:05.00,Caption,,0,0,0,,ЗАГОЛОВОК УЖЕ ГОТОВ, ЗРИТЕЛЬ УДИВЛЁН,
Dialogue: 0,0:00:05.24,0:00:06.92,Caption,,0,0,0,,ЧИНОВНИК ВЫГЛЯДИТ ПОБЕДИТЕЛЕМ,
Dialogue: 0,0:00:07.08,0:00:09.56,Caption,,0,0,0,,ХОТЯ САМОЙ СИСТЕМЫ ЕМУ ПОКА НИКТО НЕ ПОКАЗАЛ.
Dialogue: 0,0:00:09.99,0:00:12.52,Caption,,0,0,0,,УДОБНАЯ КОНСТРУКЦИЯ СНАЧАЛА ОБЪЯВЛЯЕШЬ ПОБЕДУ ЗА
Dialogue: 0,0:00:12.52,0:00:16.20,Caption,,0,0,0,,ПРЕДЕЛАМИ АТМОСФЕРЫ, А ПОТОМ НА ЗЕМЛЕ СПОКОЙНО ИЩЕШЬ ВСЁ,
Dialogue: 0,0:00:16.36,0:00:19.24,Caption,,0,0,0,,БЕЗ ЧЕГО ОНА НЕ СОСТОИТСЯ. ГДЕ САМА СИСТЕМА?
Dialogue: 0,0:00:19.64,0:00:22.28,Caption,,0,0,0,,В ОТВЕТ МОЖНО ПОЛУЧИТЬ ЦЕЛЫЙ ВАГОН ПРАВИЛЬНЫХ СЛОВ.
Dialogue: 0,0:00:22.68,0:00:25.48,Caption,,0,0,0,,РАЗРАБОТКА ИДЁТ, ЗАДАЧА БЕСПРЕЦЕДЕНТНАЯ,
Dialogue: 0,0:00:25.67,0:00:30.44,Caption,,0,0,0,,СПЕЦИАЛИСТЫ ТРУДЯТСЯ, ИСПЫТАНИЯ ПРОДОЛЖАЮТСЯ. ЧЕМ ВЫШЕ ОБЕЩАННЫЙ РУБЕЖ
Dialogue: 0,0:00:30.44,0:00:33.80,Caption,,0,0,0,,ПЕРЕХВАТА, ТЕМ ТРУДНЕЕ ОБЫЧНОМУ ЧЕЛОВЕКУ ЗАГЛЯНУТЬ ТУДА И
Dialogue: 0,0:00:33.80,0:00:37.08,Caption,,0,0,0,,СПРОСИТЬ, ПОЧЕМУ НА ЭТОМ РУБЕЖЕ ОПЯТЬ НИЧЕГО НЕ ВИДНО.
Dialogue: 0,0:00:37.62,0:00:41.80,Caption,,0,0,0,,КОСМОС БОЛЬШОЙ, ОТЧЁТ ПОМЕСТИТСЯ. ДЛЯ БЮДЖЕТА ЭТО ПОЧТИ КУРОРТ.
Dialogue: 0,0:00:42.28,0:00:44.12,Caption,,0,0,0,,ГОТОВОГО РЕЗУЛЬТАТА СЕГОДНЯ НЕТ,
Dialogue: 0,0:00:44.36,0:00:47.56,Caption,,0,0,0,,ЗАТО ЕСТЬ ПРИЧИНА ОПЛАТИТЬ СЛЕДУЮЩИЙ ЭТАП. ЗАТЕМ
Dialogue: 0,0:00:47.56,0:00:50.36,Caption,,0,0,0,,ПОНАДОБИТСЯ ДРУГОЙ ДВИГАТЕЛЬ, НОВАЯ ЭЛЕКТРОНИКА,
Dialogue: 0,0:00:50.53,0:00:55.24,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНЫЙ ЦЕНТР, МЕЖДУНАРОДНАЯ КООПЕРАЦИЯ И ЕЩЁ ОДИН РАУНД РАБОТ.
Dialogue: 0,0:00:55.62,0:00:58.04,Caption,,0,0,0,,СРОК МОЖНО ОТОДВИНУТЬ, СМЕТУ РАСШИРИТЬ,
Dialogue: 0,0:00:58.33,0:01:01.16,Caption,,0,0,0,,А ЛЮБОЙ НЕУДОБНЫЙ ВОПРОС ОТПРАВИТЬ НА ОРБИТУ ВСЛЕД
Dialogue: 0,0:01:01.24,0:01:04.44,Caption,,0,0,0,,ЗА ПРЕЖНИМ ТРАНШЕМ. ПРИ ЭТОМ ЗЕМНОЙ СПИСОК ПОКУПОК
Dialogue: 0,0:01:04.44,0:01:07.88,Caption,,0,0,0,,НИКУДА НЕ ИСЧЕЗАЕТ. НУЖНЫ ПРОИЗВОДСТВЕННЫЕ ПЛОЩАДКИ,
Dialogue: 0,0:01:08.10,0:01:11.40,Caption,,0,0,0,,РАДАРЫ, СИСТЕМА НАВЕДЕНИЯ, ПУСКОВАЯ ЧАСТЬ,
Dialogue: 0,0:01:11.56,0:01:14.84,Caption,,0,0,0,,ЭЛЕКТРОНИКА И ОБУЧЕННЫЕ ЛЮДИ. ВСЁ ЭТО ТРЕБУЕТСЯ
Dialogue: 0,0:01:14.84,0:01:21.91,Caption,,0,0,0,,СОЗДАТЬ, СВЯЗАТЬ И ПРОВЕРИТЬ. ОДНОЙ ФРАЗОЙ О ПЕРЕХВАТЕ АТМОСФЕРУ НЕ ПРОШЬЁШЬ,
Dialogue: 0,0:01:22.03,0:01:24.15,Caption,,0,0,0,,ХОТЯ БЮДЖЕТНАЯ ЗАЯВКА, ПОХОЖЕ,
Dialogue: 0,0:01:24.30,0:01:29.27,Caption,,0,0,0,,ПРОХОДИТ ЕЁ БЕЗ НАГРЕВА. УКРАИНА СООБЩАЕТ УЖЕ О ТРЁХ ИСПЫТАНИЯХ. ЗАДАЧА
Dialogue: 0,0:01:29.27,0:01:31.91,Caption,,0,0,0,,ЗАЯВЛЕНА КОНКРЕТНО РОССИЙСКИЙ "ОРЕШНИК" ХОТЯТ
Dialogue: 0,0:01:31.91,0:01:36.71,Caption,,0,0,0,,ПЕРЕХВАТЫВАТЬ ТАМ, ГДЕ ОН НАХОДИТСЯ ЗА ПРЕДЕЛАМИ АТМОСФЕРЫ. САМ МАСШТАБ
Dialogue: 0,0:01:36.79,0:01:39.83,Caption,,0,0,0,,ВЫБРАН БЕЗ ЗАСТЕНЧИВОСТИ. ПОКА У ОДНИХ ИНЖЕНЕРОВ
Dialogue: 0,0:01:39.83,0:01:42.07,Caption,,0,0,0,,РАКЕТА ПОДНИМАЕТСЯ НА ОГРОМНУЮ ВЫСОТУ,
Dialogue: 0,0:01:42.31,0:01:44.87,Caption,,0,0,0,,У ДРУГИХ ЧИНОВНИКОВ РУКА ПОДНИМАЕТСЯ ЗА НОВЫМ
Dialogue: 0,0:01:44.87,0:01:48.15,Caption,,0,0,0,,ФИНАНСИРОВАНИЕМ. ОБЕ ТРАЕКТОРИИ ВЫГЛЯДЯТ УВЕРЕННО.
Dialogue: 0,0:01:48.70,0:01:51.27,Caption,,0,0,0,,ВСЯ ПРЕЛЕСТЬ ТАКОГО ПРОЕКТА В РАССТОЯНИИ МЕЖДУ
Dialogue: 0,0:01:51.27,0:01:54.15,Caption,,0,0,0,,ОБЕЩАНИЕМ И ПРОВЕРКОЙ. ЧЕМ ДАЛЬШЕ ИТОГ,
Dialogue: 0,0:01:54.39,0:01:57.11,Caption,,0,0,0,,ТЕМ ДОЛЬШЕ МОЖНО ОБЪЯСНЯТЬ ПРОМЕЖУТОЧНЫЕ УСПЕХИ.
Dialogue: 0,0:01:57.43,0:02:00.71,Caption,,0,0,0,,СЕГОДНЯ ТРИ ИСПЫТАНИЯ, ЗАВТРА ДОРАБОТКА КОМПЛЕКСА,
Dialogue: 0,0:02:00.87,0:02:04.31,Caption,,0,0,0,,ЗАТЕМ НОВАЯ ВЕРСИЯ. ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ ЛЮБОЙ ВОПРОС
Dialogue: 0,0:02:04.31,0:02:07.03,Caption,,0,0,0,,О РЕЗУЛЬТАТЕ МОЖНО ВСТРЕТИТЬ СУРОВЫМ ЛИЦОМ ЧЕЛОВЕКА,
Dialogue: 0,0:02:07.27,0:02:10.15,Caption,,0,0,0,,КОТОРОМУ МЕШАЮТ СПАСАТЬ ПЛАНЕТУ МЕЛКИМИ ПРИДИРКАМИ.
Dialogue: 0,0:02:10.50,0:02:12.47,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА "ПЛАНЕТУ". ПРОВЕРИМ,
Dialogue: 0,0:02:12.70,0:02:15.11,Caption,,0,0,0,,ПОЯВИЛСЯ ЛИ ЗА ГРОМКИМ ЗАГОЛОВКОМ РАБОТАЮЩИЙ
Dialogue: 0,0:02:15.19,0:02:18.95,Caption,,0,0,0,,МЕХАНИЗМ, ИЛИ НА ОРБИТУ ПОКА ВЫШЛА ТОЛЬКО СМЕТА. НАУЧНАЯ
Dialogue: 0,0:02:18.95,0:02:21.35,Caption,,0,0,0,,ФАНТАСТИКА ОБЫЧНО ЧЕСТНО ПИШЕТ НА АФИШЕ,
Dialogue: 0,0:02:21.59,0:02:25.19,Caption,,0,0,0,,ЧТО ПЕРЕД НАМИ ВЫДУМАННЫЙ МИР. ЗДЕСЬ ЖАНР СКРОМНЕЕ,
Dialogue: 0,0:02:25.43,0:02:27.43,Caption,,0,0,0,,ЕГО НАЗЫВАЮТ ПРОГРАММОЙ РАЗРАБОТКИ.
Dialogue: 0,0:02:27.98,0:02:32.63,Caption,,0,0,0,,ОСТАЛОСЬ НАЗНАЧИТЬ ЭКИПАЖ, ВЫДАТЬ ЕМУ СЕРЕБРИСТЫЕ КОМБИНЕЗОНЫ И ОБЪЯСНИТЬ,
Dialogue: 0,0:02:32.79,0:02:35.43,Caption,,0,0,0,,ЧТО НЕПРИЯТЕЛЬСКИЙ АППАРАТ НАДО ЖДАТЬ ЧУТЬ ЛЕВЕЕ
Dialogue: 0,0:02:35.43,0:02:38.59,Caption,,0,0,0,,ЛУНЫ. ПРАВДА,
Dialogue: 0,0:02:38.67,0:02:40.91,Caption,,0,0,0,,ЗАВОДЫ И СПЕЦИАЛИСТЫ ВСЁ РАВНО ПОНАДОБЯТСЯ
Dialogue: 0,0:02:40.91,0:02:43.95,Caption,,0,0,0,,НАСТОЯЩИЕ. С НЕБЕС СПУСКАЕМСЯ К ПРЕДПРИЯТИЯМ,
Dialogue: 0,0:02:44.19,0:02:46.59,Caption,,0,0,0,,ГДЕ НОВОЕ РЕШЕНИЕ УЖЕ МОЖНО ПОТРОГАТЬ РУКАМИ,
Dialogue: 0,0:02:46.98,0:02:48.99,Caption,,0,0,0,,А ПРИ НЕУДАЧЕ ЕЩЁ И СОБРАТЬ С СОСЕДНЕЙ
Dialogue: 0,0:02:48.99,0:02:52.43,Caption,,0,0,0,,КРЫШИ. ПОЧТИ СТО УКРАИНСКИХ КОМПАНИЙ ПРИСОЕДИНИЛИСЬ
Dialogue: 0,0:02:52.43,0:02:55.07,Caption,,0,0,0,,К СИСТЕМЕ СОБСТВЕННОЙ ПРОТИВОВОЗДУШНОЙ ОБОРОНЫ.
Dialogue: 0,0:02:55.71,0:02:58.59,Caption,,0,0,0,,НИЖНЮЮ ВОЗРАСТНУЮ ПЛАНКУ ДЛЯ УЧАСТНИКОВ ОПУСТИЛИ ДО
Dialogue: 0,0:02:58.59,0:03:03.15,Caption,,0,0,0,,ВОСЕМНАДЦАТИ ЛЕТ. ВИДИМО, СОВЕРШЕННОЛЕТИЕ ТЕПЕРЬ АВТОМАТИЧЕСКИ ОТКРЫВАЕТ
Dialogue: 0,0:03:03.15,0:03:06.59,Caption,,0,0,0,,СКРЫТЫЙ НАВЫК РАСПОЗНАВАНИЯ ВОЗДУШНЫХ ЦЕЛЕЙ. ГЛАВНЫЙ
Dialogue: 0,0:03:06.59,0:03:10.91,Caption,,0,0,0,,ВОПРОС ЗДЕСЬ НЕ В ТОМ, МОЖНО ЛИ ПОСТАВИТЬ ОРУЖИЕ ВОЗЛЕ ПРОХОДНОЙ. ПОСТАВИТЬ
Dialogue: 0,0:03:10.99,0:03:16.11,Caption,,0,0,0,,МОЖНО МНОГОЕ. ИНТЕРЕСНЕЕ, КТО ПРИМЕТ РЕШЕНИЕ ОТКРЫТЬ ОГОНЬ НАД ГОРОДОМ И
Dialogue: 0,0:03:16.19,0:03:20.51,Caption,,0,0,0,,КТО ОТВЕТИТ, ЕСЛИ РАСЧЁТ ОШИБЁТСЯ. ПОД ЦЕЛЬЮ НАХОДЯТСЯ ДОМА,
Dialogue: 0,0:03:20.66,0:03:25.31,Caption,,0,0,0,,ДОРОГИ, МАШИНЫ И ЛЮДИ. ПОСЛЕ ПОПАДАНИЯ ОБЛОМКИ НЕ ПОЛУЧАЮТ
Dialogue: 0,0:03:25.31,0:03:28.43,Caption,,0,0,0,,ВЕЖЛИВУЮ ИНСТРУКЦИЮ УПАСТЬ СТРОГО НА ПУСТЫРЬ. ДЛЯ
Dialogue: 0,0:03:28.51,0:03:30.83,Caption,,0,0,0,,ЭТОЙ РАБОТЫ НУЖЕН НЕ ОХРАННИК С ХОРОШИМ ЗРЕНИЕМ,
Dialogue: 0,0:03:31.06,0:03:34.19,Caption,,0,0,0,,А ПОДГОТОВЛЕННЫЙ СПЕЦИАЛИСТ. ОН ДОЛЖЕН РАСПОЗНАТЬ
Dialogue: 0,0:03:34.19,0:03:36.59,Caption,,0,0,0,,ОБЪЕКТ, ОЦЕНИТЬ НАПРАВЛЕНИЕ ПОЛЁТА,
Dialogue: 0,0:03:36.88,0:03:39.63,Caption,,0,0,0,,УЧЕСТЬ СОСЕДНИЕ ЗДАНИЯ И ПОНИМАТЬ ВОЗМОЖНОСТИ
Dialogue: 0,0:03:39.63,0:03:41.95,Caption,,0,0,0,,ОРУЖИЯ. ОШИБКА ДЛИТСЯ СЕКУНДУ,
Dialogue: 0,0:03:42.28,0:03:44.35,Caption,,0,0,0,,А ПОСЛЕДСТВИЯ ПОТОМ ИЗУЧАЮТ МЕСЯЦАМИ.
Dialogue: 0,0:03:46.62,0:03:49.27,Caption,,0,0,0,,ПОВЫШЕНИЕ ИЗ БУДКИ НА ПРОХОДНОЙ ДО КОМАНДИРА ПВО
Dialogue: 0,0:03:49.27,0:03:51.99,Caption,,0,0,0,,ВЫГЛЯДИТ БОДРО ТОЛЬКО В ПРИКАЗЕ ОТДЕЛА КАДРОВ,
Dialogue: 0,0:03:52.07,0:03:54.87,Caption,,0,0,0,,ПРИМЕРНО КАК ЕСЛИ СТОРОЖУ ВЧЕРА ВРУЧИЛИ ЗЕНИТКУ,
Dialogue: 0,0:03:55.03,0:03:57.43,Caption,,0,0,0,,А ВОРОБЬЯМ НА СОСЕДНЕМ ДЕРЕВЕ ОБ ЭТОМ ЗАБЫЛИ
Dialogue: 0,0:03:57.43,0:04:01.27,Caption,,0,0,0,,СООБЩИТЬ. СПЕЦИАЛИСТЫ ТАКОГО УРОВНЯ УЖЕ НУЖНЫ АРМИИ.
Dialogue: 0,0:04:01.59,0:04:04.87,Caption,,0,0,0,,НЕ КОГДА ОСВОБОДЯТСЯ, НЕ ПОСЛЕ КУРСОВ В УДОБНЫЙ СЕЗОН,
Dialogue: 0,0:04:04.95,0:04:09.27,Caption,,0,0,0,,А СЕЙЧАС. НОВАЯ СЕТЬ ПРЕДПРИЯТИЙ СОЗДАЁТ ДОПОЛНИТЕЛЬНЫЙ СПРОС
Dialogue: 0,0:04:09.35,0:04:12.23,Caption,,0,0,0,,НА ТЕХ ЖЕ ЛЮДЕЙ. ПОЧТИ СТО УЧАСТНИКОВ ЗВУЧАТ
Dialogue: 0,0:04:12.23,0:04:16.07,Caption,,0,0,0,,ВНУШИТЕЛЬНО, НО ЗА КАЖДОЙ УСТАНОВКОЙ ТРЕБУЕТСЯ РАСЧЁТ. ЕСЛИ
Dialogue: 0,0:04:16.15,0:04:18.87,Caption,,0,0,0,,КОМПАНИЙ СТАНЕТ ДВЕСТИ, ТРИСТА ИЛИ ПЯТЬСОТ,
Dialogue: 0,0:04:19.19,0:04:22.15,Caption,,0,0,0,,ОБУЧЕННЫЕ КАДРЫ НЕ РАЗМНОЖАТСЯ ОТ УВАЖЕНИЯ К КРУГЛЫМ
Dialogue: 0,0:04:22.23,0:04:24.95,Caption,,0,0,0,,ЧИСЛАМ. ТУТ ЖЕ ВОЗНИКАЕТ ПРОБЛЕМА ДОБРОВОЛЬЦЕВ.
Dialogue: 0,0:04:25.35,0:04:28.87,Caption,,0,0,0,,МУЖЧИН НЕ ХВАТАЕТ НА ФРОНТЕ, МОБИЛИЗАЦИЯ ПРОДОЛЖАЕТСЯ,
Dialogue: 0,0:04:29.11,0:04:31.67,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЕ ЦЕНТРЫ КОМПЛЕКТОВАНИЯ СВОЮ РАБОТУ НЕ
Dialogue: 0,0:04:31.75,0:04:34.39,Caption,,0,0,0,,ПРЕКРАЩАЮТ. И ЧЕЛОВЕКУ ПРЕДЛАГАЮТ ОФИЦИАЛЬНО
Dialogue: 0,0:04:34.39,0:04:36.15,Caption,,0,0,0,,ВСТУПИТЬ В ВООРУЖЁННУЮ ГРУППУ,
Dialogue: 0,0:04:36.39,0:04:40.71,Caption,,0,0,0,,ПРЕДЪЯВИТЬ ЗДОРОВЬЕ, ПОДГОТОВКУ И ПОЛЕЗНЫЕ НАВЫКИ. ДЛЯ ТОГО,
Dialogue: 0,0:04:40.95,0:04:42.71,Caption,,0,0,0,,КТО МЕСЯЦАМИ ПРЯЧЕТСЯ ОТ ПОВЕСТКИ,
Dialogue: 0,0:04:43.03,0:04:45.27,Caption,,0,0,0,,ЭТО ПРИГЛАШЕНИЕ ЗВУЧИТ ПРИМЕРНО КАК БЕСПЛАТНАЯ
Dialogue: 0,0:04:45.27,0:04:48.15,Caption,,0,0,0,,ФОТОСЕССИЯ В КАБИНЕТЕ ВОЕНКОМА. МОЖНО НАБИРАТЬ
Dialogue: 0,0:04:48.15,0:04:51.35,Caption,,0,0,0,,ЖЕНЩИН. СРЕДИ НИХ ЕСТЬ ВОЕННОСЛУЖАЩИЕ И ГРАМОТНЫЕ
Dialogue: 0,0:04:51.35,0:04:55.27,Caption,,0,0,0,,СПЕЦИАЛИСТЫ, КОТОРЫЕ УМЕЮТ ОБРАЩАТЬСЯ С ТЕХНИКОЙ НЕ ХУЖЕ МУЖЧИН.
Dialogue: 0,0:04:55.54,0:04:57.67,Caption,,0,0,0,,ТОЛЬКО ИХ ЗАПАС ТОЖЕ НЕ БЕЗДОННЫЙ.
Dialogue: 0,0:04:59.95,0:05:02.59,Caption,,0,0,0,,ДЛЯ СОТЕН РАСЧЁТОВ НУЖНЫ ТЫСЯЧИ ПОДГОТОВЛЕННЫХ
Dialogue: 0,0:05:02.59,0:05:05.79,Caption,,0,0,0,,УЧАСТНИКОВ, А ПОСТАНОВЛЕНИЕ ПРАВИТЕЛЬСТВА ПОКА НЕ НАУЧИЛОСЬ
Dialogue: 0,0:05:05.79,0:05:08.59,Caption,,0,0,0,,ВЫПУСКАТЬ ЛЮДЕЙ ИЗ ПРИНТЕРА ВМЕСТЕ С ПЕЧАТЬЮ И
Dialogue: 0,0:05:08.59,0:05:11.55,Caption,,0,0,0,,ПОДПИСЬЮ. ПОЛНОМОЧИЯ ПРИ ЭТОМ РАСШИРЕНЫ СЕРЬЁЗНО.
Dialogue: 0,0:05:12.01,0:05:14.19,Caption,,0,0,0,,ГРУППЫ МОГУТ ЗАЩИЩАТЬ НЕ ТОЛЬКО СОБСТВЕННОЕ
Dialogue: 0,0:05:14.19,0:05:17.87,Caption,,0,0,0,,ПРЕДПРИЯТИЕ, НО И ЧУЖИЕ ОБЪЕКТЫ ПО ДОГОВОРУ. РАЗРЕШЕНО
Dialogue: 0,0:05:17.87,0:05:20.99,Caption,,0,0,0,,ИСПОЛЬЗОВАТЬ ПИЛОТИРУЕМЫЕ САМОЛЁТЫ. ВОЗНИКАЕТ УЖЕ
Dialogue: 0,0:05:20.99,0:05:24.59,Caption,,0,0,0,,РЫНОК УСЛУГ, ГДЕ ОДИН ЗАВОД МОЖЕТ ЗАКАЗАТЬ У ДРУГОГО ЗАЩИТУ
Dialogue: 0,0:05:24.59,0:05:28.11,Caption,,0,0,0,,С ВОЗДУХА. ЕЩЁ НЕМНОГО, И БУХГАЛТЕРИЯ НАЧНЁТ УТОЧНЯТЬ,
Dialogue: 0,0:05:28.28,0:05:31.07,Caption,,0,0,0,,ВХОДИТ ЛИ ПОВТОРНЫЙ ВЫЛЕТ В ТАРИФ ИЛИ ОПЛАЧИВАЕТСЯ
Dialogue: 0,0:05:31.07,0:05:35.23,Caption,,0,0,0,,ОТДЕЛЬНО. ЛОГИКА У РЕШЕНИЯ ПОНЯТНА. АРМИЯ НЕ СПОСОБНА
Dialogue: 0,0:05:35.23,0:05:38.19,Caption,,0,0,0,,ПОСТАВИТЬ ПОЛНОЦЕННЫЙ КОМПЛЕКС ВОЗЛЕ КАЖДОГО СКЛАДА,
Dialogue: 0,0:05:38.35,0:05:41.87,Caption,,0,0,0,,ЗАВОДА И ЭНЕРГЕТИЧЕСКОГО ОБЪЕКТА. БИЗНЕСУ ПРЕДЛАГАЮТ
Dialogue: 0,0:05:41.87,0:05:44.99,Caption,,0,0,0,,ВЗЯТЬ ЧАСТЬ НАГРУЗКИ НА СЕБЯ. В РОССИИ ПРЕДПРИЯТИЯ
Dialogue: 0,0:05:44.99,0:05:49.55,Caption,,0,0,0,,ТОЖЕ ПОДКЛЮЧАЮТ К ЗАЩИТЕ, ЗАКУПАЮТ ОБОРУДОВАНИЕ И СОЗДАЮТ МОБИЛЬНЫЕ ГРУППЫ.
Dialogue: 0,0:05:49.95,0:05:52.59,Caption,,0,0,0,,БУМАГА В ОБОИХ СЛУЧАЯХ ОФОРМЛЯЕТСЯ БЫСТРЕЕ,
Dialogue: 0,0:05:52.75,0:05:55.63,Caption,,0,0,0,,ЧЕМ ГОТОВИТСЯ ХОРОШИЙ РАСЧЁТ. ДАЖЕ ПРИ ГРАМОТНОЙ
Dialogue: 0,0:05:55.63,0:05:58.91,Caption,,0,0,0,,ОРГАНИЗАЦИИ ОСТАЁТСЯ ГОРОДСКАЯ СРЕДА. СБИТЫЙ АППАРАТ
Dialogue: 0,0:05:58.91,0:06:03.95,Caption,,0,0,0,,ПАДАЕТ, ОСКОЛКИ РАЗЛЕТАЮТСЯ, ВЫПУЩЕННЫЙ БОЕПРИПАС ТОЖЕ ОБЯЗАТЕЛЬНО ПРИЛЕТАЕТ НА
Dialogue: 0,0:06:04.03,0:06:07.23,Caption,,0,0,0,,ЗЕМЛЮ. ЖИЛЬЦЫ СОСЕДНЕГО ДОМА ВРЯД ЛИ УТЕШАТСЯ ТЕМ,
Dialogue: 0,0:06:07.39,0:06:09.63,Caption,,0,0,0,,ЧТО ЦЕХ ФОРМАЛЬНО ЗАЩИЩЁН ПО ДОГОВОРУ.
Dialogue: 0,0:06:11.92,0:06:15.92,Caption,,0,0,0,,ОНИ ЗАХОТЯТ ЗНАТЬ, КТО РАЗРЕШИЛ СТРЕЛЬБУ ВОЗЛЕ ИХ ОКОН И НА
Dialogue: 0,0:06:16.00,0:06:18.72,Caption,,0,0,0,,КАКОМ ОСНОВАНИИ ЭТОТ ЧЕЛОВЕК СЧЁЛ ЦЕЛЬ ОПАСНОЙ.
Dialogue: 0,0:06:19.20,0:06:21.36,Caption,,0,0,0,,ДОВЕСТИ ЗАМЫСЕЛ ДО КОМИЧЕСКОГО СОВЕРШЕНСТВА
Dialogue: 0,0:06:21.44,0:06:24.72,Caption,,0,0,0,,НЕТРУДНО. КАЖДОМУ КРУПНОМУ ПРЕДПРИЯТИЮ МОЖНО СРАЗУ
Dialogue: 0,0:06:24.72,0:06:29.04,Caption,,0,0,0,,ВРУЧИТЬ СРЕДСТВО ПОМОЩНЕЕ, ЧТОБЫ ОНО САМО РЕШАЛО ВСЕ ВОПРОСЫ БЕЗОПАСНОСТИ.
Dialogue: 0,0:06:29.44,0:06:32.72,Caption,,0,0,0,,ЗАОДНО СОКРАТЯТСЯ ДОГОВОРЫ И СОВЕЩАНИЯ. ПРАВДА,
Dialogue: 0,0:06:32.87,0:06:35.04,Caption,,0,0,0,,ТОГДА ПРОХОДНУЮ ЛУЧШЕ ПЕРЕНЕСТИ ПОДАЛЬШЕ,
Dialogue: 0,0:06:35.20,0:06:38.08,Caption,,0,0,0,,ЖЕЛАТЕЛЬНО НА ДРУГУЮ ПЛАНЕТУ. ТАМ КАК РАЗ ОБЕЩАЛИ
Dialogue: 0,0:06:38.08,0:06:40.64,Caption,,0,0,0,,ПЕРЕХВАТЫВАТЬ "ОРЕШНИК". НО КИЕВ ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:06:40.64,0:06:43.60,Caption,,0,0,0,,ПОЛУЧИЛ ДРУГУЮ ГРОМКУЮ ИДЕЮ. ПРЕЗИДЕНТ ПОРУЧИЛ
Dialogue: 0,0:06:43.60,0:06:46.00,Caption,,0,0,0,,ПРАВИТЕЛЬСТВУ ПОДГОТОВИТЬ БЕСПЛАТНЫЙ ПРОЕЗД В
Dialogue: 0,0:06:46.00,0:06:49.12,Caption,,0,0,0,,НАЗЕМНОМ ОБЩЕСТВЕННОМ ТРАНСПОРТЕ СТОЛИЦЫ И СОЗДАТЬ
Dialogue: 0,0:06:49.12,0:06:51.92,Caption,,0,0,0,,РЕЗЕРВ АВТОБУСОВ. РЕШЕНИЕ ЗВУЧИТ ПРИЯТНО,
Dialogue: 0,0:06:52.16,0:06:54.24,Caption,,0,0,0,,ОСОБЕННО ЕСЛИ ПРОИЗНОСИТЬ ЕГО В КАБИНЕТЕ,
Dialogue: 0,0:06:54.48,0:06:58.80,Caption,,0,0,0,,ГДЕ ЕСТЬ СВЕТ, ВОДА И ОТОПЛЕНИЕ. У ГОРОЖАН ВОПРОС ПРОЩЕ ЧТО
Dialogue: 0,0:06:58.88,0:07:02.16,Caption,,0,0,0,,ИМЕННО ПОЕДЕТ? БЕСПЛАТНОСТЬ НЕ ПРЕВРАЩАЕТСЯ В АВТОБУС,
Dialogue: 0,0:07:02.40,0:07:04.96,Caption,,0,0,0,,НЕ САДИТСЯ ЗА РУЛЬ И НЕ ЗАЛИВАЕТ ТОПЛИВО
Dialogue: 0,0:07:05.04,0:07:07.36,Caption,,0,0,0,,В БАК. РЕЗЕРВ СНАЧАЛА НАДО НАЙТИ,
Dialogue: 0,0:07:07.52,0:07:10.48,Caption,,0,0,0,,ТЕХНИКУ ОБСЛУЖИТЬ, ВОДИТЕЛЕЙ ВЫВЕСТИ НА МАРШРУТ,
Dialogue: 0,0:07:10.64,0:07:13.36,Caption,,0,0,0,,А ПОЛОМКИ РЕМОНТИРОВАТЬ. НУЛЕВАЯ ЦЕНА БИЛЕТА
Dialogue: 0,0:07:13.36,0:07:18.24,Caption,,0,0,0,,ОТМЕНЯЕТ ПЛАТУ ПАССАЖИРА, НО НЕ ОТМЕНЯЕТ СЧЁТ ПЕРЕВОЗЧИКА. ДА ФИГУШКИ ТАКСИСТЫ
Dialogue: 0,0:07:18.24,0:07:21.28,Caption,,0,0,0,,ПОВЕЗУТ БЕСПЛАТНО. ЗДЕСЬ НАДЕЖДА МОЖЕТ СМЕЛО СНИМАТЬ
Dialogue: 0,0:07:21.28,0:07:27.65,Caption,,0,0,0,,ПАЛЬТО И УХОДИТЬ ДОМОЙ. ВОДИТЕЛЬ ТАКСИ СОГЛАСИТСЯ НА ТАКОЙ ТАРИФ РАЗВЕ ЧТО
Dialogue: 0,0:07:27.73,0:07:31.73,Caption,,0,0,0,,ПРИ УСЛОВИИ, ЧТО ПАССАЖИРЫ САМИ ТОЛКАЮТ МАШИНУ ДО МЕСТА. ЕСЛИ
Dialogue: 0,0:07:31.73,0:07:33.33,Caption,,0,0,0,,АВТОБУСОВ И ТОПЛИВА НЕ ХВАТИТ,
Dialogue: 0,0:07:33.65,0:07:36.53,Caption,,0,0,0,,ОСТАНЕТСЯ ИСКАТЬ ЛОШАДИНЫЕ ТЕЛЕГИ. ЛОШАДЬ ХОТЯ БЫ НЕ
Dialogue: 0,0:07:36.53,0:07:39.09,Caption,,0,0,0,,СПРАШИВАЕТ, КОГДА ВКЛЮЧАТ ЗАРЯДНУЮ СТАНЦИЮ.
Dialogue: 0,0:07:39.68,0:07:43.01,Caption,,0,0,0,,ИРОНИЯ ОСОБЕННО ЕДКАЯ НА ОБЩЕМ ФОНЕ. В СТОЛИЦЕ
Dialogue: 0,0:07:43.01,0:07:46.61,Caption,,0,0,0,,ПЕРЕБОИ СО СВЕТОМ, ВОДОЙ, ОТОПЛЕНИЕМ И ТОПЛИВОМ,
Dialogue: 0,0:07:46.79,0:07:49.49,Caption,,0,0,0,,ТРАНСПОРТНЫЕ МАРШРУТЫ ПРИХОДИТСЯ МЕНЯТЬ. НА ЭТОМ
Dialogue: 0,0:07:49.49,0:07:52.37,Caption,,0,0,0,,ФОНЕ ОБЪЯВЛЯЮТ БЕСПЛАТНЫЙ ПРОЕЗД. ЖИТЕЛЬ ЕЩЁ НЕ
Dialogue: 0,0:07:52.37,0:07:55.49,Caption,,0,0,0,,ЗНАЕТ, БУДЕТ ЛИ РАБОТАТЬ ЕГО КРАН И ВКЛЮЧИТСЯ ЛИ
Dialogue: 0,0:07:55.49,0:07:59.17,Caption,,0,0,0,,ЛАМПА, ЗАТО ЕМУ ЗАРАНЕЕ СООБЩИЛИ ЦЕНУ ПОЕЗДКИ К МЕСТУ,
Dialogue: 0,0:07:59.33,0:08:01.81,Caption,,0,0,0,,КУДА ОН, ВОЗМОЖНО, НЕ СМОЖЕТ ДОЕХАТЬ.
Dialogue: 0,0:08:02.74,0:08:05.57,Caption,,0,0,0,,АВТОБУСНЫЙ РЕЗЕРВ ТРЕБУЕТ НЕ ТОЛЬКО МАШИН. НУЖНЫ
Dialogue: 0,0:08:05.57,0:08:08.77,Caption,,0,0,0,,ВОДИТЕЛИ, МЕХАНИКИ, РЕМОНТНЫЕ МОЩНОСТИ,
Dialogue: 0,0:08:08.86,0:08:13.17,Caption,,0,0,0,,ЗАПЧАСТИ И ГОРЮЧЕЕ. ТЕ ЖЕ ГОРОДСКИЕ СЛУЖБЫ ИЩУТ ЭЛЕКТРИКОВ,
Dialogue: 0,0:08:13.33,0:08:16.85,Caption,,0,0,0,,ЭНЕРГЕТИКОВ И АВАРИЙНЫЕ БРИГАДЫ. СТРАНА ИСПЫТЫВАЕТ
Dialogue: 0,0:08:16.85,0:08:20.69,Caption,,0,0,0,,НЕХВАТКУ ЛЮДЕЙ, А КАЖДОЕ НОВОЕ РЕШЕНИЕ ОТКРЫВАЕТ ЕЩЁ НЕСКОЛЬКО
Dialogue: 0,0:08:20.69,0:08:24.21,Caption,,0,0,0,,ВАКАНСИЙ. ПОХОЖЕ, ДОЛЖЕН СУЩЕСТВОВАТЬ ТАЙНЫЙ ШКАФ,
Dialogue: 0,0:08:24.45,0:08:27.65,Caption,,0,0,0,,ПОЛНЫЙ СВОБОДНЫХ СПЕЦИАЛИСТОВ ВСЕХ ПРОФЕССИЙ. КЛЮЧ
Dialogue: 0,0:08:27.73,0:08:32.29,Caption,,0,0,0,,ОТ НЕГО, ВЕРОЯТНО, ТОЖЕ МОБИЛИЗОВАЛИ. ТЫЛОВЫЕ РАБОТНИКИ НЕ ВОЗНИКАЮТ
Dialogue: 0,0:08:32.37,0:08:37.01,Caption,,0,0,0,,ПОСЛЕ РАСПОРЯЖЕНИЯ. ЧЕЛОВЕК, КОТОРЫЙ ЗНАЕТ КОНКРЕТНУЮ ПОДСТАНЦИЮ ИЛИ СИСТЕМУ
Dialogue: 0,0:08:37.01,0:08:39.89,Caption,,0,0,0,,ВОДОСНАБЖЕНИЯ, ЦЕНЕН ИМЕННО СВОИМ ОПЫТОМ.
Dialogue: 0,0:08:42.18,0:08:46.50,Caption,,0,0,0,,ЕСЛИ ЕГО ОТПРАВИТЬ В АРМИЮ, СЕТЬ НЕ СТАНЕТ ПРОЩЕ ИЗ УВАЖЕНИЯ К ОБСТОЯТЕЛЬСТВАМ.
Dialogue: 0,0:08:46.97,0:08:50.26,Caption,,0,0,0,,КОГДА СЛУЧИТСЯ ПОВРЕЖДЕНИЕ, ЧИНИТЬ ЕГО БУДЕТ УЖЕ НЕКОМУ,
Dialogue: 0,0:08:50.53,0:08:52.90,Caption,,0,0,0,,И ТОГДА БЕСПЛАТНЫЙ АВТОБУС ПОВЕЗЁТ ПАССАЖИРОВ
Dialogue: 0,0:08:52.90,0:08:58.02,Caption,,0,0,0,,ЛЮБОВАТЬСЯ ТЁМНЫМИ ОКНАМИ. ЖИТЕЛИ КОМПЛЕКСА "НОВЫЙ АВТОГРАФ" НА ЛЕВОМ БЕРЕГУ
Dialogue: 0,0:08:58.02,0:09:00.90,Caption,,0,0,0,,ПРОВЕЛИ БЕЗ ЭЛЕКТРИЧЕСТВА ТРОЕ СУТОК И ПЕРЕКРЫЛИ
Dialogue: 0,0:09:00.90,0:09:03.62,Caption,,0,0,0,,ДОРОГУ. ОНИ ВЫШЛИ НЕ РАДИ ПРОГУЛКИ И НЕ
Dialogue: 0,0:09:03.62,0:09:06.82,Caption,,0,0,0,,РАДИ БЕСПЛАТНОГО МАРШРУТА. ИМ НУЖЕН РАБОТАЮЩИЙ СВЕТ.
Dialogue: 0,0:09:07.29,0:09:10.02,Caption,,0,0,0,,ТАКОЙ ПРОТЕСТ ПОКАЗЫВАЕТ ЦЕНУ КАДРОВОГО ДЕФИЦИТА
Dialogue: 0,0:09:10.02,0:09:12.82,Caption,,0,0,0,,ГОРАЗДО ТОЧНЕЕ ЛЮБОГО СОВЕЩАНИЯ ЕСЛИ БРИГАДА НЕ
Dialogue: 0,0:09:12.82,0:09:17.70,Caption,,0,0,0,,УСПЕВАЕТ ВОССТАНОВИТЬ СЕТЬ, ТЕРПЕНИЕ ЗАКАНЧИВАЕТСЯ РАНЬШЕ АВАРИИ. МЕТРО МОЖЕТ
Dialogue: 0,0:09:17.78,0:09:20.66,Caption,,0,0,0,,РАБОТАТЬ С ПЕРЕБОЯМИ, МОСТЫ ТРЕБУЮТ ВНИМАНИЯ,
Dialogue: 0,0:09:20.83,0:09:23.38,Caption,,0,0,0,,НАЗЕМНЫЕ МАРШРУТЫ ПЕРЕСТРАИВАЮТ ПОСЛЕ УДАРОВ.
Dialogue: 0,0:09:23.61,0:09:26.26,Caption,,0,0,0,,БЕСПЛАТНЫЙ ПРОЕЗД В ТАКОЙ ОБСТАНОВКЕ НАПОМИНАЕТ
Dialogue: 0,0:09:26.26,0:09:30.74,Caption,,0,0,0,,СКИДКУ НА ТОВАР, КОТОРОГО МАЛО НА СКЛАДЕ. ВЫ ЭКОНОМИТЕ ВСЮ СТОИМОСТЬ,
Dialogue: 0,0:09:30.98,0:09:33.94,Caption,,0,0,0,,ЕСЛИ СУМЕЕТЕ ЕГО НАЙТИ. МАРКЕТОЛОГИ АПЛОДИРУЮТ,
Dialogue: 0,0:09:34.17,0:09:36.58,Caption,,0,0,0,,ПАССАЖИРЫ ПРОДОЛЖАЮТ ЖДАТЬ. ПОДПИШИТЕСЬ НА
Dialogue: 0,0:09:36.58,0:09:38.66,Caption,,0,0,0,,"ПЛАНЕТУ", ЕСЛИ ВАМ ТОЖЕ ИНТЕРЕСНО,
Dialogue: 0,0:09:38.90,0:09:41.54,Caption,,0,0,0,,НА КАКОМ МАРШРУТЕ ВСТРЕТЯТСЯ БЕСПЛАТНЫЙ АВТОБУС,
Dialogue: 0,0:09:41.69,0:09:44.98,Caption,,0,0,0,,СВОБОДНЫЙ ВОДИТЕЛЬ И ПОЛНЫЙ БАК. ТАКОЕ СОВПАДЕНИЕ
Dialogue: 0,0:09:44.98,0:09:47.94,Caption,,0,0,0,,СКОРО МОЖНО БУДЕТ СЧИТАТЬ ЕЩЁ ОДНИМ КОСМИЧЕСКИМ
Dialogue: 0,0:09:47.94,0:09:53.25,Caption,,0,0,0,,ИСПЫТАНИЕМ. ЕСТЬ У РЕШЕНИЯ И ПОЛИТИЧЕСКИЙ РАСЧЁТ ГОВОРЯТ,
Dialogue: 0,0:09:53.48,0:09:55.97,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ЗАХОДИТ НА ТЕРРИТОРИЮ КЛИЧКО И
Dialogue: 0,0:09:55.97,0:09:58.77,Caption,,0,0,0,,ПЕРЕХВАТЫВАЕТ У МЭРИИ КРАСИВУЮ СОЦИАЛЬНУЮ ТЕМУ.
Dialogue: 0,0:09:59.10,0:10:03.73,Caption,,0,0,0,,ПУСКАЙ САМИ РАЗБИРАЮТСЯ, КТО У КОГО ЧТО ОТЖАЛ. ВЫИГРАВШИМ ОБЪЯВЯТ ТОГО,
Dialogue: 0,0:10:03.92,0:10:08.61,Caption,,0,0,0,,ЧЬЁ ИМЯ НАПИШУТ КРУПНЕЕ, А ЗА ПОЛОМАННЫЙ АВТОБУС ОТВЕЧАТЬ ВСЁ РАВНО ПРИДЁТСЯ
Dialogue: 0,0:10:08.61,0:10:11.57,Caption,,0,0,0,,МЕХАНИКУ. ОБЫЧНОГО КИЕВЛЯНИНА ИХ СОРЕВНОВАНИЕ
Dialogue: 0,0:10:11.65,0:10:15.49,Caption,,0,0,0,,ВОЛНУЕТ МЕНЬШЕ, ЧЕМ ВЫКЛЮЧАТЕЛЬ НА СТЕНЕ. ЕМУ НУЖЕН СВЕТ ПОСЛЕ
Dialogue: 0,0:10:15.49,0:10:19.49,Caption,,0,0,0,,НАЖАТИЯ, ВОДА ПОСЛЕ ПОВОРОТА КРАНА И ТРАНСПОРТ ПОСЛЕ ВЫХОДА
Dialogue: 0,0:10:19.57,0:10:22.61,Caption,,0,0,0,,НА ОСТАНОВКУ. КТО ИЗ НИХ ДВОИХ ЗАПИШЕТ БЕСПЛАТНЫЙ
Dialogue: 0,0:10:22.61,0:10:26.93,Caption,,0,0,0,,ПРОЕЗД СЕБЕ В ЗАСЛУГУ, КВАРТИРУ НЕ СОГРЕЕТ И ДВИГАТЕЛЬ НЕ ЗАВЕДЁТ. В
Dialogue: 0,0:10:26.93,0:10:29.33,Caption,,0,0,0,,ЭТОМ СМЫСЛЕ РЕАЛЬНОСТЬ ВЕДЁТ СЕБЯ НЕВОСПИТАННО,
Dialogue: 0,0:10:29.57,0:10:34.53,Caption,,0,0,0,,ОНА ТРЕБУЕТ НЕ ЗАЯВЛЕНИЯ, А РАБОТАЮЩЕЙ СИСТЕМЫ. МАСШТАБ ТУТ ОСОБЕННО СМЕШНО
Dialogue: 0,0:10:34.53,0:10:37.73,Caption,,0,0,0,,СКАЧЕТ. НАВЕРХУ ОБСУЖДАЮТ ПЕРЕХВАТ ЗА АТМОСФЕРОЙ,
Dialogue: 0,0:10:37.97,0:10:40.85,Caption,,0,0,0,,НИЖЕ ПРЕДПРИЯТИЯ СОБИРАЮТ СОБСТВЕННЫЕ ВООРУЖЁННЫЕ
Dialogue: 0,0:10:40.85,0:10:43.65,Caption,,0,0,0,,ГРУППЫ, А НА ОСТАНОВКЕ ЧЕЛОВЕК ПЫТАЕТСЯ ПОНЯТЬ,
Dialogue: 0,0:10:43.89,0:10:47.57,Caption,,0,0,0,,ПРИЕДЕТ ЛИ ОБЫЧНЫЙ АВТОБУС. ВЕЗДЕ ОБЕЩАНИЕ ОФОРМЛЕНО
Dialogue: 0,0:10:47.65,0:10:50.77,Caption,,0,0,0,,РАНЬШЕ МЕХАНИЗМА. СЛОВА УЖЕ ВЫЕХАЛИ ПО МАРШРУТУ,
Dialogue: 0,0:10:51.01,0:10:52.93,Caption,,0,0,0,,ТЕХНИКА ЕЩЁ ПРОГРЕВАЕТ ДВИГАТЕЛЬ,
Dialogue: 0,0:10:53.16,0:10:55.25,Caption,,0,0,0,,ЕСЛИ ДВИГАТЕЛЬ ВООБЩЕ НАШЛИ. НАПИШИТЕ В
Dialogue: 0,0:10:55.25,0:10:58.85,Caption,,0,0,0,,КОММЕНТАРИЯХ, КАКОЕ ИЗ ЭТИХ РЕШЕНИЙ КАЖЕТСЯ ВАМ САМЫМ
Dialogue: 0,0:10:58.85,0:11:04.65,Caption,,0,0,0,,ЖИЗНЕСПОСОБНЫМ. ТОЛЬКО НЕ ПРЕДЛАГАЙТЕ ОДНОГО СВОБОДНОГО СПЕЦИАЛИСТА
Dialogue: 0,0:11:04.65,0:11:06.65,Caption,,0,0,0,,НАЗНАЧИТЬ ОДНОВРЕМЕННО РАКЕТЧИКОМ,
Dialogue: 0,0:11:06.77,0:11:11.69,Caption,,0,0,0,,ЭЛЕКТРИКОМ И ВОДИТЕЛЕМ. ДО ТАКОГО КАДРОВОГО ИЗОБРЕТЕНИЯ ЧИНОВНИКИ НАВЕРНЯКА
Dialogue: 0,0:11:11.69,0:11:14.01,Caption,,0,0,0,,ДОЙДУТ САМИ, ИМ ПОДСКАЗКИ НЕ ТРЕБУЮТСЯ.
Dialogue: 0,0:11:14.65,0:11:17.61,Caption,,0,0,0,,ОБЩАЯ БЕДА НЕ В НЕХВАТКЕ ГРОМКИХ ИДЕЙ. ИХ
Dialogue: 0,0:11:17.61,0:11:20.09,Caption,,0,0,0,,КАК РАЗ ПРОИЗВОДЯТ С ПРЕКРАСНОЙ СКОРОСТЬЮ. НЕ
Dialogue: 0,0:11:20.09,0:11:22.89,Caption,,0,0,0,,ХВАТАЕТ ЛЮДЕЙ, ОБОРУДОВАНИЯ, ТОПЛИВА,
Dialogue: 0,0:11:23.13,0:11:26.17,Caption,,0,0,0,,ПРОИЗВОДСТВЕННЫХ ВОЗМОЖНОСТЕЙ И ВРЕМЕНИ. ОБЪЯВЛЕНИЕ
Dialogue: 0,0:11:26.25,0:11:28.81,Caption,,0,0,0,,НЕ ЗАМЕНЯЕТ НИ ОДНОГО ИЗ ЭТИХ РЕСУРСОВ. ОНО
Dialogue: 0,0:11:28.89,0:11:31.05,Caption,,0,0,0,,ЛИШЬ ДАЁТ КОРОТКУЮ ПЕРЕДЫШКУ ДО МОМЕНТА,
Dialogue: 0,0:11:31.25,0:11:36.01,Caption,,0,0,0,,КОГДА ПУБЛИКА СПРОСИТ, ГДЕ РЕЗУЛЬТАТ. КОСМИЧЕСКИЙ ПЕРЕХВАТ ОСОБЕННО УДОБЕН
Dialogue: 0,0:11:36.01,0:11:39.61,Caption,,0,0,0,,ТЕМ, ЧТО ВОПРОС МОЖНО ОТЛОЖИТЬ. ЧАСТНАЯ ЗАЩИТА ЗАВОДА
Dialogue: 0,0:11:39.61,0:11:41.45,Caption,,0,0,0,,ПЕРЕНОСИТ ОТВЕТСТВЕННОСТЬ НА БИЗНЕС,
Dialogue: 0,0:11:41.67,0:11:44.57,Caption,,0,0,0,,ХОТЯ СПЕЦИАЛИСТОВ БОЛЬШЕ НЕ СТАНОВИТСЯ. БЕСПЛАТНЫЙ
Dialogue: 0,0:11:44.57,0:11:46.89,Caption,,0,0,0,,ПРОЕЗД ПЕРЕНОСИТ ВНИМАНИЕ НА ЦЕНУ БИЛЕТА,
Dialogue: 0,0:11:47.13,0:11:50.01,Caption,,0,0,0,,ХОТЯ ГОРОД БЕСПОКОИТ НАЛИЧИЕ САМОГО ТРАНСПОРТА И
Dialogue: 0,0:11:50.09,0:11:52.65,Caption,,0,0,0,,РАБОТА КОММУНАЛЬНЫХ СИСТЕМ. В КАЖДОМ СЛУЧАЕ
Dialogue: 0,0:11:52.65,0:11:55.13,Caption,,0,0,0,,СЛОЖНЕЙШАЯ ЧАСТЬ НАЧИНАЕТСЯ ПОСЛЕ ТОГО,
Dialogue: 0,0:11:55.28,0:11:57.93,Caption,,0,0,0,,КАК МИКРОФОНЫ ВЫКЛЮЧИЛИ. ФИНАЛ У ЭТОЙ ЦЕПОЧКИ
Dialogue: 0,0:11:57.93,0:12:00.49,Caption,,0,0,0,,ПРОСТОЙ. ПЕРЕХВАТ ДЕРЖИТСЯ НА ИНЖЕНЕРАХ И
Dialogue: 0,0:12:00.49,0:12:04.17,Caption,,0,0,0,,ПРОИЗВОДСТВЕ, ЗАВОДСКАЯ ПВО НА ОБУЧЕННЫХ РАСЧЁТАХ И СТРОГОМ
Dialogue: 0,0:12:04.17,0:12:06.97,Caption,,0,0,0,,КОНТРОЛЕ, А ГОРОДСКОЙ ТРАНСПОРТ НА АВТОБУСАХ,
Dialogue: 0,0:12:07.13,0:12:11.21,Caption,,0,0,0,,ВОДИТЕЛЯХ, ТОПЛИВЕ И РЕМОНТЕ. ЕСЛИ ВМЕСТО ЭТОГО СНОВА ПОЯВИТСЯ
Dialogue: 0,0:12:11.29,0:12:14.17,Caption,,0,0,0,,ТОЛЬКО ЗАЯВЛЕНИЕ, ЕГО ТОЖЕ МОЖНО СДЕЛАТЬ БЕСПЛАТНЫМ.
Dialogue: 0,0:12:16.46,0:12:18.46,Caption,,0,0,0,,ВСЁ РАВНО ПЛАТИТЬ ЗА НЕГО ПРИДЁТСЯ ТЕМ,
Dialogue: 0,0:12:18.68,0:12:23.58,Caption,,0,0,0,,КТО ОСТАНЕТСЯ БЕЗ СВЕТА, ЗАЩИТЫ И ВОЗМОЖНОСТИ УЕХАТЬ. И КОГДА ОЧЕРЕДНОЙ
Dialogue: 0,0:12:23.58,0:12:26.22,Caption,,0,0,0,,РУКОВОДИТЕЛЬ ПРЕДЛОЖИТ ПРОГРАММУ ЕЩЁ КРУПНЕЕ,
Dialogue: 0,0:12:26.46,0:12:29.34,Caption,,0,0,0,,СТОИТ ЗАДАТЬ ОДИН СКУЧНЫЙ ВОПРОС КТО ЕЁ ВЫПОЛНИТ?
Dialogue: 0,0:12:29.85,0:12:32.54,Caption,,0,0,0,,НЕ ТОТ, КТО ПОСТАВИТ ПОДПИСЬ ПОД РАСПОРЯЖЕНИЕМ,
Dialogue: 0,0:12:32.86,0:12:34.54,Caption,,0,0,0,,НЕ КТО ВЫСТУПИТ ПЕРЕД КАМЕРАМИ,
Dialogue: 0,0:12:34.86,0:12:37.74,Caption,,0,0,0,,А КТО ВСТАНЕТ У СТАНКА, ВОССТАНОВИТ ПОДСТАНЦИЮ,
Dialogue: 0,0:12:37.90,0:12:41.34,Caption,,0,0,0,,СЯДЕТ ЗА РУЛЬ И ПРИМЕТ ОТВЕТСТВЕННОЕ РЕШЕНИЕ. ЕСЛИ
Dialogue: 0,0:12:41.34,0:12:44.78,Caption,,0,0,0,,ОТВЕТА НЕТ, МОЖНО СРАЗУ БРОНИРОВАТЬ ЛОШАДЬ. У НЕЁ ХОТЯ БЫ
Dialogue: 0,0:12:44.78,0:12:47.02,Caption,,0,0,0,,КОСМИЧЕСКИХ АМБИЦИЙ ПОКА НЕ ОБНАРУЖЕНО.
