Dialogue: 0,0:00:00.12,0:00:02.16,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ КОМИССИЮ ПОЗВАЛИ В МОСКВУ
Dialogue: 0,0:00:02.16,0:00:04.14,Caption,,0,0,0,,ОБСУДИТЬ БЕЗОПАСНОСТЬ КОНТИНЕНТА БЕЗ
Dialogue: 0,0:00:04.14,0:00:07.39,Caption,,0,0,0,,ПОСРЕДНИКОВ И РАССАДКИ НА ПОЛСОТНИ КРЕСЕЛ. В БРЮССЕЛЕ
Dialogue: 0,0:00:07.39,0:00:10.28,Caption,,0,0,0,,ОТВЕТИЛИ, ЧТО ОТДЕЛЬНО ЕХАТЬ НЕ СОБИРАЮТСЯ НУЖЕН
Dialogue: 0,0:00:10.28,0:00:12.42,Caption,,0,0,0,,МНОГОСТОРОННИЙ ФОРМАТ. ОДНОВРЕМЕННО
Dialogue: 0,0:00:12.42,0:00:15.72,Caption,,0,0,0,,ФРИДРИХ МЕРЦ УВЕРЯЕТ, ЧТО ЕВРОПА ГОТОВА К ПЕРЕГОВОРАМ,
Dialogue: 0,0:00:15.96,0:00:18.12,Caption,,0,0,0,,НО ТОЛЬКО ПОСЛЕ ПРЕКРАЩЕНИЯ ОГНЯ НА
Dialogue: 0,0:00:18.12,0:00:20.61,Caption,,0,0,0,,УКРАИНЕ И ПРИ ВЫСТАВЛЕННЫХ УСЛОВИЯХ. ЭТО
Dialogue: 0,0:00:20.61,0:00:22.60,Caption,,0,0,0,,ТРЕБОВАНИЕ СНАЧАЛА ОПЛАТИТЬ СЧЁТ,
Dialogue: 0,0:00:22.74,0:00:25.48,Caption,,0,0,0,,А ПОТОМ, ВОЗМОЖНО, ВАС ПУСТЯТ В РЕСТОРАН.
Dialogue: 0,0:00:26.26,0:00:29.79,Caption,,0,0,0,,ЕСЛИ ВАМ ПО ДУШЕ РАЗБОР, ГДЕ ЧИНОВНИЧЬИ РЕЧИ ПЕРЕВОДЯТ С
Dialogue: 0,0:00:29.79,0:00:31.56,Caption,,0,0,0,,ПАРАДНОГО ЯЗЫКА НА ЧЕЛОВЕЧЕСКИЙ,
Dialogue: 0,0:00:31.78,0:00:34.12,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ. И НАПИШИТЕ В КОММЕНТАРИЯХ,
Dialogue: 0,0:00:34.44,0:00:36.88,Caption,,0,0,0,,ПОХОЖИ ТАКИЕ УСЛОВИЯ НА ПЕРЕГОВОРЫ ИЛИ
Dialogue: 0,0:00:36.88,0:00:38.68,Caption,,0,0,0,,НА УЛЬТИМАТУМ В ХОРОШЕМ КОСТЮМЕ.
Dialogue: 0,0:00:39.64,0:00:43.18,Caption,,0,0,0,,МАРК РЮТТЕ ОБЪЯВЛЯЕТ, ЧТО ВОЗВРАЩЕНИЕ НАТО К РУБЕЖАМ МАЯ
Dialogue: 0,0:00:43.18,0:00:45.96,Caption,,0,0,0,,ДЕВЯНОСТО СЕДЬМОГО ГОДА НЕВОЗМОЖНО. КОГО
Dialogue: 0,0:00:45.96,0:00:49.16,Caption,,0,0,0,,ПРИНИМАТЬ В АЛЬЯНС, ГДЕ РАЗМЕЩАТЬ ВОЙСКА И КУДА
Dialogue: 0,0:00:49.16,0:00:52.68,Caption,,0,0,0,,РАСШИРЯТЬСЯ, НАТО РЕШИТ БЕЗ РОССИИ. МОСКВА ТРЕБУЕТ
Dialogue: 0,0:00:52.68,0:00:54.75,Caption,,0,0,0,,ПРОТИВОПОЛОЖНОГО ПРЕКРАТИТЬ ДВИЖЕНИЕ
Dialogue: 0,0:00:54.75,0:00:57.77,Caption,,0,0,0,,НА ВОСТОК, ОТВЕСТИ СИЛЫ К ПРЕЖНИМ ПОЗИЦИЯМ И
Dialogue: 0,0:00:57.77,0:01:00.60,Caption,,0,0,0,,СВЕРНУТЬ ВОЕННУЮ АКТИВНОСТЬ В ВОСТОЧНОЙ ЕВРОПЕ,
Dialogue: 0,0:01:00.74,0:01:03.42,Caption,,0,0,0,,ЗАКАВКАЗЬЕ И ЦЕНТРАЛЬНОЙ АЗИИ. ЮРИЙ
Dialogue: 0,0:01:03.42,0:01:06.37,Caption,,0,0,0,,УШАКОВ ПОДТВЕРДИЛ, ЧТО ЭТИ ТРЕБОВАНИЯ ОБСУЖДАЛИСЬ НА
Dialogue: 0,0:01:06.37,0:01:09.27,Caption,,0,0,0,,ПЕРЕГОВОРАХ В АБУ ДАБИ. ПОЛЬША УВИДЕЛА ЗДЕСЬ УГРОЗУ
Dialogue: 0,0:01:09.27,0:01:12.82,Caption,,0,0,0,,СВОЕЙ БЕЗОПАСНОСТИ, А БОЛГАРИЯ ОТКАЗАЛАСЬ ОТКРЫВАТЬ ЭТУ
Dialogue: 0,0:01:12.82,0:01:14.92,Caption,,0,0,0,,ПАПКУ. КАКОЙ ВЫХОД ПРЕДЛАГАЮТ РОССИИ?
Dialogue: 0,0:01:17.21,0:01:20.23,Caption,,0,0,0,,СМИРНО СТОЯТЬ У СТЕНЫ, ПОКА ВОЕННАЯ ИНФРАСТРУКТУРА
Dialogue: 0,0:01:20.23,0:01:24.25,Caption,,0,0,0,,ПРИБЛИЖАЕТСЯ К ЕЁ ГРАНИЦАМ? БЕЗОПАСНОСТЬ ВАРШАВЫ СВЯЩЕННА,
Dialogue: 0,0:01:24.49,0:01:26.97,Caption,,0,0,0,,БЕЗОПАСНОСТЬ МОСКВЫ СЧИТАЕТСЯ ДУРНОЙ
Dialogue: 0,0:01:26.97,0:01:29.77,Caption,,0,0,0,,ПРИВЫЧКОЙ. НАТО ВЫБИРАЕТ МЕСТО ДЛЯ СВОИХ ВОЙСК,
Dialogue: 0,0:01:30.01,0:01:31.99,Caption,,0,0,0,,А РОССИЯ ОБЯЗАНА СМОТРЕТЬ НА ЭТО С
Dialogue: 0,0:01:31.99,0:01:34.96,Caption,,0,0,0,,ВЫРАЖЕНИЕМ ДУХОВНОЙ ГАРМОНИИ. ВЫ ОСТАВЛЯЕТЕ ЕЙ
Dialogue: 0,0:01:34.96,0:01:38.88,Caption,,0,0,0,,ВЫБОР, КРОМЕ ОТВЕТА СИЛОЙ? МОЖНО МОЛЧА ОТСТУПИТЬ И ПОПРОСИТЬ
Dialogue: 0,0:01:38.88,0:01:41.80,Caption,,0,0,0,,СЛЕДУЮЩИЙ ПАКЕТ ТРЕБОВАНИЙ. ТОЛЬКО ГОСУДАРСТВА ТАК НЕ
Dialogue: 0,0:01:41.80,0:01:44.80,Caption,,0,0,0,,ДЕЙСТВУЮТ, ОСОБЕННО ЯДЕРНЫЕ. ЕСЛИ ОДНУ СТОРОНУ
Dialogue: 0,0:01:44.80,0:01:47.85,Caption,,0,0,0,,ПРИЖИМАЮТ К СТЕНЕ И ЗАПРЕЩАЮТ СЧИТАТЬ ЭТО УГРОЗОЙ,
Dialogue: 0,0:01:48.17,0:01:50.80,Caption,,0,0,0,,ЕВРОПА ПОЛУЧАЕТ ДОРОГУ К ЯДЕРНОЙ ЗИМЕ.
Dialogue: 0,0:01:50.80,0:01:53.20,Caption,,0,0,0,,ВИДИМО, КОММУНАЛЬНЫЕ ПЛАТЕЖИ ПОКАЗАЛИСЬ
Dialogue: 0,0:01:53.20,0:01:55.87,Caption,,0,0,0,,НЕДОСТАТОЧНО ХОЛОДНЫМИ. НА ЭТОМ ФОНЕ НИКТО НЕ
Dialogue: 0,0:01:55.87,0:01:58.83,Caption,,0,0,0,,РАЗБИРАЕТ РАКЕТЫ НА МЕТАЛЛОЛОМ И НЕ РЕЖЕТ ВОЕННЫЕ
Dialogue: 0,0:01:58.83,0:02:01.13,Caption,,0,0,0,,БЮДЖЕТЫ. ОБСУЖДАЮТ ВЫПУСК БОЕПРИПАСОВ,
Dialogue: 0,0:02:01.44,0:02:04.04,Caption,,0,0,0,,НОВЫЕ МОЩНОСТИ И БОЕВЫЕ ПОЛЁТЫ АВИАЦИИ
Dialogue: 0,0:02:04.04,0:02:06.73,Caption,,0,0,0,,НАТО ВОЗЛЕ РОССИЙСКИХ ГРАНИЦ. ЕЩЁ НЕМНОГО,
Dialogue: 0,0:02:07.12,0:02:08.84,Caption,,0,0,0,,И ВОЗЛЕ КАЖДОГО САМОЛЁТА ПОСТАВЯТ
Dialogue: 0,0:02:08.84,0:02:12.18,Caption,,0,0,0,,СОТРУДНИКА ОБЪЯСНЯТЬ, НАСКОЛЬКО МИРНО ОН ЛЕТИТ С ПОЛНОЙ
Dialogue: 0,0:02:12.18,0:02:14.89,Caption,,0,0,0,,БОЕВОЙ ЗАГРУЗКОЙ. ПОТОМ ТЕ ЖЕ ЛЮДИ УДИВЛЯЮТСЯ,
Dialogue: 0,0:02:15.14,0:02:17.56,Caption,,0,0,0,,ПОЧЕМУ ПЕРЕГОВОРЫ УПИРАЮТСЯ В БЕТОН.
Dialogue: 0,0:02:17.56,0:02:19.69,Caption,,0,0,0,,ЕВРОПА НЕ НАЗЫВАЕТ СОБСТВЕННЫХ УСТУПОК,
Dialogue: 0,0:02:20.01,0:02:21.98,Caption,,0,0,0,,РОССИЯ НЕ ПРИНИМАЕТ ЕВРОПЕЙСКИЕ
Dialogue: 0,0:02:21.98,0:02:26.22,Caption,,0,0,0,,УСЛОВИЯ, А ВСЕ ЖДУТ, КТО ПЕРВЫМ ДЁРНЕТ ГЛАЗОМ. СЛЕДУЮЩИМ К
Dialogue: 0,0:02:26.22,0:02:29.49,Caption,,0,0,0,,МИКРОФОНУ В БЕРЛИНЕ ВЫХОДИТ РЮТТЕ. ГОРОД ДОБАВЛЯЕТ
Dialogue: 0,0:02:29.49,0:02:31.29,Caption,,0,0,0,,РАЗГОВОРУ ИСТОРИЧЕСКИЙ ПРИВКУС.
Dialogue: 0,0:02:33.56,0:02:35.87,Caption,,0,0,0,,ГЕРМАНИЯ УЖЕ СЛЫШАЛА УВЕРЕННЫЕ РЕЧИ О
Dialogue: 0,0:02:35.87,0:02:39.18,Caption,,0,0,0,,НОВОМ ПОРЯДКЕ И ВЕЛИКИХ ПОХОДАХ. ПАМЯТЬ У ДЕКОРАЦИЙ
Dialogue: 0,0:02:39.18,0:02:42.07,Caption,,0,0,0,,ДЛИННЕЕ, ЧЕМ У НЕКОТОРЫХ ОРАТОРОВ. ГЕНЕРАЛЬНЫЙ
Dialogue: 0,0:02:42.07,0:02:44.92,Caption,,0,0,0,,СЕКРЕТАРЬ НАТО ПРЕДЛАГАЕТ ГОТОВИТЬ К ВОЗМОЖНОЙ ВОЙНЕ
Dialogue: 0,0:02:44.92,0:02:47.66,Caption,,0,0,0,,НЕ ТОЛЬКО АРМИИ. В ПОДГОТОВКУ ДОЛЖНЫ ВКЛЮЧАТЬСЯ
Dialogue: 0,0:02:47.66,0:02:51.30,Caption,,0,0,0,,ГРАЖДАНЕ, ПРЕДПРИЯТИЯ, ГОСУДАРСТВЕННЫЕ ОРГАНЫ И МЕСТНЫЕ
Dialogue: 0,0:02:51.30,0:02:54.12,Caption,,0,0,0,,СООБЩЕСТВА. НАСЕЛЕНИЮ СЛЕДУЕТ ОБЪЯСНЯТЬ,
Dialogue: 0,0:02:54.29,0:02:56.02,Caption,,0,0,0,,КАК ВЕСТИ СЕБЯ ВО ВРЕМЯ БОЕВЫХ
Dialogue: 0,0:02:56.02,0:02:58.69,Caption,,0,0,0,,ДЕЙСТВИЙ И ПОМОГАТЬ ВОЕННЫМ. ПЕРЕЧИСЛЕНЫ
Dialogue: 0,0:02:58.69,0:03:01.81,Caption,,0,0,0,,ЭНЕРГЕТИКА, ОТОПЛЕНИЕ И КИБЕРБЕЗОПАСНОСТЬ.
Dialogue: 0,0:03:01.81,0:03:05.08,Caption,,0,0,0,,ОБРАЗЦАМИ НАЗВАНЫ НОРВЕГИЯ, ШВЕЦИЯ,
Dialogue: 0,0:03:05.22,0:03:07.54,Caption,,0,0,0,,ДАНИЯ И ФИНЛЯНДИЯ. С ОРГАНИЗАЦИЕЙ
Dialogue: 0,0:03:07.54,0:03:10.98,Caption,,0,0,0,,БОЛЬШОЙ БЕДЫ У НИХ ВСЁ ПОСТАВЛЕНО КРЕПКО. ДЛЯ ГРАЖДАН
Dialogue: 0,0:03:10.98,0:03:13.80,Caption,,0,0,0,,НАЙДУТСЯ ПАМЯТКИ, ДЛЯ БИЗНЕСА ОБЯЗАННОСТИ,
Dialogue: 0,0:03:14.12,0:03:18.25,Caption,,0,0,0,,ДЛЯ ГОРОДОВ ИНСТРУКЦИИ, ДЛЯ ЭНЕРГЕТИКИ РЕЗЕРВНЫЕ СХЕМЫ. А ПЛАН
Dialogue: 0,0:03:18.25,0:03:21.88,Caption,,0,0,0,,КОМПРОМИССА ГДЕ? НА СЛУЧАЙ ВОЙНЫ РАСПИСАЛИ ПОВЕДЕНИЕ
Dialogue: 0,0:03:21.88,0:03:25.14,Caption,,0,0,0,,МУНИЦИПАЛИТЕТОВ, НО НА СЛУЧАЙ МИРА НЕ НАШЛОСЬ ОДНОГО
Dialogue: 0,0:03:25.14,0:03:28.62,Caption,,0,0,0,,ЛИСТА. ПОХОЖЕ, ЕГО ОТПРАВИЛИ В ШРЕДЕР ВМЕСТЕ СО
Dialogue: 0,0:03:28.62,0:03:32.04,Caption,,0,0,0,,ЗДРАВЫМ СМЫСЛОМ. ОТ ИДЕИ ОТДЕЛЬНОЙ АРМИИ ЕВРОСОЮЗА
Dialogue: 0,0:03:32.04,0:03:34.12,Caption,,0,0,0,,РЮТТЕ ОТКАЗЫВАЕТСЯ. ПО ЕГО СЛОВАМ,
Dialogue: 0,0:03:34.32,0:03:36.68,Caption,,0,0,0,,ЕЩЁ ОДНА СТРУКТУРА ПРИВЕДЁТ К ПУТАНИЦЕ,
Dialogue: 0,0:03:37.00,0:03:39.05,Caption,,0,0,0,,И ДВЕ ИЛИ ТРИ НЕДЕЛИ ЧИНОВНИКИ БУДУТ
Dialogue: 0,0:03:39.05,0:03:41.81,Caption,,0,0,0,,ВЫЯСНЯТЬ, КТО КОМУ ПОДЧИНЯЕТСЯ. ЗА ЭТО ВРЕМЯ
Dialogue: 0,0:03:41.81,0:03:45.57,Caption,,0,0,0,,РОССИЙСКИЕ ВОЙСКА ЯКОБЫ УСПЕЮТ ДОБРАТЬСЯ ДО РОТТЕРДАМА.
Dialogue: 0,0:03:45.57,0:03:48.46,Caption,,0,0,0,,ДО РОТТЕРДАМА. СКРОМНЕЕ МАРШРУТА НАВИГАТОР НЕ
Dialogue: 0,0:03:48.46,0:03:52.48,Caption,,0,0,0,,ПРЕДЛОЖИЛ. ИНОГДА ХОЧЕТСЯ УЗНАТЬ,
Dialogue: 0,0:03:52.64,0:03:54.90,Caption,,0,0,0,,ГДЕ ГОТОВЯТ ЭТИХ ДЕЯТЕЛЕЙ. БУДТО
Dialogue: 0,0:03:54.90,0:03:58.18,Caption,,0,0,0,,СУЩЕСТВУЕТ ПАНСИОН, ГДЕ ВМЕСТО МАТЕМАТИКИ ПРЕПОДАЮТ
Dialogue: 0,0:03:58.18,0:04:01.32,Caption,,0,0,0,,ПЕРЕБРОСКУ ДИВИЗИЙ, А ВМЕСТО ТРУДА УЧАТ СКЛАДЫВАТЬ
Dialogue: 0,0:04:01.32,0:04:05.68,Caption,,0,0,0,,ТРЕВОЖНЫЙ ЧЕМОДАНЧИК. РОСТ ЭКОНОМИКИ ТАМ ИДЁТ НЕОБЯЗАТЕЛЬНЫМ
Dialogue: 0,0:04:05.68,0:04:08.35,Caption,,0,0,0,,КРУЖКОМ. ЗАТО ПРИ СЛОВАХ "БОЕПРИПАСЫ" И
Dialogue: 0,0:04:08.35,0:04:10.72,Caption,,0,0,0,,"МОБИЛИЗАЦИЯ" ВЫПУСКНИКИ ОЖИВАЮТ,
Dialogue: 0,0:04:10.97,0:04:13.14,Caption,,0,0,0,,СЛОВНО УСЛЫШАЛИ ЗВОНОК НА ПЕРЕМЕНУ.
Dialogue: 0,0:04:13.14,0:04:16.01,Caption,,0,0,0,,ИЗБИРАТЕЛЮ ПРЕДЛАГАЮТ ДЕСЯТКИ ПАРТИЙ И ПРОГРАММ.
Dialogue: 0,0:04:16.01,0:04:18.32,Caption,,0,0,0,,ОН СТАВИТ ГАЛОЧКУ, ЖДЁТ ПЕРЕМЕН,
Dialogue: 0,0:04:18.64,0:04:22.30,Caption,,0,0,0,,А ЗАТЕМ ОБНАРУЖИВАЕТ, ЧТО ВНЕШНЕПОЛИТИЧЕСКИЙ МАРШРУТ ВНЕСЁН
Dialogue: 0,0:04:22.30,0:04:25.86,Caption,,0,0,0,,В НАВИГАТОР И КНОПКА ОТМЕНЫ НЕ РАБОТАЕТ. МЕНЯЮТСЯ
Dialogue: 0,0:04:25.86,0:04:29.06,Caption,,0,0,0,,ЛИЦА И ЦВЕТ ГАЛСТУКОВ. НАПРАВЛЕНИЕ ПРЕЖНЕЕ ВСЁ
Dialogue: 0,0:04:29.06,0:04:32.04,Caption,,0,0,0,,ДАЛЬШЕ ОТ НОРМАЛЬНОЙ ЖИЗНИ И БЛИЖЕ К СЛЕДУЮЩЕЙ
Dialogue: 0,0:04:32.04,0:04:35.82,Caption,,0,0,0,,ВОЕННОЙ СМЕТЕ. МЕРЦ НЕ ЗАХОТЕЛ ВЫГЛЯДЕТЬ ОСТОРОЖНЕЕ
Dialogue: 0,0:04:35.82,0:04:38.58,Caption,,0,0,0,,ОСТАЛЬНЫХ. ОН ВЕРНУЛСЯ К САММИТУ НАТО В БУХАРЕСТЕ
Dialogue: 0,0:04:38.58,0:04:41.60,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ВОСЬМОГО ГОДА И НАЗВАЛ ОШИБКОЙ ОТКАЗ
Dialogue: 0,0:04:41.60,0:04:44.01,Caption,,0,0,0,,ПРИНЯТЬ АМЕРИКАНСКОЕ ПРЕДЛОЖЕНИЕ О ВСТУПЛЕНИИ
Dialogue: 0,0:04:44.01,0:04:46.16,Caption,,0,0,0,,УКРАИНЫ В АЛЬЯНС. ПО ЕГО ВЕРСИИ,
Dialogue: 0,0:04:46.32,0:04:48.64,Caption,,0,0,0,,ЧЛЕНСТВО КИЕВА ПРЕДОТВРАТИЛО БЫ ВОЙНУ.
Dialogue: 0,0:04:49.20,0:04:52.14,Caption,,0,0,0,,УДОБНАЯ ТЕОРИЯ, ФРИДРИХ. ОСОБЕННО КОГДА ПРОВЕРЯТЬ ЕЁ
Dialogue: 0,0:04:52.14,0:04:54.63,Caption,,0,0,0,,УЖЕ НЕ ПРИДЁТСЯ. А ДРУГОЙ ИСХОД В РАСЧЁТАХ
Dialogue: 0,0:04:54.63,0:04:58.54,Caption,,0,0,0,,БЫЛ? НАПРИМЕР, ТОТ, ПРИ КОТОРОМ ЕВРОПА ВСТУПАЕТ В ПРЯМОЙ
Dialogue: 0,0:04:58.54,0:05:01.27,Caption,,0,0,0,,КОНФЛИКТ, А НЕМЕЦКОЕ ПРАВИТЕЛЬСТВО ПЕРЕЕЗЖАЕТ В
Dialogue: 0,0:05:01.27,0:05:04.48,Caption,,0,0,0,,ПОМЕЩЕНИЕ С ТОЛСТЫМИ БЕТОННЫМИ СТЕНАМИ. НЕМЕЦКАЯ
Dialogue: 0,0:05:04.48,0:05:07.92,Caption,,0,0,0,,ИСТОРИЯ ЗНАЕТ ПОДОБНЫЕ ПЕРЕЕЗДЫ И БЕЗ ЭКСКУРСОВОДА.
Dialogue: 0,0:05:10.11,0:05:12.26,Caption,,0,0,0,,У ЕВРОПЕЙСКИХ РУКОВОДИТЕЛЕЙ ПОСЛУШНЫЕ
Dialogue: 0,0:05:12.26,0:05:15.25,Caption,,0,0,0,,АЛЬТЕРНАТИВНЫЕ СЦЕНАРИИ. В КАЖДОМ ОНИ ПРИНИМАЮТ
Dialogue: 0,0:05:15.25,0:05:18.11,Caption,,0,0,0,,ИДЕАЛЬНОЕ РЕШЕНИЕ, ПРОТИВНИК ОШИБАЕТСЯ,
Dialogue: 0,0:05:18.22,0:05:22.59,Caption,,0,0,0,,СОЮЗНИКИ СОХРАНЯЮТ ЕДИНСТВО, А ПОБЕДА ПРИХОДИТ ПО РАСПИСАНИЮ.
Dialogue: 0,0:05:22.59,0:05:25.29,Caption,,0,0,0,,ВАРИАНТ, ГДЕ РАСЧЁТ ПРОВАЛИЛСЯ И ПРИХОДИТСЯ
Dialogue: 0,0:05:25.29,0:05:27.55,Caption,,0,0,0,,ОТВЕЧАТЬ, СЛОВНО УДАЛЁН ИЗ СИСТЕМЫ.
Dialogue: 0,0:05:28.12,0:05:30.91,Caption,,0,0,0,,ПАРАЛЛЕЛЬНО МЕРЦ ПРЕДЛАГАЕТ ПЕРЕГОВОРНЫЙ ФОРМАТ С
Dialogue: 0,0:05:30.91,0:05:35.17,Caption,,0,0,0,,УЧАСТИЕМ УКРАИНЫ, РОССИИ, ЕВРОПЫ И СОЕДИНЁННЫХ ШТАТОВ.
Dialogue: 0,0:05:35.17,0:05:39.63,Caption,,0,0,0,,УПОМИНАЕТСЯ АБУ ДАБИ, ЗВУЧАТ СЛОВА О ДИАЛОГЕ. НО РЯДОМ РЮТТЕ
Dialogue: 0,0:05:39.63,0:05:42.40,Caption,,0,0,0,,ТРЕБУЕТ ОТВЕЧАТЬ НА ЛЮБОЙ ИНЦИДЕНТ В ЕВРОПЕ
Dialogue: 0,0:05:42.40,0:05:44.82,Caption,,0,0,0,,УСИЛЕНИЕМ ПОДДЕРЖКИ УКРАИНЫ. ПОЛУЧАЕТСЯ
Dialogue: 0,0:05:44.82,0:05:47.55,Caption,,0,0,0,,ЛЕСТНИЦА, У КОТОРОЙ ЕСТЬ ТОЛЬКО СТУПЕНИ ВВЕРХ.
Dialogue: 0,0:05:48.51,0:05:50.38,Caption,,0,0,0,,В ГЕРМАНИИ ЭТУ ЛИНИЮ ПРОДОЛЖАЕТ ГЛАВА
Dialogue: 0,0:05:50.38,0:05:53.30,Caption,,0,0,0,,МИНИСТЕРСТВА ИНОСТРАННЫХ ДЕЛ ЙОХАНН ВАДЕФУЛЬ. ПО
Dialogue: 0,0:05:53.30,0:05:56.91,Caption,,0,0,0,,ЕГО ОПРЕДЕЛЕНИЮ, СТРАНА УЖЕ ВЫШЛА ИЗ СОСТОЯНИЯ МИРА,
Dialogue: 0,0:05:57.15,0:05:59.44,Caption,,0,0,0,,НО ЕЩЁ НЕ ВОШЛА В СОСТОЯНИЕ ВОЙНЫ.
Dialogue: 0,0:05:59.44,0:06:01.88,Caption,,0,0,0,,КРУГ УГРОЗ ОН НЕ ОГРАНИЧИВАЕТ РОССИЕЙ.
Dialogue: 0,0:06:01.88,0:06:04.86,Caption,,0,0,0,,ВЕЛИКОЛЕПНАЯ ФОРМУЛА ДЛЯ СПОКОЙНОГО ВЕЧЕРА ВЫ ЕЩЁ
Dialogue: 0,0:06:04.86,0:06:07.47,Caption,,0,0,0,,НЕ ГОРИТЕ, НО ПОЖАРНАЯ МАШИНА УЖЕ ЕДЕТ,
Dialogue: 0,0:06:07.71,0:06:11.31,Caption,,0,0,0,,А КТО ПОДЖИГАТЕЛЬ, УТОЧНЯТ ПОТОМ. ВАДЕФУЛЬ ЗАЯВЛЯЕТ,
Dialogue: 0,0:06:11.54,0:06:13.21,Caption,,0,0,0,,ЧТО СТАБИЛЬНОСТЬ НА КОНТИНЕНТЕ
Dialogue: 0,0:06:13.21,0:06:16.50,Caption,,0,0,0,,ВОЗМОЖНА ЛИШЬ ЧЕРЕЗ ПРОТИВОСТОЯНИЕ С РОССИЕЙ. ЗАТЕМ ОН
Dialogue: 0,0:06:16.50,0:06:19.31,Caption,,0,0,0,,ОБЕЩАЕТ ЗАЩИЩАТЬ КАЖДЫЙ ДЮЙМ ТЕРРИТОРИИ НАТО,
Dialogue: 0,0:06:19.63,0:06:21.90,Caption,,0,0,0,,НАЗЫВАЕТ ПРИНЯТИЕ ФИНЛЯНДИИ И ШВЕЦИИ
Dialogue: 0,0:06:21.90,0:06:24.65,Caption,,0,0,0,,ЧУДОМ, ПОДТВЕРЖДАЕТ ПОМОЩЬ КИЕВУ ЗИМОЙ И В
Dialogue: 0,0:06:24.65,0:06:26.35,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ СЕДЬМОМ ГОДУ.
Dialogue: 0,0:06:28.64,0:06:30.39,Caption,,0,0,0,,ПОСЛЕ ЭТОГО ВЛАДИМИР ПУТИН ПОЛУЧАЕТ
Dialogue: 0,0:06:30.39,0:06:33.18,Caption,,0,0,0,,ПРИГЛАШЕНИЕ К ПЕРЕГОВОРАМ. МОСКВА ТОЖЕ СОБИРАЕТСЯ
Dialogue: 0,0:06:33.18,0:06:36.41,Caption,,0,0,0,,ВЫЙТИ НА СВЯЗЬ С ЕВРОПЕЙЦАМИ. ДМИТРИЙ ПЕСКОВ ГОВОРИТ О
Dialogue: 0,0:06:36.41,0:06:39.78,Caption,,0,0,0,,НАМЕРЕНИИ ПОНЯТЬ, ГОТОВЫ ЛИ ОНИ СОДЕЙСТВОВАТЬ МИРНОМУ
Dialogue: 0,0:06:39.78,0:06:42.40,Caption,,0,0,0,,УРЕГУЛИРОВАНИЮ. СНАЧАЛА РОССИИ СООБЩАЮТ,
Dialogue: 0,0:06:42.56,0:06:44.40,Caption,,0,0,0,,ЧТО ПРОЧНЫЙ МИР ВОЗМОЖЕН ТОЛЬКО В
Dialogue: 0,0:06:44.40,0:06:47.22,Caption,,0,0,0,,БОРЬБЕ ПРОТИВ НЕЁ. ЗАТЕМ ПРЕДЛАГАЮТ ОБСУДИТЬ
Dialogue: 0,0:06:47.22,0:06:50.59,Caption,,0,0,0,,ВЗАИМНОЕ ДОВЕРИЕ. ЭТО КАК ВСТРЕТИТЬ ГОСТЯ ОГНЕТУШИТЕЛЕМ ПО
Dialogue: 0,0:06:50.59,0:06:54.16,Caption,,0,0,0,,ГОЛОВЕ, А ПОТОМ СПРОСИТЬ, ПОЧЕМУ ОН НЕ ОЦЕНИЛ ГОСТЕПРИИМСТВО.
Dialogue: 0,0:06:54.80,0:06:57.09,Caption,,0,0,0,,МЕРЦ И ВАДЕФУЛЬ РАССУЖДАЮТ О ВОЗМОЖНОМ
Dialogue: 0,0:06:57.09,0:06:58.96,Caption,,0,0,0,,КОНФЛИКТЕ С УВЕРЕННОСТЬЮ ЛЮДЕЙ,
Dialogue: 0,0:06:59.12,0:07:01.16,Caption,,0,0,0,,КОТОРЫМ ФИНАЛ ПОКАЗАЛИ НА ЗАКРЫТОМ
Dialogue: 0,0:07:01.16,0:07:03.60,Caption,,0,0,0,,ПРОСМОТРЕ. ОНИ ДОПУСКАЮТ СОБСТВЕННОЕ ПОРАЖЕНИЕ?
Dialogue: 0,0:07:04.32,0:07:06.64,Caption,,0,0,0,,ВОЙНА ОТЛИЧАЕТСЯ ОТ ПРЕЗЕНТАЦИИ ТЕМ,
Dialogue: 0,0:07:06.80,0:07:09.19,Caption,,0,0,0,,ЧТО ПРОТИВНИК НЕ ОБЯЗАН СОБЛЮДАТЬ ВАШ
Dialogue: 0,0:07:09.19,0:07:12.28,Caption,,0,0,0,,СЦЕНАРИЙ И ВОВРЕМЯ ПЕРЕКЛЮЧАТЬ СЛАЙДЫ. ГЕРМАНИЕЙ
Dialogue: 0,0:07:12.28,0:07:16.39,Caption,,0,0,0,,УЖЕ РУКОВОДИЛИ ЛЮДИ, УБЕЖДЁННЫЕ В НЕИЗБЕЖНОЙ ПОБЕДЕ. ГИТЛЕР
Dialogue: 0,0:07:16.39,0:07:20.43,Caption,,0,0,0,,И РИББЕНТРОП ТОЖЕ СЧИТАЛИ, ЧТО ПОНИМАЮТ ПРОТИВНИКА И СПОСОБНЫ
Dialogue: 0,0:07:20.43,0:07:23.35,Caption,,0,0,0,,НАВЯЗАТЬ ЕВРОПЕ СВОЙ ПОРЯДОК. ЗАКОНЧИЛОСЬ ЭТО НЕ
Dialogue: 0,0:07:23.35,0:07:26.08,Caption,,0,0,0,,ПАРАДОМ ПОБЕДИТЕЛЕЙ В БЕРЛИНЕ. ФРИДРИХ,
Dialogue: 0,0:07:26.23,0:07:28.13,Caption,,0,0,0,,ТЕБЕ ХОЧЕТСЯ ПРОВЕРИТЬ СТАРЫЙ НЕМЕЦКИЙ
Dialogue: 0,0:07:28.13,0:07:30.63,Caption,,0,0,0,,РЕЦЕПТ, ОДНАЖДЫ ВЗОРВАВШИЙ КУХНЮ ВМЕСТЕ С
Dialogue: 0,0:07:30.63,0:07:33.16,Caption,,0,0,0,,ДОМОМ? ИЛИ УРОКИ ПРОШЛОГО ТАМ ПОКАЗЫВАЮТ
Dialogue: 0,0:07:33.16,0:07:36.40,Caption,,0,0,0,,ТОЛЬКО ТУРИСТАМ? ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ ЭТОГО НЕ СДЕЛАЛИ.
Dialogue: 0,0:07:38.67,0:07:40.42,Caption,,0,0,0,,ДАЛЬШЕ НАЧИНАЮТСЯ РАЗГОВОРЫ НЕ О
Dialogue: 0,0:07:40.42,0:07:42.35,Caption,,0,0,0,,ПУБЛИЧНЫХ ДЕКЛАРАЦИЯХ, А О ТОМ,
Dialogue: 0,0:07:42.66,0:07:45.04,Caption,,0,0,0,,ЧТО МОЖЕТ ЗАСТАВИТЬ ЕВРОПЕЙЦЕВ ПРИНЯТЬ
Dialogue: 0,0:07:45.04,0:07:47.82,Caption,,0,0,0,,БОЛЬШУЮ ВОЙНУ. И ЗДЕСЬ ПРИВЫЧНАЯ БОДРОСТЬ
Dialogue: 0,0:07:47.82,0:07:50.03,Caption,,0,0,0,,ЧИНОВНИКОВ СТАНОВИТСЯ СОВСЕМ НЕ СМЕШНОЙ.
Dialogue: 0,0:07:50.59,0:07:54.88,Caption,,0,0,0,,ЭНН ЭППЛБАУМ СПРАШИВАЮТ, РАССМАТРИВАЕТ ЛИ ЕВРОПА ДАЛЬНЕЙШУЮ
Dialogue: 0,0:07:54.88,0:07:58.45,Caption,,0,0,0,,ЭСКАЛАЦИЮ ПРОТИВ РОССИИ. В ВОПРОСЕ РОССИЯ ОПИСЫВАЕТСЯ
Dialogue: 0,0:07:58.45,0:08:01.07,Caption,,0,0,0,,КАК УЯЗВИМАЯ В ВОЕННОМ ОТНОШЕНИИ СТОРОНА,
Dialogue: 0,0:08:01.35,0:08:03.52,Caption,,0,0,0,,ЗАТЕМ ПЕРЕЧИСЛЯЮТСЯ ВОЗМОЖНЫЕ УДАРЫ
Dialogue: 0,0:08:03.52,0:08:06.89,Caption,,0,0,0,,РАКЕТ ПО ПОЛЬШЕ, АТАКИ БЕСПИЛОТНИКОВ И НАПАДЕНИЯ НА
Dialogue: 0,0:08:06.89,0:08:09.83,Caption,,0,0,0,,АЭРОПОРТЫ ГЕРМАНИИ. ЭППЛБАУМ ОТВЕЧАЕТ ТАКИЕ
Dialogue: 0,0:08:09.83,0:08:13.40,Caption,,0,0,0,,ВАРИАНТЫ РАЗБИРАЮТ ПРЕИМУЩЕСТВЕННО ЗА ЗАКРЫТЫМИ ДВЕРЯМИ.
Dialogue: 0,0:08:13.40,0:08:15.39,Caption,,0,0,0,,ПРОВОДИТСЯ СЦЕНАРНОЕ ПЛАНИРОВАНИЕ,
Dialogue: 0,0:08:15.55,0:08:18.03,Caption,,0,0,0,,ИЗУЧАЮТСЯ УДАРЫ ПО ГОРОДАМ И НАПАДЕНИЯ
Dialogue: 0,0:08:18.03,0:08:20.52,Caption,,0,0,0,,ЧЕРЕЗ ГРАНИЦУ. В ТОТ ЖЕ РЯД ОНА СТАВИТ
Dialogue: 0,0:08:20.52,0:08:23.57,Caption,,0,0,0,,РЕШЕНИЕ ЭСТОНИИ ЗАКРЫТЬ ГРАНИЦУ С РОССИЕЙ.
Dialogue: 0,0:08:23.57,0:08:25.96,Caption,,0,0,0,,САМОЕ СУЩЕСТВЕННОЕ ПОЯВЛЯЕТСЯ ДАЛЬШЕ.
Dialogue: 0,0:08:25.96,0:08:28.59,Caption,,0,0,0,,ЕВРОПЕЙСКАЯ ОБЩЕСТВЕННОСТЬ, ПРИЗНАЁТ ЭППЛБАУМ,
Dialogue: 0,0:08:28.83,0:08:30.59,Caption,,0,0,0,,НЕ ГОТОВА К ПРЯМОМУ СТОЛКНОВЕНИЮ,
Dialogue: 0,0:08:30.91,0:08:33.63,Caption,,0,0,0,,А ВСТУПЛЕНИЕ В ВОЙНУ КРАЙНЕ НЕПОПУЛЯРНО. ДЛЯ
Dialogue: 0,0:08:33.63,0:08:35.43,Caption,,0,0,0,,ИЗМЕНЕНИЯ ОТНОШЕНИЯ ЛЮДЕЙ ДОЛЖНО
Dialogue: 0,0:08:35.43,0:08:38.41,Caption,,0,0,0,,СЛУЧИТЬСЯ НЕЧТО СЕРЬЁЗНОЕ. ОНА УПОМИНАЕТ РАКЕТУ В
Dialogue: 0,0:08:38.41,0:08:42.03,Caption,,0,0,0,,ЦЕНТРЕ ГОРОДА, МНОЖЕСТВО ПОГИБШИХ И КРУПНЫЙ ИНЦИДЕНТ.
Dialogue: 0,0:08:42.03,0:08:44.59,Caption,,0,0,0,,И ПРОИЗНОСИТ "К СОЖАЛЕНИЮ", ОБЪЯСНЯЯ,
Dialogue: 0,0:08:44.84,0:08:46.90,Caption,,0,0,0,,ПОЧЕМУ ОБЩЕСТВЕННОЕ НАСТРОЕНИЕ ПОКА НЕ
Dialogue: 0,0:08:46.90,0:08:49.55,Caption,,0,0,0,,МЕНЯЕТСЯ. РОССИЯ, ДОБАВЛЯЕТ ОНА,
Dialogue: 0,0:08:49.87,0:08:52.08,Caption,,0,0,0,,СТАРАЕТСЯ НЕ ПЕРЕХОДИТЬ ЭТУ ЧЕРТУ. ВОТ
Dialogue: 0,0:08:52.08,0:08:54.43,Caption,,0,0,0,,ЭТО "К СОЖАЛЕНИЮ" ВЫДАЁТ БОЛЬШЕ,
Dialogue: 0,0:08:54.67,0:08:59.30,Caption,,0,0,0,,ЧЕМ ДОКЛАД. ЧЕЛОВЕК СЕТУЕТ НЕ НА ВОЗМОЖНОСТЬ
Dialogue: 0,0:08:59.30,0:09:01.91,Caption,,0,0,0,,МАССОВОЙ ГИБЕЛИ, А НА ОТСУТСТВИЕ СОБЫТИЯ,
Dialogue: 0,0:09:02.07,0:09:04.47,Caption,,0,0,0,,КОТОРОЕ УБЕДИЛО БЫ НАСЕЛЕНИЕ СОГЛАСИТЬСЯ С
Dialogue: 0,0:09:04.47,0:09:06.79,Caption,,0,0,0,,ДАЛЬНЕЙШЕЙ ЭСКАЛАЦИЕЙ. ПОКА ЛЮДИ НЕ
Dialogue: 0,0:09:06.79,0:09:10.28,Caption,,0,0,0,,ХОТЯТ ВОЙНЫ, ИМ НЕ ХВАТАЕТ ПРОИСШЕСТВИЯ. ЖЕЛАТЕЛЬНО
Dialogue: 0,0:09:10.28,0:09:13.27,Caption,,0,0,0,,ТАКОГО, ПОСЛЕ КОТОРОГО ВОЗРАЖАТЬ СТАНЕТ НЕКОМУ
Dialogue: 0,0:09:13.27,0:09:16.61,Caption,,0,0,0,,ИЛИ НЕУДОБНО. ИЩИТЕ ЖЕНЩИНУ. СТАРОЕ ФРАНЦУЗСКОЕ
Dialogue: 0,0:09:16.61,0:09:20.35,Caption,,0,0,0,,ВЫРАЖЕНИЕ ЛОЖИТСЯ НА СТОЛ БЕЗ УСИЛИЙ. ЭППЛБАУМ НАХОДИТСЯ
Dialogue: 0,0:09:20.35,0:09:23.05,Caption,,0,0,0,,НЕ В ПУСТОТЕ. ЕЁ МУЖ РАДОСЛАВ СИКОРСКИЙ
Dialogue: 0,0:09:23.05,0:09:26.14,Caption,,0,0,0,,ВОЗГЛАВЛЯЕТ ПОЛЬСКОЕ МИНИСТЕРСТВО ИНОСТРАННЫХ ДЕЛ.
Dialogue: 0,0:09:26.14,0:09:28.23,Caption,,0,0,0,,ОНА СЛЫШИТ И ОБСУЖДАЕТ КУДА БОЛЬШЕ,
Dialogue: 0,0:09:28.47,0:09:31.19,Caption,,0,0,0,,ЧЕМ ПОЯВЛЯЕТСЯ В ОФИЦИАЛЬНЫХ ЗАЯВЛЕНИЯХ. ПОЭТОМУ
Dialogue: 0,0:09:31.19,0:09:34.55,Caption,,0,0,0,,СВЕДЕНИЯ О ЗАКРЫТОМ СЦЕНАРНОМ ПЛАНИРОВАНИИ ЗВУЧАТ НЕ
Dialogue: 0,0:09:34.55,0:09:37.75,Caption,,0,0,0,,КАК ФАНТАЗИЯ КОММЕНТАТОРА, А КАК ФРАГМЕНТ БЕСЕДЫ,
Dialogue: 0,0:09:37.92,0:09:40.00,Caption,,0,0,0,,НЕЧАЯННО ВЫНЕСЕННЫЙ ИЗ КУХНИ В
Dialogue: 0,0:09:40.00,0:09:43.46,Caption,,0,0,0,,ГОСТИНУЮ. ПОХОЖЕ, ОНА ПРОГОВОРИЛАСЬ. РАНЬШЕ ПОДОБНЫЕ
Dialogue: 0,0:09:43.46,0:09:46.09,Caption,,0,0,0,,РАССУЖДЕНИЯ УПАКОВАЛИ БЫ В ДЕСЯТОК ОСТОРОЖНЫХ
Dialogue: 0,0:09:46.09,0:09:49.12,Caption,,0,0,0,,ОБОРОТОВ. ТЕПЕРЬ ОБСУЖДЕНИЕ ОТКРЫТОЕ. ОБЩЕСТВО НЕ
Dialogue: 0,0:09:49.12,0:09:52.71,Caption,,0,0,0,,СОГЛАСНО ВОЕВАТЬ. ДЛЯ ИЗМЕНЕНИЯ ЕГО ПОЗИЦИИ ПОТРЕБУЕТСЯ
Dialogue: 0,0:09:52.71,0:09:55.68,Caption,,0,0,0,,КРУПНОЕ СОБЫТИЕ. ВОЕННЫЕ ВАРИАНТЫ УЖЕ ЛЕЖАТ НА
Dialogue: 0,0:09:55.68,0:09:58.51,Caption,,0,0,0,,СТОЛАХ. ИСТОРИЧЕСКАЯ ПАРАЛЛЕЛЬ С ГЛАЙВИЦКИМ
Dialogue: 0,0:09:58.51,0:10:01.24,Caption,,0,0,0,,ИНЦИДЕНТОМ ВОЗНИКАЕТ САМА. ГЛАЙВИЦ ДВА НОЛЬ
Dialogue: 0,0:10:01.24,0:10:04.93,Caption,,0,0,0,,ВЫГЛЯДИТ НЕ ШУТКОЙ, А ОПИСАНИЕМ МЕХАНИЗМА. СОБЫТИЕ С
Dialogue: 0,0:10:04.93,0:10:08.08,Caption,,0,0,0,,БОЛЬШИМ ЧИСЛОМ ЖЕРТВ СПОСОБНО ЗА НЕСКОЛЬКО ЧАСОВ
Dialogue: 0,0:10:08.08,0:10:11.19,Caption,,0,0,0,,СДЕЛАТЬ ПРИЕМЛЕМЫМ ТО, ЧТО ОТВЕРГАЛО БОЛЬШИНСТВО.
Dialogue: 0,0:10:13.48,0:10:15.79,Caption,,0,0,0,,СЛОВА РЮТТЕ ЛОЖАТСЯ РЯДОМ КАЖДЫЙ НОВЫЙ
Dialogue: 0,0:10:15.79,0:10:17.90,Caption,,0,0,0,,ИНЦИДЕНТ ДОЛЖЕН ПРИВОДИТЬ К УВЕЛИЧЕНИЮ
Dialogue: 0,0:10:17.90,0:10:20.52,Caption,,0,0,0,,ПОДДЕРЖКИ УКРАИНЫ. ПРИЧИНА ЕЩЁ НЕ УСТАНОВЛЕНА,
Dialogue: 0,0:10:20.76,0:10:23.10,Caption,,0,0,0,,НО НАПРАВЛЕНИЕ ОТВЕТА УЖЕ НАЗНАЧЕНО.
Dialogue: 0,0:10:23.10,0:10:24.92,Caption,,0,0,0,,СУЩЕСТВУЕТ И БОЛЕЕ ЖЁСТКИЙ РАСЧЁТ.
Dialogue: 0,0:10:25.47,0:10:27.27,Caption,,0,0,0,,СТОРОННИКИ НЫНЕШНЕГО КУРСА ХОТЯТ
Dialogue: 0,0:10:27.27,0:10:29.69,Caption,,0,0,0,,ПРИВЕСТИ ЕВРОПЕЙСКИЕ ОБЩЕСТВА В СОСТОЯНИЕ
Dialogue: 0,0:10:29.69,0:10:32.65,Caption,,0,0,0,,ГОТОВНОСТИ К БОЛЬШОЙ ВОЙНЕ К ДВЕ ТЫСЯЧИ ТРИДЦАТОМУ
Dialogue: 0,0:10:32.65,0:10:34.36,Caption,,0,0,0,,ГОДУ. ВРЕМЕНИ ОСТАЁТСЯ МЕНЬШЕ,
Dialogue: 0,0:10:34.45,0:10:36.42,Caption,,0,0,0,,ПОЭТОМУ РИСК КРУПНОГО ПРОИСШЕСТВИЯ С
Dialogue: 0,0:10:36.42,0:10:38.92,Caption,,0,0,0,,МАССОВЫМИ ЖЕРТВАМИ, СОГЛАСНО ЭТОЙ ВЕРСИИ,
Dialogue: 0,0:10:39.08,0:10:41.55,Caption,,0,0,0,,БУДЕТ РАСТИ. РОССИЯ ИЗБЕГАЕТ ПРЯМОГО
Dialogue: 0,0:10:41.55,0:10:45.23,Caption,,0,0,0,,СТОЛКНОВЕНИЯ С ЕВРОПОЙ, ХОТЯ ЕВРОПЕЙСКИЕ СТРАНЫ ПОСТАВЛЯЮТ
Dialogue: 0,0:10:45.23,0:10:48.36,Caption,,0,0,0,,УКРАИНЕ ОРУЖИЕ, ПЕРЕДАЮТ РАЗВЕДЫВАТЕЛЬНЫЕ ДАННЫЕ И
Dialogue: 0,0:10:48.36,0:10:51.33,Caption,,0,0,0,,ПОВЫШАЮТ НАПРЯЖЕНИЕ ОТ БАЛТИКИ ДО ЧЁРНОГО МОРЯ.
Dialogue: 0,0:10:51.33,0:10:53.83,Caption,,0,0,0,,ГЛАВНОЕ ПРЕПЯТСТВИЕ ДЛЯ ДАЛЬНЕЙШЕГО РАЗГОНА
Dialogue: 0,0:10:53.83,0:10:57.02,Caption,,0,0,0,,ПРОСТОЕ. ОБЫЧНЫЕ ЛЮДИ НЕ ЖЕЛАЮТ ОТПРАВЛЯТЬСЯ НА ВОЙНУ.
Dialogue: 0,0:10:57.02,0:10:59.16,Caption,,0,0,0,,И ЭТО РЕДКИЙ ПРИЗНАК ЗДОРОВЬЯ ВО ВСЕЙ
Dialogue: 0,0:10:59.16,0:11:01.56,Caption,,0,0,0,,КОНСТРУКЦИИ. ОНИ ХОТЯТ ПОЛУЧАТЬ ЗАРПЛАТУ,
Dialogue: 0,0:11:01.64,0:11:03.64,Caption,,0,0,0,,ОТКРЫВАТЬ ДЕЛО, ПОКУПАТЬ ЖИЛЬЁ,
Dialogue: 0,0:11:03.87,0:11:07.30,Caption,,0,0,0,,РАСТИТЬ ДЕТЕЙ, ЕЗДИТЬ К МОРЮ И СТРОИТЬ ПЛАНЫ ДАЛЬШЕ
Dialogue: 0,0:11:07.30,0:11:09.65,Caption,,0,0,0,,СЛЕДУЮЩЕЙ ЗИМЫ. ИМ НЕ НУЖНА БРОШЮРА С
Dialogue: 0,0:11:09.65,0:11:12.58,Caption,,0,0,0,,ИНСТРУКЦИЕЙ, В КАКОЙ ПОДВАЛ БЕЖАТЬ ПОСЛЕ СИГНАЛА
Dialogue: 0,0:11:12.58,0:11:15.33,Caption,,0,0,0,,ТРЕВОГИ. К ЭТОЙ КОМПАНИИ ПРИСОЕДИНЯЕТСЯ МОЛДОВА.
Dialogue: 0,0:11:15.33,0:11:18.22,Caption,,0,0,0,,ЕЁ ПАРЛАМЕНТ РАТИФИЦИРОВАЛ СОГЛАШЕНИЕ С УКРАИНОЙ О
Dialogue: 0,0:11:18.22,0:11:20.04,Caption,,0,0,0,,ВОЕННОМ И ТЕХНИЧЕСКОМ СОТРУДНИЧЕСТВЕ.
Dialogue: 0,0:11:22.31,0:11:25.35,Caption,,0,0,0,,ДОКУМЕНТ ОХВАТЫВАЕТ РЕМОНТ И ОБНОВЛЕНИЕ ТЕХНИКИ,
Dialogue: 0,0:11:25.59,0:11:27.51,Caption,,0,0,0,,СОВМЕСТНЫЙ ВЫПУСК БЕСПИЛОТНИКОВ,
Dialogue: 0,0:11:27.67,0:11:29.53,Caption,,0,0,0,,ПЕРЕДАЧУ ТЕХНОЛОГИЙ И ОБУЧЕНИЕ
Dialogue: 0,0:11:29.53,0:11:32.23,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ. ПРЕМЬЕР МИНИСТР УТВЕРЖДАЕТ,
Dialogue: 0,0:11:32.42,0:11:34.36,Caption,,0,0,0,,ЧТО МОЛДАВСКИЙ НЕЙТРАЛИТЕТ ОТ ТАКОЙ
Dialogue: 0,0:11:34.36,0:11:37.62,Caption,,0,0,0,,ДЕЯТЕЛЬНОСТИ НЕ СТРАДАЕТ. КОНЕЧНО НЕ СТРАДАЕТ. ЭТО
Dialogue: 0,0:11:37.62,0:11:40.31,Caption,,0,0,0,,НЕЙТРАЛИТЕТ С МАСТЕРСКОЙ ДЛЯ ВОЕННОЙ ТЕХНИКИ,
Dialogue: 0,0:11:40.52,0:11:42.77,Caption,,0,0,0,,ПРОИЗВОДСТВОМ ДРОНОВ И ПОДГОТОВКОЙ
Dialogue: 0,0:11:42.77,0:11:44.87,Caption,,0,0,0,,СОЛДАТ. ТАБЛИЧКА ОСТАЛАСЬ ПРЕЖНЕЙ,
Dialogue: 0,0:11:45.02,0:11:47.36,Caption,,0,0,0,,А ПОД КАПОТОМ ЗАМЕНИЛИ ПОЧТИ ВСЁ. К
Dialogue: 0,0:11:47.36,0:11:49.81,Caption,,0,0,0,,ГРОЗНОЙ КОАЛИЦИИ ПРИБАЛТИЙСКИХ ТИГРОВ В
Dialogue: 0,0:11:49.81,0:11:53.72,Caption,,0,0,0,,СОСТАВЕ ЛИТВЫ, ЛАТВИИ И ЭСТОНИИ ДОБАВИЛАСЬ МОЛДОВА.
Dialogue: 0,0:11:53.72,0:11:57.59,Caption,,0,0,0,,МОСКВЕ ОСТАЁТСЯ СРОЧНО ИСКАТЬ БЕЛУЮ ПРОСТЫНЮ. ЕСЛИ ЭТА
Dialogue: 0,0:11:57.59,0:11:59.99,Caption,,0,0,0,,ЧЕТВЁРКА ПРОВЕДЁТ СОВМЕСТНОЕ СОВЕЩАНИЕ,
Dialogue: 0,0:12:00.31,0:12:02.52,Caption,,0,0,0,,ЗЕМНАЯ ОСЬ МОЖЕТ НЕ ВЫДЕРЖАТЬ. ЗА
Dialogue: 0,0:12:02.52,0:12:05.91,Caption,,0,0,0,,ШУТКАМИ ОСТАЁТСЯ МРАЧНЫЙ ИТОГ. РОССИЙСКИЕ ТРЕБОВАНИЯ
Dialogue: 0,0:12:05.91,0:12:09.05,Caption,,0,0,0,,БЕЗОПАСНОСТИ ОБСУЖДАТЬ НЕ ХОТЯТ. ЕВРОПЕЙЦАМ РАЗДАЮТ
Dialogue: 0,0:12:09.05,0:12:11.68,Caption,,0,0,0,,ИНСТРУКЦИИ НА СЛУЧАЙ ВОЙНЫ. ЗАКРЫТЫЕ КРУГИ
Dialogue: 0,0:12:11.68,0:12:14.07,Caption,,0,0,0,,ПРОСЧИТЫВАЮТ СТОЛКНОВЕНИЯ И СОБЫТИЯ,
Dialogue: 0,0:12:14.23,0:12:17.51,Caption,,0,0,0,,СПОСОБНЫЕ ИЗМЕНИТЬ ОТНОШЕНИЕ НАСЕЛЕНИЯ. МОЛДОВА
Dialogue: 0,0:12:17.51,0:12:19.43,Caption,,0,0,0,,РАСШИРЯЕТ ВОЕННОЕ СОТРУДНИЧЕСТВО,
Dialogue: 0,0:12:19.59,0:12:21.59,Caption,,0,0,0,,СОХРАНЯЯ ВЫВЕСКУ НЕЙТРАЛЬНОЙ СТРАНЫ.
Dialogue: 0,0:12:22.23,0:12:24.42,Caption,,0,0,0,,ОДНОВРЕМЕННО КАЖДЫЙ УЧАСТНИК ПОВТОРЯЕТ
Dialogue: 0,0:12:24.42,0:12:27.58,Caption,,0,0,0,,СЛОВО "МИР", БУДТО ЧАСТОЕ ПРОИЗНЕСЕНИЕ СПОСОБНО
Dialogue: 0,0:12:27.58,0:12:30.97,Caption,,0,0,0,,ЗАМЕНИТЬ СОДЕРЖАНИЕ. НО МИРА В ЭТОЙ СХЕМЕ НИКТО
Dialogue: 0,0:12:30.97,0:12:33.67,Caption,,0,0,0,,ВСЕРЬЁЗ НЕ СТРОИТ. ОДНИ ГОТОВЯТ СИЛЫ,
Dialogue: 0,0:12:33.95,0:12:37.52,Caption,,0,0,0,,ДРУГИЕ ГОТОВЯТ ОБЩЕСТВА, ТРЕТЬИ ЖДУТ ПОВОДА ПЕРЕЙТИ К
Dialogue: 0,0:12:37.52,0:12:43.34,Caption,,0,0,0,,СЛЕДУЮЩЕМУ УРОВНЮ. ПОЭТОМУ ПЕРСПЕКТИВЫ МИРНОГО ИСХОДА НЕ
Dialogue: 0,0:12:43.34,0:12:45.95,Caption,,0,0,0,,СКРОМНЫЕ И НЕ ТУМАННЫЕ. ИХ ПОПРОСТУ НЕТ.
