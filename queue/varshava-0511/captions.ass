Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,ДРОН ПРИЛЕТЕЛ К КИЕВУ С ЛИСТОВКАМИ. УЖЕ САМО
Dialogue: 0,0:00:03.16,0:00:07.40,Caption,,0,0,0,,ПО СЕБЕ ЗВУЧИТ ТАК, БУДТО КТО ТО ПЕРЕПУТАЛ ДВЕ ЭПОХИ. НО ПОСЛЕДНИЕ
Dialogue: 0,0:00:07.48,0:00:10.52,Caption,,0,0,0,,ДНИ ВООБЩЕ КАКИЕ ТО СТРАННЫЕ. ПОЯВЛЯЮТСЯ ВЕЩИ,
Dialogue: 0,0:00:10.76,0:00:13.00,Caption,,0,0,0,,О КОТОРЫХ РАНЬШЕ ГОВОРИЛИ ТОЛЬКО КАК О ПЛАНАХ.
Dialogue: 0,0:00:13.25,0:00:17.64,Caption,,0,0,0,,ВДРУГ ВСПОМИНАЮТ ТО, ЧТО ДЕСЯТИЛЕТИЯМИ ЛЕЖАЛО В АРХИВАХ. И ВСЁ ЭТО
Dialogue: 0,0:00:17.64,0:00:20.68,Caption,,0,0,0,,ПРОИСХОДИТ ПОЧТИ ОДНОВРЕМЕННО. СОВПАДЕНИЙ НАБИРАЕТСЯ
Dialogue: 0,0:00:20.68,0:00:23.48,Caption,,0,0,0,,МНОГОВАТО. ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ ВЕЩИ НЕ ПО
Dialogue: 0,0:00:23.48,0:00:26.20,Caption,,0,0,0,,ОТДЕЛЬНОСТИ, А КОГДА ИХ СТАВЯТ РЯДОМ И СМОТРЯТ,
Dialogue: 0,0:00:26.36,0:00:31.88,Caption,,0,0,0,,ЧТО ИЗ ЭТОГО ПОЛУЧАЕТСЯ, ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ЭТИМ И ЗАНИМАЕМСЯ. ИТАК,
Dialogue: 0,0:00:32.02,0:00:36.12,Caption,,0,0,0,,ЛИСТОВКИ. ПО СЛОВАМ КОМАНДУЮЩЕГО СИЛАМИ БЕСПИЛОТНЫХ СИСТЕМ
Dialogue: 0,0:00:36.12,0:00:39.16,Caption,,0,0,0,,УКРАИНЫ РОБЕРТА БРОВДИ, ИЗВЕСТНОГО КАК МАДЬЯР,
Dialogue: 0,0:00:39.56,0:00:42.68,Caption,,0,0,0,,РОССИЙСКИЙ БЕСПИЛОТНИК, НАПРАВЛЯВШИЙСЯ В СТОРОНУ КИЕВА,
Dialogue: 0,0:00:42.92,0:00:45.32,Caption,,0,0,0,,НЁС ВМЕСТЕ С БОЕВОЙ ЧАСТЬЮ ЕЩЁ И ПАЧКУ
Dialogue: 0,0:00:45.32,0:00:48.12,Caption,,0,0,0,,АГИТАЦИОННЫХ ЛИСТОВОК. ОДИН ВАРИАНТ ПРИЗЫВАЛ
Dialogue: 0,0:00:48.20,0:00:50.28,Caption,,0,0,0,,БОРОТЬСЯ С ТАК НАЗЫВАЕМЫМ ПРОИЗВОЛОМ ТЦК.
Dialogue: 0,0:00:51.00,0:00:53.72,Caption,,0,0,0,,В ДРУГОМ СООБЩАЛОСЬ О СОЗДАНИИ В РОССИЙСКОЙ АРМИИ
Dialogue: 0,0:00:53.72,0:00:56.44,Caption,,0,0,0,,УКРАИНСКОЙ ДОБРОВОЛЬЧЕСКОЙ БРИГАДЫ И ПРЕДЛАГАЛОСЬ
Dialogue: 0,0:00:56.52,0:00:59.00,Caption,,0,0,0,,ВЫБРАТЬ ДЛЯ НЕЁ НАЗВАНИЕ. СПИСОК ТАМ,
Dialogue: 0,0:00:59.16,0:01:01.72,Caption,,0,0,0,,НАДО СКАЗАТЬ, БОГАТЫЙ. КИЕВСКАЯ РУСЬ,
Dialogue: 0,0:01:01.96,0:01:05.80,Caption,,0,0,0,,НЕСТОР МАХНО, БОГДАН ХМЕЛЬНИЦКИЙ. ТО ЕСТЬ ГОЛОСОВАНИЕ РЕШИЛИ
Dialogue: 0,0:01:05.80,0:01:08.52,Caption,,0,0,0,,ОРГАНИЗОВАТЬ СРАЗУ С ДОСТАВКОЙ НА ДОМ. ОСТАЛОСЬ
Dialogue: 0,0:01:08.52,0:01:11.40,Caption,,0,0,0,,ТОЛЬКО УРНУ ДЛЯ БЮЛЛЕТЕНЕЙ К ДРОНУ ПРИКРУТИТЬ. НА
Dialogue: 0,0:01:11.40,0:01:18.09,Caption,,0,0,0,,ЛИСТОВКАХ БЫЛ ЕЩЁ И QR КОД. МАДЬЯР ОТДЕЛЬНО ПРЕДУПРЕДИЛ ЕГО НЕ СКАНИРОВАТЬ,
Dialogue: 0,0:01:18.17,0:01:21.85,Caption,,0,0,0,,ЗАЯВИВ, ЧТО ЧЕРЕЗ НЕГО МОГУТ ПОПЫТАТЬСЯ УКРАСТЬ ДАННЫЕ ИЛИ
Dialogue: 0,0:01:21.85,0:01:24.81,Caption,,0,0,0,,ЗАРАЗИТЬ ТЕЛЕФОН ВРЕДОНОСНОЙ ПРОГРАММОЙ. ТУТ ВООБЩЕ
Dialogue: 0,0:01:24.81,0:01:27.77,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ИНТЕРЕСНЫЙ НАБОР. БУМАЖНАЯ ЛИСТОВКА ИЗ
Dialogue: 0,0:01:27.77,0:01:31.93,Caption,,0,0,0,,ПРОШЛОГО ВЕКА, QR КОД ИЗ НЫНЕШНЕГО И БЕСПИЛОТНИК В КАЧЕСТВЕ
Dialogue: 0,0:01:31.93,0:01:35.37,Caption,,0,0,0,,ПОЧТАЛЬОНА. НО БУКВАЛЬНО РЯДОМ ПОЯВЛЯЕТСЯ УЖЕ СОВСЕМ
Dialogue: 0,0:01:35.37,0:01:38.41,Caption,,0,0,0,,ДРУГАЯ ИСТОРИЯ С РОССИЙСКИМИ ДРОНАМИ. НАЗВАНИЕ
Dialogue: 0,0:01:38.63,0:01:41.77,Caption,,0,0,0,,"РАССВЕТ". РОССИЯ РАЗВОРАЧИВАЕТ СОБСТВЕННУЮ
Dialogue: 0,0:01:41.77,0:01:44.73,Caption,,0,0,0,,НИЗКООРБИТАЛЬНУЮ СПУТНИКОВУЮ СЕТЬ СВЯЗИ. НА НАЧАЛО
Dialogue: 0,0:01:44.81,0:01:46.73,Caption,,0,0,0,,НОЯБРЯ ИЗ ДВУХ СЕРИЙНЫХ ПАРТИЙ,
Dialogue: 0,0:01:46.88,0:01:49.05,Caption,,0,0,0,,ПО ОТКРЫТЫМ ДАННЫМ ОРБИТАЛЬНОГО НАБЛЮДЕНИЯ,
Dialogue: 0,0:01:49.44,0:01:52.49,Caption,,0,0,0,,НА ОРБИТЕ ОСТАВАЛИСЬ ТРИДЦАТЬ АППАРАТОВ. ДВАДЦАТЬ
Dialogue: 0,0:01:52.49,0:01:54.57,Caption,,0,0,0,,ШЕСТЬ ИЗ НИХ УЖЕ ВЫШЛИ ПРИМЕРНО НА ВЫСОТУ
Dialogue: 0,0:01:54.57,0:01:57.21,Caption,,0,0,0,,ПЯТЬСОТ ВОСЕМЬ КИЛОМЕТРОВ. ТО ЕСТЬ РЕЧЬ УЖЕ НЕ
Dialogue: 0,0:01:57.29,0:01:59.69,Caption,,0,0,0,,О КРАСИВОЙ ПРЕЗЕНТАЦИИ С РАКЕТОЙ НА ЭКРАНЕ И
Dialogue: 0,0:01:59.69,0:02:03.05,Caption,,0,0,0,,ОБЕЩАНИЕМ КОГДА НИБУДЬ ВСЁ ЗАПУСТИТЬ. ЖЕЛЕЗО ЛЕТАЕТ
Dialogue: 0,0:02:03.13,0:02:05.61,Caption,,0,0,0,,НАД ЗЕМЛЁЙ. ДО ПОЛНОЦЕННОГО РОССИЙСКОГО АНАЛОГА
Dialogue: 0,0:02:05.61,0:02:08.73,Caption,,0,0,0,,STARLINK ТАМ ЕЩЁ ДАЛЕКО. НО ДЛЯ ВОЕННОЙ ЗАДАЧИ
Dialogue: 0,0:02:08.73,0:02:10.89,Caption,,0,0,0,,ВООБЩЕ НЕ ОБЯЗАТЕЛЬНО НАКРЫВАТЬ ИНТЕРНЕТОМ ВСЮ
Dialogue: 0,0:02:10.89,0:02:14.49,Caption,,0,0,0,,ПЛАНЕТУ, ЧТОБЫ КОТИКИ В ЯКУТИИ СМОТРЕЛИ ВИДЕО БЕЗ ЗАДЕРЖЕК.
Dialogue: 0,0:02:14.94,0:02:17.77,Caption,,0,0,0,,НУЖНО ДРУГОЕ ПОЛУЧИТЬ УСТОЙЧИВЫЙ КАНАЛ ТАМ,
Dialogue: 0,0:02:17.85,0:02:20.49,Caption,,0,0,0,,ГДЕ ОН НУЖЕН. УКРАИНСКИЙ СПЕЦИАЛИСТ СЕРГЕЙ
Dialogue: 0,0:02:20.49,0:02:22.57,Caption,,0,0,0,,БЕСКРЕСТНОВ, ИЗВЕСТНЫЙ КАК ФЛЕШ,
Dialogue: 0,0:02:22.89,0:02:24.65,Caption,,0,0,0,,ДАВНО ПРЕДУПРЕЖДАЕТ ИМЕННО ОБ ЭТОМ.
Dialogue: 0,0:02:26.93,0:02:29.57,Caption,,0,0,0,,ЕСЛИ РОССИЙСКИЕ БЕСПИЛОТНИКИ ПОЛУЧАТ СПУТНИКОВУЮ
Dialogue: 0,0:02:29.57,0:02:33.01,Caption,,0,0,0,,СВЯЗЬ, ОПЕРАТОРУ УЖЕ НЕ ПРИДЁТСЯ ПОЛНОСТЬЮ ОТДАВАТЬ АППАРАТ
Dialogue: 0,0:02:33.09,0:02:35.89,Caption,,0,0,0,,НА ВОЛЮ ЗАРАНЕЕ ЗАЛОЖЕННОГО МАРШРУТА. ПОЯВЛЯЕТСЯ
Dialogue: 0,0:02:35.89,0:02:39.33,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ПОЛУЧАТЬ ДАННЫЕ, МЕНЯТЬ ЗАДАЧУ В ПОЛЁТЕ,
Dialogue: 0,0:02:39.49,0:02:44.05,Caption,,0,0,0,,КОРРЕКТИРОВАТЬ НАПРАВЛЕНИЕ, РАБОТАТЬ ЗНАЧИТЕЛЬНО ДАЛЬШЕ ОБЫЧНОГО РАДИОГОРИЗОНТА.
Dialogue: 0,0:02:44.42,0:02:47.73,Caption,,0,0,0,,ВОТ ТУТ РАЗНИЦА УЖЕ СЕРЬЁЗНАЯ. ОБЫЧНЫЙ ДАЛЬНИЙ ДРОН
Dialogue: 0,0:02:48.00,0:02:52.45,Caption,,0,0,0,,ВО МНОГОМ ПОХОЖ НА КУРЬЕРА, КОТОРОМУ ДАЛИ АДРЕС И ВЫПУСТИЛИ ИЗ ДОМА. ПО
Dialogue: 0,0:02:52.45,0:02:54.45,Caption,,0,0,0,,ДОРОГЕ ХОЗЯИН УЖЕ НЕ ОЧЕНЬ ПОНИМАЕТ,
Dialogue: 0,0:02:54.61,0:02:57.73,Caption,,0,0,0,,ГДЕ ИМЕННО ТОТ КУРЬЕР СВЕРНУЛ НЕ ТУДА. СО
Dialogue: 0,0:02:57.81,0:03:00.29,Caption,,0,0,0,,СПУТНИКОВОЙ СВЯЗЬЮ ХОЗЯИН НАЧИНАЕТ ПЕРИОДИЧЕСКИ
Dialogue: 0,0:03:00.29,0:03:03.01,Caption,,0,0,0,,БРАТЬ ТРУБКУ. ИМЕННО ПОЭТОМУ ВОКРУГ "РАССВЕТА"
Dialogue: 0,0:03:03.01,0:03:07.57,Caption,,0,0,0,,СТОЛЬКО ВНИМАНИЯ. НЕ ПОТОМУ, ЧТО ТРИДЦАТЬ СПУТНИКОВ ВНЕЗАПНО ЗАМЕНИЛИ ТЫСЯЧИ
Dialogue: 0,0:03:07.65,0:03:12.85,Caption,,0,0,0,,АППАРАТОВ STARLINK. А ПОТОМУ, ЧТО ВОЕННЫМ НЕ НУЖЕН STARLINK ЦЕЛИКОМ. ИМ НУЖЕН
Dialogue: 0,0:03:12.85,0:03:16.13,Caption,,0,0,0,,РАБОТАЮЩИЙ КУСОК СИСТЕМЫ НАД НУЖНОЙ ТЕРРИТОРИЕЙ В
Dialogue: 0,0:03:16.21,0:03:19.97,Caption,,0,0,0,,НУЖНОЕ ВРЕМЯ. ПО ОЦЕНКАМ, КОТОРЫЕ ПУБЛИКОВАЛИСЬ ЕЩЁ РАНЬШЕ,
Dialogue: 0,0:03:20.21,0:03:23.01,Caption,,0,0,0,,ДАЖЕ НЫНЕШНЯЯ КОНФИГУРАЦИЯ СПОСОБНА СОЗДАВАТЬ НАД
Dialogue: 0,0:03:23.01,0:03:25.33,Caption,,0,0,0,,УКРАИНОЙ ОТДЕЛЬНЫЕ ОКНА СВЯЗИ.
Dialogue: 0,0:03:25.88,0:03:27.73,Caption,,0,0,0,,ДАЛЬШЕ ВОПРОС КОЛИЧЕСТВА АППАРАТОВ,
Dialogue: 0,0:03:27.88,0:03:32.53,Caption,,0,0,0,,ПОКРЫТИЯ, ТЕРМИНАЛОВ И ТОГО, НАСКОЛЬКО БЫСТРО ВСЁ ЭТО СМОГУТ ДОВЕСТИ ДО
Dialogue: 0,0:03:32.61,0:03:35.65,Caption,,0,0,0,,НОРМАЛЬНОЙ ЭКСПЛУАТАЦИИ. И ВОТ НА ЭТОМ ФОНЕ ПАШИНЯН
Dialogue: 0,0:03:35.65,0:03:38.05,Caption,,0,0,0,,БЕРЁТ И ОКОНЧАТЕЛЬНО ФОРМУЛИРУЕТ ТО,
Dialogue: 0,0:03:38.21,0:03:41.49,Caption,,0,0,0,,К ЧЕМУ ЕРЕВАН ШЁЛ УЖЕ ДАВНО. ИНТЕРЕСЫ АРМЕНИИ
Dialogue: 0,0:03:41.57,0:03:48.50,Caption,,0,0,0,,В ОДКБ ИСЧЕРПАНЫ. НЕ "МЫ НЕМНОГО НЕДОВОЛЬНЫ". НЕ "ЕСТЬ ВОПРОСЫ К
Dialogue: 0,0:03:48.50,0:03:50.98,Caption,,0,0,0,,ПАРТНЁРАМ". НЕ "НАДО ОБСУДИТЬ ДАЛЬНЕЙШЕЕ
Dialogue: 0,0:03:50.98,0:03:54.66,Caption,,0,0,0,,ВЗАИМОДЕЙСТВИЕ". ИСЧЕРПАНЫ. ФОРМУЛИРОВКА ХОРОШАЯ.
Dialogue: 0,0:03:54.80,0:03:59.94,Caption,,0,0,0,,ТАКАЯ, ЗНАЕТЕ, БАНКОВСКАЯ. СЧЁТ БЫЛ. ДЕНЬГИ ЗАКОНЧИЛИСЬ. СПАСИБО,
Dialogue: 0,0:04:00.02,0:04:03.78,Caption,,0,0,0,,ДО СВИДАНИЯ. АРМЕНИЯ УЖЕ ДАВНО ФАКТИЧЕСКИ НЕ УЧАСТВУЕТ В РАБОТЕ
Dialogue: 0,0:04:03.78,0:04:06.98,Caption,,0,0,0,,ОРГАНИЗАЦИИ. УЧАСТИЕ ЗАМОРОЖЕНО. НА ЗАСЕДАНИЯ НЕ
Dialogue: 0,0:04:06.98,0:04:10.10,Caption,,0,0,0,,ЕЗДИТ. ВЗНОСЫ НЕ ПЛАТИТ. ВОЕННОЕ СОТРУДНИЧЕСТВО ПО
Dialogue: 0,0:04:10.10,0:04:13.38,Caption,,0,0,0,,ЛИНИИ ОДКБ ФАКТИЧЕСКИ ОСТАНОВЛЕНО. И ТУТ ВОЗНИКАЕТ
Dialogue: 0,0:04:13.38,0:04:16.26,Caption,,0,0,0,,ПОЧТИ БЫТОВАЯ СИТУАЦИЯ. ВЫ В КЛУБ НЕ ХОДИТЕ.
Dialogue: 0,0:04:16.65,0:04:20.02,Caption,,0,0,0,,НА МЕРОПРИЯТИЯ НЕ ПРИХОДИТЕ. ВЗНОСЫ НЕ ПЛАТИТЕ. ПРО
Dialogue: 0,0:04:20.10,0:04:23.38,Caption,,0,0,0,,КЛУБ РАССКАЗЫВАЕТЕ, ЧТО ОН ВАМ БОЛЬШЕ ВООБЩЕ НЕ НУЖЕН. А
Dialogue: 0,0:04:23.38,0:04:25.94,Caption,,0,0,0,,КАРТОЧКА ЧЛЕНА КЛУБА ВСЁ ЕЩЁ ЛЕЖИТ В КОШЕЛЬКЕ.
Dialogue: 0,0:04:26.59,0:04:29.30,Caption,,0,0,0,,ОДКБ ТЕПЕРЬ ОБСУЖДАЕТ УЖЕ СВОИ ПРОЦЕДУРЫ. В
Dialogue: 0,0:04:29.30,0:04:34.74,Caption,,0,0,0,,ЧАСТНОСТИ, ВОПРОС О ТОМ, ЧТОБЫ ЛИШИТЬ АРМЕНИЮ ПРАВА ГОЛОСА И ПРАВА ВЫДВИГАТЬ
Dialogue: 0,0:04:34.74,0:04:37.22,Caption,,0,0,0,,СВОИХ ПРЕДСТАВИТЕЛЕЙ НА КВОТНЫЕ ДОЛЖНОСТИ ДО
Dialogue: 0,0:04:37.22,0:04:40.58,Caption,,0,0,0,,ПОГАШЕНИЯ ЗАДОЛЖЕННОСТИ. КРАСИВО. СТРАНА ГОВОРИТ НАМ
Dialogue: 0,0:04:40.66,0:04:43.38,Caption,,0,0,0,,ОТ ВАС УЖЕ НИЧЕГО НЕ НАДО. ОРГАНИЗАЦИЯ ОТВЕЧАЕТ
Dialogue: 0,0:04:43.38,0:04:45.78,Caption,,0,0,0,,ТОГДА МЫ ВАМ ЕЩЁ И ГОЛОС ОТКЛЮЧИМ. СПОР
Dialogue: 0,0:04:45.78,0:04:48.90,Caption,,0,0,0,,ПРИМЕРНО КАК У ЧЕЛОВЕКА, КОТОРЫЙ УЖЕ ВЫШЕЛ ИЗ РЕСТОРАНА,
Dialogue: 0,0:04:49.14,0:04:51.54,Caption,,0,0,0,,А ОФИЦИАНТ БЕЖИТ СЛЕДОМ И КРИЧИТ МЕЖДУ ПРОЧИМ,
Dialogue: 0,0:04:51.78,0:04:53.22,Caption,,0,0,0,,СТОЛИК МЫ ВАМ БОЛЬШЕ НЕ ДАДИМ.
Dialogue: 0,0:04:53.78,0:04:56.66,Caption,,0,0,0,,НО ЗДЕСЬ ВАЖНА НЕ КОМЕДИЯ СО ВЗНОСАМИ. ПАШИНЯН
Dialogue: 0,0:04:56.74,0:04:59.54,Caption,,0,0,0,,НЕ ВЧЕРА НАЧАЛ ЭТУ ЛИНИЮ. ЕРЕВАН ВСЁ АКТИВНЕЕ
Dialogue: 0,0:04:59.62,0:05:04.63,Caption,,0,0,0,,СМОТРИТ В СТОРОНУ ЕВРОСОЮЗА. РАНЕЕ УЖЕ ЗВУЧАЛО,
Dialogue: 0,0:05:04.86,0:05:07.75,Caption,,0,0,0,,ЧТО ОФИЦИАЛЬНУЮ ЗАЯВКУ НА ВСТУПЛЕНИЕ МОГУТ ПОДАТЬ В
Dialogue: 0,0:05:07.83,0:05:10.31,Caption,,0,0,0,,ДВАДЦАТЬ СЕДЬМОМ ИЛИ ДВАДЦАТЬ ВОСЬМОМ ГОДУ. ТАК ЧТО
Dialogue: 0,0:05:10.31,0:05:13.19,Caption,,0,0,0,,НЫНЕШНЯЯ ФРАЗА ОБ ИСЧЕРПАННЫХ ИНТЕРЕСАХ УЖЕ НЕ
Dialogue: 0,0:05:13.19,0:05:16.15,Caption,,0,0,0,,ВЫГЛЯДИТ РАЗДРАЖЕНИЕМ ОДНОГО ДНЯ. ЭТО ЕЩЁ ОДИН КУСОК
Dialogue: 0,0:05:16.15,0:05:20.39,Caption,,0,0,0,,БОЛЬШОГО РАЗВОРОТА, КОТОРЫЙ ИДЁТ НЕ ПЕРВЫЙ ГОД. А ТЕПЕРЬ РЯДОМ
Dialogue: 0,0:05:20.47,0:05:23.67,Caption,,0,0,0,,С СОВРЕМЕННЫМИ АЛЬЯНСАМИ ВНЕЗАПНО ПОЯВЛЯЕТСЯ ПРИВЕТ
Dialogue: 0,0:05:23.72,0:05:26.63,Caption,,0,0,0,,ИЗ СОВСЕМ ДРУГОЙ ЭПОХИ. В СЕТИ СНОВА ВСПЛЫЛА
Dialogue: 0,0:05:26.63,0:05:29.51,Caption,,0,0,0,,СТАРАЯ КАРТА ПЛАНОВ СТРАН ВАРШАВСКОГО ДОГОВОРА ПО
Dialogue: 0,0:05:29.51,0:05:31.99,Caption,,0,0,0,,БОЕВЫМ ДЕЙСТВИЯМ ПРОТИВ НАТО. ОЧЕНЬ ВОВРЕМЯ,
Dialogue: 0,0:05:32.08,0:05:34.87,Caption,,0,0,0,,КОНЕЧНО. ВАРШАВСКОГО ДОГОВОРА НЕТ БОЛЬШЕ ТРИДЦАТИ
Dialogue: 0,0:05:34.87,0:05:38.47,Caption,,0,0,0,,ЛЕТ. СОВЕТСКОГО СОЮЗА НЕТ. ГЕРМАНИЯ ДАВНО ОДНА.
Dialogue: 0,0:05:38.63,0:05:41.67,Caption,,0,0,0,,ПОЛЬША САМА В НАТО. ПОЛИТИЧЕСКАЯ КАРТА ЕВРОПЫ
Dialogue: 0,0:05:41.67,0:05:45.03,Caption,,0,0,0,,ПЕРЕКРАШЕНА НЕСКОЛЬКО РАЗ. А СТАРАЯ ВОЕННАЯ КАРТА
Dialogue: 0,0:05:45.27,0:05:48.63,Caption,,0,0,0,,ВДРУГ СНОВА ГУЛЯЕТ ПО СЕТИ ИМЕННО СЕЙЧАС. КТО
Dialogue: 0,0:05:48.63,0:05:51.59,Caption,,0,0,0,,ИМЕННО ВЕРНУЛ ЭТУ КАРТУ В ОБСУЖДЕНИЕ И ЗАЧЕМ,
Dialogue: 0,0:05:51.67,0:05:54.95,Caption,,0,0,0,,НЕИЗВЕСТНО. НО ВОПРОС ИНТЕРЕСНЫЙ. ПОЧЕМУ ИМЕННО
Dialogue: 0,0:05:54.95,0:05:58.55,Caption,,0,0,0,,СЕЙЧАС? ПОЧЕМУ НА ФОНЕ НЫНЕШНЕГО ПЕРЕВООРУЖЕНИЯ ЕВРОПЫ,
Dialogue: 0,0:05:58.93,0:06:00.71,Caption,,0,0,0,,РАЗГОВОРОВ О ГОТОВНОСТИ АРМИЙ,
Dialogue: 0,0:06:00.86,0:06:07.03,Caption,,0,0,0,,УКРЕПЛЕНИЯ ГРАНИЦ, НОВЫХ БАЗ, РАДАРОВ И ВОЕННЫХ БЮДЖЕТОВ ВДРУГ СНОВА ПОНАДОБИЛОСЬ
Dialogue: 0,0:06:07.11,0:06:09.91,Caption,,0,0,0,,СМОТРЕТЬ НА КАРТУ ПРЯМОГО СТОЛКНОВЕНИЯ ДВУХ ВОЕННЫХ
Dialogue: 0,0:06:09.91,0:06:15.11,Caption,,0,0,0,,БЛОКОВ? СОВПАДЕНИЕ? РАДИ БОГА. ТОГДА СОВПАДЕНИЕ ДЕЙСТВИТЕЛЬНО КРАСИВОЕ.
Dialogue: 0,0:06:15.38,0:06:19.35,Caption,,0,0,0,,А ВЫ ЧТО ДУМАЕТЕ? ПОЧЕМУ ИМЕННО СЕЙЧАС ЭТУ КАРТУ СНОВА ВЫТАЩИЛИ В
Dialogue: 0,0:06:19.35,0:06:26.04,Caption,,0,0,0,,ИНФОРМАЦИОННОЕ ПРОСТРАНСТВО? НАПИШИТЕ В КОММЕНТАРИЯХ И ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ
Dialogue: 0,0:06:26.04,0:06:28.04,Caption,,0,0,0,,ИНТЕРЕСНО НЕ ГОТОВЫЙ ОТВЕТ ПОЛУЧИТЬ,
Dialogue: 0,0:06:28.19,0:06:30.76,Caption,,0,0,0,,А ПОСМОТРЕТЬ, КАКИЕ ВЕРСИИ УВИДЯТ ЛЮДИ.
Dialogue: 0,0:06:31.55,0:06:34.12,Caption,,0,0,0,,И ПОКА СТАРАЯ КАРТА ПУТЕШЕСТВУЕТ ПО ИНТЕРНЕТУ,
Dialogue: 0,0:06:34.43,0:06:37.96,Caption,,0,0,0,,НОВАЯ ЕВРОПА НАЧИНАЕТ СЧИТАТЬ ДЕНЬГИ. МНОГО ДЕНЕГ.
Dialogue: 0,0:06:38.44,0:06:40.76,Caption,,0,0,0,,ПО ДАННЫМ СТОКГОЛЬМСКОГО ИНСТИТУТА ИССЛЕДОВАНИЯ
Dialogue: 0,0:06:40.76,0:06:44.76,Caption,,0,0,0,,ПРОБЛЕМ МИРА, В ДВАДЦАТЬ ПЯТОМ ГОДУ ВОЕННЫЕ РАСХОДЫ ЕВРОПЫ ВЫРОСЛИ
Dialogue: 0,0:06:44.76,0:06:47.48,Caption,,0,0,0,,СРАЗУ НА ЧЕТЫРНАДЦАТЬ ПРОЦЕНТОВ. ПРИЧЁМ ЕВРОПА
Dialogue: 0,0:06:47.48,0:06:50.76,Caption,,0,0,0,,ОКАЗАЛАСЬ САМЫМ БЫСТРОРАСТУЩИМ РЕГИОНОМ МИРА ПО
Dialogue: 0,0:06:50.76,0:06:53.56,Caption,,0,0,0,,ТЕМПАМ УВЕЛИЧЕНИЯ ВОЕННЫХ РАСХОДОВ. ВСЕГО
Dialogue: 0,0:06:53.56,0:06:55.96,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ СТРАНЫ ПОТРАТИЛИ ОКОЛО ВОСЬМИСОТ
Dialogue: 0,0:06:55.96,0:06:58.92,Caption,,0,0,0,,ШЕСТИДЕСЯТИ ЧЕТЫРЁХ МИЛЛИАРДОВ ДОЛЛАРОВ. ГЕРМАНИЯ
Dialogue: 0,0:06:58.92,0:07:02.04,Caption,,0,0,0,,ПОТРАТИЛА СТО ЧЕТЫРНАДЦАТЬ МИЛЛИАРДОВ. РОСТ ЗА ГОД
Dialogue: 0,0:07:02.12,0:07:04.76,Caption,,0,0,0,,ПОЧТИ НА ЧЕТВЕРТЬ. ИСПАНИЯ УВЕЛИЧИЛА РАСХОДЫ
Dialogue: 0,0:07:04.76,0:07:07.64,Caption,,0,0,0,,ПРИМЕРНО НАПОЛОВИНУ. ПОЛЬША ПОТРАТИЛА НА ОБОРОНУ
Dialogue: 0,0:07:07.72,0:07:10.76,Caption,,0,0,0,,ОКОЛО ЧЕТЫРЁХ С ПОЛОВИНОЙ ПРОЦЕНТОВ СВОЕГО ВВП. ЭТО
Dialogue: 0,0:07:10.76,0:07:13.72,Caption,,0,0,0,,САМЫЙ ВЫСОКИЙ ПОКАЗАТЕЛЬ СРЕДИ СТРАН НАТО. И ЭТО
Dialogue: 0,0:07:13.72,0:07:16.04,Caption,,0,0,0,,УЖЕ НЕ ИСТОРИЯ ПРО "ДАДИМ АРМИИ ЕЩЁ ПАРУ
Dialogue: 0,0:07:16.04,0:07:19.96,Caption,,0,0,0,,МИЛЛИАРДОВ, ЧТОБЫ ГЕНЕРАЛЫ НЕ ЖАЛОВАЛИСЬ". ЗА ДЕСЯТЬ ЛЕТ ВОЕННЫЕ
Dialogue: 0,0:07:19.96,0:07:23.24,Caption,,0,0,0,,РАСХОДЫ ЕВРОПЫ ФАКТИЧЕСКИ УДВОИЛИСЬ. ВОТ ЭТО УЖЕ
Dialogue: 0,0:07:23.30,0:07:26.12,Caption,,0,0,0,,НАСТОЯЩИЙ РАЗВОРОТ ЭКОНОМИКИ. ПОТОМУ ЧТО ДЕНЬГИ
Dialogue: 0,0:07:26.12,0:07:29.32,Caption,,0,0,0,,ГОСУДАРСТВО НЕ ПЕЧАТАЕТ В ПОДВАЛЕ МЭРИИ. ЕСЛИ СОТНИ
Dialogue: 0,0:07:29.40,0:07:31.40,Caption,,0,0,0,,МИЛЛИАРДОВ УХОДЯТ НА ОДНУ СТАТЬЮ,
Dialogue: 0,0:07:31.70,0:07:34.44,Caption,,0,0,0,,ОНИ ЛИБО ПРИХОДЯТ ИЗ НАЛОГОВ, ЛИБО ИЗ ДОЛГОВ,
Dialogue: 0,0:07:34.64,0:07:38.87,Caption,,0,0,0,,ЛИБО НЕ ИДУТ КУДА ТО ЕЩЁ. ГЕРМАНИЯ,
Dialogue: 0,0:07:38.88,0:07:41.91,Caption,,0,0,0,,НАПРИМЕР, УЖЕ МЕНЯЛА СОБСТВЕННЫЕ ФИНАНСОВЫЕ ПРАВИЛА,
Dialogue: 0,0:07:42.15,0:07:45.19,Caption,,0,0,0,,ЧТОБЫ ВОЕННЫЕ РАСХОДЫ МЕНЬШЕ УПИРАЛИСЬ В ЗНАМЕНИТЫЙ
Dialogue: 0,0:07:45.19,0:07:48.07,Caption,,0,0,0,,ДОЛГОВОЙ ТОРМОЗ. ТО ЕСТЬ СНАЧАЛА ДЕСЯТИЛЕТИЯМИ
Dialogue: 0,0:07:48.07,0:07:52.15,Caption,,0,0,0,,ОБЪЯСНЯЛИ, ЧТО ДОЛГ ЭТО СТРАШНАЯ ВЕЩЬ. БЮДЖЕТ ДОЛЖЕН БЫТЬ
Dialogue: 0,0:07:52.15,0:07:56.47,Caption,,0,0,0,,ДИСЦИПЛИНИРОВАННЫМ, И КАЖДЫЙ ЕВРО НАДО СЧИТАТЬ. ПОТОМ ПРИШЛА НОВАЯ
Dialogue: 0,0:07:56.47,0:08:00.31,Caption,,0,0,0,,РЕАЛЬНОСТЬ. И ВЫЯСНИЛОСЬ, ЧТО ЕСЛИ ОЧЕНЬ НАДО КУПИТЬ ПУШКУ,
Dialogue: 0,0:08:00.47,0:08:03.35,Caption,,0,0,0,,КАЛЬКУЛЯТОР МОЖНО СЛЕГКА ОТОДВИНУТЬ. ПРИ ЭТОМ САМОЕ
Dialogue: 0,0:08:03.35,0:08:07.43,Caption,,0,0,0,,ИНТЕРЕСНОЕ, ЧТО ОГРОМНЫЕ СУММЫ ВОВСЕ НЕ ЗАКРЫВАЮТ РАЗГОВОР О
Dialogue: 0,0:08:07.43,0:08:10.39,Caption,,0,0,0,,НЕХВАТКЕ ДЕНЕГ. ЕВРОПЕ ОДНОВРЕМЕННО ОБЪЯСНЯЮТ
Dialogue: 0,0:08:10.39,0:08:15.03,Caption,,0,0,0,,ПОТРАТИЛИ РЕКОРДНО МНОГО, НО НУЖНО ЕЩЁ БОЛЬШЕ. ПОТОМУ ЧТО НАДО РАСШИРЯТЬ
Dialogue: 0,0:08:15.03,0:08:17.91,Caption,,0,0,0,,ПРОИЗВОДСТВО БОЕПРИПАСОВ, ОБНОВЛЯТЬ ПВО,
Dialogue: 0,0:08:18.07,0:08:21.43,Caption,,0,0,0,,ЗАКУПАТЬ САМОЛЁТЫ, ТЕХНИКУ, СТРОИТЬ СКЛАДЫ,
Dialogue: 0,0:08:21.58,0:08:26.23,Caption,,0,0,0,,УКРЕПЛЯТЬ ВОСТОЧНЫЙ ФЛАНГ, УВЕЛИЧИВАТЬ ЧИСЛЕННОСТЬ АРМИЙ. ТО ЕСТЬ СЧЁТ УЖЕ
Dialogue: 0,0:08:26.23,0:08:29.99,Caption,,0,0,0,,ВНУШИТЕЛЬНЫЙ, А БАНКЕТ ТОЛЬКО РАЗОГРЕВАЕТСЯ. И ОДНА ИЗ СТРАН,
Dialogue: 0,0:08:30.23,0:08:32.47,Caption,,0,0,0,,ГДЕ ЭТОТ ПРОЦЕСС ОСОБЕННО ХОРОШО ВИДЕН,
Dialogue: 0,0:08:32.62,0:08:35.59,Caption,,0,0,0,,ЭТО НОРВЕГИЯ. КИРКЕНЕС. ПРАКТИЧЕСКИ РОССИЙСКАЯ
Dialogue: 0,0:08:35.67,0:08:38.23,Caption,,0,0,0,,ГРАНИЦА. ДО МУРМАНСКОЙ ОБЛАСТИ РУКОЙ ПОДАТЬ.
Dialogue: 0,0:08:38.51,0:08:40.31,Caption,,0,0,0,,НОРВЕЖСКОЕ МИНОБОРОНЫ ОБЪЯВИЛО,
Dialogue: 0,0:08:40.68,0:08:44.55,Caption,,0,0,0,,ЧТО В РАЙОНЕ КИРКЕНЕСА РАЗМЕЩАЮТСЯ СЕНСОРЫ СИСТЕМЫ N
Dialogue: 0,0:08:44.58,0:08:47.51,Caption,,0,0,0,,A S A M S ДЛЯ НАБЛЮДЕНИЯ ЗА
Dialogue: 0,0:08:47.51,0:08:50.31,Caption,,0,0,0,,ВОЗДУШНЫМ ПРОСТРАНСТВОМ И ОБНАРУЖЕНИЯ БЕСПИЛОТНИКОВ.
Dialogue: 0,0:08:50.51,0:08:52.71,Caption,,0,0,0,,ПРИЧЁМ ОФИЦИАЛЬНАЯ ФОРМУЛИРОВКА ПРЕКРАСНА.
Dialogue: 0,0:08:54.97,0:08:57.54,Caption,,0,0,0,,ПОВЫШЕННОЙ ВОЗДУШНОЙ УГРОЗЫ ДЛЯ НОРВЕГИИ И НАСЕЛЕНИЯ
Dialogue: 0,0:08:57.54,0:09:00.74,Caption,,0,0,0,,ФИННМАРКА СЕЙЧАС НЕТ. КОНКРЕТНОЙ НОВОЙ УГРОЗЫ ТОЖЕ
Dialogue: 0,0:09:00.74,0:09:03.30,Caption,,0,0,0,,НЕТ. НО РАДАРЫ СТАВИМ. ТРИДЦАТЬ С ЛИШНИМ
Dialogue: 0,0:09:03.30,0:09:05.94,Caption,,0,0,0,,ВОЕННОСЛУЖАЩИХ ТУДА ТОЖЕ ОТПРАВЛЯЕМ. СИСТЕМУ
Dialogue: 0,0:09:05.94,0:09:08.90,Caption,,0,0,0,,НАБЛЮДЕНИЯ УСИЛИВАЕМ. ПОТОМУ ЧТО ЛУЧШЕ ЗАРАНЕЕ.
Dialogue: 0,0:09:09.18,0:09:12.10,Caption,,0,0,0,,СПОРИТЬ С ТАКОЙ ЛОГИКОЙ СЛОЖНО. ОГНЕТУШИТЕЛЬ ТОЖЕ
Dialogue: 0,0:09:12.18,0:09:14.66,Caption,,0,0,0,,ОБЫЧНО ПОКУПАЮТ ДО ПОЖАРА. НО ЕСЛИ НА ОДНОЙ
Dialogue: 0,0:09:14.66,0:09:17.38,Caption,,0,0,0,,СТОРОНЕ ГРАНИЦЫ ГОВОРЯТ НИКАКОЙ КОНКРЕТНОЙ НОВОЙ
Dialogue: 0,0:09:17.38,0:09:20.98,Caption,,0,0,0,,УГРОЗЫ НЕТ, А НА ДРУГОЙ НАЧИНАЮТ ДВИГАТЬ ВОЕННЫХ И СЕНСОРЫ,
Dialogue: 0,0:09:21.20,0:09:23.78,Caption,,0,0,0,,МОСКВА СМОТРИТ НЕ НА ФОРМУЛИРОВКУ ПРЕСС РЕЛИЗА.
Dialogue: 0,0:09:24.16,0:09:27.30,Caption,,0,0,0,,МОСКВА СМОТРИТ НА ОБОРУДОВАНИЕ. А ОБОРУДОВАНИЕ СТОИТ
Dialogue: 0,0:09:27.30,0:09:30.34,Caption,,0,0,0,,НА МЕСТЕ СОВЕРШЕННО КОНКРЕТНОМ. КИРКЕНЕС НАХОДИТСЯ
Dialogue: 0,0:09:30.34,0:09:33.38,Caption,,0,0,0,,НЕ ГДЕ НИБУДЬ ВОЗЛЕ ОСЛО. ЭТО КРАЙНИЙ СЕВЕР,
Dialogue: 0,0:09:33.54,0:09:37.70,Caption,,0,0,0,,РОССИЙСКАЯ ГРАНИЦА, РЯДОМ СТРАТЕГИЧЕСКИ ВАЖНЕЙШИЙ ДЛЯ РОССИИ РАЙОН
Dialogue: 0,0:09:37.70,0:09:40.34,Caption,,0,0,0,,СЕВЕРНОГО ФЛОТА. И ЭТО УЖЕ НЕ ЕДИНСТВЕННАЯ
Dialogue: 0,0:09:40.34,0:09:43.70,Caption,,0,0,0,,НОРВЕЖСКАЯ ИСТОРИЯ ПОСЛЕДНИХ ЛЕТ. НОРВЕГИЯ УСИЛИВАЕТ
Dialogue: 0,0:09:43.70,0:09:46.50,Caption,,0,0,0,,ФИННМАРК, УВЕЛИЧИВАЕТ ВОЕННОЕ ПРИСУТСТВИЕ,
Dialogue: 0,0:09:46.65,0:09:50.18,Caption,,0,0,0,,УЧАСТВУЕТ В КРУПНЫХ АРКТИЧЕСКИХ УЧЕНИЯХ НАТО. СЕВЕР
Dialogue: 0,0:09:50.18,0:09:52.98,Caption,,0,0,0,,ЕВРОПЫ ПОСТЕПЕННО ПРЕВРАЩАЕТСЯ ИЗ ДАЛЁКОЙ ХОЛОДНОЙ
Dialogue: 0,0:09:52.98,0:09:55.94,Caption,,0,0,0,,ОКРАИНЫ В ОДНО ИЗ САМЫХ ВНИМАТЕЛЬНО НАБЛЮДАЕМЫХ
Dialogue: 0,0:09:55.94,0:09:58.82,Caption,,0,0,0,,НАПРАВЛЕНИЙ. ПРИЧЁМ ЗДЕСЬ НАДО ОТДЕЛЬНО РАЗОБРАТЬСЯ
Dialogue: 0,0:09:58.90,0:10:04.42,Caption,,0,0,0,,С N A S A M S, ПОТОМУ ЧТО ФОРМУЛИРОВКА "НОРВЕГИЯ ПОСТАВИЛА РАДАРЫ N
Dialogue: 0,0:10:04.45,0:10:08.26,Caption,,0,0,0,,A S A M S" ЗВУЧИТ ПРОЩЕ, ЧЕМ САМА СИСТЕМА УСТРОЕНА.
Dialogue: 0,0:10:10.52,0:10:13.80,Caption,,0,0,0,,N A S A M S НЕ ОДИН БОЛЬШОЙ ЯЩИК,
Dialogue: 0,0:10:14.00,0:10:15.48,Caption,,0,0,0,,КОТОРЫЙ ПРИВЕЗЛИ НА ГРУЗОВИКЕ,
Dialogue: 0,0:10:15.72,0:10:19.40,Caption,,0,0,0,,ВОТКНУЛИ В ЗЕМЛЮ, НАЖАЛИ ЗЕЛЁНУЮ КНОПКУ И ПОЛУЧИЛИ ГОТОВУЮ
Dialogue: 0,0:10:19.40,0:10:22.52,Caption,,0,0,0,,ПРОТИВОВОЗДУШНУЮ ОБОРОНУ. ЭТО НАБОР СВЯЗАННЫХ
Dialogue: 0,0:10:22.52,0:10:26.04,Caption,,0,0,0,,ЭЛЕМЕНТОВ. ПУНКТЫ УПРАВЛЕНИЯ, ПУСКОВЫЕ УСТАНОВКИ,
Dialogue: 0,0:10:26.20,0:10:30.60,Caption,,0,0,0,,СРЕДСТВА СВЯЗИ, ВНЕШНИЕ ИСТОЧНИКИ ИНФОРМАЦИИ И СОБСТВЕННЫЕ РАДАРЫ.
Dialogue: 0,0:10:31.24,0:10:34.52,Caption,,0,0,0,,ОДИН ИЗ ШТАТНЫХ РАДАРОВ СИСТЕМЫ НАЗЫВАЕТСЯ AN КОСАЯ
Dialogue: 0,0:10:34.52,0:10:38.28,Caption,,0,0,0,,ЧЕРТА M P Q ШЕСТЬДЕСЯТ ЧЕТЫРЕ SENTINEL. ОН
Dialogue: 0,0:10:38.28,0:10:41.48,Caption,,0,0,0,,РАБОТАЕТ НА ОБНАРУЖЕНИЕ ЦЕЛЕЙ И ОБЕСПЕЧЕНИЕ РАБОТЫ
Dialogue: 0,0:10:41.48,0:10:44.12,Caption,,0,0,0,,КОМПЛЕКСА. У НЕГО СОВСЕМ НЕ ТЕ ВОЗМОЖНОСТИ,
Dialogue: 0,0:10:44.36,0:10:47.32,Caption,,0,0,0,,ЧТО У КРУПНЫХ ДАЛЬНОБОЙНЫХ РЛС ТЯЖЁЛЫХ СИСТЕМ ВРОДЕ
Dialogue: 0,0:10:47.32,0:10:50.44,Caption,,0,0,0,,РОССИЙСКИХ С ТРИСТА ИЛИ С ЧЕТЫРЕСТА. N A
Dialogue: 0,0:10:50.44,0:10:52.44,Caption,,0,0,0,,S A M S ВООБЩЕ СТРОИЛСЯ ПО ДРУГОЙ
Dialogue: 0,0:10:52.44,0:10:55.08,Caption,,0,0,0,,ЛОГИКЕ. ОН ДОЛЖЕН ПОЛУЧАТЬ КАРТИНУ НЕ ТОЛЬКО ОТ
Dialogue: 0,0:10:55.08,0:10:58.12,Caption,,0,0,0,,СВОЕГО РАДАРА. СИСТЕМА УМЕЕТ РАБОТАТЬ ВНУТРИ ОБЩЕЙ
Dialogue: 0,0:10:58.12,0:11:01.80,Caption,,0,0,0,,ИНФОРМАЦИОННОЙ СЕТИ НАТО, ПОЛУЧАТЬ ЦЕЛЕУКАЗАНИЕ ИЗВНЕ,
Dialogue: 0,0:11:01.88,0:11:04.12,Caption,,0,0,0,,В ТОМ ЧИСЛЕ ОТ ДРУГИХ РАДАРОВ И АВИАЦИИ
Dialogue: 0,0:11:04.12,0:11:06.12,Caption,,0,0,0,,ДАЛЬНЕГО РАДИОЛОКАЦИОННОГО ОБНАРУЖЕНИЯ.
Dialogue: 0,0:11:06.68,0:11:09.56,Caption,,0,0,0,,ПОЭТОМУ КОГДА К ГРАНИЦЕ ВЫДВИГАЮТ ИМЕННО СЕНСОРЫ N
Dialogue: 0,0:11:09.62,0:11:12.92,Caption,,0,0,0,,A S A M S, ВОПРОС НЕ СВОДИТСЯ К ТОМУ,
Dialogue: 0,0:11:13.00,0:11:16.36,Caption,,0,0,0,,СКОЛЬКО КИЛОМЕТРОВ ВИДИТ КОНКРЕТНАЯ ТАРЕЛКА. ВАЖНЕЕ,
Dialogue: 0,0:11:16.60,0:11:19.48,Caption,,0,0,0,,ЧАСТЬЮ КАКОЙ СЕТИ ОНА СТАНОВИТСЯ. НОРВЕЖЦЫ
Dialogue: 0,0:11:19.48,0:11:22.28,Caption,,0,0,0,,ОФИЦИАЛЬНО ГОВОРЯТ ОБ ОБНАРУЖЕНИИ БЕСПИЛОТНИКОВ И
Dialogue: 0,0:11:22.28,0:11:24.84,Caption,,0,0,0,,КОНТРОЛЕ ПРИГРАНИЧНОГО ВОЗДУШНОГО ПРОСТРАНСТВА.
Dialogue: 0,0:11:27.11,0:11:29.75,Caption,,0,0,0,,ВОЕННЫЕ ОБОЗРЕВАТЕЛИ СМОТРЯТ ДАЛЬШЕ И ЗАДАЮТ УЖЕ
Dialogue: 0,0:11:29.75,0:11:32.47,Caption,,0,0,0,,ДРУГОЙ ВОПРОС ЕСЛИ СЮДА ВЫДВИНУЛИ СЕНСОРЫ И
Dialogue: 0,0:11:32.47,0:11:36.23,Caption,,0,0,0,,УПРАВЛЕНИЕ, НАСКОЛЬКО БЫСТРО ПРИ НЕОБХОДИМОСТИ РЯДОМ ОКАЖУТСЯ
Dialogue: 0,0:11:36.23,0:11:39.43,Caption,,0,0,0,,ОСТАЛЬНЫЕ ЭЛЕМЕНТЫ ПВО? ПУСКОВУЮ УСТАНОВКУ,
Dialogue: 0,0:11:39.67,0:11:43.67,Caption,,0,0,0,,В ОТЛИЧИЕ ОТ АЭРОДРОМА, ГОДАМИ СТРОИТЬ НЕ НАДО. ПОДОГНАЛ МАШИНУ,
Dialogue: 0,0:11:43.81,0:11:46.63,Caption,,0,0,0,,ВКЛЮЧИЛ В СЕТЬ. И ХАРАКТЕР ПОЗИЦИИ УЖЕ СОВСЕМ
Dialogue: 0,0:11:46.71,0:11:49.35,Caption,,0,0,0,,ДРУГОЙ. НО ЗДЕСЬ НЕ НАДО УБЕГАТЬ ВПЕРЕДИ САМИХ
Dialogue: 0,0:11:49.35,0:11:52.71,Caption,,0,0,0,,НОРВЕЖЦЕВ. ПОКА ОФИЦИАЛЬНО ОБЪЯВЛЕНО ИМЕННО УСИЛЕНИЕ
Dialogue: 0,0:11:52.71,0:11:55.43,Caption,,0,0,0,,НАБЛЮДЕНИЯ И РАЗМЕЩЕНИЕ СЕНСОРОВ. ЭТОГО ВПОЛНЕ
Dialogue: 0,0:11:55.43,0:11:59.59,Caption,,0,0,0,,ДОСТАТОЧНО, ЧТОБЫ УВИДЕТЬ ОБЩИЙ ПРОЦЕСС. ЕВРОПА УВЕЛИЧИВАЕТ
Dialogue: 0,0:11:59.59,0:12:02.71,Caption,,0,0,0,,РАСХОДЫ. СЕВЕРНЫЙ ФЛАНГ УСИЛИВАЕТСЯ. СРЕДСТВА
Dialogue: 0,0:12:02.71,0:12:05.99,Caption,,0,0,0,,НАБЛЮДЕНИЯ ПОДХОДЯТ БЛИЖЕ К ГРАНИЦАМ. РОССИЯ ВЫВОДИТ
Dialogue: 0,0:12:06.07,0:12:09.35,Caption,,0,0,0,,НА ОРБИТУ СОБСТВЕННУЮ СЕТЬ СВЯЗИ. АРМЕНИЯ ФАКТИЧЕСКИ
Dialogue: 0,0:12:09.35,0:12:12.31,Caption,,0,0,0,,ОТХОДИТ ОТ СТАРОЙ СИСТЕМЫ БЕЗОПАСНОСТИ. А НА СТОЛ
Dialogue: 0,0:12:12.39,0:12:17.35,Caption,,0,0,0,,СНОВА ЛОЖАТСЯ КАРТЫ ВРЕМЁН, КОГДА ЕВРОПА УЖЕ ОДНАЖДЫ ДЕЛИЛАСЬ НА ДВА ВООРУЖЁННЫХ
Dialogue: 0,0:12:17.43,0:12:21.43,Caption,,0,0,0,,ЛАГЕРЯ. КАЖДАЯ ИСТОРИЯ САМА ПО СЕБЕ ОБЪЯСНИМА. НА КАЖДУЮ
Dialogue: 0,0:12:21.51,0:12:24.07,Caption,,0,0,0,,МОЖНО НАПИСАТЬ ОТДЕЛЬНЫЙ ПРЕСС РЕЛИЗ И ПОСТАВИТЬ
Dialogue: 0,0:12:24.08,0:12:27.51,Caption,,0,0,0,,ТОЧКУ. ДРОН С ЛИСТОВКАМИ. ИНФОРМАЦИОННАЯ ОПЕРАЦИЯ.
Dialogue: 0,0:12:27.74,0:12:31.67,Caption,,0,0,0,,СПУТНИКИ. РАЗВИТИЕ СВЯЗИ. ПАШИНЯН. АРМЯНСКАЯ ВНЕШНЯЯ
Dialogue: 0,0:12:31.67,0:12:34.79,Caption,,0,0,0,,ПОЛИТИКА. СТАРАЯ КАРТА. ИСТОРИЧЕСКИЙ ИНТЕРЕС.
Dialogue: 0,0:12:34.95,0:12:38.47,Caption,,0,0,0,,ЕВРОПЕЙСКИЕ РАСХОДЫ. РЕАКЦИЯ НА УГРОЗЫ. НОРВЕЖСКИЕ
Dialogue: 0,0:12:38.47,0:12:41.83,Caption,,0,0,0,,СЕНСОРЫ. ПРОФИЛАКТИКА. ВСЁ АККУРАТНО РАЗЛОЖЕНО ПО
Dialogue: 0,0:12:41.91,0:12:47.15,Caption,,0,0,0,,РАЗНЫМ ПАПКАМ. ВОТ ТОЛЬКО МИР ОБЫЧНО МЕНЯЕТСЯ НЕ ПО ПАПКАМ.
Dialogue: 0,0:12:47.54,0:12:51.39,Caption,,0,0,0,,ОН МЕНЯЕТСЯ ТОГДА, КОГДА В РАЗНЫХ МЕСТАХ ОДНОВРЕМЕННО НАЧИНАЮТ
Dialogue: 0,0:12:51.39,0:12:54.67,Caption,,0,0,0,,ПРИНИМАТЬ РЕШЕНИЯ, КОТОРЫЕ ЕЩЁ НЕСКОЛЬКО ЛЕТ НАЗАД КАЗАЛИСЬ
Dialogue: 0,0:12:54.67,0:12:58.11,Caption,,0,0,0,,ЧРЕЗМЕРНЫМИ, СЛИШКОМ ДОРОГИМИ ИЛИ ПРОСТО НЕНУЖНЫМИ.
Dialogue: 0,0:12:58.88,0:13:00.67,Caption,,0,0,0,,САМОЕ ИНТЕРЕСНОЕ СЕЙЧАС НЕ В ТОМ,
Dialogue: 0,0:13:00.87,0:13:03.31,Caption,,0,0,0,,ОЗНАЧАЕТ ЛИ КАЖДЫЙ ОТДЕЛЬНЫЙ ЭПИЗОД ЧТО ТО
Dialogue: 0,0:13:03.31,0:13:05.63,Caption,,0,0,0,,ГРАНДИОЗНОЕ. САМОЕ ИНТЕРЕСНОЕ,
Dialogue: 0,0:13:05.88,0:13:08.83,Caption,,0,0,0,,СКОЛЬКО ТАКИХ ЭПИЗОДОВ МЫ УЖЕ ПЕРЕСТАЛИ СЧИТАТЬ
Dialogue: 0,0:13:08.83,0:13:12.03,Caption,,0,0,0,,НЕОБЫЧНЫМИ. ПОТОМУ ЧТО ИМЕННО ТАК НОВАЯ РЕАЛЬНОСТЬ
Dialogue: 0,0:13:12.03,0:13:15.39,Caption,,0,0,0,,ОБЫЧНО И СТАНОВИТСЯ ОБЫЧНОЙ. СНАЧАЛА ОДНА СТРАННАЯ
Dialogue: 0,0:13:15.47,0:13:18.75,Caption,,0,0,0,,НОВОСТЬ. ПОТОМ ВТОРАЯ. А ПОТОМ ОДНАЖДЫ ОТКРЫВАЕШЬ
Dialogue: 0,0:13:18.83,0:13:22.83,Caption,,0,0,0,,СТАРУЮ КАРТУ И ОБНАРУЖИВАЕШЬ, ЧТО СМОТРЕТЬ НА НЕЁ ПОЧЕМУ ТО СНОВА СТАЛО
Dialogue: 0,0:13:22.83,0:13:23.47,Caption,,0,0,0,,ИНТЕРЕСНО.
