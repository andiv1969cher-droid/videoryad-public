Dialogue: 0,0:00:00.12,0:00:03.05,Caption,,0,0,0,,НУ ЧТО, В ЕВРОПЕ НАКОНЕЦ ТО ИСПУГАЛИСЬ. САМИ
Dialogue: 0,0:00:03.05,0:00:06.04,Caption,,0,0,0,,ПОСТРОИЛИ ДОМ ВОЗЛЕ ВУЛКАНА, А ТЕПЕРЬ УДИВЛЯЮТСЯ,
Dialogue: 0,0:00:06.28,0:00:08.64,Caption,,0,0,0,,ЧТО ЛАВА УЖЕ В ПРИХОЖЕЙ. ПРИЧЁМ ВУЛКАН
Dialogue: 0,0:00:08.64,0:00:11.36,Caption,,0,0,0,,СТОЛЬКО ВРЕМЕНИ НИКОГО ОСОБО НЕ БЕСПОКОИЛ.
Dialogue: 0,0:00:11.36,0:00:13.40,Caption,,0,0,0,,ДАЖЕ НАОБОРОТ. А ТЕПЕРЬ ПОСЛУШАЙТЕ,
Dialogue: 0,0:00:13.48,0:00:15.53,Caption,,0,0,0,,ЧТО ЗАГОВОРИЛИ НЕКОТОРЫЕ ЕВРОПЕЙСКИЕ
Dialogue: 0,0:00:15.53,0:00:18.44,Caption,,0,0,0,,ПОЛИТИКИ. РЕБЯТА, А ВЫ ВООБЩЕ НА ЧТО РАССЧИТЫВАЛИ?
Dialogue: 0,0:00:18.73,0:00:20.44,Caption,,0,0,0,,ЕСЛИ ВАМ ИНТЕРЕСЕН ТАКОЙ РАЗБОР,
Dialogue: 0,0:00:20.52,0:00:22.36,Caption,,0,0,0,,ГДЕ МЫ СМОТРИМ НЕ ТОЛЬКО НА ЗАЯВЛЕНИЯ,
Dialogue: 0,0:00:22.49,0:00:25.32,Caption,,0,0,0,,НО И НА ТО, ЧТО ЗА НИМИ НАЧИНАЕТ ВЫЛЕЗАТЬ НАРУЖУ,
Dialogue: 0,0:00:25.40,0:00:27.80,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:28.04,0:00:29.87,Caption,,0,0,0,,КОГДА ОТДЕЛЬНЫЕ НОВОСТИ ПО ОДНОЙ
Dialogue: 0,0:00:29.87,0:00:33.03,Caption,,0,0,0,,ВЫГЛЯДЯТ СТРАННО, А ВМЕСТЕ УЖЕ СКЛАДЫВАЮТСЯ В ОЧЕНЬ
Dialogue: 0,0:00:33.03,0:00:36.46,Caption,,0,0,0,,ЗАНЯТНУЮ КАРТИНУ. НАЧНЁМ С КАЛИНИНГРАДА. РОССИЙСКИЕ
Dialogue: 0,0:00:36.46,0:00:39.80,Caption,,0,0,0,,ВЛАСТИ ВЫДЕЛЯЮТ ПОЧТИ СОРОК СЕМЬ МИЛЛИАРДОВ РУБЛЕЙ НА
Dialogue: 0,0:00:39.80,0:00:42.44,Caption,,0,0,0,,ДВА НОВЫХ ЖЕЛЕЗНОДОРОЖНЫХ ПАРОМА. ДЕНЬГИ,
Dialogue: 0,0:00:42.60,0:00:45.16,Caption,,0,0,0,,В ТОМ ЧИСЛЕ, ПОЙДУТ ИЗ ФОНДА НАЦИОНАЛЬНОГО
Dialogue: 0,0:00:45.16,0:00:48.61,Caption,,0,0,0,,БЛАГОСОСТОЯНИЯ. ПАРОМЫ ДОЛЖНЫ ХОДИТЬ МЕЖДУ УСТЬ ЛУГОЙ И
Dialogue: 0,0:00:48.61,0:00:51.55,Caption,,0,0,0,,БАЛТИЙСКОМ И ОБЕСПЕЧИВАТЬ СНАБЖЕНИЕ РЕГИОНА В ОБХОД
Dialogue: 0,0:00:51.55,0:00:54.63,Caption,,0,0,0,,СУХОПУТНЫХ МАРШРУТОВ. САМ ПО СЕБЕ ШАГ ПОНЯТНЫЙ.
Dialogue: 0,0:00:54.63,0:00:57.32,Caption,,0,0,0,,ЕСЛИ ВОКРУГ ВСЁ ЧАЩЕ ГОВОРЯТ ОБ ОГРАНИЧЕНИЯХ,
Dialogue: 0,0:00:57.40,0:01:02.06,Caption,,0,0,0,,ГРАНИЦАХ, ТРАНЗИТЕ И БАЛТИКЕ, МОРСКОЙ ПУТЬ НАДО УСИЛИВАТЬ. ТЕМ БОЛЕЕ
Dialogue: 0,0:01:02.06,0:01:04.84,Caption,,0,0,0,,ЧТО ДОЛЯ ГРУЗОВ, КОТОРЫЕ ИДУТ В КАЛИНИНГРАД МОРЕМ,
Dialogue: 0,0:01:05.07,0:01:06.93,Caption,,0,0,0,,УЖЕ ВЫРОСЛА С ВОСЬМИ ПРОЦЕНТОВ В ДВЕ
Dialogue: 0,0:01:06.93,0:01:08.94,Caption,,0,0,0,,ТЫСЯЧИ ДВАДЦАТЬ ПЕРВОМ ГОДУ ДО БОЛЕЕ ЧЕМ
Dialogue: 0,0:01:08.94,0:01:11.32,Caption,,0,0,0,,ПОЛОВИНЫ. НО ЕСТЬ ОДНА ФОРМУЛИРОВОЧКА.
Dialogue: 0,0:01:13.60,0:01:16.56,Caption,,0,0,0,,РОССИЯ ГОТОВИТСЯ К БЛОКАДЕ КАЛИНИНГРАДА. ПРИЧЁМ В
Dialogue: 0,0:01:16.56,0:01:18.69,Caption,,0,0,0,,САМОМ РЕГИОНЕ УЖЕ ОБЪЯВЛЯЛИ ВОЗДУШНУЮ
Dialogue: 0,0:01:18.69,0:01:21.50,Caption,,0,0,0,,ТРЕВОГУ ИЗ ЗА ПОДОЗРИТЕЛЬНОГО ОБЪЕКТА СО СТОРОНЫ
Dialogue: 0,0:01:21.50,0:01:24.64,Caption,,0,0,0,,ЛИТВЫ. А РАНЬШЕ ПУТИН И ПАТРУШЕВ ПРЕДУПРЕЖДАЛИ ПОПЫТКА
Dialogue: 0,0:01:24.64,0:01:26.91,Caption,,0,0,0,,ВОЕННОЙ ИЛИ ТРАНСПОРТНОЙ БЛОКАДЫ ПОЛУЧИТ
Dialogue: 0,0:01:26.91,0:01:30.23,Caption,,0,0,0,,НЕМЕДЛЕННЫЙ ОТВЕТ ВСЕМИ ИМЕЮЩИМИСЯ СРЕДСТВАМИ. НЕ К
Dialogue: 0,0:01:30.23,0:01:32.48,Caption,,0,0,0,,НЕДОПУЩЕНИЮ БЛОКАДЫ. НЕ К ТОМУ,
Dialogue: 0,0:01:32.64,0:01:34.56,Caption,,0,0,0,,ЧТОБЫ СДЕЛАТЬ САМУ ИДЕЮ БЛОКАДЫ
Dialogue: 0,0:01:34.56,0:01:38.70,Caption,,0,0,0,,БЕССМЫСЛЕННОЙ. А К СИТУАЦИИ, КОГДА РЕГИОН УЖЕ ОКАЖЕТСЯ ФАКТИЧЕСКИ
Dialogue: 0,0:01:38.70,0:01:41.44,Caption,,0,0,0,,ОТРЕЗАН И ЕГО НАДО БУДЕТ СНАБЖАТЬ МОРЕМ. НУ
Dialogue: 0,0:01:41.44,0:01:45.30,Caption,,0,0,0,,ПРЕКРАСНО. МОЖНО, КОНЕЧНО, И ТАК ГОТОВИТЬСЯ. ПРИЧЁМ СРОК
Dialogue: 0,0:01:45.30,0:01:48.00,Caption,,0,0,0,,ГОТОВНОСТИ НОВЫХ ПАРОМОВ НАЗЫВАЕТСЯ ВСЁ ТОТ ЖЕ,
Dialogue: 0,0:01:48.24,0:01:50.80,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ТРИДЦАТЫЙ ГОД. ВОТ ЭТОТ ГОД
Dialogue: 0,0:01:50.80,0:01:53.76,Caption,,0,0,0,,ВООБЩЕ КАКОЙ ТО МАГИЧЕСКИЙ. КУДА НИ ПОСМОТРИ,
Dialogue: 0,0:01:53.92,0:01:56.30,Caption,,0,0,0,,ТАМ ОН. ЗДЕСЬ ПЕРЕВООРУЖЕНИЕ. ТАМ
Dialogue: 0,0:01:56.30,0:01:59.80,Caption,,0,0,0,,ПОДГОТОВКА АРМИЙ. ТАМ НОВЫЕ ПЛАНЫ ОБОРОНЫ. ТАМ НОВЫЕ
Dialogue: 0,0:01:59.80,0:02:02.72,Caption,,0,0,0,,ИНФРАСТРУКТУРНЫЕ ПРОЕКТЫ. ТАКОЕ ВПЕЧАТЛЕНИЕ,
Dialogue: 0,0:02:02.98,0:02:04.74,Caption,,0,0,0,,БУДТО ДВЕ ТЫСЯЧИ ТРИДЦАТЫЙ УЖЕ
Dialogue: 0,0:02:04.74,0:02:08.11,Caption,,0,0,0,,НАЗНАЧИЛИ СРОКОМ НАЧАЛА ПОЛНОМАСШТАБНОЙ ВОЙНЫ В ЕВРОПЕ.
Dialogue: 0,0:02:08.11,0:02:09.90,Caption,,0,0,0,,ПРИЧЁМ МАСШТАБЫ МОГУТ ОКАЗАТЬСЯ
Dialogue: 0,0:02:09.90,0:02:13.47,Caption,,0,0,0,,НЕСОПОСТАВИМЫМИ С ТЕМ, ЧТО ПРОИСХОДИТ НА УКРАИНЕ. И ТЕПЕРЬ
Dialogue: 0,0:02:13.47,0:02:15.80,Caption,,0,0,0,,РОССИЯ САМА ЗАКЛАДЫВАЕТ ЭТОТ ГОД В ОДИН ИЗ
Dialogue: 0,0:02:15.80,0:02:18.91,Caption,,0,0,0,,КЛЮЧЕВЫХ ПРОЕКТОВ ПО КАЛИНИНГРАДУ. А ВОКРУГ РЕГИОНА ТЕМ
Dialogue: 0,0:02:18.91,0:02:21.90,Caption,,0,0,0,,ВРЕМЕНЕМ ТОЖЕ НИКТО НЕ СКУЧАЕТ. ЛАТВИЯ ОБСУЖДАЕТ
Dialogue: 0,0:02:21.90,0:02:24.56,Caption,,0,0,0,,ПОЛНОЕ ЗАКРЫТИЕ ПЕРЕХОДОВ НА ГРАНИЦЕ С РОССИЕЙ.
Dialogue: 0,0:02:26.85,0:02:28.61,Caption,,0,0,0,,ФИНЛЯНДИЯ СВОЮ ГРАНИЦУ ДЛЯ ЛЮДЕЙ
Dialogue: 0,0:02:28.61,0:02:31.39,Caption,,0,0,0,,ЗАКРЫЛА ЕЩЁ В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ТРЕТЬЕМ ГОДУ.
Dialogue: 0,0:02:31.39,0:02:34.86,Caption,,0,0,0,,ЭСТОНИЯ ОБЪЯВИЛА, ЧТО ЗАКРЫВАЕТ АВТОМОБИЛЬНЫЕ ПУНКТЫ
Dialogue: 0,0:02:34.86,0:02:37.42,Caption,,0,0,0,,ПРОПУСКА. ЛИТВА УЖЕ ОГРАНИЧИВАЛА КАЛИНИНГРАДСКИЙ
Dialogue: 0,0:02:37.42,0:02:40.72,Caption,,0,0,0,,ТРАНЗИТ И ПРОВОДИЛА УЧЕНИЯ НА ГРАНИЦЕ. ПРИ ЭТОМ ЛАТВИЯ С
Dialogue: 0,0:02:40.72,0:02:42.53,Caption,,0,0,0,,КАЛИНИНГРАДОМ ВООБЩЕ НЕ ГРАНИЧИТ,
Dialogue: 0,0:02:42.77,0:02:44.79,Caption,,0,0,0,,НО АКТИВНО ПОДТАЛКИВАЕТ СОСЕДЕЙ К
Dialogue: 0,0:02:44.79,0:02:47.81,Caption,,0,0,0,,ОБЩЕЙ ЛИНИИ. ОЧЕНЬ УДОБНО. САМ РЯДОМ НЕ СТОИШЬ,
Dialogue: 0,0:02:47.89,0:02:50.08,Caption,,0,0,0,,НО СОВЕТЫ РАЗДАЁШЬ. И ТУТ ЕЩЁ ОДНА
Dialogue: 0,0:02:50.08,0:02:52.86,Caption,,0,0,0,,ДЕТАЛЬ. В ЛАТВИИ В ОБЯЗАТЕЛЬНОЙ ЖЕРЕБЬЁВКЕ ДЛЯ
Dialogue: 0,0:02:52.86,0:02:55.21,Caption,,0,0,0,,ПРИЗЫВА ВПЕРВЫЕ ДОЛЖНЫ УЧАСТВОВАТЬ МОЛОДЫЕ
Dialogue: 0,0:02:55.21,0:02:58.73,Caption,,0,0,0,,ГРАЖДАНЕ СТРАНЫ, КОТОРЫЕ ПОСТОЯННО ЖИВУТ ЗА ГРАНИЦЕЙ.
Dialogue: 0,0:02:58.73,0:03:01.26,Caption,,0,0,0,,ДАЖЕ ТЕ, КТО РОДИЛСЯ И ВЫРОС ВООБЩЕ В ДРУГОМ
Dialogue: 0,0:03:01.26,0:03:04.21,Caption,,0,0,0,,ГОСУДАРСТВЕ. ДАЖЕ ТЕ, КТО, КАК ПИШУТ,
Dialogue: 0,0:03:04.45,0:03:06.34,Caption,,0,0,0,,МОЖЕТ ТОЛКОМ НЕ ЗНАТЬ ЛАТЫШСКОГО
Dialogue: 0,0:03:06.34,0:03:08.99,Caption,,0,0,0,,ЯЗЫКА. ТО ЕСТЬ ЧЕЛОВЕК МОЖЕТ ВСЮ ЖИЗНЬ ПРОЖИТЬ ГДЕ
Dialogue: 0,0:03:08.99,0:03:12.38,Caption,,0,0,0,,НИБУДЬ В ДРУГОЙ СТРАНЕ, А ЕМУ ОТТУДА ПРИВЕТ РОДИНА ПРО ТЕБЯ
Dialogue: 0,0:03:12.38,0:03:15.22,Caption,,0,0,0,,ВСПОМНИЛА. ВОТ ВАМ ЕЩЁ ОДИН МАЛЕНЬКИЙ КУСОЧЕК ТОЙ
Dialogue: 0,0:03:15.22,0:03:19.27,Caption,,0,0,0,,САМОЙ ПОДГОТОВКИ К БУДУЩЕМУ, О КОТОРОЙ В ЕВРОПЕ ГОВОРЯТ ВСЁ ЧАЩЕ.
Dialogue: 0,0:03:19.27,0:03:21.56,Caption,,0,0,0,,ТОЛЬКО ПОКА ОНИ ГОТОВЯТСЯ К ЧЕМУ ТО БОЛЬШОМУ
Dialogue: 0,0:03:21.56,0:03:24.84,Caption,,0,0,0,,ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ, ПРОИСХОДЯЩЕЕ УЖЕ ПРИШЛО К НИМ ПОД
Dialogue: 0,0:03:24.84,0:03:27.90,Caption,,0,0,0,,ОКНА. РОССИЙСКОЕ СУДНО В ФИНСКОМ ЗАЛИВЕ АТАКОВАНО.
Dialogue: 0,0:03:27.90,0:03:31.92,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПОТОМ ПОДТВЕРДИЛ, ЧТО ЗА АТАКОЙ СТОЯЛА УКРАИНА. И
Dialogue: 0,0:03:31.92,0:03:34.93,Caption,,0,0,0,,ОБЪЯСНИЛ СВОЮ ЛОГИКУ ДОВОЛЬНО ШИРОКО РОССИЙСКИЙ
Dialogue: 0,0:03:34.93,0:03:37.49,Caption,,0,0,0,,ФЛАГ, ОРУЖИЕ, САНКЦИОННЫЕ ГРУЗЫ,
Dialogue: 0,0:03:37.66,0:03:42.98,Caption,,0,0,0,,НЕЙТРАЛЬНЫЕ ВОДЫ. ВОТ ТУТ УЖЕ СОЮЗНИКИ И НАПРЯГЛИСЬ.
Dialogue: 0,0:03:42.98,0:03:45.04,Caption,,0,0,0,,ФИНСКИЙ ПРЕМЬЕР ПЕТТЕРИ ОРПО ГОВОРИТ,
Dialogue: 0,0:03:45.28,0:03:47.62,Caption,,0,0,0,,ЧТО УКРАИНА ИМЕЕТ ПРАВО ДАВАТЬ ОТПОР.
Dialogue: 0,0:03:47.62,0:03:50.10,Caption,,0,0,0,,НО НЕМЕЦКИЙ МИНИСТР ОБОРОНЫ БОРИС ПИСТОРИУС
Dialogue: 0,0:03:50.10,0:03:53.20,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ ВОЙНА НЕ ДОЛЖНА РАСПРОСТРАНИТЬСЯ НА БАЛТИКУ,
Dialogue: 0,0:03:53.52,0:03:56.24,Caption,,0,0,0,,И УКРАИНА НЕСЁТ ЗА ЭТО ОСОБУЮ ОТВЕТСТВЕННОСТЬ. А
Dialogue: 0,0:03:56.24,0:03:58.29,Caption,,0,0,0,,МИНИСТР ОБОРОНЫ НОРВЕГИИ ТОРЕ САНДВИК
Dialogue: 0,0:03:58.29,0:04:01.27,Caption,,0,0,0,,НАПОМИНАЕТ О НЕОБХОДИМОСТИ СОХРАНЯТЬ СТАБИЛЬНОСТЬ В
Dialogue: 0,0:04:01.27,0:04:04.03,Caption,,0,0,0,,РЕГИОНЕ. ВОТ ВАМ И ЕДИНСТВО РЕАКЦИИ. ПОДДЕРЖИВАТЬ
Dialogue: 0,0:04:04.03,0:04:06.56,Caption,,0,0,0,,УКРАИНУ ГОТОВЫ, А ВОТ ПОЛУЧИТЬ ПОСЛЕДСТВИЯ У
Dialogue: 0,0:04:06.56,0:04:09.77,Caption,,0,0,0,,СОБСТВЕННЫХ БЕРЕГОВ УЖЕ НЕ ОЧЕНЬ ХОЧЕТСЯ. ПОТОМУ ЧТО ОДНО
Dialogue: 0,0:04:09.77,0:04:12.56,Caption,,0,0,0,,ДЕЛО, КОГДА БОЕВЫЕ ДЕЙСТВИЯ ИДУТ ДАЛЕКО.
Dialogue: 0,0:04:12.56,0:04:15.20,Caption,,0,0,0,,ДРУГОЕ, КОГДА РЯДОМ С ТВОИМИ БЕРЕГАМИ НАЧИНАЮТ
Dialogue: 0,0:04:15.20,0:04:17.96,Caption,,0,0,0,,ГОРЕТЬ ТОРГОВЫЕ СУДА. ПРЕМЬЕР ЭСТОНИИ КРИСТЕН
Dialogue: 0,0:04:17.96,0:04:21.38,Caption,,0,0,0,,МИХАЛ СНАЧАЛА СКАЗАЛ, ЧТО К ТАКИМ АТАКАМ НАДО ПРИВЫКАТЬ И
Dialogue: 0,0:04:21.38,0:04:25.27,Caption,,0,0,0,,БЫТЬ ГОТОВЫМИ. БОЛЕЕ ТОГО, ЭСТОНСКИЕ СЛУЖБЫ УЖЕ ОТРАБАТЫВАЛИ
Dialogue: 0,0:04:25.27,0:04:28.20,Caption,,0,0,0,,ПОДОБНЫЕ СЦЕНАРИИ, А ГОСУДАРСТВЕННЫЙ ФЛОТ ГОТОВИЛСЯ К
Dialogue: 0,0:04:28.20,0:04:30.47,Caption,,0,0,0,,ВОЗМОЖНЫМ ПРОИСШЕСТВИЯМ. ТО ЕСТЬ ПОДГОТОВИЛИСЬ
Dialogue: 0,0:04:30.47,0:04:32.88,Caption,,0,0,0,,ЗАРАНЕЕ. А ПОТОМ ЭСТОНИЯ ЗАЯВИЛА,
Dialogue: 0,0:04:33.11,0:04:34.86,Caption,,0,0,0,,ЧТО НЕ ПОЗВОЛИТ ИСПОЛЬЗОВАТЬ СВОЮ
Dialogue: 0,0:04:34.86,0:04:36.92,Caption,,0,0,0,,ТЕРРИТОРИЮ, ВОЗДУШНОЕ ПРОСТРАНСТВО И
Dialogue: 0,0:04:36.92,0:04:40.12,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНЫЕ ВОДЫ ДЛЯ УДАРОВ ПО РОССИИ. ВОТ ТУТ УЖЕ
Dialogue: 0,0:04:40.12,0:04:43.28,Caption,,0,0,0,,ИНТЕРЕСНЕЕ. С ОДНОЙ СТОРОНЫ, ПРИВЫКАЙТЕ. С ДРУГОЙ,
Dialogue: 0,0:04:43.44,0:04:45.39,Caption,,0,0,0,,ТОЛЬКО НЕ ЧЕРЕЗ НАС. ПОТОМУ ЧТО КОГДА
Dialogue: 0,0:04:45.39,0:04:49.12,Caption,,0,0,0,,В МОРЕ ГОРИТ ЧУЖОЙ КОРАБЛЬ, МОЖНО РАССУЖДАТЬ О БОЛЬШОЙ СТРАТЕГИИ.
Dialogue: 0,0:04:51.38,0:04:53.62,Caption,,0,0,0,,А КОГДА ВЕТЕР ПОНЁС ДЫМ В ТВОЮ СТОРОНУ
Dialogue: 0,0:04:53.70,0:04:55.79,Caption,,0,0,0,,И ЕЩЁ ПОЯВЛЯЕТСЯ РИСК ЗАГРЯЗНЕНИЯ
Dialogue: 0,0:04:55.79,0:04:58.74,Caption,,0,0,0,,МОРЯ, СТРАТЕГИЯ ВНЕЗАПНО СТАНОВИТСЯ ОЧЕНЬ
Dialogue: 0,0:04:58.74,0:05:01.87,Caption,,0,0,0,,БЫТОВОЙ. ФИННЫ ПОМОГАЮТ ТУШИТЬ. ЭСТОНСКИЙ КОРАБЛЬ
Dialogue: 0,0:05:01.87,0:05:04.10,Caption,,0,0,0,,ИДЁТ НА ПОМОЩЬ. ВСЕ УЖЕ СЧИТАЮТ,
Dialogue: 0,0:05:04.18,0:05:06.35,Caption,,0,0,0,,ГДЕ НЕЙТРАЛЬНЫЕ ВОДЫ, ГДЕ ГРАНИЦА,
Dialogue: 0,0:05:06.50,0:05:08.63,Caption,,0,0,0,,СКОЛЬКО МОРСКИХ МИЛЬ ДО БЕРЕГА. И
Dialogue: 0,0:05:08.63,0:05:12.59,Caption,,0,0,0,,ВНЕЗАПНО ВЫЯСНЯЕТСЯ, ЧТО БАЛТИЙСКОЕ МОРЕ ЭТО НЕ ТЕЛЕВИЗОР.
Dialogue: 0,0:05:12.59,0:05:15.86,Caption,,0,0,0,,ТАМ СВОИ ПОРТЫ, СВОИ СУДА, СВОИ ЭКОЛОГИ,
Dialogue: 0,0:05:16.03,0:05:18.50,Caption,,0,0,0,,СВОИ СТРАХОВЫЕ КОМПАНИИ И СВОИ ГОРОДА.
Dialogue: 0,0:05:19.06,0:05:21.70,Caption,,0,0,0,,МОСКВА НА ЭТОМ ФОНЕ ВЫЗЫВАЕТ ЭСТОНСКОГО ПОСЛА И
Dialogue: 0,0:05:21.70,0:05:23.93,Caption,,0,0,0,,ГОВОРИТ, ЧТО ОТНОШЕНИЯ ПОДОШЛИ К ГРАНИ
Dialogue: 0,0:05:23.93,0:05:26.45,Caption,,0,0,0,,ОТКРЫТОГО СТОЛКНОВЕНИЯ. ОБВИНЯЕТ ТАЛЛИН В
Dialogue: 0,0:05:26.45,0:05:29.80,Caption,,0,0,0,,СОДЕЙСТВИИ ПРОЛЁТУ УКРАИНСКИХ БЕСПИЛОТНИКОВ И В ПОПЫТКАХ
Dialogue: 0,0:05:29.80,0:05:32.77,Caption,,0,0,0,,ОГРАНИЧИВАТЬ РОССИЙСКОЕ СУДОХОДСТВО. ОТВЕТ ПОКА
Dialogue: 0,0:05:32.77,0:05:35.79,Caption,,0,0,0,,ПОЛИТИЧЕСКИЙ И ДИПЛОМАТИЧЕСКИЙ. И ВОТ ЭТО КАК РАЗ
Dialogue: 0,0:05:35.79,0:05:38.64,Caption,,0,0,0,,ВНУТРИ РОССИИ МНОГИХ РАЗДРАЖАЕТ. ПОТОМУ ЧТО МОЖНО
Dialogue: 0,0:05:38.64,0:05:41.68,Caption,,0,0,0,,СКОЛЬКО УГОДНО РИСОВАТЬ КРАСНЫЕ ЛИНИИ НА КАРТАХ. НО
Dialogue: 0,0:05:41.68,0:05:43.46,Caption,,0,0,0,,ЕСЛИ ИХ ПОСТОЯННО ПЕРЕСТУПАЮТ,
Dialogue: 0,0:05:43.70,0:05:45.86,Caption,,0,0,0,,А ЗА НИМИ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА ЛИНИЯ,
Dialogue: 0,0:05:46.02,0:05:49.03,Caption,,0,0,0,,ПОТОМ ЕЩЁ ОДНА, ТО У ЧАСТИ ЛЮДЕЙ ЭТО НАЧИНАЕТ
Dialogue: 0,0:05:49.03,0:05:50.82,Caption,,0,0,0,,ВОСПРИНИМАТЬСЯ УЖЕ НЕ КАК МУДРОСТЬ,
Dialogue: 0,0:05:50.98,0:05:53.78,Caption,,0,0,0,,А КАК СЛАБОСТЬ. И ЗДЕСЬ ЕСТЬ НЕПРИЯТНАЯ ВЕЩЬ,
Dialogue: 0,0:05:54.03,0:05:55.94,Caption,,0,0,0,,КОТОРУЮ ТОЖЕ НЕЛЬЗЯ ВЫБРАСЫВАТЬ ИЗ
Dialogue: 0,0:05:55.94,0:05:58.74,Caption,,0,0,0,,РАЗГОВОРА. НА РУКОВОДСТВЕ РОССИИ ЛЕЖИТ СОВСЕМ ДРУГАЯ
Dialogue: 0,0:05:58.74,0:06:00.58,Caption,,0,0,0,,ОТВЕТСТВЕННОСТЬ, ЧЕМ НА ЧЕЛОВЕКЕ,
Dialogue: 0,0:06:00.82,0:06:02.94,Caption,,0,0,0,,КОТОРЫЙ ПИШЕТ ГНЕВНЫЙ КОММЕНТАРИЙ ИЗ
Dialogue: 0,0:06:02.94,0:06:06.26,Caption,,0,0,0,,ДОМА. СКАЗАТЬ НАДО ЖЁСТЧЕ, ОЧЕНЬ ЛЕГКО. А ПОТОМ ЧТО?
Dialogue: 0,0:06:08.55,0:06:11.19,Caption,,0,0,0,,ЕСЛИ ПОСЛЕ ЭТОГО НАЧИНАЕТ РАСКРУЧИВАТЬСЯ ЦЕПОЧКА,
Dialogue: 0,0:06:11.43,0:06:13.43,Caption,,0,0,0,,КОТОРУЮ УЖЕ НИКТО НЕ МОЖЕТ ОСТАНОВИТЬ,
Dialogue: 0,0:06:13.79,0:06:15.82,Caption,,0,0,0,,РАДОВАТЬСЯ БУДУТ НЕДОЛГО ДАЖЕ САМЫЕ
Dialogue: 0,0:06:15.82,0:06:18.32,Caption,,0,0,0,,ГОРЯЧИЕ СТОРОННИКИ ЖЁСТКОГО ОТВЕТА. НО И
Dialogue: 0,0:06:18.32,0:06:21.75,Caption,,0,0,0,,БЕСКОНЕЧНО ДЕЛАТЬ ВИД, ЧТО НИЧЕГО ОСОБЕННОГО НЕ ПРОИСХОДИТ,
Dialogue: 0,0:06:21.89,0:06:24.06,Caption,,0,0,0,,ТОЖЕ НЕ ПОЛУЧИТСЯ. ПОТОМУ ЧТО ТОГДА
Dialogue: 0,0:06:24.06,0:06:27.37,Caption,,0,0,0,,КРАСНАЯ ЛИНИЯ ПРЕВРАЩАЕТСЯ ПРОСТО В ЭЛЕМЕНТ ДИЗАЙНА
Dialogue: 0,0:06:27.37,0:06:29.67,Caption,,0,0,0,,КАРТЫ. В ПОЛЬШЕ ПРИМЕРНО ТА ЖЕ НЕРВОЗНОСТЬ,
Dialogue: 0,0:06:29.91,0:06:31.81,Caption,,0,0,0,,ТОЛЬКО ПРОЯВЛЯЕТСЯ ОНА ПО СВОЕМУ.
Dialogue: 0,0:06:31.81,0:06:34.05,Caption,,0,0,0,,РОССИЙСКИЙ БЕСПИЛОТНИК ЗАЛЕТЕЛ В ПОЛЬСКОЕ
Dialogue: 0,0:06:34.05,0:06:36.80,Caption,,0,0,0,,ВОЗДУШНОЕ ПРОСТРАНСТВО НАД ХЕЛМОМ. ПОЛЬСКАЯ
Dialogue: 0,0:06:36.80,0:06:39.58,Caption,,0,0,0,,СИСТЕМА ПРОТИВОВОЗДУШНОЙ ОБОРОНЫ БЫЛА ГОТОВА.
Dialogue: 0,0:06:39.58,0:06:43.19,Caption,,0,0,0,,РАЗРЕШЕНИЕ НА ПОРАЖЕНИЕ ЦЕЛИ, ПО СООБЩЕНИЮ ПОЛЬСКОЙ СТОРОНЫ,
Dialogue: 0,0:06:43.27,0:06:45.91,Caption,,0,0,0,,БЫЛО. НО СБИВАТЬ НЕ СТАЛИ. ПОЧЕМУ?
Dialogue: 0,0:06:46.23,0:06:47.83,Caption,,0,0,0,,ПОТОМУ ЧТО БЕСПИЛОТНИК ПОВЕРНУЛ
Dialogue: 0,0:06:47.83,0:06:50.63,Caption,,0,0,0,,ОБРАТНО В СТОРОНУ УКРАИНЫ, А ВОЕННЫЕ РЕШИЛИ,
Dialogue: 0,0:06:50.71,0:06:52.76,Caption,,0,0,0,,ЧТО РИСК ОТ ЕГО УНИЧТОЖЕНИЯ ДЛЯ ЛЮДЕЙ
Dialogue: 0,0:06:52.76,0:06:55.11,Caption,,0,0,0,,НА ЗЕМЛЕ МОЖЕТ ОКАЗАТЬСЯ ВЫШЕ. ТО ЕСТЬ
Dialogue: 0,0:06:55.11,0:06:57.39,Caption,,0,0,0,,КОГДА ЦЕЛЬ РЕАЛЬНО ПОЯВИЛАСЬ НАД ПОЛЬСКИМ
Dialogue: 0,0:06:57.39,0:06:59.93,Caption,,0,0,0,,ГОРОДОМ, ВКЛЮЧИЛАСЬ ОБЫЧНАЯ ЧЕЛОВЕЧЕСКАЯ
Dialogue: 0,0:06:59.93,0:07:03.08,Caption,,0,0,0,,АРИФМЕТИКА. НЕ ЛОЗУНГИ. НЕ РЕЧИ. НЕ ГРОЗНЫЕ
Dialogue: 0,0:07:03.08,0:07:06.39,Caption,,0,0,0,,ЗАЯВЛЕНИЯ. А ПРОСТОЙ ВОПРОС ЕСЛИ СЕЙЧАС ПАЛЬНУТЬ,
Dialogue: 0,0:07:06.53,0:07:08.87,Caption,,0,0,0,,КУДА ВСЁ ЭТО УПАДЁТ? И ПРАВИЛЬНО,
Dialogue: 0,0:07:08.95,0:07:11.08,Caption,,0,0,0,,ЧТО ТАКОЙ ВОПРОС ЗАДАЮТ. НО ОН ОЧЕНЬ
Dialogue: 0,0:07:11.08,0:07:13.64,Caption,,0,0,0,,ХОРОШО ПОКАЗЫВАЕТ РАЗНИЦУ МЕЖДУ РАЗГОВОРАМИ О
Dialogue: 0,0:07:13.64,0:07:17.90,Caption,,0,0,0,,БОЛЬШОЙ ВОЙНЕ И МОМЕНТОМ, КОГДА НАДО НАЖАТЬ КОНКРЕТНУЮ КНОПКУ.
Dialogue: 0,0:07:17.90,0:07:23.59,Caption,,0,0,0,,ТО ЖЕ САМОЕ С ДИПЛОМАТИЕЙ. В ПОЛЬШЕ ЗВУЧАТ ПРИЗЫВЫ ВЫСЛАТЬ
Dialogue: 0,0:07:23.59,0:07:26.29,Caption,,0,0,0,,РОССИЙСКОГО ПОСЛА. А ЗАМЕСТИТЕЛЬ МИНИСТРА ОБОРОНЫ
Dialogue: 0,0:07:26.29,0:07:29.24,Caption,,0,0,0,,ПРЕДУПРЕЖДАЕТ ВЫ ЕГО ВЫШЛЕТЕ, МОСКВА ОТВЕТИТ,
Dialogue: 0,0:07:29.55,0:07:31.34,Caption,,0,0,0,,ПОЛЬША ПОТЕРЯЕТ СВОЁ ПОСОЛЬСТВО В
Dialogue: 0,0:07:31.34,0:07:33.96,Caption,,0,0,0,,РОССИИ, А ВМЕСТЕ С НИМ И ВОЗМОЖНОСТЬ СМОТРЕТЬ,
Dialogue: 0,0:07:34.12,0:07:36.22,Caption,,0,0,0,,ЧТО ТАМ ПРОИСХОДИТ ИЗНУТРИ. ТО ЕСТЬ
Dialogue: 0,0:07:36.22,0:07:39.66,Caption,,0,0,0,,ОПЯТЬ ВЫЯСНЯЕТСЯ, ЧТО ДАЖЕ У ОЧЕНЬ ГРОМКИХ ШАГОВ ЕСТЬ
Dialogue: 0,0:07:39.66,0:07:41.96,Caption,,0,0,0,,ЦЕНА. ЕСЛИ ВАМ БЛИЗОК ТАКОЙ ФОРМАТ,
Dialogue: 0,0:07:42.12,0:07:43.96,Caption,,0,0,0,,ГДЕ МЫ НЕ СЧИТАЕМ ГРОМКОСТЬ ЗАЯВЛЕНИЯ
Dialogue: 0,0:07:43.96,0:07:47.46,Caption,,0,0,0,,ДОКАЗАТЕЛЬСТВОМ СИЛЫ, ПОДПИШИТЕСЬ. ПОТОМУ ЧТО ДАЛЬШЕ ЭТА
Dialogue: 0,0:07:47.46,0:07:50.34,Caption,,0,0,0,,ИСТОРИЯ СТАНОВИТСЯ ЕЩЁ ВЕСЕЛЕЕ. БАЛТИКА ЗДЕСЬ
Dialogue: 0,0:07:50.34,0:07:54.68,Caption,,0,0,0,,ТОЛЬКО НАЧАЛО. ЗЕЛЕНСКИЙ, ОБЪЯСНЯЯ АТАКУ НА РОССИЙСКОЕ СУДНО,
Dialogue: 0,0:07:54.92,0:07:57.74,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО ЗАКОННЫМИ ЦЕЛЯМИ СЧИТАЕТ СУДА ПОД
Dialogue: 0,0:07:57.74,0:08:01.55,Caption,,0,0,0,,РОССИЙСКИМ ФЛАГОМ, СУДА С ОРУЖИЕМ И ГРУЗЫ ПОД САНКЦИЯМИ.
Dialogue: 0,0:08:01.55,0:08:04.20,Caption,,0,0,0,,ПРИЧЁМ РЕЧЬ ШЛА И О НЕЙТРАЛЬНЫХ ВОДАХ. И ВОТ
Dialogue: 0,0:08:04.28,0:08:07.00,Caption,,0,0,0,,ТУТ МОЖНО ПОНЯТЬ БЕСПОКОЙСТВО СОЮЗНИКОВ УКРАИНЫ.
Dialogue: 0,0:08:07.40,0:08:09.16,Caption,,0,0,0,,ПОТОМУ ЧТО ЕСЛИ ЭТУ ЛОГИКУ РАСТЯНУТЬ,
Dialogue: 0,0:08:09.40,0:08:11.54,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ОЧЕНЬ СКОЛЬЗКАЯ ДОРОЖКА.
Dialogue: 0,0:08:11.54,0:08:14.35,Caption,,0,0,0,,МОЖНО ЗАФИГАЧИТЬ КАКОЙ НИБУДЬ КОРАБЛЬ ПОД ФЛАГОМ МАЛЬТЫ
Dialogue: 0,0:08:14.35,0:08:16.57,Caption,,0,0,0,,И ПОТОМ СКАЗАТЬ А ПРИНАДЛЕЖИТ ОН УКРАИНСКИМ
Dialogue: 0,0:08:16.57,0:08:19.52,Caption,,0,0,0,,ВЛАДЕЛЬЦАМ, А ГРУЗ ТАМ ОРУЖИЕ. НУ ПОПРОБУЙ ПОТОМ
Dialogue: 0,0:08:19.52,0:08:22.69,Caption,,0,0,0,,ДОКАЖИ ОБРАТНОЕ, КОГДА КОРАБЛЬ УЖЕ ГОРИТ. И САМОЕ
Dialogue: 0,0:08:22.69,0:08:25.60,Caption,,0,0,0,,НЕПРИЯТНОЕ, ЧТО ТАКАЯ ЛОГИКА УМЕЕТ ХОДИТЬ В ОБЕ
Dialogue: 0,0:08:25.60,0:08:28.52,Caption,,0,0,0,,СТОРОНЫ. УКРАИНСКИХ КОМПАНИЙ, ВЛАДЕЛЬЦЕВ,
Dialogue: 0,0:08:28.60,0:08:31.36,Caption,,0,0,0,,СУДОВ, ВСПОМОГАТЕЛЬНОЙ ИНФРАСТРУКТУРЫ ЗА
Dialogue: 0,0:08:31.36,0:08:36.65,Caption,,0,0,0,,РУБЕЖОМ ТОЖЕ ХВАТАЕТ. ЕСЛИ АТАКА НА РОССИЙСКИЙ ОБЪЕКТ В
Dialogue: 0,0:08:36.65,0:08:39.37,Caption,,0,0,0,,ТРЕТЬЕЙ СТРАНЕ ОБЪЯВЛЯЕТСЯ ДОПУСТИМОЙ ТОЛЬКО ПОТОМУ,
Dialogue: 0,0:08:39.53,0:08:43.09,Caption,,0,0,0,,ЧТО ОБЪЕКТ РОССИЙСКИЙ, ТО НЕИЗБЕЖНО ПОЯВЛЯЕТСЯ ЗЕРКАЛЬНЫЙ
Dialogue: 0,0:08:43.09,0:08:45.41,Caption,,0,0,0,,ВОПРОС. А ЧТО ТОГДА МЕШАЕТ КОМУ ТО ОБЪЯВИТЬ
Dialogue: 0,0:08:45.41,0:08:47.77,Caption,,0,0,0,,УКРАИНСКИЙ ОБЪЕКТ ЗА РУБЕЖОМ ТАКОЙ ЖЕ ЦЕЛЬЮ?
Dialogue: 0,0:08:48.15,0:08:50.73,Caption,,0,0,0,,НЕ ЗНАЧИТ, ЧТО ЭТО НАДО ДЕЛАТЬ. ЗНАЧИТ,
Dialogue: 0,0:08:50.89,0:08:53.08,Caption,,0,0,0,,ЧТО ИМЕННО ТАКИЕ ПРАВИЛА ОЧЕНЬ БЫСТРО
Dialogue: 0,0:08:53.08,0:08:56.04,Caption,,0,0,0,,НАЧИНАЮТ ЖИТЬ СВОЕЙ ЖИЗНЬЮ. И ВОТ ЗДЕСЬ МЫ ВЫХОДИМ
Dialogue: 0,0:08:56.04,0:08:58.50,Caption,,0,0,0,,ИЗ БАЛТИКИ В СРЕДИЗЕМНОЕ МОРЕ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:08:58.50,0:09:01.16,Caption,,0,0,0,,ПОДТВЕРДИЛ УКРАИНСКУЮ АТАКУ НА РОССИЙСКИЕ СУДА В
Dialogue: 0,0:09:01.16,0:09:04.22,Caption,,0,0,0,,РАЙОНЕ БЕНГАЗИ И НАЗВАЛ ОПЕРАЦИЮ ОБРАЗЦОВОЙ. ПО ЕГО
Dialogue: 0,0:09:04.22,0:09:06.54,Caption,,0,0,0,,СЛОВАМ, ИСПОЛЬЗОВАЛИСЬ СЕМЬ МОРСКИХ
Dialogue: 0,0:09:06.54,0:09:09.85,Caption,,0,0,0,,БЕСПИЛОТНИКОВ. ОН ЗАЯВИЛ ОБ УНИЧТОЖЕНИИ КОРВЕТА "МЕРКУРИЙ",
Dialogue: 0,0:09:10.01,0:09:12.46,Caption,,0,0,0,,ВЕРТОЛЁТА КА ДВАДЦАТЬ СЕМЬ И ПОРАЖЕНИИ
Dialogue: 0,0:09:12.46,0:09:15.11,Caption,,0,0,0,,СУХОГРУЗА "АНГАРА". А ВОТ ОТКУДА ЗАПУСТИЛИ
Dialogue: 0,0:09:15.11,0:09:18.83,Caption,,0,0,0,,МОРСКИЕ ДРОНЫ, НЕ СООБЩИЛ. ЕСТЬ ДВЕ ВЕРСИИ ТЕРРИТОРИЯ
Dialogue: 0,0:09:18.83,0:09:21.74,Caption,,0,0,0,,АЛБАНИИ ИЛИ СЕКРЕТНАЯ БАЗА НА ЗАПАДЕ ЛИВИИ. ПОКА
Dialogue: 0,0:09:21.74,0:09:24.87,Caption,,0,0,0,,ЭТО ТОЛЬКО ВЕРСИИ. НО ОБЕ ДОБАВЛЯЮТ К ОПЕРАЦИИ
Dialogue: 0,0:09:24.87,0:09:27.30,Caption,,0,0,0,,ЕЩЁ ОДИН НЕПРИЯТНЫЙ ВОПРОС КТО ПРЕДОСТАВИЛ
Dialogue: 0,0:09:27.30,0:09:30.64,Caption,,0,0,0,,ТЕРРИТОРИЮ ДЛЯ ЗАПУСКА? ЗАЯВЛЕННЫЕ РЕЗУЛЬТАТЫ ЕЩЁ МОГУТ
Dialogue: 0,0:09:30.64,0:09:33.77,Caption,,0,0,0,,ОБСУЖДАТЬСЯ ОТДЕЛЬНО. НО ГЕОГРАФИЯ УЖЕ НИКУДА НЕ
Dialogue: 0,0:09:33.77,0:09:36.83,Caption,,0,0,0,,ДЕНЕТСЯ. ЛИВИЯ. СРЕДИЗЕМНОЕ МОРЕ. РОССИЙСКОЕ
Dialogue: 0,0:09:36.83,0:09:41.05,Caption,,0,0,0,,ПРИСУТСТВИЕ В АФРИКЕ. ПОРТЫ. МАРШРУТЫ СНАБЖЕНИЯ. И ВОТ ЭТО
Dialogue: 0,0:09:41.05,0:09:43.70,Caption,,0,0,0,,УЖЕ СОВСЕМ НЕ УКРАИНСКАЯ ТЕРРИТОРИЯ. РАСЧЁТ
Dialogue: 0,0:09:43.70,0:09:48.24,Caption,,0,0,0,,ПОНЯТЕН. ЕСЛИ РОССИЙСКОЕ ПРИСУТСТВИЕ В АФРИКЕ
Dialogue: 0,0:09:48.24,0:09:51.16,Caption,,0,0,0,,ЗАВИСИТ ОТ КОРАБЛЕЙ, ПОРТОВ И ДОСТАВКИ ГРУЗОВ,
Dialogue: 0,0:09:51.48,0:09:53.40,Caption,,0,0,0,,ЗНАЧИТ УДАР ПО ЭТИМ ЗВЕНЬЯМ ДЕЛАЕТ
Dialogue: 0,0:09:53.40,0:09:56.89,Caption,,0,0,0,,ТАКОЕ ПРИСУТСТВИЕ ДОРОЖЕ И ОПАСНЕЕ. КРАСИВО НА БУМАГЕ.
Dialogue: 0,0:09:56.89,0:09:59.73,Caption,,0,0,0,,ТОЛЬКО БЕНГАЗИ С УКРАИНОЙ НЕ ВОЮЕТ. И ТУТ ЛИВИЯ
Dialogue: 0,0:09:59.73,0:10:02.36,Caption,,0,0,0,,ГОВОРИТ СЕКУНДОЧКУ, А ВЫ ВООБЩЕ ГДЕ НАХОДИТЕСЬ?
Dialogue: 0,0:10:02.76,0:10:04.43,Caption,,0,0,0,,ЗАМЕСТИТЕЛЬ ГЛАВЫ ПРЕЗИДЕНТСКОГО
Dialogue: 0,0:10:04.43,0:10:07.03,Caption,,0,0,0,,СОВЕТА ЛИВИИ МУСА АЛЬ КУНИ НАЗВАЛ ПРОИЗОШЕДШЕЕ
Dialogue: 0,0:10:07.03,0:10:10.45,Caption,,0,0,0,,РАВНОСИЛЬНЫМ ОБЪЯВЛЕНИЮ ВОЙНЫ. ЛИВИЙСКАЯ СТОРОНА ЗАЯВИЛА О
Dialogue: 0,0:10:10.45,0:10:13.82,Caption,,0,0,0,,НАРУШЕНИИ СУВЕРЕНИТЕТА, ОБ УЩЕРБЕ И РАНЕНИЯХ СРЕДИ
Dialogue: 0,0:10:13.82,0:10:17.64,Caption,,0,0,0,,ГРАЖДАНСКИХ. ЗАГОВОРИЛА ОБ ОБРАЩЕНИИ В СОВЕТ БЕЗОПАСНОСТИ ООН,
Dialogue: 0,0:10:17.83,0:10:20.68,Caption,,0,0,0,,МЕЖДУНАРОДНЫЙ СУД И ДРУГИЕ МЕЖДУНАРОДНЫЕ СТРУКТУРЫ.
Dialogue: 0,0:10:21.11,0:10:22.89,Caption,,0,0,0,,ПРОЗВУЧАЛО И ТРЕБОВАНИЕ СОЗВАТЬ
Dialogue: 0,0:10:22.89,0:10:25.08,Caption,,0,0,0,,ЭКСТРЕННОЕ ЗАСЕДАНИЕ СОВБЕЗА ООН,
Dialogue: 0,0:10:25.32,0:10:27.56,Caption,,0,0,0,,ВКЛЮЧИТЬ ЗЕЛЕНСКОГО В СПИСОК ПОДОЗРЕВАЕМЫХ В
Dialogue: 0,0:10:27.56,0:10:29.52,Caption,,0,0,0,,ТЕРРОРИЗМЕ И ПРИНЯТЬ МЕРЫ ПРОТИВ
Dialogue: 0,0:10:29.52,0:10:32.96,Caption,,0,0,0,,ПОДОБНЫХ НАПАДЕНИЙ. ОТДЕЛЬНО ПРЕДЛОЖЕНО СОБРАТЬ ВОЕННЫЕ
Dialogue: 0,0:10:32.96,0:10:36.06,Caption,,0,0,0,,КОМИТЕТЫ ЛИВИИ, ЧТОБЫ ОПРЕДЕЛИТЬ ДАЛЬНЕЙШИЕ ДЕЙСТВИЯ.
Dialogue: 0,0:10:36.06,0:10:39.48,Caption,,0,0,0,,ТО ЕСТЬ ОПЕРАЦИЯ, КОТОРУЮ КИЕВ НАЗЫВАЕТ ОБРАЗЦОВОЙ,
Dialogue: 0,0:10:39.72,0:10:44.22,Caption,,0,0,0,,В СТРАНЕ, ГДЕ ОНА ПРОИЗОШЛА, ПОЛУЧАЕТ СОВСЕМ ДРУГУЮ ОЦЕНКУ. ВОТ ВАМ
Dialogue: 0,0:10:44.22,0:10:46.65,Caption,,0,0,0,,И ОБРАЗЦОВОСТЬ. ПРИЧЁМ РЯДОМ ВСПЛЫВАЕТ
Dialogue: 0,0:10:46.65,0:10:49.59,Caption,,0,0,0,,ЕЩЁ ОДИН СЮЖЕТ. СООБЩАЕТСЯ ОБ АТАКЕ НА ИРАНСКОЕ
Dialogue: 0,0:10:49.59,0:10:52.11,Caption,,0,0,0,,ТОРГОВОЕ СУДНО ALVAN. И ЕСЛИ АТАКИ НАЧИНАЮТ
Dialogue: 0,0:10:52.11,0:10:55.46,Caption,,0,0,0,,ПЕРЕХОДИТЬ С РОССИЙСКИХ ВОЕННЫХ И ГРУЗОВЫХ ОБЪЕКТОВ НА СУДА
Dialogue: 0,0:10:55.46,0:10:58.52,Caption,,0,0,0,,ДРУГИХ СТРАН, НАЧИНАЕТСЯ УЖЕ СОВСЕМ ДРУГОЙ РАЗГОВОР.
Dialogue: 0,0:11:00.81,0:11:02.58,Caption,,0,0,0,,ПОТОМУ ЧТО МИРОВАЯ ТОРГОВЛЯ ДЕРЖИТСЯ
Dialogue: 0,0:11:02.58,0:11:05.14,Caption,,0,0,0,,НА ОЧЕНЬ ПРОСТОЙ ВЕЩИ КОРАБЛЬ ВЫХОДИТ ИЗ ОДНОГО
Dialogue: 0,0:11:05.14,0:11:07.46,Caption,,0,0,0,,ПОРТА И ДОЛЖЕН ДОЙТИ ДО ДРУГОГО. ЕСЛИ ПО
Dialogue: 0,0:11:07.46,0:11:10.65,Caption,,0,0,0,,ДОРОГЕ ПОЯВЛЯЕТСЯ НОВАЯ ИГРА ПОД НАЗВАНИЕМ УГАДАЙ,
Dialogue: 0,0:11:10.76,0:11:12.89,Caption,,0,0,0,,ЧЕЙ НА САМОМ ДЕЛЕ ЭТОТ СУХОГРУЗ И ЧТО
Dialogue: 0,0:11:12.89,0:11:16.24,Caption,,0,0,0,,У НЕГО В КОНТЕЙНЕРАХ, СТРАХОВОЙ РЫНОК МГНОВЕННО НАЧИНАЕТ
Dialogue: 0,0:11:16.24,0:11:18.91,Caption,,0,0,0,,СЧИТАТЬ ДЕНЬГИ. А СТРАХОВАНИЕ МОРСКИХ ПЕРЕВОЗОК ЭТО
Dialogue: 0,0:11:18.91,0:11:21.93,Caption,,0,0,0,,ВООБЩЕ ОТДЕЛЬНАЯ ПРЕКРАСНАЯ ИСТОРИЯ. ЧЕМ ВЫШЕ РИСК,
Dialogue: 0,0:11:22.06,0:11:24.28,Caption,,0,0,0,,ТЕМ ВЫШЕ СТРАХОВКА. КТО ЗАРАБАТЫВАЕТ
Dialogue: 0,0:11:24.28,0:11:27.16,Caption,,0,0,0,,НА СТРАХОВАНИИ? ЛОНДОН В ЭТОМ БИЗНЕСЕ ДАЛЕКО НЕ
Dialogue: 0,0:11:27.16,0:11:30.65,Caption,,0,0,0,,ПОСЛЕДНИЙ ГОРОД. И ЗДЕСЬ ПОЯВЛЯЕТСЯ ОЧЕНЬ ЗАНЯТНАЯ
Dialogue: 0,0:11:30.65,0:11:33.58,Caption,,0,0,0,,ВЕРСИЯ. ХАОС В МОРСКОЙ ТОРГОВЛЕ БЬЁТ ПРЕЖДЕ ВСЕГО ПО
Dialogue: 0,0:11:33.58,0:11:36.16,Caption,,0,0,0,,СТРАНАМ, КОТОРЫЕ СИЛЬНО ЗАВИСЯТ ОТ МОРСКИХ
Dialogue: 0,0:11:36.16,0:11:39.87,Caption,,0,0,0,,ПЕРЕВОЗОК. ПО ЭТОЙ ВЕРСИИ, ЗАВИСИМОСТЬ НЕКОТОРЫХ СТРАН ОТ МОРСКИХ
Dialogue: 0,0:11:39.87,0:11:42.49,Caption,,0,0,0,,ПЕРЕВОЗОК ДОСТИГАЕТ СЕМИДЕСЯТИ ПРОЦЕНТОВ. ПРИ
Dialogue: 0,0:11:42.49,0:11:45.43,Caption,,0,0,0,,ЭТОМ САМА БРИТАНИЯ ТОЖЕ ЗАВИСИТ ОТ МОРЯ. ВОТ И
Dialogue: 0,0:11:45.43,0:11:48.26,Caption,,0,0,0,,ПОЛУЧАЕТСЯ СТРАННАЯ КАРТИНА. СОЗДАВАТЬ ХАОС
Dialogue: 0,0:11:48.26,0:11:50.89,Caption,,0,0,0,,ВЫГОДНО ТОЛЬКО ТОГДА, КОГДА ТЫ УВЕРЕН,
Dialogue: 0,0:11:51.05,0:11:53.10,Caption,,0,0,0,,ЧТО СОБСТВЕННУЮ ДВЕРЬ КАК НИБУДЬ
Dialogue: 0,0:11:53.10,0:11:56.65,Caption,,0,0,0,,ПРИКРОЕШЬ. А СОСЕД ПУСТЬ РАЗБИРАЕТСЯ. ОТСЮДА И ВЕРСИЯ ПРО
Dialogue: 0,0:11:56.65,0:11:59.45,Caption,,0,0,0,,КОНТРОЛИРУЕМЫЙ ХАОС, ПРО СТРАХОВЫЕ ДЕНЬГИ,
Dialogue: 0,0:11:59.64,0:12:01.45,Caption,,0,0,0,,ПРО ПЕРЕРАСПРЕДЕЛЕНИЕ КАПИТАЛОВ,
Dialogue: 0,0:12:01.63,0:12:03.45,Caption,,0,0,0,,ПРО ПОПЫТКУ СОХРАНИТЬ ВЛИЯНИЕ,
Dialogue: 0,0:12:03.61,0:12:06.09,Caption,,0,0,0,,КОГДА ПРЕЖНЕГО ЗАПАСА СИЛЫ УЖЕ МЕНЬШЕ.
Dialogue: 0,0:12:06.09,0:12:10.45,Caption,,0,0,0,,ЭТО ВЕРСИЯ. НО ОНА ХОТЯ БЫ ОБЪЯСНЯЕТ,
Dialogue: 0,0:12:10.68,0:12:12.62,Caption,,0,0,0,,ПОЧЕМУ ЭКОНОМИЧЕСКИЕ ПОСЛЕДСТВИЯ ВСЕЙ
Dialogue: 0,0:12:12.62,0:12:14.85,Caption,,0,0,0,,ЭТОЙ ИСТОРИИ МОГУТ ОКАЗАТЬСЯ КУДА ШИРЕ,
Dialogue: 0,0:12:15.01,0:12:19.31,Caption,,0,0,0,,ЧЕМ ОДИН ПОДБИТЫЙ КОРАБЛЬ. И ТУТ ЖЕ ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА ДЕНЕЖНАЯ
Dialogue: 0,0:12:19.31,0:12:22.09,Caption,,0,0,0,,ЛИНИЯ. ДВАДЦАТЬ ШЕСТОГО И ДВАДЦАТЬ СЕДЬМОГО
Dialogue: 0,0:12:22.09,0:12:24.54,Caption,,0,0,0,,НОЯБРЯ ЛИДЕРЫ ЕВРОСОЮЗА СОБИРАЮТСЯ ОБСУЖДАТЬ
Dialogue: 0,0:12:24.54,0:12:27.81,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНОЕ ФИНАНСИРОВАНИЕ УКРАИНЫ. РЕЧЬ О КРЕДИТЕ
Dialogue: 0,0:12:27.81,0:12:30.85,Caption,,0,0,0,,НА СУММУ ДО СОРОКА ПЯТИ МИЛЛИАРДОВ ЕВРО. И РЯДОМ
Dialogue: 0,0:12:30.85,0:12:33.55,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ВЕРСИЯ ПЕРЕД НОВЫМ БОЛЬШИМ РАЗГОВОРОМ
Dialogue: 0,0:12:33.55,0:12:36.05,Caption,,0,0,0,,О ДЕНЬГАХ КИЕВУ НУЖНО ПОКАЗАТЬ РЕЗУЛЬТАТ. НЕ
Dialogue: 0,0:12:36.05,0:12:39.23,Caption,,0,0,0,,ПРОСТО СКАЗАТЬ, ЧТО МЫ ДЕРЖИМСЯ. А ПРИНЕСТИ НА СТОЛ
Dialogue: 0,0:12:39.23,0:12:41.63,Caption,,0,0,0,,ЧТО ТО ГРОМКОЕ. БАЛТИКА. БЕНГАЗИ.
Dialogue: 0,0:12:41.63,0:12:45.07,Caption,,0,0,0,,РОССИЙСКИЕ СУДА. РАСШИРЕНИЕ ГЕОГРАФИИ ОПЕРАЦИЙ.
Dialogue: 0,0:12:45.07,0:12:48.05,Caption,,0,0,0,,ПОКАЗАТЬ СПОНСОРАМ СМОТРИТЕ, ИНСТРУМЕНТ РАБОТАЕТ,
Dialogue: 0,0:12:48.19,0:12:50.43,Caption,,0,0,0,,ДАВАЙТЕ ДЕНЬГИ ДАЛЬШЕ. ТАК ЭТО ИЛИ
Dialogue: 0,0:12:50.43,0:12:53.08,Caption,,0,0,0,,НЕТ, НО СОВПАДЕНИЕ ПО ВРЕМЕНИ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:12:53.08,0:12:55.62,Caption,,0,0,0,,ЗАНЯТНОЕ. ТЕМ БОЛЕЕ ЧТО ПРОДОЛЖЕНИЕ ФИНАНСИРОВАНИЯ
Dialogue: 0,0:12:55.62,0:12:57.73,Caption,,0,0,0,,УЖЕ ЗАВЯЗАНО НЕ НА МЕСЯЦ И НЕ НА ДВА,
Dialogue: 0,0:12:57.96,0:13:01.89,Caption,,0,0,0,,А НА СЛЕДУЮЩИЙ ГОД. А ТЕПЕРЬ ВЕРНЁМСЯ К БРИТАНИИ. ТАМ
Dialogue: 0,0:13:01.89,0:13:04.69,Caption,,0,0,0,,КОНТРРАЗВЕДКА И МИНИСТЕРСТВО ОБОРОНЫ ПРЕДУПРЕЖДАЮТ О
Dialogue: 0,0:13:04.69,0:13:06.49,Caption,,0,0,0,,РИСКАХ РОССИЙСКИХ ДИВЕРСИЙ ПРОТИВ
Dialogue: 0,0:13:06.49,0:13:09.48,Caption,,0,0,0,,ПРЕДПРИЯТИЙ, КОТОРЫЕ РАБОТАЮТ НА УКРАИНСКИЕ ВОЕННЫЕ
Dialogue: 0,0:13:09.48,0:13:12.17,Caption,,0,0,0,,ПОСТАВКИ. РОССИЙСКОЕ ПОСОЛЬСТВО ОТВЕЧАЕТ
Dialogue: 0,0:13:12.17,0:13:15.56,Caption,,0,0,0,,АТАКОВАТЬ БРИТАНСКИЕ ЗАВОДЫ МОСКВА НЕ СОБИРАЕТСЯ. ПРИ ЭТОМ
Dialogue: 0,0:13:15.56,0:13:17.33,Caption,,0,0,0,,БОРИС ДЖОНСОН СПОКОЙНО ГОВОРИТ,
Dialogue: 0,0:13:17.57,0:13:19.66,Caption,,0,0,0,,ЧТО БРИТАНИЯ УЖЕ ВЕДЁТ ОПОСРЕДОВАННУЮ
Dialogue: 0,0:13:19.66,0:13:24.25,Caption,,0,0,0,,ВОЙНУ С РОССИЕЙ. НАПОМИНАЕТ О МИЛЛИАРДАХ,
Dialogue: 0,0:13:24.33,0:13:27.37,Caption,,0,0,0,,БОЕПРИПАСАХ И ПОМОЩИ УКРАИНЕ. РАССУЖДАЕТ О
Dialogue: 0,0:13:27.37,0:13:29.81,Caption,,0,0,0,,ВОЗМОЖНОСТИ ИНОСТРАННЫХ ВОЙСК И О СИЛЕ
Dialogue: 0,0:13:29.81,0:13:32.55,Caption,,0,0,0,,НАТО. ТО ЕСТЬ ФОРМУЛА ПОЛУЧАЕТСЯ ЗАМЕЧАТЕЛЬНАЯ.
Dialogue: 0,0:13:32.55,0:13:36.12,Caption,,0,0,0,,МЫ УЧАСТВУЕМ. МЫ ПОСТАВЛЯЕМ. МЫ ФИНАНСИРУЕМ. МЫ
Dialogue: 0,0:13:36.12,0:13:40.02,Caption,,0,0,0,,ПОМОГАЕМ. НО ВЫ, ПОЖАЛУЙСТА, СЮДА НЕ ПРИХОДИТЕ. А В БОЛЬШОЙ
Dialogue: 0,0:13:40.02,0:13:43.02,Caption,,0,0,0,,ПОЛИТИКЕ ТАК РЕДКО БЫВАЕТ. НЕЛЬЗЯ ГОДАМИ ПОДНОСИТЬ
Dialogue: 0,0:13:43.02,0:13:45.53,Caption,,0,0,0,,ДРОВА К КОСТРУ, А ПОТОМ ВОЗМУЩАТЬСЯ,
Dialogue: 0,0:13:45.61,0:13:47.85,Caption,,0,0,0,,ЧТО ОТ НЕГО ЖАРКО. И ИТАЛИЯ ЭТО УЖЕ
Dialogue: 0,0:13:47.85,0:13:50.45,Caption,,0,0,0,,ПОЧУВСТВОВАЛА. ГЛАВА ИТАЛЬЯНСКОГО МИД
Dialogue: 0,0:13:50.45,0:13:53.52,Caption,,0,0,0,,АНТОНИО ТАЯНИ ПОСЛЕ ИСТОРИИ В БЕНГАЗИ ПРЯМО ГОВОРИТ
Dialogue: 0,0:13:53.52,0:13:55.66,Caption,,0,0,0,,О РИСКЕ РАСПРОСТРАНЕНИЯ КОНФЛИКТА НА
Dialogue: 0,0:13:55.66,0:13:57.61,Caption,,0,0,0,,СРЕДИЗЕМНОМОРЬЕ. ЕГО БЕСПОКОИТ,
Dialogue: 0,0:13:57.77,0:13:59.68,Caption,,0,0,0,,ЧТО ВСЁ ЭТО ПРОИСХОДИТ В НЕСКОЛЬКИХ
Dialogue: 0,0:13:59.68,0:14:02.12,Caption,,0,0,0,,СОТНЯХ КИЛОМЕТРОВ ОТ ИТАЛИИ И МОЖЕТ УДАРИТЬ
Dialogue: 0,0:14:02.12,0:14:06.16,Caption,,0,0,0,,ПО СТАБИЛЬНОСТИ ЛИВИИ. ВОТ ТУТ НАШ ВУЛКАН И ПОЯВЛЯЕТСЯ ВО
Dialogue: 0,0:14:06.16,0:14:08.73,Caption,,0,0,0,,ВСЕЙ КРАСЕ. КОГДА КОНФЛИКТ ДАЛЕКО,
Dialogue: 0,0:14:08.89,0:14:10.85,Caption,,0,0,0,,МОЖНО ГОВОРИТЬ О ПРИНЦИПАХ. КОГДА ДО
Dialogue: 0,0:14:10.85,0:14:12.65,Caption,,0,0,0,,НЕГО НЕСКОЛЬКО СОТЕН КИЛОМЕТРОВ,
Dialogue: 0,0:14:12.97,0:14:15.16,Caption,,0,0,0,,ВНЕЗАПНО ВСПОМИНАЕШЬ ПРО СОБСТВЕННЫЕ
Dialogue: 0,0:14:15.16,0:14:18.57,Caption,,0,0,0,,ПОРТЫ. ПРО ТОРГОВЛЮ. ПРО ТУРИСТИЧЕСКИЕ ПОБЕРЕЖЬЯ.
Dialogue: 0,0:14:18.57,0:14:22.71,Caption,,0,0,0,,ПРО ЭКОЛОГИЮ. ПРО СУДА. ПРО ЦЕНЫ. ПРО СТРАХОВКИ. И
Dialogue: 0,0:14:22.71,0:14:25.76,Caption,,0,0,0,,ПРО ТО, ЧТО СРЕДИЗЕМНОЕ МОРЕ ВООБЩЕ ТО НЕ
Dialogue: 0,0:14:25.76,0:14:28.38,Caption,,0,0,0,,ПОЛИГОН. ТЕМ БОЛЕЕ ЧТО УЖЕ СООБЩАЛОСЬ О ПОПЫТКЕ
Dialogue: 0,0:14:28.38,0:14:30.41,Caption,,0,0,0,,АТАКИ НА ТАНКЕР В ИТАЛЬЯНСКОЙ САВОНЕ,
Dialogue: 0,0:14:30.65,0:14:32.36,Caption,,0,0,0,,КОТОРАЯ МОГЛА ОБЕРНУТЬСЯ БОЛЬШОЙ
Dialogue: 0,0:14:32.36,0:14:35.83,Caption,,0,0,0,,ЭКОЛОГИЧЕСКОЙ АВАРИЕЙ. ВОТ ТОГДА ФРАЗА ЗВУЧИТ СОВСЕМ
Dialogue: 0,0:14:35.83,0:14:38.57,Caption,,0,0,0,,ИНАЧЕ. ВЫ САМИ ЗАЖГЛИ ОГОНЬ У СЕБЯ НА БАЛКОНЕ.
Dialogue: 0,0:14:40.83,0:14:44.08,Caption,,0,0,0,,ТЕПЕРЬ СТРАШНО СТАЛО? И ВЕДЬ ЭТО ТОЛЬКО НАЧАЛО ГЛАВНОЙ
Dialogue: 0,0:14:44.08,0:14:46.58,Caption,,0,0,0,,ПРОБЛЕМЫ. ПОТОМУ ЧТО ЕВРОПА ВСЁ ЧАЩЕ ГОВОРИТ О
Dialogue: 0,0:14:46.58,0:14:48.93,Caption,,0,0,0,,ГОТОВНОСТИ К БОЛЬШОЙ ВОЙНЕ ГДЕ ТО В РАЙОНЕ ДВЕ
Dialogue: 0,0:14:48.93,0:14:51.40,Caption,,0,0,0,,ТЫСЯЧИ ТРИДЦАТОГО ГОДА. СТРОИТ ПЛАНЫ,
Dialogue: 0,0:14:51.48,0:14:54.20,Caption,,0,0,0,,ЗАКРЫВАЕТ ГРАНИЦЫ, РАСШИРЯЕТ ПРИЗЫВ,
Dialogue: 0,0:14:54.39,0:14:56.79,Caption,,0,0,0,,УСИЛИВАЕТ ИНФРАСТРУКТУРУ. А ВОЙНА НЕ
Dialogue: 0,0:14:56.79,0:14:59.47,Caption,,0,0,0,,ОБЯЗАНА ЧИТАТЬ ЕВРОПЕЙСКИЙ КАЛЕНДАРЬ. ОНА УЖЕ
Dialogue: 0,0:14:59.47,0:15:02.65,Caption,,0,0,0,,ВЫЛЕЗАЕТ ЗА УКРАИНСКИЕ ГРАНИЦЫ. СНАЧАЛА БАЛТИКА.
Dialogue: 0,0:15:02.65,0:15:05.50,Caption,,0,0,0,,ПОТОМ СРЕДИЗЕМНОЕ МОРЕ. ПОТОМ ТРЕТЬИ СТРАНЫ
Dialogue: 0,0:15:05.50,0:15:08.50,Caption,,0,0,0,,НАЧИНАЮТ СЧИТАТЬ УЩЕРБ И ЗАДАВАТЬ ВОПРОСЫ. И
Dialogue: 0,0:15:08.50,0:15:11.44,Caption,,0,0,0,,ВОТ ТУТ ВЫЯСНЯЕТСЯ ПРОСТАЯ ВЕЩЬ. ПОСТРОИТЬ ДОМ
Dialogue: 0,0:15:11.44,0:15:14.66,Caption,,0,0,0,,ВОЗЛЕ ВУЛКАНА МОЖНО. МОЖНО ДАЖЕ ДОЛГО ОБЪЯСНЯТЬ
Dialogue: 0,0:15:14.66,0:15:17.89,Caption,,0,0,0,,СОСЕДЯМ, ЧТО МЕСТО ОТЛИЧНОЕ. НО КОГДА ЛАВА УЖЕ
Dialogue: 0,0:15:17.89,0:15:19.80,Caption,,0,0,0,,В ПРИХОЖЕЙ, ПОЗДНО УДИВЛЯТЬСЯ,
Dialogue: 0,0:15:19.95,0:15:21.16,Caption,,0,0,0,,ОТКУДА ОНА ВЗЯЛАСЬ.
