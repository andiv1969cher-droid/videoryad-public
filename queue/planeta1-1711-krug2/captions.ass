Dialogue: 0,0:00:00.12,0:00:02.92,Caption,,0,0,0,,У ЕВРОПЫ ЗАВЁЛСЯ НОВЫЙ ПОВОД ПРОВЕРЯТЬ ЗАМКИ ПЕРЕД
Dialogue: 0,0:00:02.92,0:00:04.84,Caption,,0,0,0,,СНОМ. РАНЬШЕ ТАМ ВЫСМАТРИВАЛИ,
Dialogue: 0,0:00:05.00,0:00:07.80,Caption,,0,0,0,,КАКОЙ СЛЕДУЮЩИЙ ХОД СДЕЛАЕТ ПУТИН. ТЕПЕРЬ ПРИХОДИТСЯ
Dialogue: 0,0:00:07.80,0:00:12.12,Caption,,0,0,0,,СЛЕДИТЬ ЕЩЁ И ЗА ТРАМПОМ, ПОТОМУ ЧТО ЭТОТ СОЮЗНИК СПОСОБЕН УТРОМ ПОЖАТЬ ТЕБЕ
Dialogue: 0,0:00:12.12,0:00:15.56,Caption,,0,0,0,,РУКУ, А К ОБЕДУ ДОГОВОРИТЬСЯ БЕЗ ТЕБЯ. ФРИДРИХ МЕРЦ
Dialogue: 0,0:00:15.56,0:00:18.76,Caption,,0,0,0,,УЖЕ ПРОСИТ ВАШИНГТОН ОБОЙТИСЬ БЕЗ ВНЕЗАПНЫХ РЕШЕНИЙ.
Dialogue: 0,0:00:18.98,0:00:23.08,Caption,,0,0,0,,ЕЩЁ НЕМНОГО, И АМЕРИКАНСКОМУ ПРЕЗИДЕНТУ ВЫДАДУТ СОПРОВОЖДАЮЩЕГО,
Dialogue: 0,0:00:23.32,0:00:25.96,Caption,,0,0,0,,КОТОРЫЙ БУДЕТ ЗАРАНЕЕ ПРЕДУПРЕЖДАТЬ ЕВРОПЕЙЦЕВ,
Dialogue: 0,0:00:26.20,0:00:28.36,Caption,,0,0,0,,КУДА ТОТ НАПРАВИЛСЯ И С КЕМ СОБИРАЕТСЯ
Dialogue: 0,0:00:28.36,0:00:31.80,Caption,,0,0,0,,РАЗГОВАРИВАТЬ. ВОПРОС ТОЛЬКО ОДИН. КАК ПОЛУЧИЛОСЬ,
Dialogue: 0,0:00:32.09,0:00:34.28,Caption,,0,0,0,,ЧТО ЕВРОПА НАЧАЛА ОПАСАТЬСЯ ЧЕЛОВЕКА,
Dialogue: 0,0:00:34.54,0:00:36.76,Caption,,0,0,0,,КОТОРЫЙ ВРОДЕ БЫ ДОЛЖЕН ПРИКРЫВАТЬ ЕЙ СПИНУ?
Dialogue: 0,0:00:37.39,0:00:39.24,Caption,,0,0,0,,ТРАМП ГОТОВИТСЯ К ПОЕЗДКЕ В КИТАЙ,
Dialogue: 0,0:00:39.48,0:00:42.12,Caption,,0,0,0,,ГДЕ ОЖИДАЕТСЯ ЕГО ОБЩЕНИЕ С ПУТИНЫМ. МЕРЦ ПРИ
Dialogue: 0,0:00:42.20,0:00:45.00,Caption,,0,0,0,,ЭТОМ ВСПОМИНАЕТ АНКОРИДЖ И ФАКТИЧЕСКИ УГОВАРИВАЕТ
Dialogue: 0,0:00:45.00,0:00:47.32,Caption,,0,0,0,,АМЕРИКАНЦЕВ НЕ УСТРАИВАТЬ ВТОРУЮ ВСТРЕЧУ,
Dialogue: 0,0:00:47.56,0:00:50.44,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ ЕВРОПЕЙСКИЕ СТОЛИЦЫ СНОВА УЗНАЮТ ОБО
Dialogue: 0,0:00:50.44,0:00:53.40,Caption,,0,0,0,,ВСЁМ ИЗ НОВОСТЕЙ. ЕСЛИ ВАМ НРАВИТСЯ ТАКОЙ РАЗБОР,
Dialogue: 0,0:00:53.64,0:00:56.52,Caption,,0,0,0,,ГДЕ ЗА ЗАЯВЛЕНИЯМИ ИЩУТ ИНТЕРЕСЫ И ПОСЛЕДСТВИЯ,
Dialogue: 0,0:00:56.75,0:00:59.40,Caption,,0,0,0,,ПОДПИШИТЕСЬ НА КАНАЛ. ЗДЕСЬ КАК РАЗ НАЧИНАЕТСЯ
Dialogue: 0,0:00:59.40,0:01:03.16,Caption,,0,0,0,,ИСТОРИЯ, В КОТОРОЙ СОЮЗНИКИ УЛЫБАЮТСЯ ДРУГ ДРУГУ РОВНО ДО
Dialogue: 0,0:01:03.24,0:01:06.84,Caption,,0,0,0,,ТОГО МОМЕНТА, ПОКА ОДИН ИЗ НИХ НЕ ЗАКРЫВАЕТ ДВЕРЬ ПЕРЕГОВОРНОЙ.
Dialogue: 0,0:01:07.29,0:01:09.40,Caption,,0,0,0,,САМО ОБРАЩЕНИЕ МЕРЦА ГОВОРИТ БОЛЬШЕ,
Dialogue: 0,0:01:09.56,0:01:16.17,Caption,,0,0,0,,ЧЕМ ДЛИННАЯ ДЕКЛАРАЦИЯ. НАДЁЖНОМУ ПАРТНЁРУ НЕ НАПОМИНАЮТ ЧЕРЕЗ ПРЕССУ,
Dialogue: 0,0:01:16.33,0:01:18.65,Caption,,0,0,0,,ЧТО ОН ДОЛЖЕН ПРОДОЛЖАТЬ ДЕЙСТВОВАТЬ ВМЕСТЕ С
Dialogue: 0,0:01:18.65,0:01:22.49,Caption,,0,0,0,,ЕВРОПОЙ И УКРАИНОЙ. ЕСЛИ ТАКОЕ НАПОМИНАНИЕ ПОНАДОБИЛОСЬ,
Dialogue: 0,0:01:22.81,0:01:26.01,Caption,,0,0,0,,ЗНАЧИТ, ВНУТРИ ЗАПАДНОЙ КОМАНДЫ УЖЕ НИКТО НЕ УВЕРЕН,
Dialogue: 0,0:01:26.25,0:01:28.65,Caption,,0,0,0,,КТО ТАМ КАПИТАН, КТО ЗАПАСНОЙ ИГРОК,
Dialogue: 0,0:01:28.81,0:01:31.29,Caption,,0,0,0,,А КТО ВООБЩЕ ЗАБРАЛ МЯЧ И УШЁЛ ДОГОВАРИВАТЬСЯ
Dialogue: 0,0:01:31.37,0:01:35.61,Caption,,0,0,0,,НА СОСЕДНЕЕ ПОЛЕ. ЕВРОПЕЙЦЕВ БЕСПОКОИТ НЕ КОЛИЧЕСТВО КРЕСЕЛ ВОЗЛЕ
Dialogue: 0,0:01:35.61,0:01:38.81,Caption,,0,0,0,,БУДУЩЕГО СТОЛА. НАСТОЯЩАЯ ПРОБЛЕМА В ДРУГОМ.
Dialogue: 0,0:01:39.05,0:01:41.29,Caption,,0,0,0,,АДМИНИСТРАЦИЯ ТРАМПА РАССМАТРИВАЕТ РАЗГОВОР С
Dialogue: 0,0:01:41.29,0:01:43.85,Caption,,0,0,0,,РОССИЕЙ КАК САМОСТОЯТЕЛЬНЫЙ ИНСТРУМЕНТ,
Dialogue: 0,0:01:44.01,0:01:48.09,Caption,,0,0,0,,А НЕ КАК НАГРАДУ, КОТОРУЮ МОСКВЕ КОГДА НИБУДЬ ВЫДАДУТ ПОСЛЕ ВЫПОЛНЕНИЯ
Dialogue: 0,0:01:48.09,0:01:51.05,Caption,,0,0,0,,ЕВРОПЕЙСКОГО СПИСКА ТРЕБОВАНИЙ. ПРЕЖНИЙ РАСЧЁТ БЫЛ
Dialogue: 0,0:01:51.05,0:01:53.93,Caption,,0,0,0,,ПОНЯТЕН. РОССИЮ ПРЕДПОЛАГАЛОСЬ ДОЛГО ЗАЖИМАТЬ
Dialogue: 0,0:01:53.93,0:01:58.09,Caption,,0,0,0,,САНКЦИЯМИ, ЛИШАТЬ РЕСУРСОВ, УСИЛИВАТЬ УКРАИНУ И ЖДАТЬ,
Dialogue: 0,0:01:58.25,0:02:01.53,Caption,,0,0,0,,ПОКА ДАВЛЕНИЕ ПРИНЕСЁТ НУЖНЫЙ РЕЗУЛЬТАТ. СОЕДИНЁННЫЕ
Dialogue: 0,0:02:01.61,0:02:03.77,Caption,,0,0,0,,ШТАТЫ ОБЕСПЕЧИВАЛИ ЭТОЙ СХЕМЕ ДЕНЬГИ,
Dialogue: 0,0:02:03.93,0:02:08.97,Caption,,0,0,0,,ВООРУЖЕНИЕ, РАЗВЕДКУ И ОПОРУ ВНУТРИ НАТО. ТЕПЕРЬ ВАШИНГТОН САМ
Dialogue: 0,0:02:08.97,0:02:11.69,Caption,,0,0,0,,ОТКРЫВАЕТ КАНАЛЫ С МОСКВОЙ. ГЛАВНАЯ СИЛА,
Dialogue: 0,0:02:11.93,0:02:14.57,Caption,,0,0,0,,КОТОРАЯ ДОЛЖНА БЫЛА ТОЛКАТЬ ВСЮ КОНСТРУКЦИЮ В ОДНОМ
Dialogue: 0,0:02:14.57,0:02:17.13,Caption,,0,0,0,,НАПРАВЛЕНИИ, ВДРУГ РЕШИЛА ПОГОВОРИТЬ С ТЕМ,
Dialogue: 0,0:02:17.29,0:02:22.33,Caption,,0,0,0,,ПРОТИВ КОГО ЕЁ СОБИРАЛИ. ВОТ ПОЧЕМУ МЕРЦ ПРОСИТ НЕ ПРЕПОДНОСИТЬ СЮРПРИЗОВ. ОН
Dialogue: 0,0:02:22.33,0:02:25.85,Caption,,0,0,0,,ПОНИМАЕТ, ЧТО ДЕЛО НЕ В ХАРАКТЕРЕ ТРАМПА. МЕНЯЕТСЯ САМА
Dialogue: 0,0:02:25.93,0:02:32.60,Caption,,0,0,0,,ЛОГИКА АМЕРИКАНСКОГО УЧАСТИЯ. МОСКВА МНОГО ЛЕТ ГОВОРИТ ОБ УСТРАНЕНИИ ПЕРВОПРИЧИН
Dialogue: 0,0:02:32.60,0:02:35.32,Caption,,0,0,0,,КОНФЛИКТА. ЗА ЭТОЙ ФОРМУЛОЙ СКРЫВАЕТСЯ ВОПРОС
Dialogue: 0,0:02:35.40,0:02:38.20,Caption,,0,0,0,,НАМНОГО ШИРЕ УКРАИНСКОЙ ПОВЕСТКИ. К ПЕРВОПРИЧИНАМ
Dialogue: 0,0:02:38.28,0:02:43.56,Caption,,0,0,0,,ЧАСТО ОТНОСЯТ ТЕРРИТОРИИ, СОСТОЯНИЕ УКРАИНСКОЙ АРМИИ И КИЕВСКУЮ ВЛАСТЬ. ОДНАКО
Dialogue: 0,0:02:43.56,0:02:46.20,Caption,,0,0,0,,ИСХОДНАЯ РОССИЙСКАЯ ПРЕТЕНЗИЯ ПОЯВИЛАСЬ РАНЬШЕ И
Dialogue: 0,0:02:46.20,0:02:51.40,Caption,,0,0,0,,КАСАЛАСЬ ПРОДВИЖЕНИЯ НАТО, РАЗМЕЩЕНИЯ ВОЕННОЙ ИНФРАСТРУКТУРЫ И ОТКАЗА ЗАПАДА
Dialogue: 0,0:02:51.40,0:02:54.28,Caption,,0,0,0,,ОБСУЖДАТЬ ПРЕДЕЛЫ РАСШИРЕНИЯ АЛЬЯНСА. УКРАИНА
Dialogue: 0,0:02:54.28,0:02:58.68,Caption,,0,0,0,,ОКАЗАЛАСЬ МЕСТОМ, ГДЕ ДАВНИЙ СПОР О БЕЗОПАСНОСТИ ПЕРЕШЁЛ ИЗ ЗАЯВЛЕНИЙ
Dialogue: 0,0:02:58.84,0:03:01.72,Caption,,0,0,0,,В ОТКРЫТУЮ СХВАТКУ. СНАЧАЛА МОСКВА ТРЕБОВАЛА
Dialogue: 0,0:03:01.72,0:03:04.68,Caption,,0,0,0,,РАЗГОВОРА О НАТО И ВОЕННЫХ ОБЪЕКТАХ ВОЗЛЕ РОССИЙСКИХ
Dialogue: 0,0:03:04.76,0:03:07.88,Caption,,0,0,0,,ГРАНИЦ. ЗАТЕМ ПРОТИВОСТОЯНИЕ СОСРЕДОТОЧИЛОСЬ НА
Dialogue: 0,0:03:07.88,0:03:11.40,Caption,,0,0,0,,УКРАИНЕ. УЖЕ ПОСЛЕ ЭТОГО ВОЗНИКЛИ НЫНЕШНИЕ ВОПРОСЫ О
Dialogue: 0,0:03:11.40,0:03:16.84,Caption,,0,0,0,,ТЕРРИТОРИЯХ, ВООРУЖЕНИЯХ, СОСТАВЕ УКРАИНСКИХ СИЛ И БУДУЩЕМ КИЕВА. ПОЭТОМУ
Dialogue: 0,0:03:16.84,0:03:19.72,Caption,,0,0,0,,СООБЩЕНИЕ УШАКОВА О БЕСЕДЕ ПУТИНА С УИТКОФФОМ И
Dialogue: 0,0:03:19.72,0:03:22.44,Caption,,0,0,0,,КУШНЕРОМ ЗАСЛУЖИВАЕТ БОЛЬШЕГО ВНИМАНИЯ,
Dialogue: 0,0:03:22.60,0:03:25.40,Caption,,0,0,0,,ЧЕМ ОЧЕРЕДНАЯ ПЕРЕПАЛКА ВОКРУГ ОТДЕЛЬНЫХ УСЛОВИЙ
Dialogue: 0,0:03:25.40,0:03:29.32,Caption,,0,0,0,,ПЕРЕМИРИЯ. НА ВСТРЕЧЕ ПОДНИМАЛИСЬ ЕВРОПЕЙСКАЯ БЕЗОПАСНОСТЬ,
Dialogue: 0,0:03:29.54,0:03:32.92,Caption,,0,0,0,,РАСШИРЕНИЕ НАТО И ПРИНЦИП НЕДЕЛИМОЙ БЕЗОПАСНОСТИ.
Dialogue: 0,0:03:33.32,0:03:36.20,Caption,,0,0,0,,РОССИЯ ВЫРАЗИЛА ГОТОВНОСТЬ ОБСУЖДАТЬ ПРЕДЛОЖЕНИЯ ПО
Dialogue: 0,0:03:36.20,0:03:39.48,Caption,,0,0,0,,ЭТОЙ ТЕМЕ ВМЕСТЕ С СОЕДИНЁННЫМИ ШТАТАМИ. МАСШТАБ
Dialogue: 0,0:03:39.48,0:03:41.48,Caption,,0,0,0,,РАЗГОВОРА СРАЗУ СТАНОВИТСЯ ДРУГИМ.
Dialogue: 0,0:03:43.75,0:03:48.63,Caption,,0,0,0,,ЛИНИЯ СОПРИКОСНОВЕНИЯ, ОБМЕН ПЛЕННЫМИ И ОГРАНИЧЕНИЯ УДАРОВ ПО ЭНЕРГЕТИКЕ
Dialogue: 0,0:03:48.63,0:03:51.59,Caption,,0,0,0,,ОСТАЮТСЯ ВАЖНЫМИ. НО ЕСЛИ МОСКВА И ВАШИНГТОН
Dialogue: 0,0:03:51.59,0:03:54.39,Caption,,0,0,0,,ДЕЙСТВИТЕЛЬНО ВЕРНУЛИСЬ К ОТНОШЕНИЯМ РОССИИ С НАТО,
Dialogue: 0,0:03:54.72,0:03:57.03,Caption,,0,0,0,,ЗНАЧИТ, ОНИ ДОБРАЛИСЬ ДО ТОГО УЗЛА,
Dialogue: 0,0:03:57.27,0:04:00.39,Caption,,0,0,0,,ИЗ КОТОРОГО ВЫРОС ВЕСЬ ПОСЛЕДУЮЩИЙ КЛУБОК. ДЛЯ
Dialogue: 0,0:04:00.39,0:04:02.71,Caption,,0,0,0,,ЕВРОПЕЙСКИХ СТОЛИЦ ЭТО КРАЙНЕ НЕПРИЯТНАЯ
Dialogue: 0,0:04:02.71,0:04:06.07,Caption,,0,0,0,,ПЕРСПЕКТИВА. УИТКОФФ И КУШНЕР ФАКТИЧЕСКИ ДОПУСКАЮТ,
Dialogue: 0,0:04:06.32,0:04:09.59,Caption,,0,0,0,,ЧТО УСТРОЙСТВО БЕЗОПАСНОСТИ НА КОНТИНЕНТЕ ТОЖЕ МОЖЕТ
Dialogue: 0,0:04:09.59,0:04:12.79,Caption,,0,0,0,,СТАТЬ ПРЕДМЕТОМ СДЕЛКИ. МОСКВА МНОГО ЛЕТ ДОБИВАЛАСЬ
Dialogue: 0,0:04:12.79,0:04:15.51,Caption,,0,0,0,,ИМЕННО ЭТОГО. ЕЙ НУЖЕН БЫЛ РАЗГОВОР НЕ ТОЛЬКО
Dialogue: 0,0:04:15.59,0:04:17.99,Caption,,0,0,0,,О ПОЛОЖЕНИИ УКРАИНЫ, НО И О ПРАВИЛАХ,
Dialogue: 0,0:04:18.18,0:04:20.71,Caption,,0,0,0,,ПО КОТОРЫМ ВОЕННАЯ ИНФРАСТРУКТУРА ПРИБЛИЖАЕТСЯ К
Dialogue: 0,0:04:20.71,0:04:24.47,Caption,,0,0,0,,ЧУЖИМ ГРАНИЦАМ. ЕВРОПА ПРЕДЛАГАЕТ СНАЧАЛА ОСТАНОВИТЬ ОГОНЬ,
Dialogue: 0,0:04:24.77,0:04:27.99,Caption,,0,0,0,,А ВСЕ КРУПНЫЕ ВОПРОСЫ ОТЛОЖИТЬ. НО ПОСЛЕ ПОДПИСАНИЯ
Dialogue: 0,0:04:27.99,0:04:30.79,Caption,,0,0,0,,СОГЛАШЕНИЯ СПОР О БАЗАХ, ВООРУЖЕНИЯХ,
Dialogue: 0,0:04:30.95,0:04:34.23,Caption,,0,0,0,,ИНОСТРАННЫХ КОНТИНГЕНТАХ И ВОЗМОЖНОМ РАСШИРЕНИИ НАТО
Dialogue: 0,0:04:34.23,0:04:37.11,Caption,,0,0,0,,ОСТАНЕТСЯ НА ПРЕЖНЕМ МЕСТЕ. ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ ОН
Dialogue: 0,0:04:37.11,0:04:39.67,Caption,,0,0,0,,СНОВА ВЫЛЕЗЕТ НАРУЖУ. ОТЛИЧНАЯ МОДЕЛЬ,
Dialogue: 0,0:04:39.92,0:04:42.31,Caption,,0,0,0,,ОСОБЕННО ДЛЯ ПРОИЗВОДИТЕЛЕЙ ТАБЛИЧЕК С ФАМИЛИЯМИ
Dialogue: 0,0:04:42.31,0:04:45.27,Caption,,0,0,0,,УЧАСТНИКОВ. КАЖДОМУ НОВОМУ САММИТУ ПОНАДОБИТСЯ
Dialogue: 0,0:04:45.27,0:04:47.27,Caption,,0,0,0,,СВЕЖИЙ КОМПЛЕКТ. КУШНЕР ГОВОРИТ,
Dialogue: 0,0:04:47.47,0:04:50.23,Caption,,0,0,0,,ЧТО НА ПУБЛИКЕ УЧАСТНИКИ СОХРАНЯЮТ МАКСИМАЛЬНО
Dialogue: 0,0:04:50.31,0:04:53.75,Caption,,0,0,0,,ЖЁСТКИЕ ПОЗИЦИИ, ТОГДА КАК В ЗАКРЫТОМ ПОМЕЩЕНИИ ПРИЗНАЮТ
Dialogue: 0,0:04:53.75,0:04:56.71,Caption,,0,0,0,,НЕОБХОДИМОСТЬ КОНКРЕТНЫХ УСТУПОК. ТАК ОБЫЧНО И
Dialogue: 0,0:04:56.71,0:04:58.23,Caption,,0,0,0,,ВЫГЛЯДЯТ СЕРЬЁЗНЫЕ ПЕРЕГОВОРЫ.
Dialogue: 0,0:05:00.50,0:05:03.46,Caption,,0,0,0,,ПЕРЕД КАМЕРАМИ КАЖДЫЙ ОБЯЗАН ИЗОБРАЖАТЬ НЕСГИБАЕМУЮ
Dialogue: 0,0:05:03.54,0:05:07.78,Caption,,0,0,0,,КОЛОННУ ПОБЕДА БЛИЗКА, УСЛОВИЯ ОБСУЖДЕНИЮ НЕ ПОДЛЕЖАТ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:05:08.03,0:05:10.98,Caption,,0,0,0,,ЕСЛИ ЕЩЁ ЭТОГО НЕ СДЕЛАЛИ. ДАЛЬШЕ УКРАИНСКАЯ ТЕМА
Dialogue: 0,0:05:10.98,0:05:13.70,Caption,,0,0,0,,СТАНОВИТСЯ ЧАСТЬЮ ГОРАЗДО БОЛЕЕ КРУПНОГО ТОРГА,
Dialogue: 0,0:05:14.02,0:05:16.10,Caption,,0,0,0,,ГДЕ ОДНИМ УЧАСТНИКАМ НУЖНЫ ГРАНИЦЫ,
Dialogue: 0,0:05:16.41,0:05:19.38,Caption,,0,0,0,,ДРУГИМ ГАРАНТИИ, ТРЕТЬИМ ОГРАНИЧЕНИЯ НАТО,
Dialogue: 0,0:05:19.57,0:05:22.18,Caption,,0,0,0,,А ЧЕТВЁРТЫМ ВОЗМОЖНОСТЬ ОБЪЯВИТЬ РЕЗУЛЬТАТ СВОЕЙ
Dialogue: 0,0:05:22.18,0:05:24.10,Caption,,0,0,0,,ПОБЕДОЙ. ЗЕЛЕНСКИЙ УТВЕРЖДАЕТ,
Dialogue: 0,0:05:24.34,0:05:27.14,Caption,,0,0,0,,ЧТО МОСКВА ОТВЕРГЛА ЭНЕРГЕТИЧЕСКОЕ ПЕРЕМИРИЕ.
Dialogue: 0,0:05:27.46,0:05:29.30,Caption,,0,0,0,,ОДНОВРЕМЕННО АМЕРИКАНЦЫ ВЫЯСНЯЮТ,
Dialogue: 0,0:05:29.62,0:05:32.58,Caption,,0,0,0,,КАКИЕ ТЕРРИТОРИАЛЬНЫЕ РЕШЕНИЯ ДОПУСТИМЫ ДЛЯ КИЕВА.
Dialogue: 0,0:05:32.96,0:05:35.46,Caption,,0,0,0,,НА СТОЛЕ ОСТАЮТСЯ ГАРАНТИИ БЕЗОПАСНОСТИ,
Dialogue: 0,0:05:35.68,0:05:41.22,Caption,,0,0,0,,СТАТУС НАТО И ОБМЕН ПЛЕННЫМИ. КУШНЕР СНОВА ГОВОРИТ О ПРАКТИЧЕСКИХ КОМПРОМИССАХ.
Dialogue: 0,0:05:41.54,0:05:43.62,Caption,,0,0,0,,ЭТО НЕ НЕСКОЛЬКО НЕЗАВИСИМЫХ СЮЖЕТОВ,
Dialogue: 0,0:05:43.91,0:05:47.22,Caption,,0,0,0,,А НАБОР УСЛОВИЙ ОДНОЙ СДЕЛКИ. ЭНЕРГЕТИКА МОЖЕТ
Dialogue: 0,0:05:47.22,0:05:50.02,Caption,,0,0,0,,ОБМЕНИВАТЬСЯ НА УСТУПКУ В ДРУГОЙ ЧАСТИ СОГЛАШЕНИЯ,
Dialogue: 0,0:05:50.26,0:05:52.26,Caption,,0,0,0,,ТЕРРИТОРИИ СВЯЗЫВАТЬСЯ С ГАРАНТИЯМИ,
Dialogue: 0,0:05:52.56,0:05:54.34,Caption,,0,0,0,,А ОГРАНИЧЕНИЯ ИНОСТРАННЫХ ВОЙСК,
Dialogue: 0,0:05:54.50,0:05:58.50,Caption,,0,0,0,,С ЧЛЕНСТВОМ В НАТО. САНКЦИИ СТАНОВЯТСЯ ИНСТРУМЕНТОМ ИСПОЛНЕНИЯ
Dialogue: 0,0:05:58.50,0:06:01.54,Caption,,0,0,0,,ДОГОВОРЁННОСТЕЙ. У КАЖДОГО УЧАСТНИКА СВОЙ СПИСОК
Dialogue: 0,0:06:01.54,0:06:04.66,Caption,,0,0,0,,ЖЕЛАНИЙ, И НИКТО НЕ СОБИРАЕТСЯ ОПЛАЧИВАТЬ ВЕСЬ ЗАКАЗ В
Dialogue: 0,0:06:04.74,0:06:07.78,Caption,,0,0,0,,ОДИНОЧКУ. ПОЭТОМУ ФРАЗА О БЫСТРОМ МИРЕ МАЛО ЧТО
Dialogue: 0,0:06:07.78,0:06:10.42,Caption,,0,0,0,,ОБЪЯСНЯЕТ. БЫСТРО МОЖНО ПОСТАВИТЬ ПОДПИСИ.
Dialogue: 0,0:06:12.70,0:06:15.18,Caption,,0,0,0,,ЗНАЧИТЕЛЬНО ТРУДНЕЕ СОСТАВИТЬ УСЛОВИЯ ТАК,
Dialogue: 0,0:06:15.38,0:06:18.14,Caption,,0,0,0,,ЧТОБЫ СПУСТЯ НЕСКОЛЬКО МЕСЯЦЕВ КАЖДАЯ СТОЛИЦА НЕ
Dialogue: 0,0:06:18.14,0:06:22.22,Caption,,0,0,0,,ЗАЯВИЛА, ЧТО ДОГОВОР ПОНИМАЛСЯ СОВСЕМ ИНАЧЕ. В МЕЖДУНАРОДНЫХ
Dialogue: 0,0:06:22.22,0:06:25.02,Caption,,0,0,0,,ДЕЛАХ МЕЛКИЙ ШРИФТ ИНОГДА СТРЕЛЯЕТ ГРОМЧЕ
Dialogue: 0,0:06:25.02,0:06:29.18,Caption,,0,0,0,,АРТИЛЛЕРИИ. СЛЕДУЮЩИЙ КРУПНЫЙ УЗЕЛ НАХОДИТСЯ В КИТАЕ. В
Dialogue: 0,0:06:29.18,0:06:31.42,Caption,,0,0,0,,ШЭНЬЧЖЭНЕ ОЖИДАЕТСЯ ВСТРЕЧА ТРАМПА,
Dialogue: 0,0:06:31.59,0:06:34.94,Caption,,0,0,0,,ПУТИНА И СИ ЦЗИНЬПИНА. ОДИН СЦЕНАРИЙ УЖЕ ОКРЕСТИЛИ
Dialogue: 0,0:06:34.94,0:06:37.98,Caption,,0,0,0,,НОВОЙ ЯЛТОЙ ТРИ ДЕРЖАВЫ РЕШАТ КЛЮЧЕВЫЕ ВОПРОСЫ,
Dialogue: 0,0:06:38.15,0:06:43.34,Caption,,0,0,0,,А ОСТАЛЬНЫМ ПОЗЖЕ СООБЩАТ, ЧТО ПОЛУЧИЛОСЬ. СУЩЕСТВУЕТ И ИНОЙ ВАРИАНТ ПОВЕСТКИ.
Dialogue: 0,0:06:43.58,0:06:45.82,Caption,,0,0,0,,УКРАИНСКИЙ КОНФЛИКТ МОГУТ ОСТАВИТЬ ОТДЕЛЬНОМУ
Dialogue: 0,0:06:45.82,0:06:49.90,Caption,,0,0,0,,КАНАЛУ, А ЛИДЕРЫ СОСРЕДОТОЧАТСЯ НА ЯДЕРНОМ ОРУЖИИ И ИРАНЕ.
Dialogue: 0,0:06:50.46,0:06:53.18,Caption,,0,0,0,,ЭТО НЕ УМЕНЬШАЕТ ЗНАЧЕНИЯ ВСТРЕЧИ КРУПНЕЙШИЕ ДЕРЖАВЫ
Dialogue: 0,0:06:53.18,0:06:56.38,Caption,,0,0,0,,РАССМАТРИВАЮТ БЕЗОПАСНОСТЬ МИРА ШИРЕ ЕВРОПЕЙСКОГО
Dialogue: 0,0:06:56.38,0:06:59.10,Caption,,0,0,0,,КОНФЛИКТА. УКРАИНА ОСТАЁТСЯ ВАЖНЕЙШЕЙ ТЕМОЙ,
Dialogue: 0,0:06:59.27,0:07:01.34,Caption,,0,0,0,,НО РЯДОМ СТОЯТ ЯДЕРНОЕ СДЕРЖИВАНИЕ,
Dialogue: 0,0:07:01.50,0:07:05.90,Caption,,0,0,0,,ТАЙВАНЬ, ИРАН, ОТНОШЕНИЯ РОССИИ С НАТО И НАПРЯЖЕНИЕ НА БЛИЖНЕМ
Dialogue: 0,0:07:05.90,0:07:08.94,Caption,,0,0,0,,ВОСТОКЕ. ЭТИ ВОПРОСЫ НЕЛЬЗЯ БЕСКОНЕЧНО СКЛАДЫВАТЬ В
Dialogue: 0,0:07:09.02,0:07:11.98,Caption,,0,0,0,,ОДНУ УКРАИНСКУЮ ПАПКУ. ПАПКА УЖЕ НЕ ЗАКРЫВАЕТСЯ,
Dialogue: 0,0:07:12.30,0:07:14.22,Caption,,0,0,0,,А ЧИНОВНИКИ ВСЁ ПРОДОЛЖАЮТ ДЕЛАТЬ ВИД,
Dialogue: 0,0:07:14.46,0:07:16.86,Caption,,0,0,0,,ЧТО ДОСТАТОЧНО ПОСИЛЬНЕЕ НАДАВИТЬ НА КРЫШКУ.
Dialogue: 0,0:07:17.23,0:07:19.50,Caption,,0,0,0,,СЦЕНАРИЙ ЯЛТЫ ДВА НОЛЬ НЕ ОЗНАЧАЕТ,
Dialogue: 0,0:07:19.66,0:07:22.62,Caption,,0,0,0,,ЧТО ТРИ ЛИДЕРА ПОДЕЛЯТ СТРАНЫ ПО САЛФЕТКАМ. МИР
Dialogue: 0,0:07:22.62,0:07:25.34,Caption,,0,0,0,,СЛИШКОМ СЛОЖЕН ДЛЯ ТАКОГО ЗАСТОЛЬНОГО ЗЕМЛЕМЕРИЯ.
Dialogue: 0,0:07:27.62,0:07:30.02,Caption,,0,0,0,,НО РЕГУЛЯРНЫЕ ДОГОВОРЁННОСТИ ВАШИНГТОНА,
Dialogue: 0,0:07:30.11,0:07:33.46,Caption,,0,0,0,,МОСКВЫ И ПЕКИНА ПО СТРАТЕГИЧЕСКИМ ВООРУЖЕНИЯМ И
Dialogue: 0,0:07:33.46,0:07:36.02,Caption,,0,0,0,,РЕГИОНАЛЬНЫМ КОНФЛИКТАМ СОЗДАДУТ КРУГ,
Dialogue: 0,0:07:36.18,0:07:39.46,Caption,,0,0,0,,ВНУТРИ КОТОРОГО ПРИНИМАЮТСЯ ГЛАВНЫЕ РЕШЕНИЯ. И ТОГДА
Dialogue: 0,0:07:39.54,0:07:42.98,Caption,,0,0,0,,У ЕВРОПЫ ПОЯВЛЯЕТСЯ БОЛЕЗНЕННЫЙ ВОПРОС О СОБСТВЕННОЙ
Dialogue: 0,0:07:42.98,0:07:45.38,Caption,,0,0,0,,РОЛИ. ОДНО ДЕЛО ДАВИТЬ НА РОССИЮ,
Dialogue: 0,0:07:45.54,0:07:48.50,Caption,,0,0,0,,КОГДА ЗА ПЛЕЧОМ СТОЯТ АМЕРИКАНСКИЕ РЕСУРСЫ. СОВСЕМ
Dialogue: 0,0:07:48.50,0:07:52.02,Caption,,0,0,0,,ДРУГОЕ, КОГДА СОЕДИНЁННЫЕ ШТАТЫ САМИ ОБСУЖДАЮТ С МОСКВОЙ И
Dialogue: 0,0:07:52.02,0:07:54.34,Caption,,0,0,0,,ПЕКИНОМ ДОПУСТИМЫЕ ПРЕДЕЛЫ СИЛЫ.
Dialogue: 0,0:07:54.92,0:07:59.54,Caption,,0,0,0,,МЕРЦ НЕРВНИЧАЕТ НЕ ПОТОМУ, ЧТО ЕМУ НЕ НРАВИТСЯ ОФОРМЛЕНИЕ СТОЛА. ОН БОИТСЯ
Dialogue: 0,0:07:59.62,0:08:02.34,Caption,,0,0,0,,ОБНАРУЖИТЬ, ЧТО МЕНЮ УЖЕ СОГЛАСОВАЛИ БЕЗ НЕГО.
Dialogue: 0,0:08:02.94,0:08:04.66,Caption,,0,0,0,,КИТАЙ ТЕМ ВРЕМЕНЕМ ДЕМОНСТРИРУЕТ,
Dialogue: 0,0:08:04.90,0:08:07.14,Caption,,0,0,0,,С КАКИМИ АРГУМЕНТАМИ ПРИХОДИТ К РАЗГОВОРУ О
Dialogue: 0,0:08:07.14,0:08:10.18,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ТАЙВАНЬ СООБЩАЕТ БОЛЕЕ ЧЕМ О СОТНЕ
Dialogue: 0,0:08:10.18,0:08:13.30,Caption,,0,0,0,,КИТАЙСКИХ ВОЕННЫХ КОРАБЛЕЙ И СУДОВ БЕРЕГОВОЙ ОХРАНЫ
Dialogue: 0,0:08:13.38,0:08:16.42,Caption,,0,0,0,,В ЗАПАДНОЙ ЧАСТИ ТИХОГО ОКЕАНА. АВИАНОСНАЯ ГРУППА
Dialogue: 0,0:08:16.42,0:08:20.98,Caption,,0,0,0,,ЛЯОНИН УЧАСТВУЕТ В УЧЕНИЯХ, ФУЦЗЯНЬ ПОЯВИЛСЯ В ЮЖНО КИТАЙСКОМ МОРЕ,
Dialogue: 0,0:08:21.18,0:08:23.86,Caption,,0,0,0,,КИТАЙСКАЯ АВИАЦИЯ СОВЕРШАЕТ ДЕСЯТКИ ВЫЛЕТОВ ЗА
Dialogue: 0,0:08:23.86,0:08:27.22,Caption,,0,0,0,,СУТКИ. ЭТО ПОКАЗЫВАЕТ ВЕС КИТАЙСКОЙ ПОЗИЦИИ. ДЛЯ
Dialogue: 0,0:08:27.22,0:08:30.42,Caption,,0,0,0,,ПЕКИНА ТАЙВАНЬ НЕ ТЕМА ДЛЯ ТЕЛЕВИЗИОННОЙ ДИСКУССИИ И
Dialogue: 0,0:08:30.50,0:08:33.14,Caption,,0,0,0,,НЕ УДОБНЫЙ ПУНКТ ПРЕДВЫБОРНОЙ ПРОГРАММЫ. ЗА
Dialogue: 0,0:08:33.14,0:08:38.26,Caption,,0,0,0,,ЗАЯВЛЕНИЯМИ СТОЯТ ФЛОТ, АВИАЦИЯ И ГОТОВАЯ ИНФРАСТРУКТУРА. КОГДА КИТАЙ
Dialogue: 0,0:08:38.26,0:08:40.10,Caption,,0,0,0,,ПРЕДЛАГАЕТ УЧИТЫВАТЬ ЕГО ИНТЕРЕСЫ,
Dialogue: 0,0:08:40.34,0:08:43.30,Caption,,0,0,0,,РЯДОМ С ПРЕДЛОЖЕНИЕМ УЖЕ ПРИПАРКОВАН АВИАНОСЕЦ.
Dialogue: 0,0:08:45.57,0:08:48.37,Caption,,0,0,0,,ОЧЕНЬ УБЕДИТЕЛЬНАЯ ФОРМА СОПРОВОДИТЕЛЬНОГО ПИСЬМА.
Dialogue: 0,0:08:48.99,0:08:51.81,Caption,,0,0,0,,ОТСЮДА ВОЗНИКАЕТ НЕУДОБНЫЙ СПОР О ЕДИНЫХ ПРАВИЛАХ.
Dialogue: 0,0:08:52.29,0:08:54.45,Caption,,0,0,0,,ВАШИНГТОН ОПРЕДЕЛЯЕТ УГРОЗЫ АМЕРИКАНСКОЙ
Dialogue: 0,0:08:54.45,0:08:57.41,Caption,,0,0,0,,БЕЗОПАСНОСТИ ОДНИМ СПОСОБОМ. ПЕКИН ДЕЛАЕТ ТО ЖЕ
Dialogue: 0,0:08:57.41,0:09:00.21,Caption,,0,0,0,,САМОЕ СО СВОЕЙ СТОРОНЫ. МОСКВА ИСХОДИТ ИЗ
Dialogue: 0,0:09:00.21,0:09:03.49,Caption,,0,0,0,,СОБСТВЕННОГО ПОНИМАНИЯ РИСКА. ОБЩЕГО МЕРИЛА ПРИ ЭТОМ
Dialogue: 0,0:09:03.57,0:09:06.37,Caption,,0,0,0,,НЕТ, ЗАТО У КАЖДОГО В КАРМАНЕ ЛЕЖИТ ЛИНЕЙКА,
Dialogue: 0,0:09:06.53,0:09:09.33,Caption,,0,0,0,,НА КОТОРОЙ ЕГО ИНТЕРЕСЫ ПОЧЕМУ ТО ВСЕГДА ДЛИННЕЕ
Dialogue: 0,0:09:09.33,0:09:12.13,Caption,,0,0,0,,ЧУЖИХ. СЛЕДОМ ПОЯВЛЯЕТСЯ ТЕМА МЕЖДУНАРОДНОГО
Dialogue: 0,0:09:12.13,0:09:15.25,Caption,,0,0,0,,УГОЛОВНОГО СУДА. ОБСУЖДАЮТСЯ ВОЗМОЖНЫЕ ИЗМЕНЕНИЯ
Dialogue: 0,0:09:15.25,0:09:18.93,Caption,,0,0,0,,ПРАВИЛ, КАСАЮЩИХСЯ ЮРИСДИКЦИИ СУДА В ОТНОШЕНИИ РУКОВОДИТЕЛЕЙ
Dialogue: 0,0:09:18.93,0:09:21.97,Caption,,0,0,0,,ГОСУДАРСТВ. В ЭТОЙ ИСТОРИИ УПОМИНАЮТСЯ СОЕДИНЁННЫЕ
Dialogue: 0,0:09:21.97,0:09:24.93,Caption,,0,0,0,,ШТАТЫ И НИДЕРЛАНДЫ. РЕЧЬ ИДЁТ НЕ ПРОСТО ОБ
Dialogue: 0,0:09:24.93,0:09:30.29,Caption,,0,0,0,,ОДНОМ ЮРИДИЧЕСКОМ СПОРЕ, А О ПРОДОЛЖЕНИИ КУРСА ТРАМПА НА ПЕРЕДЕЛКУ НЕУДОБНЫХ
Dialogue: 0,0:09:30.29,0:09:33.57,Caption,,0,0,0,,МЕХАНИЗМОВ. ВАШИНГТОН УЖЕ ПЕРЕСМАТРИВАЛ ОТНОШЕНИЕ К
Dialogue: 0,0:09:33.57,0:09:36.45,Caption,,0,0,0,,МЕЖДУНАРОДНЫМ ОРГАНИЗАЦИЯМ И СОГЛАШЕНИЯМ. ТЕПЕРЬ
Dialogue: 0,0:09:36.53,0:09:39.17,Caption,,0,0,0,,ВНИМАНИЕ ДОШЛО ДО ГААГИ. ТРАМП ДЕЙСТВУЕТ
Dialogue: 0,0:09:39.17,0:09:42.13,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНО. ЕСЛИ ПРАВИЛО МЕШАЕТ АМЕРИКАНСКИМ
Dialogue: 0,0:09:42.13,0:09:45.57,Caption,,0,0,0,,ИНТЕРЕСАМ, ОН НЕ ПЫТАЕТСЯ ПОЛЮБИТЬ ЕГО ЧЕРЕЗ СИЛУ. ОН
Dialogue: 0,0:09:45.57,0:09:50.29,Caption,,0,0,0,,БЕРЁТ ОТВЁРТКУ И ВЫЯСНЯЕТ, КАКАЯ ДЕТАЛЬ НЕ ДАЁТ МЕХАНИЗМУ РАБОТАТЬ В НУЖНУЮ
Dialogue: 0,0:09:50.29,0:09:53.09,Caption,,0,0,0,,СТОРОНУ. ГЛУБИНА ИЗМЕНЕНИЙ СТАНЕТ ПОНЯТНА ПО
Dialogue: 0,0:09:53.17,0:09:57.17,Caption,,0,0,0,,РЕШЕНИЯМ, НО НАПРАВЛЕНИЕ ВИДНО УЖЕ СЕЙЧАС. СОЕДИНЁННЫЕ ШТАТЫ
Dialogue: 0,0:09:57.17,0:09:59.65,Caption,,0,0,0,,НЕ ПРОСТО СТРЕМЯТСЯ ВЫИГРАТЬ КОНКРЕТНЫЙ СПОР.
Dialogue: 0,0:10:01.93,0:10:06.73,Caption,,0,0,0,,ОНИ ПЕРЕПИСЫВАЮТ ПОРЯДОК ТАМ, ГДЕ ПРЕЖНИЕ ОГРАНИЧЕНИЯ НЕ УСТРАИВАЮТ АМЕРИКАНСКУЮ
Dialogue: 0,0:10:06.73,0:10:09.61,Caption,,0,0,0,,ВЛАСТЬ. ОСОБЕННО НАГЛЯДНО ЭТО ПРОЯВЛЯЕТСЯ ВОКРУГ
Dialogue: 0,0:10:09.69,0:10:13.05,Caption,,0,0,0,,ИРАНА. ПОСТУПАЮТ СООБЩЕНИЯ ОБ УСИЛЕНИИ АМЕРИКАНСКОЙ
Dialogue: 0,0:10:13.05,0:10:14.97,Caption,,0,0,0,,АВИАЦИОННОЙ ИНФРАСТРУКТУРЫ В РЕГИОНЕ.
Dialogue: 0,0:10:15.53,0:10:18.49,Caption,,0,0,0,,УПОМИНАЮТСЯ МНОГОЧИСЛЕННЫЕ САМОЛЁТЫ ЗАПРАВЩИКИ И
Dialogue: 0,0:10:18.49,0:10:21.53,Caption,,0,0,0,,РАЗВЕДЫВАТЕЛЬНЫЕ МАШИНЫ. ЭТО ЕЩЁ НЕ ПРИКАЗ О НАЧАЛЕ
Dialogue: 0,0:10:21.53,0:10:25.29,Caption,,0,0,0,,ОПЕРАЦИИ, НО СЕРЬЁЗНУЮ КАМПАНИЮ НЕ ГОТОВЯТ ЗА ОДИН ДЕНЬ.
Dialogue: 0,0:10:25.65,0:10:30.49,Caption,,0,0,0,,ВОЗМОЖНОСТИ СОЗДАЮТ ЗАРАНЕЕ, ЧТОБЫ НУЖНАЯ КНОПКА В ПОДХОДЯЩИЙ МОМЕНТ ОКАЗАЛАСЬ
Dialogue: 0,0:10:30.49,0:10:33.45,Caption,,0,0,0,,ПОДКЛЮЧЕНА. ПОСЛЕ ПРЕЖНИХ АМЕРИКАНСКИХ И ИЗРАИЛЬСКИХ
Dialogue: 0,0:10:33.45,0:10:36.65,Caption,,0,0,0,,УДАРОВ ЗВУЧАЛИ ЗАЯВЛЕНИЯ О РАЗРУШЕНИИ ЗНАЧИТЕЛЬНОЙ
Dialogue: 0,0:10:36.65,0:10:40.09,Caption,,0,0,0,,ЧАСТИ ИРАНСКОЙ ВОЕННОЙ ПРОМЫШЛЕННОСТИ. ОДНАКО ИРАН,
Dialogue: 0,0:10:40.33,0:10:44.33,Caption,,0,0,0,,ПО ИМЕЮЩЕЙСЯ ОЦЕНКЕ, ПРОДОЛЖАЕТ ПРОИЗВОДИТЬ ПРИМЕРНО ПЯТЬДЕСЯТ
Dialogue: 0,0:10:44.33,0:10:47.53,Caption,,0,0,0,,БАЛЛИСТИЧЕСКИХ РАКЕТ ЕЖЕМЕСЯЧНО. ЭТО ПОЧТИ ВДВОЕ
Dialogue: 0,0:10:47.53,0:10:51.77,Caption,,0,0,0,,МЕНЬШЕ ПРЕЖНЕГО ТЕМПА, НО СОВСЕМ НЕ ПОХОЖЕ НА ИСЧЕЗНУВШЕЕ ПРОИЗВОДСТВО.
Dialogue: 0,0:10:52.06,0:10:55.45,Caption,,0,0,0,,СЛЕДОВАТЕЛЬНО, КОЛИЧЕСТВО ПОРАЖЁННЫХ ОБЪЕКТОВ САМО ПО СЕБЕ НЕ
Dialogue: 0,0:10:55.45,0:10:58.09,Caption,,0,0,0,,ОТВЕЧАЕТ НА ГЛАВНЫЙ ВОПРОС. ДОСТИГНУТА ЛИ
Dialogue: 0,0:10:58.09,0:11:02.33,Caption,,0,0,0,,СТРАТЕГИЧЕСКАЯ ЦЕЛЬ? ЕСЛИ ИРАН ПО ПРЕЖНЕМУ ВЫПУСКАЕТ РАКЕТЫ,
Dialogue: 0,0:11:02.57,0:11:05.61,Caption,,0,0,0,,СПОСОБЕН УГРОЖАТЬ АМЕРИКАНСКИМ БАЗАМ И СОХРАНЯЕТ
Dialogue: 0,0:11:05.69,0:11:09.69,Caption,,0,0,0,,ВОЗМОЖНОСТЬ ОТВЕТИТЬ, БОДРЫЙ ПРОЦЕНТ В ОТЧЁТЕ МАЛО ЧТО РЕШАЕТ.
Dialogue: 0,0:11:09.92,0:11:12.65,Caption,,0,0,0,,ПРОИЗВОДСТВЕННУЮ СИСТЕМУ ПРИХОДИТСЯ ЛОМАТЬ ДОЛГО И
Dialogue: 0,0:11:12.65,0:11:16.17,Caption,,0,0,0,,ДОРОГО. НА ЭТОМ ФОНЕ КАТАР ПРЕДЛАГАЕТ ИРАНУ ЦЕЛЫЙ
Dialogue: 0,0:11:16.17,0:11:21.25,Caption,,0,0,0,,ПАКЕТ УСЛОВИЙ. ОБСУЖДАЮТСЯ ОБОГАЩЕНИЕ УРАНА,
Dialogue: 0,0:11:21.47,0:11:26.13,Caption,,0,0,0,,МЕЖДУНАРОДНЫЕ ИНСПЕКЦИИ, СНЯТИЕ МОРСКОЙ БЛОКАДЫ И РАЗМОРАЖИВАНИЕ ЧАСТИ
Dialogue: 0,0:11:26.13,0:11:29.57,Caption,,0,0,0,,ИРАНСКИХ АКТИВОВ. РЯДОМ НАХОДЯТСЯ ОРМУЗСКИЙ ПРОЛИВ,
Dialogue: 0,0:11:29.74,0:11:32.37,Caption,,0,0,0,,ОТНОШЕНИЯ САУДОВСКОЙ АРАВИИ С ХУСИТАМИ И
Dialogue: 0,0:11:32.37,0:11:34.13,Caption,,0,0,0,,БЕЗОПАСНОСТЬ НЕФТЯНЫХ МАРШРУТОВ.
Dialogue: 0,0:11:35.00,0:11:37.65,Caption,,0,0,0,,ЯДЕРНАЯ ПРОБЛЕМА ЗДЕСЬ НЕ СУЩЕСТВУЕТ ОТДЕЛЬНО ОТ
Dialogue: 0,0:11:37.65,0:11:40.29,Caption,,0,0,0,,ВСЕГО ОСТАЛЬНОГО. ОНА СВЯЗАНА С ДЕНЬГАМИ,
Dialogue: 0,0:11:40.42,0:11:44.77,Caption,,0,0,0,,НЕФТЬЮ, СОЮЗНИКАМИ И КОНТРОЛЕМ НАД РЕГИОНОМ. НЕЛЬЗЯ ВЫНУТЬ
Dialogue: 0,0:11:44.77,0:11:46.93,Caption,,0,0,0,,АТОМНУЮ ПРОГРАММУ ИЗ ЭТОЙ КОНСТРУКЦИИ,
Dialogue: 0,0:11:47.08,0:11:49.57,Caption,,0,0,0,,ДОГОВОРИТЬСЯ ПО НЕЙ ЗА ЧАС И ПОЛОЖИТЬ ОБРАТНО.
Dialogue: 0,0:11:49.81,0:11:54.05,Caption,,0,0,0,,ЭТО НЕ БАТАРЕЙКА В ПУЛЬТЕ, ХОТЯ НЕКОТОРЫЕ ПЕРЕГОВОРЩИКИ ЯВНО ХОТЕЛИ БЫ ИМЕННО
Dialogue: 0,0:11:54.05,0:11:57.17,Caption,,0,0,0,,ТАКУЮ ИНСТРУКЦИЮ. ИРАН ПРЕДУПРЕЖДАЕТ ЕВРОПЕЙСКИЕ
Dialogue: 0,0:11:57.17,0:11:59.65,Caption,,0,0,0,,ГОСУДАРСТВА ЕСЛИ ИХ ТЕРРИТОРИЯ БУДЕТ ИСПОЛЬЗОВАНА
Dialogue: 0,0:11:59.73,0:12:03.89,Caption,,0,0,0,,ДЛЯ АМЕРИКАНСКИХ АТАК, ВОЕННЫЕ БАЗЫ США В ЕВРОПЕ МОГУТ ПОПАСТЬ ПОД
Dialogue: 0,0:12:03.89,0:12:07.17,Caption,,0,0,0,,УДАР. ДЛЯ ЕВРОПЕЙЦЕВ ПОЛУЧАЕТСЯ ОСОБЕННО ИЗЯЩНОЕ
Dialogue: 0,0:12:07.17,0:12:11.81,Caption,,0,0,0,,ПОЛОЖЕНИЕ. ОНИ ПЕРЕЖИВАЮТ, ЧТО ТРАМП ДОГОВОРИТСЯ С РОССИЕЙ ЗА ИХ СПИНОЙ,
Dialogue: 0,0:12:12.21,0:12:14.85,Caption,,0,0,0,,НО ВПОЛНЕ МОГУТ ПОЛУЧИТЬ ПОСЛЕДСТВИЯ АМЕРИКАНСКОГО
Dialogue: 0,0:12:14.85,0:12:17.25,Caption,,0,0,0,,СТОЛКНОВЕНИЯ С ИРАНОМ ПРЯМО У СЕБЯ ДОМА.
Dialogue: 0,0:12:17.89,0:12:21.81,Caption,,0,0,0,,ВАШИНГТОН ПРИНИМАЕТ РЕШЕНИЕ, АМЕРИКАНСКИЕ СИЛЫ НАЧИНАЮТ ДЕЙСТВОВАТЬ,
Dialogue: 0,0:12:22.13,0:12:25.25,Caption,,0,0,0,,А РИСК ПРИЛЕТАЕТ ЕВРОПЕЙСКИМ СОЮЗНИКАМ. ЕВРОПА
Dialogue: 0,0:12:25.25,0:12:27.01,Caption,,0,0,0,,ПРОСИТ УЧАСТВОВАТЬ В ОБСУЖДЕНИИ,
Dialogue: 0,0:12:27.23,0:12:30.05,Caption,,0,0,0,,НО ГЕОГРАФИЯ УЖЕ УЧАСТВУЕТ БЕЗ ВСЯКОГО ПРИГЛАШЕНИЯ.
Dialogue: 0,0:12:30.39,0:12:32.53,Caption,,0,0,0,,ОЧЕНЬ УДОБНОЕ РАСПРЕДЕЛЕНИЕ ОБЯЗАННОСТЕЙ.
Dialogue: 0,0:12:34.80,0:12:38.00,Caption,,0,0,0,,ОДИН ВЫБИРАЕТ КОНФЛИКТ, ОСТАЛЬНЫЕ ПРЕДОСТАВЛЯЮТ АДРЕСА.
Dialogue: 0,0:12:38.64,0:12:41.04,Caption,,0,0,0,,ЗАТЕМ В ЭТОЙ ЦЕПОЧКЕ ПОЯВЛЯЕТСЯ КУБА.
Dialogue: 0,0:12:41.62,0:12:44.08,Caption,,0,0,0,,ВЛАСТИ СТРАНЫ ПРОВОДЯТ РЕГУЛЯРНЫЕ ОБОРОННЫЕ
Dialogue: 0,0:12:44.08,0:12:46.64,Caption,,0,0,0,,ТРЕНИРОВКИ И ПРИВЛЕКАЮТ К ПОДГОТОВКЕ ГРАЖДАНСКОЕ
Dialogue: 0,0:12:46.64,0:12:50.88,Caption,,0,0,0,,НАСЕЛЕНИЕ. ГАВАНА СЧИТАЕТ АМЕРИКАНСКУЮ УГРОЗУ РЕАЛЬНОЙ И ВЕДЁТ
Dialogue: 0,0:12:50.96,0:12:55.76,Caption,,0,0,0,,СЕБЯ СООТВЕТСТВЕННО. ПОСЛЕ СОБЫТИЙ В ВЕНЕСУЭЛЕ КУБА ЛИШИЛАСЬ ВАЖНОЙ ОПОРЫ
Dialogue: 0,0:12:55.78,0:12:57.52,Caption,,0,0,0,,НЕФТЯНЫЕ ПОСТАВКИ СОКРАТИЛИСЬ,
Dialogue: 0,0:12:57.78,0:13:01.04,Caption,,0,0,0,,ЭНЕРГЕТИЧЕСКИЕ ТРУДНОСТИ УСИЛИЛИСЬ. ТРАМП ПРИ ЭТОМ
Dialogue: 0,0:13:01.04,0:13:03.76,Caption,,0,0,0,,ЗАЯВЛЯЕТ О ЖЕЛАНИИ РЕШИТЬ КУБИНСКИЙ ВОПРОС ДО
Dialogue: 0,0:13:03.76,0:13:06.80,Caption,,0,0,0,,ОКОНЧАНИЯ СВОЕГО ПРЕЗИДЕНТСКОГО СРОКА И НЕ ИСКЛЮЧАЕТ
Dialogue: 0,0:13:06.80,0:13:10.16,Caption,,0,0,0,,ПРИМЕНЕНИЕ СИЛЫ. РЯДОМ НАХОДИТСЯ МАРКО РУБИО,
Dialogue: 0,0:13:10.48,0:13:12.88,Caption,,0,0,0,,ДЛЯ КОТОРОГО КУБА ПРЕДСТАВЛЯЕТ НЕ ТОЛЬКО ВНЕШНЮЮ
Dialogue: 0,0:13:12.88,0:13:16.24,Caption,,0,0,0,,ТЕМУ, НО И ЛИЧНУЮ ЧАСТЬ ВНУТРЕННЕЙ АМЕРИКАНСКОЙ ПОЛИТИКИ.
Dialogue: 0,0:13:16.47,0:13:20.08,Caption,,0,0,0,,ЗДЕСЬ ВСЕ ЛИНИИ СХОДЯТСЯ. СОЕДИНЁННЫЕ ШТАТЫ СЧИТАЮТ
Dialogue: 0,0:13:20.08,0:13:23.12,Caption,,0,0,0,,ЕСТЕСТВЕННЫМ ЗАЩИЩАТЬ СОБСТВЕННУЮ БЕЗОПАСНОСТЬ ТЕМИ
Dialogue: 0,0:13:23.12,0:13:27.28,Caption,,0,0,0,,СРЕДСТВАМИ, КОТОРЫЕ СОЧТУТ НЕОБХОДИМЫМИ. ЕСЛИ УГРОЗОЙ ОБЪЯВЛЕН
Dialogue: 0,0:13:27.35,0:13:30.88,Caption,,0,0,0,,ИРАН, МОЖНО НАРАЩИВАТЬ АВИАЦИЮ И ТРЕБОВАТЬ ИЗМЕНЕНИЯ
Dialogue: 0,0:13:30.88,0:13:34.08,Caption,,0,0,0,,ЯДЕРНОЙ ПРОГРАММЫ. ЕСЛИ ПРОБЛЕМОЙ НАЗВАНА КУБА,
Dialogue: 0,0:13:34.30,0:13:37.28,Caption,,0,0,0,,ДОПУСТИМЫ ЭКОНОМИЧЕСКОЕ ДАВЛЕНИЕ И РАЗГОВОРЫ О СИЛЕ.
Dialogue: 0,0:13:37.65,0:13:40.56,Caption,,0,0,0,,С АМЕРИКАНСКОЙ ТОЧКИ ЗРЕНИЯ ЭТА ЛОГИКА ПОНЯТНА. НО
Dialogue: 0,0:13:40.56,0:13:43.44,Caption,,0,0,0,,ОНА НЕИЗБЕЖНО ПОРОЖДАЕТ ВОПРОС О ПРАВАХ ДРУГИХ
Dialogue: 0,0:13:43.44,0:13:46.56,Caption,,0,0,0,,ДЕРЖАВ. КИТАЙ ДЕСЯТИЛЕТИЯМИ НАЗЫВАЕТ ТАЙВАНЬ
Dialogue: 0,0:13:46.56,0:13:49.52,Caption,,0,0,0,,ВОПРОСОМ ТЕРРИТОРИАЛЬНОЙ ЦЕЛОСТНОСТИ И НАЦИОНАЛЬНОЙ
Dialogue: 0,0:13:49.52,0:13:55.47,Caption,,0,0,0,,БЕЗОПАСНОСТИ. РОССИЯ МНОГО ЛЕТ ВОЗРАЖАЛА ПРОТИВ ДВИЖЕНИЯ НАТО И
Dialogue: 0,0:13:55.47,0:13:58.51,Caption,,0,0,0,,ПОЯВЛЕНИЯ ВОЕННОЙ ИНФРАСТРУКТУРЫ ВОЗЛЕ СВОИХ ГРАНИЦ.
Dialogue: 0,0:13:58.80,0:14:02.03,Caption,,0,0,0,,С ЭТИМИ ПОЗИЦИЯМИ МОЖНО СПОРИТЬ. ИХ МОЖНО ОТВЕРГАТЬ
Dialogue: 0,0:14:02.11,0:14:05.55,Caption,,0,0,0,,И СЧИТАТЬ ДЕЙСТВИЯ МОСКВЫ ИЛИ ПЕКИНА ОШИБОЧНЫМИ. НО
Dialogue: 0,0:14:05.55,0:14:07.95,Caption,,0,0,0,,ЖИЗНЕСПОСОБНАЯ СИСТЕМА ТРЕБУЕТ ПРАВИЛА,
Dialogue: 0,0:14:08.19,0:14:10.51,Caption,,0,0,0,,КОТОРОЕ ХОТЯ БЫ ОДИНАКОВО ЧИТАЕТСЯ ВСЕМИ
Dialogue: 0,0:14:10.51,0:14:12.59,Caption,,0,0,0,,УЧАСТНИКАМИ. ИНАЧЕ ПОЛУЧАЕТСЯ,
Dialogue: 0,0:14:12.84,0:14:15.47,Caption,,0,0,0,,ЧТО АМЕРИКАНСКИЕ ОПАСЕНИЯ СЧИТАЮТСЯ ФАКТОМ,
Dialogue: 0,0:14:15.71,0:14:19.23,Caption,,0,0,0,,А ЧУЖИЕ РАЗРЕШЕНО ОБЪЯВЛЯТЬ ФАНТАЗИЕЙ. ТАКОЙ ПОРЯДОК
Dialogue: 0,0:14:19.23,0:14:23.79,Caption,,0,0,0,,ДЕРЖИТСЯ ДО ТЕХ ПОР, ПОКА ДРУГАЯ КРУПНАЯ ДЕРЖАВА НЕ НАЧИНАЕТ ПОЛЬЗОВАТЬСЯ
Dialogue: 0,0:14:23.79,0:14:27.07,Caption,,0,0,0,,ТЕМ ЖЕ ПОДХОДОМ. ПОСЛЕ ЭТОГО ВНЕЗАПНО ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:14:27.31,0:14:29.63,Caption,,0,0,0,,ЧТО ИСКЛЮЧИТЕЛЬНОСТЬ УДОБНА ТОЛЬКО ВЛАДЕЛЬЦУ
Dialogue: 0,0:14:29.63,0:14:32.19,Caption,,0,0,0,,ИСКЛЮЧЕНИЯ. ДЛЯ ОКРУЖАЮЩИХ ОНА ВЫГЛЯДИТ КАК
Dialogue: 0,0:14:32.19,0:14:35.71,Caption,,0,0,0,,РЕСТОРАННЫЙ СЧЁТ, ГДЕ САМЫЙ БОГАТЫЙ ГОСТЬ ЗАКАЗАЛ БАНКЕТ,
Dialogue: 0,0:14:35.99,0:14:39.07,Caption,,0,0,0,,А ОПЛАТУ РАЗЛОЖИЛ МЕЖДУ СОСЕДНИМИ СТОЛИКАМИ. ПОЭТОМУ
Dialogue: 0,0:14:39.07,0:14:41.63,Caption,,0,0,0,,ВОЗВРАЩЕНИЕ МОСКВЫ И ВАШИНГТОНА К РАЗГОВОРУ О
Dialogue: 0,0:14:41.63,0:14:44.35,Caption,,0,0,0,,ПЕРВОПРИЧИНАХ ВАЖНЕЕ ОТДЕЛЬНОГО СОГЛАШЕНИЯ ПО
Dialogue: 0,0:14:44.35,0:14:47.55,Caption,,0,0,0,,УКРАИНЕ. ЕСЛИ ПЕРЕГОВОРЫ ОГРАНИЧАТСЯ ТЕРРИТОРИЯМИ И
Dialogue: 0,0:14:47.55,0:14:51.87,Caption,,0,0,0,,ПРЕКРАЩЕНИЕМ ОГНЯ, СТОРОНЫ ЕЩЁ ДОЛГО БУДУТ МЕНЯТЬ УСЛОВИЯ МЕСТАМИ И
Dialogue: 0,0:14:51.87,0:14:54.83,Caption,,0,0,0,,ОБЪЯВЛЯТЬ, ЧТО ДО МИРА НЕ ХВАТИЛО ПОСЛЕДНЕЙ ЗАПЯТОЙ.
Dialogue: 0,0:14:55.62,0:14:58.51,Caption,,0,0,0,,ЕСЛИ ЖЕ ОБСУЖДЕНИЕ ДЕЙСТВИТЕЛЬНО ОХВАТЫВАЕТ НАТО,
Dialogue: 0,0:14:58.75,0:15:01.71,Caption,,0,0,0,,БЕЗОПАСНОСТЬ ЕВРОПЫ, ЯДЕРНЫЕ ОГРАНИЧЕНИЯ,
Dialogue: 0,0:15:01.80,0:15:05.07,Caption,,0,0,0,,КИТАЙ, ИРАН И ДОПУСТИМЫЕ ПРЕДЕЛЫ ВОЕННОЙ СИЛЫ,
Dialogue: 0,0:15:05.38,0:15:09.90,Caption,,0,0,0,,ЗАДАЧА СТАНОВИТСЯ ДРУГОЙ. НУЖНО ОПРЕДЕЛИТЬ,
Dialogue: 0,0:15:10.06,0:15:13.10,Caption,,0,0,0,,ГДЕ ЗАЩИТА ОДНОЙ ДЕРЖАВЫ ПРЕВРАЩАЕТСЯ В УГРОЗУ ДЛЯ
Dialogue: 0,0:15:13.10,0:15:16.78,Caption,,0,0,0,,ДРУГОЙ И КТО УСТАНАВЛИВАЕТ ЭТУ ГРАНИЦУ. НАПИШИТЕ В
Dialogue: 0,0:15:16.78,0:15:20.70,Caption,,0,0,0,,КОММЕНТАРИЯХ, ВОЗМОЖНО ЛИ ВООБЩЕ ЕДИНОЕ ПРАВИЛО ДЛЯ США,
Dialogue: 0,0:15:20.79,0:15:25.02,Caption,,0,0,0,,РОССИИ И КИТАЯ, ИЛИ КАЖДАЯ БОЛЬШАЯ СТРАНА ПРИЗНАЁТ ТОЛЬКО ТОТ
Dialogue: 0,0:15:25.02,0:15:28.30,Caption,,0,0,0,,ПОРЯДОК, КОТОРЫЙ ВЫГОДЕН ЕЙ САМОЙ. ПОКА БЕЗОПАСНОСТЬ
Dialogue: 0,0:15:28.30,0:15:30.14,Caption,,0,0,0,,СЧИТАЕТСЯ ЗАКОННОЙ ЛИШЬ ТОГДА,
Dialogue: 0,0:15:30.38,0:15:32.70,Caption,,0,0,0,,КОГДА ЕЁ ОДОБРЯЕТ САМЫЙ СИЛЬНЫЙ УЧАСТНИК,
Dialogue: 0,0:15:32.94,0:15:35.26,Caption,,0,0,0,,ДОГОВОРЫ БУДУТ ЗАКРЫВАТЬ ОДИН КОНФЛИКТ И
Dialogue: 0,0:15:35.26,0:15:38.14,Caption,,0,0,0,,ОДНОВРЕМЕННО ГОТОВИТЬ СЛЕДУЮЩИЙ. ПОЛИТИКИ ПРОДОЛЖАТ
