Dialogue: 0,0:00:00.12,0:00:04.36,Caption,,0,0,0,,ЕСЛИ ЧЕЛОВЕК ПОКУПАЕТ КАСКУ, БРОНЕЖИЛЕТ И ПРОВЕРЯЕТ ЗАПАСНОЙ ВЫХОД,
Dialogue: 0,0:00:04.68,0:00:10.04,Caption,,0,0,0,,МОЖНО, КОНЕЧНО, ПОВЕРИТЬ, ЧТО ОН ПРОСТО ЛЮБИТ ПОРЯДОК. МОЖНО. НО ВОПРОСЫ
Dialogue: 0,0:00:10.12,0:00:12.68,Caption,,0,0,0,,ВСЁ РАВНО ОСТАНУТСЯ. И СЕЙЧАС ТАКИХ ВОПРОСОВ
Dialogue: 0,0:00:12.68,0:00:15.72,Caption,,0,0,0,,СТАНОВИТСЯ ВСЁ БОЛЬШЕ. ОСОБЕННО В ПОЛЬШЕ. ПОКА
Dialogue: 0,0:00:15.72,0:00:18.68,Caption,,0,0,0,,ПОЛИТИКИ ОБЪЯСНЯЮТ, ЧТО ЕВРОПА ТОЛЬКО ГОТОВИТСЯ,
Dialogue: 0,0:00:19.00,0:00:21.80,Caption,,0,0,0,,САМА ПОЛЬША УЖЕ ПОКАЗЫВАЕТ ВПОЛНЕ ПОНЯТНУЮ КАРТИНУ.
Dialogue: 0,0:00:22.48,0:00:25.48,Caption,,0,0,0,,ПОЛЬША УКРЕПЛЯЕТ ВОСТОЧНУЮ ГРАНИЦУ. ПЕРЕСТРАИВАЕТ
Dialogue: 0,0:00:25.56,0:00:28.68,Caption,,0,0,0,,ВОЕННЫЕ ЧАСТИ. УСИЛИВАЕТ ВЗАИМОДЕЙСТВИЕ АРМИИ,
Dialogue: 0,0:00:28.82,0:00:33.64,Caption,,0,0,0,,ПОГРАНИЧНИКОВ, ПОЛИЦИИ И СПЕЦСЛУЖБ. ГОТОВИТСЯ К БОЛЬШИМ УЧЕНИЯМ,
Dialogue: 0,0:00:33.84,0:00:35.64,Caption,,0,0,0,,НА КОТОРЫХ БУДУТ ПРОВЕРЯТЬ ПЕРЕБРОСКУ
Dialogue: 0,0:00:35.64,0:00:37.80,Caption,,0,0,0,,МНОГОНАЦИОНАЛЬНЫХ СИЛ В СТОРОНУ УКРАИНЫ.
Dialogue: 0,0:00:38.38,0:00:41.72,Caption,,0,0,0,,ТО ЕСТЬ КАСКА УЖЕ КУПЛЕНА. БРОНЕЖИЛЕТ ЗАСТЁГНУТ.
Dialogue: 0,0:00:41.96,0:00:44.68,Caption,,0,0,0,,ЗАПАСНОЙ ВЫХОД НАЙДЕН. А ТЕПЕРЬ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:00:44.84,0:00:47.48,Caption,,0,0,0,,ЧТО ПО КОРИДОРУ УЖЕ КТО ТО ХОДИТ. НОЧЬЮ
Dialogue: 0,0:00:47.48,0:00:50.04,Caption,,0,0,0,,НА ПОЛЬСКОЙ ГРАНИЦЕ С КАЛИНИНГРАДСКОЙ ОБЛАСТЬЮ
Dialogue: 0,0:00:50.04,0:00:52.76,Caption,,0,0,0,,ПОГРАНИЧНИКИ ЗАМЕТИЛИ ПОДОЗРИТЕЛЬНОЕ ДВИЖЕНИЕ.
Dialogue: 0,0:00:53.12,0:00:57.72,Caption,,0,0,0,,ДОНАЛЬД ТУСК СООБЩИЛ, ЧТО В РАЙОН СРАЗУ ВЫДВИНУЛИСЬ ПОЛЬСКИЕ СИЛЫ. ПО
Dialogue: 0,0:00:57.72,0:01:00.20,Caption,,0,0,0,,ЕГО СЛОВАМ, ВЛАСТИ СОРВАЛИ ТО,
Dialogue: 0,0:01:00.36,0:01:02.76,Caption,,0,0,0,,ЧТО РАССМАТРИВАЛИ КАК ВОЗМОЖНУЮ ПРОВОКАЦИЮ.
Dialogue: 0,0:01:03.06,0:01:05.64,Caption,,0,0,0,,ОДНОВРЕМЕННО НА СЕВЕРО ВОСТОКЕ ПОЛЬШИ ПРОДОЛЖАЕТСЯ
Dialogue: 0,0:01:05.64,0:01:08.36,Caption,,0,0,0,,СПЕЦИАЛЬНАЯ ОПЕРАЦИЯ С УЧАСТИЕМ ПОЛИЦИИ,
Dialogue: 0,0:01:08.56,0:01:13.80,Caption,,0,0,0,,ВОЕННЫХ, ПОГРАНИЧНИКОВ, СПЕЦСЛУЖБ И КОНТРТЕРРОРИСТИЧЕСКИХ ПОДРАЗДЕЛЕНИЙ.
Dialogue: 0,0:01:16.08,0:01:18.72,Caption,,0,0,0,,ЕСЛИ ХОТИТЕ СМОТРЕТЬ НЕ ТОЛЬКО НА СЛОВА ПОЛИТИКОВ,
Dialogue: 0,0:01:18.92,0:01:21.36,Caption,,0,0,0,,НО И НА ТО, ЧТО ПРОИСХОДИТ НА САМОМ ДЕЛЕ,
Dialogue: 0,0:01:21.50,0:01:24.24,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ВОТ ЗДЕСЬ СТАНОВИТСЯ ИНТЕРЕСНО.
Dialogue: 0,0:01:24.80,0:01:28.00,Caption,,0,0,0,,НЕ ПОТОМУ, ЧТО НЕСКОЛЬКО ЧЕЛОВЕК С ФОНАРИКАМИ ВОЗЛЕ ГРАНИЦЫ
Dialogue: 0,0:01:28.00,0:01:31.20,Caption,,0,0,0,,ВНЕЗАПНО НАЧАЛИ ТРЕТЬЮ МИРОВУЮ ВОЙНУ. НЕ НАДО ДЕЛАТЬ
Dialogue: 0,0:01:31.20,0:01:34.24,Caption,,0,0,0,,ИЗ ФОНАРИКА МЕЖКОНТИНЕНТАЛЬНУЮ РАКЕТУ. ИНТЕРЕСНО
Dialogue: 0,0:01:34.24,0:01:38.48,Caption,,0,0,0,,ДРУГОЕ. ПОЛЬША СОЗДАЛА СИСТЕМУ ДЛЯ БЫСТРОГО РЕАГИРОВАНИЯ НА
Dialogue: 0,0:01:38.56,0:01:41.60,Caption,,0,0,0,,ВОСТОЧНОМ НАПРАВЛЕНИИ. И ЭТА СИСТЕМА УЖЕ НАЧИНАЕТ
Dialogue: 0,0:01:41.68,0:01:46.40,Caption,,0,0,0,,РАБОТАТЬ ТАК, КАК ЕЁ И СОБИРАЛИ. ПОЛУЧИЛИ СИГНАЛ. ПОДНЯЛИ ЛЮДЕЙ.
Dialogue: 0,0:01:46.79,0:01:49.68,Caption,,0,0,0,,ПЕРЕБРОСИЛИ СИЛЫ. ПОДКЛЮЧИЛИ РАЗНЫЕ ВЕДОМСТВА.
Dialogue: 0,0:01:49.92,0:01:53.60,Caption,,0,0,0,,НАЧАЛИ ПРОВЕРЯТЬ РАЙОН. ВСЁ. НИКАКИХ КРАСИВЫХ РЕЧЕЙ
Dialogue: 0,0:01:53.68,0:01:57.92,Caption,,0,0,0,,НЕ ТРЕБУЕТСЯ. ВОЕННАЯ МАШИНА ВООБЩЕ ОТЛИЧАЕТСЯ ОТ ПОЛИТИКА ОДНОЙ
Dialogue: 0,0:01:57.92,0:02:01.68,Caption,,0,0,0,,НЕПРИЯТНОЙ ОСОБЕННОСТЬЮ. ПОЛИТИК МОЖЕТ СЕГОДНЯ СКАЗАТЬ ОДНО,
Dialogue: 0,0:02:01.92,0:02:04.40,Caption,,0,0,0,,ЗАВТРА ДРУГОЕ, ПОСЛЕЗАВТРА ОБЪЯСНИТЬ,
Dialogue: 0,0:02:04.48,0:02:07.60,Caption,,0,0,0,,ЧТО ЕГО НЕПРАВИЛЬНО ПОНЯЛИ. БРИГАДА ТАК НЕ УМЕЕТ.
Dialogue: 0,0:02:08.00,0:02:10.64,Caption,,0,0,0,,ЕСЛИ БРИГАДУ ПЕРЕСТРОИЛИ ПОД ОПРЕДЕЛЁННУЮ ЗАДАЧУ,
Dialogue: 0,0:02:10.96,0:02:13.44,Caption,,0,0,0,,ОНА ЭТОЙ ЗАДАЧЕЙ И ЗАНИМАЕТСЯ. ЕСЛИ СОЗДАЛИ
Dialogue: 0,0:02:13.44,0:02:17.12,Caption,,0,0,0,,КОМАНДОВАНИЕ, ОНО КОМАНДУЕТ. ЕСЛИ ПОДГОТОВИЛИ МАРШРУТЫ,
Dialogue: 0,0:02:17.20,0:02:20.16,Caption,,0,0,0,,ПО НИМ НАЧИНАЮТ ЕЗДИТЬ. ЕСЛИ НА ГРАНИЦУ ОТПРАВИЛИ
Dialogue: 0,0:02:20.16,0:02:23.28,Caption,,0,0,0,,СИЛЫ, ОНИ ТАМ УЖЕ СТОЯТ. И ИМЕННО ПОЭТОМУ Я
Dialogue: 0,0:02:23.28,0:02:25.52,Caption,,0,0,0,,ДАВНО ПРЕДЛАГАЮ СМОТРЕТЬ НЕ СТОЛЬКО НА СЛОВА
Dialogue: 0,0:02:25.52,0:02:28.08,Caption,,0,0,0,,ЕВРОПЕЙСКИХ ПОЛИТИКОВ, СКОЛЬКО НА ТО,
Dialogue: 0,0:02:28.22,0:02:31.28,Caption,,0,0,0,,ЧТО ОНИ ДЕЛАЮТ РУКАМИ. ПОЛЬША СЕЙЧАС ОСОБЕННО
Dialogue: 0,0:02:31.36,0:02:36.45,Caption,,0,0,0,,УДОБНЫЙ ПРИМЕР. ПОТОМУ ЧТО У НЕЁ ОДНОВРЕМЕННО РАБОТАЮТ ДВА
Dialogue: 0,0:02:36.45,0:02:40.21,Caption,,0,0,0,,НАПРАВЛЕНИЯ. ОДНО СМОТРИТ НА УКРАИНУ. ВТОРОЕ СМОТРИТ
Dialogue: 0,0:02:40.29,0:02:43.33,Caption,,0,0,0,,НА КАЛИНИНГРАД. И ЭТО НЕ ДВЕ ПОЛЬШИ. НЕ
Dialogue: 0,0:02:43.33,0:02:46.77,Caption,,0,0,0,,ДВЕ АРМИИ. И НЕ ДВА СЛУЧАЙНО СОВПАВШИХ МЕРОПРИЯТИЯ.
Dialogue: 0,0:02:47.05,0:02:49.73,Caption,,0,0,0,,ГОСУДАРСТВО ОДНО. ВОЕННОЕ РУКОВОДСТВО ОДНО.
Dialogue: 0,0:02:50.05,0:02:53.01,Caption,,0,0,0,,ТРАНСПОРТНАЯ СИСТЕМА ОДНА. СКЛАДЫ,
Dialogue: 0,0:02:53.17,0:02:56.77,Caption,,0,0,0,,ДОРОГИ, СВЯЗЬ, АЭРОДРОМЫ, ЖЕЛЕЗНАЯ ДОРОГА,
Dialogue: 0,0:02:56.87,0:02:59.81,Caption,,0,0,0,,ПОГРАНИЧНАЯ ИНФРАСТРУКТУРА НАХОДЯТСЯ ВНУТРИ ОДНОЙ
Dialogue: 0,0:02:59.81,0:03:03.17,Caption,,0,0,0,,СИСТЕМЫ. НА СЕВЕРО ВОСТОКЕ ПОЛЯКИ УСИЛИВАЮТ ГРАНИЦУ
Dialogue: 0,0:03:03.25,0:03:05.89,Caption,,0,0,0,,С РОССИЕЙ. А НА ЮГО ВОСТОКЕ БУКВАЛЬНО ЧЕРЕЗ
Dialogue: 0,0:03:05.89,0:03:08.93,Caption,,0,0,0,,НЕСКОЛЬКО ДНЕЙ НАЧИНАЕТСЯ СОВСЕМ ДРУГАЯ ИСТОРИЯ.
Dialogue: 0,0:03:09.48,0:03:12.93,Caption,,0,0,0,,ДЕВЯТОГО НОЯБРЯ СТАРТУЮТ УЧЕНИЯ KOALICJA. И ВОТ
Dialogue: 0,0:03:13.01,0:03:15.57,Caption,,0,0,0,,ЗДЕСЬ Я БЫ СЛОВО УЧЕНИЯ ВООБЩЕ ПРОИЗНОСИЛ ОЧЕНЬ
Dialogue: 0,0:03:15.57,0:03:18.77,Caption,,0,0,0,,АККУРАТНО. ПОТОМУ ЧТО У МНОГИХ СЛОВО УЧЕНИЯ ДО
Dialogue: 0,0:03:18.85,0:03:22.53,Caption,,0,0,0,,СИХ ПОР ВЫЗЫВАЕТ КАРТИНКУ, ГДЕ СОЛДАТЫ ПРОБЕЖАЛИ ПО ПОЛЮ,
Dialogue: 0,0:03:22.69,0:03:25.41,Caption,,0,0,0,,ПОСТРЕЛЯЛИ, КОМАНДИР ПОЖАЛ КОМУ ТО РУКУ,
Dialogue: 0,0:03:25.56,0:03:28.69,Caption,,0,0,0,,ПОТОМ ВСЕ ПОЕЛИ КАШУ И РАЗЪЕХАЛИСЬ. ЗДЕСЬ ЗАДАЧА
Dialogue: 0,0:03:28.69,0:03:32.21,Caption,,0,0,0,,ДРУГАЯ. ПОЧТИ ДВЕ ТЫСЯЧИ ВОСЕМЬСОТ ВОЕННОСЛУЖАЩИХ
Dialogue: 0,0:03:32.51,0:03:34.29,Caption,,0,0,0,,ДОЛЖНЫ ПРОВЕРЯТЬ КОМАНДОВАНИЕ,
Dialogue: 0,0:03:34.37,0:03:37.73,Caption,,0,0,0,,СВЯЗЬ, ПЕРЕБРОСКУ ЛЮДЕЙ, ТЕХНИКИ И ГРУЗОВ,
Dialogue: 0,0:03:37.97,0:03:40.53,Caption,,0,0,0,,ВЗАИМОДЕЙСТВИЕ МЕЖДУ АРМИЯМИ И РАБОТУ
Dialogue: 0,0:03:40.57,0:03:43.01,Caption,,0,0,0,,МНОГОНАЦИОНАЛЬНОЙ ГРУППИРОВКИ. БРИТАНСКОЕ
Dialogue: 0,0:03:43.01,0:03:46.13,Caption,,0,0,0,,МИНИСТЕРСТВО ОБОРОНЫ ПРЯМО ПИШЕТ ЭТО ПЕРВАЯ КРУПНАЯ
Dialogue: 0,0:03:46.21,0:03:49.65,Caption,,0,0,0,,ПРОВЕРКА MULTINATIONAL FORCE UKRAINE. СИЛЫ,
Dialogue: 0,0:03:49.83,0:03:52.69,Caption,,0,0,0,,КОТОРУЮ ВЕЛИКОБРИТАНИЯ И ФРАНЦИЯ УЖЕ СОЗДАЮТ В
Dialogue: 0,0:03:52.69,0:03:58.98,Caption,,0,0,0,,РАМКАХ КОАЛИЦИИ ЖЕЛАЮЩИХ. И БРИТАНСКИЙ МИНИСТР ОБОРОНЫ СФОРМУЛИРОВАЛ ОСОБЕННО
Dialogue: 0,0:03:58.98,0:04:01.46,Caption,,0,0,0,,ПРЕКРАСНО ЭТО НЕ ГИПОТЕТИЧЕСКИЙ ПЛАН,
Dialogue: 0,0:04:01.70,0:04:06.34,Caption,,0,0,0,,А РЕАЛЬНАЯ СИЛА. ПОДПИШИТЕСЬ, ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. ДАЛЬШЕ ПОСМОТРИМ,
Dialogue: 0,0:04:06.56,0:04:10.10,Caption,,0,0,0,,ЧТО ПРОИСХОДИТ, КОГДА ТАКИЕ ПЛАНЫ НАЧИНАЮТ ПРОВЕРЯТЬ НА ПРАКТИКЕ.
Dialogue: 0,0:04:10.61,0:04:13.54,Caption,,0,0,0,,ВОТ СПАСИБО. НАКОНЕЦ ТО БЕЗ ЗАГАДОК. НЕ
Dialogue: 0,0:04:13.54,0:04:16.90,Caption,,0,0,0,,ГИПОТЕТИЧЕСКАЯ. РЕАЛЬНАЯ. ГОТОВАЯ К РАЗВЁРТЫВАНИЮ
Dialogue: 0,0:04:16.98,0:04:19.70,Caption,,0,0,0,,ПОСЛЕ ПРЕКРАЩЕНИЯ БОЕВЫХ ДЕЙСТВИЙ НА УКРАИНЕ. ТО
Dialogue: 0,0:04:19.78,0:04:22.50,Caption,,0,0,0,,ЕСТЬ ТО, ЧТО ЕЩЁ НЕДАВНО ОБСУЖДАЛИ НА ВСТРЕЧАХ,
Dialogue: 0,0:04:22.82,0:04:27.38,Caption,,0,0,0,,ТЕПЕРЬ ПРОВЕРЯЮТ НОГАМИ, КОЛЁСАМИ И САМОЛЁТАМИ. МОЖНО ДОЛГО РИСОВАТЬ
Dialogue: 0,0:04:27.38,0:04:31.14,Caption,,0,0,0,,СТРЕЛОЧКУ НА КАРТЕ. НО ПОКА ПО ЭТОЙ СТРЕЛОЧКЕ НЕ ПОПРОБОВАЛИ ПРОТАЩИТЬ
Dialogue: 0,0:04:31.22,0:04:33.30,Caption,,0,0,0,,КОЛОННУ ТЕХНИКИ ЧЕРЕЗ НЕСКОЛЬКО ГРАНИЦ,
Dialogue: 0,0:04:33.54,0:04:36.18,Caption,,0,0,0,,ЭТО ПРОСТО СТРЕЛОЧКА. А ПОТОМ ВЫЯСНЯЕТСЯ,
Dialogue: 0,0:04:36.42,0:04:40.02,Caption,,0,0,0,,ЧТО МОСТ УЗКИЙ. ВОДИТЕЛЬ ПОТЕРЯЛСЯ. СВЯЗЬ ОДНОЙ
Dialogue: 0,0:04:40.10,0:04:43.38,Caption,,0,0,0,,АРМИИ НЕ РАЗГОВАРИВАЕТ СО СВЯЗЬЮ ДРУГОЙ. БОЕПРИПАСЫ
Dialogue: 0,0:04:43.38,0:04:46.18,Caption,,0,0,0,,ПРИЕХАЛИ НЕ ТУДА. ТОПЛИВО ЗАКОНЧИЛОСЬ РАНЬШЕ,
Dialogue: 0,0:04:46.33,0:04:49.14,Caption,,0,0,0,,ЧЕМ ПОЛИТИЧЕСКИЕ ЗАЯВЛЕНИЯ. И ВОТ ДЛЯ ЭТОГО КАК
Dialogue: 0,0:04:49.14,0:04:52.42,Caption,,0,0,0,,РАЗ СУЩЕСТВУЮТ ТАКИЕ УЧЕНИЯ. НЕ ДЛЯ ФОТОГРАФИИ. А
Dialogue: 0,0:04:52.50,0:04:54.98,Caption,,0,0,0,,ЧТОБЫ ПОНЯТЬ, РАБОТАЕТ МАШИНА ИЛИ НЕТ.
Dialogue: 0,0:04:55.88,0:04:58.34,Caption,,0,0,0,,С ДЕВЯТОГО ПО ДВАДЦАТЬ ВТОРОЕ НОЯБРЯ В ПОЛЬШЕ
Dialogue: 0,0:04:58.42,0:05:01.38,Caption,,0,0,0,,КАК РАЗ И БУДУТ ПРОВЕРЯТЬ ЭТУ МАШИНУ. ФРАНЦИЯ
Dialogue: 0,0:05:01.38,0:05:04.10,Caption,,0,0,0,,И ВЕЛИКОБРИТАНИЯ РУКОВОДЯТ КОНСТРУКЦИЕЙ. В НЕЙ
Dialogue: 0,0:05:04.10,0:05:06.90,Caption,,0,0,0,,УЧАСТВУЮТ СИЛЫ НЕСКОЛЬКИХ ЕВРОПЕЙСКИХ ГОСУДАРСТВ.
Dialogue: 0,0:05:07.29,0:05:10.02,Caption,,0,0,0,,ВОЗДУШНУЮ ЧАСТЬ ПРОВОДЯТ В ТОМ ЧИСЛЕ ЧЕРЕЗ РУМЫНИЮ.
Dialogue: 0,0:05:12.30,0:05:15.11,Caption,,0,0,0,,МОРСКОЙ КОМПОНЕНТ ОТРАБАТЫВАЕТСЯ С УЧАСТИЕМ ТУРЦИИ.
Dialogue: 0,0:05:15.46,0:05:17.43,Caption,,0,0,0,,НАТО О ПРОИСХОДЯЩЕМ ИНФОРМИРОВАНО,
Dialogue: 0,0:05:17.80,0:05:20.55,Caption,,0,0,0,,НО САМА КОНСТРУКЦИЯ ФОРМАЛЬНО СОЗДАНА ВНЕ НАТО.
Dialogue: 0,0:05:21.21,0:05:26.39,Caption,,0,0,0,,А ТЕПЕРЬ ВЕРНЁМСЯ К КАРТЕ. НА ОДНОМ КОНЦЕ ПОЛЬШИ ПРОВЕРЯЮТ РЕАЛЬНУЮ ПЕРЕБРОСКУ
Dialogue: 0,0:05:26.39,0:05:29.03,Caption,,0,0,0,,МЕЖДУНАРОДНОЙ ВОЕННОЙ ГРУППИРОВКИ. НА ДРУГОМ УЖЕ
Dialogue: 0,0:05:29.03,0:05:30.87,Caption,,0,0,0,,ПОДНЯТЫ СИЛЫ ВОЗЛЕ КАЛИНИНГРАДА.
Dialogue: 0,0:05:31.42,0:05:33.83,Caption,,0,0,0,,И ВОТ ТУТ ОСОБЕННО СМЕШНО ЧИТАТЬ ФОРМУЛИРОВКИ В
Dialogue: 0,0:05:33.83,0:05:37.35,Caption,,0,0,0,,ДУХЕ ЕВРОПА НАЧИНАЕТ ГОТОВИТЬСЯ. НАЧИНАЕТ?
Dialogue: 0,0:05:37.64,0:05:39.83,Caption,,0,0,0,,РЕБЯТА, ВЫ КАЛЕНДАРЬ ДАВНО ОТКРЫВАЛИ?
Dialogue: 0,0:05:40.24,0:05:41.91,Caption,,0,0,0,,ОНА УЖЕ ПОДГОТОВИЛАСЬ НАСТОЛЬКО,
Dialogue: 0,0:05:42.15,0:05:46.23,Caption,,0,0,0,,ЧТО ТЕПЕРЬ ПРОВЕРЯЕТ, КАК ВСЁ ЭТО ЕЗДИТ. НЕ МЕНЯЕТ ПЛАНЫ. ПЛАНЫ
Dialogue: 0,0:05:46.23,0:05:49.35,Caption,,0,0,0,,УЖЕ ПОМЕНЯНЫ. НЕ ПРИБЛИЖАЕТСЯ К РОССИЙСКОЙ ГРАНИЦЕ.
Dialogue: 0,0:05:49.51,0:05:52.23,Caption,,0,0,0,,ГРАНИЦА ВОТ ОНА. ДАЛЬШЕ ПРИБЛИЖАТЬСЯ ТОЛЬКО С
Dialogue: 0,0:05:52.23,0:05:55.03,Caption,,0,0,0,,РУЛЕТКОЙ. ФИЗИЧЕСКИ НЕКУДА. И ВОТ ЭТО,
Dialogue: 0,0:05:55.24,0:05:57.51,Caption,,0,0,0,,НА МОЙ ВЗГЛЯД, ВАЖНЕЙШЕЕ ИЗМЕНЕНИЕ,
Dialogue: 0,0:05:57.75,0:06:00.87,Caption,,0,0,0,,КОТОРОЕ ПОСТОЯННО ТЕРЯЕТСЯ В НОВОСТНОМ ПОТОКЕ. НАМ
Dialogue: 0,0:06:00.87,0:06:03.91,Caption,,0,0,0,,ПРОДОЛЖАЮТ КАЖДУЮ ДЕТАЛЬ ПОКАЗЫВАТЬ ОТДЕЛЬНО. ПОЛЬША
Dialogue: 0,0:06:03.91,0:06:07.11,Caption,,0,0,0,,УСИЛИЛА ГРАНИЦУ. ОТДЕЛЬНАЯ НОВОСТЬ. УЧЕНИЯ.
Dialogue: 0,0:06:07.34,0:06:10.23,Caption,,0,0,0,,ОТДЕЛЬНАЯ НОВОСТЬ. ФРАНЦИЯ ЧТО ТО ОБСУЖДАЕТ.
Dialogue: 0,0:06:10.46,0:06:13.91,Caption,,0,0,0,,ОТДЕЛЬНАЯ НОВОСТЬ. ФИНЛЯНДИЯ КУДА ТО ВСТУПИЛА. ЕЩЁ
Dialogue: 0,0:06:13.91,0:06:17.03,Caption,,0,0,0,,ОДНА НОВОСТЬ. А Я ПРЕДЛАГАЮ СДЕЛАТЬ ОЧЕНЬ СЛОЖНУЮ
Dialogue: 0,0:06:17.03,0:06:19.75,Caption,,0,0,0,,ИНТЕЛЛЕКТУАЛЬНУЮ ОПЕРАЦИЮ. ПОЛОЖИТЬ ВСЁ НА ОДИН
Dialogue: 0,0:06:19.75,0:06:24.63,Caption,,0,0,0,,СТОЛ. И ВНЕЗАПНО ВЫЯСНЯЕТСЯ, ЧТО ДЕТАЛИ ПРЕКРАСНО ДРУГ С ДРУГОМ РАЗГОВАРИВАЮТ.
Dialogue: 0,0:06:24.85,0:06:28.15,Caption,,0,0,0,,ПОТОМУ ЧТО СЕВЕРНЕЕ ПОЛЬШИ ПРОИСХОДИТ ЕЩЁ БОЛЕЕ
Dialogue: 0,0:06:28.15,0:06:33.86,Caption,,0,0,0,,ЗАНЯТНАЯ ИСТОРИЯ. ФИНЛЯНДИЯ ПРИСОЕДИНИЛАСЬ К ФРАНЦУЗСКОЙ ИНИЦИАТИВЕ
Dialogue: 0,0:06:33.86,0:06:36.74,Caption,,0,0,0,,ЯДЕРНОГО СДЕРЖИВАНИЯ. НЕ ПРОСТО ПОДПИСАЛА КРАСИВУЮ
Dialogue: 0,0:06:36.74,0:06:40.42,Caption,,0,0,0,,БУМАГУ. ДВАДЦАТЬ СЕДЬМОГО ОКТЯБРЯ ФРАНЦИЯ И ФИНЛЯНДИЯ
Dialogue: 0,0:06:40.42,0:06:43.86,Caption,,0,0,0,,ПРОВЕЛИ В ПАРИЖЕ ПЕРВОЕ ЗАСЕДАНИЕ СОВМЕСТНОЙ NUCLEAR
Dialogue: 0,0:06:43.86,0:06:46.66,Caption,,0,0,0,,STEERING GROUP. В КОМНАТЕ НАХОДИЛИСЬ ПРЕДСТАВИТЕЛИ
Dialogue: 0,0:06:46.66,0:06:51.22,Caption,,0,0,0,,ЕЛИСЕЙСКОГО ДВОРЦА, АДМИНИСТРАЦИИ ПРЕЗИДЕНТА И ПРАВИТЕЛЬСТВА ФИНЛЯНДИИ,
Dialogue: 0,0:06:51.38,0:06:56.82,Caption,,0,0,0,,МИНИСТЕРСТВ ИНОСТРАННЫХ ДЕЛ, МИНИСТЕРСТВ ОБОРОНЫ И ВЫСОКОПОСТАВЛЕННЫЕ ВОЕННЫЕ. ТО
Dialogue: 0,0:06:56.90,0:06:59.22,Caption,,0,0,0,,ЕСТЬ ЭТО НЕ КРУЖОК ЛЮБИТЕЛЕЙ МЕЖДУНАРОДНЫХ
Dialogue: 0,0:06:59.22,0:07:02.66,Caption,,0,0,0,,ОТНОШЕНИЙ. ЛЮДИ ЗАНИМАЮТСЯ ПРАКТИЧЕСКОЙ ЧАСТЬЮ. А
Dialogue: 0,0:07:02.74,0:07:06.02,Caption,,0,0,0,,ВТОРОГО НОЯБРЯ АЛЕКСАНДР СТУББ УЖЕ ПУБЛИЧНО ЗАЯВИЛ,
Dialogue: 0,0:07:06.26,0:07:09.22,Caption,,0,0,0,,ЧТО РАБОТА ПО РЕАЛИЗАЦИИ СОТРУДНИЧЕСТВА ЗАПУЩЕНА НА
Dialogue: 0,0:07:09.22,0:07:12.02,Caption,,0,0,0,,ОФИЦИАЛЬНОМ УРОВНЕ. И ВОТ ЗДЕСЬ У МЕНЯ СНОВА
Dialogue: 0,0:07:12.02,0:07:14.66,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ТОТ САМЫЙ ДУРНОЙ ВОПРОС. ЗАЧЕМ?
Dialogue: 0,0:07:15.02,0:07:18.10,Caption,,0,0,0,,НАМ ОТВЕЧАЮТ СДЕРЖИВАНИЕ. ПРЕКРАСНО. ТОГДА ДАВАЙТЕ
Dialogue: 0,0:07:18.10,0:07:21.46,Caption,,0,0,0,,РАЗБЕРЁМСЯ, ЧТО ИМЕННО МЫ СДЕРЖИВАЕМ И КАКИМ СПОСОБОМ.
Dialogue: 0,0:07:22.18,0:07:25.38,Caption,,0,0,0,,ФРАНЦИЯ УЖЕ ДЕСЯТИЛЕТИЯМИ ИМЕЕТ ПОЛНОЦЕННЫЙ ЯДЕРНЫЙ
Dialogue: 0,0:07:25.46,0:07:28.58,Caption,,0,0,0,,ПОТЕНЦИАЛ. ПРИЧЁМ ГЛАВНАЯ ЕГО СИЛА СИДИТ НЕ ГДЕ
Dialogue: 0,0:07:28.58,0:07:30.98,Caption,,0,0,0,,НИБУДЬ ВОЗЛЕ ВЫБОРГА. ОНА СИДИТ ПОД ВОДОЙ.
Dialogue: 0,0:07:31.53,0:07:33.70,Caption,,0,0,0,,ФРАНЦУЗСКИЕ АТОМНЫЕ ПОДВОДНЫЕ ЛОДКИ С
Dialogue: 0,0:07:33.70,0:07:36.66,Caption,,0,0,0,,БАЛЛИСТИЧЕСКИМИ РАКЕТАМИ СУЩЕСТВУЮТ ИМЕННО ДЛЯ ТОГО,
Dialogue: 0,0:07:36.90,0:07:39.62,Caption,,0,0,0,,ЧТОБЫ ПРОТИВНИК НЕ МОГ ОДНИМ УДАРОМ УНИЧТОЖИТЬ
Dialogue: 0,0:07:39.62,0:07:42.18,Caption,,0,0,0,,ФРАНЦУЗСКИЙ ЯДЕРНЫЙ ОТВЕТ. ЭТО ОЧЕНЬ ПОНЯТНАЯ
Dialogue: 0,0:07:42.18,0:07:45.06,Caption,,0,0,0,,КОНСТРУКЦИЯ. ПОДЛОДКУ ТРУДНО НАЙТИ. ОНА НАХОДИТСЯ
Dialogue: 0,0:07:45.14,0:07:50.06,Caption,,0,0,0,,ДАЛЕКО. ОНА ДВИГАЕТСЯ. ТЫ НЕ ЗНАЕШЬ ТОЧНО,
Dialogue: 0,0:07:50.14,0:07:53.42,Caption,,0,0,0,,ГДЕ ОНА. ДАЖЕ ЕСЛИ ПО ТЕРРИТОРИИ ФРАНЦИИ ПРИЛЕТИТ
Dialogue: 0,0:07:53.42,0:07:57.42,Caption,,0,0,0,,ПЕРВЫЙ УДАР, ЛОДКА ДОЛЖНА ОСТАТЬСЯ В МОРЕ И ОТВЕТИТЬ. ВОТ
Dialogue: 0,0:07:57.42,0:08:00.06,Caption,,0,0,0,,ЭТО НОРМАЛЬНАЯ ЛОГИКА СДЕРЖИВАНИЯ. ТЫ ГОВОРИШЬ
Dialogue: 0,0:08:00.06,0:08:02.30,Caption,,0,0,0,,ПРОТИВНИКУ ДАЖЕ ЕСЛИ ТЫ УДАРИШЬ ПЕРВЫМ,
Dialogue: 0,0:08:02.51,0:08:05.18,Caption,,0,0,0,,ВСЁ РАВНО ПОЛУЧИШЬ В ОТВЕТ. ПОЭТОМУ ЛУЧШЕ ВООБЩЕ
Dialogue: 0,0:08:05.26,0:08:08.46,Caption,,0,0,0,,НЕ НАЧИНАЙ. ВСЁ ПОНЯТНО. РАБОТАЕТ УЖЕ ДЕСЯТИЛЕТИЯМИ.
Dialogue: 0,0:08:08.86,0:08:12.46,Caption,,0,0,0,,И ТУТ ВНЕЗАПНО ПОЯВЛЯЕТСЯ НОВАЯ КОНЦЕПЦИЯ. ПЕРЕДОВОЕ
Dialogue: 0,0:08:12.46,0:08:17.50,Caption,,0,0,0,,СДЕРЖИВАНИЕ. СЛОВО, КОНЕЧНО, ВЕЛИКОЛЕПНОЕ. СДЕРЖИВАНИЕ ТЕПЕРЬ ДОЛЖНО БЫТЬ
Dialogue: 0,0:08:17.50,0:08:20.30,Caption,,0,0,0,,ПЕРЕДОВЫМ. ПОТОМУ ЧТО ЗАДНЕЕ, ВИДИМО,
Dialogue: 0,0:08:20.42,0:08:23.42,Caption,,0,0,0,,УЖЕ НЕДОСТАТОЧНО УБЕДИТЕЛЬНОЕ. СЛЕДУЮЩИМ ЭТАПОМ
Dialogue: 0,0:08:23.42,0:08:25.74,Caption,,0,0,0,,БУДЕТ СДЕРЖИВАНИЕ ПОВЫШЕННОЙ ПРОХОДИМОСТИ.
Dialogue: 0,0:08:25.90,0:08:29.10,Caption,,0,0,0,,КОМПЛЕКТАЦИЯ ЛЮКС. ПОДОГРЕВ СИДЕНИЙ. НО ШУТКИ В
Dialogue: 0,0:08:29.10,0:08:32.38,Caption,,0,0,0,,СТОРОНУ. ЕСЛИ У ФРАНЦИИ УЖЕ ЕСТЬ ЗАЩИЩЁННЫЙ МОРСКОЙ
Dialogue: 0,0:08:32.38,0:08:36.78,Caption,,0,0,0,,КОМПОНЕНТ ОТВЕТНОГО УДАРА, ВОЗНИКАЕТ СОВЕРШЕННО НОРМАЛЬНЫЙ ВОПРОС. КАКУЮ
Dialogue: 0,0:08:36.78,0:08:39.26,Caption,,0,0,0,,ДОПОЛНИТЕЛЬНУЮ ЗАДАЧУ ДОЛЖНО РЕШИТЬ РАСШИРЕНИЕ
Dialogue: 0,0:08:39.26,0:08:41.34,Caption,,0,0,0,,ЯДЕРНОГО ПЛАНИРОВАНИЯ НА ВОСТОК ЕВРОПЫ?
Dialogue: 0,0:08:41.61,0:08:43.74,Caption,,0,0,0,,ПОЧЕМУ ФИНЛЯНДИЯ? ПОЧЕМУ ИМЕННО СЕЙЧАС?
Dialogue: 0,0:08:44.13,0:08:46.62,Caption,,0,0,0,,И ЧТО ФРАНЦУЗСКАЯ ЯДЕРНАЯ КОНЦЕПЦИЯ СОБИРАЕТСЯ
Dialogue: 0,0:08:46.62,0:08:50.22,Caption,,0,0,0,,ДЕЛАТЬ ТАМ ТАКОГО, ЧЕГО НЕ СПОСОБНЫ СДЕЛАТЬ ФРАНЦУЗСКИЕ ПОДВОДНЫЕ
Dialogue: 0,0:08:50.22,0:08:53.66,Caption,,0,0,0,,ЛОДКИ? ВОТ ЗДЕСЬ СТАНОВИТСЯ ПОЛЕЗНО УБРАТЬ ПОЛИТИЧЕСКИЕ
Dialogue: 0,0:08:53.74,0:08:56.46,Caption,,0,0,0,,ТЕРМИНЫ СО СТОЛА И ОСТАВИТЬ ОБЫЧНУЮ ВОЕННУЮ
Dialogue: 0,0:08:56.46,0:08:59.90,Caption,,0,0,0,,МЕХАНИКУ. ЕСЛИ ТЫ БОИШЬСЯ ПЕРВОГО УДАРА ПРОТИВНИКА,
Dialogue: 0,0:09:00.12,0:09:01.98,Caption,,0,0,0,,ЧТО ТЫ ДЕЛАЕШЬ? ПРЯЧЕШЬ ОРУЖИЕ.
Dialogue: 0,0:09:04.25,0:09:07.29,Caption,,0,0,0,,РАССРЕДОТОЧИВАЕШЬ ЕГО. ЗАЩИЩАЕШЬ КОМАНДОВАНИЕ.
Dialogue: 0,0:09:07.53,0:09:10.57,Caption,,0,0,0,,СТРОИШЬ ПРОТИВОВОЗДУШНУЮ ОБОРОНУ. УКРЕПЛЯЕШЬ СВЯЗЬ.
Dialogue: 0,0:09:10.81,0:09:14.09,Caption,,0,0,0,,СОЗДАЁШЬ ЗАПАСНЫЕ ПУНКТЫ УПРАВЛЕНИЯ. ДЕЛАЕШЬ ВСЁ,
Dialogue: 0,0:09:14.27,0:09:17.13,Caption,,0,0,0,,ЧТОБЫ ПЕРЕЖИТЬ ПЕРВЫЙ УДАР И СОХРАНИТЬ ВОЗМОЖНОСТЬ
Dialogue: 0,0:09:17.13,0:09:20.97,Caption,,0,0,0,,ОТВЕТИТЬ. ВОТ ПОЧЕМУ ПОДЛОДКИ ТАК ВАЖНЫ. ОНИ ДАЛЕКО.
Dialogue: 0,0:09:21.33,0:09:24.81,Caption,,0,0,0,,ОНИ СПРЯТАНЫ. ОНИ ЖИВУТ. А ТЕПЕРЬ ДРУГАЯ ЗАДАЧА.
Dialogue: 0,0:09:25.15,0:09:27.85,Caption,,0,0,0,,ТЕБЕ НУЖНО СОКРАТИТЬ ПРОТИВНИКУ ВРЕМЯ НА РЕАКЦИЮ.
Dialogue: 0,0:09:28.25,0:09:31.13,Caption,,0,0,0,,ТОГДА РАССТОЯНИЕ ВНЕЗАПНО СТАНОВИТСЯ ОЧЕНЬ ВАЖНЫМ.
Dialogue: 0,0:09:31.45,0:09:33.61,Caption,,0,0,0,,ЧЕМ БЛИЖЕ ПОТЕНЦИАЛЬНЫЙ НОСИТЕЛЬ К ЦЕЛИ,
Dialogue: 0,0:09:34.01,0:09:36.01,Caption,,0,0,0,,ТЕМ МЕНЬШЕ ВРЕМЕНИ НА ОБНАРУЖЕНИЕ,
Dialogue: 0,0:09:36.12,0:09:40.33,Caption,,0,0,0,,ДОКЛАД, ОЦЕНКУ, ПОЛИТИЧЕСКОЕ РЕШЕНИЕ И ОТВЕТНЫЕ ДЕЙСТВИЯ.
Dialogue: 0,0:09:40.97,0:09:43.61,Caption,,0,0,0,,И ВОТ ТУТ МНЕ ОСОБЕННО НРАВИТСЯ СЛОВО СДЕРЖИВАНИЕ.
Dialogue: 0,0:09:43.93,0:09:46.65,Caption,,0,0,0,,ОНО ОЧЕНЬ УДОБНОЕ. ИМ МОЖНО НАКРЫТЬ ПОЧТИ ВСЁ.
Dialogue: 0,0:09:47.03,0:09:50.81,Caption,,0,0,0,,САМОЛЁТЫ БЛИЖЕ К ГРАНИЦЕ? СДЕРЖИВАНИЕ. НОВАЯ ИНФРАСТРУКТУРА?
Dialogue: 0,0:09:51.04,0:09:53.93,Caption,,0,0,0,,СДЕРЖИВАНИЕ. СОВМЕСТНОЕ ЯДЕРНОЕ ПЛАНИРОВАНИЕ?
Dialogue: 0,0:09:54.22,0:09:58.17,Caption,,0,0,0,,СДЕРЖИВАНИЕ. УЧЕНИЯ? СДЕРЖИВАНИЕ. ВОЕННЫЕ СКЛАДЫ?
Dialogue: 0,0:09:58.30,0:10:01.61,Caption,,0,0,0,,СДЕРЖИВАНИЕ. ЕСЛИ ЕЩЁ ПОСТАВИТЬ СВЕРХУ ГОЛУБЯ МИРА,
Dialogue: 0,0:10:01.88,0:10:04.73,Caption,,0,0,0,,ПОЛУЧИТСЯ ВООБЩЕ ЗАМЕЧАТЕЛЬНО. НО РАКЕТА ГОЛУБЯ НЕ
Dialogue: 0,0:10:04.73,0:10:07.61,Caption,,0,0,0,,УВИДИТ. У НЕЁ ДРУГИЕ ДАТЧИКИ. ЗДЕСЬ ЕСТЬ ЕЩЁ
Dialogue: 0,0:10:07.69,0:10:10.97,Caption,,0,0,0,,ОДИН НЕПРИЯТНЫЙ МОМЕНТ. ЯДЕРНЫЕ СИЛЫ РОССИИ И ДВУХ
Dialogue: 0,0:10:10.97,0:10:14.25,Caption,,0,0,0,,ЕВРОПЕЙСКИХ ЯДЕРНЫХ ДЕРЖАВ КОЛИЧЕСТВЕННО НАХОДЯТСЯ В
Dialogue: 0,0:10:14.25,0:10:17.21,Caption,,0,0,0,,СОВЕРШЕННО РАЗНЫХ ВЕСОВЫХ КАТЕГОРИЯХ. РОССИЙСКИЙ
Dialogue: 0,0:10:17.29,0:10:19.69,Caption,,0,0,0,,ОБЩИЙ ЯДЕРНЫЙ АРСЕНАЛ ЗНАЧИТЕЛЬНО БОЛЬШЕ
Dialogue: 0,0:10:19.77,0:10:21.53,Caption,,0,0,0,,ФРАНЦУЗСКОГО И БРИТАНСКОГО ВМЕСТЕ.
Dialogue: 0,0:10:23.82,0:10:26.14,Caption,,0,0,0,,И Я СРАЗУ УБЕРУ ДЕТСКИЙ АРГУМЕНТ ПРО ТО,
Dialogue: 0,0:10:26.30,0:10:31.34,Caption,,0,0,0,,ЧТО У КОГО РАКЕТ БОЛЬШЕ, ТОТ АВТОМАТИЧЕСКИ ПОБЕДИЛ. НЕТ. ЯДЕРНАЯ ВОЙНА ТАК НЕ
Dialogue: 0,0:10:31.34,0:10:34.38,Caption,,0,0,0,,СЧИТАЕТСЯ. ЕСЛИ У ТЕБЯ ДАЖЕ НЕСКОЛЬКО ДЕСЯТКОВ
Dialogue: 0,0:10:34.38,0:10:37.18,Caption,,0,0,0,,БОЕГОЛОВОК ГАРАНТИРОВАННО ПЕРЕЖИВАЮТ ПЕРВЫЙ УДАР И
Dialogue: 0,0:10:37.18,0:10:40.94,Caption,,0,0,0,,ПРИЛЕТАЮТ В ОТВЕТ, ЛЮБОЙ ЗДРАВОМЫСЛЯЩИЙ ЧЕЛОВЕК СИЛЬНО ПОДУМАЕТ,
Dialogue: 0,0:10:41.10,0:10:44.38,Caption,,0,0,0,,СТОИТ ЛИ НАЧИНАТЬ. ИМЕННО ПОЭТОМУ АТОМНЫЕ ПОДЛОДКИ
Dialogue: 0,0:10:44.38,0:10:47.58,Caption,,0,0,0,,НАСТОЛЬКО ВАЖНЫ. НО ЗДЕСЬ ПОЯВЛЯЕТСЯ ДРУГАЯ ЛОГИКА.
Dialogue: 0,0:10:47.86,0:10:52.06,Caption,,0,0,0,,КОГДА ТВОЙ АРСЕНАЛ МЕНЬШЕ, ДЛЯ ТЕБЯ ОСОБЕННО ОПАСНА ПОТЕРЯ ЕГО ЗНАЧИТЕЛЬНОЙ
Dialogue: 0,0:10:52.06,0:10:55.10,Caption,,0,0,0,,ЧАСТИ В САМОМ НАЧАЛЕ КОНФЛИКТА. ПОДЛОДКИ ЕЩЁ НАДО
Dialogue: 0,0:10:55.18,0:10:59.02,Caption,,0,0,0,,НАЙТИ. А АЭРОДРОМ? ВОТ ОН. КОМАНДНЫЙ ПУНКТ?
Dialogue: 0,0:10:59.19,0:11:01.98,Caption,,0,0,0,,ИЗВЕСТЕН. СКЛАД? ИЗВЕСТЕН. СВЯЗЬ?
Dialogue: 0,0:11:02.38,0:11:05.42,Caption,,0,0,0,,РАБОТАЕТ ЧЕРЕЗ КОНКРЕТНУЮ ИНФРАСТРУКТУРУ. АВИАЦИЯ?
Dialogue: 0,0:11:05.88,0:11:08.06,Caption,,0,0,0,,ОНА НЕ УМЕЕТ МЕСЯЦАМИ ПЛАВАТЬ ПОД СЕВЕРНОЙ
Dialogue: 0,0:11:08.06,0:11:10.94,Caption,,0,0,0,,АТЛАНТИКОЙ. И ПОЭТОМУ У БОЛЕЕ СЛАБОЙ ПО КОЛИЧЕСТВУ
Dialogue: 0,0:11:10.94,0:11:13.90,Caption,,0,0,0,,СТОРОНЫ ВОЗНИКАЕТ ОЧЕНЬ НЕПРИЯТНЫЙ СОБЛАЗН. НЕ
Dialogue: 0,0:11:13.90,0:11:16.06,Caption,,0,0,0,,ЖДАТЬ. ПОТОМУ ЧТО ЕСЛИ ТЫ ЖДЁШЬ,
Dialogue: 0,0:11:16.21,0:11:18.94,Caption,,0,0,0,,ЧАСТЬ ТВОИХ ВОЗМОЖНОСТЕЙ МОЖЕТ ИСЧЕЗНУТЬ РАНЬШЕ,
Dialogue: 0,0:11:19.08,0:11:21.26,Caption,,0,0,0,,ЧЕМ ПОЛИТИЧЕСКОЕ РУКОВОДСТВО УСПЕЕТ РЕШИТЬ,
Dialogue: 0,0:11:21.50,0:11:24.22,Caption,,0,0,0,,ЧТО ПОРА ИМИ ПОЛЬЗОВАТЬСЯ. А ЕСЛИ НЕ ЖДЁШЬ,
Dialogue: 0,0:11:24.61,0:11:27.74,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ПРЕИМУЩЕСТВО ПЕРВОГО ХОДА. ВОТ ТОТ
Dialogue: 0,0:11:27.82,0:11:31.10,Caption,,0,0,0,,ВОПРОС, ВОКРУГ КОТОРОГО ОБЫЧНО НАЧИНАЮТ ОЧЕНЬ АККУРАТНО
Dialogue: 0,0:11:31.18,0:11:33.50,Caption,,0,0,0,,ХОДИТЬ НА ЦЫПОЧКАХ. Я ХОДИТЬ НЕ БУДУ.
Dialogue: 0,0:11:35.79,0:11:38.03,Caption,,0,0,0,,ЕСЛИ ВОЕННАЯ СИСТЕМА СОЗДАЁТ УСЛОВИЯ,
Dialogue: 0,0:11:38.19,0:11:40.75,Caption,,0,0,0,,ПРИ КОТОРЫХ В КРИЗИСЕ ПЕРВЫЙ УДАР СТАНОВИТСЯ ДЛЯ
Dialogue: 0,0:11:40.83,0:11:42.59,Caption,,0,0,0,,ОДНОЙ СТОРОНЫ ВЫГОДНЕЕ ОЖИДАНИЯ,
Dialogue: 0,0:11:42.90,0:11:46.67,Caption,,0,0,0,,ЭТО ОПАСНАЯ СИСТЕМА. КАК ЕЁ НАЗВАЛИ В ПРЕСС РЕЛИЗЕ,
Dialogue: 0,0:11:46.91,0:11:50.19,Caption,,0,0,0,,МНЕ СОВЕРШЕННО БЕЗРАЗЛИЧНО. ХОТЬ СДЕРЖИВАНИЕ. ХОТЬ
Dialogue: 0,0:11:50.27,0:11:53.15,Caption,,0,0,0,,УПРАВЛЕНИЕ ЭСКАЛАЦИЕЙ. ХОТЬ ПРОГРАММА МИРА,
Dialogue: 0,0:11:53.26,0:11:58.99,Caption,,0,0,0,,ДРУЖБЫ И ХОРОШЕГО НАСТРОЕНИЯ. ВОЕННАЯ ЛОГИКА ОТ НАЗВАНИЯ НЕ МЕНЯЕТСЯ. И ОСОБЕННО
Dialogue: 0,0:11:58.99,0:12:02.27,Caption,,0,0,0,,ИНТЕРЕСНО, ЧТО САМ СТУББ В СВОЕЙ РЕЧИ ВТОРОГО НОЯБРЯ
Dialogue: 0,0:12:02.58,0:12:04.91,Caption,,0,0,0,,ПРЯМО ГОВОРИЛ УЖЕ НЕ ТОЛЬКО О СДЕРЖИВАНИИ,
Dialogue: 0,0:12:05.23,0:12:07.71,Caption,,0,0,0,,НО И ОБ УПРАВЛЕНИИ ЭСКАЛАЦИЕЙ. ОН ЗАЯВИЛ,
Dialogue: 0,0:12:07.95,0:12:10.67,Caption,,0,0,0,,ЧТО РОЛЬ СОЕДИНЁННЫХ ШТАТОВ УМЕНЬШАЕТСЯ И ЕВРОПЕ
Dialogue: 0,0:12:10.67,0:12:12.99,Caption,,0,0,0,,НУЖНО ВСЁ БОЛЬШЕ РАССЧИТЫВАТЬ НА СОБСТВЕННЫЕ
Dialogue: 0,0:12:12.99,0:12:16.03,Caption,,0,0,0,,ВОЗМОЖНОСТИ И САМОСТОЯТЕЛЬНО УПРАВЛЯТЬ ЭСКАЛАЦИЕЙ.
Dialogue: 0,0:12:16.48,0:12:20.51,Caption,,0,0,0,,ВОТ ЭТО, КСТАТИ, КУДА ВАЖНЕЕ ПОЛОВИНЫ ГРОМКИХ ЗАЯВЛЕНИЙ ПОСЛЕДНИХ
Dialogue: 0,0:12:20.59,0:12:24.03,Caption,,0,0,0,,МЕСЯЦЕВ. ПОТОМУ ЧТО ДЕСЯТИЛЕТИЯМИ ЕВРОПА ЖИЛА ВНУТРИ
Dialogue: 0,0:12:24.03,0:12:26.75,Caption,,0,0,0,,АМЕРИКАНСКОЙ СИСТЕМЫ БЕЗОПАСНОСТИ. ЕСЛИ НАЧИНАЕТСЯ
Dialogue: 0,0:12:26.75,0:12:30.75,Caption,,0,0,0,,БОЛЬШАЯ БЕДА, ЕСТЬ ВАШИНГТОН. ЕСТЬ АМЕРИКАНСКИЕ СИЛЫ. ЕСТЬ
Dialogue: 0,0:12:30.75,0:12:33.47,Caption,,0,0,0,,АМЕРИКАНСКОЕ ЯДЕРНОЕ ОРУЖИЕ. ЕСТЬ АМЕРИКАНСКАЯ
Dialogue: 0,0:12:33.47,0:12:36.51,Caption,,0,0,0,,ЛОГИСТИКА. ЕСТЬ АМЕРИКАНСКОЕ КОМАНДОВАНИЕ. ЕСТЬ
Dialogue: 0,0:12:36.59,0:12:38.67,Caption,,0,0,0,,ЧЕЛОВЕК ЗА ОКЕАНОМ С ОЧЕНЬ БОЛЬШИМ ВОЕННЫМ
Dialogue: 0,0:12:38.67,0:12:41.87,Caption,,0,0,0,,КОШЕЛЬКОМ. А ТЕПЕРЬ ЕВРОПЕЙСКИЕ ЛИДЕРЫ САМИ НАЧИНАЮТ
Dialogue: 0,0:12:41.87,0:12:44.67,Caption,,0,0,0,,ГОВОРИТЬ АМЕРИКАНСКАЯ РОЛЬ УМЕНЬШАЕТСЯ. ЗНАЧИТ,
Dialogue: 0,0:12:44.79,0:12:48.75,Caption,,0,0,0,,ЧТО НУЖНО ДЕЛАТЬ? ПРАВИЛЬНО. СОЗДАВАТЬ СВОЁ. И ОНИ СОЗДАЮТ.
Dialogue: 0,0:12:50.94,0:12:53.58,Caption,,0,0,0,,ФРАНЦИЯ ДВИГАЕТ СВОЮ ЯДЕРНУЮ КОНЦЕПЦИЮ В СТОРОНУ
Dialogue: 0,0:12:53.58,0:12:56.30,Caption,,0,0,0,,ЕВРОПЕЙСКИХ ПАРТНЁРОВ. ФИНЛЯНДИЯ ВХОДИТ В ЭТУ
Dialogue: 0,0:12:56.30,0:12:59.26,Caption,,0,0,0,,КОНСТРУКЦИЮ. ВЕЛИКОБРИТАНИЯ И ФРАНЦИЯ СОЗДАЮТ
Dialogue: 0,0:12:59.44,0:13:02.54,Caption,,0,0,0,,MULTINATIONAL FORCE UKRAINE. ПОЛЬША СТАНОВИТСЯ
Dialogue: 0,0:13:02.54,0:13:06.62,Caption,,0,0,0,,ТЕРРИТОРИЕЙ, ГДЕ ПРОВЕРЯЮТ ЛОГИСТИКУ БУДУЩЕГО РАЗВЁРТЫВАНИЯ. НА
Dialogue: 0,0:13:06.62,0:13:09.34,Caption,,0,0,0,,ВОСТОЧНОЙ ПОЛЬСКОЙ ГРАНИЦЕ УЖЕ РАБОТАЕТ ОТДЕЛЬНАЯ
Dialogue: 0,0:13:09.34,0:13:12.30,Caption,,0,0,0,,СИСТЕМА РЕАГИРОВАНИЯ. ЕВРОПЕЙСКИЕ МИНИСТРЫ ОБОРОНЫ
Dialogue: 0,0:13:12.30,0:13:14.78,Caption,,0,0,0,,ОТДЕЛЬНО ДОГОВАРИВАЮТСЯ ПОВЫШАТЬ ГОТОВНОСТЬ,
Dialogue: 0,0:13:15.02,0:13:17.90,Caption,,0,0,0,,РАСШИРЯТЬ ВОЗМОЖНОСТИ И БРАТЬ НА ЕВРОПУ БОЛЬШУЮ
Dialogue: 0,0:13:17.90,0:13:20.38,Caption,,0,0,0,,ЧАСТЬ ОТВЕТСТВЕННОСТИ ЗА СОБСТВЕННУЮ БЕЗОПАСНОСТЬ.
Dialogue: 0,0:13:21.32,0:13:23.34,Caption,,0,0,0,,ВОТ ТЕПЕРЬ ВЕРНЁМСЯ К НОЧНОЙ ИСТОРИИ ВОЗЛЕ
Dialogue: 0,0:13:23.34,0:13:25.26,Caption,,0,0,0,,КАЛИНИНГРАДА. ПОЧЕМУ ОНА ВАЖНА?
Dialogue: 0,0:13:25.89,0:13:29.82,Caption,,0,0,0,,НЕ ПОТОМУ, ЧТО ТАМ ОБЯЗАТЕЛЬНО ПРОИЗОШЛО ЧТО ТО ГРАНДИОЗНОЕ. А
Dialogue: 0,0:13:29.82,0:13:33.90,Caption,,0,0,0,,ПОТОМУ, ЧТО ОНА ПОКАЗЫВАЕТ СТАДИЮ ПРОЦЕССА. РАНЬШЕ СТРОИЛИ
Dialogue: 0,0:13:33.90,0:13:37.18,Caption,,0,0,0,,СИСТЕМУ. ТЕПЕРЬ СИСТЕМА НАЧИНАЕТ РЕАГИРОВАТЬ. И ЭТО
Dialogue: 0,0:13:37.18,0:13:40.46,Caption,,0,0,0,,ОЧЕНЬ БОЛЬШАЯ РАЗНИЦА. ПОЖАРНАЯ ЧАСТЬ МОЖЕТ СТОЯТЬ
Dialogue: 0,0:13:40.54,0:13:43.18,Caption,,0,0,0,,ДВАДЦАТЬ ЛЕТ, И ТЫ О НЕЙ НЕ ДУМАЕШЬ. А ПОТОМ
Dialogue: 0,0:13:43.18,0:13:45.98,Caption,,0,0,0,,НОЧЬЮ ЗАВЫВАЕТ СИРЕНА, ОТКРЫВАЮТСЯ ВОРОТА,
Dialogue: 0,0:13:46.14,0:13:49.02,Caption,,0,0,0,,МАШИНЫ ВЫЛЕТАЮТ НА УЛИЦУ. И ТЫ ВДРУГ ВСПОМИНАЕШЬ,
Dialogue: 0,0:13:49.28,0:13:53.82,Caption,,0,0,0,,ЗАЧЕМ ВООБЩЕ СТРОИЛИ ЗДАНИЕ. С ЕВРОПЕЙСКОЙ ВОЕННОЙ ИНФРАСТРУКТУРОЙ СЕЙЧАС
Dialogue: 0,0:13:53.82,0:13:57.18,Caption,,0,0,0,,ПРОИСХОДИТ ПРИМЕРНО ТО ЖЕ САМОЕ. СКЛАДЫ СТРОИЛИСЬ НЕ
Dialogue: 0,0:13:57.18,0:14:00.62,Caption,,0,0,0,,РАДИ СКЛАДОВ. ДОРОГИ РАСШИРЯЛИСЬ НЕ РАДИ КРАСИВОГО
Dialogue: 0,0:14:00.62,0:14:03.66,Caption,,0,0,0,,АСФАЛЬТА. ШТАБЫ СОЗДАВАЛИСЬ НЕ РАДИ ГЕНЕРАЛЬСКИХ
Dialogue: 0,0:14:03.66,0:14:08.89,Caption,,0,0,0,,КРЕСЕЛ. КОМАНДОВАНИЕ ОТРАБАТЫВАЕТСЯ НЕ ДЛЯ ПРЕЗЕНТАЦИИ
Dialogue: 0,0:14:08.89,0:14:11.69,Caption,,0,0,0,,POWERPOINT. А ЯДЕРНЫЕ ГРУППЫ СОБИРАЮТСЯ НЕ РАДИ
Dialogue: 0,0:14:11.69,0:14:15.13,Caption,,0,0,0,,ФРАНЦУЗСКОГО КОФЕ. У ВСЕГО ЭТОГО ЕСТЬ ФУНКЦИЯ. И
Dialogue: 0,0:14:15.21,0:14:17.85,Caption,,0,0,0,,ФУНКЦИЯ ЭТА ВСЁ ОТЧЁТЛИВЕЕ СМОТРИТ НА ВОСТОК.
Dialogue: 0,0:14:18.48,0:14:21.13,Caption,,0,0,0,,ВОТ ПОЭТОМУ Я НЕ ЛЮБЛЮ ФРАЗУ ЕВРОПА ГОТОВИТСЯ
Dialogue: 0,0:14:21.21,0:14:24.49,Caption,,0,0,0,,К ВОЙНЕ. ОНА УЖЕ СЛИШКОМ МЯГКАЯ. ГОТОВИТСЯ СТУДЕНТ
Dialogue: 0,0:14:24.57,0:14:28.25,Caption,,0,0,0,,К ЭКЗАМЕНУ. ОН СИДИТ ДОМА, ЧИТАЕТ УЧЕБНИК И НАДЕЕТСЯ,
Dialogue: 0,0:14:28.34,0:14:31.13,Caption,,0,0,0,,ЧТО ПОПАДЁТСЯ ЛЁГКИЙ БИЛЕТ. ЗДЕСЬ УЖЕ ДРУГОЙ ЭТАП.
Dialogue: 0,0:14:31.36,0:14:34.01,Caption,,0,0,0,,ЗДЕСЬ ЭКЗАМЕНАЦИОННАЯ КОМИССИЯ СИДИТ ЗА СТОЛОМ.
Dialogue: 0,0:14:34.32,0:14:37.13,Caption,,0,0,0,,БИЛЕТЫ РАСПЕЧАТАНЫ. А ОДИН ЧЕЛОВЕК УЖЕ ЗАЧЕМ ТО
Dialogue: 0,0:14:37.13,0:14:40.09,Caption,,0,0,0,,ПРИШЁЛ С КАЛЬКУЛЯТОРОМ. ПОЛЬША ПРОВЕРЯЕТ ГРАНИЦУ.
Dialogue: 0,0:14:40.41,0:14:43.05,Caption,,0,0,0,,ЧЕРЕЗ НЕСКОЛЬКО ДНЕЙ ПОЛЬША ПРОВЕРЯЕТ МЕЖДУНАРОДНУЮ
Dialogue: 0,0:14:43.13,0:14:46.01,Caption,,0,0,0,,ПЕРЕБРОСКУ ВОЙСК. ФРАНЦИЯ И ФИНЛЯНДИЯ УЖЕ СОЗДАЛИ
Dialogue: 0,0:14:46.01,0:14:48.41,Caption,,0,0,0,,СОВМЕСТНЫЙ МЕХАНИЗМ ДЛЯ ОБСУЖДЕНИЯ ЯДЕРНОГО
Dialogue: 0,0:14:48.41,0:14:51.37,Caption,,0,0,0,,СДЕРЖИВАНИЯ. ЕВРОПЕЙСКИЕ СТРАНЫ УЖЕ ОБСУЖДАЮТ,
Dialogue: 0,0:14:51.53,0:14:54.97,Caption,,0,0,0,,КАК МЕНЬШЕ ЗАВИСЕТЬ ОТ США. КОМАНДНЫЕ СТРУКТУРЫ УЖЕ
Dialogue: 0,0:14:54.97,0:14:57.45,Caption,,0,0,0,,СУЩЕСТВУЮТ. ВОЕННЫЕ ОБЯЗАТЕЛЬСТВА УЖЕ
Dialogue: 0,0:14:57.45,0:15:01.45,Caption,,0,0,0,,РАСПРЕДЕЛЯЮТСЯ. МАРШРУТЫ УЖЕ СЧИТАЮТ. ЛОГИСТИКУ УЖЕ
Dialogue: 0,0:15:01.45,0:15:04.41,Caption,,0,0,0,,ПРОВЕРЯЮТ. ВОТ ЭТО И ЕСТЬ САМОЕ ОПАСНОЕ. НЕ
Dialogue: 0,0:15:04.41,0:15:08.09,Caption,,0,0,0,,ЗАЯВЛЕНИЕ. СИСТЕМА. ЗАЯВЛЕНИЕ МОЖНО ОТМЕНИТЬ.
Dialogue: 0,0:15:08.31,0:15:11.61,Caption,,0,0,0,,СЕГОДНЯ МИНИСТР ГРОЗНЫЙ. ЗАВТРА ВЫБОРЫ. ПОСЛЕЗАВТРА
Dialogue: 0,0:15:11.69,0:15:13.69,Caption,,0,0,0,,МИНИСТР ПИШЕТ МЕМУАРЫ И РАССКАЗЫВАЕТ,
Dialogue: 0,0:15:13.85,0:15:16.41,Caption,,0,0,0,,ЧТО ВСЕГДА ВЫСТУПАЛ ЗА МИР. А БЕТОННЫЙ СКЛАД
Dialogue: 0,0:15:16.41,0:15:19.61,Caption,,0,0,0,,НИКУДА НЕ БАЛЛОТИРУЕТСЯ. ОН СТОИТ. ВОЕННАЯ БАЗА НЕ
Dialogue: 0,0:15:19.61,0:15:22.01,Caption,,0,0,0,,МЕНЯЕТ МНЕНИЕ ПОСЛЕ СОЦИОЛОГИЧЕСКОГО ОПРОСА.
Dialogue: 0,0:15:24.28,0:15:27.48,Caption,,0,0,0,,ОНА СТОИТ. ШТАБ ПОСЛЕ ВЫБОРОВ НЕ ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:15:27.48,0:15:30.68,Caption,,0,0,0,,СУПЕРМАРКЕТ. ОН ПРОДОЛЖАЕТ СЧИТАТЬ ПЛАНЫ. И КОГДА
Dialogue: 0,0:15:30.76,0:15:32.52,Caption,,0,0,0,,ТАКИХ ЭЛЕМЕНТОВ СТАНОВИТСЯ МНОГО,
Dialogue: 0,0:15:32.84,0:15:35.08,Caption,,0,0,0,,ПОЛИТИЧЕСКАЯ КОНФРОНТАЦИЯ ПРЕВРАЩАЕТСЯ В
Dialogue: 0,0:15:35.08,0:15:38.28,Caption,,0,0,0,,ИНФРАСТРУКТУРУ. ДЛЯ МЕНЯ ИМЕННО ЭТО УЖЕ И ЕСТЬ
Dialogue: 0,0:15:38.28,0:15:41.08,Caption,,0,0,0,,СТАДИЯ СКРЫТЫХ ВОЕННЫХ ДЕЙСТВИЙ. НЕ ПОТОМУ,
Dialogue: 0,0:15:41.32,0:15:43.88,Caption,,0,0,0,,ЧТО ФРАНЦУЗСКИЙ ТАНК СЕГОДНЯ СТРЕЛЯЕТ ПО РОССИЙСКОМУ
Dialogue: 0,0:15:43.88,0:15:49.16,Caption,,0,0,0,,ТАНКУ. А ПОТОМУ, ЧТО ОГРОМНЫЙ ПЛАСТ ЕВРОПЕЙСКОЙ СИСТЕМЫ УЖЕ ЕЖЕДНЕВНО
Dialogue: 0,0:15:49.24,0:15:51.64,Caption,,0,0,0,,РАБОТАЕТ С РОССИЕЙ КАК С ПОТЕНЦИАЛЬНЫМ ВОЕННЫМ
Dialogue: 0,0:15:51.64,0:15:54.92,Caption,,0,0,0,,ПРОТИВНИКОМ. ЛЮДИ ПОЛУЧАЮТ ЗАРПЛАТУ ЗА ЭТУ ЗАДАЧУ.
Dialogue: 0,0:15:55.24,0:15:58.28,Caption,,0,0,0,,ШТАБЫ ПИШУТ ПЛАНЫ ПОД ЭТУ ЗАДАЧУ. МИНИСТЕРСТВА
Dialogue: 0,0:15:58.28,0:16:01.64,Caption,,0,0,0,,ВЫДЕЛЯЮТ ДЕНЬГИ ПОД ЭТУ ЗАДАЧУ. УЧЕНИЯ ПРОВЕРЯЮТ ЭТУ
Dialogue: 0,0:16:01.72,0:16:04.84,Caption,,0,0,0,,ЗАДАЧУ. ИНФРАСТРУКТУРУ СТРОЯТ ПОД ЭТУ ЗАДАЧУ. А
Dialogue: 0,0:16:04.84,0:16:08.04,Caption,,0,0,0,,ДАЛЬШЕ НАЧИНАЕТСЯ САМОЕ ПРЕКРАСНОЕ. КАЖДАЯ СТОРОНА
Dialogue: 0,0:16:08.12,0:16:11.00,Caption,,0,0,0,,ОБЪЯСНЯЕТ ВСЁ СОБСТВЕННОЙ БЕЗОПАСНОСТЬЮ. ПОЛЬША
Dialogue: 0,0:16:11.00,0:16:15.00,Caption,,0,0,0,,УСИЛИВАЕТ ГРАНИЦУ, ПОТОМУ ЧТО БОИТСЯ РОССИИ. РОССИЯ УСИЛИВАЕТ
Dialogue: 0,0:16:15.00,0:16:19.00,Caption,,0,0,0,,КАЛИНИНГРАД, ПОТОМУ ЧТО ВИДИТ ПОЛЬШУ. ПОЛЬША СМОТРИТ НА УСИЛЕНИЕ
Dialogue: 0,0:16:19.00,0:16:20.84,Caption,,0,0,0,,КАЛИНИНГРАДА И ГОВОРИТ ВОТ ВИДИТЕ,
Dialogue: 0,0:16:21.05,0:16:24.04,Caption,,0,0,0,,МЫ БЫЛИ ПРАВЫ. РОССИЯ СМОТРИТ НА ПОЛЬСКИЕ БРИГАДЫ
Dialogue: 0,0:16:24.04,0:16:27.08,Caption,,0,0,0,,И ГОВОРИТ РОВНО ТО ЖЕ САМОЕ. ФРАНЦИЯ РАСШИРЯЕТ
Dialogue: 0,0:16:27.08,0:16:29.64,Caption,,0,0,0,,ЯДЕРНОЕ СДЕРЖИВАНИЕ. РОССИЯ ПЕРЕСЧИТЫВАЕТ
Dialogue: 0,0:16:29.64,0:16:32.12,Caption,,0,0,0,,ПОТЕНЦИАЛЬНЫЕ ЦЕЛИ. ФИНЛЯНДИЯ ГОВОРИТ,
Dialogue: 0,0:16:32.34,0:16:34.04,Caption,,0,0,0,,ЧТО ХОЧЕТ БОЛЬШЕ БЕЗОПАСНОСТИ.
Dialogue: 0,0:16:36.25,0:16:39.21,Caption,,0,0,0,,В РЕЗУЛЬТАТЕ ФИНСКИЕ ВОЕННЫЕ ОБЪЕКТЫ ПОЛУЧАЮТ ЕЩЁ
Dialogue: 0,0:16:39.29,0:16:41.61,Caption,,0,0,0,,БОЛЕЕ ЗАМЕТНОЕ МЕСТО В РОССИЙСКОМ ВОЕННОМ
Dialogue: 0,0:16:41.61,0:16:44.81,Caption,,0,0,0,,ПЛАНИРОВАНИИ. ЗАМЕЧАТЕЛЬНАЯ КОНСТРУКЦИЯ. КАЖДЫЙ
Dialogue: 0,0:16:44.81,0:16:47.05,Caption,,0,0,0,,ДЕЛАЕТ СЕБЯ БЕЗОПАСНЕЕ ТАКИМ СПОСОБОМ,
Dialogue: 0,0:16:47.36,0:16:50.33,Caption,,0,0,0,,ЧТО СОСЕД НАЧИНАЕТ ЧУВСТВОВАТЬ СЕБЯ МЕНЕЕ БЕЗОПАСНО.
Dialogue: 0,0:16:50.56,0:16:53.37,Caption,,0,0,0,,СОСЕД ОТВЕЧАЕТ. ПОСЛЕ ЭТОГО ПЕРВЫЙ ПОКАЗЫВАЕТ
Dialogue: 0,0:16:53.45,0:16:58.41,Caption,,0,0,0,,ПАЛЬЦЕМ ВОТ! Я ЖЕ ГОВОРИЛ! И НАЧИНАЕТСЯ СЛЕДУЮЩИЙ КРУГ. ПРОБЛЕМА ТОЛЬКО В ТОМ,
Dialogue: 0,0:16:58.49,0:17:00.97,Caption,,0,0,0,,ЧТО КАЖДЫЙ НОВЫЙ КРУГ УЖЕ ПРОХОДИТ НЕ С
Dialogue: 0,0:17:00.97,0:17:04.41,Caption,,0,0,0,,ЧИСТОГО ЛИСТА. ПОСЛЕ ПРЕДЫДУЩЕГО ОСТАЛИСЬ ВОЙСКА.
Dialogue: 0,0:17:04.80,0:17:08.57,Caption,,0,0,0,,ОСТАЛИСЬ СКЛАДЫ. ОСТАЛИСЬ ПЛАНЫ. ОСТАЛИСЬ БЮДЖЕТЫ.
Dialogue: 0,0:17:08.81,0:17:12.41,Caption,,0,0,0,,ОСТАЛИСЬ РАКЕТЫ. ОСТАЛИСЬ ШТАБЫ. ОСТАЛАСЬ ПРИВЫЧКА
Dialogue: 0,0:17:12.41,0:17:15.61,Caption,,0,0,0,,СЧИТАТЬ БОЛЬШУЮ ВОЙНУ РЕАЛЬНЫМ РАБОЧИМ СЦЕНАРИЕМ.
Dialogue: 0,0:17:15.90,0:17:18.73,Caption,,0,0,0,,ВОТ ЭТО МЕНЯ БЕСПОКОИТ КУДА БОЛЬШЕ ЛЮБЫХ РЕЧЕЙ.
Dialogue: 0,0:17:19.33,0:17:21.61,Caption,,0,0,0,,КОГДА ВОЙНА СУЩЕСТВУЕТ ТОЛЬКО В ТЕЛЕВИЗОРЕ,
Dialogue: 0,0:17:21.84,0:17:24.33,Caption,,0,0,0,,ЕЁ ЕЩЁ МОЖНО ВЫКЛЮЧИТЬ КНОПКОЙ. КОГДА ВОЙНА
Dialogue: 0,0:17:24.33,0:17:26.81,Caption,,0,0,0,,ПРЕВРАЩАЕТСЯ В ПАПКУ НА СТОЛЕ У СОТЕН ШТАБНЫХ
Dialogue: 0,0:17:26.81,0:17:30.73,Caption,,0,0,0,,ОФИЦЕРОВ, КНОПКУ УЖЕ НАЙТИ СЛОЖНЕЕ. ПОТОМУ ЧТО ДЛЯ КАЖДОГО
Dialogue: 0,0:17:30.81,0:17:33.29,Caption,,0,0,0,,ИЗ ЭТИХ ЛЮДЕЙ ЭТО УЖЕ НЕ ФАНТАЗИЯ. ЭТО
Dialogue: 0,0:17:33.29,0:17:37.21,Caption,,0,0,0,,ЗАДАЧА. ВОТ МАРШРУТ. ВОТ СРОКИ. ВОТ КОЛИЧЕСТВО
Dialogue: 0,0:17:37.21,0:17:41.37,Caption,,0,0,0,,МАШИН. ВОТ АЭРОДРОМ. ВОТ ТОПЛИВО. ВОТ СВЯЗЬ. ВОТ
Dialogue: 0,0:17:41.37,0:17:44.41,Caption,,0,0,0,,СОЮЗНИКИ. ВОТ ПРОТИВНИК. А ПОТОМ ПРОИСХОДИТ
Dialogue: 0,0:17:44.41,0:17:47.69,Caption,,0,0,0,,ОЧЕРЕДНОЙ КРИЗИС. КТО ТО ПЕРЕСЁК ГРАНИЦУ. КТО ТО
Dialogue: 0,0:17:47.69,0:17:50.73,Caption,,0,0,0,,ПОДНЯЛ САМОЛЁТЫ. КТО ТО НЕПРАВИЛЬНО ПОНЯЛ УЧЕНИЯ.
Dialogue: 0,0:17:51.01,0:17:54.09,Caption,,0,0,0,,КТО ТО РЕШИЛ, ЧТО ДРУГАЯ СТОРОНА УЖЕ НАЧАЛА.
Dialogue: 0,0:17:56.36,0:18:00.53,Caption,,0,0,0,,И ТУТ ВЫЯСНЯЕТСЯ, ЧТО ВОКРУГ ЛЕЖИТ ОГРОМНОЕ КОЛИЧЕСТВО ЗАРАНЕЕ
Dialogue: 0,0:18:00.53,0:18:03.16,Caption,,0,0,0,,ПРИГОТОВЛЕННЫХ РЕШЕНИЙ. ОСТАЁТСЯ ТОЛЬКО ВЫБРАТЬ
Dialogue: 0,0:18:03.24,0:18:06.68,Caption,,0,0,0,,ОДНО. ПОЭТОМУ СЕГОДНЯШНЯЯ ИСТОРИЯ ДЛЯ МЕНЯ УЖЕ НЕ О
Dialogue: 0,0:18:06.68,0:18:10.04,Caption,,0,0,0,,ТОМ, ГОТОВИТСЯ ЛИ ЕВРОПА. ЭТОТ ВОПРОС ЗАКОНЧИЛСЯ.
Dialogue: 0,0:18:10.27,0:18:13.80,Caption,,0,0,0,,ГОТОВИТСЯ. И ДАВНО. ТЕПЕРЬ ВОПРОС ДРУГОЙ. КОГДА
Dialogue: 0,0:18:13.80,0:18:16.92,Caption,,0,0,0,,СИСТЕМА, КОТОРУЮ ТАК ДОЛГО СОБИРАЛИ ДЛЯ ВОЙНЫ,
Dialogue: 0,0:18:17.16,0:18:19.72,Caption,,0,0,0,,НАЧИНАЕТ ВСЁ ЧАЩЕ ИСПОЛЬЗОВАТЬСЯ В РЕАЛЬНЫХ
Dialogue: 0,0:18:19.72,0:18:23.72,Caption,,0,0,0,,КРИЗИСАХ, СКОЛЬКО ЕЩЁ ВРЕМЕНИ ОНА СМОЖЕТ ОСТАВАТЬСЯ ПРОСТО
Dialogue: 0,0:18:23.72,0:18:28.44,Caption,,0,0,0,,СИСТЕМОЙ СДЕРЖИВАНИЯ? ПОТОМУ ЧТО КАСКА УЖЕ НАДЕТА. БРОНЕЖИЛЕТ ЗАСТЁГНУТ.
Dialogue: 0,0:18:28.75,0:18:31.72,Caption,,0,0,0,,ЗАПАСНОЙ ВЫХОД ПРОВЕРЕН. ЛЮДИ СТОЯТ НА МЕСТАХ.
Dialogue: 0,0:18:31.96,0:18:34.77,Caption,,0,0,0,,КОМАНДОВАНИЕ РАБОТАЕТ. И ТЕПЕРЬ НАМ ПРОДОЛЖАЮТ
Dialogue: 0,0:18:34.77,0:18:38.12,Caption,,0,0,0,,ОБЪЯСНЯТЬ, ЧТО ВСЁ ЭТО НУЖНО ИСКЛЮЧИТЕЛЬНО ДЛЯ ТОГО,
Dialogue: 0,0:18:38.29,0:18:40.29,Caption,,0,0,0,,ЧТОБЫ НИКОГДА ЭТИМ НЕ ВОСПОЛЬЗОВАТЬСЯ.
Dialogue: 0,0:18:40.87,0:18:44.04,Caption,,0,0,0,,ОЧЕНЬ ХОТЕЛОСЬ БЫ ПОВЕРИТЬ. ТОЛЬКО ИСТОРИЯ ПОЧЕМУ ТО
Dialogue: 0,0:18:44.04,0:18:46.36,Caption,,0,0,0,,ПОСТОЯННО ПОРТИТ ТАКУЮ КРАСИВУЮ ТЕОРИЮ.
Dialogue: 0,0:18:47.01,0:18:49.72,Caption,,0,0,0,,ДЛЯ МЕНЯ НЫНЕШНЯЯ СТАДИЯ УЖЕ ВЫГЛЯДИТ КАК СКРЫТОЕ
Dialogue: 0,0:18:49.72,0:18:53.80,Caption,,0,0,0,,ВОЕННОЕ ПРОТИВОСТОЯНИЕ, КОТОРОЕ ПОСТЕПЕННО ПРЕВРАЩАЕТСЯ В НОРМАЛЬНОЕ
Dialogue: 0,0:18:53.80,0:18:57.16,Caption,,0,0,0,,СОСТОЯНИЕ ЕВРОПЫ. И ВОТ ЭТО ДЕЙСТВИТЕЛЬНО ОПАСНО.
Dialogue: 0,0:18:57.46,0:19:00.44,Caption,,0,0,0,,ПОТОМУ ЧТО БОЛЬШУЮ ВОЙНУ ЧАЩЕ ВСЕГО НАЧИНАЮТ НЕ
Dialogue: 0,0:19:00.44,0:19:03.80,Caption,,0,0,0,,В ТОТ ДЕНЬ, КОГДА КТО ТО ВНЕЗАПНО СХОДИТ С УМА. К
Dialogue: 0,0:19:03.80,0:19:06.44,Caption,,0,0,0,,НЕЙ ДОЛГО ПРИВЫКАЮТ. И ИМЕННО ПОЭТОМУ ДЛЯ МЕНЯ
Dialogue: 0,0:19:06.44,0:19:09.01,Caption,,0,0,0,,БОЛЬШАЯ ВОЙНА В ЕВРОПЕ СТАНОВИТСЯ НЕОБРАТИМОЙ.
Dialogue: 0,0:19:11.13,0:19:14.25,Caption,,0,0,0,,К НЕЙ ПРИВЫКАЮТ ЗАРАНЕЕ, А КОГДА ОНА НАЧИНАЕТСЯ,
Dialogue: 0,0:19:14.56,0:19:17.29,Caption,,0,0,0,,ВСЕ ДЕЛАЮТ ВИД, ЧТО НИЧЕГО ПОДОБНОГО НЕ ОЖИДАЛИ.
