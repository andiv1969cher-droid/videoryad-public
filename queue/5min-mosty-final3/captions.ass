Dialogue: 0,0:00:00.12,0:00:02.84,Caption,,0,0,0,,ЕСТЬ ТАКАЯ СТАРАЯ ПРИВЫЧКА СДЕЛАТЬ СОСЕДУ ГАДОСТЬ,
Dialogue: 0,0:00:02.99,0:00:04.92,Caption,,0,0,0,,А ПОТОМ ПЕРВЫМ ПОБЕЖАТЬ ЖАЛОВАТЬСЯ,
Dialogue: 0,0:00:05.08,0:00:07.32,Caption,,0,0,0,,ЧТО СОСЕД ПЛОХО СЕБЯ ВЕДЁТ. И ВЕДЬ ИНОГДА
Dialogue: 0,0:00:07.32,0:00:10.68,Caption,,0,0,0,,РАБОТАЕТ. ОСОБЕННО КОГДА ЖАЛОВАТЬСЯ ЕСТЬ КОМУ. ВОТ
Dialogue: 0,0:00:10.68,0:00:12.92,Caption,,0,0,0,,ТОЛЬКО В БОЛЬШОЙ ПОЛИТИКЕ СОСЕД ТОЖЕ УМЕЕТ
Dialogue: 0,0:00:12.92,0:00:16.20,Caption,,0,0,0,,РАЗГОВАРИВАТЬ, ПРИЧЁМ ИНОГДА С ТЕМ ЖЕ САМЫМ ЧЕЛОВЕКОМ. И
Dialogue: 0,0:00:16.20,0:00:18.76,Caption,,0,0,0,,СЕЙЧАС ВОКРУГ КРЫМСКОГО МОСТА СКЛАДЫВАЕТСЯ ИМЕННО
Dialogue: 0,0:00:18.76,0:00:21.88,Caption,,0,0,0,,ТАКАЯ ЛЮБОПЫТНАЯ ИСТОРИЯ. НО ТУТ ВОЗНИКАЕТ ОДИН
Dialogue: 0,0:00:21.88,0:00:23.64,Caption,,0,0,0,,НЕПРИЯТНЫЙ ВОПРОС А КТО СКАЗАЛ,
Dialogue: 0,0:00:23.96,0:00:26.76,Caption,,0,0,0,,ЧТО ЖАЛОВАТЬСЯ ПЕРВЫМ ОБЯЗАТЕЛЬНО ОЗНАЧАЕТ ОКАЗАТЬСЯ
Dialogue: 0,0:00:26.84,0:00:29.64,Caption,,0,0,0,,ПРАВЫМ? ЕСЛИ ВАМ ИНТЕРЕСНЫ ТАКИЕ РАЗБОРЫ,
Dialogue: 0,0:00:29.74,0:00:32.52,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ВОКРУГ КРЫМСКОГО МОСТА СНОВА
Dialogue: 0,0:00:32.52,0:00:35.72,Caption,,0,0,0,,РАЗВОРАЧИВАЕТСЯ ЦЕЛАЯ СЕРИЯ СОБЫТИЙ. НО ВАЖНЕЕ НЕ
Dialogue: 0,0:00:35.72,0:00:39.72,Caption,,0,0,0,,КОЛИЧЕСТВО УДАРОВ, А ВЫБОР ЦЕЛИ И МОМЕНТА. КРЫМСКИЙ МОСТ ДЛЯ
Dialogue: 0,0:00:39.72,0:00:42.68,Caption,,0,0,0,,РОССИИ НЕ ОБЫЧНЫЙ КУСОК БЕТОНА ЧЕРЕЗ ВОДУ. ЭТО
Dialogue: 0,0:00:42.68,0:00:45.16,Caption,,0,0,0,,ОБЪЕКТ ПОЛИТИЧЕСКИЙ, СИМВОЛИЧЕСКИЙ,
Dialogue: 0,0:00:45.32,0:00:48.52,Caption,,0,0,0,,МЕДИЙНЫЙ. УДАР ПО ТАКОМУ ОБЪЕКТУ ПОЧТИ АВТОМАТИЧЕСКИ
Dialogue: 0,0:00:48.52,0:00:51.56,Caption,,0,0,0,,ПОДНИМАЕТ ВОПРОС ОБ ОТВЕТЕ. И ВОТ ЗДЕСЬ НАЧИНАЕТСЯ
Dialogue: 0,0:00:51.56,0:00:54.68,Caption,,0,0,0,,САМОЕ ИНТЕРЕСНОЕ. ЗЕЛЕНСКОМУ ЗАВЕРШЕНИЕ КОНФЛИКТА
Dialogue: 0,0:00:54.68,0:00:57.80,Caption,,0,0,0,,ПОЛИТИЧЕСКИ НЕВЫГОДНО. ЭТО УЖЕ НЕ СЕКРЕТ ПОЛИШИНЕЛЯ.
Dialogue: 0,0:00:58.12,0:01:00.68,Caption,,0,0,0,,НО ВАЖНЕЕ ДРУГОЕ ЕСЛИ ТЕБЕ НУЖЕН НОВЫЙ ВИТОК
Dialogue: 0,0:01:00.68,0:01:03.64,Caption,,0,0,0,,КОНФРОНТАЦИИ ИМЕННО ПЕРЕД СЕРЬЁЗНЫМИ ПЕРЕГОВОРАМИ,
Dialogue: 0,0:01:03.96,0:01:07.80,Caption,,0,0,0,,ТЫ ВЫБИРАЕШЬ ТАКУЮ ТОЧКУ, ПОСЛЕ КОТОРОЙ ПРОТИВНИКУ ТРУДНО СДЕЛАТЬ ВИД,
Dialogue: 0,0:01:07.92,0:01:10.60,Caption,,0,0,0,,ЧТО НИЧЕГО НЕ ПРОИЗОШЛО. СХЕМА ПРОСТАЯ.
Dialogue: 0,0:01:12.87,0:01:15.51,Caption,,0,0,0,,КИЕВ НАНОСИТ БОЛЕЗНЕННЫЙ И ДЕМОНСТРАТИВНЫЙ УДАР.
Dialogue: 0,0:01:15.67,0:01:18.39,Caption,,0,0,0,,МОСКВА ОТВЕЧАЕТ. ПОСЛЕ ЭТОГО ЗЕЛЕНСКИЙ ВЫХОДИТ К
Dialogue: 0,0:01:18.39,0:01:20.23,Caption,,0,0,0,,ЗАПАДНОЙ АУДИТОРИИ И ГОВОРИТ ВОТ,
Dialogue: 0,0:01:20.34,0:01:23.35,Caption,,0,0,0,,СМОТРИТЕ, МЫ ЗА МИР, А РОССИЯ СНОВА БЬЁТ,
Dialogue: 0,0:01:23.43,0:01:27.11,Caption,,0,0,0,,ЗНАЧИТ, ОНА МИРА НЕ ХОЧЕТ. МЕССЕДЖ АДРЕСУЕТСЯ ПРЕЖДЕ ВСЕГО
Dialogue: 0,0:01:27.11,0:01:31.67,Caption,,0,0,0,,ТРАМПУ. КРАСИВО? НА БУМАГЕ ВПОЛНЕ. ТОЛЬКО ЕСТЬ ОДНА ПРОБЛЕМА. ТРАМП
Dialogue: 0,0:01:31.67,0:01:34.39,Caption,,0,0,0,,РАЗГОВАРИВАЕТ НЕ ТОЛЬКО С ЗЕЛЕНСКИМ. ПУТИН МОЖЕТ
Dialogue: 0,0:01:34.47,0:01:36.63,Caption,,0,0,0,,СЕСТЬ НАПРОТИВ НЕГО И СКАЗАТЬ РОВНО ОБРАТНОЕ
Dialogue: 0,0:01:36.63,0:01:39.75,Caption,,0,0,0,,ДОНАЛЬД, ПОСМОТРИТЕ НА ПОСЛЕДОВАТЕЛЬНОСТЬ. МЫ ГОВОРИМ О
Dialogue: 0,0:01:39.75,0:01:42.79,Caption,,0,0,0,,ПЕРЕГОВОРАХ. КИЕВ В ЭТОТ МОМЕНТ БЬЁТ ПО ОБЪЕКТУ,
Dialogue: 0,0:01:43.02,0:01:45.83,Caption,,0,0,0,,НА КОТОРЫЙ РОССИЯ ОБЯЗАНА РЕАГИРОВАТЬ. ПОТОМ РОССИЯ
Dialogue: 0,0:01:45.83,0:01:49.19,Caption,,0,0,0,,ОТВЕЧАЕТ, А КИЕВ ИСПОЛЬЗУЕТ ЭТОТ ОТВЕТ КАК ДОКАЗАТЕЛЬСТВО
Dialogue: 0,0:01:49.19,0:01:52.55,Caption,,0,0,0,,ТОГО, ЧТО РОССИЯ ЯКОБЫ СОРВАЛА МИР. ТАК КТО ЗДЕСЬ
Dialogue: 0,0:01:52.63,0:01:54.79,Caption,,0,0,0,,НА САМОМ ДЕЛЕ ПОДТАЛКИВАЕТ СИТУАЦИЮ ВВЕРХ?
Dialogue: 0,0:01:55.01,0:01:57.27,Caption,,0,0,0,,И ВОТ ЗДЕСЬ КОМБИНАЦИЯ НАЧИНАЕТ ИГРАТЬ УЖЕ В
Dialogue: 0,0:01:57.35,0:01:59.67,Caption,,0,0,0,,ОБЕ СТОРОНЫ. ОДНО И ТО ЖЕ СОБЫТИЕ МОЖНО
Dialogue: 0,0:01:59.67,0:02:02.71,Caption,,0,0,0,,ПРИНЕСТИ ТРАМПУ В ДВУХ УПАКОВКАХ. ЗЕЛЕНСКИЙ ПОКАЖЕТ
Dialogue: 0,0:02:02.71,0:02:05.19,Caption,,0,0,0,,РОССИЙСКИЙ ОТВЕТ. ПУТИН ПОКАЖЕТ ТО,
Dialogue: 0,0:02:05.27,0:02:07.51,Caption,,0,0,0,,ЧТО БЫЛО ПЕРЕД НИМ. А ДАЛЬШЕ ВОПРОС НЕ
Dialogue: 0,0:02:07.51,0:02:10.23,Caption,,0,0,0,,В ТОМ, КТО ГРОМЧЕ ЗАКРИЧИТ, А В ТОМ,
Dialogue: 0,0:02:10.31,0:02:13.35,Caption,,0,0,0,,КАКУЮ ПОСЛЕДОВАТЕЛЬНОСТЬ ДЕЙСТВИЙ ТРАМП СОЧТЁТ БОЛЕЕ
Dialogue: 0,0:02:13.35,0:02:15.83,Caption,,0,0,0,,УБЕДИТЕЛЬНОЙ. ОСОБЕННО С УЧЁТОМ ТОГО,
Dialogue: 0,0:02:16.07,0:02:18.63,Caption,,0,0,0,,ЧТО САМ ТРАМП ПРЯМО ГОВОРИЛ РОССИЯ ДЕЙСТВУЕТ НЕ
Dialogue: 0,0:02:18.71,0:02:21.67,Caption,,0,0,0,,В ПОЛНУЮ СИЛУ, ПУТИН МОГ БЫ ДЕЙСТВОВАТЬ НАМНОГО ЖЁСТЧЕ.
Dialogue: 0,0:02:23.95,0:02:26.43,Caption,,0,0,0,,ТО ЕСТЬ АМЕРИКАНСКИЙ ПРЕЗИДЕНТ ПРЕКРАСНО ПОНИМАЕТ,
Dialogue: 0,0:02:26.67,0:02:29.63,Caption,,0,0,0,,ЧТО У МОСКВЫ ЕСТЬ ЕЩЁ СТУПЕНИ ЭСКАЛАЦИИ. И
Dialogue: 0,0:02:29.63,0:02:32.11,Caption,,0,0,0,,ТУТ ПРЯМО ПЕРЕД БОЛЬШИМ РАЗГОВОРОМ КТО ТО НАЧИНАЕТ
Dialogue: 0,0:02:32.11,0:02:35.95,Caption,,0,0,0,,ПРОВЕРЯТЬ, НАСКОЛЬКО ЭТИ СТУПЕНИ ВЫСОКИЕ. ОЧЕНЬ СВОЕВРЕМЕННО.
Dialogue: 0,0:02:36.19,0:02:38.83,Caption,,0,0,0,,ПРИЧЁМ ПОХОЖУЮ ЛОГИКУ МЫ УЖЕ ВИДЕЛИ ПОСЛЕ СОБЫТИЙ
Dialogue: 0,0:02:38.83,0:02:41.47,Caption,,0,0,0,,ОКТЯБРЯ ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ВТОРОГО ГОДА. ТОГДА УДАР
Dialogue: 0,0:02:41.47,0:02:43.63,Caption,,0,0,0,,ПО КРЫМСКОМУ МОСТУ СТАЛ ОДНОЙ ИЗ ТОЧЕК,
Dialogue: 0,0:02:43.87,0:02:46.35,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ РОССИЯ РЕЗКО РАСШИРИЛА УДАРЫ ПО
Dialogue: 0,0:02:46.35,0:02:48.59,Caption,,0,0,0,,УКРАИНСКОЙ ЭНЕРГЕТИКЕ. В КИЕВЕ ЭТУ
Dialogue: 0,0:02:48.59,0:02:50.35,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТЬ ПОМНЯТ НЕ ХУЖЕ,
Dialogue: 0,0:02:50.43,0:02:55.15,Caption,,0,0,0,,ЧЕМ В МОСКВЕ. ЗНАЧИТ, ПОСЛЕДСТВИЯ ТАКОГО ШАГА НЕВОЗМОЖНО БЫЛО ВООБЩЕ НЕ
Dialogue: 0,0:02:55.15,0:02:58.03,Caption,,0,0,0,,УЧИТЫВАТЬ. И ТУТ ПОЯВЛЯЮТСЯ ОЧЕНЬ ЛЮБОПЫТНЫЕ
Dialogue: 0,0:02:58.03,0:03:00.59,Caption,,0,0,0,,ПРЕДУПРЕЖДЕНИЯ. ПРЕДСТАВИТЕЛЬ УКРАИНСКИХ ВОЗДУШНЫХ
Dialogue: 0,0:03:00.59,0:03:02.43,Caption,,0,0,0,,СИЛ ЮРИЙ ИГНАТ ЗАРАНЕЕ ГОВОРИТ,
Dialogue: 0,0:03:02.76,0:03:05.15,Caption,,0,0,0,,ЧТО ПОСТУПАЕТ ИНФОРМАЦИЯ О ПОДГОТОВКЕ НОВЫХ
Dialogue: 0,0:03:05.15,0:03:07.55,Caption,,0,0,0,,РОССИЙСКИХ УДАРОВ ПО ЭНЕРГЕТИКЕ И КРИТИЧЕСКОЙ
Dialogue: 0,0:03:07.55,0:03:10.51,Caption,,0,0,0,,ИНФРАСТРУКТУРЕ. САМ ПО СЕБЕ ТАКОЙ ПРОГНОЗ НИКОГО БЫ
Dialogue: 0,0:03:10.51,0:03:13.31,Caption,,0,0,0,,ОСОБЕННО НЕ УДИВИЛ. НО РЯДОМ ПОЯВЛЯЕТСЯ ЗАЯВЛЕНИЕ
Dialogue: 0,0:03:13.31,0:03:16.11,Caption,,0,0,0,,СПИКЕРА ВЕРХОВНОЙ РАДЫ РУСЛАНА СТЕФАНЧУКА ПАРЛАМЕНТ
Dialogue: 0,0:03:16.11,0:03:18.67,Caption,,0,0,0,,ДОЛЖЕН ИМЕТЬ ВОЗМОЖНОСТЬ ПРИНИМАТЬ РЕШЕНИЯ ДАЖЕ В
Dialogue: 0,0:03:18.67,0:03:22.67,Caption,,0,0,0,,СИТУАЦИИ, ЕСЛИ ЗДАНИЕ РАДЫ БУДЕТ РАЗРУШЕНО. УКРЫТИЯ,
Dialogue: 0,0:03:22.83,0:03:27.23,Caption,,0,0,0,,АЛЬТЕРНАТИВНАЯ РАБОТА, ВОЗМОЖНОСТЬ ПРОДОЛЖАТЬ ГОЛОСОВАНИЯ. СЛИШКОМ МНОГО
Dialogue: 0,0:03:27.23,0:03:29.31,Caption,,0,0,0,,ЛЮДЕЙ ОДНОВРЕМЕННО НАЧИНАЮТ РАССКАЗЫВАТЬ,
Dialogue: 0,0:03:29.55,0:03:32.27,Caption,,0,0,0,,КАК ОНИ БУДУТ ЖИТЬ ПОСЛЕ ОЧЕНЬ СЕРЬЁЗНОГО ОТВЕТА.
Dialogue: 0,0:03:34.56,0:03:38.56,Caption,,0,0,0,,И ЗДЕСЬ ВОПРОС УЖЕ НЕ В ТОМ, УМЕЕТ ЛИ УКРАИНСКОЕ РУКОВОДСТВО ЧИТАТЬ НОВОСТИ.
Dialogue: 0,0:03:38.96,0:03:41.68,Caption,,0,0,0,,ИГНАТ И СТЕФАНЧУК НЕ ДОМОХОЗЯЙКИ С ТЕЛЕГРАМОМ В
Dialogue: 0,0:03:41.68,0:03:43.76,Caption,,0,0,0,,ТЕЛЕФОНЕ. ЭТО ЛЮДИ ИЗ ТОГО КРУГА,
Dialogue: 0,0:03:44.00,0:03:46.80,Caption,,0,0,0,,КОТОРЫЙ ПОЛУЧАЕТ ИНФОРМАЦИЮ О РИСКАХ РАНЬШЕ ОБЫЧНОГО
Dialogue: 0,0:03:46.88,0:03:50.24,Caption,,0,0,0,,ЗРИТЕЛЯ. ОНИ И ДОЛЖНЫ ЕЁ ПОЛУЧАТЬ. ПОЭТОМУ ЛОГИЧНЫЙ
Dialogue: 0,0:03:50.32,0:03:52.96,Caption,,0,0,0,,ВОПРОС ЧТО ИМЕННО БЫЛО ИЗВЕСТНО ВНУТРИ СИСТЕМЫ,
Dialogue: 0,0:03:53.12,0:03:55.60,Caption,,0,0,0,,ЕСЛИ ПУБЛИЧНЫЕ ПРЕДУПРЕЖДЕНИЯ ПОШЛИ ЗАРАНЕЕ?
Dialogue: 0,0:03:55.82,0:03:59.20,Caption,,0,0,0,,ЭТО НЕ ЗНАЧИТ, ЧТО СТЕФАНЧУК СИДЕЛ НАД КАРТОЙ КРЫМСКОГО МОСТА И
Dialogue: 0,0:03:59.20,0:04:02.80,Caption,,0,0,0,,ВЫБИРАЛ ТОЧКУ УДАРА. РЕЧЬ О ДРУГОМ. ЕСЛИ РУКОВОДСТВО
Dialogue: 0,0:04:02.80,0:04:06.16,Caption,,0,0,0,,ЗАРАНЕЕ ПОНИМАЕТ, ЧТО ВПЕРЕДИ БУДЕТ ОЧЕНЬ ТЯЖЁЛЫЙ ЭТАП,
Dialogue: 0,0:04:06.50,0:04:09.68,Caption,,0,0,0,,ЗНАЧИТ, ВНУТРИ ГОСУДАРСТВА УЖЕ СУЩЕСТВУЕТ ОЦЕНКА
Dialogue: 0,0:04:09.68,0:04:12.80,Caption,,0,0,0,,ПОСЛЕДСТВИЙ. А ВОТ ОТКУДА ЭТА ОЦЕНКА ВЗЯЛАСЬ И
Dialogue: 0,0:04:12.80,0:04:14.56,Caption,,0,0,0,,НАСКОЛЬКО ЗАРАНЕЕ ОНА ПОЯВИЛАСЬ,
Dialogue: 0,0:04:15.04,0:04:17.28,Caption,,0,0,0,,ЭТО УЖЕ НАМНОГО ИНТЕРЕСНЕЕ САМОГО ОЧЕРЕДНОГО
Dialogue: 0,0:04:17.36,0:04:19.68,Caption,,0,0,0,,СООБЩЕНИЯ О ВОЗДУШНОЙ ТРЕВОГЕ. И ТУТ У НАС
Dialogue: 0,0:04:19.76,0:04:21.92,Caption,,0,0,0,,ЕЩЁ ЗЕЛЕНСКИЙ ПРОДОЛЖАЕТ ЕЗДИТЬ ПО ЗАРУБЕЖНЫМ
Dialogue: 0,0:04:21.92,0:04:25.52,Caption,,0,0,0,,ПЛОЩАДКАМ. НУ ХОРОШО. ДОМА ОБСУЖДАЮТ НОВЫЕ УДАРЫ,
Dialogue: 0,0:04:25.68,0:04:29.76,Caption,,0,0,0,,ЭНЕРГЕТИКУ, УКРЫТИЯ И ДАЖЕ РАБОТУ ПАРЛАМЕНТА ПОСЛЕ РАЗРУШЕНИЯ
Dialogue: 0,0:04:29.76,0:04:34.24,Caption,,0,0,0,,ЗДАНИЯ. ВОВА, ВЕРНИСЬ ДОМОЙ. ТЕБЯ ЖДУТ. ШУТКИ ШУТКАМИ,
Dialogue: 0,0:04:34.48,0:04:36.72,Caption,,0,0,0,,НО ЭТА ДЕТАЛЬ ХОРОШО ЛОЖИТСЯ В ОБЩУЮ КАРТИНУ
Dialogue: 0,0:04:36.72,0:04:39.20,Caption,,0,0,0,,УКРАИНСКОЕ РУКОВОДСТВО ЯВНО РАБОТАЕТ НЕ ТОЛЬКО С
Dialogue: 0,0:04:39.20,0:04:41.36,Caption,,0,0,0,,ТЕКУЩИМИ СОБЫТИЯМИ, НО И С ТЕМ,
Dialogue: 0,0:04:41.52,0:04:45.52,Caption,,0,0,0,,ЧТО ОЖИДАЕТ ДАЛЬШЕ. А ЗНАЧИТ, СМОТРЕТЬ НАДО НЕ НА ОДИН ЭПИЗОД,
Dialogue: 0,0:04:45.68,0:04:47.44,Caption,,0,0,0,,А НА ПОДГОТОВКУ К СЛЕДУЮЩЕМУ ХОДУ.
Dialogue: 0,0:04:49.71,0:04:52.51,Caption,,0,0,0,,ЕСТЬ ЕЩЁ ОДНА НЕПОДТВЕРЖДЁННАЯ ИНФОРМАЦИЯ. И ЗДЕСЬ
Dialogue: 0,0:04:52.59,0:04:57.31,Caption,,0,0,0,,ПРЯМО СКАЖЕМ ЗА ЧТО КУПИЛ, ЗА ТО И ПРОДАЛ. ПОСЛЕ НЫНЕШНЕЙ ЭСКАЛАЦИИ РОССИЙСКИМ
Dialogue: 0,0:04:57.31,0:05:00.19,Caption,,0,0,0,,ВОЕННЫМ ЯКОБЫ СНЯЛИ ПРЕЖНИЕ ОГРАНИЧЕНИЯ ПО ВЫБОРУ
Dialogue: 0,0:05:00.19,0:05:04.67,Caption,,0,0,0,,ЦЕЛЕЙ. ПО ЭТОЙ ЖЕ ВЕРСИИ, В ВОЕННОЙ СРЕДЕ ПО ЭТОМУ ПОВОДУ ПОЧТИ ПРАЗДНИК
Dialogue: 0,0:05:04.75,0:05:07.79,Caption,,0,0,0,,ТАКОГО РЕШЕНИЯ ЖДАЛИ ГОДАМИ. ЕСЛИ ЭТА ИНФОРМАЦИЯ
Dialogue: 0,0:05:07.79,0:05:10.59,Caption,,0,0,0,,ВЕРНА, ПОСЛЕДСТВИЯ ДЛЯ КИЕВА МОГУТ ОКАЗАТЬСЯ КУДА
Dialogue: 0,0:05:10.59,0:05:13.71,Caption,,0,0,0,,НЕПРИЯТНЕЕ. ПОТОМУ ЧТО ОДНА ГРОМКАЯ ПЕРЕМОГА МОЖЕТ
Dialogue: 0,0:05:13.71,0:05:17.87,Caption,,0,0,0,,ОКАЗАТЬСЯ КНОПКОЙ, ПОСЛЕ НАЖАТИЯ НА КОТОРУЮ ПРОТИВНИК ПОЛУЧАЕТ ТО,
Dialogue: 0,0:05:18.09,0:05:20.99,Caption,,0,0,0,,ЧЕГО ДАВНО ХОТЕЛ БОЛЕЕ ШИРОКУЮ СВОБОДУ ДЕЙСТВИЙ.
Dialogue: 0,0:05:21.55,0:05:24.43,Caption,,0,0,0,,ВОТ ТОГДА И ВОЗНИКАЕТ ВОПРОС ЦЕНЫ. НЕ ТОЙ,
Dialogue: 0,0:05:24.59,0:05:26.99,Caption,,0,0,0,,КОТОРУЮ ПОКАЗЫВАЮТ В ПЕРВЫЕ ЧАСЫ ПОСЛЕ УСПЕШНОЙ
Dialogue: 0,0:05:26.99,0:05:30.11,Caption,,0,0,0,,ОПЕРАЦИИ, КОГДА ВСЕ ХЛОПАЮТ ДРУГ ДРУГА ПО ПЛЕЧУ. А
Dialogue: 0,0:05:30.19,0:05:33.39,Caption,,0,0,0,,ТОЙ, КОТОРАЯ ПРИХОДИТ ПОЗЖЕ. ЕСЛИ РАДИ КРАСИВОГО
Dialogue: 0,0:05:33.39,0:05:35.95,Caption,,0,0,0,,ПОЛИТИЧЕСКОГО ЭФФЕКТА ТЫ ДОБИЛСЯ ИЗМЕНЕНИЯ ПРАВИЛ
Dialogue: 0,0:05:35.95,0:05:38.91,Caption,,0,0,0,,ИГРЫ, ОБРАТНО ЭТИ ПРАВИЛА ПОТОМ ПО ЩЕЛЧКУ ПАЛЬЦЕВ НЕ
Dialogue: 0,0:05:38.91,0:05:42.19,Caption,,0,0,0,,ВЕРНЁШЬ. А ТЕПЕРЬ ОДНА ВАЖНАЯ ДЕТАЛЬ. ДАЖЕ ЕСЛИ
Dialogue: 0,0:05:42.19,0:05:44.83,Caption,,0,0,0,,STARLINK ДЕЙСТВИТЕЛЬНО РАБОТАЛ С ОГРАНИЧЕНИЯМИ,
Dialogue: 0,0:05:45.07,0:05:47.87,Caption,,0,0,0,,ОТДЕЛЬНЫЕ УДАРЫ ОСТАВАЛИСЬ ТОЧНЫМИ И БОЛЕЗНЕННЫМИ.
Dialogue: 0,0:05:48.03,0:05:51.63,Caption,,0,0,0,,ЗНАЧИТ, СВОДИТЬ ВСЁ К ОДНОЙ КНОПКЕ STARLINK СЛИШКОМ УДОБНО.
Dialogue: 0,0:05:51.91,0:05:54.35,Caption,,0,0,0,,ЧТОБЫ ОБЕСПЕЧИВАТЬ УСТОЙЧИВУЮ СВЯЗЬ ПО ОГРОМНОЙ
Dialogue: 0,0:05:54.43,0:05:58.03,Caption,,0,0,0,,ЛИНИИ ФРОНТА КРУГЛЫЕ СУТКИ, НУЖНА ОДНА ИНФРАСТРУКТУРА.
Dialogue: 0,0:06:00.32,0:06:02.88,Caption,,0,0,0,,ЧТОБЫ ПОМОЧЬ ПРОВЕСТИ ОДНУ КОНКРЕТНУЮ ОПЕРАЦИЮ НА
Dialogue: 0,0:06:02.88,0:06:05.36,Caption,,0,0,0,,ОГРАНИЧЕННОМ УЧАСТКЕ И В ОГРАНИЧЕННОЕ ВРЕМЯ,
Dialogue: 0,0:06:05.60,0:06:08.56,Caption,,0,0,0,,ЗАДАЧА СОВСЕМ ДРУГАЯ. ДЛЯ НЕЁ НЕ НУЖНО НАКРЫВАТЬ
Dialogue: 0,0:06:08.56,0:06:11.04,Caption,,0,0,0,,СВЯЗЬЮ ТЫСЯЧУ КИЛОМЕТРОВ И ДЕРЖАТЬ СИСТЕМУ БЕЗ
Dialogue: 0,0:06:11.04,0:06:14.08,Caption,,0,0,0,,ПЕРЕРЫВА МЕСЯЦАМИ. ЕСТЬ ДРУГИЕ СРЕДСТВА СВЯЗИ,
Dialogue: 0,0:06:14.17,0:06:17.12,Caption,,0,0,0,,НАВИГАЦИИ И РАЗВЕДКИ. ОНИ МЕНЬШЕ ПО МАСШТАБУ,
Dialogue: 0,0:06:17.38,0:06:19.60,Caption,,0,0,0,,НО ДЛЯ ОТДЕЛЬНОЙ ЗАДАЧИ МАСШТАБ ВООБЩЕ НЕ
Dialogue: 0,0:06:19.60,0:06:22.80,Caption,,0,0,0,,ОБЯЗАТЕЛЬНО ГЛАВНОЕ. И ВОТ ЕЩЁ ОДНА ДЕТАЛЬ. НАД
Dialogue: 0,0:06:22.80,0:06:24.64,Caption,,0,0,0,,ЧЁРНЫМ МОРЕМ ФИКСИРОВАЛИСЬ МАРШРУТЫ
Dialogue: 0,0:06:24.64,0:06:27.68,Caption,,0,0,0,,СПЕЦИАЛИЗИРОВАННОЙ ЗАПАДНОЙ АВИАЦИИ. НА КАРТЕ
Dialogue: 0,0:06:27.68,0:06:30.24,Caption,,0,0,0,,ОДНОВРЕМЕННО ВИДНЫ БРИТАНСКИЙ РАЗВЕДЫВАТЕЛЬНЫЙ РИВЕТ
Dialogue: 0,0:06:30.24,0:06:33.92,Caption,,0,0,0,,ДЖОЙНТ, АМЕРИКАНСКИЙ АРТЕМИС ДВА И ИТАЛЬЯНСКИЙ САМОЛЁТ
Dialogue: 0,0:06:33.92,0:06:36.40,Caption,,0,0,0,,ДАЛЬНЕГО РАДИОЛОКАЦИОННОГО ОБНАРУЖЕНИЯ. НЕТ,
Dialogue: 0,0:06:36.78,0:06:40.72,Caption,,0,0,0,,ИЗ ЭТОГО НЕ СЛЕДУЕТ, ЧТО ЭКИПАЖИ ЭТИХ САМОЛЁТОВ СИДЕЛИ И НАВОДИЛИ УДАР
Dialogue: 0,0:06:40.80,0:06:43.68,Caption,,0,0,0,,НА КРЫМСКИЙ МОСТ. НЕ НАДО ПРЕВРАЩАТЬ КАРТУ ПОЛЁТОВ
Dialogue: 0,0:06:43.76,0:06:46.16,Caption,,0,0,0,,В ДЕТЕКТИВ ДЛЯ НАЧИНАЮЩИХ. НО САМА КАРТИНА
Dialogue: 0,0:06:46.16,0:06:49.04,Caption,,0,0,0,,ПОКАЗЫВАЕТ ДРУГОЕ ВОКРУГ РЕГИОНА РАБОТАЕТ СЕРЬЁЗНАЯ
Dialogue: 0,0:06:49.04,0:06:51.60,Caption,,0,0,0,,РАЗВЕДЫВАТЕЛЬНАЯ ИНФРАСТРУКТУРА НАТО. ПОЭТОМУ
Dialogue: 0,0:06:51.60,0:06:55.68,Caption,,0,0,0,,РАССУЖДАТЬ ТАК, БУДТО КРОМЕ STARLINK У КИЕВА ВООБЩЕ НЕТ ГЛАЗ,
Dialogue: 0,0:06:55.76,0:06:59.12,Caption,,0,0,0,,УШЕЙ И ТЕХНИЧЕСКОЙ ПОДДЕРЖКИ, БЫЛО БЫ СЛИШКОМ НАИВНО.
Dialogue: 0,0:07:01.40,0:07:03.48,Caption,,0,0,0,,И ВОТ ТУТ ПРОШУ НАПИСАТЬ В КОММЕНТАРИЯХ КАК
Dialogue: 0,0:07:03.48,0:07:07.48,Caption,,0,0,0,,ВЫ СЧИТАЕТЕ, ОГРАНИЧЕНИЕ ОДНОЙ БОЛЬШОЙ СИСТЕМЫ ВООБЩЕ СПОСОБНО
Dialogue: 0,0:07:07.56,0:07:09.88,Caption,,0,0,0,,ОСТАНОВИТЬ ОТДЕЛЬНЫЕ ВЫСОКОТОЧНЫЕ ОПЕРАЦИИ,
Dialogue: 0,0:07:10.20,0:07:12.76,Caption,,0,0,0,,ЕСЛИ ВОКРУГ ОСТАЁТСЯ ЦЕЛЫЙ НАБОР ДРУГИХ СРЕДСТВ
Dialogue: 0,0:07:12.76,0:07:18.04,Caption,,0,0,0,,РАЗВЕДКИ И СВЯЗИ? ПАРАЛЛЕЛЬНО ПОЯВЛЯЕТСЯ ЕЩЁ ОДНА ИСТОРИЯ. ФСБ ЗАЯВИЛА
Dialogue: 0,0:07:18.12,0:07:22.92,Caption,,0,0,0,,О ПРЕДОТВРАЩЕНИИ ОПЕРАЦИИ, КОТОРУЮ УЖЕ НАЗВАЛИ "ПАУТИНОЙ ДВА НОЛЬ". ПО ВЕРСИИ
Dialogue: 0,0:07:22.92,0:07:26.68,Caption,,0,0,0,,РОССИЙСКОЙ СПЕЦСЛУЖБЫ, РЕЧЬ ШЛА О ПОДГОТОВКЕ АТАК НА ПОРТЫ,
Dialogue: 0,0:07:26.76,0:07:30.84,Caption,,0,0,0,,КОРАБЛИ И АЭРОДРОМЫ, ДЛЯ ЧЕГО БЫЛИ ЗАГОТОВЛЕНЫ УДАРНЫЕ ДРОНЫ,
Dialogue: 0,0:07:30.92,0:07:34.20,Caption,,0,0,0,,ВЗРЫВЧАТКА И ГИДРОЦИКЛЫ. НО ГЛАВНОЕ ЗДЕСЬ НЕ
Dialogue: 0,0:07:34.28,0:07:38.76,Caption,,0,0,0,,ПЕРЕЧЕНЬ ОБОРУДОВАНИЯ, А МАСШТАБ ЗАМЫСЛА. ЕСЛИ ОДНОВРЕМЕННО РАЗВИВАЕТСЯ
Dialogue: 0,0:07:38.84,0:07:40.44,Caption,,0,0,0,,ИСТОРИЯ ВОКРУГ КРЫМСКОГО МОСТА,
Dialogue: 0,0:07:40.76,0:07:45.32,Caption,,0,0,0,,ОБСУЖДАЮТСЯ НОВЫЕ УДАРЫ, ПОЯВЛЯЮТСЯ СВЕДЕНИЯ О ПОДГОТОВКЕ ДРУГИХ ОПЕРАЦИЙ И
Dialogue: 0,0:07:45.40,0:07:47.56,Caption,,0,0,0,,ВСЁ ЭТО ПРИХОДИТСЯ НА ПЕРЕГОВОРНЫЙ ПЕРИОД,
Dialogue: 0,0:07:48.03,0:07:50.28,Caption,,0,0,0,,ТО ПЕРЕД НАМИ УЖЕ НЕ ОДИН СЛУЧАЙНЫЙ ХЛОПОК
Dialogue: 0,0:07:50.36,0:07:52.92,Caption,,0,0,0,,ДВЕРЬЮ. КТО ТО ЯВНО СТАРАЕТСЯ СДЕЛАТЬ ТАК,
Dialogue: 0,0:07:53.08,0:07:55.72,Caption,,0,0,0,,ЧТОБЫ ДВЕРЬ ВООБЩЕ НЕ ЗАКРЫВАЛАСЬ. ПОДПИШИТЕСЬ,
Dialogue: 0,0:07:55.87,0:07:58.44,Caption,,0,0,0,,ЕСЛИ ЕЩЁ НЕ ПОДПИСАЛИСЬ. И ТЕПЕРЬ ВОЗВРАЩАЕМСЯ К
Dialogue: 0,0:07:58.44,0:08:01.48,Caption,,0,0,0,,ГЛАВНОМУ. В ЭТОЙ КОМБИНАЦИИ ЕСТЬ ЕЩЁ ОДИН УЧАСТНИК.
Dialogue: 0,0:08:01.80,0:08:04.60,Caption,,0,0,0,,ЛОНДОН ПОСЛЕДОВАТЕЛЬНО ВЫСТУПАЕТ ЗА ЖЁСТКУЮ ЛИНИЮ И
Dialogue: 0,0:08:04.68,0:08:07.40,Caption,,0,0,0,,СПОСОБЕН ПОДДЕРЖАТЬ ПОЛИТИЧЕСКУЮ ВЕРСИЮ КИЕВА,
Dialogue: 0,0:08:07.62,0:08:11.00,Caption,,0,0,0,,РАССЧИТАННУЮ НА ТРАМПА. НО ЕСЛИ РАСЧЁТ ИМЕННО ТАКОЙ,
Dialogue: 0,0:08:11.24,0:08:13.32,Caption,,0,0,0,,ТО В НЁМ ЕСТЬ СЛАБОЕ МЕСТО РАЗМЕРОМ С
Dialogue: 0,0:08:13.40,0:08:17.90,Caption,,0,0,0,,ТОТ САМЫЙ КРЫМСКИЙ МОСТ. ОН ПРЕДПОЛАГАЕТ,
Dialogue: 0,0:08:18.14,0:08:20.70,Caption,,0,0,0,,ЧТО ТРАМП БУДЕТ СМОТРЕТЬ ТОЛЬКО НА ПОСЛЕДНИЙ КАДР.
Dialogue: 0,0:08:20.94,0:08:24.86,Caption,,0,0,0,,ПРИЧЁМ ТРАМП УЖЕ ГОВОРИЛ, ЧТО РОССИЯ СПОСОБНА ДЕЙСТВОВАТЬ ГОРАЗДО ЖЁСТЧЕ.
Dialogue: 0,0:08:25.09,0:08:28.78,Caption,,0,0,0,,МОСКВА ЗАЯВЛЯЕТ, ЧТО ПЕРЕГОВОРЫ НЕ БРОСАЕТ ДАЖЕ ПОСЛЕ АТАКИ НА
Dialogue: 0,0:08:28.86,0:08:31.58,Caption,,0,0,0,,МОСТ. И ЭТО ДАЁТ ПУТИНУ ВОЗМОЖНОСТЬ ПРЕДЪЯВИТЬ НЕ
Dialogue: 0,0:08:31.58,0:08:35.58,Caption,,0,0,0,,ТОЛЬКО ПОСЛЕДСТВИЯ, НО И ПРИЧИНЫ РОССИЙСКОГО ОТВЕТА. И ТОГДА ВСЯ
Dialogue: 0,0:08:35.58,0:08:38.46,Caption,,0,0,0,,КОМБИНАЦИЯ СПОСОБНА ДАТЬ ОБРАТНЫЙ ЭФФЕКТ. ВМЕСТО
Dialogue: 0,0:08:38.46,0:08:41.18,Caption,,0,0,0,,ВОПРОСА "ПОЧЕМУ РОССИЯ СНОВА УДАРИЛА?" У ТРАМПА
Dialogue: 0,0:08:41.26,0:08:44.38,Caption,,0,0,0,,ПОЯВЛЯЕТСЯ ДРУГОЙ "А ЗАЧЕМ КИЕВ ИМЕННО СЕЙЧАС СДЕЛАЛ
Dialogue: 0,0:08:44.38,0:08:47.34,Caption,,0,0,0,,ТО, ПОСЛЕ ЧЕГО ЭТОТ ОТВЕТ БЫЛ ПРАКТИЧЕСКИ НЕИЗБЕЖЕН?"
Dialogue: 0,0:08:47.82,0:08:50.38,Caption,,0,0,0,,ВОТ ЭТО ДЛЯ ЗЕЛЕНСКОГО ГОРАЗДО НЕПРИЯТНЕЕ. ПОТОМУ
Dialogue: 0,0:08:50.38,0:08:52.94,Caption,,0,0,0,,ЧТО ОДНО ДЕЛО ПРОДАВАТЬ ЗАПАДУ ОБРАЗ СТРАНЫ,
Dialogue: 0,0:08:53.19,0:08:55.98,Caption,,0,0,0,,КОТОРАЯ ТОЛЬКО ОТБИВАЕТСЯ. И СОВСЕМ ДРУГОЕ,
Dialogue: 0,0:08:56.30,0:08:58.78,Caption,,0,0,0,,КОГДА АМЕРИКАНСКИЙ ПРЕЗИДЕНТ НАЧИНАЕТ РАССМАТРИВАТЬ
Dialogue: 0,0:08:58.78,0:09:03.98,Caption,,0,0,0,,НЕ ОТДЕЛЬНЫЙ РОССИЙСКИЙ УДАР, А ВСЮ ПОСЛЕДОВАТЕЛЬНОСТЬ РЕШЕНИЙ. КТО ПОВЫСИЛ СТАВКУ
Dialogue: 0,0:09:03.98,0:09:06.14,Caption,,0,0,0,,ПЕРВЫМ? КТО ПОНИМАЛ ПОСЛЕДСТВИЯ?
Dialogue: 0,0:09:06.27,0:09:10.54,Caption,,0,0,0,,КТО ГОТОВИЛСЯ К НИМ ЗАРАНЕЕ? КТО РАССЧИТЫВАЛ ПОТОМ ИСПОЛЬЗОВАТЬ ЭТИ ПОСЛЕДСТВИЯ В
Dialogue: 0,0:09:10.54,0:09:13.18,Caption,,0,0,0,,ПЕРЕГОВОРАХ? И ТОГДА ЗАЯВЛЕНИЕ ИГНАТА,
Dialogue: 0,0:09:13.26,0:09:16.38,Caption,,0,0,0,,ПОДГОТОВКА РАДЫ, ЗАРУБЕЖНАЯ АКТИВНОСТЬ ЗЕЛЕНСКОГО,
Dialogue: 0,0:09:16.62,0:09:20.70,Caption,,0,0,0,,УДАР ПО МОСТУ, СООБЩЕНИЯ О ДРУГИХ ОПЕРАЦИЯХ И ВОЗМОЖНОЕ ИЗМЕНЕНИЕ
Dialogue: 0,0:09:20.70,0:09:23.82,Caption,,0,0,0,,РОССИЙСКИХ ОГРАНИЧЕНИЙ СКЛАДЫВАЮТСЯ УЖЕ НЕ В РАССКАЗ
Dialogue: 0,0:09:23.90,0:09:30.35,Caption,,0,0,0,,О ЕЩЁ ОДНОМ ВОЕННОМ ЭПИЗОДЕ. ОНИ СТАНОВЯТСЯ ИСТОРИЕЙ О БОРЬБЕ ЗА ПЕРЕГОВОРНУЮ
Dialogue: 0,0:09:30.35,0:09:33.55,Caption,,0,0,0,,ПОЗИЦИЮ. ПРИ ЭТОМ МОСКВА ТОЖЕ ИГРАЕТ СВОЮ ИГРУ.
Dialogue: 0,0:09:33.87,0:09:36.75,Caption,,0,0,0,,ЕЙ ВЫГОДНО ПОКАЗАТЬ ТРАМПУ МЫ ПЕРЕГОВОРЫ НЕ БРОСАЕМ,
Dialogue: 0,0:09:37.07,0:09:39.07,Caption,,0,0,0,,НО ЕСЛИ ПО НАМ БЬЮТ, ОТВЕТ БУДЕТ.
Dialogue: 0,0:09:39.79,0:09:42.19,Caption,,0,0,0,,И ЗДЕСЬ РОССИЙСКАЯ СТОРОНА ПОЛУЧАЕТ ОЧЕНЬ ПРОСТОЙ
Dialogue: 0,0:09:42.19,0:09:45.39,Caption,,0,0,0,,АРГУМЕНТ. НЕ НУЖНО ДОЛГО ОБЪЯСНЯТЬ СЛОЖНЫЕ ДОКТРИНЫ.
Dialogue: 0,0:09:45.71,0:09:48.67,Caption,,0,0,0,,ДОСТАТОЧНО ПОКАЗАТЬ ХРОНОЛОГИЮ. И ВОТ ТУТ ЦЕНА
Dialogue: 0,0:09:48.75,0:09:51.55,Caption,,0,0,0,,ОШИБКИ СТАНОВИТСЯ ОГРОМНОЙ. ЕСЛИ РАСЧЁТ КИЕВА
Dialogue: 0,0:09:51.55,0:09:54.59,Caption,,0,0,0,,СРАБОТАЕТ, РОССИЙСКИЙ ОТВЕТ ДЕЙСТВИТЕЛЬНО МОЖНО БУДЕТ
Dialogue: 0,0:09:54.67,0:09:58.03,Caption,,0,0,0,,ИСПОЛЬЗОВАТЬ КАК НОВЫЙ АРГУМЕНТ ПРОТИВ МОСКВЫ. ЕСЛИ
Dialogue: 0,0:09:58.11,0:10:01.87,Caption,,0,0,0,,НЕ СРАБОТАЕТ, ТОГДА ПЕРЕД ТРАМПОМ ОКАЖЕТСЯ СОВСЕМ ДРУГАЯ КАРТИНА
Dialogue: 0,0:10:01.87,0:10:04.11,Caption,,0,0,0,,СТОРОНА, КОТОРАЯ ГОВОРИТ О МИРЕ,
Dialogue: 0,0:10:04.27,0:10:07.15,Caption,,0,0,0,,САМА ПЕРЕД ВАЖНЫМИ КОНТАКТАМИ ЗАПУСКАЕТ ПРОЦЕСС,
Dialogue: 0,0:10:07.37,0:10:10.03,Caption,,0,0,0,,ПОСЛЕ КОТОРОГО ЭСКАЛАЦИЯ БЫЛА ПОЧТИ ГАРАНТИРОВАНА.
Dialogue: 0,0:10:10.31,0:10:12.35,Caption,,0,0,0,,ТО ЕСТЬ ОДНА И ТА ЖЕ ОПЕРАЦИЯ СПОСОБНА
Dialogue: 0,0:10:12.35,0:10:15.47,Caption,,0,0,0,,ДАТЬ ПРЯМО ПРОТИВОПОЛОЖНЫЙ ПОЛИТИЧЕСКИЙ РЕЗУЛЬТАТ. И
Dialogue: 0,0:10:15.47,0:10:17.87,Caption,,0,0,0,,ПОЭТОМУ ГЛАВНАЯ ИСТОРИЯ ЗДЕСЬ ВОВСЕ НЕ ПРО МОСТ.
Dialogue: 0,0:10:18.27,0:10:23.39,Caption,,0,0,0,,НЕ ПРО БЕТОН, ПРОЛЁТЫ, ДРОНЫ И ДАЖЕ НЕ ПРО КОЛИЧЕСТВО УДАРОВ. ГЛАВНАЯ
Dialogue: 0,0:10:23.39,0:10:27.55,Caption,,0,0,0,,ИСТОРИЯ О ТОМ, КТО СУМЕЕТ ОБЪЯСНИТЬ ТРАМПУ ПРИЧИННО СЛЕДСТВЕННУЮ
Dialogue: 0,0:10:27.55,0:10:31.63,Caption,,0,0,0,,СВЯЗЬ. ПОТОМУ ЧТО В МОМЕНТ, КОГДА СТОРОНЫ СНОВА ГОВОРЯТ О ПЕРЕГОВОРАХ,
Dialogue: 0,0:10:31.95,0:10:34.51,Caption,,0,0,0,,ГЛАВНЫМ ОРУЖИЕМ СТАНОВИТСЯ УЖЕ НЕ ТОЛЬКО РАКЕТА ИЛИ
Dialogue: 0,0:10:34.51,0:10:37.15,Caption,,0,0,0,,БЕСПИЛОТНИК. ГЛАВНЫМ ОРУЖИЕМ СТАНОВИТСЯ
Dialogue: 0,0:10:37.15,0:10:40.59,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТЬ СОБЫТИЙ. КТО ЧТО СДЕЛАЛ ПЕРВЫМ.
Dialogue: 0,0:10:40.89,0:10:46.62,Caption,,0,0,0,,КТО ЧЕГО ЖДАЛ. КТО К ЧЕМУ ГОТОВИЛСЯ. И КТО ПОТОМ ПРИШЁЛ
Dialogue: 0,0:10:46.70,0:10:50.38,Caption,,0,0,0,,К ПОСРЕДНИКУ РАССКАЗЫВАТЬ, ЧТО ОН ЗДЕСЬ ЕДИНСТВЕННЫЙ СТОРОННИК МИРА.
Dialogue: 0,0:10:51.02,0:10:53.66,Caption,,0,0,0,,ВОТ ТОЛЬКО ЕСЛИ ЭТУ КОМБИНАЦИЮ ЗАДУМАЛИ КАК ЛОВУШКУ
Dialogue: 0,0:10:53.66,0:10:56.38,Caption,,0,0,0,,ДЛЯ МОСКВЫ, СЕЙЧАС САМОЕ ВРЕМЯ ПРОВЕРИТЬ,
Dialogue: 0,0:10:56.51,0:10:58.54,Caption,,0,0,0,,НЕ ЗАХЛОПНЕТСЯ ЛИ ОНА С ДРУГОЙ СТОРОНЫ.
