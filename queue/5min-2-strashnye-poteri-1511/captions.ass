Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,УКРАИНА ДОЛЖНА СТАТЬ ВЕЛИКОЙ. ЗВУЧИТ КРАСИВО.
Dialogue: 0,0:00:03.40,0:00:06.28,Caption,,0,0,0,,ОСОБЕННО ЕСЛИ НЕ ЗАДАВАТЬ ЛИШНИХ ВОПРОСОВ. НАПРИМЕР,
Dialogue: 0,0:00:06.55,0:00:09.16,Caption,,0,0,0,,КТО ИМЕННО БУДЕТ ПОЛЬЗОВАТЬСЯ ЭТИМ ВЕЛИЧИЕМ И
Dialogue: 0,0:00:09.24,0:00:11.72,Caption,,0,0,0,,СКОЛЬКО НАРОДУ ВООБЩЕ ОСТАНЕТСЯ К ТОМУ СЧАСТЛИВОМУ
Dialogue: 0,0:00:11.72,0:00:14.36,Caption,,0,0,0,,МОМЕНТУ. ПОТОМУ ЧТО ПОЯВИЛИСЬ ТАКИЕ ОЦЕНКИ,
Dialogue: 0,0:00:14.63,0:00:17.16,Caption,,0,0,0,,ПОСЛЕ КОТОРЫХ ТОРЖЕСТВЕННУЮ РЕЧЬ ХОЧЕТСЯ НЕНАДОЛГО
Dialogue: 0,0:00:17.24,0:00:20.12,Caption,,0,0,0,,ВЫКЛЮЧИТЬ. И ПРОСТО ВЗЯТЬ КАЛЬКУЛЯТОР. ЕСЛИ ВАМ
Dialogue: 0,0:00:20.20,0:00:22.44,Caption,,0,0,0,,НРАВИТСЯ, КОГДА МЫ НЕ ПЕРЕСКАЗЫВАЕМ НОВОСТИ,
Dialogue: 0,0:00:22.60,0:00:24.12,Caption,,0,0,0,,А СКЛАДЫВАЕМ ИХ В ОДНУ КАРТИНУ,
Dialogue: 0,0:00:24.27,0:00:26.76,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:26.92,0:00:29.00,Caption,,0,0,0,,КОГДА НЕСКОЛЬКО ЦИФР ГОВОРЯТ БОЛЬШЕ,
Dialogue: 0,0:00:29.24,0:00:30.84,Caption,,0,0,0,,ЧЕМ ДЕСЯТОК ГРОМКИХ ЗАЯВЛЕНИЙ.
Dialogue: 0,0:00:31.40,0:00:33.80,Caption,,0,0,0,,УКРАИНСКИЙ ВОЛОНТЁР ГЕННАДИЙ ДРУЗЕНКО ПОПРОБОВАЛ
Dialogue: 0,0:00:33.80,0:00:36.68,Caption,,0,0,0,,ПОСЧИТАТЬ БЕЗВОЗВРАТНЫЕ ПОТЕРИ УКРАИНЫ СОВСЕМ НЕ ПО
Dialogue: 0,0:00:36.76,0:00:39.64,Caption,,0,0,0,,ОФИЦИАЛЬНЫМ СВОДКАМ. ОН ВЗЯЛ ОДИН КОНКРЕТНЫЙ ГОРОД.
Dialogue: 0,0:00:39.80,0:00:42.52,Caption,,0,0,0,,ЛОЗОВУЮ В ХАРЬКОВСКОЙ ОБЛАСТИ. ДО НАЧАЛА БОЕВЫХ
Dialogue: 0,0:00:42.52,0:00:45.08,Caption,,0,0,0,,ДЕЙСТВИЙ ТАМ ЖИЛИ ПРИМЕРНО ПЯТЬДЕСЯТ ЧЕТЫРЕ ТЫСЯЧИ
Dialogue: 0,0:00:45.08,0:00:48.20,Caption,,0,0,0,,ЧЕЛОВЕК. НА МЕСТНОЙ АЛЛЕЕ ГЕРОЕВ ДРУЗЕНКО НАСЧИТАЛ
Dialogue: 0,0:00:48.20,0:00:51.16,Caption,,0,0,0,,ДВЕСТИ СЕМЬДЕСЯТ СЕМЬ ИМЁН ПОГИБШИХ ВОЕННОСЛУЖАЩИХ.
Dialogue: 0,0:00:51.58,0:00:54.44,Caption,,0,0,0,,ДАЛЬШЕ АРИФМЕТИКА ПРОСТАЯ И ДОВОЛЬНО НЕПРИЯТНАЯ.
Dialogue: 0,0:00:54.60,0:00:58.12,Caption,,0,0,0,,ДРУЗЕНКО ГОВОРИТ, ЧТО В ЭТОМ СПИСКЕ ЕЩЁ НЕТ ЧАСТИ ПОГИБШИХ
Dialogue: 0,0:00:58.20,0:01:00.20,Caption,,0,0,0,,В ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОМ ГОДУ И ПРОПАВШИХ
Dialogue: 0,0:01:00.28,0:01:02.84,Caption,,0,0,0,,БЕЗ ВЕСТИ. ПОЭТОМУ РЕАЛЬНАЯ ЦИФРА ПО ГОРОДУ,
Dialogue: 0,0:01:03.00,0:01:07.16,Caption,,0,0,0,,ПО ЕГО ОЦЕНКЕ, УЖЕ НЕ МЕНЬШЕ ТРЁХСОТ ЧЕЛОВЕК. ЭТО БОЛЬШЕ ПОЛОВИНЫ
Dialogue: 0,0:01:07.16,0:01:09.32,Caption,,0,0,0,,ПРОЦЕНТА ДОВОЕННОГО НАСЕЛЕНИЯ ЛОЗОВОЙ.
Dialogue: 0,0:01:11.59,0:01:14.07,Caption,,0,0,0,,ПОТОМ ОН ПЕРЕНОСИТ ЭТУ ПРОПОРЦИЮ НА ДОВОЕННОЕ
Dialogue: 0,0:01:14.07,0:01:18.31,Caption,,0,0,0,,НАСЕЛЕНИЕ ВСЕЙ УКРАИНЫ, ПРИМЕРНО СОРОК ОДНУ С ПОЛОВИНОЙ МИЛЛИОН ЧЕЛОВЕК.
Dialogue: 0,0:01:18.71,0:01:21.03,Caption,,0,0,0,,ПОЛУЧАЕТСЯ НЕ ОФИЦИАЛЬНАЯ СТАТИСТИКА И НЕ
Dialogue: 0,0:01:21.03,0:01:25.51,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЙ ОТЧЁТ, А ЕГО СОБСТВЕННАЯ ОЦЕНКА МИНИМУМ ОКОЛО ДВУХСОТ ТЫСЯЧ
Dialogue: 0,0:01:25.51,0:01:28.47,Caption,,0,0,0,,ПОГИБШИХ ВОЕННЫХ. А ЕСЛИ ДОБАВИТЬ ПРОПАВШИХ БЕЗ
Dialogue: 0,0:01:28.55,0:01:31.91,Caption,,0,0,0,,ВЕСТИ, ДИАПАЗОН БЕЗВОЗВРАТНЫХ ПОТЕРЬ У НЕГО ПОДНИМАЕТСЯ ДО
Dialogue: 0,0:01:31.91,0:01:35.67,Caption,,0,0,0,,ДВУХСОТ, А ТО И ТРЁХСОТ ТЫСЯЧ ЧЕЛОВЕК. САМ ДРУЗЕНКО
Dialogue: 0,0:01:35.67,0:01:39.67,Caption,,0,0,0,,ПРИ ЭТОМ ПРИЗНАЁТ, ЧТО ЕГО РАСЧЁТЫ ОСНОВАНЫ НА ДОПУЩЕНИЯХ И НАУЧНЫМ
Dialogue: 0,0:01:39.67,0:01:42.71,Caption,,0,0,0,,ИССЛЕДОВАНИЕМ НЕ ЯВЛЯЮТСЯ. ХОРОШО. НО ДВЕСТИ
Dialogue: 0,0:01:42.71,0:01:45.59,Caption,,0,0,0,,СЕМЬДЕСЯТ СЕМЬ ФАМИЛИЙ НА АЛЛЕЕ ГЕРОЕВ ОДНОГО ГОРОДА
Dialogue: 0,0:01:45.67,0:01:47.99,Caption,,0,0,0,,ОТ ЭТОГО НИКУДА НЕ ДЕВАЮТСЯ. И ВОТ ЗДЕСЬ
Dialogue: 0,0:01:48.07,0:01:50.79,Caption,,0,0,0,,БОЛЬШИЕ ЧИСЛА ВДРУГ ПЕРЕСТАЮТ БЫТЬ ПРОСТО БОЛЬШИМИ
Dialogue: 0,0:01:50.79,0:01:55.11,Caption,,0,0,0,,ЧИСЛАМИ. СТО ТЫСЯЧ. ДВЕСТИ ТЫСЯЧ. ТРИСТА ТЫСЯЧ. К
Dialogue: 0,0:01:55.11,0:01:58.31,Caption,,0,0,0,,ТАКИМ ЦИФРАМ УХО ПРИВЫКАЕТ БЫСТРО. А НЕБОЛЬШОЙ ГОРОД
Dialogue: 0,0:01:58.40,0:02:01.35,Caption,,0,0,0,,И ДВЕСТИ СЕМЬДЕСЯТ СЕМЬ ФАМИЛИЙ ВОСПРИНИМАЮТСЯ УЖЕ
Dialogue: 0,0:02:01.35,0:02:05.51,Caption,,0,0,0,,СОВСЕМ ИНАЧЕ. НЕ ПОТОМУ, ЧТО ОДИН ГОРОД АВТОМАТИЧЕСКИ ДАЁТ НАМ ТОЧНУЮ
Dialogue: 0,0:02:05.59,0:02:07.91,Caption,,0,0,0,,СТАТИСТИКУ ПО ВСЕЙ СТРАНЕ. А ПОТОМУ,
Dialogue: 0,0:02:08.03,0:02:10.55,Caption,,0,0,0,,ЧТО МАСШТАБ НАЧИНАЕТ ВЫГЛЯДЕТЬ НЕ ПРОЦЕНТАМИ,
Dialogue: 0,0:02:10.78,0:02:15.03,Caption,,0,0,0,,А ЛЮДЬМИ. И ТУТ ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС. СКОЛЬКО ЕЩЁ ЛЮДЕЙ
Dialogue: 0,0:02:15.03,0:02:18.87,Caption,,0,0,0,,МОЖНО ПОТЕРЯТЬ, ПРЕЖДЕ ЧЕМ КТО НИБУДЬ НАЧНЁТ ВСЛУХ СПРАШИВАТЬ НЕ
Dialogue: 0,0:02:18.95,0:02:21.43,Caption,,0,0,0,,ТОЛЬКО О ПОБЕДЕ, НО И О ЦЕНЕ ДОРОГИ К НЕЙ?
Dialogue: 0,0:02:21.74,0:02:24.63,Caption,,0,0,0,,ДЕНЬГИ МОЖНО ЗАНЯТЬ. ОРУЖИЕ МОЖНО ПОЛУЧИТЬ.
Dialogue: 0,0:02:26.90,0:02:29.38,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО МОЖНО ИМПОРТИРОВАТЬ. А ПОГИБШЕГО
Dialogue: 0,0:02:29.38,0:02:31.94,Caption,,0,0,0,,ЧЕЛОВЕКА ОБРАТНО УЖЕ НЕ ЗАВЕЗЁШЬ НИ ПОЕЗДОМ,
Dialogue: 0,0:02:32.18,0:02:34.42,Caption,,0,0,0,,НИ ГРУЗОВИКОМ, НИ ЕВРОПЕЙСКИМ ТРАНШЕМ.
Dialogue: 0,0:02:35.06,0:02:37.22,Caption,,0,0,0,,И ВОТ ЗДЕСЬ ПОЯВЛЯЕТСЯ СЛЕДУЮЩАЯ АРИФМЕТИКА.
Dialogue: 0,0:02:37.70,0:02:40.02,Caption,,0,0,0,,ЖУРНАЛИСТ ДМИТРИЙ ГНАП ГОВОРИТ УЖЕ НЕ О ВОЕННЫХ
Dialogue: 0,0:02:40.02,0:02:43.86,Caption,,0,0,0,,ПОТЕРЯХ, А О НАСЕЛЕНИИ СТРАНЫ ВООБЩЕ. В ПЕРВОМ ПОЛУГОДИИ
Dialogue: 0,0:02:43.94,0:02:46.10,Caption,,0,0,0,,ДВЕ ТЫСЯЧИ ДВАДЦАТЬ ШЕСТОГО ГОДА СМЕРТНОСТЬ В
Dialogue: 0,0:02:46.18,0:02:49.54,Caption,,0,0,0,,УКРАИНЕ ПРЕВЫСИЛА РОЖДАЕМОСТЬ БОЛЕЕ ЧЕМ ВТРОЕ. БОЛЕЕ
Dialogue: 0,0:02:49.62,0:02:52.82,Caption,,0,0,0,,ЧЕМ ВТРОЕ. ПЛЮС МАССОВЫЙ ОТЪЕЗД ЛЮДЕЙ ЗА ГРАНИЦУ.
Dialogue: 0,0:02:52.98,0:02:56.02,Caption,,0,0,0,,МНОГИЕ УЖЕ ОБУСТРАИВАЮТ ТАМ ЖИЗНЬ. РАБОТА,
Dialogue: 0,0:02:56.10,0:03:00.66,Caption,,0,0,0,,ЖИЛЬЁ, ДЕТИ, ОБЫЧНАЯ ЧЕЛОВЕЧЕСКАЯ ЖИЗНЬ. В КИЕВСКОМ ИНСТИТУТЕ
Dialogue: 0,0:03:00.66,0:03:03.46,Caption,,0,0,0,,ДЕМОГРАФИИ ПРОИСХОДЯЩЕЕ НАЗЫВАЮТ ЭКЗИСТЕНЦИАЛЬНОЙ
Dialogue: 0,0:03:03.46,0:03:06.82,Caption,,0,0,0,,УГРОЗОЙ БУДУЩЕМУ СТРАНЫ. НА ЭТОМ ФОНЕ КАБМИН СОЗДАЁТ
Dialogue: 0,0:03:06.82,0:03:09.22,Caption,,0,0,0,,КООРДИНАЦИОННЫЙ ШТАБ ДЛЯ РЕАГИРОВАНИЯ НА СЛУЧАИ
Dialogue: 0,0:03:09.22,0:03:12.10,Caption,,0,0,0,,МАССОВОГО ПРИБЫТИЯ ИНОСТРАНЦЕВ. ФОРМАЛЬНО ВСЁ
Dialogue: 0,0:03:12.18,0:03:15.22,Caption,,0,0,0,,КРАСИВО. ГОСУДАРСТВЕННЫЕ ОРГАНЫ ДОЛЖНЫ БЫТЬ ГОТОВЫ,
Dialogue: 0,0:03:15.54,0:03:18.66,Caption,,0,0,0,,ЕСЛИ ВДРУГ НАЧНЁТСЯ БОЛЬШОЙ МИГРАЦИОННЫЙ ПОТОК. НО
Dialogue: 0,0:03:18.74,0:03:21.14,Caption,,0,0,0,,ГНАП СМОТРИТ НА ЭТУ ИСТОРИЮ СОВСЕМ ИНАЧЕ. ПО
Dialogue: 0,0:03:21.22,0:03:24.10,Caption,,0,0,0,,ЕГО ОЦЕНКЕ, ВЛАСТИ ЗАРАНЕЕ ГОТОВЯТСЯ К ТОМУ,
Dialogue: 0,0:03:24.26,0:03:26.74,Caption,,0,0,0,,ЧТО ДЕМОГРАФИЧЕСКИЕ И ТРУДОВЫЕ ПРОВАЛЫ ПРИДЁТСЯ
Dialogue: 0,0:03:26.74,0:03:29.38,Caption,,0,0,0,,ЗАКРЫВАТЬ ИНОСТРАНЦАМИ. ТО ЕСТЬ ПОСЛЕДОВАТЕЛЬНОСТЬ
Dialogue: 0,0:03:29.46,0:03:32.18,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАМЕЧАТЕЛЬНАЯ. СОБСТВЕННОЕ НАСЕЛЕНИЕ
Dialogue: 0,0:03:32.18,0:03:35.70,Caption,,0,0,0,,СОКРАЩАЕТСЯ. ЧАСТЬ ЛЮДЕЙ ПОГИБАЕТ. ЧАСТЬ УЕЗЖАЕТ.
Dialogue: 0,0:03:36.02,0:03:37.78,Caption,,0,0,0,,РОЖДАЕТСЯ ЛЮДЕЙ НАМНОГО МЕНЬШЕ,
Dialogue: 0,0:03:37.95,0:03:42.30,Caption,,0,0,0,,ЧЕМ УМИРАЕТ. А ПОТОМ ВОЗНИКАЕТ ВОПРОС,
Dialogue: 0,0:03:42.37,0:03:45.26,Caption,,0,0,0,,ГДЕ ВЗЯТЬ ЛЮДЕЙ. ВОТ ТУТ ГОСУДАРСТВЕННАЯ МАШИНА
Dialogue: 0,0:03:45.26,0:03:47.66,Caption,,0,0,0,,НАКОНЕЦ ПРОСЫПАЕТСЯ И ГОВОРИТ СПОКОЙНО,
Dialogue: 0,0:03:47.82,0:03:50.70,Caption,,0,0,0,,У НАС БУДЕТ ШТАБ. ОТЛИЧНО. ЛЮДЕЙ НЕТ,
Dialogue: 0,0:03:50.89,0:03:53.58,Caption,,0,0,0,,ЗАТО ШТАБ УЖЕ ПОЧТИ ЕСТЬ. ПРИ ЭТОМ ГНАП
Dialogue: 0,0:03:53.66,0:03:55.98,Caption,,0,0,0,,ОТДЕЛЬНО СТАВИТ ВОПРОС О ВОЗВРАЩЕНИИ САМИХ
Dialogue: 0,0:03:55.98,0:03:58.94,Caption,,0,0,0,,УКРАИНЦЕВ. ПОТОМУ ЧТО ОДНО ДЕЛО НАРИСОВАТЬ КРАСИВЫЙ
Dialogue: 0,0:03:58.94,0:04:01.98,Caption,,0,0,0,,ПЛАН ВОЗВРАЩЕНИЯ МИЛЛИОНОВ. СОВСЕМ ДРУГОЕ УБЕДИТЬ
Dialogue: 0,0:04:01.98,0:04:05.02,Caption,,0,0,0,,ЧЕЛОВЕКА, КОТОРЫЙ УЖЕ УСТРОИЛ ЖИЗНЬ ЗА ГРАНИЦЕЙ,
Dialogue: 0,0:04:05.23,0:04:07.90,Caption,,0,0,0,,ВСЁ БРОСИТЬ И ЕХАТЬ ОБРАТНО. ЛЮДИ ВЕДЬ НЕ
Dialogue: 0,0:04:07.98,0:04:10.14,Caption,,0,0,0,,СТОЯТ ЧЕТЫРЕ ГОДА НА ВОКЗАЛЕ С ЧЕМОДАНОМ И
Dialogue: 0,0:04:10.22,0:04:15.18,Caption,,0,0,0,,НЕ ЖДУТ, ПОКА ИМ СКАЖУТ ВСЁ, МОЖЕТЕ ВОЗВРАЩАТЬСЯ. ОНИ ЖИВУТ. И ЧЕМ ДОЛЬШЕ
Dialogue: 0,0:04:15.18,0:04:17.02,Caption,,0,0,0,,ПРОДОЛЖАЕТСЯ НЫНЕШНЯЯ СИТУАЦИЯ,
Dialogue: 0,0:04:17.18,0:04:19.82,Caption,,0,0,0,,ТЕМ СЛОЖНЕЕ БУДЕТ ВЕРНУТЬ ИХ ОБРАТНО. ПОЭТОМУ
Dialogue: 0,0:04:19.82,0:04:22.62,Caption,,0,0,0,,ИСТОРИЯ С ИНОСТРАНЦАМИ ИНТЕРЕСНА НЕ САМА ПО СЕБЕ.
Dialogue: 0,0:04:22.82,0:04:24.54,Caption,,0,0,0,,МИГРАНТЫ ЕСТЬ В ДЕСЯТКАХ СТРАН,
Dialogue: 0,0:04:24.69,0:04:26.94,Caption,,0,0,0,,НИЧЕГО НЕОБЫЧНОГО ЗДЕСЬ НЕТ. ИНТЕРЕСНА
Dialogue: 0,0:04:26.94,0:04:29.58,Caption,,0,0,0,,ПОСЛЕДОВАТЕЛЬНОСТЬ. СТРАНА ТЕРЯЕТ СОБСТВЕННОЕ
Dialogue: 0,0:04:29.58,0:04:33.02,Caption,,0,0,0,,НАСЕЛЕНИЕ, А ГОСУДАРСТВО УЖЕ СОЗДАЁТ МЕХАНИЗМЫ НА СЛУЧАЙ
Dialogue: 0,0:04:33.02,0:04:36.30,Caption,,0,0,0,,МАССОВОГО ПРИБЫТИЯ ЧУЖОГО. И ВСЁ ЭТО ПРОИСХОДИТ НА
Dialogue: 0,0:04:36.38,0:04:39.10,Caption,,0,0,0,,ФОНЕ РАЗГОВОРОВ О БУДУЩЕМ, ВОССТАНОВЛЕНИИ,
Dialogue: 0,0:04:39.17,0:04:42.86,Caption,,0,0,0,,ПОБЕДЕ И ВЕЛИЧИИ. ВЕЛИЧИЕ ВООБЩЕ ВЕЩЬ ЗАМЕЧАТЕЛЬНАЯ.
Dialogue: 0,0:04:43.10,0:04:44.77,Caption,,0,0,0,,ОСОБЕННО ПОКА НЕ НАЧИНАЕШЬ СЧИТАТЬ,
Dialogue: 0,0:04:44.94,0:04:47.82,Caption,,0,0,0,,СКОЛЬКО ЛЮДЕЙ ОСТАЛОСЬ ДЛЯ ЭТОГО ВЕЛИЧИЯ. А ТУТ
Dialogue: 0,0:04:47.82,0:04:50.62,Caption,,0,0,0,,ЕЩЁ ИРИНА ВЕРЕЩУК РЕШИЛА ДОБАВИТЬ НЕМНОГО ОПТИМИЗМА.
Dialogue: 0,0:04:52.90,0:04:55.14,Caption,,0,0,0,,ЗАМЕСТИТЕЛЬ ГЛАВЫ ОФИСА ПРЕЗИДЕНТА ГОВОРИТ
Dialogue: 0,0:04:55.14,0:04:58.58,Caption,,0,0,0,,УКРАИНЦАМ, ЧТО РАССЧИТЫВАТЬ НА СКОРОЕ ЗАВЕРШЕНИЕ КОНФЛИКТА НЕ
Dialogue: 0,0:04:58.58,0:05:03.30,Caption,,0,0,0,,СТОИТ. ПО ЕЁ СЛОВАМ, РОССИЯ УВЕЛИЧИВАЕТ ПРОИЗВОДСТВО БЕСПИЛОТНИКОВ И
Dialogue: 0,0:05:03.38,0:05:05.54,Caption,,0,0,0,,РАКЕТ, А ЗНАЧИТ ОСНОВАНИЙ СЧИТАТЬ,
Dialogue: 0,0:05:05.70,0:05:08.42,Caption,,0,0,0,,ЧТО МОСКВА ГОТОВИТСЯ К БЫСТРОМУ ОКОНЧАНИЮ БОЕВЫХ
Dialogue: 0,0:05:08.42,0:05:11.46,Caption,,0,0,0,,ДЕЙСТВИЙ, ОНА НЕ ВИДИТ. ПРЕДСТОЯЩАЯ ЗИМА,
Dialogue: 0,0:05:11.54,0:05:15.22,Caption,,0,0,0,,ГОВОРИТ ВЕРЕЩУК, БУДЕТ ТЯЖЁЛОЙ. ЭНЕРГЕТИЧЕСКАЯ ИНФРАСТРУКТУРА
Dialogue: 0,0:05:15.22,0:05:18.66,Caption,,0,0,0,,ПОВРЕЖДЕНА НАСТОЛЬКО, ЧТО ВОССТАНАВЛИВАТЬ ЕЁ УЖЕ СЛОЖНЕЕ,
Dialogue: 0,0:05:18.86,0:05:22.10,Caption,,0,0,0,,ЧЕМ ПРОШЛОЙ ЗИМОЙ. ЛЮДЯМ СОВЕТУЮТ ЗАПАСАТЬСЯ ВОДОЙ И
Dialogue: 0,0:05:22.10,0:05:24.18,Caption,,0,0,0,,ВСЕМ НЕОБХОДИМЫМ. НУ, СОБСТВЕННО,
Dialogue: 0,0:05:24.42,0:05:27.62,Caption,,0,0,0,,ОЗВУЧИЛА ОЧЕВИДНЫЕ ВЕЩИ. ПОСЛЕ ЦИФР ПО ПОТЕРЯМ И
Dialogue: 0,0:05:27.62,0:05:30.10,Caption,,0,0,0,,ДЕМОГРАФИИ ИМЕННО ТАКОЙ БОДРОЙ НОТЫ НАМ И НЕ
Dialogue: 0,0:05:30.10,0:05:33.30,Caption,,0,0,0,,ХВАТАЛО. ПОЛУЧАЕТСЯ ЗАНЯТНАЯ КОНСТРУКЦИЯ. ЛЮДЕЙ
Dialogue: 0,0:05:33.30,0:05:36.74,Caption,,0,0,0,,СТАНОВИТСЯ МЕНЬШЕ. ПОТЕРИ ПРОДОЛЖАЮТСЯ. РОЖДАЕМОСТЬ
Dialogue: 0,0:05:36.74,0:05:39.86,Caption,,0,0,0,,ПРОВАЛИЛАСЬ. МИЛЛИОНЫ НАХОДЯТСЯ ЗА ПРЕДЕЛАМИ СТРАНЫ.
Dialogue: 0,0:05:40.18,0:05:42.66,Caption,,0,0,0,,ВЕРНУТЬ ИХ СТАНОВИТСЯ ВСЁ СЛОЖНЕЕ. А ЛЮДЯМ
Dialogue: 0,0:05:42.66,0:05:46.02,Caption,,0,0,0,,ОДНОВРЕМЕННО ГОВОРЯТ БЫСТРОГО ОКОНЧАНИЯ НЕ ЖДИТЕ. НО
Dialogue: 0,0:05:46.10,0:05:48.34,Caption,,0,0,0,,СЛОВА ПРО БОЛЬШОЕ БУДУЩЕЕ ПРИ ЭТОМ НИКУДА НЕ
Dialogue: 0,0:05:48.34,0:05:51.78,Caption,,0,0,0,,ИСЧЕЗАЮТ. ВЕЛИЧИЕ НА МЕСТЕ. ПОБЕДА НА МЕСТЕ.
Dialogue: 0,0:05:51.94,0:05:55.14,Caption,,0,0,0,,ВОССТАНОВЛЕНИЕ НА МЕСТЕ. ЕВРОПЕЙСКОЕ БУДУЩЕЕ ТОЖЕ
Dialogue: 0,0:05:55.14,0:05:57.38,Caption,,0,0,0,,ГДЕ ТО РЯДОМ. ТОЛЬКО ЛЮДЕЙ ПОЧЕМУ ТО ОТ
Dialogue: 0,0:05:57.38,0:05:59.94,Caption,,0,0,0,,ЭТИХ РЕЧЕЙ БОЛЬШЕ НЕ СТАНОВИТСЯ. ЕСЛИ ВАМ БЛИЗОК
Dialogue: 0,0:06:00.02,0:06:02.34,Caption,,0,0,0,,ТАКОЙ РАЗБОР БЕЗ ДЛИННЫХ ПОЛИТИЧЕСКИХ ЛЕКЦИЙ,
Dialogue: 0,0:06:02.42,0:06:05.14,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ДАЛЬШЕ К ЧЕЛОВЕЧЕСКОЙ АРИФМЕТИКЕ
Dialogue: 0,0:06:05.14,0:06:10.62,Caption,,0,0,0,,ДОБАВЛЯЕТСЯ ХОЗЯЙСТВЕННАЯ. И ТАМ ТОЖЕ ВСЁ ВЫГЛЯДИТ ПРЕКРАСНО,
Dialogue: 0,0:06:10.76,0:06:15.26,Caption,,0,0,0,,ПОКА НЕ НАЧИНАЕШЬ СЧИТАТЬ. МЕЖДУНАРОДНОЕ ЭНЕРГЕТИЧЕСКОЕ АГЕНТСТВО ОПУБЛИКОВАЛО
Dialogue: 0,0:06:15.34,0:06:17.90,Caption,,0,0,0,,ОЦЕНКУ ГОТОВНОСТИ УКРАИНЫ К ЗИМЕ. ТАМ ЕСТЬ
Dialogue: 0,0:06:17.90,0:06:20.54,Caption,,0,0,0,,ГЕНЕРАЦИЯ, ИМПОРТ, МОЩНОСТИ,
Dialogue: 0,0:06:20.78,0:06:22.94,Caption,,0,0,0,,ЛИНИИ ПЕРЕДАЧИ И КУЧА ДРУГИХ ЦИФР,
Dialogue: 0,0:06:23.18,0:06:26.14,Caption,,0,0,0,,КОТОРЫМИ МОЖНО ПРЕКРАСНО ЗАМУЧИТЬ ЧЕЛОВЕКА. ПОЭТОМУ
Dialogue: 0,0:06:26.14,0:06:28.62,Caption,,0,0,0,,ОСТАВИМ ТОЛЬКО САМОЕ ПОНЯТНОЕ. ПРОМЫШЛЕННОЕ
Dialogue: 0,0:06:28.62,0:06:30.94,Caption,,0,0,0,,ПОТРЕБЛЕНИЕ ЭЛЕКТРИЧЕСТВА В АВГУСТЕ УПАЛО НА
Dialogue: 0,0:06:30.94,0:06:33.58,Caption,,0,0,0,,ДВАДЦАТЬ ТРИ ПРОЦЕНТА ПО СРАВНЕНИЮ С ПРОШЛЫМ ГОДОМ.
Dialogue: 0,0:06:33.90,0:06:36.54,Caption,,0,0,0,,К СЕНТЯБРЮ ДЕВЯНОСТО ПРОЦЕНТОВ МОЩНОСТЕЙ УКРАИНСКОЙ
Dialogue: 0,0:06:36.54,0:06:39.58,Caption,,0,0,0,,МЕТАЛЛУРГИИ БЫЛИ ОСТАНОВЛЕНЫ ИЛИ ПОВРЕЖДЕНЫ. В
Dialogue: 0,0:06:39.66,0:06:41.90,Caption,,0,0,0,,РЕЗУЛЬТАТЕ ПРОМЫШЛЕННЫЙ СПРОС НА ЭЛЕКТРОЭНЕРГИЮ
Dialogue: 0,0:06:41.90,0:06:45.18,Caption,,0,0,0,,СОКРАТИЛСЯ ПРИМЕРНО НА ПОЛТОРА ГИГАВАТТА. И ВОТ ТУТ
Dialogue: 0,0:06:45.18,0:06:48.14,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ЗАМЕЧАТЕЛЬНЫЙ ФОКУС. ЭЛЕКТРИЧЕСТВА ВРОДЕ
Dialogue: 0,0:06:48.22,0:06:50.30,Caption,,0,0,0,,ТРЕБУЕТСЯ МЕНЬШЕ. ТОЛЬКО НЕ ПОТОМУ,
Dialogue: 0,0:06:50.46,0:06:53.10,Caption,,0,0,0,,ЧТО СТРАНА ПОСТРОИЛА КУЧУ НОВЫХ ЭЛЕКТРОСТАНЦИЙ И
Dialogue: 0,0:06:53.10,0:06:55.26,Caption,,0,0,0,,ПРОМЫШЛЕННОСТЬ РАСЦВЕЛА. А ПОТОМУ,
Dialogue: 0,0:06:55.42,0:06:58.38,Caption,,0,0,0,,ЧТО КРУПНЫЕ ПОТРЕБИТЕЛИ ПЕРЕСТАЛИ ПОТРЕБЛЯТЬ. ЗАВОД
Dialogue: 0,0:06:58.38,0:07:01.02,Caption,,0,0,0,,НЕ РАБОТАЕТ. ЭЛЕКТРИЧЕСТВО ЕМУ БОЛЬШЕ НЕ НУЖНО.
Dialogue: 0,0:07:01.19,0:07:04.06,Caption,,0,0,0,,ЭКОНОМИЯ. ЕСЛИ ЗАКРЫТЬ ВООБЩЕ ВСЕ ЗАВОДЫ,
Dialogue: 0,0:07:04.38,0:07:07.10,Caption,,0,0,0,,МОЖНО ЕЩЁ СИЛЬНЕЕ СНИЗИТЬ ПРОМЫШЛЕННОЕ ПОТРЕБЛЕНИЕ.
Dialogue: 0,0:07:07.42,0:07:09.66,Caption,,0,0,0,,ПРАВДА, ПОТОМ ВОЗНИКНЕТ МАЛЕНЬКИЙ ВОПРОС,
Dialogue: 0,0:07:09.89,0:07:13.74,Caption,,0,0,0,,ГДЕ РАБОТА, ПРОИЗВОДСТВО И ДЕНЬГИ. С ГАЗОМ ПОХОЖАЯ ИСТОРИЯ.
Dialogue: 0,0:07:13.97,0:07:18.06,Caption,,0,0,0,,ЗАПАСЫ ХОРОШИЕ, ИМПОРТ СОКРАТИЛСЯ. И ОДНА ИЗ ПРИЧИН СНОВА ТА
Dialogue: 0,0:07:18.06,0:07:20.54,Caption,,0,0,0,,ЖЕ САМАЯ. ПРОМЫШЛЕННОСТЬ ПОТРЕБЛЯЕТ МЕНЬШЕ.
Dialogue: 0,0:07:22.82,0:07:25.78,Caption,,0,0,0,,ВОТ ТАКАЯ СВОЕОБРАЗНАЯ ОПТИМИЗАЦИЯ. НО ДАЛЬШЕ
Dialogue: 0,0:07:25.78,0:07:28.74,Caption,,0,0,0,,СТАНОВИТСЯ ЕЩЁ ВЕСЕЛЕЕ. В КИЕВСКОЙ ОБЛАСТИ СТРОЯТ
Dialogue: 0,0:07:28.74,0:07:31.46,Caption,,0,0,0,,ЗАЩИТНЫЕ СООРУЖЕНИЯ ДЛЯ ЭНЕРГЕТИЧЕСКИХ ОБЪЕКТОВ.
Dialogue: 0,0:07:31.86,0:07:34.74,Caption,,0,0,0,,ДВАДЦАТЬ ШЕСТЬ ОБЪЕКТОВ. НАРОДНЫЙ ДЕПУТАТ АЛЕКСЕЙ
Dialogue: 0,0:07:34.82,0:07:38.18,Caption,,0,0,0,,КУЧЕРЕНКО ЗАЯВЛЯЕТ НЕ ЗАВЕРШЁН НИ ОДИН. НЕ ДВАДЦАТЬ
Dialogue: 0,0:07:38.18,0:07:41.86,Caption,,0,0,0,,ПЯТЬ ИЗ ДВАДЦАТИ ШЕСТИ. НЕ ПОЛОВИНА. НОЛЬ. ОБЩАЯ
Dialogue: 0,0:07:41.86,0:07:44.42,Caption,,0,0,0,,СТОИМОСТЬ РАБОТ СОСТАВЛЯЕТ МИЛЛИАРД ВОСЕМЬСОТ
Dialogue: 0,0:07:44.50,0:07:47.06,Caption,,0,0,0,,МИЛЛИОНОВ ГРИВЕН. ПОДРЯДЧИКАМ УЖЕ ПЕРЕЧИСЛИЛИ
Dialogue: 0,0:07:47.06,0:07:49.54,Caption,,0,0,0,,СЕМЬСОТ ПЯТЬДЕСЯТ МИЛЛИОНОВ АВАНСА. И,
Dialogue: 0,0:07:49.77,0:07:53.94,Caption,,0,0,0,,ПО СЛОВАМ КУЧЕРЕНКО, ПОДРЯДЧИК ТЕПЕРЬ ТРЕБУЕТ ЕЩЁ ЧЕТЫРЕСТА МИЛЛИОНОВ.
Dialogue: 0,0:07:54.32,0:07:56.50,Caption,,0,0,0,,ВОТ ТУТ ДАЖЕ НИКАКИХ РАКЕТ ПОКА НЕ НАДО.
Dialogue: 0,0:07:56.72,0:08:00.26,Caption,,0,0,0,,ДВАДЦАТЬ ШЕСТЬ ОБЪЕКТОВ. ГОТОВО НОЛЬ. ТРИ ЧЕТВЕРТИ
Dialogue: 0,0:08:00.26,0:08:03.38,Caption,,0,0,0,,МИЛЛИАРДА ГРИВЕН АВАНСА УЖЕ УШЛИ. ТЕПЕРЬ НАДО ЕЩЁ
Dialogue: 0,0:08:03.38,0:08:06.26,Caption,,0,0,0,,ДЕНЕГ. ЗАШИБИСЬ. И ВЕДЬ ОБЪЯСНЯТЬ ЗДЕСЬ ОСОБО
Dialogue: 0,0:08:06.26,0:08:09.30,Caption,,0,0,0,,НЕЧЕГО. КОГДА ИЗ ДВАДЦАТИ ШЕСТИ ЗАЩИТНЫХ СООРУЖЕНИЙ
Dialogue: 0,0:08:09.38,0:08:12.98,Caption,,0,0,0,,НЕ ЗАКОНЧЕНО НИ ОДНОГО, НОРМАЛЬНЫЙ ЧЕЛОВЕК СПРАШИВАЕТ НЕ О СЛОЖНОЙ
Dialogue: 0,0:08:12.98,0:08:15.30,Caption,,0,0,0,,ГЕОПОЛИТИКЕ. ОН СПРАШИВАЕТ МУЖИКИ,
Dialogue: 0,0:08:15.46,0:08:19.46,Caption,,0,0,0,,А ДЕНЬГИ ГДЕ? ПОТОМУ ЧТО СХЕМА ПОКА ВЫГЛЯДИТ ОЧЕНЬ КРАСИВО. ДЕНЬГИ
Dialogue: 0,0:08:19.46,0:08:23.30,Caption,,0,0,0,,ДАЛИ. ОБЪЕКТЫ НЕ ПОЛУЧИЛИ. ДАЙТЕ ЕЩЁ ДЕНЕГ. МОЖНО,
Dialogue: 0,0:08:23.44,0:08:26.74,Caption,,0,0,0,,КОНЕЧНО, ДОЛГО РАССКАЗЫВАТЬ О СЛОЖНОСТЯХ СТРОИТЕЛЬСТВА ВО
Dialogue: 0,0:08:26.74,0:08:29.22,Caption,,0,0,0,,ВРЕМЯ КОНФЛИКТА, ДОРОГИХ МАТЕРИАЛАХ,
Dialogue: 0,0:08:29.30,0:08:33.46,Caption,,0,0,0,,ПОДРЯДЧИКАХ, СРОКАХ И ВЕЛИКОЙ ТАЙНЕ УКРАИНСКОГО БЕТОНА. НО ЕСТЬ
Dialogue: 0,0:08:33.46,0:08:36.74,Caption,,0,0,0,,КОНЕЧНЫЙ РЕЗУЛЬТАТ. ДВАДЦАТЬ ШЕСТЬ ОБЪЕКТОВ. НОЛЬ
Dialogue: 0,0:08:36.74,0:08:42.63,Caption,,0,0,0,,ЗАВЕРШЁННЫХ. СЕМЬСОТ ПЯТЬДЕСЯТ МИЛЛИОНОВ АВАНСА. ВОТ ВАМ И ВЕСЬ
Dialogue: 0,0:08:42.63,0:08:45.11,Caption,,0,0,0,,ГРАФИК. И ЕСЛИ КТО ТО ПОСЛЕ ЭТОГО СКАЖЕТ,
Dialogue: 0,0:08:45.35,0:08:47.91,Caption,,0,0,0,,ЧТО ЭНЕРГЕТИЧЕСКИЕ ОБЪЕКТЫ ОСТАЛИСЬ БЕЗ ЗАЩИТЫ
Dialogue: 0,0:08:47.91,0:08:51.03,Caption,,0,0,0,,ИСКЛЮЧИТЕЛЬНО ПОТОМУ, ЧТО ПРОТИВНИК СЛИШКОМ СИЛЬНО БЬЁТ,
Dialogue: 0,0:08:51.35,0:08:53.67,Caption,,0,0,0,,СНАЧАЛА НЕПЛОХО БЫ ЗАКОНЧИТЬ ХОТЯ БЫ ОДНО ИЗ
Dialogue: 0,0:08:53.75,0:08:56.63,Caption,,0,0,0,,ДВАДЦАТИ ШЕСТИ СООРУЖЕНИЙ. А ПОТОМ УЖЕ ОБЪЯСНЯТЬ ВСЁ
Dialogue: 0,0:08:56.63,0:08:59.11,Caption,,0,0,0,,ОСТАЛЬНОЕ. ПОТОМУ ЧТО ИНОГДА ПРОТИВНИКУ ДАЖЕ
Dialogue: 0,0:08:59.11,0:09:01.75,Caption,,0,0,0,,ПОМОГАТЬ НЕ НАДО. СВОИ СПРАВЛЯЮТСЯ. ПОКА ТАМ
Dialogue: 0,0:09:01.75,0:09:03.83,Caption,,0,0,0,,РАЗБИРАЮТСЯ С МИЛЛИАРДАМИ И СТРОЙКАМИ,
Dialogue: 0,0:09:04.13,0:09:07.27,Caption,,0,0,0,,КИЕВ УЖЕ ЭКОНОМИТ НА УЛИЧНОМ ОСВЕЩЕНИИ. В СТОЛИЦЕ
Dialogue: 0,0:09:07.35,0:09:09.83,Caption,,0,0,0,,ПОЛНОСТЬЮ ОТКЛЮЧАЮТ НАРУЖНЫЙ СВЕТ ИЗ ЗА ОСТРОЙ
Dialogue: 0,0:09:09.83,0:09:12.71,Caption,,0,0,0,,НЕХВАТКИ ЭЛЕКТРОЭНЕРГИИ. ЭЛЕКТРИЧЕСТВО В ПЕРВУЮ
Dialogue: 0,0:09:12.71,0:09:15.35,Caption,,0,0,0,,ОЧЕРЕДЬ НАПРАВЛЯЮТ НА КРИТИЧЕСКИ ВАЖНЫЕ ГОРОДСКИЕ
Dialogue: 0,0:09:15.35,0:09:18.55,Caption,,0,0,0,,ОБЪЕКТЫ. ИСКЛЮЧЕНИЕ ОСТАВЛЯЮТ ДЛЯ ОТДЕЛЬНЫХ ЛИНИЙ,
Dialogue: 0,0:09:18.71,0:09:21.59,Caption,,0,0,0,,КОТОРЫЕ ОБЕСПЕЧИВАЮТ РАБОТУ СИСТЕМ ОПОВЕЩЕНИЯ. ПРИ
Dialogue: 0,0:09:21.67,0:09:23.99,Caption,,0,0,0,,НАЛИЧИИ ЭЛЕКТРИЧЕСТВА ОНИ ПРОДОЛЖАЮТ РАБОТАТЬ ДО
Dialogue: 0,0:09:24.07,0:09:27.03,Caption,,0,0,0,,ДЕСЯТИ ВЕЧЕРА. ВОДИТЕЛЕЙ ПРОСЯТ СНИЖАТЬ СКОРОСТЬ.
Dialogue: 0,0:09:27.33,0:09:29.27,Caption,,0,0,0,,ПЕШЕХОДОВ ПОЛЬЗОВАТЬСЯ ФОНАРИКАМИ И
Dialogue: 0,0:09:29.27,0:09:32.39,Caption,,0,0,0,,СВЕТОВОЗВРАЩАЮЩИМИ ЭЛЕМЕНТАМИ. И ЗДЕСЬ ТОЖЕ НЕ НАДО
Dialogue: 0,0:09:32.47,0:09:35.99,Caption,,0,0,0,,ОБЪЯСНЯТЬ ВЗРОСЛОМУ ЧЕЛОВЕКУ, ЧТО ЕСЛИ ВЫКЛЮЧИЛИ УЛИЧНЫЕ ФОНАРИ,
Dialogue: 0,0:09:36.23,0:09:38.79,Caption,,0,0,0,,НА УЛИЦЕ СТАНОВИТСЯ ТЕМНО. СМЫСЛ НЕ В ЭТОМ.
Dialogue: 0,0:09:39.03,0:09:41.75,Caption,,0,0,0,,ПРОСТО ПОСТАВИМ РЯДОМ НЕСКОЛЬКО ЦИФР. ДВЕСТИ
Dialogue: 0,0:09:41.83,0:09:44.47,Caption,,0,0,0,,СЕМЬДЕСЯТ СЕМЬ ФАМИЛИЙ НА АЛЛЕЕ ГЕРОЕВ ОДНОГО
Dialogue: 0,0:09:44.55,0:09:47.51,Caption,,0,0,0,,ГОРОДА. ОЦЕНКА ОТ ДВУХСОТ ДО ТРЁХСОТ ТЫСЯЧ
Dialogue: 0,0:09:47.51,0:09:49.83,Caption,,0,0,0,,БЕЗВОЗВРАТНЫХ ПОТЕРЬ ПО РАСЧЁТУ ДРУЗЕНКО.
Dialogue: 0,0:09:52.11,0:09:54.67,Caption,,0,0,0,,СМЕРТНОСТЬ БОЛЕЕ ЧЕМ ВТРОЕ ВЫШЕ РОЖДАЕМОСТИ.
Dialogue: 0,0:09:55.05,0:09:57.23,Caption,,0,0,0,,ПРОМЫШЛЕННОЕ ПОТРЕБЛЕНИЕ ЭЛЕКТРИЧЕСТВА МИНУС
Dialogue: 0,0:09:57.31,0:10:00.43,Caption,,0,0,0,,ДВАДЦАТЬ ТРИ ПРОЦЕНТА. ДЕВЯНОСТО ПРОЦЕНТОВ МОЩНОСТЕЙ
Dialogue: 0,0:10:00.43,0:10:03.63,Caption,,0,0,0,,МЕТАЛЛУРГИИ ОСТАНОВЛЕНЫ ИЛИ ПОВРЕЖДЕНЫ. ДВАДЦАТЬ
Dialogue: 0,0:10:03.63,0:10:07.15,Caption,,0,0,0,,ШЕСТЬ ЗАЩИТНЫХ ОБЪЕКТОВ. НОЛЬ ЗАВЕРШЁННЫХ. СЕМЬСОТ
Dialogue: 0,0:10:07.15,0:10:10.03,Caption,,0,0,0,,ПЯТЬДЕСЯТ МИЛЛИОНОВ ГРИВЕН АВАНСА. И ВЫКЛЮЧЕННЫЕ
Dialogue: 0,0:10:10.03,0:10:13.23,Caption,,0,0,0,,УЛИЦЫ СТОЛИЦЫ. ВОТ ЗДЕСЬ ГРАФИКИ УЖЕ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:10:13.23,0:10:16.35,Caption,,0,0,0,,ПОЛЕЗНЕЕ МНОГИХ РЕЧЕЙ. И ПОСЛЕ ВСЕГО ЭТОГО ВОПРОС
Dialogue: 0,0:10:16.43,0:10:20.03,Caption,,0,0,0,,ДАЖЕ НЕ В ТОМ, СКОЛЬКО ЕЩЁ ПРОДЕРЖИТСЯ ОДНА ЭЛЕКТРОСТАНЦИЯ ИЛИ
Dialogue: 0,0:10:20.11,0:10:22.35,Caption,,0,0,0,,СКОЛЬКО ДЕНЕГ ДАДУТ ОЧЕРЕДНОМУ ПОДРЯДЧИКУ.
Dialogue: 0,0:10:22.76,0:10:25.87,Caption,,0,0,0,,ТРАНСФОРМАТОР ПОТОМ МОЖНО ЗАМЕНИТЬ. ФОНАРЬ ВКЛЮЧИТЬ.
Dialogue: 0,0:10:26.19,0:10:28.99,Caption,,0,0,0,,ДОРОГУ ПОЧИНИТЬ. ЗАЩИТНОЕ СООРУЖЕНИЕ,
Dialogue: 0,0:10:29.08,0:10:33.15,Caption,,0,0,0,,ХОЧЕТСЯ ВЕРИТЬ, КОГДА НИБУДЬ ВСЁ ТАКИ ДОСТРОИТЬ. ГОРАЗДО СЛОЖНЕЕ
Dialogue: 0,0:10:33.23,0:10:36.99,Caption,,0,0,0,,ВЕРНУТЬ ЧЕЛОВЕКА, КОТОРЫЙ ПОГИБ. И ОЧЕНЬ ТРУДНО ВЕРНУТЬ СЕМЬЮ,
Dialogue: 0,0:10:37.26,0:10:40.59,Caption,,0,0,0,,КОТОРАЯ УЕХАЛА, УСТРОИЛА ЖИЗНЬ В ДРУГОМ МЕСТЕ И БОЛЬШЕ НЕ
Dialogue: 0,0:10:40.59,0:10:42.67,Caption,,0,0,0,,ПОНИМАЕТ, ЗАЧЕМ ЕЙ ВОЗВРАЩАТЬСЯ.
Dialogue: 0,0:10:43.31,0:10:45.87,Caption,,0,0,0,,ВОТ ПОЭТОМУ РАЗГОВОР О ВЕЛИЧИИ ПРЕКРАСНО ЗВУЧИТ ДО
Dialogue: 0,0:10:45.95,0:10:49.07,Caption,,0,0,0,,ТЕХ ПОР, ПОКА РЯДОМ НЕ ПОЛОЖИЛИ КАЛЬКУЛЯТОР. А КОГДА
Dialogue: 0,0:10:49.07,0:10:53.31,Caption,,0,0,0,,ПОЛОЖИЛИ, ВЫЯСНЯЕТСЯ ОДНА НЕПРИЯТНАЯ ВЕЩЬ. СТРАНЕ МАЛО ПРОСТО
Dialogue: 0,0:10:53.39,0:10:56.35,Caption,,0,0,0,,ДОЖИТЬ ДО ОЧЕРЕДНОЙ ПОБЕДНОЙ РЕЧИ. НАДО ЕЩЁ,
Dialogue: 0,0:10:56.43,0:10:58.59,Caption,,0,0,0,,ЧТОБЫ ПОСЛЕ ЭТОЙ РЕЧИ В СТРАНЕ БЫЛО КОМУ
Dialogue: 0,0:10:58.67,0:10:58.91,Caption,,0,0,0,,ЖИТЬ.
