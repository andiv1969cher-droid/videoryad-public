Dialogue: 0,0:00:00.12,0:00:03.80,Caption,,0,0,0,,ПОХОЖЕ, МОСКВА ПЕРЕСМАТРИВАЕТ ПРЕЖНЕЕ НЕГЛАСНОЕ ПРАВИЛО,
Dialogue: 0,0:00:04.03,0:00:07.16,Caption,,0,0,0,,ЕЩЁ ВЧЕРА КАЗАВШЕЕСЯ НЕЗЫБЛЕМЫМ. СУДЯ ПО УТЕЧКЕ,
Dialogue: 0,0:00:07.48,0:00:10.12,Caption,,0,0,0,,НА ЗАКРЫТОМ УРОВНЕ ОБСУЖДАЮТ СНЯТИЕ ЗАПРЕТА НА
Dialogue: 0,0:00:10.20,0:00:13.08,Caption,,0,0,0,,ЛИКВИДАЦИЮ ВЫСШЕГО РУКОВОДСТВА УКРАИНЫ. ЗНАЧИТ,
Dialogue: 0,0:00:13.37,0:00:16.20,Caption,,0,0,0,,КРАСНЫЕ ЛИНИИ, О КОТОРЫХ ТВЕРДИЛИ ГОДАМИ,
Dialogue: 0,0:00:16.36,0:00:21.08,Caption,,0,0,0,,БОЛЬШЕ НЕ ДЕЙСТВУЮТ, А ПРЕЖНИЙ ЗАЩИЩЁННЫЙ СТАТУС ПЕРЕЧЁРКНУТ. НО ВСЁ ЭТО
Dialogue: 0,0:00:21.16,0:00:25.48,Caption,,0,0,0,,ЛИШЬ ИНСАЙД, НЕПОДТВЕРЖДЁННОЕ СООБЩЕНИЕ БЕЗ ДОКАЗАТЕЛЬСТВ. И ВСЁ
Dialogue: 0,0:00:25.56,0:00:29.40,Caption,,0,0,0,,ЖЕ ДЛЯ ЗЕЛЕНСКОГО, МИНИСТРОВ И ГЕНЕРАЛОВ ВСЁ ЭТО УЖЕ НЕ ТРЕВОЖНЫЙ
Dialogue: 0,0:00:29.40,0:00:32.04,Caption,,0,0,0,,ЗВОНОК, А ЖЁСТКИЙ БУДИЛЬНИК ПОД ПОДУШКОЙ.
Dialogue: 0,0:00:32.62,0:00:35.16,Caption,,0,0,0,,САМОЕ ПРИМЕЧАТЕЛЬНОЕ ЗДЕСЬ ДАЖЕ НЕ СОДЕРЖАНИЕ
Dialogue: 0,0:00:35.16,0:00:39.08,Caption,,0,0,0,,УТЕЧКИ, А МОМЕНТ ЕЁ ПОЯВЛЕНИЯ. ЕЩЁ НЕДАВНО УКРАИНСКОЕ
Dialogue: 0,0:00:39.16,0:00:41.72,Caption,,0,0,0,,РУКОВОДСТВО В МОСКВЕ РАССМАТРИВАЛИ КАК СТОРОНУ,
Dialogue: 0,0:00:41.88,0:00:44.76,Caption,,0,0,0,,КОТОРАЯ ПОТРЕБУЕТСЯ ДЛЯ БУДУЩИХ ПЕРЕГОВОРОВ. ВОЙНА
Dialogue: 0,0:00:44.76,0:00:48.12,Caption,,0,0,0,,КОГДА НИБУДЬ ЗАКАНЧИВАЕТСЯ, ДОКУМЕНТЫ КТО ТО ПОДПИСЫВАЕТ,
Dialogue: 0,0:00:48.33,0:00:49.96,Caption,,0,0,0,,ОБЯЗАТЕЛЬСТВА КТО ТО ПРИНИМАЕТ.
Dialogue: 0,0:00:50.60,0:00:53.24,Caption,,0,0,0,,ТЕПЕРЬ ПО СЕТИ ГУЛЯЕТ СОВСЕМ ИНОЙ СИГНАЛ ПРЕЖНЯЯ
Dialogue: 0,0:00:53.24,0:00:55.08,Caption,,0,0,0,,НЕПРИКОСНОВЕННОСТЬ МОГЛА ЗАКОНЧИТЬСЯ.
Dialogue: 0,0:00:55.37,0:00:58.44,Caption,,0,0,0,,ПОДПИСЫВАЙТЕСЬ, ЕСЛИ ХОТИТЕ ВИДЕТЬ НЕ РОССЫПЬ НОВОСТЕЙ,
Dialogue: 0,0:00:58.67,0:01:02.60,Caption,,0,0,0,,А МЕХАНИЗМ, КОТОРЫЙ ЗА НИМИ ПРЯЧЕТСЯ. СЕГОДНЯ КАЖДАЯ СЛЕДУЮЩАЯ
Dialogue: 0,0:01:02.60,0:01:05.16,Caption,,0,0,0,,ДЕТАЛЬ ДЕЛАЕТ ПРЕДЫДУЩУЮ ГОРАЗДО НЕПРИЯТНЕЕ.
Dialogue: 0,0:01:05.32,0:01:08.28,Caption,,0,0,0,,ПРЕДЫСТОРИЯ У ЭТОГО РАЗВОРОТА БОГАТАЯ. ЗА ПОСЛЕДНИЕ
Dialogue: 0,0:01:08.28,0:01:12.12,Caption,,0,0,0,,ГОДЫ ВЗРЫВАЛИСЬ АВТОМОБИЛИ, ПОГИБАЛИ РОССИЙСКИЕ ВОЕННЫЕ,
Dialogue: 0,0:01:12.37,0:01:16.12,Caption,,0,0,0,,АТАКИ ДОБИРАЛИСЬ ДО ЛЮДЕЙ, СВЯЗАННЫХ С АРМИЕЙ И ГОСУДАРСТВОМ.
Dialogue: 0,0:01:18.41,0:01:20.81,Caption,,0,0,0,,В КИЕВЕ, СУДЯ ПО ВСЕМУ, РЕШИЛИ,
Dialogue: 0,0:01:21.12,0:01:23.45,Caption,,0,0,0,,ЧТО ПОВЫШАТЬ СТАВКИ МОЖНО БЕСКОНЕЧНО,
Dialogue: 0,0:01:23.74,0:01:25.93,Caption,,0,0,0,,А ОТВЕТ ВСЕГДА ОСТАНЕТСЯ АККУРАТНЫМ,
Dialogue: 0,0:01:26.09,0:01:29.61,Caption,,0,0,0,,ПРИВЫЧНЫМ И ЗАРАНЕЕ ИЗВЕСТНЫМ. УДОБНАЯ АРИФМЕТИКА.
Dialogue: 0,0:01:29.93,0:01:32.65,Caption,,0,0,0,,ОДНОЙ СТОРОНЕ ПОЗВОЛЕНО РАСШИРЯТЬ НАБОР МЕТОДОВ,
Dialogue: 0,0:01:32.89,0:01:35.37,Caption,,0,0,0,,ВЫБИРАТЬ НОВЫЕ ЦЕЛИ И РАЗ ЗА РАЗОМ ЗАХОДИТЬ
Dialogue: 0,0:01:35.45,0:01:38.89,Caption,,0,0,0,,ДАЛЬШЕ. ДРУГАЯ ДОЛЖНА СОХРАНЯТЬ СТАРЫЕ ОГРАНИЧЕНИЯ,
Dialogue: 0,0:01:39.13,0:01:41.77,Caption,,0,0,0,,ПОТОМУ ЧТО ТАК ВСЕМ СПОКОЙНЕЕ. ОСОБЕННО ТЕМ,
Dialogue: 0,0:01:41.93,0:01:45.05,Caption,,0,0,0,,КТО ЭТИ ОГРАНИЧЕНИЯ ДАВНО ПЕРЕСТАЛ СОБЛЮДАТЬ. С ЧЕГО
Dialogue: 0,0:01:45.05,0:01:50.01,Caption,,0,0,0,,БЫ ВДРУГ ТАКАЯ ЩЕДРОСТЬ? ЕСТЬ И БОЛЕЕ ХИТРАЯ ВЕРСИЯ. ЗЕЛЕНСКОМУ И ЕГО
Dialogue: 0,0:01:50.09,0:01:52.89,Caption,,0,0,0,,СОЮЗНИКАМ МОЖЕТ БЫТЬ ВЫГОДНА МАКСИМАЛЬНО ЖЁСТКАЯ
Dialogue: 0,0:01:52.89,0:01:56.25,Caption,,0,0,0,,РЕАКЦИЯ РОССИИ. НЕ ОБЯЗАТЕЛЬНО РАДИ САМОГО УДАРА. ИМ
Dialogue: 0,0:01:56.33,0:01:58.25,Caption,,0,0,0,,НУЖНА ОЧЕРЕДНАЯ СТУПЕНЬ КОНФЛИКТА,
Dialogue: 0,0:01:58.49,0:02:00.97,Caption,,0,0,0,,КОТОРУЮ МОЖНО ПРИНЕСТИ В ЕВРОПЕЙСКИЕ СТОЛИЦЫ КАК
Dialogue: 0,0:02:00.97,0:02:04.33,Caption,,0,0,0,,СЧЁТ ИЗ ОЧЕНЬ ДОРОГОГО РЕСТОРАНА. ВОТ УГРОЗА,
Dialogue: 0,0:02:04.57,0:02:07.13,Caption,,0,0,0,,ВОТ ПОСЛЕДСТВИЯ, ТЕПЕРЬ НЕСИТЕ ОРУЖИЕ,
Dialogue: 0,0:02:07.29,0:02:11.45,Caption,,0,0,0,,КРЕДИТЫ, БЮДЖЕТЫ И ЕЩЁ НЕСКОЛЬКО ЛЕТ ПОДДЕРЖКИ. И ПОКА
Dialogue: 0,0:02:11.45,0:02:14.57,Caption,,0,0,0,,НАВЕРХУ ВЫЯСНЯЮТ, НАСКОЛЬКО ДАЛЕКО МОЖНО ЗАЙТИ,
Dialogue: 0,0:02:14.89,0:02:18.09,Caption,,0,0,0,,ВНУТРИ УКРАИНЫ УЖЕ НАЧИНАЮТ ВСЛУХ ПРОИЗНОСИТЬ ТО,
Dialogue: 0,0:02:18.44,0:02:21.05,Caption,,0,0,0,,ЗА ЧТО СОВСЕМ НЕДАВНО ЧЕЛОВЕКА ОТПРАВИЛИ БЫ НА
Dialogue: 0,0:02:21.05,0:02:25.77,Caption,,0,0,0,,ОБЩЕСТВЕННУЮ МЯСОРУБКУ. ДЕПУТАТ ВЕРХОВНОЙ РАДЫ ГЕОРГИЙ МАЗУРАШУ ДОПУСТИЛ
Dialogue: 0,0:02:25.77,0:02:28.57,Caption,,0,0,0,,ИЗМЕНЕНИЕ ГРАНИЦ ДОНЕЦКОЙ И ЛУГАНСКОЙ ОБЛАСТЕЙ ПО
Dialogue: 0,0:02:28.57,0:02:32.89,Caption,,0,0,0,,НЫНЕШНЕЙ ЛИНИИ ФРОНТА, ЕСЛИ ТАКОЙ ВАРИАНТ ОБЕСПЕЧИТ НАСТОЯЩИЕ ГАРАНТИИ
Dialogue: 0,0:02:32.97,0:02:35.77,Caption,,0,0,0,,МИРА. ОН СРАЗУ УКАЗАЛ И НА ПРАВОВОЙ ПРОХОД.
Dialogue: 0,0:02:38.06,0:02:40.78,Caption,,0,0,0,,КОНСТИТУЦИЮ ПРИ ВОЕННОМ ПОЛОЖЕНИИ МЕНЯТЬ НЕЛЬЗЯ,
Dialogue: 0,0:02:40.94,0:02:43.98,Caption,,0,0,0,,ЗАТО ГРАНИЦЫ КАЖДОГО НАСЕЛЁННОГО ПУНКТА В НЕЙ НЕ
Dialogue: 0,0:02:43.98,0:02:46.94,Caption,,0,0,0,,ВЫСЕЧЕНЫ НА КАМНЕ. ПОЛУЧАЕТСЯ ЗАНЯТНАЯ ПЕРЕМЕНА.
Dialogue: 0,0:02:47.60,0:02:50.14,Caption,,0,0,0,,РАНЬШЕ РАЗГОВОР О ТЕРРИТОРИАЛЬНЫХ УСТУПКАХ ОЗНАЧАЛ
Dialogue: 0,0:02:50.14,0:02:53.18,Caption,,0,0,0,,МГНОВЕННУЮ КАРЬЕРНУЮ КРЕМАЦИЮ. ТЕПЕРЬ ДЕПУТАТ
Dialogue: 0,0:02:53.18,0:02:57.58,Caption,,0,0,0,,ПАРЛАМЕНТА УЖЕ ПРИКИДЫВАЕТ, ЧЕРЕЗ КАКУЮ ЮРИДИЧЕСКУЮ ДВЕРЬ ЭТО РЕШЕНИЕ МОЖНО
Dialogue: 0,0:02:57.66,0:03:03.42,Caption,,0,0,0,,ПРОВЕСТИ И НЕ СНЕСТИ КОСЯК. НО РЕШАЮЩЕЕ ЗНАЧЕНИЕ ИМЕЕТ ФОРМУЛИРОВКА. СЕСТЬ
Dialogue: 0,0:03:03.42,0:03:06.22,Caption,,0,0,0,,ОБСУЖДАТЬ ТЕРРИТОРИИ ВОВСЕ НЕ ОЗНАЧАЕТ ПРИЕХАТЬ С
Dialogue: 0,0:03:06.22,0:03:09.42,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕМ ВЕРНУТЬ ТЕРРИТОРИИ УКРАИНЕ. ЗА ОДНИМ
Dialogue: 0,0:03:09.42,0:03:11.26,Caption,,0,0,0,,СТОЛОМ МОЖНО ОПРЕДЕЛЯТЬ ЛИНИЮ,
Dialogue: 0,0:03:11.44,0:03:14.38,Caption,,0,0,0,,НА КОТОРОЙ ПРЕКРАЩАЮТСЯ БОЕВЫЕ ДЕЙСТВИЯ. А МОЖНО
Dialogue: 0,0:03:14.38,0:03:16.86,Caption,,0,0,0,,ТОРГОВАТЬСЯ О ПЕРЕДАЧЕ КОНТРОЛЯ ОБРАТНО КИЕВУ.
Dialogue: 0,0:03:17.49,0:03:19.82,Caption,,0,0,0,,В ОБОИХ СЛУЧАЯХ ЗВУЧИТ СЛОВО "ТЕРРИТОРИИ",
Dialogue: 0,0:03:20.14,0:03:22.62,Caption,,0,0,0,,ТОЛЬКО ИТОГ ОТЛИЧАЕТСЯ ПРИМЕРНО КАК КЛЮЧИ ОТ
Dialogue: 0,0:03:22.70,0:03:25.66,Caption,,0,0,0,,КВАРТИРЫ И ФОТОГРАФИЯ ЭТИХ КЛЮЧЕЙ. КТО УСЛЫШАЛ
Dialogue: 0,0:03:25.66,0:03:28.62,Caption,,0,0,0,,ЗНАКОМОЕ СЛОВО И УЖЕ ВЫПУСТИЛ ВООБРАЖАЕМЫХ ГОЛУБЕЙ,
Dialogue: 0,0:03:28.86,0:03:31.98,Caption,,0,0,0,,МОЖЕТ СПОКОЙНО ВЕРНУТЬ ПТИЦ В КОРОБКУ. ВОПРОС ПОКА
Dialogue: 0,0:03:32.06,0:03:35.66,Caption,,0,0,0,,НЕ В ТОМ, ЧТО МОСКВА СОБИРАЕТСЯ ОТДАВАТЬ. ВОПРОС В ТОМ,
Dialogue: 0,0:03:35.96,0:03:39.10,Caption,,0,0,0,,ГДЕ СТОРОНЫ МОГУТ ЗАФИКСИРОВАТЬ НОВУЮ ГРАНИЦУ
Dialogue: 0,0:03:39.18,0:03:43.18,Caption,,0,0,0,,РЕАЛЬНОСТИ. СЛЕДОМ В ЭТУ КОНСТРУКЦИЮ ВОШЁЛ ТАРАС ЧМУТ. И
Dialogue: 0,0:03:43.18,0:03:47.02,Caption,,0,0,0,,ВОШЁЛ ТАК БОДРО, БУДТО РЕШИЛ ОДНИМ ИНТЕРВЬЮ ПРОВЕРИТЬ НА ПРОЧНОСТЬ
Dialogue: 0,0:03:47.10,0:03:50.30,Caption,,0,0,0,,СРАЗУ НЕСКОЛЬКО ЕВРОПЕЙСКИХ КРЕСЕЛ. ЧМУТ МНОГО ЛЕТ
Dialogue: 0,0:03:50.38,0:03:52.38,Caption,,0,0,0,,СВЯЗАН С ПОДДЕРЖКОЙ УКРАИНСКОЙ АРМИИ.
Dialogue: 0,0:03:54.65,0:03:57.13,Caption,,0,0,0,,И ОН ЗАДАЛ ОДИН ВОПРОС ЕСЛИ ЗАПАД ПРИНУДИТ
Dialogue: 0,0:03:57.13,0:04:01.77,Caption,,0,0,0,,КИЕВ УСТУПИТЬ ТЕРРИТОРИИ, ПОЧЕМУ УКРАИНА ДОЛЖНА НАВЕЧНО СОХРАНИТЬ НЫНЕШНЮЮ
Dialogue: 0,0:04:01.77,0:04:05.85,Caption,,0,0,0,,СИСТЕМУ СОЮЗОВ? ЕЩЁ ТРИ НАПРАВЛЕНИЯ ОН НАЗВАЛ ПРЯМО КИТАЙ,
Dialogue: 0,0:04:06.08,0:04:08.97,Caption,,0,0,0,,ИРАН И СЕВЕРНАЯ КОРЕЯ. ПОВОРОТ К ЛЮБОМУ ИЗ
Dialogue: 0,0:04:08.97,0:04:11.69,Caption,,0,0,0,,ЭТИХ ПАРТНЁРОВ ЛИШИЛ БЫ ЕВРОПУ ВЛИЯНИЯ НА КИЕВ
Dialogue: 0,0:04:12.01,0:04:14.49,Caption,,0,0,0,,И СОЗДАЛ БЫ ДЛЯ НЕЁ ЖЁСТКУЮ УГРОЗУ. А
Dialogue: 0,0:04:14.49,0:04:18.33,Caption,,0,0,0,,ЗАТЕМ ПРОЗВУЧАЛ ВАРИАНТ, ПОСЛЕ КОТОРОГО В БРЮССЕЛЕ КОМУ ТО НАВЕРНЯКА
Dialogue: 0,0:04:18.33,0:04:21.13,Caption,,0,0,0,,ЗАХОТЕЛОСЬ ПЕРЕЧИТАТЬ ИНТЕРВЬЮ МЕДЛЕННО И ПО СЛОГАМ.
Dialogue: 0,0:04:21.56,0:04:24.49,Caption,,0,0,0,,УКРАИНА ТЕОРЕТИЧЕСКИ МОЖЕТ СТАТЬ СОЮЗНИКОМ РОССИИ
Dialogue: 0,0:04:24.57,0:04:27.93,Caption,,0,0,0,,ПРОТИВ ЕВРОПЫ. ЧМУТ НЕ СОБИРАЕТ КОАЛИЦИЮ ДЛЯ МАРША
Dialogue: 0,0:04:28.01,0:04:31.13,Caption,,0,0,0,,НА БЕЛЬГИЙСКУЮ СТОЛИЦУ. ОН ПОКАЗЫВАЕТ АБСУРД МИРА,
Dialogue: 0,0:04:31.36,0:04:34.33,Caption,,0,0,0,,В КОТОРОМ РЕШАЕТ ТОЛЬКО СИЛА. НО ФРАЗА УЖЕ
Dialogue: 0,0:04:34.33,0:04:37.37,Caption,,0,0,0,,ВЫЛЕТЕЛА, И ОБРАТНО В РОТ ЕЁ НЕ ЗАТОЛКАЕШЬ. ТЕМ
Dialogue: 0,0:04:37.45,0:04:39.69,Caption,,0,0,0,,БОЛЕЕ ЧТО ЗА НЕЙ СТОИТ НЕ ПУСТАЯ ФАНТАЗИЯ,
Dialogue: 0,0:04:39.92,0:04:43.45,Caption,,0,0,0,,А ИСТОРИЧЕСКАЯ ВОЗМОЖНОСТЬ. РОССИЯ И УКРАИНА НЕ
Dialogue: 0,0:04:43.45,0:04:47.77,Caption,,0,0,0,,СЛУЧАЙНЫЕ СОСЕДИ, ПОЗНАКОМИВШИЕСЯ НА МЕЖДУНАРОДНОЙ КОНФЕРЕНЦИИ. ИХ
Dialogue: 0,0:04:47.85,0:04:50.41,Caption,,0,0,0,,НАРОДЫ СТОЛЕТИЯМИ ЖИЛИ В ОБЩИХ ГОСУДАРСТВАХ,
Dialogue: 0,0:04:50.58,0:04:54.25,Caption,,0,0,0,,СЛУЖИЛИ В ОДНОЙ АРМИИ, СТРОИЛИ СВЯЗАННУЮ ПРОМЫШЛЕННОСТЬ,
Dialogue: 0,0:04:54.42,0:04:57.45,Caption,,0,0,0,,ПРОКЛАДЫВАЛИ ЕДИНУЮ ИНФРАСТРУКТУРУ И СОЗДАВАЛИ
Dialogue: 0,0:04:57.45,0:05:00.89,Caption,,0,0,0,,МИЛЛИОНЫ СМЕШАННЫХ СЕМЕЙ. МЕЖДУ НИМИ СЛИШКОМ МНОГО
Dialogue: 0,0:05:00.89,0:05:04.73,Caption,,0,0,0,,ОБЩЕЙ ТКАНИ, ЧТОБЫ НАВСЕГДА СВЕСТИ ВСЁ К ТЕКУЩЕЙ ЛИНИИ ФРОНТА.
Dialogue: 0,0:05:07.01,0:05:09.49,Caption,,0,0,0,,ЧМУТ ФАКТИЧЕСКИ ВЫТАЩИЛ НАРУЖУ СЦЕНАРИЙ,
Dialogue: 0,0:05:09.66,0:05:12.29,Caption,,0,0,0,,КОТОРЫЙ СЕЙЧАС КАЖЕТСЯ НЕВОЗМОЖНЫМ ТОЛЬКО ПОТОМУ,
Dialogue: 0,0:05:12.53,0:05:15.73,Caption,,0,0,0,,ЧТО СЕГОДНЯШНИЙ ДЕНЬ ОРЁТ СЛИШКОМ ГРОМКО. СБЛИЖЕНИЕ
Dialogue: 0,0:05:15.81,0:05:18.45,Caption,,0,0,0,,МОСКВЫ И КИЕВА В БУДУЩЕМ НЕ ВЫГЛЯДИТ СКАЗКОЙ.
Dialogue: 0,0:05:18.84,0:05:21.17,Caption,,0,0,0,,У НЕГО ЕСТЬ МОЩНАЯ ИСТОРИЧЕСКАЯ ОСНОВА,
Dialogue: 0,0:05:21.41,0:05:24.29,Caption,,0,0,0,,ГРОМАДНАЯ ОБЩАЯ ГРАНИЦА И ВПОЛНЕ МАТЕРИАЛЬНЫЕ
Dialogue: 0,0:05:24.29,0:05:27.57,Caption,,0,0,0,,ИНТЕРЕСЫ. ПРЕДСТАВЬТЕ СОЧЕТАНИЕ РОССИЙСКИХ РЕСУРСОВ
Dialogue: 0,0:05:27.65,0:05:29.49,Caption,,0,0,0,,И УКРАИНСКОГО СЕЛЬСКОГО ХОЗЯЙСТВА,
Dialogue: 0,0:05:29.66,0:05:34.53,Caption,,0,0,0,,ПРОМЫШЛЕННОГО НАСЛЕДИЯ, ТЕРРИТОРИЙ И ВОЕННОГО ОПЫТА ОБЕИХ СТРАН. ЭТО БЫЛ
Dialogue: 0,0:05:34.53,0:05:37.41,Caption,,0,0,0,,БЫ УЖЕ НЕ ОЧЕРЕДНОЙ СПОР ДВУХ ВОСТОЧНЫХ СОСЕДЕЙ,
Dialogue: 0,0:05:37.78,0:05:41.41,Caption,,0,0,0,,А НОВАЯ СИЛА, С КОТОРОЙ ЕВРОПЕ ПРИШЛОСЬ БЫ РАЗГОВАРИВАТЬ СОВСЕМ
Dialogue: 0,0:05:41.49,0:05:44.37,Caption,,0,0,0,,ДРУГИМ ГОЛОСОМ. ДЛЯ ЕВРОПЕЙСКИХ СТОЛИЦ ТАКОЙ ПОВОРОТ
Dialogue: 0,0:05:44.45,0:05:48.05,Caption,,0,0,0,,СТРАШНЕЕ МНОГИХ НЫНЕШНИХ УГРОЗ. РОССИЯ И УКРАИНА,
Dialogue: 0,0:05:48.29,0:05:51.09,Caption,,0,0,0,,НАПРАВИВШИЕ НАКОПЛЕННЫЙ ОПЫТ НЕ ДРУГ ПРОТИВ ДРУГА,
Dialogue: 0,0:05:51.48,0:05:53.89,Caption,,0,0,0,,ПОЛНОСТЬЮ МЕНЯЮТ РАССТАНОВКУ СИЛ НА ВОСТОКЕ
Dialogue: 0,0:05:53.89,0:05:56.77,Caption,,0,0,0,,КОНТИНЕНТА. ТАМ УЖЕ НЕ ПОЛУЧИТСЯ ГОДАМИ РАЗДАВАТЬ
Dialogue: 0,0:05:56.77,0:06:01.41,Caption,,0,0,0,,ОБЕЩАНИЯ, А ПОТОМ УДИВЛЯТЬСЯ, ПОЧЕМУ АДРЕСАТЫ ПЕРЕСТАЛИ БЛАГОДАРИТЬ. ПОЭТОМУ
Dialogue: 0,0:06:01.41,0:06:05.33,Caption,,0,0,0,,РЕПЛИКА ЧМУТА ВАЖНА НЕ КАК УДАЧНАЯ ПРОВОКАЦИЯ. ОНА
Dialogue: 0,0:06:05.33,0:06:09.33,Caption,,0,0,0,,ПОКАЗЫВАЕТ, КАКОЙ ВОПРОС СПОСОБЕН ПОЯВИТЬСЯ ПОСЛЕ ВОЙНЫ КОМУ
Dialogue: 0,0:06:09.33,0:06:12.21,Caption,,0,0,0,,УКРАИНА ПРЕДЪЯВИТ ГЛАВНЫЙ СЧЁТ И С КЕМ РЕШИТ
Dialogue: 0,0:06:12.21,0:06:14.21,Caption,,0,0,0,,СТРОИТЬ СЛЕДУЮЩИЙ ЭТАП СВОЕЙ ИСТОРИИ?
Dialogue: 0,0:06:14.74,0:06:18.29,Caption,,0,0,0,,САМ ЧМУТ ДОБАВЛЯЕТ ЕЩЁ ОДНУ НЕУДОБНУЮ ДЕТАЛЬ. НИКТО
Dialogue: 0,0:06:18.37,0:06:20.77,Caption,,0,0,0,,НЕ ЗНАЕТ, КАКАЯ ВЛАСТЬ СМЕНИТ ЗЕЛЕНСКОГО.
Dialogue: 0,0:06:23.05,0:06:25.69,Caption,,0,0,0,,БУДУЩИЕ РУКОВОДИТЕЛИ ВОВСЕ НЕ ОБЯЗАНЫ СМОТРЕТЬ НА
Dialogue: 0,0:06:25.77,0:06:28.49,Caption,,0,0,0,,ЕВРОПУ С ПРЕЖНИМ ВОСТОРГОМ. ОНИ МОГУТ СПРОСИТЬ,
Dialogue: 0,0:06:28.68,0:06:31.45,Caption,,0,0,0,,ЧТО ИМЕННО СТРАНА ПОЛУЧИЛА ЗА ГОДЫ ОЖИДАНИЯ,
Dialogue: 0,0:06:31.82,0:06:33.69,Caption,,0,0,0,,КТО ПОДТАЛКИВАЛ ЕЁ К УСТУПКАМ,
Dialogue: 0,0:06:33.93,0:06:36.89,Caption,,0,0,0,,КТО ЗАКРЫВАЛ РЫНКИ ДЛЯ ЗЕРНА И ПОЧЕМУ ОБЕЩАННЫЙ
Dialogue: 0,0:06:36.97,0:06:40.09,Caption,,0,0,0,,ВХОД В ЕВРОСОЮЗ ВСЁ ВРЕМЯ ОТОДВИГАЛСЯ НА СЛЕДУЮЩИЙ
Dialogue: 0,0:06:40.09,0:06:44.25,Caption,,0,0,0,,ПОВОРОТ. ОТВЕТ ИЗ ЕВРОПЫ УЖЕ НАЧИНАЕТ ПРОСТУПАТЬ. УКРАИНА
Dialogue: 0,0:06:44.25,0:06:47.13,Caption,,0,0,0,,ВРЯД ЛИ СТАНЕТ ЧЛЕНОМ ЕВРОСОЮЗА В БЛИЖАЙШИЕ ДЕСЯТЬ
Dialogue: 0,0:06:47.21,0:06:50.33,Caption,,0,0,0,,ЛЕТ. ИМЕННО ДЕСЯТЬ ЛЕТ. НЕ ПАРА МЕСЯЦЕВ ПОСЛЕ
Dialogue: 0,0:06:50.33,0:06:53.37,Caption,,0,0,0,,ЗАВЕРШЕНИЯ ВОЙНЫ. НЕ КОРОТКАЯ ПАУЗА НА ДВЕ РЕФОРМЫ
Dialogue: 0,0:06:53.45,0:06:55.77,Caption,,0,0,0,,И НОВУЮ ПЕЧАТЬ. ЦЕЛОЕ ДЕСЯТИЛЕТИЕ,
Dialogue: 0,0:06:56.09,0:06:58.73,Caption,,0,0,0,,ПОСЛЕ КОТОРОГО НИКТО ВСЁ РАВНО НЕ ОБЯЗАН ВРУЧАТЬ
Dialogue: 0,0:06:58.73,0:07:02.65,Caption,,0,0,0,,КИЕВУ ЧЛЕНСКИЙ БИЛЕТ. ПРОЦЕДУРА ВСТУПЛЕНИЯ ВКЛЮЧАЕТ МНОГОЛЕТНИЕ
Dialogue: 0,0:07:02.65,0:07:04.73,Caption,,0,0,0,,ПЕРЕГОВОРЫ, ИЗМЕНЕНИЕ ЗАКОНОВ,
Dialogue: 0,0:07:04.97,0:07:07.13,Caption,,0,0,0,,ВЫПОЛНЕНИЕ ЭКОНОМИЧЕСКИХ И УПРАВЛЕНЧЕСКИХ
Dialogue: 0,0:07:07.21,0:07:10.01,Caption,,0,0,0,,ТРЕБОВАНИЙ. К ЭТОМУ УКРАИНСКОМУ НАБОРУ ПРИЛАГАЮТСЯ
Dialogue: 0,0:07:10.01,0:07:14.73,Caption,,0,0,0,,ВОЙНА, КОРРУПЦИЯ, МАСШТАБ СТРАНЫ И ТАКАЯ КУЧА НЕРЕШЁННЫХ ПРОБЛЕМ,
Dialogue: 0,0:07:15.02,0:07:17.53,Caption,,0,0,0,,ЧТО ЕВРОПЕЙСКИМ ЧИНОВНИКАМ ПОНАДОБИТСЯ ОТДЕЛЬНЫЙ
Dialogue: 0,0:07:17.53,0:07:20.25,Caption,,0,0,0,,ШКАФ. ЖЕЛАТЕЛЬНО ЖЕЛЕЗНЫЙ И С ХОРОШИМ ЗАМКОМ.
Dialogue: 0,0:07:20.79,0:07:23.53,Caption,,0,0,0,,СКОЛЬКО ЛЕТ КИЕВ ШЁЛ ЗА ОБЕЩАНИЕМ ЕВРОПЕЙСКОГО
Dialogue: 0,0:07:23.61,0:07:25.93,Caption,,0,0,0,,БУДУЩЕГО? ЕМУ ПОКАЗЫВАЛИ СЕМЬЮ,
Dialogue: 0,0:07:26.15,0:07:30.41,Caption,,0,0,0,,ПУТЬ, ОБЩИЙ ДОМ, БЛИЗКУЮ ЦЕЛЬ. ТРЕБОВАЛИ ЕЩЁ ОДИН ЗАКОН,
Dialogue: 0,0:07:30.64,0:07:35.29,Caption,,0,0,0,,ЕЩЁ ОДНУ РЕФОРМУ, ЕЩЁ НЕМНОГО ТЕРПЕНИЯ. МОРКОВКУ ПЕРЕД НОСОМ УЖЕ ПОРА
Dialogue: 0,0:07:35.29,0:07:37.53,Caption,,0,0,0,,МЕНЯТЬ, СТАРАЯ УСПЕЛА ВЫСОХНУТЬ.
Dialogue: 0,0:07:39.80,0:07:43.88,Caption,,0,0,0,,ТЕПЕРЬ ВЫЯСНЯЕТСЯ, ЧТО ДАЖЕ ЧЕРЕЗ ДЕСЯТЬ ЛЕТ УКРАИНА МОЖЕТ ОСТАТЬСЯ
Dialogue: 0,0:07:43.96,0:07:46.36,Caption,,0,0,0,,У ВХОДА. ЕВРОПА ПРЕКРАСНО ПОНИМАЕТ,
Dialogue: 0,0:07:46.60,0:07:49.80,Caption,,0,0,0,,НАСКОЛЬКО РАЗРУШИТЕЛЬНО ЗВУЧИТ ЭТОТ ОТВЕТ. ОТКРЫТО
Dialogue: 0,0:07:49.88,0:07:52.60,Caption,,0,0,0,,ПРИЗНАТЬ, ЧТО БЫСТРОЙ ДОРОГИ К ЧЛЕНСТВУ НЕТ,
Dialogue: 0,0:07:52.86,0:07:57.16,Caption,,0,0,0,,ЗНАЧИТ УДАРИТЬ ПО ЛЮДЯМ, КОТОРЫМ ГОДАМИ ПРОДАВАЛИ ПРОТИВОПОЛОЖНУЮ КАРТИНУ.
Dialogue: 0,0:07:57.39,0:08:00.36,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ПОЧТИ ИЗДЕВАТЕЛЬСТВО. КИЕВ ДЕСЯТИЛЕТИЕ
Dialogue: 0,0:08:00.44,0:08:04.12,Caption,,0,0,0,,ИДЁТ К ЗАКРЫТОЙ ДВЕРИ, А ИЗНУТРИ ЕМУ СОВЕТУЮТ НЕ ТЕРЯТЬ БОДРОСТЬ И
Dialogue: 0,0:08:04.12,0:08:07.16,Caption,,0,0,0,,ПРОДОЛЖАТЬ ДВИЖЕНИЕ. ГЛАВНОЕ, НЕ СПРАШИВАТЬ,
Dialogue: 0,0:08:07.32,0:08:11.00,Caption,,0,0,0,,КАК МОЖНО ДВИГАТЬСЯ ВПЕРЁД, УПИРАЯСЬ ЛБОМ В ДВЕРНОЕ ПОЛОТНО.
Dialogue: 0,0:08:11.90,0:08:14.52,Caption,,0,0,0,,ВЕНГРИЯ ТЕМ ВРЕМЕНЕМ ДЕРЖИТ ЗАСОВ БЕЗ МАЛЕЙШЕГО
Dialogue: 0,0:08:14.52,0:08:17.40,Caption,,0,0,0,,СМУЩЕНИЯ. БУДАПЕШТ СНОВА БЛОКИРУЕТ УКРАИНСКОЕ
Dialogue: 0,0:08:17.40,0:08:20.76,Caption,,0,0,0,,ПРОДВИЖЕНИЕ В ЕВРОСОЮЗ И НАПОМИНАЕТ О ПРАВАХ ВЕНГРОВ
Dialogue: 0,0:08:20.76,0:08:23.32,Caption,,0,0,0,,ЗАКАРПАТЬЯ. ПО МНЕНИЮ ВЕНГЕРСКОЙ СТОРОНЫ,
Dialogue: 0,0:08:23.55,0:08:26.84,Caption,,0,0,0,,КИЕВ СВОИХ ОБЕЩАНИЙ НЕ ВЫПОЛНИЛ. ОСОБЕННО НЕПРИЯТНО
Dialogue: 0,0:08:26.92,0:08:30.84,Caption,,0,0,0,,ДЛЯ УКРАИНЫ, ЧТО ТЕПЕРЬ ЭТУ ПОЗИЦИЮ ОЗВУЧИВАЕТ ПЕТЕР МАДЬЯР. ОН
Dialogue: 0,0:08:30.84,0:08:34.68,Caption,,0,0,0,,ПРЯМО ГОВОРИТ, ЧТО СТРАНА К ЧЛЕНСТВУ НЕ ГОТОВА. ДОЛГОЕ ВРЕМЯ
Dialogue: 0,0:08:34.68,0:08:37.32,Caption,,0,0,0,,ВСЕ СЛОЖНОСТИ БЫЛО УДОБНО СКЛАДЫВАТЬ В ОДИН ЯЩИК
Dialogue: 0,0:08:37.40,0:08:40.52,Caption,,0,0,0,,С ФАМИЛИЕЙ ОРБАН. МОЛ, СМЕНИТСЯ ПРЕМЬЕР,
Dialogue: 0,0:08:40.65,0:08:43.24,Caption,,0,0,0,,ПРИДУТ ДРУГИЕ ЛЮДИ, ЗАИГРАЕТ МУЗЫКА,
Dialogue: 0,0:08:43.40,0:08:46.36,Caption,,0,0,0,,ОТКРОЮТСЯ ВОРОТА И ДЕЛЕГАЦИЮ КИЕВА ВСТРЕТЯТ С
Dialogue: 0,0:08:46.36,0:08:49.56,Caption,,0,0,0,,САЛФЕТКАМИ И ШАМПАНСКИМ. ДРУГИЕ ЛЮДИ ПОЯВИЛИСЬ. ГДЕ
Dialogue: 0,0:08:49.56,0:08:54.63,Caption,,0,0,0,,ЧУДО? НИКУДА НЕ ИСЧЕЗЛИ НИ ЗАКАРПАТСКИЕ ВЕНГРЫ,
Dialogue: 0,0:08:54.93,0:08:59.35,Caption,,0,0,0,,НИ СПОР ВОКРУГ ЯЗЫКА, НИ СТРЕМЛЕНИЕ БУДАПЕШТА ЗАЩИЩАТЬ СООТЕЧЕСТВЕННИКОВ
Dialogue: 0,0:08:59.43,0:09:01.99,Caption,,0,0,0,,ЗА ПРЕДЕЛАМИ СТРАНЫ. НАЦИОНАЛЬНЫЕ ИНТЕРЕСЫ НЕ
Dialogue: 0,0:09:01.99,0:09:04.79,Caption,,0,0,0,,ВЫНОСЯТ ИЗ КАБИНЕТА ВМЕСТЕ СО СТАРОЙ МЕБЕЛЬЮ ПОСЛЕ
Dialogue: 0,0:09:04.79,0:09:08.31,Caption,,0,0,0,,ВЫБОРОВ. НА ЭТОМ ФОНЕ ПЕРЕЧЕНЬ ЧМУТА ЗВУЧИТ УЖЕ
Dialogue: 0,0:09:08.39,0:09:11.43,Caption,,0,0,0,,НЕ ЭКЗОТИКОЙ. ПОЛЬСКИЕ ОГРАНИЧЕНИЯ НА УКРАИНСКОЕ
Dialogue: 0,0:09:11.43,0:09:13.91,Caption,,0,0,0,,ЗЕРНО, ВЕНГЕРСКОЕ СОПРОТИВЛЕНИЕ,
Dialogue: 0,0:09:14.14,0:09:16.95,Caption,,0,0,0,,ВОЗМОЖНОЕ ДАВЛЕНИЕ РАДИ ТЕРРИТОРИАЛЬНЫХ УСТУПОК,
Dialogue: 0,0:09:17.27,0:09:20.79,Caption,,0,0,0,,ГОДЫ ОЖИДАНИЯ У ДВЕРЕЙ ЕВРОСОЮЗА. ИЗ ТАКИХ ВЕЩЕЙ
Dialogue: 0,0:09:20.87,0:09:24.47,Caption,,0,0,0,,И СОБИРАЕТСЯ ЧУВСТВО, ЧТО СТРАНУ ИСПОЛЬЗОВАЛИ В БОЛЬШОЙ ИГРЕ,
Dialogue: 0,0:09:24.79,0:09:28.07,Caption,,0,0,0,,А РАЗБИРАТЬСЯ С ИТОГАМИ ОСТАВИЛИ ЕЙ САМОЙ. СЕГОДНЯ
Dialogue: 0,0:09:28.07,0:09:31.11,Caption,,0,0,0,,ЭТО ЕЩЁ НЕ НОВАЯ ПРОГРАММА ВЛАСТИ. ЗАВТРА УТРОМ
Dialogue: 0,0:09:31.24,0:09:34.07,Caption,,0,0,0,,ТОЖЕ НЕ СТАНЕТ. НО ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ УКРАИНСКИЙ
Dialogue: 0,0:09:34.07,0:09:36.71,Caption,,0,0,0,,ИЗБИРАТЕЛЬ ВПОЛНЕ МОЖЕТ ПОТРЕБОВАТЬ ОТЧЁТ ГДЕ
Dialogue: 0,0:09:36.79,0:09:39.27,Caption,,0,0,0,,ОБЕЩАННОЕ ЧЛЕНСТВО, ГДЕ ВОССТАНОВЛЕНИЕ,
Dialogue: 0,0:09:39.44,0:09:43.83,Caption,,0,0,0,,ГДЕ БЕЗОПАСНОСТЬ, ГДЕ ДЕНЬГИ И ПОЧЕМУ ПОСЛЕ ВСЕХ ЖЕРТВ КИЕВ
Dialogue: 0,0:09:43.83,0:09:46.23,Caption,,0,0,0,,ПО ПРЕЖНЕМУ ДОЛЖЕН ВЫПОЛНЯТЬ НОВЫЕ УСЛОВИЯ?
Dialogue: 0,0:09:46.80,0:09:49.67,Caption,,0,0,0,,НА ТАКОЙ ПОЧВЕ ПОЯВЯТСЯ ПОЛИТИКИ С СОВЕРШЕННО ДРУГИМ
Dialogue: 0,0:09:49.67,0:09:52.39,Caption,,0,0,0,,КУРСОМ. И РЕПЛИКА О СОЮЗЕ С РОССИЕЙ ПРОТИВ
Dialogue: 0,0:09:52.47,0:09:55.35,Caption,,0,0,0,,ЕВРОПЫ ПЕРЕСТАНЕТ ЗВУЧАТЬ КАК НАРОЧНО БРОШЕННАЯ
Dialogue: 0,0:09:55.35,0:09:57.99,Caption,,0,0,0,,НЕЛЕПОСТЬ. ОНА ПРЕВРАТИТСЯ В ОДИН ИЗ ВАРИАНТОВ,
Dialogue: 0,0:09:58.24,0:10:00.87,Caption,,0,0,0,,КОТОРЫЙ БУДУТ ОБСУЖДАТЬ УЖЕ БЕЗ НЕРВНОГО СМЕХА.
Dialogue: 0,0:10:03.16,0:10:07.48,Caption,,0,0,0,,НАПИШИТЕ В КОММЕНТАРИЯХ, КОГО УКРАИНЦЫ В ИТОГЕ ОБВИНЯТ СИЛЬНЕЕ МОСКВУ,
Dialogue: 0,0:10:07.80,0:10:10.20,Caption,,0,0,0,,НЫНЕШНЕЕ РУКОВОДСТВО В КИЕВЕ ИЛИ ЕВРОПЕЙСКИХ
Dialogue: 0,0:10:10.20,0:10:14.20,Caption,,0,0,0,,ПАРТНЁРОВ, КОТОРЫЕ МНОГО ОБЕЩАЛИ И ОЧЕНЬ БЕРЕЖНО ХРАНИЛИ КЛЮЧИ
Dialogue: 0,0:10:14.20,0:10:16.36,Caption,,0,0,0,,ОТ ЗАКРЫТОЙ ДВЕРИ. И ПОДПИСЫВАЙТЕСЬ.
Dialogue: 0,0:10:17.00,0:10:19.88,Caption,,0,0,0,,САМЫЕ ВАЖНЫЕ РАЗВОРОТЫ ОБЫЧНО СНАЧАЛА ВЫГЛЯДЯТ КАК
Dialogue: 0,0:10:19.88,0:10:23.56,Caption,,0,0,0,,ФРАЗА, КОТОРУЮ НИКТО НЕ ПРИНЯЛ ВСЕРЬЁЗ. НО ВСЯ ЭТА
Dialogue: 0,0:10:23.56,0:10:25.96,Caption,,0,0,0,,БОЛЬШАЯ КОНСТРУКЦИЯ УПИРАЕТСЯ В ВЕЩЬ КУДА
Dialogue: 0,0:10:25.96,0:10:29.40,Caption,,0,0,0,,ПРОЗАИЧНЕЕ. МОЖНО ГОДАМИ СПОРИТЬ О БУДУЩИХ СОЮЗАХ,
Dialogue: 0,0:10:29.48,0:10:31.72,Caption,,0,0,0,,ГРАНИЦАХ И ЧЛЕНСТВЕ В ЕВРОСОЮЗЕ.
Dialogue: 0,0:10:32.27,0:10:34.52,Caption,,0,0,0,,ТОЛЬКО ЧЕЛОВЕКУ В КВАРТИРЕ ВАЖНЕЕ ДРУГОЙ ВОПРОС
Dialogue: 0,0:10:34.57,0:10:36.76,Caption,,0,0,0,,КОГДА В РОЗЕТКЕ ПОЯВИТСЯ ЭЛЕКТРИЧЕСТВО?
Dialogue: 0,0:10:37.46,0:10:40.12,Caption,,0,0,0,,СОГЛАСНО СОВМЕСТНОМУ ДОКЛАДУ АМЕРИКАНСКИХ ВЕДОМСТВ,
Dialogue: 0,0:10:40.48,0:10:42.92,Caption,,0,0,0,,УКРАИНА ЛИШИЛАСЬ БОЛЕЕ ПОЛОВИНЫ ДОВОЕННОЙ
Dialogue: 0,0:10:42.92,0:10:46.44,Caption,,0,0,0,,ЭЛЕКТРОГЕНЕРАЦИИ. БОЛЬШЕ ПОЛОВИНЫ ПРЕЖНИХ МОЩНОСТЕЙ
Dialogue: 0,0:10:46.60,0:10:49.00,Caption,,0,0,0,,УЖЕ НЕТ. УДАРЫ ПО ЭЛЕКТРОСТАНЦИЯМ,
Dialogue: 0,0:10:49.08,0:10:51.88,Caption,,0,0,0,,СЕТЯМ И ОБЪЕКТАМ ЦЕНТРАЛИЗОВАННОГО ОТОПЛЕНИЯ,
Dialogue: 0,0:10:52.20,0:10:54.76,Caption,,0,0,0,,А ТАКЖЕ ПОТЕРЯ КОНТРОЛЯ НАД ЗАПОРОЖСКОЙ АТОМНОЙ
Dialogue: 0,0:10:54.76,0:10:57.08,Caption,,0,0,0,,ЭЛЕКТРОСТАНЦИЕЙ РАЗРУШИЛИ СТАРУЮ МОДЕЛЬ
Dialogue: 0,0:10:57.08,0:10:59.24,Caption,,0,0,0,,ЭНЕРГОСНАБЖЕНИЯ. ОНА ЕЩЁ РАБОТАЕТ,
Dialogue: 0,0:10:59.57,0:11:01.88,Caption,,0,0,0,,НО УЖЕ НЕ КАК ЕДИНАЯ НАДЁЖНАЯ СИСТЕМА,
Dialogue: 0,0:11:02.19,0:11:04.28,Caption,,0,0,0,,А КАК ПОЖИЛОЙ ХОЛОДИЛЬНИК ГУДИТ,
Dialogue: 0,0:11:04.41,0:11:07.08,Caption,,0,0,0,,ДРОЖИТ И ВЫКЛЮЧАЕТСЯ ИМЕННО ТОГДА,
Dialogue: 0,0:11:07.32,0:11:10.84,Caption,,0,0,0,,КОГДА ВНУТРИ ВСЁ САМОЕ НУЖНОЕ. ОТСЮДА И ПЛАНОВЫЕ
Dialogue: 0,0:11:10.84,0:11:16.41,Caption,,0,0,0,,ОТКЛЮЧЕНИЯ. ЗА СУХИМИ СЛОВАМИ О ГЕНЕРАЦИИ ПРЯЧЕТСЯ ОБЫЧНАЯ
Dialogue: 0,0:11:16.49,0:11:19.05,Caption,,0,0,0,,ГОРОДСКАЯ КВАРТИРА, ГДЕ НЕТ ЛИЧНОЙ КОТЕЛЬНОЙ,
Dialogue: 0,0:11:19.30,0:11:22.01,Caption,,0,0,0,,ЗАПАСНОЙ ЭЛЕКТРОСТАНЦИИ И ТУРБИНЫ ВОЗЛЕ ЦВЕТОЧНОГО
Dialogue: 0,0:11:22.09,0:11:24.65,Caption,,0,0,0,,ГОРШКА. ДОМ ЗАВИСИТ ОТ ОБЩЕЙ СЕТИ,
Dialogue: 0,0:11:24.81,0:11:28.33,Caption,,0,0,0,,НАСОСОВ, ОТОПЛЕНИЯ И ПОДАЧИ ГОРЯЧЕЙ ВОДЫ. ПРОПАДАЕТ
Dialogue: 0,0:11:28.33,0:11:32.49,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО, СЛЕДОМ НАЧИНАЮТСЯ ПРОБЛЕМЫ С ВОДОЙ И ТЕПЛОМ. ЗИМОЙ
Dialogue: 0,0:11:32.49,0:11:35.29,Caption,,0,0,0,,ЭТА ЦЕПОЧКА ПЕРЕСТАЁТ БЫТЬ БЫТОВЫМ НЕУДОБСТВОМ И
Dialogue: 0,0:11:35.29,0:11:37.77,Caption,,0,0,0,,СТАНОВИТСЯ ВОПРОСОМ ВЫЖИВАНИЯ ЦЕЛЫХ РАЙОНОВ.
Dialogue: 0,0:11:38.05,0:11:40.97,Caption,,0,0,0,,АМЕРИКАНСКИЙ ДОКЛАД ОЦЕНИВАЕТ ПОЛНОЕ ВОССТАНОВЛЕНИЕ
Dialogue: 0,0:11:41.05,0:11:43.69,Caption,,0,0,0,,СРОКОМ ДО ПЯТИ ЛЕТ. ДАЖЕ ПРИ ХОРОШЕМ ХОДЕ
Dialogue: 0,0:11:43.69,0:11:46.01,Caption,,0,0,0,,РАБОТ К СЛЕДУЮЩЕЙ ЗИМЕ ВЕРНЁТСЯ ЛИШЬ ЧАСТЬ
Dialogue: 0,0:11:46.01,0:11:49.21,Caption,,0,0,0,,ПОТЕРЯННЫХ МОЩНОСТЕЙ. ВОТ И ПОЛУЧАЮТСЯ ДВЕ РАЗНЫЕ
Dialogue: 0,0:11:49.21,0:11:52.17,Caption,,0,0,0,,УКРАИНЫ. ОДНА ОБСУЖДАЕТ БУДУЩИЙ МИРОВОЙ ПОРЯДОК,
Dialogue: 0,0:11:52.49,0:11:57.05,Caption,,0,0,0,,НОВЫХ ПАРТНЁРОВ, ЕВРОПУ И СОЮЗЫ ПОСЛЕ ЗЕЛЕНСКОГО. ДРУГАЯ СВЕРЯЕТСЯ С
Dialogue: 0,0:11:57.13,0:12:01.37,Caption,,0,0,0,,РАСПИСАНИЕМ ОТКЛЮЧЕНИЙ, ЧТОБЫ УСПЕТЬ ВСКИПЯТИТЬ ВОДУ И ЗАРЯДИТЬ ТЕЛЕФОН.
Dialogue: 0,0:12:01.68,0:12:05.29,Caption,,0,0,0,,ПЕРВАЯ СТРОИТ СТРАТЕГИЮ НА ДЕСЯТИЛЕТИЯ. ВТОРАЯ ОЧЕНЬ
Dialogue: 0,0:12:05.29,0:12:07.05,Caption,,0,0,0,,ХОЧЕТ ПЕРЕЖИТЬ ВЕЧЕР БЕЗ СВЕЧЕЙ.
Dialogue: 0,0:12:07.76,0:12:10.01,Caption,,0,0,0,,ТЕПЕРЬ ВСЕ СЕГОДНЯШНИЕ СОБЫТИЯ СКЛАДЫВАЮТСЯ В
Dialogue: 0,0:12:10.09,0:12:13.29,Caption,,0,0,0,,ДОВОЛЬНО ЖЁСТКУЮ КАРТИНУ. ИЗ МОСКВЫ ПРИХОДИТ УТЕЧКА
Dialogue: 0,0:12:13.37,0:12:15.61,Caption,,0,0,0,,О СНЯТИИ ЗАПРЕТА НА ДЕЙСТВИЯ ПРОТИВ УКРАИНСКОЙ
Dialogue: 0,0:12:15.61,0:12:18.97,Caption,,0,0,0,,ВЕРХУШКИ. В ВЕРХОВНОЙ РАДЕ УЖЕ ИЩУТ ПРАВОВУЮ ФОРМУ
Dialogue: 0,0:12:19.05,0:12:21.77,Caption,,0,0,0,,ДЛЯ ИЗМЕНЕНИЯ ТЕРРИТОРИАЛЬНЫХ ГРАНИЦ. ЧЕЛОВЕК ИЗ
Dialogue: 0,0:12:21.77,0:12:25.29,Caption,,0,0,0,,ВЛИЯТЕЛЬНОЙ СРЕДЫ ВОЕННОЙ ПОДДЕРЖКИ ДОПУСКАЕТ ПОЛНЫЙ
Dialogue: 0,0:12:25.29,0:12:27.29,Caption,,0,0,0,,ПЕРЕСМОТР СОЮЗОВ ПОСЛЕ ЗЕЛЕНСКОГО.
Dialogue: 0,0:12:29.57,0:12:32.37,Caption,,0,0,0,,ЕВРОСОЮЗ ОТОДВИГАЕТСЯ МИНИМУМ НА ДЕСЯТИЛЕТИЕ.
Dialogue: 0,0:12:32.75,0:12:36.93,Caption,,0,0,0,,ВЕНГРИЯ ПОКАЗЫВАЕТ, ЧТО СМЕНА ФАМИЛИИ В РУКОВОДСТВЕ НЕ ОТМЕНЯЕТ ЕЁ
Dialogue: 0,0:12:37.01,0:12:40.13,Caption,,0,0,0,,ТРЕБОВАНИЙ. ЭНЕРГЕТИКА ТЕМ ВРЕМЕНЕМ НЕ СЛУШАЕТ РЕЧЕЙ
Dialogue: 0,0:12:40.45,0:12:43.81,Caption,,0,0,0,,И ЧЕСТНО ВЫДАЁТ ОСТАТОК МОЩНОСТИ. ПОЭТОМУ ГЛАВНЫЙ
Dialogue: 0,0:12:43.89,0:12:47.81,Caption,,0,0,0,,ВОПРОС НЕ В ТОМ, ЧЬЯ СЕГОДНЯШНЯЯ ЦИТАТА ГРОМЧЕ И КТО ЭФФЕКТНЕЕ
Dialogue: 0,0:12:47.81,0:12:50.85,Caption,,0,0,0,,НАХМУРИЛСЯ ПЕРЕД КАМЕРОЙ. ГОРАЗДО ВАЖНЕЕ ДРУГОЕ.
Dialogue: 0,0:12:51.24,0:12:53.73,Caption,,0,0,0,,ЕСЛИ ЧЕРЕЗ НЕСКОЛЬКО ЛЕТ УКРАИНА ПОЛУЧИТ ИНЫЕ
Dialogue: 0,0:12:53.73,0:12:56.45,Caption,,0,0,0,,ГРАНИЦЫ, ПОВРЕЖДЁННУЮ ЭНЕРГОСИСТЕМУ,
Dialogue: 0,0:12:56.61,0:12:59.17,Caption,,0,0,0,,НОВОЕ РУКОВОДСТВО И ТЯЖЁЛЫЙ СПИСОК ПРЕТЕНЗИЙ К
Dialogue: 0,0:12:59.17,0:13:02.13,Caption,,0,0,0,,ЕВРОПЕ, КОГО ОНА НАЗОВЁТ ГЛАВНЫМ ПАРТНЁРОМ?
Dialogue: 0,0:13:02.84,0:13:05.73,Caption,,0,0,0,,ИСТОРИЯ ЛЮБИТ ТАКИЕ НОМЕРА. ВСЕ ТОЛКАЮТ ЕЁ В
Dialogue: 0,0:13:05.73,0:13:08.13,Caption,,0,0,0,,ОДНУ СТОРОНУ, РАССТАВЛЯЮТ УКАЗАТЕЛИ,
Dialogue: 0,0:13:08.29,0:13:12.21,Caption,,0,0,0,,СОБИРАЮТ САММИТЫ И ЗАРАНЕЕ ПИШУТ ПОБЕДНЫЕ РЕЧИ. А
Dialogue: 0,0:13:12.21,0:13:17.01,Caption,,0,0,0,,ОНА ВНЕЗАПНО РАЗВОРАЧИВАЕТСЯ, ПРОХОДИТ ЧЕРЕЗ СОСЕДНЮЮ ДВЕРЬ И ОСТАВЛЯЕТ
Dialogue: 0,0:13:17.01,0:13:20.13,Caption,,0,0,0,,ОРГАНИЗАТОРОВ СПОРИТЬ С ГАРДЕРОБЩИКОМ. ТОГДА ФРАЗЫ,
Dialogue: 0,0:13:20.37,0:13:21.97,Caption,,0,0,0,,НАД КОТОРЫМИ ВЧЕРА ПОСМЕИВАЛИСЬ,
Dialogue: 0,0:13:22.13,0:13:25.49,Caption,,0,0,0,,СТАНОВЯТСЯ РЕШЕНИЯМИ ПРАВИТЕЛЬСТВА. И СМЕХ ПОЧЕМУ ТО
Dialogue: 0,0:13:25.54,0:13:26.77,Caption,,0,0,0,,ЗАКАНЧИВАЕТСЯ ПЕРВЫМ.
