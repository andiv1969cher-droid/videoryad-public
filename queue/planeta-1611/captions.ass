Dialogue: 0,0:00:00.12,0:00:02.84,Caption,,0,0,0,,ВАШИНГТОНУ ПОНАДОБИЛОСЬ ОДНО СЛОВО ЗЕЛЕНСКОГО.
Dialogue: 0,0:00:03.05,0:00:07.48,Caption,,0,0,0,,ПРИЧЁМ, ВОЗМОЖНО, ВОВСЕ НЕ "ДА". ЕМУ ПРЕДЛОЖИЛИ ТАКУЮ СДЕЛКУ,
Dialogue: 0,0:00:07.67,0:00:09.96,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ ОТКАЗ МОЖНО АККУРАТНО ПОЛОЖИТЬ В
Dialogue: 0,0:00:10.04,0:00:13.24,Caption,,0,0,0,,ПАПКУ, ОТНЕСТИ ТРАМПУ И СКАЗАТЬ МЫ ПРИНЕСЛИ КИЕВУ ПОЧТИ
Dialogue: 0,0:00:13.24,0:00:16.36,Caption,,0,0,0,,ВСЁ, А ОН СНОВА ДОСТАЛ СПИСОК ТРЕБОВАНИЙ ТОЛЩИНОЙ С
Dialogue: 0,0:00:16.36,0:00:19.24,Caption,,0,0,0,,РЕСТОРАННОЕ МЕНЮ. ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ЗДЕСЬ
Dialogue: 0,0:00:19.24,0:00:22.04,Caption,,0,0,0,,ЛЮБОПЫТНЕЕ НЕ ТО, ЧТО ПРЕДЛОЖИЛИ ЗЕЛЕНСКОМУ,
Dialogue: 0,0:00:22.20,0:00:24.76,Caption,,0,0,0,,А КАКОЙ ОТВЕТ ИЗ НЕГО ХОТЕЛИ ПОЛУЧИТЬ. ПО
Dialogue: 0,0:00:24.84,0:00:26.44,Caption,,0,0,0,,СЛОВАМ УКРАИНСКОГО ПРЕЗИДЕНТА,
Dialogue: 0,0:00:26.67,0:00:29.56,Caption,,0,0,0,,ПРЕДСТАВИТЕЛИ СОЕДИНЁННЫХ ШТАТОВ ВПЕРВЫЕ ЗАДАЛИ ЕМУ
Dialogue: 0,0:00:29.56,0:00:33.16,Caption,,0,0,0,,ПРЯМОЙ ВОПРОС. ГОТОВ ЛИ КИЕВ ВЫВЕСТИ ВОЙСКА ИЗ
Dialogue: 0,0:00:33.16,0:00:36.44,Caption,,0,0,0,,ДОНБАССА, ЕСЛИ УКРАИНА ВЗАМЕН СТАНЕТ ЧЛЕНОМ НАТО?
Dialogue: 0,0:00:37.02,0:00:39.72,Caption,,0,0,0,,ЗЕЛЕНСКИЙ СОГЛАШАТЬСЯ НЕ СТАЛ. ВМЕСТО ОДНОГО
Dialogue: 0,0:00:39.72,0:00:42.84,Caption,,0,0,0,,КОРОТКОГО СЛОВА ОН ПЕРЕЧИСЛИЛ УСЛОВИЯ. УКРАИНЕ
Dialogue: 0,0:00:42.84,0:00:45.96,Caption,,0,0,0,,ТРЕБУЮТСЯ ПОЛНОЦЕННЫЕ ГАРАНТИИ БЕЗОПАСНОСТИ ОТ НАТО
Dialogue: 0,0:00:45.96,0:00:48.68,Caption,,0,0,0,,И ЕВРОСОЮЗА, ПОСТОЯННОЕ ФИНАНСИРОВАНИЕ,
Dialogue: 0,0:00:48.84,0:00:51.56,Caption,,0,0,0,,ВООРУЖЕНИЕ АРМИИ И СРЕДСТВА НА ВОССТАНОВЛЕНИЕ.
Dialogue: 0,0:00:51.96,0:00:54.36,Caption,,0,0,0,,НЕЙТРАЛИТЕТ В КОНСТИТУЦИИ КИЕВ ЗАКРЕПЛЯТЬ НЕ
Dialogue: 0,0:00:54.36,0:00:57.24,Caption,,0,0,0,,НАМЕРЕН. РОССИЙСКИЙ СТАТУС ПОТЕРЯННЫХ ТЕРРИТОРИЙ
Dialogue: 0,0:00:57.24,0:01:00.60,Caption,,0,0,0,,ПРИЗНАВАТЬ ЮРИДИЧЕСКИ ТОЖЕ НЕ СОБИРАЕТСЯ. АМЕРИКАНЦЫ
Dialogue: 0,0:01:00.60,0:01:05.32,Caption,,0,0,0,,ПРИНЕСЛИ ОДИН ДОГОВОР, А ПОЛУЧИЛИ ЗАЯВКУ НА ПОЛНЫЙ КОМПЛЕКТ С ДОСТАВКОЙ,
Dialogue: 0,0:01:05.48,0:01:08.52,Caption,,0,0,0,,СБОРКОЙ И ПОЖИЗНЕННЫМ ОБСЛУЖИВАНИЕМ. ОТСЮДА И
Dialogue: 0,0:01:08.52,0:01:11.56,Caption,,0,0,0,,ВОЗНИКАЕТ ГЛАВНЫЙ ВОПРОС. А СОГЛАСИЕ ЗЕЛЕНСКОГО
Dialogue: 0,0:01:11.56,0:01:13.24,Caption,,0,0,0,,ВООБЩЕ ВХОДИЛО В АМЕРИКАНСКИЙ ПЛАН?
Dialogue: 0,0:01:15.51,0:01:19.27,Caption,,0,0,0,,ВОЗМОЖНО, ВАШИНГТОНУ ТРЕБОВАЛСЯ ИМЕННО ТАКОЙ ОТВЕТ. ТОГДА
Dialogue: 0,0:01:19.27,0:01:21.91,Caption,,0,0,0,,СТРАННОЕ ПРЕДЛОЖЕНИЕ СРАЗУ ПЕРЕСТАЁТ ВЫГЛЯДЕТЬ
Dialogue: 0,0:01:21.99,0:01:25.19,Caption,,0,0,0,,СТРАННЫМ. ПРЕДСТАВИТЕЛЬ США ПРИЕЗЖАЕТ В КИЕВ И
Dialogue: 0,0:01:25.27,0:01:29.35,Caption,,0,0,0,,ВЫКЛАДЫВАЕТ ВАРИАНТ, КОТОРЫЙ ДЛЯ УКРАИНСКОЙ ВЛАСТИ ТРУДНО НАЗВАТЬ ПУСТЫМ.
Dialogue: 0,0:01:29.75,0:01:31.51,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНАЯ УСТУПКА ОГРОМНАЯ,
Dialogue: 0,0:01:31.83,0:01:34.63,Caption,,0,0,0,,ЗАТО НА ДРУГОЙ ЧАШЕ НАХОДИТСЯ ЧЛЕНСТВО В НАТО,
Dialogue: 0,0:01:34.87,0:01:37.67,Caption,,0,0,0,,КОТОРОГО УКРАИНА ДОБИВАЕТСЯ МНОГО ЛЕТ. ПРИ ЭТОМ
Dialogue: 0,0:01:37.67,0:01:40.71,Caption,,0,0,0,,АМЕРИКАНСКАЯ СТОРОНА ПРЕКРАСНО ЗНАЕТ ПОЗИЦИЮ КИЕВА.
Dialogue: 0,0:01:41.03,0:01:43.35,Caption,,0,0,0,,ТАМ НЕ РАЗ СЛЫШАЛИ ОТКАЗ ОТ НЕЙТРАЛИТЕТА,
Dialogue: 0,0:01:43.64,0:01:46.07,Caption,,0,0,0,,ПОНИМАЮТ ЧУВСТВИТЕЛЬНОСТЬ ДОНБАССА И В КУРСЕ,
Dialogue: 0,0:01:46.27,0:01:48.71,Caption,,0,0,0,,ЧТО ЗЕЛЕНСКИЙ НЕ СОБИРАЕТСЯ СТАВИТЬ ПОДПИСЬ ПОД
Dialogue: 0,0:01:48.71,0:01:51.11,Caption,,0,0,0,,ПРИЗНАНИЕМ РОССИЙСКИХ ТЕРРИТОРИАЛЬНЫХ ПРИОБРЕТЕНИЙ.
Dialogue: 0,0:01:51.58,0:01:54.07,Caption,,0,0,0,,ЭТО НЕ ПЕРВОЕ ЗНАКОМСТВО ДВУХ ДЕЛЕГАЦИЙ В КОРИДОРЕ
Dialogue: 0,0:01:54.07,0:01:58.63,Caption,,0,0,0,,ГОСТИНИЦЫ. ДОПУСТИМ, ОНИ ВСЁ ЖЕ ЖДАЛИ СОГЛАСИЯ. ТОГДА ПОЯВЛЯЕТСЯ
Dialogue: 0,0:01:58.63,0:02:03.19,Caption,,0,0,0,,СЛЕДУЮЩИЙ ВОПРОС, ЕЩЁ НЕУДОБНЕЕ ПРЕЖНЕГО. КТО УСПЕЛ ПОЛУЧИТЬ СОГЛАСИЕ
Dialogue: 0,0:02:03.19,0:02:07.67,Caption,,0,0,0,,МОСКВЫ? РОССИЯ ГОДАМИ ТРЕБУЕТ ВНЕБЛОКОВОГО ПОЛОЖЕНИЯ УКРАИНЫ
Dialogue: 0,0:02:07.83,0:02:10.39,Caption,,0,0,0,,И СОКРАЩЕНИЯ ВОЕННОЙ АКТИВНОСТИ НАТО ВОЗЛЕ СВОИХ
Dialogue: 0,0:02:10.39,0:02:13.51,Caption,,0,0,0,,ГРАНИЦ. А ЗДЕСЬ КИЕВУ ОБЕЩАЮТ РОВНО ТО,
Dialogue: 0,0:02:13.75,0:02:16.95,Caption,,0,0,0,,ПРОТИВ ЧЕГО МОСКВА ВЫСТУПАЕТ НАИБОЛЕЕ ЖЁСТКО. СДЕЛКА
Dialogue: 0,0:02:16.95,0:02:19.75,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ИЗУМИТЕЛЬНАЯ. ПОКУПАТЕЛЮ УЖЕ ВЫДАЛИ
Dialogue: 0,0:02:19.75,0:02:23.03,Caption,,0,0,0,,КЛЮЧИ, ХОТЯ ХОЗЯИНА КВАРТИРЫ ДАЖЕ НЕ ПОЗВАЛИ. ПОЭТОМУ
Dialogue: 0,0:02:23.03,0:02:26.07,Caption,,0,0,0,,ВЕРСИЯ С ЗАРАНЕЕ ОЖИДАЕМЫМ ОТКАЗОМ ВЫГЛЯДИТ ВПОЛНЕ
Dialogue: 0,0:02:26.07,0:02:31.07,Caption,,0,0,0,,СТРОЙНО. ВАШИНГТОН ПРЕДЛАГАЕТ ЗЕЛЕНСКОМУ МАКСИМАЛЬНО
Dialogue: 0,0:02:31.07,0:02:35.07,Caption,,0,0,0,,ПРИВЛЕКАТЕЛЬНУЮ КОМБИНАЦИЮ, ПОЛУЧАЕТ В ОТВЕТ ДЛИННЫЙ ПЕРЕЧЕНЬ ДОПОЛНИТЕЛЬНЫХ
Dialogue: 0,0:02:35.15,0:02:37.71,Caption,,0,0,0,,УСЛОВИЙ И ВОЗВРАЩАЕТСЯ К ТРАМПУ С ГОТОВЫМ
Dialogue: 0,0:02:37.79,0:02:41.31,Caption,,0,0,0,,РЕЗУЛЬТАТОМ. МОЛ, ДАЖЕ ЧЛЕНСТВО В НАТО ПОЛОЖИЛИ ПЕРЕД КИЕВОМ,
Dialogue: 0,0:02:41.63,0:02:44.35,Caption,,0,0,0,,НО ЭТОГО ОКАЗАЛОСЬ МАЛО. ПОСЛЕ ТАКОГО ЗЕЛЕНСКОМУ
Dialogue: 0,0:02:44.35,0:02:48.67,Caption,,0,0,0,,ТРУДНЕЕ ДОКАЗЫВАТЬ, ЧТО СОЕДИНЁННЫЕ ШТАТЫ ПЛОХО СТАРАЛИСЬ. АМЕРИКАНСКАЯ
Dialogue: 0,0:02:48.67,0:02:51.55,Caption,,0,0,0,,СТОРОНА МОЖЕТ ОТВЕТИТЬ БЕЗ ДОЛГОЙ ЛЕКЦИИ СТАРАЛИСЬ,
Dialogue: 0,0:02:51.63,0:02:54.51,Caption,,0,0,0,,ПРЕДЛАГАЛИ, УСЛЫШАЛИ. НЕЛЬЗЯ УТВЕРЖДАТЬ,
Dialogue: 0,0:02:54.75,0:02:57.31,Caption,,0,0,0,,ЧТО В ВАШИНГТОНЕ ДЕЙСТВИТЕЛЬНО РАЗЫГРЫВАЛИ ИМЕННО
Dialogue: 0,0:02:57.31,0:03:00.75,Caption,,0,0,0,,ЭТУ ПАРТИЮ. НО РАСЧЁТ ПОНЯТЕН. ИНОГДА РЕЗУЛЬТАТОМ
Dialogue: 0,0:03:00.83,0:03:02.59,Caption,,0,0,0,,ПЕРЕГОВОРОВ СТАНОВИТСЯ НЕ ДОГОВОР,
Dialogue: 0,0:03:02.90,0:03:05.23,Caption,,0,0,0,,А ПРАВИЛЬНО ОФОРМЛЕННОЕ ЧУЖОЕ НЕСОГЛАСИЕ.
Dialogue: 0,0:03:05.80,0:03:08.75,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ТОЖЕ НЕ БРОСИЛСЯ ОТВЕЧАТЬ В ЛОБ. ДВЕРЬЮ
Dialogue: 0,0:03:08.83,0:03:11.55,Caption,,0,0,0,,ОН НЕ ХЛОПНУЛ И ОБСУЖДЕНИЕ НЕ ОТВЕРГ. ОН
Dialogue: 0,0:03:11.55,0:03:15.79,Caption,,0,0,0,,ДОПУСТИЛ РЕФЕРЕНДУМ, НО ОКРУЖИЛ ВОЗМОЖНОЕ СОГЛАСИЕ ТАКИМ КОЛИЧЕСТВОМ
Dialogue: 0,0:03:15.79,0:03:20.03,Caption,,0,0,0,,ПРЕДВАРИТЕЛЬНЫХ ТРЕБОВАНИЙ, ЧТО ЧЕРЕЗ ЭТОТ ПРОХОД БЕЗ ГРУЗОВОГО СОСТАВА НЕ
Dialogue: 0,0:03:20.03,0:03:23.55,Caption,,0,0,0,,ПРОТИСНУТЬСЯ. ПОЛУЧИЛАСЬ УДОБНАЯ КОНСТРУКЦИЯ. КИЕВ
Dialogue: 0,0:03:23.55,0:03:28.35,Caption,,0,0,0,,ГОТОВ СОГЛАСИТЬСЯ ПОСЛЕ ТОГО, КАК ПАРТНЁРЫ ЗАРАНЕЕ ВЫПОЛНЯТ ПОЧТИ ВСЮ УКРАИНСКУЮ
Dialogue: 0,0:03:28.43,0:03:31.63,Caption,,0,0,0,,ПРОГРАММУ. ЗАОДНО МОЖНО СОХРАНИТЬ ОТКРЫТОЙ ДВЕРЬ И
Dialogue: 0,0:03:31.71,0:03:34.27,Caption,,0,0,0,,НЕ ЗАХОДИТЬ ВНУТРЬ. ЕСЛИ ВАМ НРАВЯТСЯ РАЗБОРЫ,
Dialogue: 0,0:03:34.42,0:03:36.43,Caption,,0,0,0,,В КОТОРЫХ ЗАЯВЛЕНИЕ РАССМАТРИВАЮТ ВМЕСТЕ С
Dialogue: 0,0:03:36.43,0:03:38.83,Caption,,0,0,0,,ИНТЕРЕСАМИ ЕГО АВТОРОВ, ПОДПИСЫВАЙТЕСЬ.
Dialogue: 0,0:03:41.04,0:03:43.84,Caption,,0,0,0,,ДАЛЬШЕ СОЮЗНИКИ НАЧИНАЮТ СПОРИТЬ УЖЕ НЕ С КИЕВОМ,
Dialogue: 0,0:03:44.06,0:03:46.96,Caption,,0,0,0,,А С САМОЙ ВОЗМОЖНОСТЬЮ БОЛЬШОГО РАЗГОВОРА С МОСКВОЙ.
Dialogue: 0,0:03:47.75,0:03:51.92,Caption,,0,0,0,,КАЯ КАЛЛАС ПРЕДУПРЕЖДАЕТ, ЧТО ОБСУЖДЕНИЕ РОССИЙСКИХ ТРЕБОВАНИЙ К БУДУЩЕМУ
Dialogue: 0,0:03:51.92,0:03:54.72,Caption,,0,0,0,,УСТРОЙСТВУ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ СПОСОБНО
Dialogue: 0,0:03:54.72,0:03:57.84,Caption,,0,0,0,,ОТОДВИНУТЬ ПРЕКРАЩЕНИЕ БОЕВЫХ ДЕЙСТВИЙ. ПО ЕЁ
Dialogue: 0,0:03:57.84,0:04:00.16,Caption,,0,0,0,,ЛОГИКЕ, СНАЧАЛА НУЖНО ОСТАНОВИТЬ ОГОНЬ,
Dialogue: 0,0:04:00.55,0:04:03.60,Caption,,0,0,0,,А ЗАТЕМ ПЕРЕХОДИТЬ К БОЛЕЕ ШИРОКИМ ВОПРОСАМ. МОСКВА
Dialogue: 0,0:04:03.60,0:04:06.64,Caption,,0,0,0,,ПРЕДЛАГАЕТ ОБРАТНЫЙ МАСШТАБ. ОНА ХОЧЕТ ГОВОРИТЬ НЕ
Dialogue: 0,0:04:06.72,0:04:09.60,Caption,,0,0,0,,ТОЛЬКО О ЛИНИИ ФРОНТА, НО И О ПРИЧИНАХ КОНФЛИКТА,
Dialogue: 0,0:04:09.84,0:04:12.32,Caption,,0,0,0,,ПОЛОЖЕНИИ УКРАИНЫ И ВОЕННОЙ СИСТЕМЕ ВОКРУГ
Dialogue: 0,0:04:12.40,0:04:15.20,Caption,,0,0,0,,РОССИЙСКИХ ГРАНИЦ. НА ЭТОМ МЕСТЕ ЕВРОПЕЙСКОЕ
Dialogue: 0,0:04:15.20,0:04:18.16,Caption,,0,0,0,,ЕДИНСТВО НАЧИНАЕТ НАПОМИНАТЬ ОБЩИЙ СЕМЕЙНЫЙ БЮДЖЕТ.
Dialogue: 0,0:04:18.46,0:04:22.56,Caption,,0,0,0,,ВСЕ ЗА ЭКОНОМИЮ, НО КАЖДЫЙ ПРЕДЛАГАЕТ СОКРАТИТЬ РАСХОДЫ ДРУГОГО.
Dialogue: 0,0:04:22.91,0:04:26.08,Caption,,0,0,0,,МИНИСТР ОБОРОНЫ ФИНЛЯНДИИ АНТТИ ХЯККЯНЕН НАЗВАЛ
Dialogue: 0,0:04:26.08,0:04:28.24,Caption,,0,0,0,,РОССИЙСКИЕ ТРЕБОВАНИЯ К НАТО СОВЕРШЕННО
Dialogue: 0,0:04:28.24,0:04:30.64,Caption,,0,0,0,,ВОЗМУТИТЕЛЬНЫМИ. В ОПУБЛИКОВАННОМ ВАРИАНТЕ
Dialogue: 0,0:04:30.64,0:04:32.80,Caption,,0,0,0,,ЗАТРАГИВАЮТСЯ ПРИСУТСТВИЕ АЛЬЯНСА,
Dialogue: 0,0:04:33.05,0:04:36.08,Caption,,0,0,0,,УКРАИНСКИЙ СТАТУС И ПОЛОЖЕНИЕ САМОЙ ФИНЛЯНДИИ.
Dialogue: 0,0:04:36.54,0:04:40.80,Caption,,0,0,0,,ХЕЛЬСИНКИ СЧИТАЕТ, ЧТО ПОДОБНЫЕ УСЛОВИЯ НЕ ЗАСЛУЖИВАЮТ ДАЖЕ ОБСУЖДЕНИЯ.
Dialogue: 0,0:04:41.23,0:04:44.88,Caption,,0,0,0,,КАНАДА ЗАНИМАЕТ ПОЧТИ ТАКУЮ ЖЕ ПОЗИЦИЮ. МАРК КАРНИ
Dialogue: 0,0:04:44.88,0:04:48.64,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО СТРАНА НЕ СТАНЕТ ПЕРЕСМАТРИВАТЬ УЧАСТИЕ В НАТО
Dialogue: 0,0:04:48.80,0:04:50.56,Caption,,0,0,0,,И ОБЯЗАТЕЛЬСТВА ПЕРЕД СОЮЗНИКАМИ.
Dialogue: 0,0:04:52.85,0:04:55.57,Caption,,0,0,0,,КАНАДСКИЙ КОНТИНГЕНТ В ЛАТВИИ ОСТАНЕТСЯ НА МЕСТЕ,
Dialogue: 0,0:04:55.72,0:04:58.69,Caption,,0,0,0,,СВОРАЧИВАТЬ ЕГО РАДИ ДОГОВОРЁННОСТИ С РОССИЕЙ ОТТАВА
Dialogue: 0,0:04:58.77,0:05:01.41,Caption,,0,0,0,,НЕ СОБИРАЕТСЯ. КАРТИНА ВЫХОДИТ ЗАНИМАТЕЛЬНАЯ.
Dialogue: 0,0:05:01.76,0:05:04.45,Caption,,0,0,0,,ЗЕЛЕНСКОМУ ПРЕДЛАГАЮТ ЧЛЕНСТВО В АЛЬЯНСЕ В ОБМЕН НА
Dialogue: 0,0:05:04.45,0:05:07.97,Caption,,0,0,0,,ДОНБАСС, А ДЕЙСТВУЮЩИЕ СОЮЗНИКИ ОДНОВРЕМЕННО ЗАЯВЛЯЮТ,
Dialogue: 0,0:05:08.19,0:05:11.01,Caption,,0,0,0,,ЧТО ИХ ВОЕННОЕ ПРИСУТСТВИЕ РЯДОМ С РОССИЕЙ ОБСУЖДАТЬ
Dialogue: 0,0:05:11.01,0:05:14.05,Caption,,0,0,0,,НЕЛЬЗЯ. ДЛЯ БОЛЬШОГО СОГЛАШЕНИЯ УЖЕ ПОЧТИ ВСЁ
Dialogue: 0,0:05:14.05,0:05:19.09,Caption,,0,0,0,,ГОТОВО. ЕСТЬ СТОЛ, УЧАСТНИКИ И МНОЖЕСТВО УСЛОВИЙ. НЕ ХВАТАЕТ СУЩЕЙ
Dialogue: 0,0:05:19.09,0:05:23.01,Caption,,0,0,0,,МЕЛОЧИ ХОТЯ БЫ ОДНОЙ ФОРМУЛЫ, КОТОРУЮ ГОТОВЫ ПРИНЯТЬ ОБЕ СТОРОНЫ.
Dialogue: 0,0:05:23.64,0:05:26.69,Caption,,0,0,0,,ДАЖЕ ВНЕЗАПНОЕ СОГЛАСИЕ КИЕВА НИЧЕГО АВТОМАТИЧЕСКИ
Dialogue: 0,0:05:26.77,0:05:29.01,Caption,,0,0,0,,НЕ РЕШИТ. ПОСЛЕ НЕГО ПРИДЁТСЯ ОБРАЩАТЬСЯ К
Dialogue: 0,0:05:29.01,0:05:33.57,Caption,,0,0,0,,ФИНЛЯНДИИ, КАНАДЕ, ПОЛЬШЕ, ГЕРМАНИИ И СТРАНАМ БАЛТИИ.
Dialogue: 0,0:05:34.18,0:05:36.93,Caption,,0,0,0,,ЧТО КАЖДАЯ ИЗ НИХ ГОТОВА ИЗМЕНИТЬ РАДИ ОБЩЕГО
Dialogue: 0,0:05:36.93,0:05:40.53,Caption,,0,0,0,,РЕЗУЛЬТАТА? ПОКА ОТВЕТ У ВСЕХ КОРОТКИЙ. МЕНЯТЬ ОНИ НЕ
Dialogue: 0,0:05:40.61,0:05:43.49,Caption,,0,0,0,,НАМЕРЕНЫ НИЧЕГО. ТОГДА ПЕРЕГОВОРЫ ПРЕВРАЩАЮТСЯ В
Dialogue: 0,0:05:43.57,0:05:46.29,Caption,,0,0,0,,ОСМОТР ВИТРИНЫ. ТОВАРЫ КРАСИВО РАССТАВЛЕНЫ,
Dialogue: 0,0:05:46.53,0:05:48.93,Caption,,0,0,0,,НО ПРОДАВАТЬ ИХ НИКТО НЕ СОБИРАЕТСЯ. ПРИ ЭТОМ
Dialogue: 0,0:05:48.93,0:05:53.33,Caption,,0,0,0,,МИР КАЖДОМУ ТРЕБУЕТСЯ СРОЧНО, ЖЕЛАТЕЛЬНО ЗА ЧУЖОЙ СЧЁТ И БЕЗ ПЕРЕМЕН В
Dialogue: 0,0:05:53.33,0:05:57.89,Caption,,0,0,0,,СОБСТВЕННОМ ПОЛОЖЕНИИ. НА ТАКОМ ФОНЕ ИЗ ВЕЛИКОБРИТАНИИ ПОСТУПИЛ ОСОБЕННО
Dialogue: 0,0:05:57.89,0:06:01.41,Caption,,0,0,0,,БОДРЫЙ СОВЕТ. РИШИ СУНАК ПРИЗВАЛ ЛОНДОН БЫТЬ ГОТОВЫМ
Dialogue: 0,0:06:01.49,0:06:03.97,Caption,,0,0,0,,НАНЕСТИ УДАРЫ ПО РОССИЙСКИМ БАЗАМ НА КОЛЬСКОМ
Dialogue: 0,0:06:03.97,0:06:09.84,Caption,,0,0,0,,ПОЛУОСТРОВЕ. ТАМ РАЗМЕЩЕНЫ СЕВЕРНЫЙ ФЛОТ И СУЩЕСТВЕННАЯ ЧАСТЬ
Dialogue: 0,0:06:09.84,0:06:12.72,Caption,,0,0,0,,РОССИЙСКИХ ЯДЕРНЫХ СИЛ. ПО МЫСЛИ БЫВШЕГО ПРЕМЬЕРА,
Dialogue: 0,0:06:13.03,0:06:15.92,Caption,,0,0,0,,ЗАПАДУ СЛЕДУЕТ ПОКАЗАТЬ СПОСОБНОСТЬ ПРИЧИНИТЬ УЩЕРБ
Dialogue: 0,0:06:15.92,0:06:18.96,Caption,,0,0,0,,СТРАТЕГИЧЕСКОЙ ИНФРАСТРУКТУРЕ РОССИИ. РИШИ,
Dialogue: 0,0:06:19.28,0:06:22.00,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ ЗВУЧИТ ГРОЗНО. ТОЛЬКО ДОЛЖНОСТЬ У ТЕБЯ
Dialogue: 0,0:06:22.08,0:06:24.72,Caption,,0,0,0,,УЖЕ ДРУГАЯ. КОГДА СУНАК ВОЗГЛАВЛЯЛ БРИТАНСКОЕ
Dialogue: 0,0:06:24.72,0:06:28.00,Caption,,0,0,0,,ПРАВИТЕЛЬСТВО, В ЕГО РАСПОРЯЖЕНИИ НАХОДИЛИСЬ МИНИСТРЫ,
Dialogue: 0,0:06:28.15,0:06:32.48,Caption,,0,0,0,,РАЗВЕДКА, ВОЕННОЕ КОМАНДОВАНИЕ И ДОСТУП К НАСТОЯЩИМ ПЛАНАМ,
Dialogue: 0,0:06:32.64,0:06:35.36,Caption,,0,0,0,,А НЕ К МИКРОФОНУ ПОСЛЕ ОТСТАВКИ. ПОЧЕМУ ТОГДА
Dialogue: 0,0:06:35.36,0:06:37.92,Caption,,0,0,0,,КОЛЬСКИЙ ПОЛУОСТРОВ НЕ ОКАЗАЛСЯ В СПИСКЕ СРОЧНЫХ
Dialogue: 0,0:06:38.00,0:06:41.52,Caption,,0,0,0,,ДЕЛ? МОЖНО БЫЛО СОБРАТЬ КАБИНЕТ И ОБЪЯВИТЬ ПОДГОТОВКУ.
Dialogue: 0,0:06:41.83,0:06:45.92,Caption,,0,0,0,,ВОЗМОЖНОСТИ БЫЛИ, ПОЛНОМОЧИЯ ТОЖЕ. НО ПРИ ЖИЗНИ НА ДАУНИНГ СТРИТ
Dialogue: 0,0:06:45.92,0:06:48.48,Caption,,0,0,0,,ВОИНСТВЕННЫЙ ПОРЫВ ПОЧЕМУ ТО НЕ ДОБРАЛСЯ ДО ЭТОЙ
Dialogue: 0,0:06:48.48,0:06:51.20,Caption,,0,0,0,,СТАДИИ. ТЕПЕРЬ РЕШИТЕЛЬНОСТЬ ОБХОДИТСЯ ДЕШЕВЛЕ.
Dialogue: 0,0:06:51.65,0:06:54.88,Caption,,0,0,0,,СУНАК ПРЕДЛАГАЕТ КАБИНЕТУ КИРА СТАРМЕРА УДАРИТЬ ПО
Dialogue: 0,0:06:54.88,0:06:57.92,Caption,,0,0,0,,БАЗАМ СЕВЕРНОГО ФЛОТА И ПРИНЯТЬ РИСК ОТВЕТНОГО
Dialogue: 0,0:06:58.00,0:06:59.92,Caption,,0,0,0,,РАКЕТНОГО УДАРА ПО БРИТАНСКОЙ ВОЕННОЙ
Dialogue: 0,0:06:59.92,0:07:03.76,Caption,,0,0,0,,ИНФРАСТРУКТУРЕ; ЦЕНУ ЭСКАЛАЦИИ ЗАПЛАТЯТ НЫНЕШНЕЕ ПРАВИТЕЛЬСТВО И
Dialogue: 0,0:07:03.84,0:07:07.36,Caption,,0,0,0,,СТРАНА. САМ ОН, РАСПОЛАГАЯ ПРЕМЬЕРСКИМИ ПОЛНОМОЧИЯМИ,
Dialogue: 0,0:07:07.52,0:07:10.72,Caption,,0,0,0,,ТАКОГО ПРИКАЗА НЕ ОТДАЛ. ПОСЛЕ ОТСТАВКИ ЕМУ ОСТАЁТСЯ
Dialogue: 0,0:07:10.80,0:07:13.60,Caption,,0,0,0,,ЛИШЬ СТОЯТЬ РЯДОМ С СОБСТВЕННЫМ СОВЕТОМ И ВЫГЛЯДЕТЬ
Dialogue: 0,0:07:13.60,0:07:17.52,Caption,,0,0,0,,СУРОВО. ВООБЩЕ БЫВШИЕ ЧИНОВНИКИ В ЭТОТ РАЗ НАСТУПАЮТ ДРУЖНО.
Dialogue: 0,0:07:17.76,0:07:20.56,Caption,,0,0,0,,ПРАВДА, ПОКА ПРЕИМУЩЕСТВЕННО НА СТРАНИЦЫ ГАЗЕТ.
Dialogue: 0,0:07:22.84,0:07:25.88,Caption,,0,0,0,,СУНАК УЖЕ НЕ ПРЕМЬЕР. ДМИТРИЙ КУЛЕБА УЖЕ НЕ
Dialogue: 0,0:07:25.88,0:07:28.68,Caption,,0,0,0,,РУКОВОДИТ УКРАИНСКИМ ВНЕШНЕПОЛИТИЧЕСКИМ ВЕДОМСТВОМ.
Dialogue: 0,0:07:28.90,0:07:31.40,Caption,,0,0,0,,ЗАТО У ОБОИХ ПОЯВИЛИСЬ СОВЕТЫ ДЛЯ ТЕХ,
Dialogue: 0,0:07:31.72,0:07:34.76,Caption,,0,0,0,,КТО ОТВЕЧАЕТ ЗА РЕЗУЛЬТАТ СЕГОДНЯ. КУЛЕБА СЧИТАЕТ,
Dialogue: 0,0:07:35.08,0:07:38.20,Caption,,0,0,0,,ЧТО ЕДИНСТВЕННАЯ СТРАТЕГИЯ УКРАИНЫ СЕЙЧАС СОСТОИТ В
Dialogue: 0,0:07:38.20,0:07:41.32,Caption,,0,0,0,,СПОСОБНОСТИ ДЕРЖАТЬСЯ МАКСИМАЛЬНО ДОЛГО. ЗВУЧИТ
Dialogue: 0,0:07:41.32,0:07:44.44,Caption,,0,0,0,,МУЖЕСТВЕННО. НО СТРАТЕГИЯ ОБЯЗАНА ОТВЕЧАТЬ НЕ ТОЛЬКО
Dialogue: 0,0:07:44.52,0:07:48.36,Caption,,0,0,0,,НА ВОПРОС "СКОЛЬКО", НО И НА ВОПРОС "ЗАЧЕМ". ПРЕДПОЛОЖИМ,
Dialogue: 0,0:07:48.46,0:07:51.96,Caption,,0,0,0,,УКРАИНА ВЫДЕРЖИВАЕТ ЕЩЁ ГОД. ЗАТЕМ ВТОРОЙ. ПОТОМ
Dialogue: 0,0:07:52.04,0:07:54.92,Caption,,0,0,0,,ТРЕТИЙ. КАКОЕ СОБЫТИЕ ДОЛЖНО ОЗНАЧАТЬ,
Dialogue: 0,0:07:55.08,0:07:58.60,Caption,,0,0,0,,ЧТО РАСЧЁТ СРАБОТАЛ? РОССИЯ ОТКАЖЕТСЯ ОТ СВОИХ ТРЕБОВАНИЙ?
Dialogue: 0,0:07:58.92,0:08:01.24,Caption,,0,0,0,,ЕЁ ЭКОНОМИКА ПЕРЕСТАНЕТ ВЫДЕРЖИВАТЬ НАГРУЗКУ?
Dialogue: 0,0:08:01.56,0:08:05.48,Caption,,0,0,0,,ПУТИН ИЗМЕНИТ РЕШЕНИЕ? ЗАПАД ПЕРЕДАСТ ТАКОЙ ОБЪЁМ ВООРУЖЕНИЙ,
Dialogue: 0,0:08:05.72,0:08:07.56,Caption,,0,0,0,,ЧТО ПОЛОЖЕНИЕ НА ФРОНТЕ ПЕРЕВЕРНЁТСЯ?
Dialogue: 0,0:08:07.89,0:08:09.80,Caption,,0,0,0,,ВНУТРИ РОССИИ ПРОИЗОЙДУТ ПЕРЕМЕНЫ?
Dialogue: 0,0:08:10.02,0:08:12.68,Caption,,0,0,0,,БЕЗ КОНЕЧНОЙ ТОЧКИ СЛОВО "ДЕРЖАТЬСЯ" ОПИСЫВАЕТ
Dialogue: 0,0:08:12.68,0:08:14.76,Caption,,0,0,0,,СОСТОЯНИЕ, А НЕ ПУТЬ К РЕЗУЛЬТАТУ.
Dialogue: 0,0:08:15.32,0:08:18.44,Caption,,0,0,0,,КУЛЕБА СВЯЗЫВАЕТ НАДЕЖДУ С ИЗМЕНЕНИЕМ ОБСТОЯТЕЛЬСТВ,
Dialogue: 0,0:08:18.60,0:08:21.80,Caption,,0,0,0,,СПОСОБНЫХ ПОВЛИЯТЬ НА РЕШЕНИЯ ПУТИНА. ОДНАКО САМИ
Dialogue: 0,0:08:21.80,0:08:24.84,Caption,,0,0,0,,ОБСТОЯТЕЛЬСТВА ОСТАЮТСЯ ЗА КАДРОМ. НЕ НАЗВАНЫ НИ
Dialogue: 0,0:08:24.84,0:08:29.96,Caption,,0,0,0,,МЕХАНИЗМ, НИ СРОК, НИ ПРИЗНАК ПРИБЛИЖЕНИЯ НУЖНОГО МОМЕНТА. ПОЛУЧАЕТСЯ
Dialogue: 0,0:08:30.04,0:08:33.32,Caption,,0,0,0,,ОЖИДАНИЕ С ОЧЕНЬ ВЫСОКОЙ ЕЖЕМЕСЯЧНОЙ ПЛАТОЙ. УКРАИНА
Dialogue: 0,0:08:33.32,0:08:37.72,Caption,,0,0,0,,ПРОДОЛЖАЕТ ВОЙНУ, А ПОДХОДЯЩЕЕ СОБЫТИЕ ДОЛЖНО ОДНАЖДЫ ВОЙТИ БЕЗ СТУКА
Dialogue: 0,0:08:37.86,0:08:43.99,Caption,,0,0,0,,И ВСЁ ИЗМЕНИТЬ. У СУНАКА ХОТЯ БЫ ОБОЗНАЧЕНО ДЕЙСТВИЕ. ОНО СПОСОБНО
Dialogue: 0,0:08:43.99,0:08:47.91,Caption,,0,0,0,,ПРИВЕСТИ К КАТАСТРОФЕ, НО ПОНЯТЬ ЕГО МОЖНО УДАРИТЬ ПО РОССИЙСКОЙ
Dialogue: 0,0:08:47.91,0:08:50.79,Caption,,0,0,0,,СТРАТЕГИЧЕСКОЙ ИНФРАСТРУКТУРЕ И ПРОДЕМОНСТРИРОВАТЬ
Dialogue: 0,0:08:50.79,0:08:53.83,Caption,,0,0,0,,УГРОЗУ. У ФОРМУЛЫ КУЛЕБЫ ПОНЯТНА ТОЛЬКО
Dialogue: 0,0:08:53.83,0:08:56.63,Caption,,0,0,0,,ПРОДОЛЖИТЕЛЬНОСТЬ. ФИНАЛ СПРЯТАН ТАК НАДЁЖНО,
Dialogue: 0,0:08:56.95,0:08:59.67,Caption,,0,0,0,,БУДТО ЗА ЕГО ОБНАРУЖЕНИЕ ТОЖЕ ОТВЕЧАЕТ КТО ТО
Dialogue: 0,0:08:59.67,0:09:03.35,Caption,,0,0,0,,ИЗ СОЮЗНИКОВ. И ТУТ МАРЬЯНА БЕЗУГЛАЯ ОКАЗЫВАЕТСЯ
Dialogue: 0,0:09:03.35,0:09:06.55,Caption,,0,0,0,,ПРАКТИЧНЕЕ БЫВШЕГО МИНИСТРА. ЕСЛИ СТРАНА ДОЛЖНА
Dialogue: 0,0:09:06.55,0:09:09.27,Caption,,0,0,0,,ДЕРЖАТЬСЯ ДОЛГО, КТО ТО ОБЯЗАН ПОСЧИТАТЬ,
Dialogue: 0,0:09:09.64,0:09:11.91,Caption,,0,0,0,,ЗА СЧЁТ ЧЕГО ОНА БУДЕТ ЭТО ДЕЛАТЬ. НУЖНЫ
Dialogue: 0,0:09:11.91,0:09:14.39,Caption,,0,0,0,,ВООРУЖЕНИЕ, БОЕПРИПАСЫ И ДЕНЬГИ.
Dialogue: 0,0:09:15.03,0:09:17.83,Caption,,0,0,0,,НО ДАЖЕ ОГРОМНЫЙ БАНКОВСКИЙ ПЕРЕВОД НЕ ЗАНИМАЕТ
Dialogue: 0,0:09:17.83,0:09:21.27,Caption,,0,0,0,,ПОЗИЦИЮ И НЕ ЗАМЕНЯЕТ ЛИЧНЫЙ СОСТАВ. ГЛАВНЫМ
Dialogue: 0,0:09:21.27,0:09:25.91,Caption,,0,0,0,,ОГРАНИЧЕНИЕМ СТАНОВЯТСЯ ЛЮДИ. ЗДЕСЬ УЖЕ НЕТ ОЖИДАНИЯ СЛУЧАЙНОГО ПОДАРКА ОТ
Dialogue: 0,0:09:25.91,0:09:28.71,Caption,,0,0,0,,ОБСТОЯТЕЛЬСТВ. КУЛЕБА ПРЕДЛАГАЕТ ВЫИГРАТЬ ВРЕМЯ,
Dialogue: 0,0:09:28.95,0:09:31.51,Caption,,0,0,0,,А БЕЗУГЛАЯ СРАЗУ ОТКРЫВАЕТ СЧЁТ И ПОКАЗЫВАЕТ,
Dialogue: 0,0:09:31.75,0:09:33.67,Caption,,0,0,0,,КЕМ ЗА ЭТО ВРЕМЯ ПРИДЁТСЯ ПЛАТИТЬ.
Dialogue: 0,0:09:34.55,0:09:37.75,Caption,,0,0,0,,МУЖСКОЙ МОБИЛИЗАЦИОННЫЙ РЕСУРС НЕ БЕСКОНЕЧЕН. ЕСЛИ
Dialogue: 0,0:09:37.83,0:09:40.07,Caption,,0,0,0,,БОЕВЫЕ ДЕЙСТВИЯ ДОЛЖНЫ ПРОДОЛЖАТЬСЯ ГОДАМИ,
Dialogue: 0,0:09:40.39,0:09:42.79,Caption,,0,0,0,,ВЛАСТИ НЕИЗБЕЖНО ДОБИРАЮТСЯ ДО КАТЕГОРИЙ,
Dialogue: 0,0:09:43.03,0:09:45.83,Caption,,0,0,0,,КОТОРЫЕ РАНЬШЕ СТАРАЛИСЬ НЕ ЗАТРАГИВАТЬ. СНАЧАЛА
Dialogue: 0,0:09:45.91,0:09:48.15,Caption,,0,0,0,,РЕЧЬ ИДЁТ О ЖЕНЩИНАХ С НУЖНЫМИ СПЕЦИАЛЬНОСТЯМИ.
Dialogue: 0,0:09:48.55,0:09:50.31,Caption,,0,0,0,,ЗАТЕМ О ГРАЖДАНСКИХ РАБОТНИКАХ,
Dialogue: 0,0:09:50.47,0:09:53.35,Caption,,0,0,0,,ЗАЩИЩЁННЫХ БРОНЬЮ. ПОТОМ О ШКОЛЬНИКАХ,
Dialogue: 0,0:09:53.58,0:09:55.99,Caption,,0,0,0,,КОТОРЫХ ПРЕДЛАГАЮТ ЗАРАНЕЕ ГОТОВИТЬ К БУДУЩЕЙ
Dialogue: 0,0:09:55.99,0:10:01.14,Caption,,0,0,0,,СЛУЖБЕ. ДОПОЛНИТЕЛЬНЫЕ ПОДРАЗДЕЛЕНИЯ НЕ ПОЯВЛЯЮТСЯ ПО
Dialogue: 0,0:10:01.14,0:10:04.02,Caption,,0,0,0,,ПРОСЬБЕ ВЕДУЩЕГО. ЗА КАЖДЫМ НОВЫМ МЕСЯЦЕМ СТОЯТ
Dialogue: 0,0:10:04.02,0:10:07.06,Caption,,0,0,0,,КОНКРЕТНЫЕ ЛЮДИ, КОТОРЫХ НУЖНО ПОСТАВИТЬ НА УЧЁТ,
Dialogue: 0,0:10:07.21,0:10:11.54,Caption,,0,0,0,,ОБУЧИТЬ, ВООРУЖИТЬ И ОТПРАВИТЬ ВЫПОЛНЯТЬ ЗАДАЧУ. БЕЗУГЛАЯ
Dialogue: 0,0:10:11.54,0:10:14.10,Caption,,0,0,0,,ПРОСТО ДОВОДИТ ИДЕЮ КУЛЕБЫ ДО ЕЁ МАТЕРИАЛЬНОГО
Dialogue: 0,0:10:14.10,0:10:17.70,Caption,,0,0,0,,СОДЕРЖАНИЯ. ЕСЛИ ВРЕМЯ ОБЪЯВЛЕНО ГЛАВНЫМ РЕСУРСОМ,
Dialogue: 0,0:10:18.02,0:10:20.90,Caption,,0,0,0,,КТО ТО ДОЛЖЕН ОБЕСПЕЧИТЬ ЕГО ЛЮДЬМИ. ЧЕМ ДОЛЬШЕ
Dialogue: 0,0:10:20.90,0:10:23.46,Caption,,0,0,0,,СТРАНА ДЕРЖИТСЯ БЕЗ ЯСНОЙ КОНЕЧНОЙ ТОЧКИ,
Dialogue: 0,0:10:23.75,0:10:27.06,Caption,,0,0,0,,ТЕМ ГЛУБЖЕ ПРИХОДИТСЯ ЗАЧЕРПЫВАТЬ ИЗ ОБЩЕСТВА. ЦЕНА
Dialogue: 0,0:10:27.14,0:10:29.70,Caption,,0,0,0,,ЭТОЙ СТРАТЕГИИ РАСТЁТ НЕ В ТЕОРИИ. ОНА ПРИХОДИТ
Dialogue: 0,0:10:29.70,0:10:33.54,Caption,,0,0,0,,ПОВЕСТКОЙ, СОКРАЩЁННОЙ БРОНЬЮ И НОВЫМИ ТРЕБОВАНИЯМИ К ТЕМ,
Dialogue: 0,0:10:33.87,0:10:36.74,Caption,,0,0,0,,КОГО ВЧЕРА ЕЩЁ НЕ СЧИТАЛИ ЧАСТЬЮ МОБИЛИЗАЦИОННОГО
Dialogue: 0,0:10:36.82,0:10:39.62,Caption,,0,0,0,,ЗАПАСА. ВСЯ КОНСТРУКЦИЯ ТЕПЕРЬ ВИДНА ЦЕЛИКОМ.
Dialogue: 0,0:10:40.10,0:10:42.82,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ ПРЕДЛАГАЮТ ЗЕЛЕНСКОМУ ОБМЕН
Dialogue: 0,0:10:42.82,0:10:46.02,Caption,,0,0,0,,ДОНБАССА НА НАТО. ЕВРОПЕЙСКИЕ СОЮЗНИКИ ПЕРЕЧИСЛЯЮТ
Dialogue: 0,0:10:46.02,0:10:50.74,Caption,,0,0,0,,СОБСТВЕННЫЕ ПОЗИЦИИ, КОТОРЫЕ НЕ НАМЕРЕНЫ ПЕРЕСМАТРИВАТЬ. СУНАК СОВЕТУЕТ
Dialogue: 0,0:10:50.74,0:10:53.46,Caption,,0,0,0,,НЫНЕШНИМ ВЛАСТЯМ ГОТОВИТЬСЯ К УДАРУ ПО РОССИЙСКИМ
Dialogue: 0,0:10:53.46,0:10:56.66,Caption,,0,0,0,,СТРАТЕГИЧЕСКИМ ОБЪЕКТАМ. КУЛЕБА ПРЕДЛАГАЕТ УКРАИНЕ
Dialogue: 0,0:10:56.74,0:10:59.78,Caption,,0,0,0,,ЖДАТЬ БЛАГОПРИЯТНОГО ПЕРЕЛОМА. БЕЗУГЛАЯ СЧИТАЕТ
Dialogue: 0,0:10:59.86,0:11:03.62,Caption,,0,0,0,,ЛЮДЕЙ, СПОСОБНЫХ ОПЛАТИТЬ ЭТО ОЖИДАНИЕ. КАЖДЫЙ ПРОИЗНОСИТ
Dialogue: 0,0:11:03.70,0:11:06.66,Caption,,0,0,0,,УВЕРЕННЫЕ СЛОВА. ТОЛЬКО ПЛАНЫ У НИХ ЗАКАНЧИВАЮТСЯ В
Dialogue: 0,0:11:06.74,0:11:09.78,Caption,,0,0,0,,РАЗНЫХ МЕСТАХ. У ВАШИНГТОНА ВОЗМОЖНАЯ ЦЕЛЬ ХОТЯ БЫ
Dialogue: 0,0:11:09.78,0:11:15.49,Caption,,0,0,0,,ПРОСМАТРИВАЕТСЯ. ЕСЛИ АМЕРИКАНЦАМ ТРЕБОВАЛСЯ ОТКАЗ ЗЕЛЕНСКОГО,
Dialogue: 0,0:11:15.79,0:11:20.29,Caption,,0,0,0,,ОНИ ПОЛУЧИЛИ МАТЕРИАЛ, С КОТОРЫМ МОГУТ МЕНЯТЬ ДАЛЬНЕЙШУЮ ЛИНИЮ И УБЕЖДАТЬ
Dialogue: 0,0:11:20.29,0:11:23.97,Caption,,0,0,0,,ТРАМПА, ЧТО КИЕВ ОТВЕРГАЕТ ДАЖЕ КРУПНУЮ УСТУПКУ СО СТОРОНЫ
Dialogue: 0,0:11:23.97,0:11:27.73,Caption,,0,0,0,,США. У СУНАКА ТОЖЕ ИМЕЕТСЯ КОНКРЕТНОЕ ПРЕДЛОЖЕНИЕ.
Dialogue: 0,0:11:28.04,0:11:32.61,Caption,,0,0,0,,БЕЗРАССУДНОЕ, КРАЙНЕ ОПАСНОЕ, СПОСОБНОЕ ПОДНЯТЬ СТАВКИ ДО ПРЕДЕЛА,
Dialogue: 0,0:11:32.98,0:11:36.13,Caption,,0,0,0,,НО ВСЁ ЖЕ ПОНЯТНОЕ. УКРАИНСКАЯ ФОРМУЛА ПОКА СВОДИТСЯ
Dialogue: 0,0:11:36.21,0:11:38.05,Caption,,0,0,0,,К ПРОДОЛЖЕНИЮ. ДОЛЬШЕ ВОЕВАТЬ,
Dialogue: 0,0:11:38.26,0:11:42.29,Caption,,0,0,0,,ШИРЕ МОБИЛИЗОВАТЬ, СИЛЬНЕЕ ОГРАНИЧИВАТЬ БРОНЬ И НАДЕЯТЬСЯ,
Dialogue: 0,0:11:42.50,0:11:45.33,Caption,,0,0,0,,ЧТО ВНЕШНИЕ ОБСТОЯТЕЛЬСТВА ОДНАЖДЫ СДЕЛАЮТ ТО,
Dialogue: 0,0:11:45.65,0:11:48.69,Caption,,0,0,0,,ЧЕГО НЕ СМОГЛА СДЕЛАТЬ САМА СТРАТЕГИЯ. НО СТРАНА
Dialogue: 0,0:11:48.77,0:11:51.01,Caption,,0,0,0,,ДОЛЖНА ПРИЙТИ К ОПРЕДЕЛЁННОМУ РЕЗУЛЬТАТУ,
Dialogue: 0,0:11:51.25,0:11:54.13,Caption,,0,0,0,,А НЕ ПРОСТО К СЛЕДУЮЩЕМУ КАЛЕНДАРНОМУ ГОДУ. ПОЭТОМУ
Dialogue: 0,0:11:54.13,0:11:56.85,Caption,,0,0,0,,АМЕРИКАНСКАЯ ИНИЦИАТИВА ВАЖНА НЕ ТОЛЬКО СВОИМ
Dialogue: 0,0:11:56.85,0:11:59.65,Caption,,0,0,0,,СОДЕРЖАНИЕМ. ЕСЛИ ВАШИНГТОН ПРОВЕРЯЛ СПОСОБНОСТЬ
Dialogue: 0,0:11:59.73,0:12:03.25,Caption,,0,0,0,,ЗЕЛЕНСКОГО ПРИНЯТЬ СДЕЛКУ, ПРОВЕРКА ЗАКОНЧИЛАСЬ ПЕРЕЧНЕМ УСЛОВИЙ.
Dialogue: 0,0:12:03.81,0:12:06.21,Caption,,0,0,0,,ЕСЛИ ЖЕ ПРОВЕРЯЛИ ЕГО ГОТОВНОСТЬ ОТКАЗАТЬСЯ,
Dialogue: 0,0:12:06.42,0:12:09.65,Caption,,0,0,0,,ЗАДАЧА БЫЛА ВЫПОЛНЕНА ЕЩЁ УСПЕШНЕЕ. В ТАКОМ СЛУЧАЕ
Dialogue: 0,0:12:09.65,0:12:12.37,Caption,,0,0,0,,СЛЕДУЮЩИЙ ШАГ ЗАВИСИТ УЖЕ НЕ ОТ НОВЫХ ПОДАРКОВ
Dialogue: 0,0:12:12.37,0:12:17.89,Caption,,0,0,0,,КИЕВУ. ОН ЗАВИСИТ ОТ ТОГО, КАК В БЕЛОМ ДОМЕ ИСТОЛКУЮТ ПОЛУЧЕННЫЙ ОТВЕТ И
Dialogue: 0,0:12:17.97,0:12:21.09,Caption,,0,0,0,,КОМУ ПРЕДЪЯВЯТ СЧЁТ ЗА ПРОДОЛЖЕНИЕ ВОЙНЫ. НАПИШИТЕ В
Dialogue: 0,0:12:21.09,0:12:23.97,Caption,,0,0,0,,КОММЕНТАРИЯХ, ЧЕГО, ПО ВАШЕМУ МНЕНИЮ,
Dialogue: 0,0:12:24.21,0:12:27.09,Caption,,0,0,0,,ДОБИВАЛИСЬ АМЕРИКАНЦЫ СОГЛАШЕНИЯ ИЛИ УДОБНОГО
Dialogue: 0,0:12:27.17,0:12:31.84,Caption,,0,0,0,,ОТКАЗА? ПОТОМУ ЧТО ИНОГДА ПРЕДЛОЖЕНИЕ ДЕЛАЮТ РАДИ
Dialogue: 0,0:12:31.84,0:12:35.20,Caption,,0,0,0,,РУКОПОЖАТИЯ, А ИНОГДА РАДИ ВОЗМОЖНОСТИ ПОКАЗАТЬ,
Dialogue: 0,0:12:35.36,0:12:36.72,Caption,,0,0,0,,КТО ПЕРВЫМ УБРАЛ РУКУ.
