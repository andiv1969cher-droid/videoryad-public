Dialogue: 0,0:00:00.12,0:00:02.84,Caption,,0,0,0,,ВАШИНГТОНУ ПОНАДОБИЛОСЬ ОДНО СЛОВО ЗЕЛЕНСКОГО.
Dialogue: 0,0:00:03.00,0:00:07.32,Caption,,0,0,0,,ПРИЧЁМ, ВОЗМОЖНО, ВОВСЕ НЕ "ДА". ЕМУ ПРЕДЛОЖИЛИ ТАКУЮ СДЕЛКУ,
Dialogue: 0,0:00:07.56,0:00:09.96,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ ОТКАЗ МОЖНО АККУРАТНО ПОЛОЖИТЬ В
Dialogue: 0,0:00:09.96,0:00:13.48,Caption,,0,0,0,,ПАПКУ, ОТНЕСТИ ТРАМПУ И СКАЗАТЬ МЫ ПРИНЕСЛИ КИЕВУ ПОЧТИ
Dialogue: 0,0:00:13.48,0:00:16.68,Caption,,0,0,0,,ВСЁ, А ОН СНОВА ДОСТАЛ СПИСОК ТРЕБОВАНИЙ ТОЛЩИНОЙ С
Dialogue: 0,0:00:16.68,0:00:19.64,Caption,,0,0,0,,РЕСТОРАННОЕ МЕНЮ. ПОДПИСЫВАЙТЕСЬ НА КАНАЛ. ЗДЕСЬ
Dialogue: 0,0:00:19.72,0:00:22.28,Caption,,0,0,0,,ЛЮБОПЫТНЕЕ НЕ ТО, ЧТО ПРЕДЛОЖИЛИ ЗЕЛЕНСКОМУ,
Dialogue: 0,0:00:22.44,0:00:24.76,Caption,,0,0,0,,А КАКОЙ ОТВЕТ ИЗ НЕГО ХОТЕЛИ ПОЛУЧИТЬ. ПО
Dialogue: 0,0:00:24.84,0:00:26.36,Caption,,0,0,0,,СЛОВАМ УКРАИНСКОГО ПРЕЗИДЕНТА,
Dialogue: 0,0:00:26.59,0:00:29.32,Caption,,0,0,0,,ПРЕДСТАВИТЕЛИ СОЕДИНЁННЫХ ШТАТОВ ВПЕРВЫЕ ЗАДАЛИ ЕМУ
Dialogue: 0,0:00:29.32,0:00:32.84,Caption,,0,0,0,,ПРЯМОЙ ВОПРОС. ГОТОВ ЛИ КИЕВ ВЫВЕСТИ ВОЙСКА ИЗ
Dialogue: 0,0:00:32.84,0:00:36.04,Caption,,0,0,0,,ДОНБАССА, ЕСЛИ УКРАИНА ВЗАМЕН СТАНЕТ ЧЛЕНОМ НАТО?
Dialogue: 0,0:00:36.69,0:00:39.40,Caption,,0,0,0,,ЗЕЛЕНСКИЙ СОГЛАШАТЬСЯ НЕ СТАЛ. ВМЕСТО ОДНОГО
Dialogue: 0,0:00:39.48,0:00:42.28,Caption,,0,0,0,,КОРОТКОГО СЛОВА ОН ПЕРЕЧИСЛИЛ УСЛОВИЯ. УКРАИНЕ
Dialogue: 0,0:00:42.28,0:00:45.32,Caption,,0,0,0,,ТРЕБУЮТСЯ ПОЛНОЦЕННЫЕ ГАРАНТИИ БЕЗОПАСНОСТИ ОТ НАТО
Dialogue: 0,0:00:45.32,0:00:47.88,Caption,,0,0,0,,И ЕВРОСОЮЗА, ПОСТОЯННОЕ ФИНАНСИРОВАНИЕ,
Dialogue: 0,0:00:48.11,0:00:50.76,Caption,,0,0,0,,ВООРУЖЕНИЕ АРМИИ И СРЕДСТВА НА ВОССТАНОВЛЕНИЕ.
Dialogue: 0,0:00:51.08,0:00:53.48,Caption,,0,0,0,,НЕЙТРАЛИТЕТ В КОНСТИТУЦИИ КИЕВ ЗАКРЕПЛЯТЬ НЕ
Dialogue: 0,0:00:53.48,0:00:56.20,Caption,,0,0,0,,НАМЕРЕН. РОССИЙСКИЙ СТАТУС ПОТЕРЯННЫХ ТЕРРИТОРИЙ
Dialogue: 0,0:00:56.28,0:00:59.64,Caption,,0,0,0,,ПРИЗНАВАТЬ ЮРИДИЧЕСКИ ТОЖЕ НЕ СОБИРАЕТСЯ. АМЕРИКАНЦЫ
Dialogue: 0,0:00:59.64,0:01:04.20,Caption,,0,0,0,,ПРИНЕСЛИ ОДИН ДОГОВОР, А ПОЛУЧИЛИ ЗАЯВКУ НА ПОЛНЫЙ КОМПЛЕКТ С ДОСТАВКОЙ,
Dialogue: 0,0:01:04.35,0:01:07.40,Caption,,0,0,0,,СБОРКОЙ И ПОЖИЗНЕННЫМ ОБСЛУЖИВАНИЕМ. ОТСЮДА И
Dialogue: 0,0:01:07.40,0:01:10.60,Caption,,0,0,0,,ВОЗНИКАЕТ ГЛАВНЫЙ ВОПРОС. А СОГЛАСИЕ ЗЕЛЕНСКОГО
Dialogue: 0,0:01:10.60,0:01:12.28,Caption,,0,0,0,,ВООБЩЕ ВХОДИЛО В АМЕРИКАНСКИЙ ПЛАН?
Dialogue: 0,0:01:14.57,0:01:18.49,Caption,,0,0,0,,ВОЗМОЖНО, ВАШИНГТОНУ ТРЕБОВАЛСЯ ИМЕННО ТАКОЙ ОТВЕТ. ТОГДА
Dialogue: 0,0:01:18.57,0:01:21.13,Caption,,0,0,0,,СТРАННОЕ ПРЕДЛОЖЕНИЕ СРАЗУ ПЕРЕСТАЁТ ВЫГЛЯДЕТЬ
Dialogue: 0,0:01:21.13,0:01:24.17,Caption,,0,0,0,,СТРАННЫМ. ПРЕДСТАВИТЕЛЬ США ПРИЕЗЖАЕТ В КИЕВ И
Dialogue: 0,0:01:24.17,0:01:28.33,Caption,,0,0,0,,ВЫКЛАДЫВАЕТ ВАРИАНТ, КОТОРЫЙ ДЛЯ УКРАИНСКОЙ ВЛАСТИ ТРУДНО НАЗВАТЬ ПУСТЫМ.
Dialogue: 0,0:01:28.82,0:01:30.65,Caption,,0,0,0,,ТЕРРИТОРИАЛЬНАЯ УСТУПКА ОГРОМНАЯ,
Dialogue: 0,0:01:30.89,0:01:33.61,Caption,,0,0,0,,ЗАТО НА ДРУГОЙ ЧАШЕ НАХОДИТСЯ ЧЛЕНСТВО В НАТО,
Dialogue: 0,0:01:33.78,0:01:36.49,Caption,,0,0,0,,КОТОРОГО УКРАИНА ДОБИВАЕТСЯ МНОГО ЛЕТ. ПРИ ЭТОМ
Dialogue: 0,0:01:36.49,0:01:39.45,Caption,,0,0,0,,АМЕРИКАНСКАЯ СТОРОНА ПРЕКРАСНО ЗНАЕТ ПОЗИЦИЮ КИЕВА.
Dialogue: 0,0:01:39.75,0:01:42.01,Caption,,0,0,0,,ТАМ НЕ РАЗ СЛЫШАЛИ ОТКАЗ ОТ НЕЙТРАЛИТЕТА,
Dialogue: 0,0:01:42.25,0:01:44.65,Caption,,0,0,0,,ПОНИМАЮТ ЧУВСТВИТЕЛЬНОСТЬ ДОНБАССА И В КУРСЕ,
Dialogue: 0,0:01:44.89,0:01:47.29,Caption,,0,0,0,,ЧТО ЗЕЛЕНСКИЙ НЕ СОБИРАЕТСЯ СТАВИТЬ ПОДПИСЬ ПОД
Dialogue: 0,0:01:47.29,0:01:49.69,Caption,,0,0,0,,ПРИЗНАНИЕМ РОССИЙСКИХ ТЕРРИТОРИАЛЬНЫХ ПРИОБРЕТЕНИЙ.
Dialogue: 0,0:01:50.25,0:01:52.73,Caption,,0,0,0,,ЭТО НЕ ПЕРВОЕ ЗНАКОМСТВО ДВУХ ДЕЛЕГАЦИЙ В КОРИДОРЕ
Dialogue: 0,0:01:52.73,0:01:57.13,Caption,,0,0,0,,ГОСТИНИЦЫ. ДОПУСТИМ, ОНИ ВСЁ ЖЕ ЖДАЛИ СОГЛАСИЯ. ТОГДА ПОЯВЛЯЕТСЯ
Dialogue: 0,0:01:57.13,0:02:01.69,Caption,,0,0,0,,СЛЕДУЮЩИЙ ВОПРОС, ЕЩЁ НЕУДОБНЕЕ ПРЕЖНЕГО. КТО УСПЕЛ ПОЛУЧИТЬ СОГЛАСИЕ
Dialogue: 0,0:02:01.77,0:02:05.69,Caption,,0,0,0,,МОСКВЫ? РОССИЯ ГОДАМИ ТРЕБУЕТ ВНЕБЛОКОВОГО ПОЛОЖЕНИЯ УКРАИНЫ
Dialogue: 0,0:02:05.77,0:02:08.33,Caption,,0,0,0,,И СОКРАЩЕНИЯ ВОЕННОЙ АКТИВНОСТИ НАТО ВОЗЛЕ СВОИХ
Dialogue: 0,0:02:08.33,0:02:11.29,Caption,,0,0,0,,ГРАНИЦ. А ЗДЕСЬ КИЕВУ ОБЕЩАЮТ РОВНО ТО,
Dialogue: 0,0:02:11.52,0:02:14.89,Caption,,0,0,0,,ПРОТИВ ЧЕГО МОСКВА ВЫСТУПАЕТ НАИБОЛЕЕ ЖЁСТКО. СДЕЛКА
Dialogue: 0,0:02:14.97,0:02:17.61,Caption,,0,0,0,,ПОЛУЧАЕТСЯ ИЗУМИТЕЛЬНАЯ. ПОКУПАТЕЛЮ УЖЕ ВЫДАЛИ
Dialogue: 0,0:02:17.61,0:02:21.05,Caption,,0,0,0,,КЛЮЧИ, ХОТЯ ХОЗЯИНА КВАРТИРЫ ДАЖЕ НЕ ПОЗВАЛИ. ПОЭТОМУ
Dialogue: 0,0:02:21.05,0:02:24.25,Caption,,0,0,0,,ВЕРСИЯ С ЗАРАНЕЕ ОЖИДАЕМЫМ ОТКАЗОМ ВЫГЛЯДИТ ВПОЛНЕ
Dialogue: 0,0:02:24.33,0:02:29.40,Caption,,0,0,0,,СТРОЙНО. ВАШИНГТОН ПРЕДЛАГАЕТ ЗЕЛЕНСКОМУ МАКСИМАЛЬНО
Dialogue: 0,0:02:29.40,0:02:33.72,Caption,,0,0,0,,ПРИВЛЕКАТЕЛЬНУЮ КОМБИНАЦИЮ, ПОЛУЧАЕТ В ОТВЕТ ДЛИННЫЙ ПЕРЕЧЕНЬ ДОПОЛНИТЕЛЬНЫХ
Dialogue: 0,0:02:33.80,0:02:36.44,Caption,,0,0,0,,УСЛОВИЙ И ВОЗВРАЩАЕТСЯ К ТРАМПУ С ГОТОВЫМ
Dialogue: 0,0:02:36.44,0:02:40.28,Caption,,0,0,0,,РЕЗУЛЬТАТОМ. МОЛ, ДАЖЕ ЧЛЕНСТВО В НАТО ПОЛОЖИЛИ ПЕРЕД КИЕВОМ,
Dialogue: 0,0:02:40.41,0:02:43.08,Caption,,0,0,0,,НО ЭТОГО ОКАЗАЛОСЬ МАЛО. ПОСЛЕ ТАКОГО ЗЕЛЕНСКОМУ
Dialogue: 0,0:02:43.16,0:02:47.56,Caption,,0,0,0,,ТРУДНЕЕ ДОКАЗЫВАТЬ, ЧТО СОЕДИНЁННЫЕ ШТАТЫ ПЛОХО СТАРАЛИСЬ. АМЕРИКАНСКАЯ
Dialogue: 0,0:02:47.64,0:02:50.28,Caption,,0,0,0,,СТОРОНА МОЖЕТ ОТВЕТИТЬ БЕЗ ДОЛГОЙ ЛЕКЦИИ СТАРАЛИСЬ,
Dialogue: 0,0:02:50.40,0:02:53.00,Caption,,0,0,0,,ПРЕДЛАГАЛИ, УСЛЫШАЛИ. НЕЛЬЗЯ УТВЕРЖДАТЬ,
Dialogue: 0,0:02:53.23,0:02:56.04,Caption,,0,0,0,,ЧТО В ВАШИНГТОНЕ ДЕЙСТВИТЕЛЬНО РАЗЫГРЫВАЛИ ИМЕННО
Dialogue: 0,0:02:56.04,0:02:59.56,Caption,,0,0,0,,ЭТУ ПАРТИЮ. НО РАСЧЁТ ПОНЯТЕН. ИНОГДА РЕЗУЛЬТАТОМ
Dialogue: 0,0:02:59.56,0:03:01.48,Caption,,0,0,0,,ПЕРЕГОВОРОВ СТАНОВИТСЯ НЕ ДОГОВОР,
Dialogue: 0,0:03:01.72,0:03:04.12,Caption,,0,0,0,,А ПРАВИЛЬНО ОФОРМЛЕННОЕ ЧУЖОЕ НЕСОГЛАСИЕ.
Dialogue: 0,0:03:04.73,0:03:07.48,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ТОЖЕ НЕ БРОСИЛСЯ ОТВЕЧАТЬ В ЛОБ. ДВЕРЬЮ
Dialogue: 0,0:03:07.56,0:03:10.28,Caption,,0,0,0,,ОН НЕ ХЛОПНУЛ И ОБСУЖДЕНИЕ НЕ ОТВЕРГ. ОН
Dialogue: 0,0:03:10.28,0:03:14.68,Caption,,0,0,0,,ДОПУСТИЛ РЕФЕРЕНДУМ, НО ОКРУЖИЛ ВОЗМОЖНОЕ СОГЛАСИЕ ТАКИМ КОЛИЧЕСТВОМ
Dialogue: 0,0:03:14.68,0:03:18.76,Caption,,0,0,0,,ПРЕДВАРИТЕЛЬНЫХ ТРЕБОВАНИЙ, ЧТО ЧЕРЕЗ ЭТОТ ПРОХОД БЕЗ ГРУЗОВОГО СОСТАВА НЕ
Dialogue: 0,0:03:18.76,0:03:22.28,Caption,,0,0,0,,ПРОТИСНУТЬСЯ. ПОЛУЧИЛАСЬ УДОБНАЯ КОНСТРУКЦИЯ. КИЕВ
Dialogue: 0,0:03:22.28,0:03:27.00,Caption,,0,0,0,,ГОТОВ СОГЛАСИТЬСЯ ПОСЛЕ ТОГО, КАК ПАРТНЁРЫ ЗАРАНЕЕ ВЫПОЛНЯТ ПОЧТИ ВСЮ УКРАИНСКУЮ
Dialogue: 0,0:03:27.00,0:03:30.36,Caption,,0,0,0,,ПРОГРАММУ. ЗАОДНО МОЖНО СОХРАНИТЬ ОТКРЫТОЙ ДВЕРЬ И
Dialogue: 0,0:03:30.44,0:03:33.00,Caption,,0,0,0,,НЕ ЗАХОДИТЬ ВНУТРЬ. ЕСЛИ ВАМ НРАВЯТСЯ РАЗБОРЫ,
Dialogue: 0,0:03:33.32,0:03:35.48,Caption,,0,0,0,,В КОТОРЫХ ЗАЯВЛЕНИЕ РАССМАТРИВАЮТ ВМЕСТЕ С
Dialogue: 0,0:03:35.48,0:03:37.80,Caption,,0,0,0,,ИНТЕРЕСАМИ ЕГО АВТОРОВ, ПОДПИСЫВАЙТЕСЬ.
Dialogue: 0,0:03:40.07,0:03:42.87,Caption,,0,0,0,,ДАЛЬШЕ СОЮЗНИКИ НАЧИНАЮТ СПОРИТЬ УЖЕ НЕ С КИЕВОМ,
Dialogue: 0,0:03:43.24,0:03:45.99,Caption,,0,0,0,,А С САМОЙ ВОЗМОЖНОСТЬЮ БОЛЬШОГО РАЗГОВОРА С МОСКВОЙ.
Dialogue: 0,0:03:46.61,0:03:50.95,Caption,,0,0,0,,КАЯ КАЛЛАС ПРЕДУПРЕЖДАЕТ, ЧТО ОБСУЖДЕНИЕ РОССИЙСКИХ ТРЕБОВАНИЙ К БУДУЩЕМУ
Dialogue: 0,0:03:50.95,0:03:53.83,Caption,,0,0,0,,УСТРОЙСТВУ ЕВРОПЕЙСКОЙ БЕЗОПАСНОСТИ СПОСОБНО
Dialogue: 0,0:03:53.83,0:03:56.71,Caption,,0,0,0,,ОТОДВИНУТЬ ПРЕКРАЩЕНИЕ БОЕВЫХ ДЕЙСТВИЙ. ПО ЕЁ
Dialogue: 0,0:03:56.71,0:03:59.35,Caption,,0,0,0,,ЛОГИКЕ, СНАЧАЛА НУЖНО ОСТАНОВИТЬ ОГОНЬ,
Dialogue: 0,0:03:59.59,0:04:02.71,Caption,,0,0,0,,А ЗАТЕМ ПЕРЕХОДИТЬ К БОЛЕЕ ШИРОКИМ ВОПРОСАМ. МОСКВА
Dialogue: 0,0:04:02.79,0:04:05.43,Caption,,0,0,0,,ПРЕДЛАГАЕТ ОБРАТНЫЙ МАСШТАБ. ОНА ХОЧЕТ ГОВОРИТЬ НЕ
Dialogue: 0,0:04:05.51,0:04:08.55,Caption,,0,0,0,,ТОЛЬКО О ЛИНИИ ФРОНТА, НО И О ПРИЧИНАХ КОНФЛИКТА,
Dialogue: 0,0:04:08.71,0:04:11.43,Caption,,0,0,0,,ПОЛОЖЕНИИ УКРАИНЫ И ВОЕННОЙ СИСТЕМЕ ВОКРУГ
Dialogue: 0,0:04:11.51,0:04:14.63,Caption,,0,0,0,,РОССИЙСКИХ ГРАНИЦ. НА ЭТОМ МЕСТЕ ЕВРОПЕЙСКОЕ
Dialogue: 0,0:04:14.71,0:04:17.59,Caption,,0,0,0,,ЕДИНСТВО НАЧИНАЕТ НАПОМИНАТЬ ОБЩИЙ СЕМЕЙНЫЙ БЮДЖЕТ.
Dialogue: 0,0:04:17.99,0:04:21.91,Caption,,0,0,0,,ВСЕ ЗА ЭКОНОМИЮ, НО КАЖДЫЙ ПРЕДЛАГАЕТ СОКРАТИТЬ РАСХОДЫ ДРУГОГО.
Dialogue: 0,0:04:22.68,0:04:25.91,Caption,,0,0,0,,МИНИСТР ОБОРОНЫ ФИНЛЯНДИИ АНТТИ ХЯККЯНЕН НАЗВАЛ
Dialogue: 0,0:04:25.99,0:04:28.15,Caption,,0,0,0,,РОССИЙСКИЕ ТРЕБОВАНИЯ К НАТО СОВЕРШЕННО
Dialogue: 0,0:04:28.15,0:04:30.55,Caption,,0,0,0,,ВОЗМУТИТЕЛЬНЫМИ. В ОПУБЛИКОВАННОМ ВАРИАНТЕ
Dialogue: 0,0:04:30.55,0:04:32.71,Caption,,0,0,0,,ЗАТРАГИВАЮТСЯ ПРИСУТСТВИЕ АЛЬЯНСА,
Dialogue: 0,0:04:32.95,0:04:35.99,Caption,,0,0,0,,УКРАИНСКИЙ СТАТУС И ПОЛОЖЕНИЕ САМОЙ ФИНЛЯНДИИ.
Dialogue: 0,0:04:36.35,0:04:40.63,Caption,,0,0,0,,ХЕЛЬСИНКИ СЧИТАЕТ, ЧТО ПОДОБНЫЕ УСЛОВИЯ НЕ ЗАСЛУЖИВАЮТ ДАЖЕ ОБСУЖДЕНИЯ.
Dialogue: 0,0:04:41.16,0:04:44.55,Caption,,0,0,0,,КАНАДА ЗАНИМАЕТ ПОЧТИ ТАКУЮ ЖЕ ПОЗИЦИЮ. МАРК КАРНИ
Dialogue: 0,0:04:44.55,0:04:48.23,Caption,,0,0,0,,ЗАЯВИЛ, ЧТО СТРАНА НЕ СТАНЕТ ПЕРЕСМАТРИВАТЬ УЧАСТИЕ В НАТО
Dialogue: 0,0:04:48.31,0:04:49.99,Caption,,0,0,0,,И ОБЯЗАТЕЛЬСТВА ПЕРЕД СОЮЗНИКАМИ.
Dialogue: 0,0:04:52.27,0:04:54.91,Caption,,0,0,0,,КАНАДСКИЙ КОНТИНГЕНТ В ЛАТВИИ ОСТАНЕТСЯ НА МЕСТЕ,
Dialogue: 0,0:04:55.07,0:04:57.79,Caption,,0,0,0,,СВОРАЧИВАТЬ ЕГО РАДИ ДОГОВОРЁННОСТИ С РОССИЕЙ ОТТАВА
Dialogue: 0,0:04:57.79,0:05:02.19,Caption,,0,0,0,,НЕ СОБИРАЕТСЯ. КАРТИНА ВЫХОДИТ ЗАНИМАТЕЛЬНАЯ. ЗЕЛЕНСКОМУ ПРЕДЛАГАЮТ
Dialogue: 0,0:05:02.19,0:05:04.43,Caption,,0,0,0,,ЧЛЕНСТВО В АЛЬЯНСЕ В ОБМЕН НА ДОНБАСС,
Dialogue: 0,0:05:04.67,0:05:07.23,Caption,,0,0,0,,А ДЕЙСТВУЮЩИЕ СОЮЗНИКИ ОДНОВРЕМЕННО ЗАЯВЛЯЮТ,
Dialogue: 0,0:05:07.40,0:05:10.35,Caption,,0,0,0,,ЧТО ИХ ВОЕННОЕ ПРИСУТСТВИЕ РЯДОМ С РОССИЕЙ ОБСУЖДАТЬ
Dialogue: 0,0:05:10.35,0:05:13.07,Caption,,0,0,0,,НЕЛЬЗЯ. ДЛЯ БОЛЬШОГО СОГЛАШЕНИЯ УЖЕ ПОЧТИ ВСЁ
Dialogue: 0,0:05:13.07,0:05:18.11,Caption,,0,0,0,,ГОТОВО. ЕСТЬ СТОЛ, УЧАСТНИКИ И МНОЖЕСТВО УСЛОВИЙ. НЕ ХВАТАЕТ СУЩЕЙ
Dialogue: 0,0:05:18.11,0:05:21.95,Caption,,0,0,0,,МЕЛОЧИ ХОТЯ БЫ ОДНОЙ ФОРМУЛЫ, КОТОРУЮ ГОТОВЫ ПРИНЯТЬ ОБЕ СТОРОНЫ.
Dialogue: 0,0:05:22.51,0:05:25.23,Caption,,0,0,0,,ДАЖЕ ВНЕЗАПНОЕ СОГЛАСИЕ КИЕВА НИЧЕГО АВТОМАТИЧЕСКИ
Dialogue: 0,0:05:25.31,0:05:28.59,Caption,,0,0,0,,НЕ РЕШИТ. ПОСЛЕ НЕГО ПРИДЁТСЯ ОБРАЩАТЬСЯ К ФИНЛЯНДИИ,
Dialogue: 0,0:05:28.74,0:05:33.95,Caption,,0,0,0,,КАНАДЕ, ПОЛЬШЕ, ГЕРМАНИИ И СТРАНАМ БАЛТИИ. ЧТО КАЖДАЯ ИЗ НИХ
Dialogue: 0,0:05:33.95,0:05:36.03,Caption,,0,0,0,,ГОТОВА ИЗМЕНИТЬ РАДИ ОБЩЕГО РЕЗУЛЬТАТА?
Dialogue: 0,0:05:36.49,0:05:39.23,Caption,,0,0,0,,ПОКА ОТВЕТ У ВСЕХ КОРОТКИЙ. МЕНЯТЬ ОНИ НЕ
Dialogue: 0,0:05:39.31,0:05:42.11,Caption,,0,0,0,,НАМЕРЕНЫ НИЧЕГО. ТОГДА ПЕРЕГОВОРЫ ПРЕВРАЩАЮТСЯ В
Dialogue: 0,0:05:42.11,0:05:44.83,Caption,,0,0,0,,ОСМОТР ВИТРИНЫ. ТОВАРЫ КРАСИВО РАССТАВЛЕНЫ,
Dialogue: 0,0:05:45.06,0:05:47.31,Caption,,0,0,0,,НО ПРОДАВАТЬ ИХ НИКТО НЕ СОБИРАЕТСЯ. ПРИ ЭТОМ
Dialogue: 0,0:05:47.39,0:05:52.11,Caption,,0,0,0,,МИР КАЖДОМУ ТРЕБУЕТСЯ СРОЧНО, ЖЕЛАТЕЛЬНО ЗА ЧУЖОЙ СЧЁТ И БЕЗ ПЕРЕМЕН В
Dialogue: 0,0:05:52.11,0:05:56.83,Caption,,0,0,0,,СОБСТВЕННОМ ПОЛОЖЕНИИ. НА ТАКОМ ФОНЕ ИЗ ВЕЛИКОБРИТАНИИ ПОСТУПИЛ ОСОБЕННО
Dialogue: 0,0:05:56.83,0:06:00.27,Caption,,0,0,0,,БОДРЫЙ СОВЕТ. РИШИ СУНАК ПРИЗВАЛ ЛОНДОН БЫТЬ ГОТОВЫМ
Dialogue: 0,0:06:00.27,0:06:03.07,Caption,,0,0,0,,НАНЕСТИ УДАРЫ ПО РОССИЙСКИМ БАЗАМ НА КОЛЬСКОМ
Dialogue: 0,0:06:03.07,0:06:09.19,Caption,,0,0,0,,ПОЛУОСТРОВЕ. ТАМ РАЗМЕЩЕНЫ СЕВЕРНЫЙ ФЛОТ И СУЩЕСТВЕННАЯ ЧАСТЬ
Dialogue: 0,0:06:09.27,0:06:12.31,Caption,,0,0,0,,РОССИЙСКИХ ЯДЕРНЫХ СИЛ. ПО МЫСЛИ БЫВШЕГО ПРЕМЬЕРА,
Dialogue: 0,0:06:12.63,0:06:15.67,Caption,,0,0,0,,ЗАПАДУ СЛЕДУЕТ ПОКАЗАТЬ СПОСОБНОСТЬ ПРИЧИНИТЬ УЩЕРБ
Dialogue: 0,0:06:15.67,0:06:17.67,Caption,,0,0,0,,СТРАТЕГИЧЕСКОЙ ИНФРАСТРУКТУРЕ РОССИИ.
Dialogue: 0,0:06:18.26,0:06:21.67,Caption,,0,0,0,,РИШИ, ПРЕДЛОЖЕНИЕ ЗВУЧИТ ГРОЗНО. ТОЛЬКО ДОЛЖНОСТЬ У ТЕБЯ
Dialogue: 0,0:06:21.67,0:06:24.39,Caption,,0,0,0,,УЖЕ ДРУГАЯ. КОГДА СУНАК ВОЗГЛАВЛЯЛ БРИТАНСКОЕ
Dialogue: 0,0:06:24.39,0:06:27.59,Caption,,0,0,0,,ПРАВИТЕЛЬСТВО, В ЕГО РАСПОРЯЖЕНИИ НАХОДИЛИСЬ МИНИСТРЫ,
Dialogue: 0,0:06:27.73,0:06:32.15,Caption,,0,0,0,,РАЗВЕДКА, ВОЕННОЕ КОМАНДОВАНИЕ И ДОСТУП К НАСТОЯЩИМ ПЛАНАМ,
Dialogue: 0,0:06:32.31,0:06:33.99,Caption,,0,0,0,,А НЕ К МИКРОФОНУ ПОСЛЕ ОТСТАВКИ.
Dialogue: 0,0:06:34.58,0:06:37.03,Caption,,0,0,0,,ПОЧЕМУ ТОГДА КОЛЬСКИЙ ПОЛУОСТРОВ НЕ ОКАЗАЛСЯ В
Dialogue: 0,0:06:37.03,0:06:41.03,Caption,,0,0,0,,СПИСКЕ СРОЧНЫХ ДЕЛ? МОЖНО БЫЛО СОБРАТЬ КАБИНЕТ И ОБЪЯВИТЬ ПОДГОТОВКУ.
Dialogue: 0,0:06:41.27,0:06:45.43,Caption,,0,0,0,,ВОЗМОЖНОСТИ БЫЛИ, ПОЛНОМОЧИЯ ТОЖЕ. НО ПРИ ЖИЗНИ НА ДАУНИНГ СТРИТ
Dialogue: 0,0:06:45.43,0:06:47.83,Caption,,0,0,0,,ВОИНСТВЕННЫЙ ПОРЫВ ПОЧЕМУ ТО НЕ ДОБРАЛСЯ ДО ЭТОЙ
Dialogue: 0,0:06:47.91,0:06:50.55,Caption,,0,0,0,,СТАДИИ. ТЕПЕРЬ РЕШИТЕЛЬНОСТЬ ОБХОДИТСЯ ДЕШЕВЛЕ.
Dialogue: 0,0:06:51.01,0:06:53.11,Caption,,0,0,0,,СУНАК ПРЕДЛАГАЕТ ДЕЙСТВУЮЩЕМУ ПРАВИТЕЛЬСТВУ
Dialogue: 0,0:06:53.11,0:06:56.47,Caption,,0,0,0,,ВЕЛИКОБРИТАНИИ УДАРИТЬ ПО БАЗАМ СЕВЕРНОГО ФЛОТА И
Dialogue: 0,0:06:56.47,0:06:59.19,Caption,,0,0,0,,ПРИНЯТЬ РИСК ОТВЕТНОГО РАКЕТНОГО УДАРА ПО БРИТАНСКОЙ
Dialogue: 0,0:06:59.19,0:07:03.35,Caption,,0,0,0,,ВОЕННОЙ ИНФРАСТРУКТУРЕ; ЦЕНУ ЭСКАЛАЦИИ ЗАПЛАТЯТ НЫНЕШНЕЕ ПРАВИТЕЛЬСТВО И
Dialogue: 0,0:07:03.35,0:07:07.11,Caption,,0,0,0,,СТРАНА. САМ ОН, РАСПОЛАГАЯ ПРЕМЬЕРСКИМИ ПОЛНОМОЧИЯМИ,
Dialogue: 0,0:07:07.33,0:07:10.63,Caption,,0,0,0,,ТАКОГО ПРИКАЗА НЕ ОТДАЛ. ПОСЛЕ ОТСТАВКИ ЕМУ ОСТАЁТСЯ
Dialogue: 0,0:07:10.63,0:07:13.83,Caption,,0,0,0,,ЛИШЬ СТОЯТЬ РЯДОМ С СОБСТВЕННЫМ СОВЕТОМ И ВЫГЛЯДЕТЬ
Dialogue: 0,0:07:13.91,0:07:16.95,Caption,,0,0,0,,СУРОВО. ВООБЩЕ БЫВШИЕ ЧИНОВНИКИ В ЭТОТ РАЗ НАСТУПАЮТ
Dialogue: 0,0:07:17.03,0:07:20.35,Caption,,0,0,0,,ДРУЖНО. ПРАВДА,
Dialogue: 0,0:07:20.43,0:07:22.67,Caption,,0,0,0,,ПОКА ПРЕИМУЩЕСТВЕННО НА СТРАНИЦЫ ГАЗЕТ.
Dialogue: 0,0:07:23.22,0:07:26.03,Caption,,0,0,0,,СУНАК УЖЕ НЕ ПРЕМЬЕР. ДМИТРИЙ КУЛЕБА УЖЕ НЕ
Dialogue: 0,0:07:26.03,0:07:28.75,Caption,,0,0,0,,РУКОВОДИТ УКРАИНСКИМ ВНЕШНЕПОЛИТИЧЕСКИМ ВЕДОМСТВОМ.
Dialogue: 0,0:07:29.13,0:07:31.55,Caption,,0,0,0,,ЗАТО У ОБОИХ ПОЯВИЛИСЬ СОВЕТЫ ДЛЯ ТЕХ,
Dialogue: 0,0:07:31.87,0:07:34.99,Caption,,0,0,0,,КТО ОТВЕЧАЕТ ЗА РЕЗУЛЬТАТ СЕГОДНЯ. КУЛЕБА СЧИТАЕТ,
Dialogue: 0,0:07:35.30,0:07:38.27,Caption,,0,0,0,,ЧТО ЕДИНСТВЕННАЯ СТРАТЕГИЯ УКРАИНЫ СЕЙЧАС СОСТОИТ В
Dialogue: 0,0:07:38.35,0:07:41.23,Caption,,0,0,0,,СПОСОБНОСТИ ДЕРЖАТЬСЯ МАКСИМАЛЬНО ДОЛГО. ЗВУЧИТ
Dialogue: 0,0:07:41.23,0:07:44.19,Caption,,0,0,0,,МУЖЕСТВЕННО. НО СТРАТЕГИЯ ОБЯЗАНА ОТВЕЧАТЬ НЕ ТОЛЬКО
Dialogue: 0,0:07:44.19,0:07:47.71,Caption,,0,0,0,,НА ВОПРОС "СКОЛЬКО", НО И НА ВОПРОС "ЗАЧЕМ". ПРЕДПОЛОЖИМ,
Dialogue: 0,0:07:47.95,0:07:51.15,Caption,,0,0,0,,УКРАИНА ВЫДЕРЖИВАЕТ ЕЩЁ ГОД. ЗАТЕМ ВТОРОЙ. ПОТОМ
Dialogue: 0,0:07:51.15,0:07:53.87,Caption,,0,0,0,,ТРЕТИЙ. КАКОЕ СОБЫТИЕ ДОЛЖНО ОЗНАЧАТЬ,
Dialogue: 0,0:07:54.19,0:07:57.63,Caption,,0,0,0,,ЧТО РАСЧЁТ СРАБОТАЛ? РОССИЯ ОТКАЖЕТСЯ ОТ СВОИХ ТРЕБОВАНИЙ?
Dialogue: 0,0:07:57.86,0:08:00.27,Caption,,0,0,0,,ЕЁ ЭКОНОМИКА ПЕРЕСТАНЕТ ВЫДЕРЖИВАТЬ НАГРУЗКУ?
Dialogue: 0,0:08:00.58,0:08:04.59,Caption,,0,0,0,,ПУТИН ИЗМЕНИТ РЕШЕНИЕ? ЗАПАД ПЕРЕДАСТ ТАКОЙ ОБЪЁМ ВООРУЖЕНИЙ,
Dialogue: 0,0:08:04.75,0:08:06.51,Caption,,0,0,0,,ЧТО ПОЛОЖЕНИЕ НА ФРОНТЕ ПЕРЕВЕРНЁТСЯ?
Dialogue: 0,0:08:06.91,0:08:08.83,Caption,,0,0,0,,ВНУТРИ РОССИИ ПРОИЗОЙДУТ ПЕРЕМЕНЫ?
Dialogue: 0,0:08:09.54,0:08:12.11,Caption,,0,0,0,,БЕЗ КОНЕЧНОЙ ТОЧКИ СЛОВО "ДЕРЖАТЬСЯ" ОПИСЫВАЕТ
Dialogue: 0,0:08:12.11,0:08:16.11,Caption,,0,0,0,,СОСТОЯНИЕ, А НЕ ПУТЬ К РЕЗУЛЬТАТУ. КУЛЕБА СВЯЗЫВАЕТ НАДЕЖДУ
Dialogue: 0,0:08:16.19,0:08:20.99,Caption,,0,0,0,,С ИЗМЕНЕНИЕМ ОБСТОЯТЕЛЬСТВ, СПОСОБНЫХ ПОВЛИЯТЬ НА РЕШЕНИЯ ПУТИНА. ОДНАКО САМИ
Dialogue: 0,0:08:20.99,0:08:23.71,Caption,,0,0,0,,ОБСТОЯТЕЛЬСТВА ОСТАЮТСЯ ЗА КАДРОМ. НЕ НАЗВАНЫ НИ
Dialogue: 0,0:08:23.71,0:08:28.51,Caption,,0,0,0,,МЕХАНИЗМ, НИ СРОК, НИ ПРИЗНАК ПРИБЛИЖЕНИЯ НУЖНОГО МОМЕНТА. ПОЛУЧАЕТСЯ
Dialogue: 0,0:08:28.51,0:08:31.31,Caption,,0,0,0,,ОЖИДАНИЕ С ОЧЕНЬ ВЫСОКОЙ ЕЖЕМЕСЯЧНОЙ ПЛАТОЙ.
Dialogue: 0,0:08:33.50,0:08:38.14,Caption,,0,0,0,,УКРАИНА ПРОДОЛЖАЕТ ВОЙНУ, А ПОДХОДЯЩЕЕ СОБЫТИЕ ДОЛЖНО ОДНАЖДЫ ВОЙТИ БЕЗ СТУКА
Dialogue: 0,0:08:38.14,0:08:40.86,Caption,,0,0,0,,И ВСЁ ИЗМЕНИТЬ. У СУНАКА ХОТЯ БЫ ОБОЗНАЧЕНО
Dialogue: 0,0:08:40.86,0:08:43.42,Caption,,0,0,0,,ДЕЙСТВИЕ. ОНО СПОСОБНО ПРИВЕСТИ К КАТАСТРОФЕ,
Dialogue: 0,0:08:43.70,0:08:45.98,Caption,,0,0,0,,НО ПОНЯТЬ ЕГО МОЖНО УДАРИТЬ ПО РОССИЙСКОЙ
Dialogue: 0,0:08:45.98,0:08:48.78,Caption,,0,0,0,,СТРАТЕГИЧЕСКОЙ ИНФРАСТРУКТУРЕ И ПРОДЕМОНСТРИРОВАТЬ
Dialogue: 0,0:08:48.78,0:08:51.50,Caption,,0,0,0,,УГРОЗУ. У ФОРМУЛЫ КУЛЕБЫ ПОНЯТНА ТОЛЬКО
Dialogue: 0,0:08:51.50,0:08:54.38,Caption,,0,0,0,,ПРОДОЛЖИТЕЛЬНОСТЬ. ФИНАЛ СПРЯТАН ТАК НАДЁЖНО,
Dialogue: 0,0:08:54.70,0:08:57.26,Caption,,0,0,0,,БУДТО ЗА ЕГО ОБНАРУЖЕНИЕ ТОЖЕ ОТВЕЧАЕТ КТО ТО
Dialogue: 0,0:08:57.26,0:09:00.30,Caption,,0,0,0,,ИЗ СОЮЗНИКОВ. И ТУТ МАРЬЯНА БЕЗУГЛАЯ ОКАЗЫВАЕТСЯ
Dialogue: 0,0:09:00.30,0:09:04.70,Caption,,0,0,0,,ПРАКТИЧНЕЕ БЫВШЕГО МИНИСТРА. ЕСЛИ СТРАНА ДОЛЖНА ДЕРЖАТЬСЯ ДОЛГО,
Dialogue: 0,0:09:05.07,0:09:09.10,Caption,,0,0,0,,КТО ТО ОБЯЗАН ПОСЧИТАТЬ, ЗА СЧЁТ ЧЕГО ОНА БУДЕТ ЭТО ДЕЛАТЬ. НУЖНЫ
Dialogue: 0,0:09:09.10,0:09:13.50,Caption,,0,0,0,,ВООРУЖЕНИЕ, БОЕПРИПАСЫ И ДЕНЬГИ. НО ДАЖЕ ОГРОМНЫЙ БАНКОВСКИЙ
Dialogue: 0,0:09:13.50,0:09:17.02,Caption,,0,0,0,,ПЕРЕВОД НЕ ЗАНИМАЕТ ПОЗИЦИЮ И НЕ ЗАМЕНЯЕТ ЛИЧНЫЙ
Dialogue: 0,0:09:17.10,0:09:20.54,Caption,,0,0,0,,СОСТАВ. ГЛАВНЫМ ОГРАНИЧЕНИЕМ СТАНОВЯТСЯ ЛЮДИ. ЗДЕСЬ
Dialogue: 0,0:09:20.54,0:09:22.62,Caption,,0,0,0,,УЖЕ НЕТ ОЖИДАНИЯ СЛУЧАЙНОГО ПОДАРКА ОТ
Dialogue: 0,0:09:22.62,0:09:25.58,Caption,,0,0,0,,ОБСТОЯТЕЛЬСТВ. КУЛЕБА ПРЕДЛАГАЕТ ВЫИГРАТЬ ВРЕМЯ,
Dialogue: 0,0:09:25.90,0:09:28.62,Caption,,0,0,0,,А БЕЗУГЛАЯ СРАЗУ ОТКРЫВАЕТ СЧЁТ И ПОКАЗЫВАЕТ,
Dialogue: 0,0:09:28.82,0:09:30.78,Caption,,0,0,0,,КЕМ ЗА ЭТО ВРЕМЯ ПРИДЁТСЯ ПЛАТИТЬ.
Dialogue: 0,0:09:31.34,0:09:33.98,Caption,,0,0,0,,МУЖСКОЙ МОБИЛИЗАЦИОННЫЙ РЕСУРС НЕ БЕСКОНЕЧЕН.
Dialogue: 0,0:09:34.54,0:09:37.10,Caption,,0,0,0,,ЕСЛИ БОЕВЫЕ ДЕЙСТВИЯ ДОЛЖНЫ ПРОДОЛЖАТЬСЯ ГОДАМИ,
Dialogue: 0,0:09:37.42,0:09:39.90,Caption,,0,0,0,,ВЛАСТИ НЕИЗБЕЖНО ДОБИРАЮТСЯ ДО КАТЕГОРИЙ,
Dialogue: 0,0:09:40.00,0:09:42.94,Caption,,0,0,0,,КОТОРЫЕ РАНЬШЕ СТАРАЛИСЬ НЕ ЗАТРАГИВАТЬ. СНАЧАЛА
Dialogue: 0,0:09:43.02,0:09:45.50,Caption,,0,0,0,,РЕЧЬ ИДЁТ О ЖЕНЩИНАХ С НУЖНЫМИ СПЕЦИАЛЬНОСТЯМИ.
Dialogue: 0,0:09:45.82,0:09:47.74,Caption,,0,0,0,,ЗАТЕМ О ГРАЖДАНСКИХ РАБОТНИКАХ,
Dialogue: 0,0:09:47.90,0:09:52.57,Caption,,0,0,0,,ЗАЩИЩЁННЫХ БРОНЬЮ. ПОТОМ О ШКОЛЬНИКАХ,
Dialogue: 0,0:09:52.81,0:09:55.13,Caption,,0,0,0,,КОТОРЫХ ПРЕДЛАГАЮТ ЗАРАНЕЕ ГОТОВИТЬ К БУДУЩЕЙ
Dialogue: 0,0:09:55.13,0:09:58.09,Caption,,0,0,0,,СЛУЖБЕ. ДОПОЛНИТЕЛЬНЫЕ ПОДРАЗДЕЛЕНИЯ НЕ ПОЯВЛЯЮТСЯ
Dialogue: 0,0:09:58.09,0:10:01.21,Caption,,0,0,0,,ПО ПРОСЬБЕ ВЕДУЩЕГО. ЗА КАЖДЫМ НОВЫМ МЕСЯЦЕМ СТОЯТ
Dialogue: 0,0:10:01.21,0:10:04.33,Caption,,0,0,0,,КОНКРЕТНЫЕ ЛЮДИ, КОТОРЫХ НУЖНО ПОСТАВИТЬ НА УЧЁТ,
Dialogue: 0,0:10:04.49,0:10:07.61,Caption,,0,0,0,,ОБУЧИТЬ, ВООРУЖИТЬ И ОТПРАВИТЬ ВЫПОЛНЯТЬ ЗАДАЧУ.
Dialogue: 0,0:10:08.17,0:10:10.73,Caption,,0,0,0,,БЕЗУГЛАЯ ПРОСТО ДОВОДИТ ИДЕЮ КУЛЕБЫ ДО ЕЁ
Dialogue: 0,0:10:10.73,0:10:13.45,Caption,,0,0,0,,МАТЕРИАЛЬНОГО СОДЕРЖАНИЯ. ЕСЛИ ВРЕМЯ ОБЪЯВЛЕНО
Dialogue: 0,0:10:13.45,0:10:17.77,Caption,,0,0,0,,ГЛАВНЫМ РЕСУРСОМ, КТО ТО ДОЛЖЕН ОБЕСПЕЧИТЬ ЕГО ЛЮДЬМИ. ЧЕМ ДОЛЬШЕ
Dialogue: 0,0:10:17.85,0:10:20.25,Caption,,0,0,0,,СТРАНА ДЕРЖИТСЯ БЕЗ ЯСНОЙ КОНЕЧНОЙ ТОЧКИ,
Dialogue: 0,0:10:20.54,0:10:23.85,Caption,,0,0,0,,ТЕМ ГЛУБЖЕ ПРИХОДИТСЯ ЗАЧЕРПЫВАТЬ ИЗ ОБЩЕСТВА. ЦЕНА
Dialogue: 0,0:10:23.85,0:10:26.49,Caption,,0,0,0,,ЭТОЙ СТРАТЕГИИ РАСТЁТ НЕ В ТЕОРИИ. ОНА ПРИХОДИТ
Dialogue: 0,0:10:26.49,0:10:30.33,Caption,,0,0,0,,ПОВЕСТКОЙ, СОКРАЩЁННОЙ БРОНЬЮ И НОВЫМИ ТРЕБОВАНИЯМИ К ТЕМ,
Dialogue: 0,0:10:30.72,0:10:33.21,Caption,,0,0,0,,КОГО ВЧЕРА ЕЩЁ НЕ СЧИТАЛИ ЧАСТЬЮ МОБИЛИЗАЦИОННОГО
Dialogue: 0,0:10:33.21,0:10:36.41,Caption,,0,0,0,,ЗАПАСА. ВСЯ КОНСТРУКЦИЯ ТЕПЕРЬ ВИДНА ЦЕЛИКОМ.
Dialogue: 0,0:10:36.69,0:10:39.37,Caption,,0,0,0,,СОЕДИНЁННЫЕ ШТАТЫ ПРЕДЛАГАЮТ ЗЕЛЕНСКОМУ ОБМЕН
Dialogue: 0,0:10:39.37,0:10:42.65,Caption,,0,0,0,,ДОНБАССА НА НАТО. ЕВРОПЕЙСКИЕ СОЮЗНИКИ ПЕРЕЧИСЛЯЮТ
Dialogue: 0,0:10:42.73,0:10:47.29,Caption,,0,0,0,,СОБСТВЕННЫЕ ПОЗИЦИИ, КОТОРЫЕ НЕ НАМЕРЕНЫ ПЕРЕСМАТРИВАТЬ. СУНАК СОВЕТУЕТ
Dialogue: 0,0:10:47.37,0:10:49.85,Caption,,0,0,0,,НЫНЕШНИМ ВЛАСТЯМ ГОТОВИТЬСЯ К УДАРУ ПО РОССИЙСКИМ
Dialogue: 0,0:10:49.85,0:10:52.97,Caption,,0,0,0,,СТРАТЕГИЧЕСКИМ ОБЪЕКТАМ. КУЛЕБА ПРЕДЛАГАЕТ УКРАИНЕ
Dialogue: 0,0:10:52.97,0:10:56.09,Caption,,0,0,0,,ЖДАТЬ БЛАГОПРИЯТНОГО ПЕРЕЛОМА. БЕЗУГЛАЯ СЧИТАЕТ
Dialogue: 0,0:10:56.09,0:10:59.85,Caption,,0,0,0,,ЛЮДЕЙ, СПОСОБНЫХ ОПЛАТИТЬ ЭТО ОЖИДАНИЕ. КАЖДЫЙ ПРОИЗНОСИТ
Dialogue: 0,0:10:59.85,0:11:03.13,Caption,,0,0,0,,УВЕРЕННЫЕ СЛОВА. ТОЛЬКО ПЛАНЫ У НИХ ЗАКАНЧИВАЮТСЯ В
Dialogue: 0,0:11:03.13,0:11:09.17,Caption,,0,0,0,,РАЗНЫХ МЕСТАХ. У ВАШИНГТОНА ВОЗМОЖНАЯ ЦЕЛЬ ХОТЯ БЫ ПРОСМАТРИВАЕТСЯ.
Dialogue: 0,0:11:09.55,0:11:11.97,Caption,,0,0,0,,ЕСЛИ АМЕРИКАНЦАМ ТРЕБОВАЛСЯ ОТКАЗ ЗЕЛЕНСКОГО,
Dialogue: 0,0:11:12.27,0:11:16.69,Caption,,0,0,0,,ОНИ ПОЛУЧИЛИ МАТЕРИАЛ, С КОТОРЫМ МОГУТ МЕНЯТЬ ДАЛЬНЕЙШУЮ ЛИНИЮ И УБЕЖДАТЬ
Dialogue: 0,0:11:16.69,0:11:20.21,Caption,,0,0,0,,ТРАМПА, ЧТО КИЕВ ОТВЕРГАЕТ ДАЖЕ КРУПНУЮ УСТУПКУ СО СТОРОНЫ
Dialogue: 0,0:11:20.21,0:11:24.21,Caption,,0,0,0,,США. У СУНАКА ТОЖЕ ИМЕЕТСЯ КОНКРЕТНОЕ ПРЕДЛОЖЕНИЕ.
Dialogue: 0,0:11:24.61,0:11:29.33,Caption,,0,0,0,,БЕЗРАССУДНОЕ, КРАЙНЕ ОПАСНОЕ, СПОСОБНОЕ ПОДНЯТЬ СТАВКИ ДО ПРЕДЕЛА,
Dialogue: 0,0:11:29.65,0:11:32.77,Caption,,0,0,0,,НО ВСЁ ЖЕ ПОНЯТНОЕ. УКРАИНСКАЯ ФОРМУЛА ПОКА СВОДИТСЯ
Dialogue: 0,0:11:32.85,0:11:34.85,Caption,,0,0,0,,К ПРОДОЛЖЕНИЮ. ДОЛЬШЕ ВОЕВАТЬ,
Dialogue: 0,0:11:35.10,0:11:39.25,Caption,,0,0,0,,ШИРЕ МОБИЛИЗОВАТЬ, СИЛЬНЕЕ ОГРАНИЧИВАТЬ БРОНЬ И НАДЕЯТЬСЯ,
Dialogue: 0,0:11:39.41,0:11:42.21,Caption,,0,0,0,,ЧТО ВНЕШНИЕ ОБСТОЯТЕЛЬСТВА ОДНАЖДЫ СДЕЛАЮТ ТО,
Dialogue: 0,0:11:42.45,0:11:45.33,Caption,,0,0,0,,ЧЕГО НЕ СМОГЛА СДЕЛАТЬ САМА СТРАТЕГИЯ. НО СТРАНА
Dialogue: 0,0:11:45.33,0:11:47.57,Caption,,0,0,0,,ДОЛЖНА ПРИЙТИ К ОПРЕДЕЛЁННОМУ РЕЗУЛЬТАТУ,
Dialogue: 0,0:11:47.81,0:11:50.69,Caption,,0,0,0,,А НЕ ПРОСТО К СЛЕДУЮЩЕМУ КАЛЕНДАРНОМУ ГОДУ. ПОЭТОМУ
Dialogue: 0,0:11:50.69,0:11:53.09,Caption,,0,0,0,,АМЕРИКАНСКАЯ ИНИЦИАТИВА ВАЖНА НЕ ТОЛЬКО СВОИМ
Dialogue: 0,0:11:53.09,0:11:55.97,Caption,,0,0,0,,СОДЕРЖАНИЕМ. ЕСЛИ ВАШИНГТОН ПРОВЕРЯЛ СПОСОБНОСТЬ
Dialogue: 0,0:11:55.97,0:12:00.37,Caption,,0,0,0,,ЗЕЛЕНСКОГО ПРИНЯТЬ СДЕЛКУ, ПРОВЕРКА ЗАКОНЧИЛАСЬ ПЕРЕЧНЕМ УСЛОВИЙ. ЕСЛИ ЖЕ
Dialogue: 0,0:12:00.37,0:12:02.37,Caption,,0,0,0,,ПРОВЕРЯЛИ ЕГО ГОТОВНОСТЬ ОТКАЗАТЬСЯ,
Dialogue: 0,0:12:02.60,0:12:05.81,Caption,,0,0,0,,ЗАДАЧА БЫЛА ВЫПОЛНЕНА ЕЩЁ УСПЕШНЕЕ. В ТАКОМ СЛУЧАЕ
Dialogue: 0,0:12:05.81,0:12:08.29,Caption,,0,0,0,,СЛЕДУЮЩИЙ ШАГ ЗАВИСИТ УЖЕ НЕ ОТ НОВЫХ ПОДАРКОВ
Dialogue: 0,0:12:08.37,0:12:13.33,Caption,,0,0,0,,КИЕВУ. ОН ЗАВИСИТ ОТ ТОГО, КАК В БЕЛОМ ДОМЕ ИСТОЛКУЮТ ПОЛУЧЕННЫЙ ОТВЕТ И
Dialogue: 0,0:12:13.41,0:12:15.81,Caption,,0,0,0,,КОМУ ПРЕДЪЯВЯТ СЧЁТ ЗА ПРОДОЛЖЕНИЕ ВОЙНЫ.
Dialogue: 0,0:12:18.08,0:12:20.16,Caption,,0,0,0,,НАПИШИТЕ В КОММЕНТАРИЯХ, ЧЕГО,
Dialogue: 0,0:12:20.30,0:12:24.24,Caption,,0,0,0,,ПО ВАШЕМУ МНЕНИЮ, ДОБИВАЛИСЬ АМЕРИКАНЦЫ СОГЛАШЕНИЯ ИЛИ УДОБНОГО
Dialogue: 0,0:12:24.32,0:12:26.88,Caption,,0,0,0,,ОТКАЗА? ПОТОМУ ЧТО ИНОГДА ПРЕДЛОЖЕНИЕ ДЕЛАЮТ РАДИ
Dialogue: 0,0:12:26.88,0:12:29.92,Caption,,0,0,0,,РУКОПОЖАТИЯ, А ИНОГДА РАДИ ВОЗМОЖНОСТИ ПОКАЗАТЬ,
Dialogue: 0,0:12:30.20,0:12:31.68,Caption,,0,0,0,,КТО ПЕРВЫМ УБРАЛ РУКУ.
