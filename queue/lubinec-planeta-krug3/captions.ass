Dialogue: 0,0:00:00.12,0:00:05.32,Caption,,0,0,0,,НАСТУПИТЬ НА ГРАБЛИ ОДИН РАЗ, ЭТО НЕВЕЗЕНИЕ. ДОСТАТЬ ТЕ ЖЕ ГРАБЛИ ЧЕРЕЗ НЕСКОЛЬКО
Dialogue: 0,0:00:05.32,0:00:08.36,Caption,,0,0,0,,ЛЕТ, ПРОТЕРЕТЬ ИХ ОТ ПЫЛИ И АККУРАТНО ПОЛОЖИТЬ ПЕРЕД
Dialogue: 0,0:00:08.44,0:00:13.56,Caption,,0,0,0,,СОБОЙ, ЭТО УЖЕ УБЕЖДЕНИЕ. ПРЕДЫДУЩАЯ ПОПЫТКА ЗЕЛЕНСКОГО ПОГОВОРИТЬ СВЫСОКА С
Dialogue: 0,0:00:13.56,0:00:16.20,Caption,,0,0,0,,ЧЕЛОВЕКОМ, ОТ КОТОРОГО ЗАВИСЕЛА ЕГО СУДЬБА,
Dialogue: 0,0:00:16.51,0:00:20.36,Caption,,0,0,0,,ЗАКОНЧИЛАСЬ ТАК, ЧТО ПЕРЕСМАТРИВАТЬ ЗАПИСЬ ОН ВРЯД ЛИ ЛЮБИТ. И
Dialogue: 0,0:00:20.36,0:00:22.92,Caption,,0,0,0,,ВСЁ ТАКИ ОН СНОВА УВЕРЕН В СЕБЕ. ОСТАЁТСЯ
Dialogue: 0,0:00:22.92,0:00:26.84,Caption,,0,0,0,,ПОНЯТЬ, ОТКУДА ВЗЯЛАСЬ ЭТА УВЕРЕННОСТЬ. ЕСЛИ ВАМ ИНТЕРЕСНЫ
Dialogue: 0,0:00:26.84,0:00:29.40,Caption,,0,0,0,,НЕ ЦЕРЕМОНИАЛЬНЫЕ УЛЫБКИ, А ПРИЧИНЫ,
Dialogue: 0,0:00:29.52,0:00:32.28,Caption,,0,0,0,,ПО КОТОРЫМ ПОЛИТИКИ ВНЕЗАПНО НАЧИНАЮТ УЛЫБАТЬСЯ ДРУГ
Dialogue: 0,0:00:32.28,0:00:36.60,Caption,,0,0,0,,ДРУГУ ЧУТЬ РЕЖЕ, ПОДПИСЫВАЙТЕСЬ. ИНОГДА ОДНА НЕУДАЧНАЯ ШУТКА
Dialogue: 0,0:00:36.84,0:00:39.08,Caption,,0,0,0,,РАССКАЗЫВАЕТ О ПОЛОЖЕНИИ ДЕЛ БОЛЬШЕ,
Dialogue: 0,0:00:39.32,0:00:41.56,Caption,,0,0,0,,ЧЕМ ЦЕЛАЯ ПАПКА ТОРЖЕСТВЕННЫХ ЗАЯВЛЕНИЙ.
Dialogue: 0,0:00:42.43,0:00:44.60,Caption,,0,0,0,,ВЫСТУПАЯ ПЕРЕД ДАТСКИМИ ПАРЛАМЕНТАРИЯМИ,
Dialogue: 0,0:00:44.92,0:00:47.48,Caption,,0,0,0,,ЗЕЛЕНСКИЙ СНОВА ЗАДЕЛ ТРАМПА ЧЕРЕЗ ИСТОРИЮ С
Dialogue: 0,0:00:47.56,0:00:49.64,Caption,,0,0,0,,ГРЕНЛАНДИЕЙ. СДЕЛАЛ ЭТО ВЕСЕЛО,
Dialogue: 0,0:00:49.87,0:00:52.36,Caption,,0,0,0,,С ПРИВЫЧНОЙ УХМЫЛКОЙ И В РАСЧЁТЕ НА БЛАГОДАРНУЮ
Dialogue: 0,0:00:52.36,0:00:55.24,Caption,,0,0,0,,ЕВРОПЕЙСКУЮ ПУБЛИКУ. В ЗАЛЕ, ВЕРОЯТНО,
Dialogue: 0,0:00:55.39,0:00:58.68,Caption,,0,0,0,,ОЦЕНИЛИ. ВОТ ТОЛЬКО АДРЕСАТ СИДИТ НЕ В ЗАЛЕ И
Dialogue: 0,0:00:58.68,0:01:03.16,Caption,,0,0,0,,АПЛОДИРОВАТЬ НЕ ОБЯЗАН. ПЕРЕД ЗЕЛЕНСКИМ НЕ ВЕДУЩИЙ ВЕЧЕРНЕГО ШОУ,
Dialogue: 0,0:01:03.35,0:01:05.96,Caption,,0,0,0,,КОТОРОГО МОЖНО ПОДДЕТЬ РАДИ РЕАКЦИИ АУДИТОРИИ,
Dialogue: 0,0:01:06.32,0:01:08.12,Caption,,0,0,0,,А ПРЕЗИДЕНТ СОЕДИНЁННЫХ ШТАТОВ,
Dialogue: 0,0:01:08.28,0:01:10.84,Caption,,0,0,0,,СПОСОБНЫЙ ОДНИМ РЕШЕНИЕМ СДЕЛАТЬ ПОЛОЖЕНИЕ КИЕВА
Dialogue: 0,0:01:10.84,0:01:15.67,Caption,,0,0,0,,ЗАМЕТНО СЛОЖНЕЕ. А РАЗГОВАРИВАЕТ ОН С НИМ ТАК,
Dialogue: 0,0:01:15.91,0:01:19.19,Caption,,0,0,0,,СЛОВНО ЭТО ЗНАКОМЫЙ ДАЧНИК, С КОТОРЫМ ОНИ ТРЕТИЙ ГОД СПОРЯТ,
Dialogue: 0,0:01:19.35,0:01:22.47,Caption,,0,0,0,,ЧЕЙ КУСТ ЗАЛЕЗ НА ЧУЖОЙ УЧАСТОК. ДО АМЕРИКИ
Dialogue: 0,0:01:22.47,0:01:24.23,Caption,,0,0,0,,КОЛКОСТЬ ДОЛЕТЕЛА БЕЗ ЗАДЕРЖЕК.
Dialogue: 0,0:01:25.09,0:01:28.31,Caption,,0,0,0,,КОНГРЕССМЕН ГРЕГ СТЬЮБЕ ОТВЕТИЛ РЕЗКО. ЗАТЕМ ЮРИЙ
Dialogue: 0,0:01:28.31,0:01:31.59,Caption,,0,0,0,,УШАКОВ СООБЩИЛ ЕЩЁ БОЛЕЕ ЛЮБОПЫТНУЮ ДЕТАЛЬ. ВО ВРЕМЯ
Dialogue: 0,0:01:31.59,0:01:34.15,Caption,,0,0,0,,ВСТРЕЧИ ВЛАДИМИРА ПУТИНА СО СТИВОМ УИТКОФФОМ И
Dialogue: 0,0:01:34.15,0:01:37.03,Caption,,0,0,0,,ДЖАРЕДОМ КУШНЕРОМ РЕЧЬ ЗАХОДИЛА И О ЗЕЛЕНСКОМ,
Dialogue: 0,0:01:37.22,0:01:40.55,Caption,,0,0,0,,ВКЛЮЧАЯ ПЕРЕДАННЫЕ ИМ НАСМЕШЛИВЫЕ "ПРИВЕТЫ" ТРАМПУ.
Dialogue: 0,0:01:41.11,0:01:44.07,Caption,,0,0,0,,РЕПЛИКА, РАССЧИТАННАЯ НА НЕСКОЛЬКО ДОВОЛЬНЫХ ЛИЦ В
Dialogue: 0,0:01:44.07,0:01:46.55,Caption,,0,0,0,,КОПЕНГАГЕНЕ, ОКАЗАЛАСЬ НА СТОЛЕ У ЛЮДЕЙ,
Dialogue: 0,0:01:46.71,0:01:49.91,Caption,,0,0,0,,ОБСУЖДАЮЩИХ ВОЗМОЖНОЕ ОКОНЧАНИЕ КОНФЛИКТА. ПОШУТИЛ
Dialogue: 0,0:01:49.91,0:01:52.79,Caption,,0,0,0,,НА ВЫЕЗДЕ, А РАЗБИРАТЬ ШУТКУ НАЧАЛИ В КАБИНЕТЕ,
Dialogue: 0,0:01:53.03,0:01:55.83,Caption,,0,0,0,,ГДЕ СОВСЕМ ДРУГОЙ СПИСОК ПРИГЛАШЁННЫХ. ЗЕЛЕНСКИЙ
Dialogue: 0,0:01:55.91,0:01:58.63,Caption,,0,0,0,,ДОБИВАЛСЯ ВНИМАНИЯ И ПОЛУЧИЛ ЕГО В ПОЛНОМ ОБЪЁМЕ.
Dialogue: 0,0:01:58.92,0:02:01.91,Caption,,0,0,0,,ТЕПЕРЬ ЕМУ ПРИДЁТСЯ ВЫЯСНИТЬ ЦЕНУ. СЧЁТ В ТАКИХ
Dialogue: 0,0:02:01.91,0:02:03.99,Caption,,0,0,0,,СЛУЧАЯХ ПРИХОДИТ НЕ РЕПЛИКОЙ С ТРИБУНЫ,
Dialogue: 0,0:02:04.23,0:02:09.11,Caption,,0,0,0,,А ЗАДЕРЖАННОЙ ПОСТАВКОЙ, ОТЛОЖЕННОЙ ВСТРЕЧЕЙ И СТРОКОЙ В ПРОЕКТЕ СОГЛАШЕНИЯ,
Dialogue: 0,0:02:09.34,0:02:12.31,Caption,,0,0,0,,КОТОРУЮ КИЕВУ ПОКАЖУТ УЖЕ ГОТОВОЙ. МАНЕРА У
Dialogue: 0,0:02:12.31,0:02:15.19,Caption,,0,0,0,,ЗЕЛЕНСКОГО ДАВНЯЯ. В ДВЕ ТЫСЯЧИ ДЕВЯТНАДЦАТОМ ГОДУ
Dialogue: 0,0:02:15.27,0:02:18.07,Caption,,0,0,0,,ОН ПРИМЕРНО ТАК ЖЕ ДЕРЖАЛСЯ С ПУТИНЫМ ПЕРЕБИВАЛ,
Dialogue: 0,0:02:18.26,0:02:19.99,Caption,,0,0,0,,ПЫТАЛСЯ ПЕРЕИГРАТЬ НА ПУБЛИКЕ,
Dialogue: 0,0:02:20.16,0:02:22.23,Caption,,0,0,0,,ПОКАЗЫВАЛ, ЧТО ПЕРЕД НИМ ЧЕЛОВЕК,
Dialogue: 0,0:02:22.47,0:02:25.27,Caption,,0,0,0,,КОТОРОГО МОЖНО ПОСТАВИТЬ В НЕЛОВКОЕ ПОЛОЖЕНИЕ ОДНОЙ
Dialogue: 0,0:02:25.27,0:02:30.82,Caption,,0,0,0,,БОЙКОЙ РЕПЛИКОЙ. ПРОДОЛЖЕНИЕ ТОГО СПЕКТАКЛЯ ИЗВЕСТНО ВСЕМ,
Dialogue: 0,0:02:30.98,0:02:33.78,Caption,,0,0,0,,И ВЕСЁЛЫМ ЕГО НАЗВАТЬ ТРУДНО. ТЕПЕРЬ ТОТ ЖЕ
Dialogue: 0,0:02:33.78,0:02:36.50,Caption,,0,0,0,,ПРИЁМ ИСПЫТЫВАЮТ НА ТРАМПЕ ФАМИЛИЯ ДРУГАЯ,
Dialogue: 0,0:02:36.64,0:02:40.74,Caption,,0,0,0,,СЦЕНА НОВАЯ, А УВЕРЕННОСТЬ АРТИСТА ПРЕЖНЯЯ. ТЕМ ВРЕМЕНЕМ
Dialogue: 0,0:02:40.82,0:02:43.54,Caption,,0,0,0,,ВАШИНГТОН УЖЕ ПОДБИРАЕТ ВЫРАЖЕНИЯ БЕЗ КОМПЛИМЕНТОВ.
Dialogue: 0,0:02:44.02,0:02:46.02,Caption,,0,0,0,,ПОСЛЕ ВСТРЕЧИ С ПУТИНЫМ УИТКОФФ СКАЗАЛ,
Dialogue: 0,0:02:46.33,0:02:48.82,Caption,,0,0,0,,ЧТО ВМЕСТЕ С КУШНЕРОМ ОТПРАВИТСЯ К ЗЕЛЕНСКОМУ И
Dialogue: 0,0:02:48.90,0:02:51.14,Caption,,0,0,0,,СТАНЕТ УБЕЖДАТЬ ЕГО ВЫБРАТЬ ОДИН ИЗ ВАРИАНТОВ
Dialogue: 0,0:02:51.14,0:02:53.94,Caption,,0,0,0,,ПРЕКРАЩЕНИЯ КОНФЛИКТА. НЕ ВЫСЛУШИВАТЬ ПОЖЕЛАНИЯ
Dialogue: 0,0:02:53.94,0:02:57.54,Caption,,0,0,0,,КИЕВА, А ИМЕННО УБЕЖДАТЬ. ВРОДЕ ОБЫЧНОЕ СЛОВО,
Dialogue: 0,0:02:57.81,0:03:00.74,Caption,,0,0,0,,НО В НЁМ СЛЫШИТСЯ, ЧТО МЕНЮ СОСТАВЛЕНО ЗАРАНЕЕ,
Dialogue: 0,0:03:00.98,0:03:03.22,Caption,,0,0,0,,А ГОСТЮ ПРЕДЛАГАЮТ ОПРЕДЕЛИТЬСЯ ТОЛЬКО С ТЕМ,
Dialogue: 0,0:03:03.45,0:03:06.10,Caption,,0,0,0,,КАКОЙ ВИЛКОЙ ПОЛЬЗОВАТЬСЯ. МОЖНО ПРЕДСТАВИТЬ,
Dialogue: 0,0:03:06.41,0:03:08.34,Caption,,0,0,0,,КАК ПОСЛАННИКИ ЛАСКОВО УГОВАРИВАЮТ,
Dialogue: 0,0:03:08.57,0:03:11.38,Caption,,0,0,0,,ЗЕЛЕНСКИЙ ПРИЗНАЁТ ОШИБКУ И ТУТ ЖЕ ДОСТАЁТ РУЧКУ.
Dialogue: 0,0:03:11.68,0:03:13.78,Caption,,0,0,0,,НА ДЕЛЕ УБЕЖДАЮТ НЕ ИНТОНАЦИЕЙ,
Dialogue: 0,0:03:13.93,0:03:17.14,Caption,,0,0,0,,А ВОЗМОЖНОСТЯМИ. ПРЕЗИДЕНТ УКРАИНЫ НЕ РАЗ ПОКАЗЫВАЛ,
Dialogue: 0,0:03:17.30,0:03:19.54,Caption,,0,0,0,,ЧТО ДОБРОВОЛЬНО МЕНЯТЬ КУРС НЕ НАМЕРЕН,
Dialogue: 0,0:03:19.74,0:03:23.30,Caption,,0,0,0,,ЗНАЧИТ, К НЕМУ ЕДУТ НЕ С ДУШЕВНЫМИ СОВЕТАМИ. СПОСОБОВ
Dialogue: 0,0:03:23.30,0:03:25.46,Caption,,0,0,0,,СДЕЛАТЬ БЕСЕДУ СОДЕРЖАТЕЛЬНОЙ У ВАШИНГТОНА
Dialogue: 0,0:03:25.46,0:03:27.46,Caption,,0,0,0,,ДОСТАТОЧНО, И ЛЕЖАТ ОНИ БЛИЗКО.
Dialogue: 0,0:03:28.09,0:03:30.42,Caption,,0,0,0,,КОРРУПЦИОННЫЕ СЮЖЕТЫ ПРОДОЛЖАЮТ ВИСЕТЬ НАД
Dialogue: 0,0:03:30.42,0:03:34.92,Caption,,0,0,0,,УКРАИНСКОЙ ВЛАСТЬЮ. НАБУ РАБОТАЕТ,
Dialogue: 0,0:03:35.08,0:03:37.64,Caption,,0,0,0,,ИМЯ МИНДИЧА ДАВНО ЗВУЧИТ В МЕСТНЫХ РАЗБОРКАХ,
Dialogue: 0,0:03:38.04,0:03:40.92,Caption,,0,0,0,,А ЗАКУПКИ МИНИСТЕРСТВА ОБОРОНЫ С ЛЕГЕНДАРНЫМИ ЯЙЦАМИ
Dialogue: 0,0:03:41.00,0:03:45.24,Caption,,0,0,0,,ОДНАЖДЫ ОЦЕНИЛИ ТАК, БУДТО КАЖДАЯ КУРИЦА ПЕРЕД СДАЧЕЙ ПРОДУКЦИИ ПРОХОДИЛА
Dialogue: 0,0:03:45.32,0:03:50.12,Caption,,0,0,0,,ОБУЧЕНИЕ У ЮВЕЛИРА. НО ДЕЛО УЖЕ НЕ В ЦЕНЕ ЗАВТРАКА. ВАЖНЕЕ,
Dialogue: 0,0:03:50.30,0:03:53.40,Caption,,0,0,0,,СКОЛЬКО У ВЛАСТИ НАКОПЛЕНО УЯЗВИМЫХ МЕСТ И КТО
Dialogue: 0,0:03:53.48,0:03:56.44,Caption,,0,0,0,,В НУЖНЫЙ МОМЕНТ НАДАВИТ. ЕСТЬ И ЗАВИСИМОСТЬ ДРУГОГО
Dialogue: 0,0:03:56.44,0:04:01.08,Caption,,0,0,0,,РОДА. УКРАИНА СООБЩИЛА, ЧТО СКОРОСТЬ STARSHIELD ОГРАНИЧИЛИ ВОЗЛЕ ЛИНИИ
Dialogue: 0,0:04:01.08,0:04:04.28,Caption,,0,0,0,,ФРОНТА И НА ТЕРРИТОРИЯХ ПОД РОССИЙСКИМ КОНТРОЛЕМ. ПО
Dialogue: 0,0:04:04.28,0:04:08.44,Caption,,0,0,0,,СЛОВАМ ЗЕЛЕНСКОГО, ЭТО МЕШАЕТ УКРАИНСКИМ ПЕРЕХВАТЧИКАМ. ПОЛУЧИЛАСЬ
Dialogue: 0,0:04:08.44,0:04:11.00,Caption,,0,0,0,,НАГЛЯДНАЯ ДЕМОНСТРАЦИЯ СУВЕРЕННОСТИ СИСТЕМА
Dialogue: 0,0:04:11.00,0:04:14.04,Caption,,0,0,0,,НЕОБХОДИМА КИЕВУ, ЖАЛОБА ЗВУЧИТ ИЗ КИЕВА,
Dialogue: 0,0:04:14.36,0:04:16.84,Caption,,0,0,0,,А ПЕРЕКЛЮЧАТЕЛЬ ВСЁ РАВНО РАСПОЛОЖЕН ЗА ОКЕАНОМ.
Dialogue: 0,0:04:17.05,0:04:19.24,Caption,,0,0,0,,МОЖНО СКОЛЬКО УГОДНО СТУЧАТЬ ПО ПАНЕЛИ,
Dialogue: 0,0:04:19.42,0:04:22.52,Caption,,0,0,0,,ДОСТУП АДМИНИСТРАТОРА ОТ ЭТОГО НЕ ПОЯВИТСЯ. ВОТ И
Dialogue: 0,0:04:22.60,0:04:25.32,Caption,,0,0,0,,ВСЯ МЕХАНИКА БУДУЩЕГО РАЗГОВОРА. У ЗЕЛЕНСКОГО
Dialogue: 0,0:04:25.32,0:04:27.96,Caption,,0,0,0,,КРАСИВЫЕ РЕПЛИКИ, У АМЕРИКАНЦЕВ КНОПКИ,
Dialogue: 0,0:04:28.10,0:04:31.24,Caption,,0,0,0,,РАССЛЕДОВАНИЯ И УСЛОВИЯ ПОМОЩИ. И ВСЁ ТАКИ КИЕВ
Dialogue: 0,0:04:31.24,0:04:34.52,Caption,,0,0,0,,ДЕРЖИТСЯ ВЫЗЫВАЮЩЕ, ЗНАЧИТ, ТАМ ЕСТЬ РАСЧЁТ,
Dialogue: 0,0:04:34.68,0:04:37.16,Caption,,0,0,0,,КОТОРЫЙ КАЖЕТСЯ НАДЁЖНЫМ. РАСЧЁТ ДЕЙСТВИТЕЛЬНО
Dialogue: 0,0:04:37.16,0:04:40.04,Caption,,0,0,0,,ПРОСМАТРИВАЕТСЯ. НА ПРОМЕЖУТОЧНЫХ ВЫБОРАХ ДЕМОКРАТЫ
Dialogue: 0,0:04:40.04,0:04:43.08,Caption,,0,0,0,,ПОЛУЧИЛИ БОЛЬШИНСТВО СРАЗУ В ДВУХ ПАЛАТАХ КОНГРЕССА.
Dialogue: 0,0:04:43.24,0:04:45.48,Caption,,0,0,0,,НОВЫЙ СОСТАВ ПРИСТУПИТ К РАБОТЕ В ЯНВАРЕ.
Dialogue: 0,0:04:47.68,0:04:50.08,Caption,,0,0,0,,ДЛЯ КИЕВА ЭТО ВЫГЛЯДИТ КАК СПАСАТЕЛЬНЫЙ КРУГ,
Dialogue: 0,0:04:50.31,0:04:53.20,Caption,,0,0,0,,УЖЕ БРОШЕННЫЙ В ВОДУ, ХОТЯ ПОДПЛЫТЬ К НЕМУ ЕЩЁ НАДО.
Dialogue: 0,0:04:53.86,0:04:57.20,Caption,,0,0,0,,ЗЕЛЕНСКИЙ МОЖЕТ СЧИТАТЬ, ЧТО ГЛАВНОЕ СЕЙЧАС ПРОДЕРЖАТЬСЯ,
Dialogue: 0,0:04:57.36,0:04:59.60,Caption,,0,0,0,,НЕ УСТУПИТЬ ТРАМПУ И ДОЖДАТЬСЯ МОМЕНТА,
Dialogue: 0,0:04:59.89,0:05:02.56,Caption,,0,0,0,,КОГДА ДЕМОКРАТЫ СВЯЖУТ ПРЕЗИДЕНТУ РУКИ ВНУТРЕННЕЙ
Dialogue: 0,0:05:02.56,0:05:07.44,Caption,,0,0,0,,БОРЬБОЙ. СХЕМА УДОБНАЯ, НО В НЕЙ ЕСТЬ НЕПРИЯТНАЯ ДЕТАЛЬ. ДО ЯНВАРЯ
Dialogue: 0,0:05:07.44,0:05:09.92,Caption,,0,0,0,,БЕЛЫЙ ДОМ НЕ ЗАКРОЮТ НА ПЕРЕУЧЁТ ПОЛНОМОЧИЯ
Dialogue: 0,0:05:09.92,0:05:13.60,Caption,,0,0,0,,ПРЕЗИДЕНТА СОХРАНЯТСЯ, КОМАНДА ТРАМПА ПРОДОЛЖИТ ПЕРЕГОВОРЫ,
Dialogue: 0,0:05:13.83,0:05:16.16,Caption,,0,0,0,,А ДАВЛЕНИЕ НА КИЕВ НЕ ОТПРАВИТСЯ В ОТПУСК.
Dialogue: 0,0:05:16.50,0:05:18.56,Caption,,0,0,0,,К ТОМУ ЖЕ АМЕРИКАНЦЫ ИЗУЧАЮТ ВАРИАНТЫ,
Dialogue: 0,0:05:18.88,0:05:21.44,Caption,,0,0,0,,В КОТОРЫХ УКРАИНСКАЯ ПОЛИТИКА БОЛЬШЕ НЕ ВРАЩАЕТСЯ
Dialogue: 0,0:05:21.44,0:05:23.92,Caption,,0,0,0,,ВОКРУГ ОДНОГО ЧЕЛОВЕКА. ЗЕЛЕНСКИЙ СМОТРИТ НА
Dialogue: 0,0:05:23.92,0:05:27.28,Caption,,0,0,0,,КАЛЕНДАРЬ. ВАШИНГТОН РАССМАТРИВАЕТ СПИСОК ВОЗМОЖНЫХ
Dialogue: 0,0:05:27.28,0:05:30.08,Caption,,0,0,0,,ЗАМЕН. ВНИМАНИЕ СОЕДИНЁННЫХ ШТАТОВ НАЧИНАЕТ ПОЛУЧАТЬ
Dialogue: 0,0:05:30.08,0:05:33.20,Caption,,0,0,0,,ДМИТРИЙ ЛУБИНЕЦ. ВЫБОР НЕОЖИДАННЫЙ ИМЕННО ПОТОМУ,
Dialogue: 0,0:05:33.52,0:05:36.16,Caption,,0,0,0,,ЧТО РЯДОМ ЕСТЬ КУДА БОЛЕЕ ГРОМКИЕ ФАМИЛИИ ВАЛЕРИЙ
Dialogue: 0,0:05:36.16,0:05:39.68,Caption,,0,0,0,,ЗАЛУЖНЫЙ, КОТОРОГО ДАВНО ОБСУЖДАЮТ КАК СОПЕРНИКА ЗЕЛЕНСКОГО,
Dialogue: 0,0:05:39.91,0:05:42.32,Caption,,0,0,0,,КИРИЛЛ БУДАНОВ С ОБРАЗОМ СУРОВОГО РУКОВОДИТЕЛЯ
Dialogue: 0,0:05:42.32,0:05:47.84,Caption,,0,0,0,,СПЕЦСЛУЖБЫ, ДАВИД АРАХАМИЯ, ДАВНО ВСТРОЕННЫЙ ВО ВЛАСТЬ. АМЕРИКАНЦЫ ЖЕ ВЫДЕЛЯЮТ
Dialogue: 0,0:05:47.84,0:05:51.04,Caption,,0,0,0,,ОМБУДСМЕНА, ЧЕЛОВЕКА, СВЯЗАННОГО С ПЛЕННЫМИ,
Dialogue: 0,0:05:51.14,0:05:54.48,Caption,,0,0,0,,ДЕТЬМИ, ВОЗВРАЩЕНИЕМ ЛЮДЕЙ И ЗАЩИТОЙ ИХ ПРАВ.
Dialogue: 0,0:05:56.74,0:05:59.46,Caption,,0,0,0,,НА ФОНЕ УКРАИНСКОЙ ВЕРХУШКИ ЛУБИНЕЦ ВЫГЛЯДИТ КАК
Dialogue: 0,0:05:59.46,0:06:03.30,Caption,,0,0,0,,СЕЛЬСКИЙ ВРАЧ, СЛУЧАЙНО ПОПАВШИЙ НА СОВЕЩАНИЕ ВЛАДЕЛЬЦЕВ ОРУЖЕЙНЫХ
Dialogue: 0,0:06:03.30,0:06:05.70,Caption,,0,0,0,,МАГАЗИНОВ ВСЕ ВОКРУГ СЧИТАЮТ ВЛИЯНИЕ,
Dialogue: 0,0:06:05.86,0:06:08.90,Caption,,0,0,0,,ДОЛЖНОСТИ И РЕСУРСЫ, А ОН ГОВОРИТ О ЛЮДЯХ,
Dialogue: 0,0:06:09.09,0:06:13.38,Caption,,0,0,0,,КОТОРЫХ НУЖНО ВЕРНУТЬ ДОМОЙ. ПОТОМУ ЕГО ПОЯВЛЕНИЕ РЯДОМ С БЕЛЫМ ДОМОМ И
Dialogue: 0,0:06:13.38,0:06:18.42,Caption,,0,0,0,,ЗАСЛУЖИВАЕТ ВНИМАНИЯ. ПЯТОГО НОЯБРЯ МЕЛАНИЯ ТРАМП ПРИНИМАЛА ПРЕДСТАВИТЕЛЕЙ
Dialogue: 0,0:06:18.42,0:06:21.06,Caption,,0,0,0,,РОССИИ И УКРАИНЫ ПОСЛЕ ГУМАНИТАРНОЙ МИССИИ.
Dialogue: 0,0:06:21.35,0:06:24.74,Caption,,0,0,0,,УКРАИНСКУЮ СТОРОНУ ПРЕДСТАВЛЯЛИ АРАХАМИЯ И ЛУБИНЕЦ.
Dialogue: 0,0:06:25.05,0:06:27.70,Caption,,0,0,0,,ОДНАКО ОТДЕЛЬНО ПЕРВАЯ ЛЕДИ ОТМЕТИЛА ИМЕННО
Dialogue: 0,0:06:27.71,0:06:31.78,Caption,,0,0,0,,ОМБУДСМЕНА, ПОБЛАГОДАРИВ ЕГО ЗА МУЖЕСТВО И СЕРДЕЧНОЕ ОТНОШЕНИЕ К
Dialogue: 0,0:06:31.78,0:06:33.86,Caption,,0,0,0,,СЛУЖЕНИЮ ЛЮДЯМ. ДЛЯ ЧИНОВНИКА,
Dialogue: 0,0:06:34.10,0:06:36.18,Caption,,0,0,0,,КОТОРОГО ПРЕЖДЕ ТРУДНО БЫЛО НАЗВАТЬ МИРОВОЙ
Dialogue: 0,0:06:36.18,0:06:40.50,Caption,,0,0,0,,ЗНАМЕНИТОСТЬЮ, ЭТО НЕ ДЕЖУРНЫЙ КИВОК. НА НЕГО НАПРАВИЛИ СВЕТ
Dialogue: 0,0:06:40.57,0:06:43.54,Caption,,0,0,0,,И ДАЛИ ЗРИТЕЛЯМ ВРЕМЯ РАССМОТРЕТЬ ЛИЦО. ЛУБИНЦА
Dialogue: 0,0:06:43.54,0:06:46.18,Caption,,0,0,0,,ВЫВОДЯТ ИЗ ПРИВЫЧНОГО ВНУТРЕННЕГО СЮЖЕТА И
Dialogue: 0,0:06:46.18,0:06:49.22,Caption,,0,0,0,,ПОКАЗЫВАЮТ В НОВОМ КАЧЕСТВЕ. ЕГО ОБЛАСТЬ ВЫГЛЯДИТ
Dialogue: 0,0:06:49.23,0:06:51.54,Caption,,0,0,0,,ИНАЧЕ, ЧЕМ У ОСТАЛЬНЫХ ОБМЕНЫ,
Dialogue: 0,0:06:51.62,0:06:54.50,Caption,,0,0,0,,ДЕТИ, ПЛЕННЫЕ, ВОЗВРАЩЕНИЕ ДОМОЙ,
Dialogue: 0,0:06:54.66,0:06:58.90,Caption,,0,0,0,,ЧЕЛОВЕЧЕСКИЕ СУДЬБЫ. ПОСЛЕ НЕСКОЛЬКИХ ЛЕТ БОЕВОЙ РИТОРИКИ ТАКОЙ ЧЕЛОВЕК
Dialogue: 0,0:06:58.90,0:07:01.86,Caption,,0,0,0,,ВОСПРИНИМАЕТСЯ ПОЧТИ КАК ОТКРЫТОЕ ОКНО. ДАЖЕ ЕСЛИ
Dialogue: 0,0:07:01.86,0:07:04.58,Caption,,0,0,0,,ОКНО ПОКА ОТКРЫЛ ТОТ, КТО ПРЕКРАСНО ПОНИМАЕТ,
Dialogue: 0,0:07:04.66,0:07:08.42,Caption,,0,0,0,,ЗАЧЕМ ЭТО ДЕЛАЕТ. НА ЭТОМ ФОНЕ ПРИВЫЧНЫЕ КАНДИДАТЫ
Dialogue: 0,0:07:08.50,0:07:14.54,Caption,,0,0,0,,МЕНЕЕ УДОБНЫ. ЗАЛУЖНЫЙ ПРОЧНО СВЯЗАН С АРМИЕЙ И ВСЕМ ПЕРИОДОМ
Dialogue: 0,0:07:14.54,0:07:19.66,Caption,,0,0,0,,ВООРУЖЁННОГО ПРОТИВОСТОЯНИЯ, БУДАНОВ НЕСЁТ ОБРАЗ СПЕЦСЛУЖБ И СИЛОВЫХ РЕШЕНИЙ,
Dialogue: 0,0:07:20.03,0:07:22.86,Caption,,0,0,0,,А АРАХАМИЯ ВХОДИТ В НЫНЕШНЮЮ ВЛАСТЬ ТАК ДАВНО,
Dialogue: 0,0:07:23.18,0:07:25.26,Caption,,0,0,0,,ЧТО ОБЪЯВЛЯТЬ ЕГО НОВЫМ НАЧАЛОМ ВСЁ РАВНО ЧТО
Dialogue: 0,0:07:25.26,0:07:28.22,Caption,,0,0,0,,ПЕРЕКЛЕИТЬ ЦЕННИК НА СТАРОЙ ВЕЩИ И ТОРЖЕСТВЕННО
Dialogue: 0,0:07:28.22,0:07:30.38,Caption,,0,0,0,,СООБЩИТЬ О ПОСТУПЛЕНИИ СВЕЖЕЙ КОЛЛЕКЦИИ.
Dialogue: 0,0:07:30.94,0:07:33.74,Caption,,0,0,0,,ИМЕННО ПОЭТОМУ ЛУБИНЕЦ МОЖЕТ ОКАЗАТЬСЯ ПОЛЕЗЕН В
Dialogue: 0,0:07:33.74,0:07:36.78,Caption,,0,0,0,,МОМЕНТ СМЕНЫ КУРСА. НЕ КАК САМОСТОЯТЕЛЬНЫЙ ПРАВИТЕЛЬ
Dialogue: 0,0:07:36.86,0:07:39.34,Caption,,0,0,0,,И НЕ КАК ПЕРЕГОВОРЩИК ПО ТЕРРИТОРИЯМ ДЛЯ ТЯЖЁЛОГО
Dialogue: 0,0:07:39.34,0:07:44.70,Caption,,0,0,0,,ТОРГА НАЙДУТСЯ СПЕЦИАЛИСТЫ, СПОСОБНЫЕ МЕСЯЦАМИ СПОРИТЬ О КАЖДОЙ СТРОКЕ. ЕГО
Dialogue: 0,0:07:44.78,0:07:48.06,Caption,,0,0,0,,ЗАДАЧА ПРОЩЕ И ВАЖНЕЕ. ОН СПОСОБЕН СТАТЬ ЛИЦОМ,
Dialogue: 0,0:07:48.15,0:07:49.90,Caption,,0,0,0,,ЧЕРЕЗ КОТОРОЕ ПУБЛИКЕ ОБЪЯСНЯТ,
Dialogue: 0,0:07:50.21,0:07:53.50,Caption,,0,0,0,,ЧТО ПРЕЖНЯЯ ГЛАВА ЗАКРЫТА. РОССИЯ ГОДАМИ ТРЕБУЕТ
Dialogue: 0,0:07:53.50,0:07:55.74,Caption,,0,0,0,,"ДЕНАЦИФИКАЦИИ" И ИЗМЕНЕНИЯ УКРАИНСКОГО
Dialogue: 0,0:07:55.74,0:07:58.78,Caption,,0,0,0,,ПОЛИТИЧЕСКОГО КУРСА. ЧТОБЫ ПОКАЗАТЬ ТАКОЙ ПОВОРОТ,
Dialogue: 0,0:07:58.98,0:08:01.42,Caption,,0,0,0,,МАЛО ПОЛОЖИТЬ НА СТОЛ СОГЛАШЕНИЕ И УСТРОИТЬ
Dialogue: 0,0:08:01.50,0:08:03.66,Caption,,0,0,0,,ЦЕРЕМОНИЮ С РУЧКАМИ. НУЖНА ФИГУРА,
Dialogue: 0,0:08:03.96,0:08:06.94,Caption,,0,0,0,,КОТОРАЯ ОДНИМ ПОЯВЛЕНИЕМ ОБОЗНАЧИТ РАЗРЫВ С ПРЕЖНЕЙ
Dialogue: 0,0:08:06.94,0:08:09.42,Caption,,0,0,0,,СИСТЕМОЙ ВМЕСТО ЕЖЕДНЕВНЫХ УГРОЗ РАЗГОВОР ОБ
Dialogue: 0,0:08:09.42,0:08:11.82,Caption,,0,0,0,,ОБМЕНАХ, ДЕТЯХ И ВОЗВРАЩЕНИИ ЛЮДЕЙ.
Dialogue: 0,0:08:12.39,0:08:14.78,Caption,,0,0,0,,ЛУБИНЦА НЕ ПРИДЁТСЯ ДОЛГО ОБЪЯСНЯТЬ АУДИТОРИИ.
Dialogue: 0,0:08:15.18,0:08:17.26,Caption,,0,0,0,,ДОСТАТОЧНО ПОСТАВИТЬ РЯДОМ ДВА КАДРА,
Dialogue: 0,0:08:17.57,0:08:20.14,Caption,,0,0,0,,И РАЗНИЦА СТАНЕТ ПОНЯТНА БЕЗ ДЛИННОЙ ЛЕКЦИИ.
Dialogue: 0,0:08:20.53,0:08:24.46,Caption,,0,0,0,,ПОКАЗАТЕЛЬНО И ВРЕМЯ, КОГДА ЛУБИНЦА НАЧАЛИ ВЫВОДИТЬ НА МЕЖДУНАРОДНЫЙ
Dialogue: 0,0:08:24.46,0:08:29.85,Caption,,0,0,0,,УРОВЕНЬ. НА БАНКОВОЙ ЕГО САМОСТОЯТЕЛЬНУЮ АКТИВНОСТЬ ЗАМЕЧАЮТ
Dialogue: 0,0:08:29.85,0:08:33.85,Caption,,0,0,0,,БЕЗ ОСОБОГО ВОСТОРГА, А В УКРАИНСКИХ ЭКСПЕРТНЫХ КРУГАХ ЗАГОВОРИЛИ,
Dialogue: 0,0:08:34.09,0:08:36.57,Caption,,0,0,0,,ЧТО ВАШИНГТОН ПРИСМАТРИВАЕТСЯ К ОМБУДСМЕНУ НА
Dialogue: 0,0:08:36.57,0:08:39.53,Caption,,0,0,0,,БУДУЩЕЕ. ЕЩЁ НЕДАВНО ТАКАЯ ВЕРСИЯ ВЫЗВАЛА БЫ
Dialogue: 0,0:08:39.53,0:08:42.25,Caption,,0,0,0,,СНИСХОДИТЕЛЬНУЮ УЛЫБКУ. ПОДПИСЫВАЙТЕСЬ,
Dialogue: 0,0:08:42.57,0:08:44.73,Caption,,0,0,0,,ЕСЛИ ХОТИТЕ ВИДЕТЬ НЕ ТОЛЬКО СПИСОК ВИЗИТОВ,
Dialogue: 0,0:08:45.03,0:08:48.41,Caption,,0,0,0,,НО И ТЕХ, КОГО ВО ВРЕМЯ ЭТИХ ВИЗИТОВ НЕЗАМЕТНО ПЕРЕДВИГАЮТ
Dialogue: 0,0:08:48.41,0:08:50.89,Caption,,0,0,0,,БЛИЖЕ К ЦЕНТРУ ФОТОГРАФИИ. И НАПИШИТЕ В
Dialogue: 0,0:08:50.97,0:08:55.05,Caption,,0,0,0,,КОММЕНТАРИЯХ, СЧИТАЕТЕ ЛИ ВЫ ЛУБИНЦА РЕАЛЬНОЙ ЗАМЕНОЙ ИЛИ ПОКА
Dialogue: 0,0:08:55.05,0:08:57.85,Caption,,0,0,0,,ЛИШЬ УДОБНЫМ ЛИЦОМ ДЛЯ ГУМАНИТАРНОЙ ЧАСТИ СДЕЛКИ.
Dialogue: 0,0:08:58.99,0:09:01.85,Caption,,0,0,0,,А ТЕПЕРЬ СНОВА ПОСМОТРИМ НА ЗЕЛЕНСКОГО. ОН ЯЗВИТ
Dialogue: 0,0:09:01.85,0:09:03.61,Caption,,0,0,0,,В АДРЕС ТРАМПА ПЕРЕД ЕВРОПЕЙЦАМИ,
Dialogue: 0,0:09:03.85,0:09:06.41,Caption,,0,0,0,,ЕГО ВЫСКАЗЫВАНИЯ ПЕРЕСКАЗЫВАЮТ ПУТИНУ АМЕРИКАНСКИЕ
Dialogue: 0,0:09:06.41,0:09:09.85,Caption,,0,0,0,,ПРЕДСТАВИТЕЛИ, УИТКОФФ СОБИРАЕТСЯ СКЛОНЯТЬ КИЕВ К ВЫБРАННОМУ
Dialogue: 0,0:09:09.85,0:09:12.73,Caption,,0,0,0,,ВАРИАНТУ ЗАВЕРШЕНИЯ КОНФЛИКТА. И ОДНОВРЕМЕННО РЯДОМ
Dialogue: 0,0:09:12.81,0:09:15.53,Caption,,0,0,0,,С АМЕРИКАНСКОЙ АДМИНИСТРАЦИЕЙ ВОЗНИКАЕТ ЛУБИНЕЦ,
Dialogue: 0,0:09:15.73,0:09:20.97,Caption,,0,0,0,,СПОКОЙНЫЙ, НЕВОЕННЫЙ, УДОБНЫЙ ДЛЯ ОБРАЗА НОВОЙ УКРАИНЫ. ЧЕМ ТИШЕ ОН
Dialogue: 0,0:09:21.05,0:09:23.69,Caption,,0,0,0,,ВЫГЛЯДИТ, ТЕМ ПРОЩЕ ПРЕДСТАВИТЬ ЕГО ЧЕЛОВЕКОМ,
Dialogue: 0,0:09:23.85,0:09:26.17,Caption,,0,0,0,,ПРИШЕДШИМ НЕ ПРОДОЛЖАТЬ СТАРУЮ СХВАТКУ,
Dialogue: 0,0:09:26.40,0:09:31.05,Caption,,0,0,0,,А ЗАКРЫВАТЬ ЕЁ ПОСЛЕДСТВИЯ. ОТСЮДА ДЛЯ ЗЕЛЕНСКОГО ВЫРАСТАЕТ ВОПРОС ПОХУЖЕ
Dialogue: 0,0:09:31.05,0:09:33.93,Caption,,0,0,0,,АМЕРИКАНСКОЙ ОБИДЫ. НАСКОЛЬКО ВООБЩЕ ВАШИНГТОНУ
Dialogue: 0,0:09:33.93,0:09:36.25,Caption,,0,0,0,,НЕОБХОДИМО СОХРАНЯТЬ ИМЕННО ЕГО,
Dialogue: 0,0:09:36.41,0:09:38.89,Caption,,0,0,0,,ЕСЛИ НУЖНЫЙ ПОВОРОТ МОЖНО ПРОВЕСТИ ЧЕРЕЗ ДРУГУЮ
Dialogue: 0,0:09:38.89,0:09:44.46,Caption,,0,0,0,,ФИГУРУ? СПОРЫ ОБ УСЛОВИЯХ ЗАВЕРШЕНИЯ КОНФЛИКТА СПОСОБНЫ
Dialogue: 0,0:09:44.46,0:09:47.10,Caption,,0,0,0,,ТЯНУТЬСЯ ДОЛГО ТЕРРИТОРИИ, ГАРАНТИИ,
Dialogue: 0,0:09:47.21,0:09:51.82,Caption,,0,0,0,,САНКЦИИ, ПОДПИСИ. НО СМЕНУ НАПРАВЛЕНИЯ НЕ ПОКАЗАТЬ ОДНОЙ ПАПКОЙ НА
Dialogue: 0,0:09:51.82,0:09:54.30,Caption,,0,0,0,,СТОЛЕ, ЗРИТЕЛЮ НУЖЕН НОВЫЙ ГЕРОЙ,
Dialogue: 0,0:09:54.54,0:09:59.66,Caption,,0,0,0,,ЧЬЁ ПОЯВЛЕНИЕ САМО ОБЪЯСНЯЕТ, ЧТО ПРЕЖНЯЯ КОМАНДА УХОДИТ ВМЕСТЕ СО СВОИМ КУРСОМ.
Dialogue: 0,0:10:00.46,0:10:02.62,Caption,,0,0,0,,ЕСЛИ СОЕДИНЁННЫЕ ШТАТЫ ПРИДУТ К ВЫВОДУ,
Dialogue: 0,0:10:02.78,0:10:07.90,Caption,,0,0,0,,ЧТО ЗЕЛЕНСКИЙ СТАЛ ПОМЕХОЙ, ЕГО СЕГОДНЯШНЯЯ ДЕРЗОСТЬ ЗАИГРАЕТ НОВЫМИ КРАСКАМИ.
Dialogue: 0,0:10:08.29,0:10:11.90,Caption,,0,0,0,,ОН ДУМАЕТ, ЧТО ВЫДЕРЖИВАЕТ ДАВЛЕНИЕ ТРАМПА И СОХРАНЯЕТ
Dialogue: 0,0:10:11.90,0:10:14.54,Caption,,0,0,0,,НЕЗАВИСИМОСТЬ. А СО СТОРОНЫ ЭТО МОЖЕТ ВЫГЛЯДЕТЬ КАК
Dialogue: 0,0:10:14.62,0:10:17.74,Caption,,0,0,0,,ЧЕЛОВЕК, КОТОРЫЙ СПОРИТ О ПРАВЕ ОСТАТЬСЯ В КОМНАТЕ,
Dialogue: 0,0:10:17.90,0:10:20.38,Caption,,0,0,0,,ПОКА ЗА ДВЕРЬЮ УЖЕ ПРИМЕРЯЮТ КЛЮЧ К ДРУГОМУ
Dialogue: 0,0:10:20.46,0:10:23.90,Caption,,0,0,0,,ВЛАДЕЛЬЦУ. САМОЕ НЕПРИЯТНОЕ ДЛЯ ЗЕЛЕНСКОГО В ТОМ,
Dialogue: 0,0:10:24.06,0:10:26.70,Caption,,0,0,0,,ЧТО ВАШИНГТОНУ НЕ ТРЕБУЕТСЯ ВЫРАЩИВАТЬ НОВОГО
Dialogue: 0,0:10:26.78,0:10:29.34,Caption,,0,0,0,,НАЦИОНАЛЬНОГО ВОЖДЯ. ДОСТАТОЧНО ЧЕЛОВЕКА,
Dialogue: 0,0:10:29.71,0:10:32.30,Caption,,0,0,0,,КОТОРЫЙ СВОИМ СПОКОЙНЫМ ВИДОМ СООБЩИТ СТРАНЕ,
Dialogue: 0,0:10:32.53,0:10:35.34,Caption,,0,0,0,,ЧТО ВРЕМЯ ПРЕЖНИХ РУКОВОДИТЕЛЕЙ ЗАКОНЧИЛОСЬ БЕЗ
Dialogue: 0,0:10:35.34,0:10:40.14,Caption,,0,0,0,,ТЕАТРАЛЬНОЙ ПОХОДКИ, БЕЗ ВОЕННОГО КИТЕЛЯ И БЕЗ ЕЖЕДНЕВНОГО КОНКУРСА НА
Dialogue: 0,0:10:40.14,0:10:44.30,Caption,,0,0,0,,САМУЮ ГРОЗНУЮ ФРАЗУ. ТАКОЙ ЧЕЛОВЕК УЖЕ ПОБЫВАЛ В БЕЛОМ ДОМЕ,
Dialogue: 0,0:10:44.54,0:10:47.26,Caption,,0,0,0,,СТОЯЛ РЯДОМ С МЕЛАНИЕЙ ТРАМП И ПОЛУЧИЛ ОТ
Dialogue: 0,0:10:47.26,0:10:50.22,Caption,,0,0,0,,НЕЁ ОТДЕЛЬНУЮ БЛАГОДАРНОСТЬ. ПОЭТОМУ ДЕЛО УЖЕ НЕ
Dialogue: 0,0:10:50.22,0:10:54.06,Caption,,0,0,0,,СВОДИТСЯ К ТОМУ, НАСКОЛЬКО БОЛЕЗНЕННО ТРАМП ВОСПРИНЯЛ ШУТКИ
Dialogue: 0,0:10:54.06,0:10:57.82,Caption,,0,0,0,,ЗЕЛЕНСКОГО. НАСТОЯЩИЙ РИСК ДЛЯ КИЕВА КУДА СЕРЬЁЗНЕЕ.
Dialogue: 0,0:11:00.10,0:11:02.50,Caption,,0,0,0,,АМЕРИКАНСКИЙ ПРЕЗИДЕНТ МОЖЕТ НЕ ТРАТИТЬ ВРЕМЯ НА
Dialogue: 0,0:11:02.50,0:11:05.54,Caption,,0,0,0,,ОТВЕТНУЮ КОЛКОСТЬ И ПРОСТО ПОДДЕРЖАТЬ ДРУГУЮ ФИГУРУ.
Dialogue: 0,0:11:05.93,0:11:10.10,Caption,,0,0,0,,И ТОГДА ДОКУМЕНТ, КОТОРЫЙ ЗЕЛЕНСКИЙ НАЗВАЛ БЫ КАПИТУЛЯЦИЕЙ И ОТКАЗАЛСЯ
Dialogue: 0,0:11:10.10,0:11:13.94,Caption,,0,0,0,,ПОДПИСЫВАТЬ, ПОЛОЖАТ ПЕРЕД ДМИТРИЕМ ЛУБИНЦОМ. А ЗЕЛЕНСКОМУ
Dialogue: 0,0:11:14.02,0:11:18.42,Caption,,0,0,0,,ОСТАНЕТСЯ ОБЪЯСНЯТЬ, ПОЧЕМУ ЕГО ЧУВСТВО ЮМОРА ПЕРЕЖИЛО ПРЕЗИДЕНТСТВО,
Dialogue: 0,0:11:18.58,0:11:19.46,Caption,,0,0,0,,А ОН САМ НЕТ.
