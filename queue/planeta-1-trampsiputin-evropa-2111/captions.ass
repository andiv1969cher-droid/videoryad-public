Dialogue: 0,0:00:00.12,0:00:03.08,Caption,,0,0,0,,ТРАМП ГОВОРИТ О ПУТИНЕ МОЙ ДРУГ. СИ ЦЗИНЬПИН
Dialogue: 0,0:00:03.08,0:00:06.12,Caption,,0,0,0,,ПРОВОЖАЕТ РОССИЙСКОГО ПРЕЗИДЕНТА ЛИЧНО. ВОКРУГ
Dialogue: 0,0:00:06.12,0:00:09.64,Caption,,0,0,0,,УЛЫБКИ, РУКОПОЖАТИЯ И ТАКАЯ ТЁПЛАЯ АТМОСФЕРА,
Dialogue: 0,0:00:09.80,0:00:12.36,Caption,,0,0,0,,ЧТО НЕ ХВАТАЕТ ТОЛЬКО ОБЩЕГО СЕМЕЙНОГО АЛЬБОМА.
Dialogue: 0,0:00:12.82,0:00:16.20,Caption,,0,0,0,,ПРАВДА, РЯДОМ С ПУТИНЫМ ПУТЕШЕСТВУЕТ ЯДЕРНЫЙ ЧЕМОДАНЧИК.
Dialogue: 0,0:00:16.58,0:00:18.36,Caption,,0,0,0,,ПОЛЕЗНАЯ ВЕЩЬ НА ВСТРЕЧЕ ДРУЗЕЙ,
Dialogue: 0,0:00:18.60,0:00:21.24,Caption,,0,0,0,,ОСОБЕННО КОГДА КАЖДЫЙ ИЗ НИХ СПОСОБЕН ЗА НЕСКОЛЬКО
Dialogue: 0,0:00:21.32,0:00:24.36,Caption,,0,0,0,,МИНУТ ИСПОРТИТЬ НАСТРОЕНИЕ ВСЕЙ ПЛАНЕТЕ. И ИМЕННО В
Dialogue: 0,0:00:24.36,0:00:26.44,Caption,,0,0,0,,ЭТОЙ ОБСТАНОВКЕ ПРОЗВУЧАЛА ИДЕЯ,
Dialogue: 0,0:00:26.68,0:00:29.40,Caption,,0,0,0,,ПОСЛЕ КОТОРОЙ РАЗГОВОРЫ О ДОВЕРИИ ЗАИГРАЛИ СОВСЕМ
Dialogue: 0,0:00:29.40,0:00:32.04,Caption,,0,0,0,,ДРУГИМИ КРАСКАМИ. ЕСЛИ ВАМ ИНТЕРЕСНЫ НЕ САМИ
Dialogue: 0,0:00:32.04,0:00:34.52,Caption,,0,0,0,,ЗАГОЛОВКИ, А ТО, ЧТО ЗА НИМИ СТОИТ,
Dialogue: 0,0:00:34.67,0:00:37.24,Caption,,0,0,0,,ПОДПИШИТЕСЬ. ЗДЕСЬ КАК РАЗ ТОТ СЛУЧАЙ,
Dialogue: 0,0:00:37.47,0:00:40.36,Caption,,0,0,0,,КОГДА САМОЕ ВАЖНОЕ НАЧИНАЕТСЯ ПОСЛЕ ОФИЦИАЛЬНОЙ
Dialogue: 0,0:00:40.36,0:00:43.56,Caption,,0,0,0,,ЧАСТИ. РАДОСЛАВ СИКОРСКИ ОЧЕНЬ НЕДОВОЛЕН САМИМ
Dialogue: 0,0:00:43.64,0:00:46.52,Caption,,0,0,0,,СОСТАВОМ ВСТРЕЧИ. РОССИЯ, ПО ЕГО СЛОВАМ,
Dialogue: 0,0:00:46.68,0:00:50.52,Caption,,0,0,0,,ЭКОНОМИЧЕСКИЙ КАРЛИК, А ЕЁ ЗАЧЕМ ТО ПОСАДИЛИ РЯДОМ С СОЕДИНЁННЫМИ
Dialogue: 0,0:00:50.52,0:00:55.40,Caption,,0,0,0,,ШТАТАМИ И КИТАЕМ, СЛОВНО ЭТО РАВНАЯ ИМ МИРОВАЯ ДЕРЖАВА. ЗАМЕЧАТЕЛЬНО.
Dialogue: 0,0:00:55.88,0:00:58.68,Caption,,0,0,0,,НО ТОГДА ВОЗНИКАЕТ ПРОСТОЙ ВОПРОС. ЕСЛИ ЕВРОПЕЙЦЫ
Dialogue: 0,0:00:58.68,0:01:00.92,Caption,,0,0,0,,ТАКИЕ МОГУЧИЕ ЭКОНОМИЧЕСКИЕ ВЕЛИКАНЫ,
Dialogue: 0,0:01:01.16,0:01:02.84,Caption,,0,0,0,,ПОЧЕМУ БЕСЕДА ИДЁТ С КАРЛИКОМ,
Dialogue: 0,0:01:03.13,0:01:04.76,Caption,,0,0,0,,А ВЕЛИКАНЫ НАБЛЮДАЮТ ИЗ КОРИДОРА?
Dialogue: 0,0:01:05.21,0:01:09.08,Caption,,0,0,0,,ВИДИМО, РОСТ ИЗМЕРЯЛИ НЕ ТОЙ ЛИНЕЙКОЙ. ЗА СТОЛОМ ОКАЗАЛИСЬ
Dialogue: 0,0:01:09.08,0:01:16.08,Caption,,0,0,0,,МОСКВА, ВАШИНГТОН И ПЕКИН. ЕВРОПЕЙСКИЕ СТОЛИЦЫ ОСТАЛИСЬ СНАРУЖИ И ПРИНЯЛИСЬ
Dialogue: 0,0:01:16.08,0:01:19.44,Caption,,0,0,0,,ДОКАЗЫВАТЬ, ЧТО БЕЗ НИХ НЕЛЬЗЯ ОБСУЖДАТЬ ЕВРОПЕЙСКУЮ
Dialogue: 0,0:01:19.44,0:01:22.64,Caption,,0,0,0,,БЕЗОПАСНОСТЬ. ТОЛЬКО МЕЖДУНАРОДНЫЙ ВЕС СКЛАДЫВАЕТСЯ
Dialogue: 0,0:01:22.72,0:01:25.68,Caption,,0,0,0,,НЕ ИЗ ОДНОЙ ЭКОНОМИКИ. ИМЕЮТ ЗНАЧЕНИЕ ВООРУЖЁННЫЕ
Dialogue: 0,0:01:25.68,0:01:29.52,Caption,,0,0,0,,СИЛЫ, ТЕРРИТОРИЯ, РЕСУРСЫ, ЯДЕРНЫЙ АРСЕНАЛ,
Dialogue: 0,0:01:29.76,0:01:33.04,Caption,,0,0,0,,МЕСТО В СОВЕТЕ БЕЗОПАСНОСТИ ООН И ВОЗМОЖНОСТЬ
Dialogue: 0,0:01:33.04,0:01:35.68,Caption,,0,0,0,,ПРЕВРАТИТЬ ЧУЖОЙ ВЕЛИКОЛЕПНЫЙ ПЛАН В ГРУДУ
Dialogue: 0,0:01:35.76,0:01:38.56,Caption,,0,0,0,,БЕСПОЛЕЗНЫХ БУМАГ. ПРИ ТАКОМ ПОДСЧЁТЕ РОССИЙСКИЙ
Dialogue: 0,0:01:38.56,0:01:42.08,Caption,,0,0,0,,КАРЛИК НЕОЖИДАННО ВЫРАСТАЕТ ДО ПОТОЛКА. МАРК РЮТТЕ,
Dialogue: 0,0:01:42.25,0:01:45.68,Caption,,0,0,0,,КСТАТИ, НЕ СТАЛ ПОДДЕРЖИВАТЬ КОЛЛЕКТИВНОЕ УДИВЛЕНИЕ. ОН
Dialogue: 0,0:01:45.76,0:01:48.08,Caption,,0,0,0,,ПРЯМО ПРИЗНАЛ, ЧТО ВСТРЕЧА РОССИИ,
Dialogue: 0,0:01:48.24,0:01:51.68,Caption,,0,0,0,,СОЕДИНЁННЫХ ШТАТОВ И КИТАЯ ЕСТЕСТВЕННА И НЕОБХОДИМА.
Dialogue: 0,0:01:52.08,0:01:54.40,Caption,,0,0,0,,ПЕРЕД НАМИ КРУПНЕЙШИЕ ЯДЕРНЫЕ ДЕРЖАВЫ,
Dialogue: 0,0:01:54.56,0:01:57.20,Caption,,0,0,0,,ПРИЧЁМ ПЕКИН БЫСТРО РАСШИРЯЕТ СТРАТЕГИЧЕСКИЙ
Dialogue: 0,0:01:57.20,0:02:00.00,Caption,,0,0,0,,ПОТЕНЦИАЛ. ДАЖЕ РУКОВОДИТЕЛЬ НАТО ПОНИМАЕТ,
Dialogue: 0,0:02:00.16,0:02:02.72,Caption,,0,0,0,,ЗАЧЕМ ЭТИМ ГОСУДАРСТВАМ НУЖЕН ПРЯМОЙ РАЗГОВОР.
Dialogue: 0,0:02:03.09,0:02:04.96,Caption,,0,0,0,,ПОНИМАНИЕ ОКАЗАЛОСЬ ДОСТУПНО ВСЕМ,
Dialogue: 0,0:02:05.10,0:02:07.68,Caption,,0,0,0,,КРОМЕ ТЕХ, КТО В ЭТО ВРЕМЯ ПРИМЕРЯЛ НА СЕБЯ РОЛЬ
Dialogue: 0,0:02:07.84,0:02:11.52,Caption,,0,0,0,,НЕЗАСЛУЖЕННО ЗАБЫТОГО ХОЗЯИНА БАНКЕТА. НИКАКОЙ ЯЛТЫ
Dialogue: 0,0:02:11.60,0:02:14.08,Caption,,0,0,0,,ДВА НОЛЬ ПОКА НЕ СЛУЧИЛОСЬ. ЗЕМНОЙ ШАР НА
Dialogue: 0,0:02:14.16,0:02:17.52,Caption,,0,0,0,,ТРОИХ НЕ РАСКРАСИЛИ, СФЕРЫ ВЛИЯНИЯ КАРАНДАШОМ НЕ ОБВЕЛИ,
Dialogue: 0,0:02:17.69,0:02:20.24,Caption,,0,0,0,,ОСТАЛЬНЫХ ПОДПИСЫВАТЬ ГОТОВОЕ РЕШЕНИЕ НЕ ПОЗВАЛИ.
Dialogue: 0,0:02:20.78,0:02:24.32,Caption,,0,0,0,,ОДНАКО ПЕРВЫЕ КОНТУРЫ ПОЯВИЛИСЬ. ОНИ ЗАМЕТНЫ НЕ ПО
Dialogue: 0,0:02:24.32,0:02:26.80,Caption,,0,0,0,,ЦЕРЕМОНИАЛЬНЫМ СНИМКАМ, А ПО ВОПРОСАМ,
Dialogue: 0,0:02:27.03,0:02:29.28,Caption,,0,0,0,,КОТОРЫЕ ТРИ ДЕРЖАВЫ ВКЛЮЧИЛИ В СОВМЕСТНУЮ
Dialogue: 0,0:02:29.36,0:02:34.68,Caption,,0,0,0,,ДЕКЛАРАЦИЮ. ФОТОГРАФИЯ ЗАКАНЧИВАЕТСЯ ПОСЛЕ ЩЕЛЧКА КАМЕРЫ,
Dialogue: 0,0:02:34.93,0:02:38.36,Caption,,0,0,0,,А СОГЛАСОВАННАЯ ТЕМА МОЖЕТ ПОТОМ ГОДАМИ ПОРТИТЬ КОМУ
Dialogue: 0,0:02:38.36,0:02:43.24,Caption,,0,0,0,,НИБУДЬ СОН. ОСОБЕННО ЗАНЯТЕН ПУНКТ О РЕФОРМИРОВАНИИ ООН. С ТАКОЙ
Dialogue: 0,0:02:43.24,0:02:48.60,Caption,,0,0,0,,ИНИЦИАТИВОЙ ВЫСТУПАЮТ РОССИЯ, СОЕДИНЁННЫЕ ШТАТЫ И КИТАЙ. И ТУТ ХОЧЕТСЯ ПЕРЕСЧИТАТЬ
Dialogue: 0,0:02:48.60,0:02:51.64,Caption,,0,0,0,,СТУЛЬЯ. ФРАНЦИЯ ГДЕ? ВЕЛИКОБРИТАНИЯ ГДЕ?
Dialogue: 0,0:02:52.07,0:02:54.76,Caption,,0,0,0,,ОБЕ СТРАНЫ ЯВЛЯЮТСЯ ПОСТОЯННЫМИ ЧЛЕНАМИ СОВЕТА
Dialogue: 0,0:02:54.76,0:02:57.72,Caption,,0,0,0,,БЕЗОПАСНОСТИ И ОБЛАДАЮТ ПРАВОМ ВЕТО. В
Dialogue: 0,0:02:57.72,0:03:00.12,Caption,,0,0,0,,ПРИВИЛЕГИРОВАННОЙ ПЯТЁРКЕ ВСЕГО ПЯТЬ ГОСУДАРСТВ,
Dialogue: 0,0:03:00.37,0:03:02.76,Caption,,0,0,0,,НО ТРОЕ УЖЕ ОБСУЖДАЮТ УСТРОЙСТВО КЛУБА,
Dialogue: 0,0:03:02.97,0:03:05.64,Caption,,0,0,0,,НЕ ПРИГЛАСИВ ДВУХ ДРУГИХ. ПОЛУЧАЕТСЯ ЗАБАВНАЯ
Dialogue: 0,0:03:05.64,0:03:08.84,Caption,,0,0,0,,АРИФМЕТИКА. РОССИЯ ОБЪЯВЛЕНА СИКОРСКИМ КАРЛИКОМ,
Dialogue: 0,0:03:09.01,0:03:12.12,Caption,,0,0,0,,ОДНАКО УЧАСТВУЕТ В РАЗГОВОРЕ. ПАРИЖ И ЛОНДОН ИМЕЮТ
Dialogue: 0,0:03:12.12,0:03:14.52,Caption,,0,0,0,,ОФИЦИАЛЬНЫЙ СТАТУС, ЯДЕРНОЕ ОРУЖИЕ,
Dialogue: 0,0:03:14.76,0:03:17.48,Caption,,0,0,0,,ПОСТОЯННЫЕ МЕСТА И ПРАВО БЛОКИРОВАТЬ РЕШЕНИЯ,
Dialogue: 0,0:03:17.80,0:03:20.68,Caption,,0,0,0,,НО ИХ МНЕНИЕМ НА ЭТОМ ЭТАПЕ НЕ ПОИНТЕРЕСОВАЛИСЬ.
Dialogue: 0,0:03:20.89,0:03:22.92,Caption,,0,0,0,,ТАБЛИЧКА НА ДВЕРИ У НИХ БЕССРОЧНАЯ,
Dialogue: 0,0:03:23.09,0:03:25.56,Caption,,0,0,0,,А КРЕСЛО ЗА НУЖНЫМ СТОЛОМ, ОКАЗЫВАЕТСЯ,
Dialogue: 0,0:03:25.72,0:03:28.60,Caption,,0,0,0,,ВЫДАЁТСЯ ПО ОБСТОЯТЕЛЬСТВАМ. ОЧЕНЬ НЕПРИЯТНОЕ
Dialogue: 0,0:03:28.60,0:03:31.32,Caption,,0,0,0,,ОТКРЫТИЕ ДЛЯ ВЛАДЕЛЬЦЕВ ТАБЛИЧЕК. РЕЧЬ УЖЕ НЕ О
Dialogue: 0,0:03:31.32,0:03:34.68,Caption,,0,0,0,,ТОМ, КТО НА КОГО ОБИДЕЛСЯ. ТРИ ГОСУДАРСТВА НАЧАЛИ
Dialogue: 0,0:03:34.68,0:03:38.68,Caption,,0,0,0,,ВЫЯСНЯТЬ, КАК ДОЛЖНА МЕНЯТЬСЯ ООН И НА КАКИЕ УГРОЗЫ
Dialogue: 0,0:03:38.68,0:03:41.96,Caption,,0,0,0,,ОНА ОБЯЗАНА ОТВЕЧАТЬ. ЭТО ЛОМАЕТ УДОБНОЕ ПРАВИЛО,
Dialogue: 0,0:03:42.12,0:03:44.44,Caption,,0,0,0,,ПО КОТОРОМУ СТАРОЕ ЗВАНИЕ БУДТО БЫ НАВСЕГДА
Dialogue: 0,0:03:44.44,0:03:46.36,Caption,,0,0,0,,ОБЕСПЕЧИВАЕТ НАСТОЯЩЕЕ ВЛИЯНИЕ.
Dialogue: 0,0:03:48.64,0:03:51.44,Caption,,0,0,0,,МОЖНО ДЕСЯТИЛЕТИЯМИ ЗАНИМАТЬ ПОЧЁТНОЕ МЕСТО,
Dialogue: 0,0:03:51.72,0:03:54.24,Caption,,0,0,0,,ТОРЖЕСТВЕННО ПОДНИМАТЬ РУКУ ПРИ ГОЛОСОВАНИИ,
Dialogue: 0,0:03:54.55,0:03:58.64,Caption,,0,0,0,,А ОДНАЖДЫ УЗНАТЬ, ЧТО ГЛАВНЫЙ РАЗГОВОР ПРОШЁЛ В ДРУГОЙ КОМНАТЕ.
Dialogue: 0,0:03:59.76,0:04:01.68,Caption,,0,0,0,,ДАЛЬШЕ УЧАСТНИКИ САММИТА ДОБРАЛИСЬ ДО
Dialogue: 0,0:04:01.68,0:04:03.44,Caption,,0,0,0,,ГОСУДАРСТВЕННОГО СУВЕРЕНИТЕТА,
Dialogue: 0,0:04:03.66,0:04:06.08,Caption,,0,0,0,,ИММУНИТЕТОВ ДОЛЖНОСТНЫХ ЛИЦ И ПОЛНОМОЧИЙ
Dialogue: 0,0:04:06.08,0:04:09.36,Caption,,0,0,0,,МЕЖДУНАРОДНОГО УГОЛОВНОГО СУДА. ОБЩИЙ СМЫСЛ ПОНЯТЕН
Dialogue: 0,0:04:09.37,0:04:12.24,Caption,,0,0,0,,МЕЖДУНАРОДНЫЕ ОРГАНЫ НЕ ДОЛЖНЫ РАСШИРЯТЬ СОБСТВЕННУЮ
Dialogue: 0,0:04:12.32,0:04:15.20,Caption,,0,0,0,,ВЛАСТЬ ДО БЕСКОНЕЧНОСТИ И ОБРАЩАТЬСЯ С ГОСУДАРСТВАМИ
Dialogue: 0,0:04:15.20,0:04:17.92,Caption,,0,0,0,,КАК С ПОДЧИНЁННЫМИ ОТДЕЛАМИ. ОБ ЭТОМ ЖЕ ГОВОРИЛ
Dialogue: 0,0:04:17.92,0:04:20.72,Caption,,0,0,0,,ТРАМП, КОГДА ВЫСТУПАЛ ПРОТИВ ГЛОБАЛИСТСКИХ СТРУКТУР,
Dialogue: 0,0:04:21.04,0:04:22.72,Caption,,0,0,0,,КОТОРЫЕ ДАВНО ПЕРЕСТАЛИ ПОМНИТЬ,
Dialogue: 0,0:04:22.87,0:04:27.60,Caption,,0,0,0,,КТО ИХ СОЗДАВАЛ И ДЛЯ ЧЕГО. ТАКОЕ РАЗДРАЖАЕТ НЕ ТОЛЬКО РОССИЮ ИЛИ СОЕДИНЁННЫЕ
Dialogue: 0,0:04:27.60,0:04:30.24,Caption,,0,0,0,,ШТАТЫ. КИТАЙ ОТНОСИТСЯ К СУВЕРЕНИТЕТУ ПОЧТИ
Dialogue: 0,0:04:30.24,0:04:32.72,Caption,,0,0,0,,БОЛЕЗНЕННО И НЕ СОБИРАЕТСЯ ОТДАВАТЬ ВНЕШНИМ
Dialogue: 0,0:04:32.80,0:04:34.88,Caption,,0,0,0,,СТРУКТУРАМ ДОСТУП К ЧУВСТВИТЕЛЬНЫМ ВНУТРЕННИМ
Dialogue: 0,0:04:34.96,0:04:38.48,Caption,,0,0,0,,ВОПРОСАМ. ДЛЯ ПЕКИНА ПОДОБНАЯ ОПЕКА ВЫГЛЯДИТ КАК ВИЗИТ
Dialogue: 0,0:04:38.48,0:04:41.68,Caption,,0,0,0,,НЕЗНАКОМЦА, КОТОРЫЙ БЕЗ ПРИГЛАШЕНИЯ ОТКРЫЛ ВАШУ ДВЕРЬ,
Dialogue: 0,0:04:41.84,0:04:44.00,Caption,,0,0,0,,ЗАГЛЯНУЛ В ХОЛОДИЛЬНИК И НАЧАЛ ОБЪЯСНЯТЬ,
Dialogue: 0,0:04:44.14,0:04:47.44,Caption,,0,0,0,,КАКИЕ ПРОДУКТЫ ВАМ РАЗРЕШЕНО ПОКУПАТЬ. ПРОВОДИТЬ ЕГО
Dialogue: 0,0:04:47.44,0:04:50.40,Caption,,0,0,0,,ПОПРОСЯТ БЫСТРО И БЕЗ ЧАЯ. ЕСЛИ ГОВОРИТЬ БЕЗ
Dialogue: 0,0:04:50.40,0:04:55.12,Caption,,0,0,0,,ПРИЛИЗАННЫХ ФОРМУЛИРОВОК, РЕЧЬ ИДЁТ ПРО ОФИГЕВШИЕ ГЛОБАЛИСТИЧЕСКИЕ НАДСТРОЙКИ,
Dialogue: 0,0:04:55.35,0:04:57.68,Caption,,0,0,0,,НАДГОСУДАРСТВЕННЫЕ И УЖЕ ПОЧТИ НИКЕМ НЕ
Dialogue: 0,0:04:57.68,0:05:03.56,Caption,,0,0,0,,КОНТРОЛИРУЕМЫЕ. МЕЖДУНАРОДНЫЙ УГОЛОВНЫЙ СУД НИКУДА МГНОВЕННО НЕ
Dialogue: 0,0:05:03.64,0:05:06.52,Caption,,0,0,0,,ДЕНЕТСЯ. ДРУГИЕ ИНСТИТУТЫ ТОЖЕ НЕ ЗАКРОЮТСЯ ПОСЛЕ
Dialogue: 0,0:05:06.52,0:05:09.72,Caption,,0,0,0,,ОДНОЙ ДЕКЛАРАЦИИ. НО ТРИ КРУПНЫЕ ДЕРЖАВЫ НАЗВАЛИ
Dialogue: 0,0:05:09.72,0:05:13.00,Caption,,0,0,0,,ОДНУ И ТУ ЖЕ ПРОБЛЕМУ ОБСЛУЖИВАЮЩАЯ КОНСТРУКЦИЯ НЕ
Dialogue: 0,0:05:13.00,0:05:15.32,Caption,,0,0,0,,МОЖЕТ САМА НАЗНАЧИТЬ СЕБЯ НАЧАЛЬНИКОМ НАД
Dialogue: 0,0:05:15.32,0:05:18.76,Caption,,0,0,0,,ГОСУДАРСТВАМИ. ДЛЯ ЕВРОСОЮЗА ЭТО ОСОБЕННО НЕУДОБНАЯ
Dialogue: 0,0:05:18.76,0:05:21.80,Caption,,0,0,0,,ЛИНИЯ. ЕВРОПЕЙСКАЯ СИСТЕМА ДЕСЯТИЛЕТИЯМИ ПЕРЕДАВАЛА
Dialogue: 0,0:05:21.80,0:05:24.28,Caption,,0,0,0,,ПОЛНОМОЧИЯ С НАЦИОНАЛЬНОГО УРОВНЯ В БРЮССЕЛЬ,
Dialogue: 0,0:05:24.36,0:05:27.88,Caption,,0,0,0,,ОБЩИЕ ОРГАНЫ И НАДНАЦИОНАЛЬНЫЕ МЕХАНИЗМЫ. ТЕПЕРЬ
Dialogue: 0,0:05:28.12,0:05:30.36,Caption,,0,0,0,,РЯДОМ ФОРМИРУЕТСЯ ПРОТИВОПОЛОЖНЫЙ ПОДХОД.
Dialogue: 0,0:05:30.68,0:05:32.92,Caption,,0,0,0,,ГОСУДАРСТВО ОСТАЁТСЯ ГЛАВНОЙ ЕДИНИЦЕЙ,
Dialogue: 0,0:05:33.24,0:05:36.04,Caption,,0,0,0,,А ВНЕШНИЕ ИНСТИТУТЫ ОБЯЗАНЫ ЗНАТЬ ПРЕДЕЛЫ СВОЕЙ
Dialogue: 0,0:05:36.04,0:05:39.08,Caption,,0,0,0,,ВЛАСТИ. БРЮССЕЛЬ ПРИВЫК ПОДНИМАТЬ ПОЛНОМОЧИЯ НАВЕРХ,
Dialogue: 0,0:05:39.31,0:05:41.48,Caption,,0,0,0,,А БОЛЬШАЯ ТРОЙКА ПРЕДЛАГАЕТ ПРОВЕРИТЬ,
Dialogue: 0,0:05:41.72,0:05:43.88,Caption,,0,0,0,,НЕ УНЕСЛИ ЛИ НАВЕРХ ВМЕСТЕ С НИМИ КРЫШУ.
Dialogue: 0,0:05:44.11,0:05:46.52,Caption,,0,0,0,,ПОЭТОМУ ССЫЛКА СИКОРСКОГО НА РАЗМЕР РОССИЙСКОЙ
Dialogue: 0,0:05:46.60,0:05:49.72,Caption,,0,0,0,,ЭКОНОМИКИ МАЛО ЧТО ОБЪЯСНЯЕТ. ЕСЛИ УЧАСТНИКИ РЕШАЮТ,
Dialogue: 0,0:05:50.04,0:05:53.16,Caption,,0,0,0,,КТО УСТАНАВЛИВАЕТ ГРАНИЦЫ ДЛЯ МЕЖДУНАРОДНЫХ СУДОВ И
Dialogue: 0,0:05:53.16,0:05:55.40,Caption,,0,0,0,,КАК ЗАЩИЩАЮТСЯ ПОЛНОМОЧИЯ ГОСУДАРСТВ,
Dialogue: 0,0:05:55.79,0:05:59.40,Caption,,0,0,0,,ОДНОГО БОЛЬШОГО ВВП НЕДОСТАТОЧНО. НА ТАКОЙ ВСТРЕЧЕ
Dialogue: 0,0:05:59.48,0:06:01.96,Caption,,0,0,0,,СМОТРЯТ НЕ ТОЛЬКО НА ТОЛЩИНУ КОШЕЛЬКА. ИНОГДА
Dialogue: 0,0:06:01.96,0:06:04.76,Caption,,0,0,0,,ВАЖНЕЕ, КТО СПОСОБЕН НЕ ОПЛАТИТЬ ОБЩИЙ УЖИН,
Dialogue: 0,0:06:04.92,0:06:07.96,Caption,,0,0,0,,А ЗАКРЫТЬ РЕСТОРАН. С ЕДИНОЙ ЕВРОПЕЙСКОЙ ПОЗИЦИЕЙ
Dialogue: 0,0:06:08.04,0:06:10.92,Caption,,0,0,0,,ТОЖЕ НЕ СЛОЖИЛОСЬ. МЕТТЕ ФРЕДЕРИКСЕН ПРИЗЫВАЕТ НЕ
Dialogue: 0,0:06:10.92,0:06:13.48,Caption,,0,0,0,,ПРИНИМАТЬ РОССИЙСКИЕ ТРЕБОВАНИЯ ПО БЕЗОПАСНОСТИ.
Dialogue: 0,0:06:15.76,0:06:19.04,Caption,,0,0,0,,СИКОРСКИ ВОЗМУЩЁН СОСТАВОМ УЧАСТНИКОВ. РЮТТЕ СЧИТАЕТ
Dialogue: 0,0:06:19.12,0:06:21.68,Caption,,0,0,0,,САМ РАЗГОВОР НЕОБХОДИМЫМ. ФРАНЦИЯ,
Dialogue: 0,0:06:21.76,0:06:24.96,Caption,,0,0,0,,ГЕРМАНИЯ И ВЕЛИКОБРИТАНИЯ ОДНОВРЕМЕННО ОБСУЖДАЮТ
Dialogue: 0,0:06:25.04,0:06:28.00,Caption,,0,0,0,,ПРЯМЫЕ КОНТАКТЫ С МОСКВОЙ. АНСАМБЛЬ ВЫШЕЛ ШУМНЫЙ
Dialogue: 0,0:06:28.08,0:06:31.04,Caption,,0,0,0,,ОДИН НАЧИНАЕТ ПРИПЕВ, ВТОРОЙ ПОЁТ ДРУГУЮ ПЕСНЮ,
Dialogue: 0,0:06:31.20,0:06:35.52,Caption,,0,0,0,,ТРЕТИЙ ВНЕЗАПНО ОБНАРУЖИВАЕТ, ЧТО ДИРИЖЁР ВООБЩЕ НАХОДИТСЯ В СОСЕДНЕМ ЗДАНИИ.
Dialogue: 0,0:06:36.07,0:06:38.40,Caption,,0,0,0,,МОСКВА МЕЖДУ ТЕМ ПОДНИМАЕТ ВОПРОС НЕ ТОЛЬКО ОБ
Dialogue: 0,0:06:38.40,0:06:41.04,Caption,,0,0,0,,УКРАИНЕ. ПУТИН ГОВОРИТ О ТРЕБОВАНИЯХ РОССИИ К
Dialogue: 0,0:06:41.04,0:06:44.16,Caption,,0,0,0,,УСТРОЙСТВУ БЕЗОПАСНОСТИ ВСЕЙ ЕВРОПЫ. ФРЕДЕРИКСЕН
Dialogue: 0,0:06:44.24,0:06:46.40,Caption,,0,0,0,,ФАКТИЧЕСКИ ПОДТВЕРЖДАЕТ МАСШТАБ ТЕМЫ,
Dialogue: 0,0:06:46.58,0:06:50.40,Caption,,0,0,0,,КОГДА ЗАМЕЧАЕТ, ЧТО РОССИЙСКИЕ УСЛОВИЯ ВЫХОДЯТ ДАЛЕКО ЗА ПРЕДЕЛЫ
Dialogue: 0,0:06:50.40,0:06:55.52,Caption,,0,0,0,,УКРАИНСКОГО КОНФЛИКТА. ДОНБАСС ОСТАЁТСЯ ЦЕНТРАЛЬНЫМ И КРАЙНЕ ТЯЖЁЛЫМ УЗЛОМ,
Dialogue: 0,0:06:55.76,0:06:58.40,Caption,,0,0,0,,НО ВСЯ КОНСТРУКЦИЯ К НЕМУ НЕ СВОДИТСЯ. РОССИЙСКАЯ
Dialogue: 0,0:06:58.40,0:07:01.52,Caption,,0,0,0,,ПОЗИЦИЯ МНОГО ЛЕТ КАСАЕТСЯ РАЗМЕЩЕНИЯ ИНФРАСТРУКТУРЫ
Dialogue: 0,0:07:01.52,0:07:04.16,Caption,,0,0,0,,НАТО, РАСШИРЕНИЯ ВОЕННОГО ПРИСУТСТВИЯ,
Dialogue: 0,0:07:04.24,0:07:09.04,Caption,,0,0,0,,БАЗ, РАКЕТ, ВОЙСК И СРЕДСТВ ПОРАЖЕНИЯ. УКРАИНА ЗАНИМАЕТ В ЭТОМ
Dialogue: 0,0:07:09.04,0:07:13.92,Caption,,0,0,0,,СПОРЕ ОГРОМНОЕ МЕСТО, ОДНАКО НЕ ИСЧЕРПЫВАЕТ ЕГО. ДАЖЕ ЕСЛИ ОДНАЖДЫ БУДЕТ
Dialogue: 0,0:07:13.92,0:07:15.60,Caption,,0,0,0,,НАЙДЕНО РЕШЕНИЕ ПО ТЕРРИТОРИЯМ,
Dialogue: 0,0:07:15.84,0:07:19.36,Caption,,0,0,0,,СЛЕДУЮЩИЙ ВОПРОС УЖЕ ЖДЁТ У ДВЕРИ. ГДЕ ЗАКАНЧИВАЕТСЯ
Dialogue: 0,0:07:19.36,0:07:22.16,Caption,,0,0,0,,ИНФРАСТРУКТУРА АЛЬЯНСА И НАЧИНАЕТСЯ ЗОНА,
Dialogue: 0,0:07:22.40,0:07:25.28,Caption,,0,0,0,,КОТОРУЮ МОСКВА СЧИТАЕТ ПРЯМОЙ УГРОЗОЙ СОБСТВЕННОЙ
Dialogue: 0,0:07:25.28,0:07:28.00,Caption,,0,0,0,,БЕЗОПАСНОСТИ? ИСТОРИЯ ЗНАЕТ ТАКИЕ ПОРЯДКИ,
Dialogue: 0,0:07:28.32,0:07:30.96,Caption,,0,0,0,,ХОТЯ ДО НОВОЙ ЯЛТЫ НЫНЕШНЯЯ ВСТРЕЧА ЯВНО НЕ
Dialogue: 0,0:07:30.96,0:07:37.07,Caption,,0,0,0,,ДОТЯНУЛА. ГОТОВОГО РАЗДЕЛА МИРА НЕТ. ЗАТО ПОЯВИЛСЯ ПЕРЕЧЕНЬ
Dialogue: 0,0:07:37.07,0:07:42.59,Caption,,0,0,0,,НАПРАВЛЕНИЙ, ГДЕ МОСКВА, ВАШИНГТОН И ПЕКИН ГОТОВЫ ИСКАТЬ СОВМЕСТНЫЕ ПРАВИЛА
Dialogue: 0,0:07:42.59,0:07:46.11,Caption,,0,0,0,,РЕФОРМА ООН, СУВЕРЕНИТЕТ, МЕЖДУНАРОДНЫЕ СУДЫ,
Dialogue: 0,0:07:46.27,0:07:49.71,Caption,,0,0,0,,ЭНЕРГЕТИКА И ЯДЕРНЫЕ РИСКИ. ЭТО УЖЕ НАМНОГО ШИРЕ,
Dialogue: 0,0:07:49.95,0:07:52.43,Caption,,0,0,0,,ЧЕМ ОЧЕРЕДНОЙ СПОР О ЛИНИИ НА УКРАИНСКОЙ КАРТЕ.
Dialogue: 0,0:07:52.88,0:07:55.79,Caption,,0,0,0,,ЕВРОПЕ ЗДЕСЬ СОВСЕМ НЕ ВЕСЕЛО. ГЕРМАНИЯ УЖЕ
Dialogue: 0,0:07:55.79,0:07:58.19,Caption,,0,0,0,,РАСПЛАЧИВАЕТСЯ ЗА ДОРОГУЮ ЭНЕРГИЮ ПОТЕРЕЙ
Dialogue: 0,0:07:58.19,0:08:02.27,Caption,,0,0,0,,КОНКУРЕНТОСПОСОБНОСТИ, ПРОБЛЕМАМИ ПРОМЫШЛЕННОСТИ И РОСТОМ ИЗДЕРЖЕК.
Dialogue: 0,0:08:02.76,0:08:06.43,Caption,,0,0,0,,ВОЗНИКАЕТ ЕЩЁ БОЛЕЕ НЕПРИЯТНЫЙ ВЫВОД. КОЛОНИЮ ОБЫЧНО
Dialogue: 0,0:08:06.43,0:08:09.07,Caption,,0,0,0,,ДЕРЖАТ ХОТЯ БЫ РАДИ СЫРЬЯ ИЛИ РЫНКА. А
Dialogue: 0,0:08:09.07,0:08:12.11,Caption,,0,0,0,,КОНТИНЕНТ, КОТОРЫЙ ЛИШАЕТСЯ ДЕШЁВЫХ РЕСУРСОВ,
Dialogue: 0,0:08:12.35,0:08:14.51,Caption,,0,0,0,,ЧАСТИ ПРОИЗВОДСТВЕННОЙ БАЗЫ И ВЛИЯНИЯ,
Dialogue: 0,0:08:14.78,0:08:17.63,Caption,,0,0,0,,РИСКУЕТ ОКАЗАТЬСЯ В ПОЛОЖЕНИИ ПОХУЖЕ. ТРЕБОВАНИЯ
Dialogue: 0,0:08:17.63,0:08:21.47,Caption,,0,0,0,,ОСТАЛИСЬ ЦАРСКИЕ, А ИНСТРУМЕНТЫ СТАНОВЯТСЯ ВСЁ СКРОМНЕЕ. КОГДА
Dialogue: 0,0:08:21.55,0:08:24.27,Caption,,0,0,0,,НЕМЕЦКИЙ МИНИСТР СВЯЗЫВАЕТ ЭКОНОМИЧЕСКИЕ ТРУДНОСТИ С
Dialogue: 0,0:08:24.27,0:08:28.11,Caption,,0,0,0,,ПРОТИВОСТОЯНИЕМ РОССИИ, СПОР ПЕРЕСТАЁТ БЫТЬ РАЗГОВОРОМ НА ДАЛЁКОЙ
Dialogue: 0,0:08:28.11,0:08:30.75,Caption,,0,0,0,,КОНФЕРЕНЦИИ. ЦЕНА ПОЯВЛЯЕТСЯ В ПЛАТЁЖКЕ ЗА
Dialogue: 0,0:08:30.75,0:08:32.99,Caption,,0,0,0,,ЭЛЕКТРИЧЕСТВО, В СТОИМОСТИ ОТОПЛЕНИЯ,
Dialogue: 0,0:08:33.23,0:08:35.95,Caption,,0,0,0,,В СЕБЕСТОИМОСТИ ТОВАРА И В РЕШЕНИИ ПРЕДПРИЯТИЯ
Dialogue: 0,0:08:35.95,0:08:38.75,Caption,,0,0,0,,СОКРАТИТЬ РАБОЧИЕ МЕСТА. ЦЕННОСТИ ЗВУЧАТ
Dialogue: 0,0:08:38.75,0:08:42.43,Caption,,0,0,0,,ТОРЖЕСТВЕННО, НО КВИТАНЦИЯ ПОЧЕМУ ТО ПРИХОДИТ БЕЗ ОРКЕСТРА.
Dialogue: 0,0:08:42.64,0:08:46.11,Caption,,0,0,0,,ПОДПИШИТЕСЬ, ЕСЛИ ХОТИТЕ ДАЛЬШЕ РАЗБИРАТЬ ИМЕННО ТАКИЕ СВЯЗИ.
Dialogue: 0,0:08:46.51,0:08:49.07,Caption,,0,0,0,,ПОТОМУ ЧТО СЕЙЧАС БУДЕТ САМЫЙ ВЕСЁЛЫЙ КУСОК ЭТОЙ
Dialogue: 0,0:08:49.15,0:08:54.80,Caption,,0,0,0,,БОЛЬШОЙ ДРУЖБЫ. СИ ЦЗИНЬПИН ПРЕДЛОЖИЛ ПОЛНОСТЬЮ ЗАПРЕТИТЬ И
Dialogue: 0,0:08:54.88,0:08:57.92,Caption,,0,0,0,,УНИЧТОЖИТЬ ЯДЕРНОЕ ОРУЖИЕ. КАРТИНА ПРЕКРАСНАЯ
Dialogue: 0,0:08:58.00,0:09:03.60,Caption,,0,0,0,,ГОЛУБОЕ НЕБО, БЕЛЫЕ ГОЛУБИ, ДОВОЛЬНЫЕ ДЕТИ И НИ ОДНОЙ РАКЕТЫ НА ГОРИЗОНТЕ.
Dialogue: 0,0:09:03.89,0:09:06.96,Caption,,0,0,0,,ЕСТЬ ЛИШЬ КРОШЕЧНАЯ ПОДРОБНОСТЬ. СРЕДИ РОССИИ,
Dialogue: 0,0:09:07.12,0:09:10.56,Caption,,0,0,0,,СОЕДИНЁННЫХ ШТАТОВ И КИТАЯ ИМЕННО ПЕКИН РАСПОЛАГАЕТ
Dialogue: 0,0:09:10.56,0:09:13.60,Caption,,0,0,0,,САМЫМ НЕБОЛЬШИМ ЯДЕРНЫМ АРСЕНАЛОМ. МОЯ ВЕРСИЯ
Dialogue: 0,0:09:13.68,0:09:17.44,Caption,,0,0,0,,ПРОСТАЯ. КИТАЙ РЕШИЛ СХИТРИТЬ. МОСКВА И ВАШИНГТОН
Dialogue: 0,0:09:17.44,0:09:20.88,Caption,,0,0,0,,ДЕСЯТИЛЕТИЯМИ СОЗДАВАЛИ ОГРОМНЫЕ ЗАПАСЫ БОЕЗАРЯДОВ И
Dialogue: 0,0:09:20.88,0:09:23.28,Caption,,0,0,0,,ПРЕВРАЩАЛИ ИХ В ОСНОВУ СТРАТЕГИЧЕСКОГО ВЛИЯНИЯ.
Dialogue: 0,0:09:23.56,0:09:26.56,Caption,,0,0,0,,ПЕКИН ТЕПЕРЬ ПРЕДЛАГАЕТ ВСЕМ ОДНОВРЕМЕННО ОТКАЗАТЬСЯ
Dialogue: 0,0:09:26.64,0:09:28.64,Caption,,0,0,0,,ОТ НАКОПЛЕННОГО. ЗВУЧИТ ЧЕСТНО,
Dialogue: 0,0:09:28.87,0:09:31.76,Caption,,0,0,0,,ЕСЛИ НЕ СЧИТАТЬ, КТО ИМЕННО ТЕРЯЕТ БОЛЬШЕ ВСЕГО.
Dialogue: 0,0:09:32.32,0:09:35.28,Caption,,0,0,0,,РОССИЯ И СОЕДИНЁННЫЕ ШТАТЫ В ТАКОМ СЛУЧАЕ ЛИШАЮТСЯ
Dialogue: 0,0:09:35.28,0:09:38.16,Caption,,0,0,0,,КОЛОССАЛЬНОГО ПРЕИМУЩЕСТВА. КИТАЙ ТОЖЕ СДАЁТ
Dialogue: 0,0:09:38.24,0:09:42.48,Caption,,0,0,0,,СОБСТВЕННЫЙ АРСЕНАЛ, НО ЕГО ОТНОСИТЕЛЬНАЯ ПОТЕРЯ ЗНАЧИТЕЛЬНО МЕНЬШЕ.
Dialogue: 0,0:09:43.03,0:09:45.52,Caption,,0,0,0,,ПОСЛЕ ЭТОГО НА ПЕРВЫЙ ПЛАН ВЫХОДЯТ ЭКОНОМИКА,
Dialogue: 0,0:09:45.66,0:09:50.72,Caption,,0,0,0,,ПРОМЫШЛЕННОЕ ПРОИЗВОДСТВО, ТЕХНОЛОГИИ И ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ. А НА ТАКОМ
Dialogue: 0,0:09:50.72,0:09:52.72,Caption,,0,0,0,,ПОЛЕ ПЕКИН УЖЕ НЕ МЛАДШИЙ УЧАСТНИК,
Dialogue: 0,0:09:52.96,0:09:56.16,Caption,,0,0,0,,КОТОРОМУ РАЗРЕШИЛИ ПОСТОЯТЬ РЯДОМ СО ВЗРОСЛЫМИ. ТАМ
Dialogue: 0,0:09:56.16,0:09:58.72,Caption,,0,0,0,,ОН САМ ВЫБИРАЕТ ПРАВИЛА ИГРЫ. КОНЕЧНО,
Dialogue: 0,0:09:58.96,0:10:01.52,Caption,,0,0,0,,ВСЕ ВЫСТУПАЮТ ЗА ЯДЕРНОЕ РАЗОРУЖЕНИЕ. КТО ЖЕ
Dialogue: 0,0:10:01.52,0:10:04.72,Caption,,0,0,0,,ПУБЛИЧНО СКАЖЕТ, ЧТО ЕМУ НРАВЯТСЯ РАКЕТЫ И БОЕГОЛОВКИ?
Dialogue: 0,0:10:05.01,0:10:07.20,Caption,,0,0,0,,ОСТАЛОСЬ ОПРЕДЕЛИТЬ ПЕРВОГО ДОБРОВОЛЬЦА,
Dialogue: 0,0:10:07.44,0:10:09.52,Caption,,0,0,0,,КОТОРЫЙ ОТПРАВИТ СВОЙ АРСЕНАЛ ПОД РЕЗАК.
Dialogue: 0,0:10:11.80,0:10:15.72,Caption,,0,0,0,,СУДЯ ПО ТИШИНЕ, ЖЕЛАЮЩИЕ ЗАДЕРЖАЛИСЬ В ДОРОГЕ. ВОЗМОЖНО,
Dialogue: 0,0:10:15.94,0:10:19.16,Caption,,0,0,0,,ИЩУТ ПАРКОВКУ ДЛЯ РАКЕТ. НА ЭТОМ ФОНЕ ЯДЕРНЫЙ
Dialogue: 0,0:10:19.16,0:10:21.72,Caption,,0,0,0,,ЧЕМОДАНЧИК ПУТИНА СТАНОВИТСЯ ПОЧТИ ОТДЕЛЬНЫМ
Dialogue: 0,0:10:21.72,0:10:24.84,Caption,,0,0,0,,УЧАСТНИКОМ САММИТА. ТРАМП УЛЫБАЕТСЯ И НАЗЫВАЕТ
Dialogue: 0,0:10:24.84,0:10:28.20,Caption,,0,0,0,,ПРЕЗИДЕНТА РОССИИ ДРУГОМ. СИ РАССУЖДАЕТ О МИРЕ.
Dialogue: 0,0:10:28.51,0:10:31.40,Caption,,0,0,0,,ПУТИН ГОВОРИТ О СТАБИЛЬНОСТИ. А ЧЕМОДАНЧИК СПОКОЙНО
Dialogue: 0,0:10:31.48,0:10:35.00,Caption,,0,0,0,,СЛЕДУЕТ РЯДОМ, ПОТОМУ ЧТО ГОСУДАРСТВЕННАЯ ПРЕДУСМОТРИТЕЛЬНОСТЬ НЕ
Dialogue: 0,0:10:35.00,0:10:37.96,Caption,,0,0,0,,ОБЯЗАНА РАЗДЕЛЯТЬ ПРАЗДНИЧНОЕ НАСТРОЕНИЕ ХОЗЯЕВ.
Dialogue: 0,0:10:38.56,0:10:41.88,Caption,,0,0,0,,ИДЕЯ О САМОЛЁТЕ СУДНОГО ДНЯ ПОДЧЁРКИВАЕТ ТУ ЖЕ
Dialogue: 0,0:10:41.88,0:10:45.00,Caption,,0,0,0,,ЛОГИКУ, ХОТЯ ПОДТВЕРЖДЁННОГО МЕДИА ДЛЯ ЭТОГО ЭПИЗОДА В
Dialogue: 0,0:10:45.08,0:10:48.04,Caption,,0,0,0,,АРХИВЕ НЕТ. ДРУЖЕСКИЕ СЛОВА ЗВУЧАТ ТЕПЛО,
Dialogue: 0,0:10:48.37,0:10:53.96,Caption,,0,0,0,,ПЕРЕГОВОРЫ ПРОХОДЯТ УСПЕШНО, ЛИДЕРЫ СТАВЯТ ВСТРЕЧЕ ВЫСОКИЕ ОЦЕНКИ. НО ИНСТРУМЕНТЫ
Dialogue: 0,0:10:54.04,0:10:57.24,Caption,,0,0,0,,НА СЛУЧАЙ ВНЕЗАПНОГО ОКОНЧАНИЯ ДРУЖБЫ НИКТО НЕ СДАЁТ
Dialogue: 0,0:10:57.24,0:11:00.12,Caption,,0,0,0,,В ГАРДЕРОБ. У ВЕЛИКИХ ДЕРЖАВ ДОВЕРИЕ КРЕПКОЕ,
Dialogue: 0,0:11:00.41,0:11:03.08,Caption,,0,0,0,,ПРОСТО ИНСТРУКЦИЯ ПО ПРИМЕНЕНИЮ ЗАНИМАЕТ НЕСКОЛЬКО
Dialogue: 0,0:11:03.08,0:11:06.28,Caption,,0,0,0,,СЕКРЕТНЫХ ТОМОВ. КИТАЙСКИЙ МАНЁВР ПОЭТОМУ ВРЯД ЛИ
Dialogue: 0,0:11:06.28,0:11:09.56,Caption,,0,0,0,,СРАБОТАЕТ. РОССИЯ И СОЕДИНЁННЫЕ ШТАТЫ ПОНИМАЮТ
Dialogue: 0,0:11:09.56,0:11:12.60,Caption,,0,0,0,,ЦЕННОСТЬ ЯДЕРНОГО ОРУЖИЯ СЛИШКОМ ХОРОШО. ЭТО НЕ
Dialogue: 0,0:11:12.60,0:11:17.32,Caption,,0,0,0,,ДОРОГАЯ КОЛЛЕКЦИЯ МЕТАЛЛА, КОТОРУЮ МОЖНО ОБМЕНЯТЬ НА КРАСИВУЮ ДЕКЛАРАЦИЮ. ЭТО
Dialogue: 0,0:11:17.32,0:11:20.20,Caption,,0,0,0,,ПОСЛЕДНЯЯ СТРАХОВКА, ОСОБЕННО КОГДА ПАРТНЁР,
Dialogue: 0,0:11:20.36,0:11:24.20,Caption,,0,0,0,,СОПЕРНИК И ВОЗМОЖНЫЙ ПРОТИВНИК МОГУТ ОКАЗАТЬСЯ ОДНИМ
Dialogue: 0,0:11:24.28,0:11:27.24,Caption,,0,0,0,,И ТЕМ ЖЕ ГОСУДАРСТВОМ, В ЗАВИСИМОСТИ ОТ ПУНКТА ПОВЕСТКИ.
Dialogue: 0,0:11:29.44,0:11:32.72,Caption,,0,0,0,,В ЭТОМ И РАСКРЫВАЕТСЯ ПОДЛИННЫЙ СМЫСЛ ВСТРЕЧИ. ТРАМП
Dialogue: 0,0:11:32.76,0:11:36.08,Caption,,0,0,0,,ДРУЖЕСКИ ОТЗЫВАЕТСЯ О ПУТИНЕ. СИ ОКАЗЫВАЕТ ЕМУ
Dialogue: 0,0:11:36.08,0:11:39.28,Caption,,0,0,0,,ОСОБОЕ ВНИМАНИЕ. ЗАПАДНЫЕ ЛИДЕРЫ ФОТОГРАФИРУЮТСЯ С
Dialogue: 0,0:11:39.28,0:11:43.44,Caption,,0,0,0,,РОССИЙСКИМ ПРЕЗИДЕНТОМ, А ПОСЛЕ ВОЗВРАЩЕНИЯ ОБЪЯСНЯЮТ СВОИМ ИЗБИРАТЕЛЯМ,
Dialogue: 0,0:11:43.61,0:11:46.24,Caption,,0,0,0,,ПОЧЕМУ ТАК ПОЛУЧИЛОСЬ. УЛЫБОК МНОГО,
Dialogue: 0,0:11:46.64,0:11:49.20,Caption,,0,0,0,,НО НИ ОДНА СЕРЬЁЗНАЯ ДЕРЖАВА НЕ КЛАДЁТ НА
Dialogue: 0,0:11:49.28,0:11:51.68,Caption,,0,0,0,,СТОЛ ПОСЛЕДНИЙ КОЗЫРЬ. ДРУЖБА ДРУЖБОЙ,
Dialogue: 0,0:11:51.91,0:11:54.88,Caption,,0,0,0,,А КОЛОДУ КАЖДЫЙ ДЕРЖИТ РУБАШКОЙ ВВЕРХ. ПОЭТОМУ
Dialogue: 0,0:11:54.88,0:11:57.60,Caption,,0,0,0,,ВОЗМУЩЕНИЕ СИКОРСКОГО РОССИЙСКИМ МЕСТОМ ЗА СТОЛОМ
Dialogue: 0,0:11:57.68,0:12:00.48,Caption,,0,0,0,,ПОПАДАЕТ МИМО ЦЕЛИ. ТУДА ЗОВУТ НЕ ЗА ПРИМЕРНОЕ
Dialogue: 0,0:12:00.48,0:12:04.48,Caption,,0,0,0,,ПОВЕДЕНИЕ, ПРИЯТНЫЙ ХАРАКТЕР ИЛИ ПЕРВОЕ МЕСТО В РЕЙТИНГЕ
Dialogue: 0,0:12:04.48,0:12:06.88,Caption,,0,0,0,,ЭКОНОМИК. УЧАСТНИКОМ СТАНОВИТСЯ ТОТ,
Dialogue: 0,0:12:07.13,0:12:10.32,Caption,,0,0,0,,БЕЗ КОГО КОНКРЕТНАЯ ЗАДАЧА НЕ РЕШАЕТСЯ. ЭТО НЕ
Dialogue: 0,0:12:10.32,0:12:13.44,Caption,,0,0,0,,ЦЕРЕМОНИЯ НАГРАЖДЕНИЯ. ЗДЕСЬ ДИПЛОМ ЗА ХОРОШУЮ
Dialogue: 0,0:12:13.44,0:12:16.32,Caption,,0,0,0,,СТАТИСТИКУ НЕ ЗАМЕНЯЕТ ВОЗМОЖНОСТЬ ПОВЛИЯТЬ НА
Dialogue: 0,0:12:16.32,0:12:19.36,Caption,,0,0,0,,РЕЗУЛЬТАТ. ЕВРОСОЮЗ ДЕЙСТВИТЕЛЬНО БОГАЧЕ РОССИИ ПО
Dialogue: 0,0:12:19.44,0:12:21.92,Caption,,0,0,0,,РАЗМЕРУ ЭКОНОМИКИ. ЕВРОПА ОСТАЁТСЯ ОДНИМ ИЗ
Dialogue: 0,0:12:21.92,0:12:24.96,Caption,,0,0,0,,КРУПНЕЙШИХ МИРОВЫХ РЫНКОВ. ОДНАКО ПРИ ОБСУЖДЕНИИ
Dialogue: 0,0:12:24.96,0:12:27.28,Caption,,0,0,0,,ЯДЕРНОГО СДЕРЖИВАНИЯ, РЕСУРСОВ,
Dialogue: 0,0:12:27.52,0:12:32.56,Caption,,0,0,0,,ГЛОБАЛЬНОЙ БЕЗОПАСНОСТИ, СОВЕТА БЕЗОПАСНОСТИ ООН И СПОСОБНОСТИ ЗАБЛОКИРОВАТЬ
Dialogue: 0,0:12:32.56,0:12:35.44,Caption,,0,0,0,,ЧУЖОЕ РЕШЕНИЕ НАЧИНАЕТ ДЕЙСТВОВАТЬ ДРУГАЯ СИСТЕМА
Dialogue: 0,0:12:35.44,0:12:37.92,Caption,,0,0,0,,ПОДСЧЁТА. КАЛЬКУЛЯТОР СИКОРСКОГО ИСПРАВЕН,
Dialogue: 0,0:12:38.16,0:12:40.96,Caption,,0,0,0,,ПРОСТО НА НЁМ НЕТ НУЖНЫХ КНОПОК. ДЛЯ ФРАНЦИИ
Dialogue: 0,0:12:41.04,0:12:43.84,Caption,,0,0,0,,И ВЕЛИКОБРИТАНИИ ПРОИСХОДЯЩЕЕ ОСОБЕННО ОБИДНО.
Dialogue: 0,0:12:46.11,0:12:48.67,Caption,,0,0,0,,ЭТО ЯДЕРНЫЕ ДЕРЖАВЫ И ПОСТОЯННЫЕ ЧЛЕНЫ СОВЕТА
Dialogue: 0,0:12:48.67,0:12:51.31,Caption,,0,0,0,,БЕЗОПАСНОСТИ. ИХ ОСОБОЕ ПОЛОЖЕНИЕ ЗАКРЕПЛЕНО
Dialogue: 0,0:12:51.31,0:12:55.15,Caption,,0,0,0,,ПОРЯДКОМ, СЛОЖИВШИМСЯ ПОСЛЕ ВТОРОЙ МИРОВОЙ ВОЙНЫ. ТЕМ НЕ МЕНЕЕ
Dialogue: 0,0:12:55.15,0:12:58.03,Caption,,0,0,0,,ЗАЯВЛЕНИЕ О РЕФОРМЕ ООН ПОДГОТОВИЛИ В ФОРМАТЕ,
Dialogue: 0,0:12:58.35,0:13:02.35,Caption,,0,0,0,,ГДЕ НИ ПАРИЖА, НИ ЛОНДОНА НЕ ОКАЗАЛОСЬ. ПОЧЁТНЫЙ ПРОПУСК
Dialogue: 0,0:13:02.35,0:13:06.43,Caption,,0,0,0,,СОХРАНИЛСЯ, НО ОХРАННИК ПОЧЕМУ ТО НЕ ОТКРЫЛ ДВЕРЬ. ИМЕННО
Dialogue: 0,0:13:06.51,0:13:09.63,Caption,,0,0,0,,ТАК ВЫГЛЯДЯТ ПЕРВЫЕ НАМЁТКИ НОВОЙ ЯЛТЫ. МИР ПОКА
Dialogue: 0,0:13:09.71,0:13:12.19,Caption,,0,0,0,,НЕ ПОДЕЛЁН, НОВЫЙ ГЛОБУС НЕ НАПЕЧАТАН,
Dialogue: 0,0:13:12.36,0:13:15.47,Caption,,0,0,0,,ОКОНЧАТЕЛЬНЫХ СОГЛАШЕНИЙ НЕТ. ЗАТО ТРИ ДЕРЖАВЫ УЖЕ
Dialogue: 0,0:13:15.47,0:13:18.19,Caption,,0,0,0,,ПРОБУЮТ ОПРЕДЕЛИТЬ ПРИЕМЛЕМЫЕ ДЛЯ СЕБЯ ПРАВИЛА И
Dialogue: 0,0:13:18.19,0:13:21.71,Caption,,0,0,0,,НАЗВАТЬ СТРУКТУРЫ, КОТОРЫЕ СЛИШКОМ ДАЛЕКО ЗАШЛИ В СТРЕМЛЕНИИ
Dialogue: 0,0:13:21.71,0:13:23.95,Caption,,0,0,0,,КОМАНДОВАТЬ ДРУГИМИ. НА ОДНОЙ СТОРОНЕ
Dialogue: 0,0:13:24.11,0:13:28.35,Caption,,0,0,0,,ГОСУДАРСТВЕННЫЙ СУВЕРЕНИТЕТ, НА ДРУГОЙ ДАВЛЕНИЕ НАДНАЦИОНАЛЬНЫХ ОРГАНОВ.
Dialogue: 0,0:13:28.65,0:13:31.63,Caption,,0,0,0,,ИММУНИТЕТЫ ОФИЦИАЛЬНЫХ ЛИЦ СТАЛКИВАЮТСЯ С РАСТУЩИМИ
Dialogue: 0,0:13:31.63,0:13:34.51,Caption,,0,0,0,,АМБИЦИЯМИ МЕЖДУНАРОДНЫХ СУДОВ. ЭНЕРГЕТИЧЕСКИЕ
Dialogue: 0,0:13:34.51,0:13:38.67,Caption,,0,0,0,,ИНТЕРЕСЫ СПОРЯТ С КУРСОМ, КОТОРЫЙ ДЕЛАЕТ ЕВРОПЕЙСКУЮ ПРОМЫШЛЕННОСТЬ ДОРОЖЕ.
Dialogue: 0,0:13:39.14,0:13:42.11,Caption,,0,0,0,,ЯДЕРНОЕ СДЕРЖИВАНИЕ УПИРАЕТСЯ В ЗАМАНЧИВОЕ КИТАЙСКОЕ
Dialogue: 0,0:13:42.11,0:13:45.55,Caption,,0,0,0,,ПРЕДЛОЖЕНИЕ ВСЁ УНИЧТОЖИТЬ. А ЕВРОСОЮЗ ПРОДОЛЖАЕТ
Dialogue: 0,0:13:45.55,0:13:49.39,Caption,,0,0,0,,УБЕЖДАТЬ ОКРУЖАЮЩИХ, ЧТО БЕЗ НЕГО НИ ОДИН БОЛЬШОЙ ВОПРОС НЕ
Dialogue: 0,0:13:49.39,0:13:52.51,Caption,,0,0,0,,СДВИНЕТСЯ С МЕСТА. НО ВОПРОСЫ УЖЕ ДВИГАЮТСЯ. НЕ
Dialogue: 0,0:13:52.51,0:13:55.87,Caption,,0,0,0,,ВСЕ И НЕ ДО ОКОНЧАТЕЛЬНОГО РЕЗУЛЬТАТА. ПОКА ЭТО
Dialogue: 0,0:13:55.87,0:13:58.59,Caption,,0,0,0,,ТОЛЬКО НАЧАЛО СОГЛАСОВАНИЯ ОБЩИХ ПРИНЦИПОВ.
Dialogue: 0,0:14:00.87,0:14:05.67,Caption,,0,0,0,,ОДНАКО РОССИЯ, СОЕДИНЁННЫЕ ШТАТЫ И КИТАЙ СДЕЛАЛИ ЭТО БЕЗ ФРАНЦИИ,
Dialogue: 0,0:14:05.75,0:14:09.19,Caption,,0,0,0,,ВЕЛИКОБРИТАНИИ И ИНСТИТУТОВ ЕВРОСОЮЗА. ЗНАЧИТ,
Dialogue: 0,0:14:09.51,0:14:12.31,Caption,,0,0,0,,ПРЕЖНИЙ СТАТУС БОЛЬШЕ НЕ ГАРАНТИРУЕТ ПРИГЛАШЕНИЕ.
Dialogue: 0,0:14:12.87,0:14:17.67,Caption,,0,0,0,,ДАВНЯЯ ТАБЛИЧКА, ЗНАКОМЫЙ КАБИНЕТ И ЗАСЛУЖЕННОЕ ПРАВО ВЕТО МОГУТ
Dialogue: 0,0:14:17.67,0:14:21.35,Caption,,0,0,0,,ОСТАТЬСЯ НА МЕСТЕ, ПОКА РЕШЕНИЕ НАЧИНАЕТ СОЗРЕВАТЬ В ДРУГОМ ФОРМАТЕ.
Dialogue: 0,0:14:21.90,0:14:24.95,Caption,,0,0,0,,ДЛЯ ЕВРОПЫ ЭТО БОЛЕЗНЕННЕЕ ЛЮБОГО СОВМЕСТНОГО
Dialogue: 0,0:14:24.95,0:14:27.67,Caption,,0,0,0,,СНИМКА. ФОТОГРАФИЮ МОЖНО НАЗВАТЬ ПРОТОКОЛЬНОЙ.
Dialogue: 0,0:14:28.06,0:14:31.11,Caption,,0,0,0,,РУКОПОЖАТИЕ ОБЪЯСНИТЬ ВЕЖЛИВОСТЬЮ. СЛОВО ДРУГ
Dialogue: 0,0:14:31.19,0:14:34.07,Caption,,0,0,0,,СПИСАТЬ НА ПРИВЫЧНУЮ МАНЕРУ ТРАМПА. НО КОГДА КРУПНЫЕ
Dialogue: 0,0:14:34.15,0:14:36.63,Caption,,0,0,0,,ДЕРЖАВЫ ПЕРЕХОДЯТ К ООН, ЭНЕРГЕТИКЕ,
Dialogue: 0,0:14:36.87,0:14:39.51,Caption,,0,0,0,,МЕЖДУНАРОДНЫМ СУДАМ И СТРАТЕГИЧЕСКОЙ СТАБИЛЬНОСТИ,
Dialogue: 0,0:14:39.83,0:14:42.63,Caption,,0,0,0,,ОБЪЯСНЕНИЯ ДЛЯ ПРЕССЫ УЖЕ НЕ СПАСАЮТ. ПРИХОДИТСЯ
Dialogue: 0,0:14:42.63,0:14:45.67,Caption,,0,0,0,,ОТВЕЧАТЬ, ПОЧЕМУ ПРАВИЛА НАЧАЛИ ОБСУЖДАТЬ БЕЗ ТЕХ,
Dialogue: 0,0:14:45.90,0:14:48.47,Caption,,0,0,0,,КТО СЧИТАЛ СЕБЯ ИХ ГЛАВНЫМ ХРАНИТЕЛЕМ. ТАК
Dialogue: 0,0:14:48.48,0:14:51.27,Caption,,0,0,0,,ЭКОНОМИЧЕСКИЙ МОНСТР ОКАЗАЛСЯ У ЗАКРЫТОЙ ДВЕРИ И
Dialogue: 0,0:14:51.27,0:14:54.71,Caption,,0,0,0,,ТРЕБУЕТ, ЧТОБЫ ЕГО НЕМЕДЛЕННО ВПУСТИЛИ. А ЭКОНОМИЧЕСКИЙ
Dialogue: 0,0:14:54.71,0:14:59.35,Caption,,0,0,0,,КАРЛИК УЖЕ СИДИТ ВНУТРИ, БЕСЕДУЕТ С ДВУМЯ ЯДЕРНЫМИ ДЕРЖАВАМИ И ДЕРЖИТ
Dialogue: 0,0:14:59.35,0:15:04.71,Caption,,0,0,0,,ЧЕМОДАНЧИК ПОБЛИЖЕ. ПОЖАЛУЙ, ИМЕННО ЭТУ КАРТИНУ СИКОРСКОМУ БУДЕТ ТРУДНЕЕ ВСЕГО
Dialogue: 0,0:15:04.79,0:15:06.55,Caption,,0,0,0,,ОБЪЯСНИТЬ СОБСТВЕННОМУ КАЛЬКУЛЯТОРУ.
